<!-- 预约时间选择组件 — 日历 + 时间网格 -->
<view wx:if="{{paused}}" class="btp-warn-text">美甲师已关闭预约功能，请先沟通服务安排。<view class="btp-contact" bindtap="contactArtist" role="button">联系美甲师</view></view>
<view wx:elif="{{loadFailed}}" class="btp-warn-text">预约信息加载失败<view class="btp-contact" bindtap="retryLoad" role="button">重新加载</view></view>
<view wx:elif="{{!_ready}}" class="btp-warn-text">正在加载可预约日期…</view>
<view wx:else class="btp-calendar">
  <view wx:if="{{!horizontal}}" class="btp-calendar-header">
    <view class="btp-nav-btn" bindtap="onPrevMonth">‹</view>
    <text class="btp-calendar-title">{{calendarMonthLabel}}</text>
    <view class="btp-nav-btn" bindtap="onNextMonth">›</view>
  </view>
  <text wx:if="{{horizontal}}" class="btp-date-heading">选择日期</text>
  <view wx:if="{{horizontal}}" class="btp-strip-layout">
    <view class="btp-date-card {{todayOption.disabled ? 'btp-date-disabled' : ''}} {{todayOption.isSelected ? 'btp-date-active' : ''}}" bindtap="onSelectDate" data-date="{{todayOption.dateStr}}" role="button" aria-disabled="{{todayOption.disabled}}" aria-label="今天 {{todayOption.label}}" hover-class="btp-date-pressed">
      <text class="btp-date-week">今天</text><text class="btp-date-number">{{todayOption.day}}</text><text wx:if="{{todayOption.label}}" class="btp-day-label">{{todayOption.label}}</text>
    </view>
    <scroll-view class="btp-date-strip" scroll-x enhanced show-scrollbar="{{false}}" bindscrolltolower="loadMoreDates" lower-threshold="120">
      <view class="btp-date-row">
        <view wx:for="{{futureDays}}" wx:key="dateStr" class="btp-date-card {{item.disabled ? 'btp-date-disabled' : ''}} {{item.isSelected ? 'btp-date-active' : ''}}" bindtap="onSelectDate" data-date="{{item.dateStr}}" role="button" aria-disabled="{{item.disabled}}" aria-label="{{item.dateStr}} {{item.weekday}} {{item.label}}" hover-class="btp-date-pressed">
          <text class="btp-date-week">{{item.weekday}}</text><text class="btp-date-number">{{item.day}}</text><text wx:if="{{item.label}}" class="btp-day-label">{{item.label}}</text>
        </view>
      </view>
    </scroll-view>
  </view>
  <view wx:if="{{!horizontal}}" class="btp-weekdays">
    <text wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this" class="btp-weekday-cell">{{item}}</text>
  </view>
  <view wx:if="{{!horizontal}}" class="btp-calendar-grid">
    <view wx:for="{{calendarDays}}" wx:key="index" class="btp-day-wrap">
      <view wx:if="{{item.empty}}" class="btp-day btp-day-empty"></view>
      <view wx:elif="{{item.disabled}}" class="btp-day btp-day-disabled" aria-label="{{item.day}}日，{{item.label || '不可预约'}}">
        <text class="btp-day-text">{{item.day}}</text><text wx:if="{{item.label}}" class="btp-day-label">{{item.label}}</text>
      </view>
      <view wx:elif="{{item.isSelected}}" class="btp-day btp-day-selected" bindtap="onSelectDate" data-date="{{item.dateStr}}">
        <text class="btp-day-text btp-day-text-selected">{{item.day}}</text>
      </view>
      <view wx:elif="{{item.isToday}}" class="btp-day btp-day-today" bindtap="onSelectDate" data-date="{{item.dateStr}}">
        <text class="btp-day-text">{{item.day}}</text>
      </view>
      <view wx:else class="btp-day" bindtap="onSelectDate" data-date="{{item.dateStr}}">
        <text class="btp-day-text">{{item.day}}</text>
      </view>
    </view>
  </view>
</view>

<!-- 时间网格 -->
<text wx:if="{{horizontal && _ready}}" class="btp-slot-title">选择时间段</text>
<text wx:if="{{horizontal && _ready && !timeSlotStatuses.length}}" class="btp-empty-slots">当前日期暂无可预约时段，请选择其他日期或服务地址</text>
<view class="btp-time-grid {{horizontal ? 'btp-time-grid-horizontal' : ''}}" wx:if="{{timeSlotStatuses.length > 0}}">
  <view wx:for="{{timeSlotStatuses}}" wx:key="time"
    class="btp-time-item {{startTime === item.time ? 'btp-time-active' : ''}} {{item.occupied ? 'btp-time-occupied' : ''}}"
    bindtap="selectTime" data-time="{{item.time}}">
    <text class="btp-time-text">{{item.time}}</text>
    <text wx:if="{{item.occupied}}" class="btp-occupied-label">{{item.reason === 'past' ? '已过时' : '已预约'}}</text>
  </view>
</view>
