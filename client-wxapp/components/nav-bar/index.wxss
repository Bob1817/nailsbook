/* ===== 导航栏容器 ===== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(20px);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.nav-bar.transparent {
  background: transparent;
  border-bottom: none;
  backdrop-filter: none;
}

.nav-bar.light {
  background: transparent;
  border-bottom: none;
  backdrop-filter: blur(20px);
}

/* ===== 内容行 ===== */
.nav-content {
  display: flex;
  align-items: center;
  position: relative;
  padding: 0 16rpx;
}

/* ===== 左侧区域 ===== */
.nav-left {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

/* ===== 返回按钮 - 88rpx 触控区 ===== */
.back-btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn:active {
  opacity: 0.4;
}

/* CSS 画的微信风格左箭头 */
.back-chevron {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #1a1a1a;
  border-top: 4rpx solid #1a1a1a;
  border-radius: 2rpx;
  transform: rotate(-45deg) translateX(3rpx);
}

.nav-bar.light .back-chevron {
  border-left-color: #ffffff;
  border-top-color: #ffffff;
}

/* ===== 标题区域 ===== */
.title-zone {
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
}

/* 居中模式：绝对定位不挤压左右按钮 */
.title-zone.title-center {
  position: absolute;
  left: 112rpx;
  right: 112rpx;
  top: 0;
  bottom: 0;
  align-items: center;
  pointer-events: none;
}

/* 左对齐模式：flex 撑开 */
.title-zone.title-left {
  flex: 1;
  padding-left: 24rpx;
  align-items: flex-start;
}

/* ===== 副标题 ===== */
.subtitle {
  font-size: 20rpx;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 3rpx;
  color: #9ca3af;
  line-height: 1.2;
  margin-bottom: 2rpx;
}

.nav-bar.light .subtitle {
  color: rgba(255, 255, 255, 0.65);
}

/* ===== 标题文字 ===== */
.title-zone.title-center .title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 0;
  line-height: 1.3;
  text-align: center;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.title-zone.title-left .title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: -0.5rpx;
  line-height: 1.2;
}

.nav-bar.light .title {
  color: #ffffff;
}

/* ===== 右侧区域 ===== */
.nav-right {
  width: 96rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-shrink: 0;
}

/* ===== 占位符 ===== */
.nav-placeholder {
  width: 100%;
}
