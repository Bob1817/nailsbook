<view class="nb-theme nav-bar {{transparent ? 'transparent' : ''}} {{light ? 'light' : ''}}" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-content" style="height: {{navBarHeight - statusBarHeight}}px;">

    <!-- 左侧：返回按钮 -->
    <view class="nav-left">
      <view wx:if="{{showBack && customBack}}" class="back-btn" hover-class="none" bindtap="onBack">
        <image class="back-chevron" src="/static/icons/nav-back.svg" mode="aspectFit" />
      </view>
      <navigator wx:elif="{{showBack && backUrl}}" class="back-btn" url="{{backUrl}}" open-type="redirect" hover-class="none" bindtap="onBack">
        <image class="back-chevron" src="/static/icons/nav-back.svg" mode="aspectFit" />
      </navigator>
      <view wx:elif="{{showBack && hasHistory}}" class="back-btn" hover-class="none" bindtap="navigateBack" role="button" aria-label="返回上一页">
        <image class="back-chevron" src="/static/icons/nav-back.svg" mode="aspectFit" />
      </view>
      <view wx:elif="{{showBack}}" class="back-btn" hover-class="none" bindtap="goSafeHome" role="button" aria-label="进入首页">
        <image class="nav-home" src="/static/icons/tab-home.svg" mode="aspectFit" />
      </view>
    </view>

    <!-- 标题区域：有返回键时居中，否则左对齐 -->
    <view class="title-zone {{showBack || titleCenter ? 'title-center' : 'title-left'}} {{backTitleLeft ? 'back-title-left' : ''}}">
      <text wx:if="{{subtitle}}" class="subtitle">{{subtitle}}</text>
      <text class="title">{{title}}</text>
    </view>

    <!-- 右侧插槽 -->
    <view class="nav-right" style="right: {{menuButtonRightOffset + 8}}px;">
      <slot name="right"></slot>
    </view>

  </view>
</view>
<view class="nb-theme nav-placeholder" style="height: {{navBarHeight}}px;"></view>
