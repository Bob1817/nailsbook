<view class="nav-bar {{transparent ? 'transparent' : ''}} {{light ? 'light' : ''}}" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-content {{titleCenter ? 'title-center' : ''}}" style="height: {{navBarHeight - statusBarHeight}}px;">
    <view class="nav-left">
      <view wx:if="{{showBack}}" class="back-btn" bindtap="onBack">
        <text class="back-icon">‹</text>
      </view>
      <view wx:if="{{!titleCenter}}" class="title-wrap">
        <text wx:if="{{subtitle}}" class="subtitle">{{subtitle}}</text>
        <text class="title">{{title}}</text>
      </view>
    </view>
    <view wx:if="{{titleCenter}}" class="title-wrap-center">
      <text class="title">{{title}}</text>
    </view>
    <view class="nav-right">
      <slot name="right"></slot>
    </view>
  </view>
</view>
<view class="nav-placeholder" style="height: {{navBarHeight}}px;"></view>
