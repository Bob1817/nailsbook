<button class="action-button action-button-{{variant}} {{block ? 'is-block' : ''}} {{compact ? 'is-compact' : ''}} {{disabled || loading ? 'is-disabled' : ''}}"
  disabled="{{disabled || loading}}" loading="{{loading}}" hover-class="is-pressed"
  open-type="{{openType}}"
  aria-label="{{ariaLabel || label}}" catchtap="onTap" bindgetphonenumber="onGetPhoneNumber">
  <slot name="icon"></slot>
  <text wx:if="{{label}}">{{label}}</text>
  <slot wx:else></slot>
</button>
