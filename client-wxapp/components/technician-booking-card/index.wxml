<view wx:if="{{variant === 'message'}}" class="booking-card-message" bindtap="open" role="button" aria-label="查看预约详情">
  <view class="message-head">
    <image class="message-icon" src="/static/icons/calendar.svg" mode="aspectFit" />
    <text class="message-title">预约通知</text>
    <text class="message-tag">预约</text>
  </view>
  <text class="message-content">{{order.noticeContent}}</text>
  <view class="message-footer">
    <text class="semantic-link">查看预约详情</text>
    <image class="message-arrow" src="/static/icons/arrow-right.svg" mode="aspectFit" />
  </view>
</view>

<view wx:elif="{{variant === 'hero'}}" class="booking-card-hero" bindtap="open" role="button" aria-label="查看{{order.customerName}}的预约详情">
  <view class="hero-card-content">
    <view class="hero-card-top hero-card-head">
      <view class="hero-card-label-area">
        <text class="hero-card-title">下一单</text>
        <text class="hero-card-sub">最近的预约安排</text>
      </view>
      <view class="hero-status-stack">
        <view class="hero-status-badge {{order._heroStatusTone || order._statusTone || order._stateTone}}">{{order._heroStatusLabel || order._statusLabel}}</view>
        <text wx:if="{{order._countdown}}" class="hero-countdown-value">{{order._countdown}}</text>
      </view>
    </view>

    <view class="hero-card-body hero-time-section">
      <view class="hero-date-box">
        <text class="hero-date-month">{{order._dateMonth}}</text>
        <text class="hero-date-day">{{order._dateDay}}</text>
        <text class="hero-date-weekday">{{order._dateWeekday}}</text>
      </view>
      <view class="hero-details">
        <view class="hero-detail-row hero-time-range-row">
          <image class="hero-detail-icon" src="/static/icons/clock.svg" mode="aspectFit" />
          <text class="hero-detail-text hero-detail-value">{{order._serviceTypeLabel || '待确认'}}</text>
        </view>
        <view class="hero-detail-row hero-customer-row">
          <image class="hero-detail-icon" src="/static/icons/role-client.svg" mode="aspectFit" />
          <text class="hero-detail-text hero-detail-value">{{order.customerName}}</text>
        </view>
        <view class="hero-detail-row hero-shop-row">
          <image class="hero-detail-icon" src="/static/icons/shop.svg" mode="aspectFit" />
          <text class="hero-detail-text hero-detail-value">{{order._shopName || order.shopName || '未设置店铺'}}</text>
        </view>
        <view class="hero-detail-row hero-price-row"><image class="hero-detail-icon" src="/static/icons/wallet.svg" mode="aspectFit" /><text class="hero-detail-text hero-detail-value semantic-money">{{order._priceText}}</text></view>
        <view class="hero-detail-row hero-deposit-row"><image class="hero-detail-icon" src="/static/icons/status-progress.svg" mode="aspectFit" /><text class="hero-detail-text hero-detail-value">{{order._depositText}}</text></view>
      </view>
    </view>

    <view class="hero-card-actions">
      <view class="hero-action-btn" catchtap="message" role="button" aria-label="给客户发消息">
        <view class="hero-action-surface">
          <image class="hero-action-icon" src="/static/icons/tab-chat.svg" mode="aspectFit" />
          <text>发送消息</text>
        </view>
      </view>
      <view wx:if="{{order.customerPhone}}" class="hero-action-btn" catchtap="contact" role="button" aria-label="拨打客户电话">
        <view class="hero-action-surface">
          <image class="hero-action-icon" src="/static/icons/phone-active.svg" mode="aspectFit" />
          <text>拨打电话</text>
        </view>
      </view>
      <view class="hero-action-btn hero-action-primary" catchtap="open" role="button" aria-label="查看预约详情">
        <view class="hero-action-surface">查看详情</view>
      </view>
    </view>
  </view>
</view>

<view wx:elif="{{variant === 'confirmation'}}" class="booking-card booking-card-compact booking-card-confirmation">
  <view class="confirmation-card-open" bindtap="open" role="button" aria-label="查看{{order.customerName}}的预约详情">
    <view class="booking-main">
      <view class="time-col">
        <text wx:if="{{order._cardDate}}" class="date">{{order._cardDate}}</text>
        <text class="time">{{order._clock}}</text>
        <text wx:if="{{order._cardWeekday}}" class="weekday">{{order._cardWeekday}}</text>
      </view>
      <view class="content">
        <view class="title-row">
          <view class="customer-row">
            <text class="customer">{{order.customerName || '客户'}}</text>
            <text class="service-type-tag {{order.serviceType === 'home' || order._typeLabel === '上门美甲' ? 'tag-home' : 'tag-shop'}}">{{order.serviceType === 'home' || order._typeLabel === '上门美甲' ? '上门美甲' : '到店美甲'}}</text>
          </view>
          <text class="status {{order._statusTone || 'tone-red'}}">{{order.status === 'pending_quote' ? '待报价' : '待我确认'}}</text>
        </view>
        <view class="service-media-row">
          <view class="service-info-col">
            <text class="service">{{order.serviceName || order._serviceTypeLabel || '预约服务'}}</text>
            <view class="price-deposit-line">
              <text wx:if="{{order._priceText}}" class="price semantic-money">{{order._priceText}}</text>
              <text wx:elif="{{order.status === 'pending_quote'}}" class="price price-pending">待报价</text>
              <text wx:if="{{order._depositText}}" class="deposit-tag">{{order._depositText}}</text>
            </view>
          </view>
          <image wx:if="{{order._coverUrl || order.coverUrl}}" class="confirmation-thumb" src="{{order._coverUrl || order.coverUrl}}" mode="aspectFill" lazy-load aria-label="预约款式参考图" />
        </view>
      </view>
    </view>
    <view wx:if="{{order.serviceType === 'home' ? (order._cleanAddress || order.address) : (order._shopName || order.shopName)}}" class="address-row">
      <image class="meta-icon" src="{{order.serviceType === 'home' ? '/static/icons/pin.svg' : '/static/icons/shop.svg'}}" mode="aspectFit" />
      <text class="address">{{order.serviceType === 'home' ? (order._cleanAddress || order.address) : (order._shopName || order.shopName)}}</text>
    </view>
  </view>
  <view class="confirmation-actions {{order.status === 'pending_quote' ? 'confirmation-actions-quote' : ''}}">
    <block wx:if="{{order.status === 'pending_quote'}}">
      <view class="confirmation-button confirmation-button-tertiary" catchtap="open" role="button" aria-label="查看预约详情">查看详情</view>
      <view class="confirmation-button confirmation-button-primary" catchtap="quote" role="button" aria-label="立即报价">立即报价</view>
    </block>
    <block wx:else>
      <view class="confirmation-button confirmation-button-secondary" catchtap="refuse" role="button" aria-label="拒绝排期">拒绝排期</view>
      <view class="confirmation-button confirmation-button-primary" catchtap="confirm" role="button" aria-label="确认排期">确认排期</view>
      <view class="confirmation-button confirmation-button-tertiary" catchtap="open" role="button" aria-label="查看预约详情">查看详情</view>
    </block>
  </view>
</view>

<view wx:elif="{{variant === 'unread-messages'}}" class="booking-card booking-card-compact booking-card-unread-messages">
  <view class="msg-card-content">
    <view class="msg-card-head">
      <view class="msg-card-head-left">
        <image class="msg-card-icon" src="/static/icons/tab-chat.svg" mode="aspectFit" />
        <text class="msg-card-title">最新客户消息</text>
      </view>
    </view>

    <view wx:if="{{unreadConversations && unreadConversations.length > 0}}" class="msg-conv-list">
      <view
        wx:for="{{unreadConversations}}"
        wx:key="conversationId"
        class="msg-conv-item"
        catchtap="openConversation"
        data-item="{{item}}"
        role="button"
        aria-label="{{item.clientName}}发来的消息"
      >
        <view class="msg-avatar-wrap">
          <image wx:if="{{item.clientAvatar}}" class="msg-avatar" src="{{item.clientAvatar}}" mode="aspectFill" />
          <view wx:else class="msg-avatar-fallback">{{item._avatarChar}}</view>
          <view wx:if="{{item.unreadCount > 1}}" class="msg-conv-unread-dot">{{item.unreadCount}}</view>
        </view>
        <view class="msg-conv-body">
          <view class="msg-conv-row">
            <text class="msg-conv-name">{{item.clientName}}</text>
            <text wx:if="{{item.time}}" class="msg-conv-time">{{item.time}}</text>
          </view>
          <text class="msg-conv-preview">{{item.preview}}</text>
        </view>
      </view>
    </view>
    <view wx:else class="msg-conv-empty">
      <text class="msg-empty-text">您有 {{unreadCount}} 条客户消息待回复，点击下方按钮立即处理。</text>
    </view>
  </view>

  <view class="msg-card-actions">
    <view class="msg-action-btn confirmation-button-primary" catchtap="openMessages" role="button" aria-label="查看全部消息">
      查看全部消息 ›
    </view>
  </view>
</view>

<view wx:elif="{{variant === 'schedule'}}" class="schedule-card">
  <view class="schedule-card-body" bindtap="open" role="button" aria-label="查看{{order.customerName || '客户'}}的预约详情">
    <view class="schedule-date-box">
      <text class="schedule-date-sub">{{order._cardDate}}</text>
      <text class="schedule-time">{{order._clock}}</text>
      <text class="schedule-weekday">{{order._cardWeekday}}</text>
    </view>
    <view class="schedule-details">
      <view class="schedule-title-row">
        <text class="schedule-customer">{{order.customerName || '客户'}}</text>
        <text class="schedule-status {{order._statusTone}}">{{order._statusLabel}}</text>
        <image wx:if="{{!order._hasScheduleActions}}" class="schedule-arrow" src="/static/icons/arrow-right.svg" mode="aspectFit" />
      </view>
      <view class="schedule-info-row">
        <text class="schedule-info-label">来源</text>
        <text class="schedule-info-value">{{order._sourceLabel}}</text>
      </view>
      <view class="schedule-info-row">
        <text class="schedule-info-label">项目</text>
        <text class="schedule-info-value">{{order._serviceLabel}}</text>
      </view>
      <view class="schedule-info-row">
        <text class="schedule-info-label">门店</text>
        <text class="schedule-info-value">{{order._shopName}}</text>
      </view>
      <view wx:if="{{order._notes}}" class="schedule-info-row schedule-note-row">
        <text class="schedule-info-label">备注</text>
        <text class="schedule-info-value schedule-note">{{order._notes}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{order._hasScheduleActions}}" class="schedule-actions">
    <block wx:if="{{order._actionStatus === 'pending_quote'}}">
      <view class="schedule-action schedule-action-danger" catchtap="reject" role="button" aria-label="驳回预约">驳回预约</view>
      <view class="schedule-action schedule-action-primary" catchtap="quote" role="button" aria-label="立即报价">立即报价</view>
    </block>
    <block wx:elif="{{order._actionStatus === 'pending_agree'}}">
      <view class="schedule-action schedule-action-secondary" catchtap="withdrawQuote" role="button" aria-label="取消报价">取消报价</view>
      <view class="schedule-action schedule-action-primary" catchtap="quote" role="button" aria-label="编辑报价">编辑报价</view>
    </block>
    <block wx:elif="{{order._actionStatus === 'pending_confirm'}}">
      <view class="schedule-action schedule-action-secondary" catchtap="reject" role="button" aria-label="驳回申请">驳回申请</view>
      <view class="schedule-action schedule-action-primary" catchtap="confirm" role="button" aria-label="同意预约">同意预约</view>
    </block>
    <block wx:elif="{{order._actionStatus === 'pending_shop'}}">
      <view class="schedule-action schedule-action-secondary" catchtap="editBooking" role="button" aria-label="编辑预约">编辑预约</view>
      <view class="schedule-action schedule-action-danger" catchtap="cancel" role="button" aria-label="取消预约">取消预约</view>
    </block>
    <block wx:elif="{{order._actionStatus === 'in_progress'}}">
      <view class="schedule-action schedule-action-secondary" catchtap="open" role="button" aria-label="查看预约详情">预约详情</view>
      <view class="schedule-action schedule-action-primary" catchtap="complete" role="button" aria-label="确认完成">确认完成</view>
    </block>
    <block wx:elif="{{order.status === 'completed'}}">
      <view class="schedule-action schedule-action-secondary" catchtap="open" role="button" aria-label="查看预约详情">预约详情</view>
      <view wx:if="{{!order._hasWork}}" class="schedule-action schedule-action-secondary" catchtap="uploadWork" role="button" aria-label="上传作品">上传作品</view>
      <view wx:else class="schedule-action schedule-action-secondary" catchtap="viewWork" role="button" aria-label="查看作品">查看作品</view>
      <view class="schedule-action schedule-action-primary" catchtap="record" role="button" aria-label="{{order._recordCompleted ? '美甲记录' : '完善美甲记录'}}">{{order._recordCompleted ? '美甲记录' : '完善美甲记录'}}</view>
    </block>
  </view>
  <booking-confirm wx:if="{{confirming}}" order="{{confirming}}" bind:close="closeConfirmDialog" bind:saved="onConfirmDialogSaved" />
</view>

<view wx:else class="booking-card booking-card-compact" bindtap="open" role="button" aria-label="查看{{order.customerName}}的预约详情">
  <view class="booking-main">
    <view class="time-col">
      <text wx:if="{{order._cardDate}}" class="date">{{order._cardDate}}</text>
      <text class="time">{{order._clock}}</text>
      <text wx:if="{{order._cardWeekday}}" class="weekday">{{order._cardWeekday}}</text>
    </view>
    <view class="content">
      <view class="title-row">
        <text class="customer">{{order.customerName}}</text>
        <text class="status {{order._statusTone || order._stateTone}}">{{order._statusLabel || order._stateLabel}}</text>
      </view>
      <text class="service">{{order.serviceName}}</text>
      <text wx:if="{{order._priceText}}" class="price semantic-money">{{order._priceText}}</text>
    </view>
  </view>

  <view wx:if="{{order._fullAddress || order.address}}" class="address-row">
    <image class="meta-icon" src="/static/icons/pin.svg" mode="aspectFit" />
    <text class="address">{{order._fullAddress || order.address}}</text>
  </view>

  <view wx:if="{{order._hasConflict}}" class="conflict">与当日其他预约时间重叠</view>

  <view class="actions">
    <view wx:if="{{order.status === 'completed'}}" class="action" catchtap="message" role="button" aria-label="发送消息">
      <view class="action-surface"><image class="action-icon" src="/static/icons/tab-chat.svg" mode="aspectFit" /><text>发送消息</text></view>
    </view>
    <view wx:else class="action" catchtap="navigate" role="button" aria-label="开始导航">
      <view class="action-surface"><image class="action-icon" src="/static/icons/navigation.svg" mode="aspectFit" /><text>导航</text></view>
    </view>
    <view class="action" catchtap="contact" role="button" aria-label="拨打电话">
      <view class="action-surface"><image class="action-icon" src="/static/icons/phone-active.svg" mode="aspectFit" /><text>拨打电话</text></view>
    </view>
    <view wx:if="{{order.status === 'completed'}}" class="action" catchtap="open" role="button" aria-label="查看详情">
      <view class="action-surface action-surface-primary"><text>查看详情</text></view>
    </view>
  </view>
</view>
