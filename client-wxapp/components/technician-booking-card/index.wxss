.booking-card { color:var(--nb-ink); }
.booking-main { display:flex; align-items:flex-start; gap:24rpx; }
.time-col { width:120rpx; flex-shrink:0; }
.date { display:block; color:var(--nb-muted); font-size:24rpx; font-weight:500; }
.time { display:block; margin-top:4rpx; color:var(--nb-ink); font-size:40rpx; line-height:1.1; font-weight:700; font-variant-numeric:tabular-nums; }
.content { flex:1; min-width:0; padding-top:2rpx; }
.title-row { display:flex; align-items:center; justify-content:space-between; gap:12rpx; }
.customer { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:30rpx; font-weight:700; }
.status { flex-shrink:0; padding:6rpx 14rpx; border-radius:999rpx; background:var(--nb-page); color:var(--nb-ink); font-size:22rpx; }
.service { display:block; margin-top:8rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--nb-secondary); font-size:24rpx; }
.price { display:block; margin-top:8rpx; color:var(--nb-money); font-size:24rpx; font-weight:700; font-variant-numeric:tabular-nums; }
.tone-orange, .tone-purple, .tone-yellow, .tone-sky { background:var(--nb-soft-surface); color:var(--nb-text-link); }
.tone-emerald, .tone-teal { background:var(--nb-success-surface); color:var(--nb-success); }
.tone-gray { background:var(--nb-page); color:var(--nb-secondary); }
.tone-red { background:var(--nb-danger-surface); color:var(--nb-danger); }
.state-pending, .state-in-progress { background:var(--nb-soft-surface); color:var(--nb-text-link); }
.state-completed { background:var(--nb-page); color:var(--nb-secondary); }
.address-row { display:flex; align-items:flex-start; gap:10rpx; margin-top:16rpx; }
.meta-icon { width:26rpx; height:26rpx; margin-top:2rpx; flex-shrink:0; }
.address { flex:1; color:var(--nb-muted); font-size:24rpx; line-height:1.45; }
.conflict { margin-top:14rpx; padding:14rpx 18rpx; border-radius:12rpx; background:var(--nb-page); color:var(--nb-ink); font-size:22rpx; font-weight:600; }
.actions { display:flex; gap:12rpx; margin-top:18rpx; }
.action { flex:1; min-height:88rpx; box-sizing:border-box; display:flex; align-items:center; justify-content:center; gap:10rpx; border-radius:999rpx; font-size:26rpx; font-weight:600; }
.action:active { opacity:.76; }
.action-primary { background:var(--nb-action); color:var(--nb-surface); }
.action-secondary { border: 0; background: var(--nb-soft-surface); color:var(--nb-ink); }
.action-icon { width:28rpx; height:28rpx; }
.booking-card-compact { padding:28rpx; border: 0; border-radius:28rpx; background:var(--nb-surface); box-shadow:0 10rpx 28rpx rgba(0, 0, 0, .07); }
.booking-card-compact .booking-main { align-items:center; gap:20rpx; }
.booking-card-compact .time-col { width:140rpx; min-height:128rpx; padding:12rpx 4rpx; box-sizing:border-box; display:flex; flex-direction:column; gap:6rpx; align-items:center; justify-content:center; border-radius:20rpx; background:var(--nb-page); }
.booking-card-compact .date { display:block; font-size:22rpx; color:var(--nb-secondary); }
.weekday { display:block; font-size:22rpx; color:var(--nb-secondary); }
.booking-card-compact .time { margin-top:0; color:var(--nb-ink); font-size:32rpx; }
.booking-card-compact .customer { font-size:28rpx; }
.booking-card-compact .service { margin-top:10rpx; line-height:1.45; white-space:normal; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
.booking-card-compact .price { margin-top:10rpx; }
.booking-card-compact .address-row { align-items:center; margin-top:18rpx; padding:16rpx 18rpx; border-radius:18rpx; background:var(--nb-page); }
.booking-card-compact .actions { margin-top:16rpx; }
.booking-card-compact .action { min-width:0; min-height:44px; padding:0; border-radius:8px; font-size:24rpx; }
.action-surface { width:100%; height:44px; display:flex; align-items:center; justify-content:center; gap:6rpx; border-radius:8px; background:var(--nb-page); color:var(--nb-ink); }
.action-surface-primary { background:var(--nb-action); color:var(--nb-inverse); }
.action-surface .action-icon { width:14px; height:14px; flex-shrink:0; }
.booking-card-compact .action-primary { border: 0; background:var(--nb-page); color:var(--nb-secondary); box-shadow:none; }
.booking-card-compact .action-secondary { background:var(--nb-surface); }
.booking-card-confirmation { padding:0; overflow:hidden; box-shadow:none; background:var(--nb-page); }
.confirmation-card-open { padding:24rpx; }
.confirmation-card-open:active { opacity:.78; }
.booking-card-confirmation .time-col { background:var(--nb-surface); }
.booking-card-confirmation .status { color:var(--nb-secondary); background:var(--nb-surface); }
.booking-card-confirmation .address-row { margin:18rpx 0 0; background:var(--nb-surface); }
.confirmation-actions { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12rpx; padding:0 24rpx 24rpx; }
.confirmation-button { min-width:0; height:44px; box-sizing:border-box; display:flex; align-items:center; justify-content:center; border-radius:8px; font-size:24rpx; font-weight:var(--weight-semibold); white-space:nowrap; }
.confirmation-button:active { opacity:.72; transform:scale(.98); }
.confirmation-button-secondary { border:2rpx solid var(--nb-line); background:var(--nb-surface); color:var(--nb-danger); }
.confirmation-button-primary { border:2rpx solid var(--nb-action); background:var(--nb-action); color:var(--nb-inverse); }
.confirmation-button-tertiary { border:2rpx solid transparent; background:var(--nb-soft-surface); color:var(--nb-secondary); }
.booking-card-hero {
  border-radius: var(--radius-xl);
  overflow: hidden;
  background: var(--nb-surface);
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.08);
  color: var(--nb-ink);
}
.booking-card-hero:active { opacity: 0.96; transform: scale(0.995); }

.hero-card-content { padding: var(--space-xl) var(--space-xl) var(--space-sm); }

/* 顶部：状态 + 倒计时 */
.hero-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-md);
}
.hero-card-label-area {
  flex-shrink: 0;
}
.hero-status-stack {
  margin-left: auto;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  text-align: right;
}
.hero-card-title {
  display: block;
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--nb-ink);
  line-height: 1.2;
}
.hero-card-sub {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-xs);
  color: var(--nb-muted);
}
.hero-status-badge {
  display: inline-flex; align-items: center;
  padding: var(--space-xs) 22rpx;
  border-radius: var(--radius-md);
  background: var(--nb-soft-surface);
  border: 0;
  font-size: var(--font-xs); font-weight: var(--weight-medium);
  color: var(--nb-ink);
}
.hero-status-badge.tone-orange,
.hero-status-badge.tone-purple,
.hero-status-badge.tone-yellow,
.hero-status-badge.tone-sky { background: var(--nb-soft-surface); color: var(--nb-text-link); }
.hero-status-badge.tone-emerald,
.hero-status-badge.tone-teal { background: var(--nb-success-surface); color: var(--nb-success); }
.hero-status-badge.tone-red { background: var(--nb-danger-surface); color: var(--nb-danger); }
.hero-status-badge.tone-gray { background: var(--nb-page); color: var(--nb-secondary); }
.hero-countdown-value { font-size: 22rpx; color: var(--nb-muted); font-weight: var(--weight-medium); }

/* 主体：日期方块 + 详情 */
.hero-card-body {
  display: flex; align-items: flex-start; gap: var(--space-lg);
  margin-bottom: var(--space-sm);
}
.hero-date-box {
  width: 168rpx; min-height: 176rpx; flex-shrink: 0;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  background: var(--nb-soft-surface);
  border: 0;
  border-radius: var(--space-lg);
}
.hero-date-month,
.hero-date-weekday { font-size: var(--font-xs); color: var(--nb-muted); font-weight: var(--weight-medium); }
.hero-date-day {
  font-size: 56rpx; font-weight: var(--weight-bold);
  color: var(--nb-ink); line-height: 1;
  margin: 6rpx 0;
}

.hero-details {
  flex: 1; min-width: 0;
  display: flex; flex-direction: column; gap: 10rpx;
  padding-top: 2rpx;
}
.hero-detail-row {
  display: flex; align-items: flex-start; gap: 8rpx;
  line-height: var(--leading-normal);
}
.hero-detail-icon {
  width: 24rpx; height: 24rpx; margin-top: 4rpx; flex-shrink: 0;
}
.hero-detail-text { font-size: 24rpx; color: var(--nb-secondary); }
.hero-detail-value { flex: 1; min-width: 0; }
.hero-time-range-row { margin-bottom: 6rpx; align-items: center; }
.hero-time-range-row .hero-detail-icon { width: 28rpx; height: 28rpx; margin-top: 0; }
.hero-time-range-row .hero-detail-value { color: var(--nb-ink); font-size: 32rpx; line-height: 1.2; font-weight: var(--weight-bold); font-variant-numeric: tabular-nums; }
.hero-price-row .hero-detail-value { font-weight: var(--weight-semibold); }

/* 底部操作 */
.hero-card-actions {
  display: flex; gap: 12rpx;
  padding-top: 16rpx;
  border-top: 0;
}
.hero-action-btn {
  flex: 1; min-width: 0; min-height: 44px;
  display: flex; align-items: center; justify-content: center;
}
.hero-action-surface {
  width: 100%; height: 44px; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center; gap: 6rpx;
  background: var(--nb-soft-surface);
  color: var(--nb-ink);
  border-radius: 8px;
  font-size: 24rpx; font-weight: var(--weight-semibold);
  border: 0;
}
.hero-action-btn:active .hero-action-surface { opacity: 0.82; transform: scale(0.98); }
.hero-action-icon { width: 14px; height: 14px; flex-shrink:0; }
.hero-action-primary .hero-action-surface {
  background: var(--nb-action);
  color: var(--nb-inverse);
  font-weight: var(--weight-semibold);
  border: none; box-shadow: none;
}
.hero-action-primary:active .hero-action-surface { opacity: 0.9; }
.booking-card-message { width:510rpx; max-width:100%; box-sizing:border-box; overflow:hidden; border: 0; border-radius:24rpx; background:var(--nb-surface); box-shadow:0 8rpx 24rpx rgba(0, 0, 0, .07); color:var(--nb-ink); }
.booking-card-message:active { background:var(--nb-page); }
.message-head { display:flex; align-items:center; gap:12rpx; padding:24rpx 26rpx 0; }
.message-icon { width:36rpx; height:36rpx; flex-shrink:0; }
.message-title { font-size:26rpx; font-weight:700; }
.message-tag { margin-left:auto; padding:4rpx 12rpx; border-radius:999rpx; background:var(--nb-page); color:var(--nb-muted); font-size:22rpx; }
.message-content { display:block; padding:16rpx 26rpx 20rpx; color:var(--nb-secondary); font-size:26rpx; line-height:1.65; white-space:pre-line; }
.message-footer { min-height:88rpx; margin:0 26rpx; border-top: 0; display:flex; align-items:center; justify-content:space-between; color:var(--nb-secondary); font-size:26rpx; font-weight:600; }
.message-arrow { width:28rpx; height:28rpx; flex-shrink:0; }

@import '../../styles/semantic-actions.wxss';
