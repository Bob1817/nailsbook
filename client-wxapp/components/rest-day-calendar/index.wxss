.overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1200;
  background: rgba(0, 0, 0, 0.4);
}

.sheet {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  max-height: 90vh;
  background: var(--bg-card);
  border-radius: var(--btn-radius) 48rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.sheet-header {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 40rpx;
  background: var(--bg-card);
  border-bottom: 0;
}

.nav-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-input);
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-btn:active { background: var(--bg-input); }
.nav-icon { font-size: var(--font-lg); color: var(--text-body); font-weight: var(--weight-semibold); }

.month-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
}

.calendar-body {
  flex: 1;
  overflow-y: auto;
  padding: var(--space-md) 32rpx;
}

.weekday-row {
  display: flex;
  margin-bottom: var(--space-sm);
}
.weekday-cell {
  flex: 1;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--text-muted);
  font-weight: var(--weight-medium);
}

.day-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-cell {
  width: calc(100% / 7);
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.day-inner {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}

.day-inner:active { background: var(--bg-input); }

.day-num {
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  color: var(--text-primary);
}

.day-past .day-num {
  color: var(--text-muted);
}
.day-past:active { background: transparent; }

.day-selected {
  background: var(--brand-gradient);
}
.day-selected .day-num {
  color: var(--text-inverse);
  font-weight: var(--weight-bold);
}
.day-selected:active { opacity: 0.85; }

.sheet-footer {
  display: flex;
  gap: 20rpx;
  padding: var(--space-md) 40rpx calc(32rpx + env(safe-area-inset-bottom));
  border-top: 0;
}

.btn-cancel {
  flex: 1;
  height: 88rpx;
  border-radius: var(--btn-radius);
  background: var(--bg-input);
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-cancel:active { background: var(--nb-page); }
.btn-cancel-text { font-size: var(--font-md); font-weight: var(--weight-medium); color: var(--text-body); }

.btn-confirm {
  flex: 1;
  height: 88rpx;
  border-radius: var(--btn-radius);
  background: var(--brand-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-confirm:active { opacity: 0.85; }
.btn-confirm-text { font-size: var(--font-md); font-weight: var(--weight-medium); color: var(--text-inverse); }
