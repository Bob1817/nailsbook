.overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1200;
  background: rgba(0, 0, 0, 0.4);
}

.sheet {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  max-height: 90vh;
  background: #ffffff;
  border-radius: 48rpx 48rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.sheet-header {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 40rpx;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f9fafb;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-btn:active { background: #f3f4f6; }
.nav-icon { font-size: 36rpx; color: #374151; font-weight: 600; }

.month-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.calendar-body {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx 32rpx;
}

.weekday-row {
  display: flex;
  margin-bottom: 16rpx;
}
.weekday-cell {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
  font-weight: 500;
}

.day-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-cell {
  width: calc(100% / 7);
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.day-inner {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.day-inner:active { background: #f3f4f6; }

.day-num {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2937;
}

.day-past .day-num {
  color: #d1d5db;
}
.day-past:active { background: transparent; }

.day-selected {
  background: linear-gradient(135deg, #ff6b8a, #8b5cf6);
}
.day-selected .day-num {
  color: #ffffff;
  font-weight: 700;
}
.day-selected:active { opacity: 0.85; }

.sheet-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.btn-cancel {
  flex: 1;
  height: 88rpx;
  border-radius: 48rpx;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-cancel:active { background: #e5e7eb; }
.btn-cancel-text { font-size: 28rpx; font-weight: 500; color: #374151; }

.btn-confirm {
  flex: 1;
  height: 88rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #ff6b8a, #8b5cf6);
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-confirm:active { opacity: 0.85; }
.btn-confirm-text { font-size: 28rpx; font-weight: 500; color: #ffffff; }
