/* 兼容原 inline 模式 */
.poster-button { min-height: 88rpx; padding: var(--space-sm) var(--space-md); font-size: var(--font-md); line-height: 1.5; color: var(--nb-text-link); background: var(--nb-page); border: 0; border-radius: var(--radius-md); }
.poster-button::after { border: 0; }
.copy-button { min-height: 88rpx; font-size: var(--font-sm); color: var(--nb-text-link); background: transparent; border: 0; }
.copy-button::after { border: 0; }
.poster-button:active { opacity: .7; }
.poster-hint { display: block; margin: 12rpx 0 var(--space-md); text-align: center; font-size: var(--font-xs); color: var(--nb-secondary); }
.poster-canvas { position: fixed; left: -2000px; top: 0; pointer-events: none; }

/* 底部营销弹窗与遮罩 */
.wsp-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.wsp-sheet {
  background: var(--nb-surface);
  border-radius: 32rpx 32rpx 0 0;
  padding: var(--space-sm) var(--space-lg) calc(var(--space-lg) + env(safe-area-inset-bottom));
  max-height: 85vh;
  box-sizing: border-box;
}

.wsp-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--nb-line);
  margin: 12rpx auto 20rpx;
}

.wsp-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-sm);
  padding-bottom: var(--space-md);
  border-bottom: 1rpx solid var(--nb-line);
}

.wsp-header-info {
  display: flex;
  flex-direction: column;
}

.wsp-title {
  font-size: var(--font-lg, 34rpx);
  font-weight: var(--weight-semibold, 600);
  color: var(--nb-ink);
  line-height: 1.3;
}

.wsp-subtitle {
  margin-top: var(--space-xs);
  font-size: var(--font-xs, 22rpx);
  color: var(--nb-secondary);
  line-height: 1.4;
}

.wsp-close-btn {
  width: 64rpx;
  height: 64rpx;
  min-height: 44px;
  min-width: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wsp-close-icon {
  width: var(--icon-sm);
  height: var(--icon-sm);
}

.wsp-close-btn:active {
  opacity: 0.6;
}

/* 渠道卡片 */
.wsp-card {
  margin-top: var(--space-md);
  padding: var(--space-md);
  background: var(--nb-soft-surface);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--nb-line);
  box-sizing: border-box;
}

.wsp-card-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.wsp-badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-xs);
  font-size: var(--font-xs);
  font-weight: var(--weight-medium, 500);
  background: var(--nb-surface);
  color: var(--nb-ink);
  border: 1rpx solid var(--nb-line);
}

.wsp-channel-title {
  font-size: var(--font-md, 28rpx);
  font-weight: var(--weight-semibold, 600);
  color: var(--nb-ink);
}

.wsp-card-desc {
  display: block;
  margin: 12rpx 0 20rpx;
  font-size: var(--font-xs, 22rpx);
  color: var(--nb-secondary);
  line-height: 1.4;
}

.wsp-btn-row {
  display: flex;
  gap: var(--space-sm);
}

.wsp-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: var(--font-sm, 26rpx);
  font-weight: var(--weight-medium, 500);
  box-sizing: border-box;
  margin: 0;
  padding: 0 var(--space-md);
  border: 0;
}

.wsp-btn::after {
  border: 0;
}

.wsp-btn-flex {
  flex: 1;
}

.wsp-btn-primary {
  background: var(--nb-action);
  color: var(--nb-surface);
}

.wsp-btn-secondary {
  background: var(--nb-surface);
  color: var(--nb-ink);
  border: 1rpx solid var(--nb-line);
}

.wsp-btn-hover {
  opacity: 0.8;
}
