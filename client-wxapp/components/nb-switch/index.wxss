.switch-hitbox { width:88rpx; min-width:88rpx; height:88rpx; min-height:88rpx; margin:0; padding:0; border:0; border-radius:0; background:transparent; display:flex; align-items:center; justify-content:flex-end; flex-shrink:0; line-height:1; box-sizing:border-box; }
.switch-hitbox::after { border:0; }.switch-track { position:relative; width:72rpx; height:40rpx; border-radius:20rpx; background:var(--nb-secondary); transition:background .16s ease; }.switch-track.is-on { background:var(--nb-success); }.switch-track.is-disabled { opacity:.5; }
.switch-thumb { position:absolute; left:4rpx; top:4rpx; width:32rpx; height:32rpx; border-radius:50%; background:var(--nb-inverse); transition:transform .16s ease; }.switch-track.is-on .switch-thumb { transform:translateX(32rpx); }.switch-hitbox:active .switch-track { opacity:.8; }
