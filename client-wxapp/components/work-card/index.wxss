@import '../../styles/tokens.wxss';

/* 统一作品卡：清晰卡面承载视觉内容，操作区按角色切换 */
.wc-editorial { width:100%; min-width:0; max-width:100%; overflow:hidden; color:#282326; background:#fff; border:2rpx solid #e6dfe2; border-radius:24rpx; box-sizing:border-box; box-shadow:0 2rpx 5rpx rgba(48,38,42,.08),0 10rpx 28rpx rgba(48,38,42,.11); }
.wc-editorial:active { opacity:.94; }
.wc-editorial-media { position:relative; width:100%; height:0; overflow:hidden; background:#f0ece9; }
.aspect-featured { padding-bottom:64%; }
.aspect-grid { padding-bottom:112%; }
.wc-editorial-img { position:absolute; inset:0; width:100%; height:100%; }
.wc-status-icons { position:absolute; z-index:2; left:12rpx; top:12rpx; right:100rpx; display:flex; flex-direction:column; align-items:flex-start; gap:7rpx; }
.wc-status-pill { min-height:38rpx; padding:0 10rpx; display:flex; align-items:center; gap:5rpx; color:#fff; background:rgba(255,79,94,.92); border:0; border-radius:999rpx; font-size:17rpx; font-weight:600; box-shadow:0 3rpx 10rpx rgba(63,34,40,.18); }
.wc-status-icon { width:21rpx; height:21rpx; }
.wc-manage { position:absolute; z-index:3; right:0; top:0; width:88rpx; height:88rpx; padding:17rpx 12rpx 0 0; display:flex; align-items:flex-start; justify-content:flex-end; background:transparent; border:0; box-sizing:border-box; }
.wc-manage-icon { width:28rpx; height:28rpx; filter:drop-shadow(0 2rpx 5rpx rgba(255,255,255,.9)); }
.wc-manage:active { opacity:.72; transform:scale(.96); }
.wc-price-pill { position:absolute; z-index:2; left:14rpx; bottom:14rpx; max-width:70%; min-height:52rpx; padding:0 18rpx; display:flex; align-items:center; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#fff; background:rgba(38,27,32,.62); border:0; border-radius:999rpx; box-shadow:0 5rpx 16rpx rgba(28,18,23,.24); -webkit-backdrop-filter:blur(18rpx) saturate(135%); backdrop-filter:blur(18rpx) saturate(135%); text-shadow:0 2rpx 5rpx rgba(0,0,0,.34); font-family:var(--font-display); font-size:27rpx; font-weight:800; }
.wc-editorial-copy { padding:18rpx 18rpx 16rpx; }
.wc-featured .wc-editorial-copy { padding:22rpx 24rpx 18rpx; }
.wc-editorial-title { display:block; width:100%; min-width:0; color:#282326; font-family:var(--font-display); font-size:27rpx; font-weight:650; line-height:1.35; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.wc-featured .wc-editorial-title { font-size:32rpx; }
.wc-editorial-artist { width:100%; min-width:0; min-height:58rpx; margin-top:13rpx; display:flex; align-items:center; gap:10rpx; box-sizing:border-box; overflow:hidden; }
.wc-editorial-avatar { width:46rpx; height:46rpx; border-radius:50%; flex-shrink:0; background:#eee9eb; }
.wc-featured .wc-editorial-avatar { width:52rpx; height:52rpx; }
.wc-editorial-avatar-fallback { display:flex; align-items:center; justify-content:center; color:#9d466d; font-size:20rpx; font-weight:600; }
.wc-editorial-artist-copy { flex:1; min-width:0; display:flex; align-items:baseline; gap:7rpx; overflow:hidden; }
.wc-editorial-name { flex-shrink:0; max-width:48%; color:#423a3e; font-size:21rpx; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.wc-artist-separator { flex-shrink:0; color:#b0a8ab; font-size:18rpx; }
.wc-editorial-expertise { min-width:0; color:#999095; font-size:18rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; line-height:1.35; }
.wc-client-actions { min-height:96rpx; padding:8rpx 12rpx 12rpx; border-top:1rpx solid #eee8ea; display:flex; align-items:stretch; gap:8rpx; box-sizing:border-box; }
.wc-client-tools { flex:0 0 auto; min-height:88rpx; display:flex; align-items:stretch; gap:2rpx; }
.wc-client-action { width:64rpx; min-width:64rpx; min-height:88rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:3rpx; color:#71696c; font-size:17rpx; border-radius:14rpx; }
.wc-client-action:active { background:#f9f3f5; }
.wc-client-action.is-active { color:#ff4f5e; }
.wc-client-action-icon { width:29rpx; height:29rpx; }
.wc-book-same { flex:1; min-width:112rpx; min-height:88rpx; padding:0; display:flex; align-items:center; justify-content:center; color:#fff; border-radius:16rpx; font-size:19rpx; font-weight:650; white-space:nowrap; }
.wc-book-label { width:100%; height:64rpx; display:flex; align-items:center; justify-content:center; background:#ff4f5e; border-radius:14rpx; box-shadow:0 6rpx 14rpx rgba(255,79,94,.22); box-sizing:border-box; }
.wc-book-same:active .wc-book-label { background:#e94655; transform:scale(.98); }
.wc-featured .wc-client-actions { padding:12rpx 18rpx 16rpx; gap:10rpx; }
.wc-featured .wc-client-action { font-size:20rpx; }
.wc-featured .wc-client-tools { gap:6rpx; }
.wc-featured .wc-client-action { width:80rpx; min-width:80rpx; }
.wc-featured .wc-book-same { font-size:24rpx; }
.wc-featured .wc-book-label { height:72rpx; }

/* ===== 作品卡片根容器 ===== */
.wc-root {
  position: relative; width: 100%; height: 0;
  overflow: hidden;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

/* 宽高比变体（外层 work-card 包装 + wc-root 自身均可用） */
.work-card {
  -webkit-break-inside: avoid;
  break-inside: avoid;
  margin-bottom: var(--space-sm);
}
.work-card:active { opacity: 0.95; }

.aspect-3-4 { padding-bottom: 133.33%; }
.aspect-4-5 { padding-bottom: 125%; }
.aspect-5-6 { padding-bottom: 120%; }
.aspect-2-3 { padding-bottom: 150%; }
.work-card-tall { padding-bottom: 133.33%; }
.work-card-short { padding-bottom: 125%; }

/* 图片 */
.wc-img {
  position: absolute; top: 0; left: 0;
  width: 100%; height: 100%;
}
.wc-img-empty {
  position: absolute; top: 0; left: 0;
  width: 100%; height: 100%;
  background: linear-gradient(135deg, #f1e8f0, #e8eaf6);
}

/* 渐变遮罩 */
.wc-gradient {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg,
    rgba(0, 0, 0, 0.25) 0%,
    transparent 35%,
    transparent 50%,
    rgba(0, 0, 0, 0.72) 100%
  );
  z-index: 1;
}

/* ===== 顶部：美甲师 pill + 点赞 ===== */
.wc-top {
  position: absolute; top: 0; left: 0; right: 0;
  padding: 14rpx 14rpx 0;
  display: flex; align-items: center; justify-content: space-between;
  z-index: 2;
}

.wc-tech-pill {
  display: flex; align-items: center; gap: var(--space-xs);
  background: rgba(0, 0, 0, 0.32);
  padding: 7rpx 14rpx 7rpx 7rpx;
  border-radius: var(--radius-lg);
  max-width: 68%;
}
.wc-tech-pill:active { opacity: 0.75; }

.wc-tech-copy {
  display: flex; flex-direction: column; gap: 1rpx;
  min-width: 0;
}

.wc-tech-av {
  width: 34rpx; height: 34rpx; border-radius: 50%; flex-shrink: 0;
}
.wc-tech-av-ph {
  width: 34rpx; height: 34rpx; border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.wc-tech-av-char {
  font-size: var(--font-xs); font-weight: var(--weight-bold);
  color: var(--text-inverse);
}
.wc-tech-name {
  font-size: var(--font-xs); font-weight: var(--weight-medium);
  color: var(--text-inverse);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.wc-tech-meta {
  font-size: 17rpx;
  color: rgba(255, 255, 255, 0.72);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  line-height: 1.2;
}

.wc-like-pill {
  display: flex; align-items: center; gap: 6rpx;
  background: rgba(0, 0, 0, 0.32);
  padding: 7rpx 14rpx;
  border-radius: var(--radius-lg);
  flex-shrink: 0;
}
.wc-like-pill:active { opacity: 0.75; }

.wc-heart { width: 22rpx; height: 20rpx; flex-shrink: 0; }

.wc-like-num {
  font-size: var(--font-xs); color: var(--text-inverse);
  font-weight: var(--weight-medium); line-height: 1;
}

.wc-owner-badge {
  position: absolute; top: 66rpx; left: 14rpx; z-index: 2;
  min-height: 36rpx; padding: 0 12rpx;
  display: flex; align-items: center;
  border-radius: var(--radius-sm);
  background: rgba(181, 79, 121, 0.94);
  color: var(--text-inverse);
  font-size: 20rpx; font-weight: var(--weight-semibold);
  line-height: 1;
  box-shadow: 0 2rpx 8rpx rgba(67, 25, 45, 0.2);
}

/* ===== 底部：标题 + 标签 + 查看详情 ===== */
.wc-bottom {
  position: absolute; bottom: 0; left: 0; right: 0;
  padding: 14rpx; z-index: 2;
}
.wc-title {
  display: block;
  font-size: var(--font-sm); font-weight: var(--weight-semibold);
  color: var(--text-inverse);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  line-height: var(--leading-tight); margin-bottom: var(--space-xs);
}
.wc-tags {
  display: flex; gap: 6rpx; margin-bottom: 10rpx;
  flex-wrap: nowrap; overflow: hidden;
}
.wc-tag {
  font-size: var(--font-xs);
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.16);
  padding: 3rpx 12rpx;
  border-radius: var(--radius-sm);
  white-space: nowrap;
}
.wc-foot {
  display: flex; align-items: center; justify-content: space-between;
}
.wc-date {
  font-size: var(--font-xs); color: rgba(255, 255, 255, 0.5);
}
.wc-cta {
  display: flex; align-items: center; gap: 6rpx; flex-shrink: 0;
}
.wc-cta-circle {
  width: 20rpx; height: 20rpx; border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.78);
  position: relative;
}
.wc-cta-circle::after {
  content: ''; position: absolute;
  top: 50%; left: 50%;
  width: 6rpx; height: 3rpx;
  border-left: 2rpx solid rgba(255, 255, 255, 0.78);
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.78);
  transform: translate(-55%, -65%) rotate(-45deg);
}
.wc-cta-text {
  font-size: var(--font-xs); color: rgba(255, 255, 255, 0.78);
}
