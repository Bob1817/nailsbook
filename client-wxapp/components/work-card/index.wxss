/* 绝对填充外层 .w-card（由页面控制瀑布流尺寸）*/
.wc-root {
  position: absolute;
  inset: 0;
  border-radius: 20rpx;
  overflow: hidden;
}

.wc-img {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
}
.wc-img-empty { background: linear-gradient(135deg, #f1e8f0, #e8eaf6); }

.wc-gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.25) 0%,
    transparent 35%,
    transparent 50%,
    rgba(0, 0, 0, 0.72) 100%
  );
}

/* 顶部 */
.wc-top {
  position: absolute;
  top: 0; left: 0; right: 0;
  padding: 14rpx 14rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 2;
}

.wc-tech-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(0, 0, 0, 0.32);
  padding: 7rpx 14rpx 7rpx 7rpx;
  border-radius: 28rpx;
  max-width: 62%;
}

.wc-tech-av {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.wc-tech-av-ph {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.wc-tech-av-char {
  font-size: 16rpx;
  font-weight: 700;
  color: #fff;
}

.wc-tech-name {
  font-size: 20rpx;
  font-weight: 500;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wc-like-pill {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(0, 0, 0, 0.32);
  padding: 7rpx 14rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
}

.wc-heart { width: 22rpx; height: 20rpx; }

.wc-like-num {
  font-size: 20rpx;
  color: #fff;
  font-weight: 500;
  line-height: 1;
}

/* 底部 */
.wc-bottom {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 14rpx;
  z-index: 2;
}

.wc-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.3;
  margin-bottom: 8rpx;
}

.wc-tags {
  display: flex;
  gap: 6rpx;
  margin-bottom: 10rpx;
  flex-wrap: nowrap;
  overflow: hidden;
}

.wc-tag {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.16);
  padding: 3rpx 12rpx;
  border-radius: 16rpx;
  white-space: nowrap;
}

.wc-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.wc-date {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.52);
}

.wc-cta {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.wc-cta-circle {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.78);
  position: relative;
}
.wc-cta-circle::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 6rpx;
  height: 3rpx;
  border-left: 2rpx solid rgba(255, 255, 255, 0.78);
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.78);
  transform: translate(-55%, -65%) rotate(-45deg);
}

.wc-cta-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.78);
}
