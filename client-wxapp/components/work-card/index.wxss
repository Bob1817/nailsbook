@import '../../styles/tokens.wxss';

/* ===== 作品卡片根容器 ===== */
.wc-root {
  position: relative; width: 100%; height: 0;
  overflow: hidden;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

/* 宽高比变体（外层 work-card 包装 + wc-root 自身均可用） */
.work-card {
  -webkit-break-inside: avoid;
  break-inside: avoid;
  margin-bottom: var(--space-sm);
}
.work-card:active { opacity: 0.95; }

.aspect-3-4 { padding-bottom: 133.33%; }
.aspect-4-5 { padding-bottom: 125%; }
.aspect-5-6 { padding-bottom: 120%; }
.aspect-2-3 { padding-bottom: 150%; }
.work-card-tall { padding-bottom: 133.33%; }
.work-card-short { padding-bottom: 125%; }

/* 图片 */
.wc-img {
  position: absolute; top: 0; left: 0;
  width: 100%; height: 100%;
}
.wc-img-empty {
  position: absolute; top: 0; left: 0;
  width: 100%; height: 100%;
  background: linear-gradient(135deg, #f1e8f0, #e8eaf6);
}

/* 渐变遮罩 */
.wc-gradient {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg,
    rgba(0, 0, 0, 0.25) 0%,
    transparent 35%,
    transparent 50%,
    rgba(0, 0, 0, 0.72) 100%
  );
  z-index: 1;
}

/* ===== 顶部：美甲师 pill + 点赞 ===== */
.wc-top {
  position: absolute; top: 0; left: 0; right: 0;
  padding: 14rpx 14rpx 0;
  display: flex; align-items: center; justify-content: space-between;
  z-index: 2;
}

.wc-tech-pill {
  display: flex; align-items: center; gap: var(--space-xs);
  background: rgba(0, 0, 0, 0.32);
  padding: 7rpx 14rpx 7rpx 7rpx;
  border-radius: var(--radius-lg);
  max-width: 62%;
}
.wc-tech-pill:active { opacity: 0.75; }

.wc-tech-av {
  width: 34rpx; height: 34rpx; border-radius: 50%; flex-shrink: 0;
}
.wc-tech-av-ph {
  width: 34rpx; height: 34rpx; border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.wc-tech-av-char {
  font-size: var(--font-xs); font-weight: var(--weight-bold);
  color: var(--text-inverse);
}
.wc-tech-name {
  font-size: var(--font-xs); font-weight: var(--weight-medium);
  color: var(--text-inverse);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.wc-like-pill {
  display: flex; align-items: center; gap: 6rpx;
  background: rgba(0, 0, 0, 0.32);
  padding: 7rpx 14rpx;
  border-radius: var(--radius-lg);
  flex-shrink: 0;
}
.wc-like-pill:active { opacity: 0.75; }

.wc-heart { width: 22rpx; height: 20rpx; flex-shrink: 0; }

.wc-like-num {
  font-size: var(--font-xs); color: var(--text-inverse);
  font-weight: var(--weight-medium); line-height: 1;
}

.wc-owner-badge {
  position: absolute; top: 66rpx; left: 14rpx; z-index: 2;
  min-height: 36rpx; padding: 0 12rpx;
  display: flex; align-items: center;
  border-radius: var(--radius-sm);
  background: rgba(181, 79, 121, 0.94);
  color: var(--text-inverse);
  font-size: 20rpx; font-weight: var(--weight-semibold);
  line-height: 1;
  box-shadow: 0 2rpx 8rpx rgba(67, 25, 45, 0.2);
}

/* ===== 底部：标题 + 标签 + 查看详情 ===== */
.wc-bottom {
  position: absolute; bottom: 0; left: 0; right: 0;
  padding: 14rpx; z-index: 2;
}
.wc-title {
  display: block;
  font-size: var(--font-sm); font-weight: var(--weight-semibold);
  color: var(--text-inverse);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  line-height: var(--leading-tight); margin-bottom: var(--space-xs);
}
.wc-tags {
  display: flex; gap: 6rpx; margin-bottom: 10rpx;
  flex-wrap: nowrap; overflow: hidden;
}
.wc-tag {
  font-size: var(--font-xs);
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.16);
  padding: 3rpx 12rpx;
  border-radius: var(--radius-sm);
  white-space: nowrap;
}
.wc-foot {
  display: flex; align-items: center; justify-content: space-between;
}
.wc-date {
  font-size: var(--font-xs); color: rgba(255, 255, 255, 0.5);
}
.wc-cta {
  display: flex; align-items: center; gap: 6rpx; flex-shrink: 0;
}
.wc-cta-circle {
  width: 20rpx; height: 20rpx; border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.78);
  position: relative;
}
.wc-cta-circle::after {
  content: ''; position: absolute;
  top: 50%; left: 50%;
  width: 6rpx; height: 3rpx;
  border-left: 2rpx solid rgba(255, 255, 255, 0.78);
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.78);
  transform: translate(-55%, -65%) rotate(-45deg);
}
.wc-cta-text {
  font-size: var(--font-xs); color: rgba(255, 255, 255, 0.78);
}
