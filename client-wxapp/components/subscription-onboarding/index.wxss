.subscription-mask {
  position: fixed;
  inset: 0;
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-2xl);
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.48);
}

.subscription-dialog {
  width: 100%;
  box-sizing: border-box;
  padding: var(--space-xl) var(--space-lg) var(--space-lg);
  border-radius: var(--radius-lg);
  background: var(--nb-surface);
}

.subscription-title {
  display: block;
  color: var(--nb-ink);
  font-size: var(--font-lg);
  line-height: 1.35;
  font-weight: 600;
  text-align: center;
}

.subscription-desc {
  display: block;
  margin-top: var(--space-sm);
  color: var(--nb-muted);
  font-size: var(--font-md);
  line-height: 1.6;
  text-align: center;
}

.subscription-actions {
  display: flex;
  gap: var(--space-sm);
  margin-top: var(--space-lg);
}

.subscription-button {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border-radius: 16rpx;
  font-size: var(--font-md);
  line-height: 1;
  font-weight: 600;
}

.subscription-button::after { border: 0; }
.subscription-button-secondary { background: var(--nb-soft-surface); color: var(--nb-secondary); }
.subscription-button-primary { background: var(--nb-action); color: var(--nb-inverse); }
