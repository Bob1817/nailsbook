@import '../../styles/component-tokens.generated.wxss';

.tab-bar {
  position: fixed; right: 0; bottom: 0; left: 0; z-index: 999;
  min-height: 112rpx;
  padding: var(--space-xs) 18rpx calc(var(--space-xs) + env(safe-area-inset-bottom));
  box-sizing: content-box;
  display: flex; align-items: center;
  background: rgba(255, 255, 255, 0.72);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  backdrop-filter: blur(20px) saturate(180%);
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 -10rpx 32rpx rgba(0, 0, 0, 0.055);
}

.tab-item {
  min-width: 0; min-height: 104rpx; flex: 1;
  padding: 12rpx 0; box-sizing: border-box;
  border-radius: var(--radius-md);
  margin: 0 4rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 6rpx;
  color: var(--nb-muted);
  transition: transform 0.16s ease, color var(--transition-normal), background-color var(--transition-normal);
  position: relative;
}
.tab-item:active {
  background: rgba(0, 0, 0, 0.05);
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
  transform: scale(0.96);
}
.tab-item-active {
  color: var(--nb-text-link);
  background: rgba(36, 94, 168, 0.08);
  -webkit-backdrop-filter: blur(12px) saturate(180%);
  backdrop-filter: blur(12px) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.tab-icon-wrap {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
  transition: transform var(--transition-fast);
}
.tab-item-active .tab-icon-wrap {
  transform: scale(1.06);
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.tab-unread-badge {
  position: absolute;
  top: -12rpx;
  left: 30rpx;
  z-index: 2;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 var(--space-xs);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--nb-surface);
  border-radius: var(--radius-full);
  background: var(--nb-danger);
  color: var(--nb-inverse);
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
  line-height: 1;
  white-space: nowrap;
}

.tab-label {
  color: currentColor;
  font-size: var(--font-xs); font-weight: var(--weight-medium);
  line-height: var(--leading-tight); letter-spacing: 0.5rpx;
  position: relative;
  z-index: 1;
}
.tab-item-active .tab-label {
  font-weight: var(--weight-bold);
  letter-spacing: 0.2rpx;
}

.tab-bar-placeholder { height: calc(128rpx + env(safe-area-inset-bottom)); }
