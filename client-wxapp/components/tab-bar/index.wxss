@import '../../styles/component-tokens.generated.wxss';

.tab-bar {
  position: fixed; right: 0; bottom: 0; left: 0; z-index: 999;
  min-height: 112rpx;
  padding: 8rpx 18rpx calc(8rpx + env(safe-area-inset-bottom));
  box-sizing: content-box;
  display: flex; align-items: center;
  background: rgba(255, 255, 255, 0.97);
  border-top: 0;
  box-shadow: 0 -10rpx 32rpx rgba(0, 0, 0, 0.055);
}

.tab-item {
  min-width: 0; min-height: 104rpx; flex: 1;
  padding: 12rpx 0; box-sizing: border-box;
  border-radius: var(--radius-md);
  margin: 0 4rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 6rpx;
  color: var(--nb-muted);
  transition: transform 0.16s ease, color var(--transition-normal), background-color var(--transition-normal);
  position: relative;
}
.tab-item:active { background: var(--bg-input); transform: scale(0.96); }
.tab-item-active {
  color: var(--nb-text-link);
  background: var(--nb-soft-surface);
}

.tab-icon-wrap {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
  transition: transform var(--transition-fast);
}
.tab-item-active .tab-icon-wrap {
  transform: scale(1.06);
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.tab-label {
  color: currentColor;
  font-size: var(--font-xs); font-weight: var(--weight-medium);
  line-height: var(--leading-tight); letter-spacing: 0.5rpx;
  position: relative;
  z-index: 1;
}
.tab-item-active .tab-label {
  font-weight: var(--weight-bold);
  letter-spacing: 0.2rpx;
}

.tab-bar-placeholder { height: calc(128rpx + env(safe-area-inset-bottom)); }
