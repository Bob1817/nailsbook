.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  min-height: 108rpx;
  padding: 8rpx 18rpx env(safe-area-inset-bottom);
  box-sizing: content-box;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 -10rpx 32rpx rgba(15, 23, 42, 0.055);
}

.tab-item {
  min-width: 0;
  min-height: 96rpx;
  flex: 1;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  color: #8a94a3;
  transition: transform 0.16s ease, color 0.2s ease, background-color 0.2s ease;
}

.tab-item:active { background: #f7f8fa; transform: scale(0.96); }
.tab-item-active { color: #ff5f82; }

.tab-label {
  color: currentColor;
  font-size: 21rpx;
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: 0.5rpx;
}

.tab-item-active .tab-label { font-weight: 600; }

.tab-icon {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
  color: currentColor;
  box-sizing: border-box;
}

/* 首页 */
.icon-home::before {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 15rpx;
  width: 26rpx;
  height: 22rpx;
  border: 3rpx solid currentColor;
  border-top: 0;
  border-radius: 0 0 7rpx 7rpx;
  box-sizing: border-box;
}
.icon-home::after {
  content: '';
  position: absolute;
  left: 9rpx;
  top: 5rpx;
  width: 22rpx;
  height: 22rpx;
  border-top: 3rpx solid currentColor;
  border-left: 3rpx solid currentColor;
  border-radius: 4rpx 0 0 0;
  transform: rotate(45deg);
}

/* 预约 / 行程 */
.icon-calendar {
  margin-top: 2rpx;
  border: 3rpx solid currentColor;
  border-radius: 9rpx;
}
.icon-calendar::before {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 0;
  right: 0;
  border-top: 3rpx solid currentColor;
}
.icon-calendar::after {
  content: '';
  position: absolute;
  left: 9rpx;
  top: -7rpx;
  width: 3rpx;
  height: 12rpx;
  border-radius: 3rpx;
  background: currentColor;
  box-shadow: 17rpx 0 0 currentColor, 0 25rpx 0 currentColor, 9rpx 25rpx 0 currentColor, 17rpx 25rpx 0 currentColor;
}

/* 发现 */
.icon-compass { border: 3rpx solid currentColor; border-radius: 50%; }
.icon-compass::before {
  content: '';
  position: absolute;
  left: 13rpx;
  top: 9rpx;
  width: 11rpx;
  height: 18rpx;
  border: 3rpx solid currentColor;
  border-radius: 70% 20% 70% 20%;
  transform: rotate(38deg);
}
.icon-compass::after {
  content: '';
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: currentColor;
}

/* 消息 */
.icon-chat {
  margin-top: 2rpx;
  border: 3rpx solid currentColor;
  border-radius: 12rpx;
}
.icon-chat::before {
  content: '';
  position: absolute;
  left: 6rpx;
  bottom: -7rpx;
  width: 11rpx;
  height: 11rpx;
  border-left: 3rpx solid currentColor;
  background: #ffffff;
  transform: skewY(-35deg);
}
.icon-chat::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 17rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 9rpx 0 0 currentColor, 18rpx 0 0 currentColor;
}

/* 我的 */
.icon-profile::before {
  content: '';
  position: absolute;
  left: 14rpx;
  top: 3rpx;
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}
.icon-profile::after {
  content: '';
  position: absolute;
  left: 7rpx;
  bottom: 3rpx;
  width: 28rpx;
  height: 17rpx;
  border: 3rpx solid currentColor;
  border-bottom: 0;
  border-radius: 18rpx 18rpx 0 0;
  box-sizing: border-box;
}

/* 美甲师端客户 */
.icon-customers::before,
.icon-customers::after {
  content: '';
  position: absolute;
  top: 5rpx;
  width: 13rpx;
  height: 13rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}
.icon-customers::before { left: 7rpx; }
.icon-customers::after { right: 7rpx; }
.icon-customers {
  border-bottom: 3rpx solid currentColor;
  border-radius: 0 0 16rpx 16rpx;
}

.tab-bar-placeholder { height: calc(124rpx + env(safe-area-inset-bottom)); }
