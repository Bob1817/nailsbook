<view class="tab-bar">
  <view
    wx:for="{{tabs}}"
    wx:key="key"
    class="tab-item {{item.key === selected ? 'tab-item-active' : ''}}"
    bindtap="onTabTap"
    data-key="{{item.key}}"
    role="button"
    aria-label="{{item.label}}"
  >
    <view class="tab-icon icon-{{item.icon}}"></view>
    <text class="tab-label">{{item.label}}</text>
  </view>
</view>
<view class="tab-bar-placeholder"></view>
