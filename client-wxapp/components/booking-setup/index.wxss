@import '../../styles/booking-actions.wxss';
.setup-card { margin: 24rpx var(--space-xl); padding: 28rpx; border: 1rpx solid var(--nb-line); border-radius: var(--radius-lg); background: var(--nb-surface); }
.setup-head { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-bottom:12rpx; }
.setup-title { font-size:var(--font-md); font-weight:var(--weight-semibold); color:var(--nb-ink); }
.setup-progress, .setup-hint { display:block; font-size:var(--font-xs); color:var(--nb-muted); line-height:1.6; }
.setup-row.setup-row { box-sizing:border-box; font-weight:normal; display:flex; align-items:center; gap:16rpx; width:100%; min-height:44px; margin:0; padding:24rpx 0; border-radius:0; border-bottom:1rpx solid var(--nb-line); background:var(--nb-surface); text-align:left; line-height:1.5; }
.setup-row::after { border:0; }
.setup-copy { flex:1; min-width:0; }
.setup-label { display:block; font-size:var(--font-sm); font-weight:var(--weight-semibold); color:var(--nb-ink); }
.setup-number { font-size:var(--font-sm); color:var(--nb-secondary); }
.setup-link { flex-shrink:0; color:var(--nb-text-link); font-size:var(--font-xs); }
.setup-primary.booking-action, .setup-secondary.booking-action { width:100%; margin-top:24rpx; }
.setup-primary { background:var(--nb-action); color:var(--nb-inverse); }
.setup-secondary { background:var(--nb-soft-surface); color:var(--nb-secondary); }
.setup-primary.setup-disabled { color:var(--nb-control); background:var(--nb-pressed); }
.setup-error { color:var(--nb-danger); font-size:var(--font-sm); }
.setup-footnote { margin-top:16rpx; }
.setup-pressed { background:var(--nb-pressed); }
