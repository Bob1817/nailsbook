<view class="setup-content {{mode === 'profile' ? 'setup-profile' : ''}}" wx:if="{{mode !== 'profile' || loading || error || !setup.ready || (optionalSteps.length && !dismissed)}}">
  <text wx:if="{{loading}}" class="setup-hint">正在核对接单设置…</text>
  <view wx:elif="{{error}}" class="setup-feedback"><text class="setup-hint">{{error}}</text><button class="booking-action setup-text" bindtap="refresh">重试</button></view>
  <block wx:elif="{{mode === 'home' && setup.accepting}}"><slot name="overview" /></block>
  <block wx:else>
    <block wx:if="{{mode === 'home' || !setup.ready}}">
      <view class="setup-head"><text class="setup-title">{{setup.ready ? '准备就绪，开启接单' : '完成设置，开始接单'}}</text><text class="setup-count">{{setup.requiredCompleted}}<text class="setup-count-total"> / {{setup.requiredTotal}}</text></text></view>
      <text class="setup-hint">{{setup.ready ? '必要信息已完善，开启后即可接受预约。' : '先完成必要设置，经营数据将在开启接单后展示。'}}</text>
      <view class="setup-track" role="progressbar" aria-label="必要设置已完成 {{setup.requiredCompleted}} 项，共 {{setup.requiredTotal}} 项"><view class="setup-fill" style="width:{{percent}}%"></view></view>
      <view class="setup-steps">
        <button wx:for="{{requiredSteps}}" wx:key="key" class="setup-row" hover-class="setup-pressed" bindtap="open" data-key="{{item.key}}" disabled="{{saving}}" aria-label="{{item.title}}，必要，{{item.done ? '已完成' : '待完善'}}">
          <view class="setup-row-title"><view wx:if="{{!item.done}}" class="setup-dot"></view><text>{{item.title}}</text></view>
          <text class="setup-state {{item.done ? 'setup-done' : ''}}">{{item.done ? '已完成' : '待完善 ›'}}</text>
        </button>
      </view>
      <text wx:if="{{nextStep}}" class="setup-hint setup-next">下一步：{{nextStep.hint}}</text>
      <button wx:if="{{!setup.ready}}" class="booking-action setup-primary" bindtap="open" data-key="{{nextStep.key}}" disabled="{{saving}}">{{nextStep.title}}</button>
      <button wx:else class="booking-action setup-primary {{saving ? 'setup-disabled' : ''}}" bindtap="enable" disabled="{{saving}}" loading="{{saving}}">{{saving ? '正在开启…' : '开启接单'}}</button>
      <text class="setup-hint setup-footnote">主页与作品可稍后在「我的」中完善，不影响接单。</text>
    </block>
    <block wx:elif="{{optionalSteps.length && !dismissed}}">
      <view class="setup-head"><view><text class="setup-title">让客户更了解你</text><text class="setup-hint">还有 {{optionalSteps.length}} 项可完善 · 不影响接单</text></view><button class="booking-action setup-text" bindtap="dismiss" aria-label="关闭资料完善通知，入口红点仍保留">关闭</button></view>
      <button wx:for="{{optionalSteps}}" wx:key="key" class="setup-row" hover-class="setup-pressed" bindtap="open" data-key="{{item.key}}" aria-label="{{item.title}}，可选，待完善">
        <view class="setup-copy"><view class="setup-row-title"><view class="setup-dot"></view><text>{{item.title}}</text></view><text class="setup-hint">{{item.hint}}</text></view><text class="setup-state">去完善 ›</text>
      </button>
    </block>
  </block>
</view>
