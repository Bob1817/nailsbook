.work-detail {
  min-height: 100vh;
  background: var(--nb-page);
  box-sizing: border-box;
}
.has-composer { padding-bottom: calc(176rpx + env(safe-area-inset-bottom)); }
/* Visitor artist card — white card, booking-card baseline */
.visitor-section {
  margin: var(--space-md) 32rpx;
  padding: var(--space-md);
  border-radius: var(--radius-lg);
  background: var(--nb-surface);
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.07);
}
.visitor-artist {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  min-height: 88rpx;
}
.visitor-artist:active { opacity: .85; }
.visitor-avatar { width: 88rpx; height: 88rpx; border-radius: 50%; flex-shrink: 0; }
.visitor-copy { flex: 1; min-width: 0; }
.visitor-name { display: block; font-size: var(--font-md); font-weight: 600; color: var(--nb-ink); line-height: 1.3; }
.visitor-meta { display: flex; align-items: center; gap: var(--space-xs); margin-top: 8rpx; }
.visitor-meta-item { font-size: var(--font-xs); color: var(--nb-muted); }
.visitor-status { font-size: var(--font-xs); font-weight: 600; line-height: 1.4; padding: 2rpx 14rpx; border-radius: var(--radius-full); }
.visitor-status-open { color: var(--nb-success); background: var(--nb-success-surface); }
.visitor-status-closed { color: var(--nb-muted); background: var(--nb-line); }
.visitor-link { font-size: var(--font-sm); color: var(--nb-text-link); flex-shrink: 0; font-weight: 500; }
.visitor-bio { display: block; margin-top: var(--space-sm); font-size: var(--font-sm); line-height: 1.6; color: var(--nb-secondary); }
.visitor-shops { margin-top: var(--space-md); }
.visitor-shop-card {
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: var(--nb-page);
}
.visitor-shop-card + .visitor-shop-card { margin-top: var(--space-sm); }
.visitor-shop-info-row { display: flex; align-items: center; gap: var(--space-xs); min-width: 0; }
.visitor-shop-hours-row { margin-top: 12rpx; }
.visitor-shop-addr-row { align-items: flex-start; margin-top: 12rpx; }
.visitor-shop-icon { width: 26rpx; height: 26rpx; flex-shrink: 0; opacity: .9; }
.visitor-shop-addr-row .visitor-shop-icon { margin-top: 4rpx; }
.visitor-shop-name { flex: 1; min-width: 0; font-size: var(--font-sm); font-weight: 600; color: var(--nb-ink); line-height: 1.4; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.visitor-shop-hours-text { font-size: var(--font-xs); color: var(--nb-muted); }
.visitor-shop-addr { font-size: var(--font-xs); color: var(--nb-muted); line-height: 1.5; }
.visitor-shop-nav-inline { color: var(--nb-text-link); font-weight: 500; }
.visitor-hint { display: block; margin-top: var(--space-sm); font-size: var(--font-sm); color: var(--nb-muted); }
.info-panel.visitor-panel { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }
.visitor-booking-bar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 10; display: flex; gap: 24rpx; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background: var(--nb-surface); box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06); }
.visitor-bar-btn { flex: 1 0 0%; width: 0; height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; font-size: 26rpx; font-weight: 600; box-sizing: border-box; line-height: 1; }
.visitor-bar-btn-primary { background: var(--nb-action); color: var(--nb-inverse); border: 0; }
.visitor-bar-btn-primary:active { opacity: .8; }
.visitor-bar-btn-outline { background: transparent; color: var(--nb-action); border: 2rpx solid var(--nb-action); }
.visitor-bar-btn-outline:active { opacity: .7; }
.visitor-bar-pressed { opacity: .7; }
.visitor-booking-note { display: block; margin-top: 24rpx; font-size: 24rpx; line-height: 1.6; color: var(--nb-secondary); }
.state-screen {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--nb-line);
  border-top-color: var(--nb-control);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
.error-screen { box-sizing: border-box; padding: calc(100px + env(safe-area-inset-top)) 32rpx calc(40rpx + env(safe-area-inset-bottom)); justify-content: flex-start; }
.error-card { box-sizing: border-box; width: 100%; max-width: 480px; padding: 40rpx 32rpx; border-radius: 24rpx; background: var(--nb-surface); }
.error-symbol { width: 52px; height: 52px; display: flex; align-items: center; justify-content: center; margin-bottom: 28rpx; border-radius: 16px; background: var(--nb-page); color: var(--nb-secondary); font-size: 28px; font-weight: 600; }
.state-title { display: block; font-size: 36rpx; line-height: 1.4; font-weight: 600; color: var(--nb-ink); }
.state-description { display: block; margin-top: 16rpx; font-size: 28rpx; line-height: 1.7; color: var(--nb-secondary); }
.error-actions { display: flex; gap: 20rpx; margin-top: 36rpx; }
.state-btn { box-sizing: border-box; display: flex; align-items: center; justify-content: center; min-width: 0; width: 100%; min-height: 44px; margin: 0; padding: 12px 10px; border-radius: 8px; border: 0; background: var(--nb-action); color: var(--nb-surface); font-size: 28rpx; line-height: 1.4; font-weight: 500; }
.error-actions .state-btn { flex: 1; }
.state-btn::after { border: 0; }
.state-btn.secondary { background: var(--nb-page); color: var(--nb-secondary); }
.state-pressed { opacity: 0.75; }
.error-support { margin-top: 36rpx; padding-top: 32rpx; border-top: 1px solid var(--nb-line); }
.support-title { display: block; color: var(--nb-ink); font-size: 28rpx; font-weight: 500; }
.support-description { display: block; margin: 12rpx 0 24rpx; color: var(--nb-muted); font-size: 24rpx; line-height: 1.7; }
.support-account { display: block; margin-bottom: 24rpx; color: var(--nb-secondary); font-size: 26rpx; overflow-wrap: anywhere; }
.top-action {
  position: fixed;
  z-index: 30;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.52);
  box-sizing: border-box;
}
.top-back {
  left: 16px;
}
.top-back text {
  color: var(--nb-surface);
  font-size: 34px;
  line-height: 1;
  transform: translateY(-2px);
}
.image-swiper {
  width: 100%;
  height: 55vh;
  background: var(--nb-page);
}
.work-image {
  width: 100%;
  height: 100%;
}
.info-panel {
  position: relative;
  z-index: 2;
  margin-top: -36rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  background: var(--nb-surface);
  border-radius: 40rpx 40rpx 0 0;
  box-shadow: 0 -10rpx 30rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}
.intro-section {
  padding: 38rpx 32rpx 28rpx;
}
.title-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.work-title {
  flex: 1;
  min-width: 0;
  color: var(--nb-ink);
  font-size: 38rpx;
  line-height: 1.35;
  font-weight: 700;
}
.manage-button {
  width: 88rpx;
  height: 88rpx;
  margin: -22rpx -16rpx -12rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.manage-button:active {
  background: var(--nb-page);
}
.manage-button image {
  width: 36rpx;
  height: 36rpx;
}
.work-desc {
  display: block;
  margin-top: 14rpx;
  color: var(--nb-secondary);
  font-size: 27rpx;
  line-height: 1.65;
}
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}
.tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--nb-page);
  color: var(--nb-ink);
  font-size: 22rpx;
}
.engagement-section {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  padding: 20rpx 24rpx;
  border-top: 0;
  border-bottom: 0;
  background: var(--nb-surface);
}
.engagement-action {
  min-width: 0;
  min-height: 44px;
  margin: 0;
  padding: 10rpx 4rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: 0;
  border-radius: 18rpx;
  background: var(--nb-page);
  color: var(--nb-secondary);
  font-size: 21rpx;
  line-height: 1.2;
  box-sizing: border-box;
}
.engagement-action::after {
  border: 0;
}
.engagement-action:active {
  background: var(--nb-page);
}
.engagement-action image {
  width: 32rpx;
  height: 32rpx;
}
.engagement-action.is-active {
  color: var(--nb-ink);
  background: var(--nb-page);
}
.action-count {
  font-size: 26rpx;
  color: var(--nb-secondary);
}
.title-row .booking-action {
  flex: 0 0 auto;
  min-height: 44px;
  margin: -6px 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.booking-action-face {
  height: 32px;
  padding: 0 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  border-radius: 6px;
  box-sizing: border-box;
  font-size: 13px;
  line-height: 1.2;
  white-space: nowrap;
  color: var(--nb-surface);
  background: var(--nb-action);
  font-weight: 600;
}
.booking-action:active .booking-action-face {
  opacity: 0.88;
}
.booking-action image {
  width: 16px;
  height: 16px;
  filter: brightness(0) invert(1);
}
.comments-section {
  padding: 30rpx 32rpx 34rpx;
}
.comments-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.comments-title {
  color: var(--nb-ink);
  font-size: 30rpx;
  font-weight: 700;
}
.comments-count {
  color: var(--nb-muted);
  font-size: 22rpx;
}
.comments {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-top: 26rpx;
}
.comment {
  display: flex;
  gap: 18rpx;
}
.avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.avatar.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--nb-page);
  color: var(--nb-ink);
}
.comment-body {
  flex: 1;
  min-width: 0;
}
.comment-name {
  font-size: 24rpx;
  font-weight: 600;
}
.badge {
  margin-left: 10rpx;
  color: var(--nb-ink);
  font-size: 20rpx;
}
.comment-time {
  margin-left: 12rpx;
  color: var(--nb-muted);
  font-size: 20rpx;
}
.comment-text {
  display: block;
  margin-top: 7rpx;
  color: var(--nb-secondary);
  font-size: 26rpx;
  line-height: 1.55;
}
.empty {
  margin-top: 22rpx;
  padding: 38rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  text-align: center;
  background: var(--nb-page);
  border-radius: 20rpx;
}
.empty-title {
  color: var(--nb-secondary);
  font-size: 25rpx;
  font-weight: 600;
}
.empty-sub {
  color: var(--nb-muted);
  font-size: 21rpx;
}
.hidden-toggle {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--nb-ink);
}
.hidden-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  color: var(--nb-muted);
  font-size: 24rpx;
}
.composer-section {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  box-sizing: border-box;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 0;
  background: var(--nb-surface);
}
.replying {
  padding: 0 10rpx 12rpx;
  color: var(--nb-secondary);
  font-size: 22rpx;
}
.replying text {
  float: right;
  color: var(--nb-ink);
}
.input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.comment-input {
  flex: 1;
  min-width: 0;
  height: 44px;
  padding: 0 26rpx;
  border-radius: 8px;
  background: var(--nb-page);
  box-sizing: border-box;
  font-size: 25rpx;
}
.send {
  flex: 0 0 72px;
  width: 72px;
  min-width: 72px;
  max-width: 72px;
  height: 44px;
  margin: 0;
  padding: 0;
  flex-shrink: 0;
  display: block;
  text-align: center;
  border-radius: 8px;
  background: var(--nb-action);
  color: var(--nb-inverse);
  font-size: 14px;
  font-weight: 600;
  line-height: 44px;
  box-sizing: border-box;
}
.send::after { border: 0; }
.send-pressed { opacity: 0.85; }
.work-price-row {
  margin-top: 12rpx;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 10rpx 16rpx;
}
.work-promotion {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: var(--nb-page);
}
.work-promotion-title { color: var(--nb-ink); font-size: 26rpx; font-weight: 600; }
.work-promotion-amount { color: var(--nb-money); font-size: 26rpx; font-weight: 600; }
.work-promotion-note { width: 100%; color: var(--nb-secondary); font-size: 22rpx; }
.work-price { color: var(--nb-money); font-size: 38rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.work-price-note { color: var(--nb-muted); font-size: 22rpx; }
.work-price-note.discount { color: var(--nb-money); }
.work-price-note.surcharge { color: var(--nb-secondary); }
.comment-meta { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.comment-meta-copy { min-width: 0; display: flex; align-items: center; flex-wrap: wrap; }
.badge.pinned { color: var(--nb-ink); background: var(--nb-page); }
.comment-manage { width: 88rpx; min-height: 88rpx; margin: -26rpx -16rpx -26rpx 0; display: flex; align-items: center; justify-content: center; color: var(--nb-muted); font-size: 24rpx; letter-spacing: 2rpx; }
.hidden-comment { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.hidden-comment-copy { flex: 1; min-width: 0; }

@import '../../styles/semantic-actions.wxss';
@import '../../styles/booking-actions.wxss';
