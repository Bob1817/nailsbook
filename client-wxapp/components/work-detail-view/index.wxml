<view class="work-detail {{!visitorInfo && !loading && !loadFailed ? 'has-composer' : ''}}">
  <view wx:if="{{loading}}" class="state-screen"><view class="loading-spinner"></view></view>
  <view wx:elif="{{loadFailed}}" class="state-screen error-screen" aria-live="polite">
    <!-- 顶部常驻导航胶囊按钮：与小程序胶囊高度对齐，保障随时安全退出 -->
    <view wx:if="{{hasHistory}}" class="top-action top-back error-top-back" style="{{topButtonStyle}}" data-event="back" bindtap="emit" role="button" aria-label="返回上一页"><image class="top-back-icon" src="/static/icons/arrow-left-dark.svg" mode="aspectFit" /></view>
    <view wx:else class="top-action top-back top-home error-top-back" style="{{topButtonStyle}}" data-event="home" bindtap="emit" role="button" aria-label="进入首页"><image class="top-home-icon" src="/static/icons/tab-home.svg" mode="aspectFit" /></view>

    <!-- Airbnb 风格主信息卡片 (Hero Card) -->
    <view class="error-card">
      <view class="error-badge" aria-hidden="true">
        <image class="error-badge-icon" src="/static/icons/image.svg" mode="aspectFit" />
      </view>
      <text class="state-title error-title">{{loadErrorText || '作品暂时无法查看'}}</text>
      <text class="state-description error-description">{{loadErrorDescription || '该作品可能已被作者设为私密、已下架，或网络连接稍有延迟。别担心，还有更多灵感等你发现。'}}</text>

      <!-- 主行动按钮：主次分明胶囊 -->
      <view class="error-actions">
        <button wx:if="{{hasHistory}}" class="error-btn-primary" hover-class="state-pressed" data-event="back" bindtap="emit">返回继续浏览</button>
        <button wx:else class="error-btn-primary" hover-class="state-pressed" data-event="home" bindtap="emit">探索精选美甲</button>
        <button wx:if="{{canRetryLoad}}" class="error-btn-secondary" hover-class="state-pressed" data-event="retry" bindtap="emit">重新加载</button>
      </view>
    </view>

    <!-- 下一步操作与去处推荐卡片组 (Airbnb 风格结构化引导) -->
    <view class="error-guide-section">
      <view class="error-guide-header">
        <text class="error-guide-header-title">为你推荐以下去处</text>
      </view>

      <!-- 引导 1：浏览精选美甲画廊 -->
      <view class="error-guide-card" data-event="home" bindtap="emit" role="button" aria-label="浏览精选美甲画廊">
        <view class="error-guide-icon-box">
          <image class="error-guide-icon" src="/static/icons/tab-compass.svg" mode="aspectFit" />
        </view>
        <view class="error-guide-content">
          <text class="error-guide-title">浏览精选美甲画廊</text>
          <text class="error-guide-desc">发现当季流行设计与高分灵感款式</text>
        </view>
        <image class="error-guide-arrow" src="/static/icons/arrow-right.svg" mode="aspectFit" />
      </view>

      <!-- 引导 2：若有美甲师信息 (例如 visitorInfo)，引导查看美甲师其他作品 -->
      <view wx:if="{{visitorInfo && visitorInfo.id}}" class="error-guide-card" data-event="artist" bindtap="emit" role="button" aria-label="查看美甲师主页">
        <view class="error-guide-icon-box">
          <image wx:if="{{visitorInfo.avatarUrl}}" class="error-guide-avatar" src="{{visitorInfo.avatarUrl}}" mode="aspectFill" />
          <image wx:else class="error-guide-icon" src="/static/icons/technician.svg" mode="aspectFit" />
        </view>
        <view class="error-guide-content">
          <text class="error-guide-title">{{visitorInfo.name || '美甲师'}} 的个人主页</text>
          <text class="error-guide-desc">查看TA的其他精选作品与可约档期</text>
        </view>
        <image class="error-guide-arrow" src="/static/icons/arrow-right.svg" mode="aspectFit" />
      </view>

      <!-- 引导 3：专属客服顾问协助 -->
      <view wx:if="{{supportWechat}}" class="error-guide-card" bindtap="copySupportWechat" role="button" aria-label="复制专属客服微信号">
        <view class="error-guide-icon-box">
          <image class="error-guide-icon" src="/static/icons/tab-chat.svg" mode="aspectFit" />
        </view>
        <view class="error-guide-content">
          <text class="error-guide-title">联系专属客服顾问</text>
          <text class="error-guide-desc">微信号：<text class="error-guide-account" user-select="true">{{supportWechat}}</text></text>
        </view>
        <view class="error-guide-action-tag">复制微信</view>
      </view>
      <button wx:else class="error-guide-card error-guide-btn" open-type="contact" binderror="onSupportError" send-message-title="作品无法查看咨询" show-message-card="true" aria-label="在线联系专属客服">
        <view class="error-guide-icon-box">
          <image class="error-guide-icon" src="/static/icons/tab-chat.svg" mode="aspectFit" />
        </view>
        <view class="error-guide-content">
          <text class="error-guide-title">在线咨询平台客服</text>
          <text class="error-guide-desc">专属客服解答预约疑问与获取最新款式</text>
        </view>
        <image class="error-guide-arrow" src="/static/icons/arrow-right.svg" mode="aspectFit" />
      </button>
    </view>
  </view>
  <block wx:elif="{{work.id}}">
    <view wx:if="{{hasHistory}}" class="top-action top-back" style="{{topButtonStyle}}" data-event="back" bindtap="emit" role="button" aria-label="返回上一页"><image class="top-back-icon" src="/static/icons/arrow-left-dark.svg" mode="aspectFit" /></view>
    <view wx:else class="top-action top-back top-home" style="{{topButtonStyle}}" data-event="home" bindtap="emit" role="button" aria-label="进入首页"><image class="top-home-icon" src="/static/icons/tab-home.svg" mode="aspectFit" /></view>
    <swiper class="image-swiper {{isClientView ? 'client-image-swiper' : ''}}" current="{{currentImageIndex}}" circular="{{imageUrls.length > 1}}" bindchange="onSwiperChange">
      <swiper-item wx:for="{{imageUrls}}" wx:key="*this" bindtap="previewImage" data-url="{{item}}"><image class="work-image" src="{{item}}" mode="aspectFill" aria-label="{{work.title || '美甲作品'}}第{{index + 1}}张图片" /></swiper-item>
    </swiper>
    <view wx:if="{{isClientView && imageUrls.length > 1}}" class="image-count" aria-label="第{{currentImageIndex + 1}}张，共{{imageUrls.length}}张">{{currentImageIndex + 1}} / {{imageUrls.length}}</view>
    <view wx:if="{{isAuthor}}" class="detail-status-icons" aria-label="作品状态">
      <view wx:if="{{!work.isVisible}}" class="detail-status-pill"><image src="/static/icons/eye-closed.svg" class="detail-status-icon"/><text>私密</text></view>
      <view wx:if="{{work.isPinned}}" class="detail-status-pill"><image src="/static/icons/status-pin.svg" class="detail-status-icon"/><text>置顶</text></view>
      <view wx:if="{{work.isFeatured}}" class="detail-status-pill"><image src="/static/icons/status-featured.svg" class="detail-status-icon"/><text>精选</text></view>
      <view wx:if="{{work.heroSlot}}" class="detail-status-pill"><image src="/static/icons/crown.svg" class="detail-status-icon"/><text>主推</text></view>
    </view>
    <view wx:if="{{!isAuthor && work.heroSlot}}" class="detail-curated-badge"><image src="/static/icons/crown.svg"/><text>精选主推</text></view>
    <view class="info-panel {{visitorInfo ? 'visitor-panel' : ''}}">
      <view class="intro-section">
        <view class="title-row">
          <text class="work-title">{{work.title || '未命名作品'}}</text>
          <view wx:if="{{!visitorInfo && showBookSame}}" class="booking-action" bindtap="bookSame" role="button" aria-label="预约同款"><view class="booking-action-face"><image class="booking-action-icon" src="/static/icons/calendar-white.svg"/><text>预约同款</text></view></view>
          <view wx:if="{{isAuthor}}" class="manage-button" bindtap="manageWork" role="button" aria-label="管理作品"><image class="manage-icon" src="/static/icons/more-horizontal.svg" /></view>
        </view>
        <view class="work-pricing-card">
          <text wx:if="{{work.serviceSubtotalFen > 0}}" class="work-original-price">服务原价 <text class="{{work._priceDiffType === 'discount' ? 'work-original-strike' : ''}}">¥{{work.serviceSubtotalFen / 100}}</text></text>
          <view class="work-price-row">
            <view class="work-quote">
              <text class="work-price-label">作品报价</text>
              <text wx:if="{{work._priceText}}" class="work-price semantic-money">{{work._priceText}}</text>
              <text wx:else class="work-price-note">待报价</text>
            </view>
            <text wx:if="{{work._priceDiffType === 'discount'}}" class="work-price-note discount">已优惠 ¥{{work._priceDiffFen / 100}}</text>
            <text wx:elif="{{work._priceDiffType === 'surcharge'}}" class="work-price-note surcharge">其他 ¥{{work._priceDiffFen / 100}}</text>
            <text wx:if="{{work.doneCountText}}" class="work-done-count">{{work.doneCountText}}</text>
          </view>
          <view wx:if="{{work._promotionDiscountAmount > 0}}" class="work-promotion" aria-label="{{work.promotion.title}}，优惠{{work._promotionDiscountAmount}}元">
            <view class="work-promotion-row"><text class="work-promotion-title">{{work.promotion.title}}</text><text class="work-promotion-amount">立减 ¥{{work._promotionDiscountAmount}}</text></view>
            <text class="work-promotion-note">从此作品入口预约，报价时兑现</text>
          </view>
        </view>
        <view wx:if="{{work.description || (work.tags && work.tags.length)}}" class="work-story">
          <text class="work-story-title">作品介绍</text>
          <text wx:if="{{work.description}}" class="work-desc">{{work.description}}</text>
          <view wx:if="{{work.tags && work.tags.length}}" class="tags"><text wx:for="{{work.tags}}" wx:key="*this" class="tag">#{{item}}</text></view>
        </view>
      </view>

      <view wx:if="{{visitorInfo && visitorInfo.id}}" class="visitor-section">
        <view class="visitor-artist" data-event="artist" bindtap="emit" role="button" aria-label="查看{{visitorInfo.name}}的主页">
          <image wx:if="{{visitorInfo.avatarUrl}}" class="visitor-avatar" src="{{visitorInfo.avatarUrl}}" mode="aspectFill" />
          <view wx:else class="visitor-avatar"><image src="/static/icons/technician.svg" mode="aspectFit" class="nb-default-avatar" aria-label="美甲师默认头像" /></view>
          <view class="visitor-copy">
            <text class="visitor-name">{{visitorInfo.name}}</text>
            <view class="visitor-meta">
              <text wx:if="{{visitorInfo.city}}" class="visitor-meta-item">{{visitorInfo.city}}</text>
              <text wx:if="{{visitorInfo.acceptingBookings !== false}}" class="visitor-status visitor-status-open">接单中</text>
              <text wx:else class="visitor-status visitor-status-closed">休息中</text>
            </view>
          </view>
          <text class="visitor-link">进入主页 ›</text>
        </view>
        <text wx:if="{{visitorInfo.bio}}" class="visitor-bio">{{visitorInfo.bio}}</text>
        <view wx:if="{{visitorInfo.shops.length}}" class="visitor-shops">
          <view wx:for="{{visitorInfo.shops}}" wx:key="index" class="visitor-shop-card">
            <view class="visitor-shop-info-row">
              <image src="/static/icons/shop.svg" mode="aspectFit" class="visitor-shop-icon"/>
              <text class="visitor-shop-name">{{item.name}}</text>
            </view>
            <view wx:if="{{item.businessHours && item.businessHours.length}}" class="visitor-shop-info-row visitor-shop-hours-row">
              <image src="/static/icons/clock.svg" mode="aspectFit" class="visitor-shop-icon"/>
              <text class="visitor-shop-hours-text">{{item.businessHours[0].start}} - {{item.businessHours[0].end}}</text>
            </view>
            <view wx:if="{{item.address}}" class="visitor-shop-info-row visitor-shop-addr-row">
              <image src="/static/icons/pin.svg" mode="aspectFit" class="visitor-shop-icon"/>
              <text class="visitor-shop-addr"><text>{{item.address}}</text><text class="visitor-shop-nav-inline" data-index="{{index}}" catchtap="navigateToShop"> 导航</text></text>
            </view>
          </view>
        </view>
        <text wx:else class="visitor-hint">店铺信息待完善，预约前请确认服务地点</text>
      </view>

      <slot wx:if="{{!visitorInfo}}" name="before-comments"></slot>

      <view wx:if="{{!visitorInfo}}" class="comments-section">
        <view class="comments-header"><text class="comments-title">评论</text><text class="comments-count">{{comments.length}} 条</text></view>
        <view wx:if="{{comments.length}}" class="comments">
          <view wx:for="{{comments}}" wx:key="id" class="comment" data-comment="{{item}}" bindtap="replyComment">
            <image wx:if="{{item.user.avatarUrl || item.userAvatar}}" class="avatar" src="{{item.user.avatarUrl || item.userAvatar}}" mode="aspectFill" />
            <view wx:else class="avatar fallback"><image src="{{(item.user.role || item.userRole) === 'technician' ? '/static/icons/technician.svg' : '/static/icons/client.svg'}}" mode="aspectFit" class="nb-default-avatar" aria-label="默认头像" /></view>
            <view class="comment-body">
              <view class="comment-meta"><view class="comment-meta-copy"><text class="comment-name">{{item.user.name || item.userName || '匿名用户'}}</text><text wx:if="{{(item.user.role || item.userRole) === 'technician'}}" class="badge">美甲师</text><text wx:if="{{item.isPinned}}" class="badge pinned">置顶</text><text class="comment-time">{{item.createdAtText}}</text></view><view wx:if="{{isAuthor}}" class="comment-manage" data-comment="{{item}}" catchtap="manageComment" role="button" aria-label="管理评论">•••</view></view>
              <text class="comment-text">{{item.content}}</text>
              <view wx:if="{{item.replies && item.replies.length}}" class="comment-replies">
                <view wx:for="{{item.replies}}" wx:for-item="reply" wx:key="id" class="comment-reply">
                  <image wx:if="{{reply.user.avatarUrl || reply.userAvatar}}" class="reply-avatar" src="{{reply.user.avatarUrl || reply.userAvatar}}" mode="aspectFill" />
                  <view wx:else class="reply-avatar fallback"><image src="{{(reply.user.role || reply.userRole) === 'technician' ? '/static/icons/technician.svg' : '/static/icons/client.svg'}}" mode="aspectFit" class="nb-default-avatar" aria-label="默认头像" /></view>
                  <view class="reply-body">
                    <view class="reply-meta"><text class="reply-name">{{reply.user.name || reply.userName || '匿名用户'}}</text><text wx:if="{{(reply.user.role || reply.userRole) === 'technician'}}" class="badge">美甲师</text><text class="comment-time">{{reply.createdAtText}}</text></view>
                    <text class="reply-text">{{reply.content}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
        <view wx:else class="empty"><text class="empty-title">还没有评论</text><text class="empty-sub">说说你对这个作品的看法</text></view>
        <view wx:if="{{isAuthor && hiddenComments.length}}" class="hidden-toggle" bindtap="toggleHidden">{{showHidden ? '收起隐藏评论' : '查看 ' + hiddenComments.length + ' 条隐藏评论'}}</view>
        <view wx:if="{{isAuthor && showHidden}}" class="hidden-list"><view wx:for="{{hiddenComments}}" wx:key="id" class="hidden-comment"><text class="hidden-comment-copy">{{item.user.name || '用户'}}：{{item.content}}</text><view class="comment-manage" data-comment="{{item}}" catchtap="manageComment" role="button" aria-label="管理隐藏评论">•••</view></view></view>
      </view>

    </view>
    <view wx:if="{{!visitorInfo}}" class="composer-section" style="bottom:{{keyboardHeight}}px;{{keyboardHeight ? 'padding-bottom:20rpx;' : ''}}">
        <view wx:if="{{replyingTo}}" class="replying">回复 @{{replyingTo.name}} <text class="replying-cancel" data-event="commentcancel" bindtap="emit">取消</text></view>
        <view class="input-row">
          <view class="comment-entry">
            <image class="comment-entry-icon" src="/static/icons/edit.svg" mode="aspectFit" aria-hidden="true" />
            <input class="comment-input" placeholder="{{canComment ? '写评论…' : '登录后参与评论'}}" placeholder-class="comment-placeholder" value="{{commentText}}" focus="{{inputFocused}}" adjust-position="{{false}}" hold-keyboard="{{true}}" bindfocus="onInputFocus" bindkeyboardheightchange="onKeyboardHeightChange" bindblur="onInputBlur" bindinput="onInput" bindconfirm="submitComment" confirm-type="send"/>
          </view>
          <button wx:if="{{inputFocused || keyboardHeight || commentText || replyingTo}}" disabled="{{submittingComment}}" loading="{{submittingComment}}" class="send" hover-class="send-pressed" bindtap="submitComment" aria-label="{{submittingComment ? '正在发送评论' : '发送评论'}}">{{submittingComment ? '发送中' : '发送'}}</button>
          <view wx:else class="composer-actions">
            <view class="composer-action composer-stat {{work.isLiked ? 'is-active is-liked' : ''}}" data-event="like" bindtap="emit" role="button" aria-label="点赞，{{work.likeCount || 0}}次"><image class="composer-action-icon" src="{{work.isLiked ? '/static/icons/social-heart-active.svg' : '/static/icons/social-heart.svg'}}"/><text class="composer-action-count">{{work.likeCount || 0}}</text></view>
            <view class="composer-action composer-stat {{work.isFavorited ? 'is-active is-favorited' : ''}}" data-event="favorite" bindtap="emit" role="button" aria-label="收藏，{{work.favoriteCount || 0}}次"><image class="composer-action-icon" src="{{work.isFavorited ? '/static/icons/social-star-active.svg' : '/static/icons/social-star.svg'}}"/><text class="composer-action-count">{{work.favoriteCount || 0}}</text></view>
            <button class="composer-action composer-share" disabled="{{!canShare && !canRetryShare}}" open-type="{{isAuthor ? '' : (canShare ? 'share' : '')}}" bindtap="retryShare" aria-label="{{canShare ? '分享作品' : (canRetryShare ? '重新检查作品分享状态' : '此作品暂不可分享')}}"><image class="composer-action-icon" src="/static/icons/share.svg"/></button>
          </view>
        </view>
    </view>
    <!-- 已登录：分享 + 预约同款 / 编辑作品 -->
    <view wx:if="{{visitorInfo && isLoggedIn}}" class="visitor-booking-bar">
      <button class="visitor-bar-btn visitor-bar-btn-outline booking-action" open-type="share" hover-class="visitor-bar-pressed">分享给好友</button>
      <button class="visitor-bar-btn visitor-bar-btn-primary booking-action" bindtap="bookSame" disabled="{{!isOwnerView && visitorInfo.acceptingBookings === false}}" hover-class="visitor-bar-pressed" aria-label="{{isOwnerView ? '编辑作品' : (visitorInfo.acceptingBookings === false ? '暂未接单' : '预约同款')}}">{{isOwnerView ? '编辑作品' : (visitorInfo.acceptingBookings === false ? '暂未接单' : '预约同款')}}</button>
    </view>
    <!-- 未登录：先浏览公开内容，发起预约时再登录并自动关联美甲师 -->
    <view wx:elif="{{visitorInfo && !isLoggedIn}}" class="visitor-booking-bar">
      <view class="visitor-bar-btn visitor-bar-btn-outline" data-event="contact" bindtap="emit" hover-class="visitor-bar-pressed">联系该美甲师</view>
      <view class="visitor-bar-btn visitor-bar-btn-primary" data-event="book" bindtap="emit" hover-class="visitor-bar-pressed">预约同款</view>
    </view>
  </block>
</view>
