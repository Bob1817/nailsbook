@import '../../styles/component-tokens.generated.wxss';
.form-field { width: 100%; margin-bottom: var(--space-md); }
.form-field-label { display: block; margin-bottom: 12rpx; color: var(--nb-ink); font-size: var(--font-sm); font-weight: var(--weight-medium); line-height: 1.4; }
.form-field-control { width: 100%; min-height: var(--input-height); padding: 0 var(--input-padding-h); box-sizing: border-box; display: flex; align-items: center; overflow: hidden; border: 2rpx solid transparent; border-radius: var(--input-radius); background: var(--nb-soft-surface); }
.form-field-control.is-focused { border-color: var(--border-focus); background: var(--bg-input-focus); }
.form-field-control.has-error { border-color: var(--border-error); }
.form-field-control.is-disabled { opacity: .56; }
.form-field-icon { width: 34rpx; height: 34rpx; margin-right: 20rpx; flex-shrink: 0; opacity: .82; }
.form-field-input { flex: 1; width: 0; min-width: 0; height: var(--input-height); color: var(--nb-ink); background: transparent; font-size: var(--font-md); line-height: var(--input-height); }
.form-field-placeholder { color: var(--nb-muted); font-size: var(--font-sm); }
.form-field-action { flex-shrink: 0; min-height: var(--input-height); margin-left: 20rpx; padding-left: 22rpx; display: flex; align-items: center; border-left: 1rpx solid var(--nb-border); color: var(--nb-text-link); font-size: var(--font-sm); font-weight: var(--weight-semibold); white-space: nowrap; }
.form-field-action.is-disabled { color: var(--nb-muted); }
.form-field-message { display: block; margin-top: 10rpx; color: var(--nb-muted); font-size: var(--font-xs); line-height: 1.45; }
.form-field-message.is-error { color: var(--nb-ink); }
