<view class="form-field">
  <text wx:if="{{label}}" class="form-field-label">{{label}}<text wx:if="{{required}}" class="form-field-required" aria-hidden="true">*</text></text>
  <view class="form-field-control {{outlined ? 'is-outlined' : ''}} {{focused ? 'is-focused' : ''}} {{error ? 'has-error' : ''}} {{disabled ? 'is-disabled' : ''}}">
    <image wx:if="{{icon}}" class="form-field-icon" src="{{icon}}" mode="aspectFit" aria-hidden="true" />
    <view wx:if="{{customControl}}" class="form-field-custom"><slot name="control"></slot></view>
    <input wx:else
      class="form-field-input"
      value="{{value}}"
      type="{{type}}"
      password="{{password}}"
      maxlength="{{maxlength}}"
      placeholder="{{placeholder}}"
      placeholder-class="form-field-placeholder"
      disabled="{{disabled}}"
      confirm-type="done"
      cursor-spacing="{{cursorSpacing}}"
      bindinput="onInput"
      bindfocus="onFocus"
      bindblur="onBlur"
      bindconfirm="onConfirm"
    />
    <view wx:if="{{actionText}}" class="form-field-action {{actionDisabled ? 'is-disabled' : ''}}" bindtap="onAction">
      <text>{{actionText}}</text>
    </view>
    <slot name="suffix"></slot>
  </view>
  <text wx:if="{{error || hint}}" class="form-field-message {{error ? 'is-error' : ''}}">{{error || hint}}</text>
</view>
