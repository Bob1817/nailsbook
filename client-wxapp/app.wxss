@import './styles/tokens.wxss';

page {
  background-color: var(--bg-page);
  font-family: var(--font-body);
  font-size: var(--font-md);
  color: var(--text-body);
  line-height: var(--leading-normal);
  box-sizing: border-box;
}

button,
input,
textarea {
  font-family: var(--font-body);
}

/* ===== 布局工具类 ===== */
.container {
  min-height: 100vh;
  padding: var(--space-md);
}

.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-wrap {
  display: flex;
  flex-wrap: wrap;
}

/* ===== 文本工具类 ===== */
.text-primary   { color: var(--brand-primary); }
.text-muted     { color: var(--text-muted); }
.text-faint     { color: var(--text-faint); }
.text-error     { color: var(--text-error); }
.text-center    { text-align: center; }
.text-right     { text-align: right; }
.text-ellipsis  { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.text-display   { font-family: var(--font-display); }
.text-meta      { font-size: var(--type-meta); }
.text-body      { font-size: var(--type-body); }
.text-title     { font-size: var(--type-title); }
.text-section   { font-family: var(--font-display); font-size: var(--type-section); }

.mt-20 { margin-top: 20rpx; }
.mt-40 { margin-top: 40rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-40 { margin-bottom: 40rpx; }

/* ===== 按钮 ===== */
.btn-primary {
  height: var(--btn-height);
  line-height: var(--btn-height);
  background: var(--brand-gradient);
  color: var(--text-inverse);
  border-radius: var(--btn-radius);
  font-size: var(--btn-font-size);
  font-weight: var(--btn-font-weight);
  text-align: center;
  border: none;
  padding: 0;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-primary[disabled] {
  background: var(--text-faint);
  color: var(--text-inverse);
  opacity: 0.5;
}

.btn-outline {
  height: var(--btn-height);
  line-height: var(--btn-height);
  background-color: transparent;
  color: var(--brand-primary);
  border: 2rpx solid var(--brand-primary);
  border-radius: var(--btn-radius);
  font-size: var(--btn-font-size);
  font-weight: var(--btn-font-weight);
  text-align: center;
}

.btn-outline::after {
  border: none;
}

.btn-outline:active {
  background-color: var(--bg-tag);
}

/* ===== 输入框 ===== */
.input {
  height: var(--input-height);
  min-height: var(--input-height);
  background-color: var(--bg-input);
  border: 2rpx solid transparent;
  border-radius: var(--input-radius);
  padding: 0 var(--input-padding-h);
  font-size: var(--font-md);
  color: var(--text-primary);
  box-sizing: border-box;
}

.input:focus {
  background-color: var(--bg-input-focus);
  border-color: var(--border-focus);
}

.input-error {
  border-color: var(--border-error);
  background-color: var(--bg-input-focus);
}

/* ===== 卡片 ===== */
.card {
  background-color: var(--bg-card);
  border-radius: var(--card-radius);
  padding: var(--card-padding);
  margin-bottom: var(--card-gap);
  box-shadow: var(--shadow-sm);
  border: 2rpx solid var(--border-light);
}

/* ===== 头像 ===== */
.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-sm {
  width: 60rpx;
  height: 60rpx;
}

.avatar-md {
  width: 80rpx;
  height: 80rpx;
}

.avatar-lg {
  width: 160rpx;
  height: 160rpx;
}

/* ===== 标签 ===== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  background-color: var(--bg-tag);
  color: var(--brand-primary);
  border-radius: var(--radius-pill);
  font-size: var(--font-xs);
  line-height: var(--leading-tight);
}

.tag-primary {
  background: var(--brand-gradient);
  color: var(--text-inverse);
}

.tag-outline {
  background: transparent;
  border: 2rpx solid var(--brand-primary);
}

/* ===== 空状态 ===== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: var(--text-muted);
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: var(--space-md);
  opacity: 0.4;
}

.empty-title {
  font-size: var(--font-lg);
  color: var(--text-body);
  margin-bottom: var(--space-xs);
  font-weight: var(--weight-medium);
}

.empty-desc {
  font-size: var(--font-sm);
  color: var(--text-muted);
  margin-bottom: var(--space-lg);
}

/* ===== 分割线 ===== */
.divider {
  height: 2rpx;
  background-color: var(--border-default);
  margin: var(--space-md) 0;
}

.divider-thin {
  height: 1rpx;
  background-color: var(--border-card);
}

/* ===== 安全区 ===== */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== 品牌渐变文字 ===== */
.text-gradient {
  background: var(--brand-gradient);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.privacy-consent {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 6rpx;
  padding: 12rpx 28rpx calc(12rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  color: #756c70;
  font-size: 24rpx;
}

.privacy-consent label {
  display: flex;
  min-height: 64rpx;
  align-items: center;
}

.privacy-consent checkbox {
  transform: scale(.82);
}

.privacy-link {
  color: #9b6155;
}
