@import './colors.generated.wxss';
@import './semantics.generated.wxss';
/**
 * NailBook 设计令牌体系
 * 
 * 本文件定义所有设计变量，所有页面 .wxss 必须引用这些令牌，
 * 禁止在页面级硬编码颜色、字号、圆角、间距等样式值。
 *
 * 对齐：docs/UI-DESIGN-GUIDELINES.md
 *
 * == 图标色规则（必读）==
 * - 浅色/白色背景 → 图标用 --text-muted（中性灰），激活态用 --brand-primary
 * - 深色/彩色背景 → 图标用 --text-inverse（#fff），保持通体白色减轻视觉压力
 * - 选中使用石墨色；深色背景使用反白图标
 */

page {
  /* ===== 品牌色 ===== */
  --brand-primary: var(--nb-action);
  --brand-primary-light: var(--nb-action-pressed);
  --brand-accent: var(--nb-action);
  --brand-accent-light: var(--nb-action-pressed);
  --brand-blue: var(--nb-link);
  --brand-gradient: var(--nb-action);
  --brand-gradient-light: var(--nb-action);

  /* ===== 文本色 ===== */
  --text-primary: var(--nb-ink);
  --text-body: var(--nb-ink);
  --text-muted: var(--nb-muted);
  --text-faint: var(--nb-muted);
  --text-error: var(--nb-danger);
  --text-inverse: var(--nb-inverse);

  /* ===== 背景色 ===== */
  --bg-page: var(--nb-page);
  --bg-page-alt: var(--nb-page);
  --bg-card: var(--nb-surface);
  --bg-input: var(--nb-soft-surface);
  --bg-input-focus: var(--nb-active-surface, #EEF1F5);
  --bg-tag: var(--nb-page);
  --bg-overlay: rgba(0, 0, 0, 0.45);

  /* ===== 品牌背景渐变（入口页专用） ===== */
  --bg-gradient-entry: var(--nb-page);

  /* ===== 边框色 ===== */
  --border-default: var(--nb-line);
  --border-light: var(--nb-line);
  --border-focus: var(--nb-link);
  --border-error: var(--nb-danger);
  --border-card: var(--nb-line);
  --border-neutral: var(--nb-line);

  /* ===== 状态色：统一订单/客户标签用 ===== */
  --tone-amber-bg: var(--nb-soft-surface);
  --tone-amber-text: var(--nb-text-link);
  --tone-blue-bg: var(--nb-soft-surface);
  --tone-blue-text: var(--nb-text-link);
  --tone-emerald-bg: var(--nb-success-surface);
  --tone-emerald-text: var(--nb-success);
  --tone-purple-bg: var(--nb-soft-surface);
  --tone-purple-text: var(--nb-text-link);
  --tone-rose-bg: var(--nb-danger-surface);
  --tone-rose-text: var(--nb-danger);
  --tone-gray-bg: var(--nb-page);
  --tone-gray-text: var(--nb-secondary);
  --tone-sky-bg: var(--nb-soft-surface);
  --tone-sky-text: var(--nb-text-link);
  --tone-teal-bg: var(--nb-success-surface);
  --tone-teal-text: var(--nb-success);
  --tone-yellow-bg: var(--nb-soft-surface);
  --tone-yellow-text: var(--nb-text-link);

  /* ===== 圆角 ===== */
  --radius-xs: 8rpx;
  --radius-sm: 14rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 44rpx;
  --radius-pill: 48rpx;
  --radius-full: 9999rpx;

  /* ===== 阴影 ===== */
  --shadow-sm: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 10rpx 26rpx rgba(0, 0, 0, 0.05);
  --shadow-elevated: 0 12rpx 32rpx rgba(0, 0, 0, 0.08);

  /* ===== 字体：系统无衬线负责信息效率，宋体/衬线负责作品与主页展示感 ===== */
  --font-body: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', 'Noto Sans CJK SC', 'Source Han Sans SC', sans-serif;
  --font-display: Georgia, 'Times New Roman', 'Songti SC', STSong, 'Noto Serif CJK SC', 'Source Han Serif SC', serif;

  /* ===== 统一字号阶梯（基于 750rpx 设计稿） ===== */
  --font-xs: 22rpx;
  --font-sm: 24rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 40rpx;
  --font-2xl: 48rpx;
  --font-3xl: 64rpx;

  /* ===== 语义字号：新页面和共享组件优先使用 ===== */
  --type-meta: var(--font-xs);
  --type-body: var(--font-sm);
  --type-body-lg: var(--font-md);
  --type-title: var(--font-lg);
  --type-section: var(--font-xl);
  --type-display: var(--font-2xl);

  /* ===== 行高 ===== */
  --leading-tight: 1.25;
  --leading-normal: 1.5;
  --leading-relaxed: 1.75;

  /* ===== 字重 ===== */
  --weight-normal: 400;
  --weight-medium: 500;
  --weight-semibold: 600;
  --weight-bold: 700;

  /* ===== 间距 ===== */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 40rpx;
  --space-2xl: 48rpx;
  --space-3xl: 64rpx;

  /* ===== 触控尺寸 ===== */
  --touch-min: 44px;
  --touch-tap: 44rpx;

  /* ===== 卡片 ===== */
  --card-radius: 18rpx;
  --card-padding: 24rpx;
  --card-gap: 24rpx;

  /* ===== 按钮 ===== */
  --control-visual-height: 64rpx;
  --control-hit-height: 44px;
  --control-visual-inset: 12rpx;
  --btn-height: var(--control-hit-height);
  --btn-radius: 48rpx;
  --btn-font-size: 30rpx;
  --btn-font-weight: 500;

  /* ===== 输入框 ===== */
  --input-height: 88rpx;
  --input-radius: 14rpx;
  --input-padding-h: 26rpx;

  /* ===== 页面边距 ===== */
  --page-padding-h: 32rpx;
  --page-padding-v: 24rpx;

  /* ===== 过渡 ===== */
  --transition-fast: 0.15s ease;
  --transition-normal: 0.25s ease;
  --transition-slow: 0.35s ease;
}
