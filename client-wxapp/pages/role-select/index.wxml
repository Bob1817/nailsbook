<nav-bar title="选择你的身份" showBack="{{false}}"/>

<view class="wrap">
  <!-- 头部 -->
  <view class="hero">
    <view class="hero-icon-wrap">
      <image class="hero-icon" src="/static/icons/role-client.svg" mode="aspectFit" />
    </view>
    <text class="hero-title">欢迎加入 NailBook</text>
    <text class="hero-sub">选择你当前要使用的身份，随时可以在"我的"页面切换</text>
  </view>

  <!-- 角色卡片 -->
  <view class="role-grid">
    <!-- 客户 -->
    <view
      class="role-card {{selectedRole === 'client' ? 'role-card-active' : ''}}"
      bindtap="selectRole"
      data-role="client"
      hover-class="role-card-hover"
    >
      <view class="role-icon role-icon-pink">
        <image src="/static/icons/role-client.svg" mode="aspectFit" class="role-icon-img" />
      </view>
      <view class="role-info">
        <text class="role-title">我是客户</text>
        <text class="role-desc">浏览作品、预约美甲服务</text>
      </view>
      <view class="role-check {{selectedRole === 'client' ? 'role-check-active' : ''}}">
        <view wx:if="{{selectedRole === 'client'}}" class="role-check-dot"></view>
      </view>
    </view>

    <!-- 美甲师 -->
    <view
      class="role-card {{selectedRole === 'technician' ? 'role-card-active' : ''}}"
      bindtap="selectRole"
      data-role="technician"
      hover-class="role-card-hover"
    >
      <view class="role-icon role-icon-purple">
        <image src="/static/icons/role-technician.svg" mode="aspectFit" class="role-icon-img" />
      </view>
      <view class="role-info">
        <text class="role-title">我是美甲师</text>
        <text class="role-desc">管理预约、服务客户、展示作品</text>
      </view>
      <view class="role-check {{selectedRole === 'technician' ? 'role-check-active' : ''}}">
        <view wx:if="{{selectedRole === 'technician'}}" class="role-check-dot"></view>
      </view>
    </view>
  </view>

  <!-- 客户：绑定美甲师（必填） -->
  <view wx:if="{{selectedRole === 'client'}}" class="flow-panel">
    <text class="flow-title">绑定你的专属美甲师</text>
    <text class="flow-sub">客户账号必须由一位美甲师邀请并建立绑定</text>

    <view class="input-wrap {{findingTech ? 'input-loading' : ''}}">
      <input
        class="input {{foundTech ? 'input-success' : ''}}"
        value="{{inviteCode}}"
        bindinput="onInviteInput"
        placeholder="邀请码 / 邀请链接（必填）"
        placeholder-class="input-placeholder" confirm-type="done" />
      <view wx:if="{{findingTech}}" class="spinner"></view>
      <view wx:if="{{foundTech && !findingTech}}" class="check">✓</view>
    </view>

    <view wx:if="{{foundTech}}" class="found-card">
      <view class="found-avatar">
        <image wx:if="{{foundTech.avatarUrl}}" src="{{foundTech.avatarUrl}}" mode="aspectFill" />
        <image wx:else src="/static/icons/technician.svg" mode="aspectFit" class="nb-default-avatar" aria-label="美甲师默认头像" />
      </view>
      <view class="found-info">
        <text class="found-name">{{foundTech.name}}</text>
        <text wx:if="{{foundTech.city}}" class="found-city">{{foundTech.city}}</text>
      </view>
    </view>

    <view class="btn-group">
      <view class="btn btn-primary booking-action {{!foundTech || loading ? 'btn-disabled' : ''}}" bindtap="submitClient">
        <text>{{loading ? '处理中...' : '确认绑定并进入'}}</text>
      </view>
    </view>
  </view>

  <!-- 美甲师：激活密钥（必填） -->
  <view wx:if="{{selectedRole === 'technician'}}" class="flow-panel">
    <text class="flow-title">开通美甲师账户</text>
    <text class="flow-sub">输入系统分配的激活密钥完成美甲师认证</text>

    <view class="input-wrap">
      <input
        class="input"
        value="{{activationKey}}"
        bindinput="onActivationKeyInput"
        placeholder="16 位激活密钥（必填）"
        placeholder-class="input-placeholder"
        password="{{!showActivationKey}}" confirm-type="done" />
      <view class="eye" bindtap="toggleActivationKeyVisibility">
        <text>{{showActivationKey ? '隐藏' : '显示'}}</text>
      </view>
    </view>

    <view class="btn-group">
      <view class="btn btn-primary booking-action {{!activationKey || loading ? 'btn-disabled' : ''}}" bindtap="submitTechnician">
        <text>{{loading ? '激活中...' : '激活并进入'}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
