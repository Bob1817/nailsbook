@import '../../styles/tokens.wxss';

.container {
  min-height: 100vh;
  background: var(--bg-gradient-entry);
  padding: 36rpx var(--space-xl) var(--space-2xl);
  box-sizing: border-box;
}

.hero-section {
  display: flex; flex-direction: column; align-items: center;
  margin-bottom: 56rpx;
}

.logo-circle {
  width: 104rpx; height: 104rpx;
  background: var(--brand-gradient);
  border-radius: 52rpx;
  color: var(--text-inverse);
  font-size: var(--font-2xl);
  font-weight: var(--weight-bold);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: var(--space-md);
  box-shadow: 0 12rpx 30rpx rgba(139, 92, 246, 0.22);
}

.page-title {
  font-size: var(--font-lg); font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin-bottom: var(--space-xs);
  line-height: var(--leading-tight);
}

.app-desc {
  font-size: var(--font-sm); color: var(--text-muted);
  line-height: var(--leading-normal);
}

.role-section { margin-bottom: var(--space-2xl); }

.section-title {
  font-size: var(--font-md); font-weight: var(--weight-semibold);
  color: var(--text-body); margin-bottom: 20rpx;
  display: block;
}

.role-card {
  display: flex; align-items: center;
  min-height: 136rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--border-light);
  border-radius: var(--card-radius);
  padding: var(--space-md) var(--space-xl);
  margin-bottom: 18rpx;
  box-shadow: var(--shadow-lg);
  box-sizing: border-box;
}

.role-icon {
  width: 76rpx; height: 76rpx; border-radius: 38rpx;
  font-size: var(--font-md); font-weight: var(--weight-bold);
  color: var(--text-inverse);
  display: flex; align-items: center; justify-content: center;
  margin-right: var(--space-md);
  flex-shrink: 0;
}

.client-icon { background: var(--brand-gradient); }
.tech-icon { background: linear-gradient(135deg, var(--brand-accent), var(--brand-blue)); }

.role-info { flex: 1; min-width: 0; }

.role-title {
  font-size: var(--font-md); font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin-bottom: 6rpx; display: block;
  line-height: var(--leading-tight);
}

.role-desc {
  font-size: var(--font-sm); color: var(--text-muted);
  display: block; line-height: var(--leading-tight);
}

.arrow {
  font-size: 42rpx; color: var(--text-muted);
  margin-left: 18rpx;
}

.footer { text-align: center; padding: 0 var(--space-sm); }

.footer-text {
  font-size: var(--font-xs); color: var(--text-muted);
  display: block; line-height: var(--leading-normal);
}
