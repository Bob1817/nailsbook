@import '../../styles/tokens.wxss';

/* ===== 页面容器 ===== */
.wrap {
  min-height: 100vh;
  background: var(--bg-gradient-entry);
  padding: 20rpx var(--space-xl) calc(var(--space-2xl) + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== Hero 头部 ===== */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 44rpx;
}

.hero-icon-wrap {
  width: 108rpx;
  height: 108rpx;
  background: var(--brand-gradient);
  border-radius: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-md);
  box-shadow: 0 12rpx 32rpx rgba(139, 92, 246, 0.24);
}

.hero-icon {
  width: 56rpx;
  height: 56rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  margin-bottom: var(--space-xs);
  line-height: 1.25;
}

.hero-sub {
  font-size: var(--font-sm);
  color: var(--text-muted);
  text-align: center;
  line-height: var(--leading-normal);
  max-width: 480rpx;
}

/* ===== 角色卡片网格 ===== */
.role-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.role-card {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border: 2rpx solid var(--border-light);
  border-radius: var(--card-radius);
  padding: 28rpx var(--space-lg);
  box-sizing: border-box;
  transition: all 0.18s;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.role-card-active {
  border-color: var(--brand-primary);
  background: linear-gradient(135deg, rgba(255, 107, 138, 0.06), rgba(168, 85, 247, 0.06));
  box-shadow: 0 4rpx 20rpx rgba(139, 92, 246, 0.14);
}

.role-card-hover {
  opacity: 0.88;
  transform: scale(0.985);
}

.role-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--space-lg);
  flex-shrink: 0;
}

.role-icon-pink {
  background: var(--brand-gradient);
}

.role-icon-purple {
  background: linear-gradient(135deg, var(--brand-accent), #6366f1);
}

.role-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.role-info {
  flex: 1;
  min-width: 0;
}

.role-title {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  display: block;
  margin-bottom: 4rpx;
  line-height: var(--leading-tight);
}

.role-desc {
  font-size: var(--font-sm);
  color: var(--text-muted);
  display: block;
  line-height: var(--leading-tight);
}

/* 圆形选中指示器 */
.role-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  border: 3rpx solid var(--border-light);
  margin-left: var(--space-md);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.18s;
}

.role-check-active {
  border-color: var(--brand-primary);
  background: var(--brand-primary);
}

.role-check-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--text-inverse);
}

/* ===== 展开流程面板 ===== */
.flow-panel {
  background: var(--bg-card);
  border-radius: var(--card-radius);
  padding: 32rpx var(--space-lg);
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.flow-title {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  display: block;
  margin-bottom: 6rpx;
}

.flow-sub {
  font-size: var(--font-sm);
  color: var(--text-muted);
  display: block;
  margin-bottom: 24rpx;
  line-height: var(--leading-normal);
}

/* ===== 输入框 ===== */
.input-wrap {
  position: relative;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.input {
  flex: 1;
  height: 88rpx;
  background: var(--bg-input);
  border: 2rpx solid var(--border-light);
  border-radius: 16rpx;
  padding: 0 var(--space-lg);
  font-size: var(--font-md);
  color: var(--text-primary);
  box-sizing: border-box;
  transition: border-color 0.18s;
}

.input:focus {
  border-color: var(--brand-primary);
}

.input-success {
  border-color: #22c55e;
}

.input-placeholder {
  color: var(--text-faint);
  font-size: var(--font-md);
}

/* 输入框右侧状态图标 */
.spinner {
  position: absolute;
  right: 24rpx;
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid var(--border-light);
  border-top-color: var(--brand-primary);
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.check {
  position: absolute;
  right: 24rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #22c55e;
  color: #fff;
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  display: flex;
  align-items: center;
  justify-content: center;
}

.eye {
  position: absolute;
  right: 24rpx;
  font-size: var(--font-sm);
  color: var(--brand-primary);
  padding: var(--space-sm);
}

/* ===== 搜索到的美甲师卡片 ===== */
.found-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.06), rgba(255, 107, 138, 0.06));
  border: 1rpx solid rgba(139, 92, 246, 0.15);
  border-radius: 16rpx;
  padding: 20rpx var(--space-lg);
  margin-bottom: 24rpx;
}

.found-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: var(--brand-gradient);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--space-md);
  flex-shrink: 0;
}

.found-avatar image {
  width: 100%;
  height: 100%;
}

.found-avatar text {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--text-inverse);
}

.found-info {
  flex: 1;
  min-width: 0;
}

.found-name {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  display: block;
  margin-bottom: 4rpx;
  line-height: var(--leading-tight);
}

.found-city {
  font-size: var(--font-xs);
  color: var(--text-muted);
  display: block;
}

/* ===== 按钮组 ===== */
.btn-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn {
  width: 100%;
  height: var(--btn-height);
  border-radius: var(--btn-radius);
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: all 0.16s;
}

.btn:active {
  opacity: 0.86;
  transform: scale(0.985);
}

.btn-primary {
  background: var(--brand-gradient);
  color: var(--text-inverse);
  box-shadow: 0 8rpx 24rpx rgba(139, 92, 246, 0.28);
}

.btn-secondary {
  background: var(--bg-input);
  color: var(--text-muted);
  border: 2rpx solid var(--border-light);
}

.btn-disabled {
  opacity: 0.45;
  pointer-events: none;
}

/* ===== 提示文本 ===== */
.hint {
  background: rgba(139, 92, 246, 0.06);
  border-radius: 12rpx;
  padding: 16rpx var(--space-md);
  margin-bottom: 24rpx;
}

.hint text {
  font-size: var(--font-xs);
  color: var(--text-muted);
  line-height: var(--leading-normal);
}

/* ===== 错误消息 ===== */
.error {
  text-align: center;
  font-size: var(--font-sm);
  color: var(--text-error);
  padding: var(--space-md) 0;
}
