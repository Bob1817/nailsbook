.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff8fb 0%, #ffffff 34%, #f8f9fc 100%);
  padding: 36rpx 40rpx 48rpx;
  box-sizing: border-box;
}

.hero-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 56rpx;
}

.logo-circle {
  width: 104rpx;
  height: 104rpx;
  background: linear-gradient(135deg, #ff6b8a, #8b5cf6);
  border-radius: 52rpx;
  color: #fff;
  font-size: 48rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(139, 92, 246, 0.22);
}

.page-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 8rpx;
  line-height: 1.25;
}

.app-desc {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.45;
}

.role-section {
  margin-bottom: 48rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 20rpx;
  display: block;
}

.role-card {
  display: flex;
  align-items: center;
  min-height: 136rpx;
  background: #ffffff;
  border: 2rpx solid rgba(255, 107, 138, 0.08);
  border-radius: 14rpx;
  padding: 24rpx 40rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.05);
  box-sizing: border-box;
}

.role-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 38rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.client-icon {
  background: linear-gradient(135deg, #ff6b8a, #8b5cf6);
}

.tech-icon {
  background: linear-gradient(135deg, #8b5cf6, #667eea);
}

.role-info {
  flex: 1;
  min-width: 0;
}

.role-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 6rpx;
  display: block;
  line-height: 1.35;
}

.role-desc {
  font-size: 23rpx;
  color: #6b7280;
  display: block;
  line-height: 1.35;
}

.arrow {
  font-size: 42rpx;
  color: #767b84;
  margin-left: 18rpx;
}

.footer {
  text-align: center;
  padding: 0 16rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #6b7280;
  display: block;
  line-height: 1.45;
}
