<nav-bar title="{{navigationTitle}}" showBack="{{false}}"/>

<view class="onboarding-screen">
  <view class="onboarding-topbar">
    <text class="progress-copy">{{currentIndex + 1}} / {{stepCount}}</text>
    <view
      class="skip-action booking-action"
      bindtap="skipOnboarding"
      hover-class="tap-pressed"
      role="button"
      aria-label="跳过{{roleLabel}}使用引导"
    >跳过</view>
  </view>

  <view class="progress-track" aria-hidden="true">
    <view class="progress-value step-{{currentIndex + 1}}"></view>
  </view>

  <view class="onboarding-card">
    <view class="step-icon-wrap">
      <image class="step-icon" src="{{step.icon}}" mode="aspectFit" />
    </view>
    <text class="step-eyebrow">{{step.eyebrow}}</text>
    <text class="step-title">{{step.title}}</text>
    <text class="step-description">{{step.description}}</text>

    <view class="point-list">
      <view class="point-row" wx:for="{{step.points}}" wx:key="*this">
        <view class="point-check">✓</view>
        <text class="point-text">{{item}}</text>
      </view>
    </view>
  </view>

  <view class="step-dots" aria-hidden="true">
    <view
      wx:for="{{stepCount}}"
      wx:key="*this"
      class="step-dot {{index === currentIndex ? 'step-dot-active' : ''}}"
    ></view>
  </view>

  <view class="onboarding-actions">
    <view
      wx:if="{{!isFirst}}"
      class="action-secondary booking-action"
      bindtap="previousStep"
      hover-class="tap-pressed"
      role="button"
      aria-label="上一步"
    >上一步</view>
    <view
      class="action-primary booking-action"
      bindtap="nextStep"
      hover-class="tap-pressed"
      role="button"
      aria-label="{{primaryLabel}}"
    >{{navigating ? '正在进入…' : primaryLabel}}</view>
  </view>
</view>
