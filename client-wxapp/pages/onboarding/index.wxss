/* ===== NailBook 新用户引导页 ===== */
@import '../../styles/tokens.wxss';

page {
  background: #FFFFFF;
  min-height: 100vh;
}

.wrap {
  padding: 0 40rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 40rpx);
}

/* ===== Hero ===== */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 48rpx;
}

.hero-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #FFF0F5 0%, #F5F3FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.hero-icon {
  width: 44rpx;
  height: 44rpx;
}

.hero-title {
  display: block;
  font-size: var(--font-xl);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.hero-sub {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-faint);
}

/* ===== 选项卡片 ===== */
.option-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: var(--radius-lg);
  margin-bottom: 20rpx;
  transition: transform 0.15s, opacity 0.15s;
}

.option-card-hover {
  transform: scale(0.985);
  opacity: 0.92;
}

.option-card-pink {
  background: linear-gradient(135deg, #FFF0F5 0%, #FFF5F7 100%);
  border: 2rpx solid rgba(255, 107, 138, 0.12);
}

.option-card-purple {
  background: linear-gradient(135deg, #F5F3FF 0%, #F8F6FF 100%);
  border: 2rpx solid rgba(139, 92, 246, 0.12);
}

.option-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.option-icon-pink {
  background: rgba(255, 107, 138, 0.12);
}

.option-icon-purple {
  background: rgba(139, 92, 246, 0.12);
}

.option-icon-img {
  width: 28rpx;
  height: 28rpx;
}

.option-info {
  flex: 1;
  min-width: 0;
}

.option-title {
  display: block;
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.option-desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
  line-height: 1.5;
}

.option-arrow {
  font-size: var(--font-lg);
  color: var(--text-faint);
  flex-shrink: 0;
}

/* ===== 跳过 ===== */
.skip-row {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.skip-text {
  font-size: var(--font-sm);
  color: var(--text-faint);
  padding: 12rpx 32rpx;
}

/* ===== 子面板（底部弹出） ===== */
.flow-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  animation: maskIn 0.25s ease;
}

@keyframes maskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.flow-panel {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 40rpx calc(env(safe-area-inset-bottom) + 32rpx);
  animation: panelUp 0.3s cubic-bezier(0.32, 0.72, 0, 1);
}

@keyframes panelUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.flow-handle {
  width: 48rpx;
  height: 6rpx;
  background: #E5E7EB;
  border-radius: 3rpx;
  margin: 0 auto 24rpx;
}

.flow-title {
  display: block;
  font-size: var(--font-xl);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  text-align: center;
  margin-bottom: 6rpx;
}

.flow-sub {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-faint);
  text-align: center;
  margin-bottom: 32rpx;
}

/* 输入框 */
.flow-input-wrap {
  position: relative;
  margin-bottom: 16rpx;
}

.flow-input {
  width: 100%;
  height: 96rpx;
  background: var(--bg-input);
  border: 2rpx solid var(--border-default);
  border-radius: var(--radius-sm);
  padding: 0 40rpx 0 24rpx;
  font-size: var(--font-md);
  color: var(--text-primary);
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.flow-input:focus {
  border-color: var(--border-focus);
  background: #FFFFFF;
}

.flow-input-success {
  border-color: #10b981;
}

.flow-input-error {
  border-color: var(--text-error);
}

.flow-placeholder {
  color: var(--text-faint);
  font-size: var(--font-md);
}

.flow-spinner {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(255, 107, 138, 0.2);
  border-top-color: var(--brand-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: translateY(-50%) rotate(360deg); }
}

.flow-check {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 32rpx;
  height: 32rpx;
  background: #10b981;
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
}

.flow-eye {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: var(--font-sm);
  color: var(--brand-primary);
  padding: 8rpx;
}

/* 找到的美甲师 */
.found-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: #F0FDF4;
  border-radius: var(--radius-sm);
  margin-bottom: 16rpx;
}

.found-card-av {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b8a, #8b5cf6);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.found-av-img {
  width: 100%;
  height: 100%;
}

.found-av-char {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: #FFFFFF;
}

.found-card-info {
  flex: 1;
  min-width: 0;
}

.found-card-name {
  display: block;
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: #065f46;
}

.found-card-city {
  display: block;
  font-size: var(--font-sm);
  color: #10b981;
  margin-top: 2rpx;
}

/* 留言 */
.flow-textarea {
  width: 100%;
  min-height: 120rpx;
  background: var(--bg-input);
  border: 2rpx solid var(--border-default);
  border-radius: var(--radius-sm);
  padding: 20rpx 24rpx;
  font-size: var(--font-sm);
  color: var(--text-primary);
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

/* 错误提示 */
.flow-error {
  font-size: var(--font-sm);
  color: var(--text-error);
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

/* 提示 */
.flow-hint {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 16rpx;
  background: #FFF7ED;
  border-radius: var(--radius-sm);
  margin-bottom: 24rpx;
}

.flow-hint-icon {
  font-size: var(--font-sm);
  flex-shrink: 0;
  margin-top: 2rpx;
}

.flow-hint text {
  font-size: var(--font-xs);
  color: #92400e;
  line-height: 1.5;
}

/* 主按钮 */
.flow-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #ff6b8a 0%, #8b5cf6 100%);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: #FFFFFF;
  margin-bottom: 16rpx;
  transition: opacity 0.15s;
}

.flow-btn-disabled {
  opacity: 0.4;
}

/* 返回 */
.flow-cancel {
  text-align: center;
  font-size: var(--font-md);
  color: var(--text-muted);
  padding: 16rpx 0;
}
