@import '../../styles/tokens.wxss';
@import '../../styles/booking-actions.wxss';

page {
  min-height: 100vh;
  background: var(--nb-page);
}

.onboarding-screen {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 20rpx var(--page-padding-h) calc(env(safe-area-inset-bottom) + 144rpx);
}

.onboarding-topbar {
  min-height: var(--touch-min);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.progress-copy {
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
  color: var(--text-muted);
}

.skip-action.booking-action {
  min-width: 96rpx;
  padding: 0 20rpx;
  color: var(--text-muted);
  background: transparent;
}

.progress-track {
  height: 6rpx;
  overflow: hidden;
  margin: 8rpx 0 36rpx;
  border-radius: var(--radius-full);
  background: var(--nb-line);
}

.progress-value {
  height: 100%;
  border-radius: var(--radius-full);
  background: var(--nb-action);
  transition: width var(--transition-normal);
}

.progress-value.step-1 { width: 33.333%; }
.progress-value.step-2 { width: 66.666%; }
.progress-value.step-3 { width: 100%; }

.onboarding-card {
  flex: none;
  min-height: 650rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 36rpx 40rpx;
  border: 1rpx solid var(--nb-line);
  border-radius: var(--radius-lg);
  background: var(--nb-surface);
}

.step-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36rpx;
  border-radius: 36rpx;
  background: var(--nb-active-surface);
}

.step-icon {
  width: 56rpx;
  height: 56rpx;
}

.step-eyebrow {
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
  color: var(--nb-link);
  letter-spacing: 2rpx;
}

.step-title {
  margin-top: 12rpx;
  font-size: var(--font-xl);
  font-weight: var(--weight-bold);
  line-height: var(--leading-tight);
  color: var(--text-primary);
}

.step-description {
  max-width: 560rpx;
  margin-top: 20rpx;
  font-size: var(--font-sm);
  line-height: var(--leading-relaxed);
  text-align: center;
  color: var(--text-muted);
}

.point-list {
  width: 100%;
  box-sizing: border-box;
  margin-top: 44rpx;
  padding: 24rpx;
  border-radius: var(--radius-md);
  background: var(--nb-page);
}

.point-row {
  min-height: 52rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.point-row + .point-row {
  margin-top: 12rpx;
}

.point-check {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  font-size: var(--font-xs);
  font-weight: var(--weight-bold);
  color: var(--nb-inverse);
  background: var(--nb-action);
}

.point-text {
  font-size: var(--font-sm);
  line-height: var(--leading-normal);
  color: var(--text-primary);
}

.step-dots {
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.step-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: var(--radius-full);
  background: var(--nb-line);
  transition: width var(--transition-fast), background var(--transition-fast);
}

.step-dot-active {
  width: 36rpx;
  background: var(--nb-action);
}

.onboarding-actions {
  position: fixed;
  z-index: 20;
  left: var(--page-padding-h);
  right: var(--page-padding-h);
  bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  display: flex;
  gap: 16rpx;
  padding-top: 12rpx;
  background: var(--nb-page);
}

.action-secondary.booking-action,
.action-primary.booking-action {
  flex: 1;
  padding: 0 28rpx;
}

.action-secondary.booking-action {
  color: var(--text-primary);
  border: 1rpx solid var(--nb-line);
  background: var(--nb-surface);
}

.action-primary.booking-action {
  color: var(--nb-inverse);
  background: var(--nb-action);
}

.tap-pressed {
  opacity: .72;
}

@media (max-height: 700px) {
  .progress-track { margin-bottom: 20rpx; }
  .onboarding-card { min-height: 560rpx; padding-top: 32rpx; }
  .step-icon-wrap { width: 96rpx; height: 96rpx; margin-bottom: 24rpx; }
  .point-list { margin-top: 28rpx; }
}
