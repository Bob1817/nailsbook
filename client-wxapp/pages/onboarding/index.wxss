/* ===== OnlyNail 新用户引导页 ===== */
@import '../../styles/tokens.wxss';

page {
  background: var(--nb-surface);
  min-height: 100vh;
}

.wrap {
  padding: 0 var(--space-xl);
  padding-bottom: calc(env(safe-area-inset-bottom) + var(--space-xl));
}

/* ===== Hero ===== */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 var(--space-2xl);
}

.hero-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  background: var(--nb-page);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-md);
}

.hero-icon {
  width: 44rpx;
  height: 44rpx;
}

.hero-title {
  display: block;
  font-size: var(--font-xl);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  margin-bottom: var(--space-xs);
}

.hero-sub {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-faint);
}

/* ===== 选项卡片 ===== */
.option-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx var(--space-md);
  border-radius: var(--radius-lg);
  margin-bottom: 20rpx;
  transition: transform 0.15s, opacity 0.15s;
}

.option-card-hover {
  transform: scale(0.985);
  opacity: 0.92;
}

.option-card-pink {
  background: var(--nb-page);
  border: 0;
}

.option-card-purple {
  background: var(--nb-page);
  border: 0;
}

.option-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.option-icon-pink {
  background: rgba(0, 0, 0, 0.12);
}

.option-icon-purple {
  background: rgba(0, 0, 0, 0.12);
}

.option-icon-img {
  width: 28rpx;
  height: 28rpx;
}

.option-info {
  flex: 1;
  min-width: 0;
}

.option-title {
  display: block;
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.option-desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
  line-height: 1.5;
}

.option-arrow {
  font-size: var(--font-lg);
  color: var(--text-faint);
  flex-shrink: 0;
}

/* ===== 跳过 ===== */
.skip-row {
  display: flex;
  justify-content: center;
  padding: var(--space-lg) 0;
}

.skip-text {
  font-size: var(--font-sm);
  color: var(--text-faint);
  padding: 12rpx var(--space-lg);
}

/* ===== 子面板（底部弹出） ===== */
.flow-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  animation: maskIn 0.25s ease;
}

@keyframes maskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.flow-panel {
  width: 100%;
  background: var(--nb-surface);
  border-radius: 32rpx 32rpx 0 0;
  padding: var(--space-lg) var(--space-xl) calc(env(safe-area-inset-bottom) + var(--space-lg));
  animation: panelUp 0.3s cubic-bezier(0.32, 0.72, 0, 1);
}

@keyframes panelUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.flow-handle {
  width: 48rpx;
  height: 6rpx;
  background: var(--nb-page);
  border-radius: 3rpx;
  margin: 0 auto var(--space-md);
}

.flow-title {
  display: block;
  font-size: var(--font-xl);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  text-align: center;
  margin-bottom: 6rpx;
}

.flow-sub {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-faint);
  text-align: center;
  margin-bottom: var(--space-lg);
}

/* 输入框 */
.flow-input-wrap {
  position: relative;
  margin-bottom: var(--space-sm);
}

.flow-input {
  width: 100%;
  height: 96rpx;
  background: var(--nb-soft-surface);
  border: 0;
  border-radius: var(--radius-sm);
  padding: 0 var(--space-xl) 0 var(--space-md);
  font-size: var(--font-md);
  color: var(--text-primary);
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.flow-input:focus {
  border-color: var(--border-focus);
  background: var(--nb-surface);
}

.flow-input-success {
  border-color: var(--nb-link);
}

.flow-input-error {
  border-color: var(--text-error);
}

.flow-placeholder {
  color: var(--text-faint);
  font-size: var(--font-md);
}

.flow-spinner {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(0, 0, 0, 0.2);
  border-top-color: var(--brand-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: translateY(-50%) rotate(360deg); }
}

.flow-check {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 36rpx;
  height: 36rpx;
  background: var(--nb-action);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.flow-check-icon {
  width: 20rpx;
  height: 20rpx;
}

.flow-eye {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: var(--font-sm);
  color: var(--brand-primary);
  padding: var(--space-xs);
}

/* 找到的美甲师 */
.found-card {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: 20rpx;
  background: var(--nb-page);
  border-radius: var(--radius-sm);
  margin-bottom: var(--space-sm);
}

.found-card-av {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--nb-action);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.found-av-img {
  width: 100%;
  height: 100%;
}

.found-av-char {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--nb-surface);
}

.found-card-info {
  flex: 1;
  min-width: 0;
}

.found-card-name {
  display: block;
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--nb-ink);
}

.found-card-city {
  display: block;
  font-size: var(--font-sm);
  color: var(--nb-ink);
  margin-top: 2rpx;
}

/* 留言 */
.flow-textarea {
  width: 100%;
  min-height: 120rpx;
  background: var(--nb-soft-surface);
  border: 0;
  border-radius: var(--radius-sm);
  padding: 20rpx var(--space-md);
  font-size: var(--font-sm);
  color: var(--text-primary);
  box-sizing: border-box;
  margin-bottom: var(--space-sm);
}

/* 错误提示 */
.flow-error {
  font-size: var(--font-sm);
  color: var(--text-error);
  margin-bottom: var(--space-sm);
  padding: 0 4rpx;
}

/* 提示 */
.flow-hint {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: var(--space-sm);
  background: var(--nb-page);
  border-radius: var(--radius-sm);
  margin-bottom: var(--space-md);
}

.flow-hint-icon {
  font-size: var(--font-sm);
  flex-shrink: 0;
  margin-top: 2rpx;
}

.flow-hint text {
  font-size: var(--font-xs);
  color: var(--nb-ink);
  line-height: 1.5;
}

/* 主按钮 */
.flow-btn {
  width: 100%;
  height: 96rpx;
  background: var(--nb-action);
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--nb-surface);
  margin-bottom: var(--space-sm);
  transition: opacity 0.15s;
}

.flow-btn-disabled {
  opacity: 0.4;
}

/* 返回 */
.flow-cancel {
  text-align: center;
  font-size: var(--font-md);
  color: var(--text-muted);
  padding: var(--space-sm) 0;
}

@import '../../styles/booking-actions.wxss';
.flow-input { height: var(--input-height); min-height: 44px; font-size: var(--font-sm); }
.flow-placeholder { font-size: var(--font-sm); }
.flow-btn.booking-action { height: var(--control-hit-height); min-height: 44px; border-radius: 8px; font-size: var(--font-sm); box-shadow: none; }
