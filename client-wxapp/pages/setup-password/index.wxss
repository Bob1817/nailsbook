/**
 * NailBook 设置登录密码页 — 复用登录页设计令牌
 */

/* ===== 页面根 ===== */
page {
  background: var(--bg-card);
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.setup-root {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 var(--space-xl);
}

.stub-status {
  width: 100%;
  height: 44px;
  flex-shrink: 0;
}

/* ===== Logo 区域 ===== */
.hero {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 60rpx;
}

.logo-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-xl);
  background: var(--brand-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-md);
  box-shadow: 0 12rpx 36rpx rgba(255, 107, 138, 0.22);
}

.logo-text {
  font-size: 64rpx;
  font-weight: var(--weight-black);
  color: var(--text-inverse);
  line-height: 1;
}

.app-name {
  font-size: var(--font-lg);
  font-weight: var(--weight-black);
  color: var(--text-primary);
  letter-spacing: 2rpx;
}

/* ===== 描述区域 ===== */
.desc-area {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: var(--space-xl);
  margin-bottom: var(--space-2xl);
}

.desc-title {
  font-size: 40rpx;
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  margin-bottom: var(--space-sm);
}

.desc-sub {
  font-size: var(--font-sm);
  color: var(--text-faint);
  text-align: center;
  line-height: 1.5;
}

.phone-display {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-top: var(--space-md);
  padding: var(--space-sm) var(--space-md);
  background: var(--bg-input);
  border-radius: 10px;
}

.phone-label {
  font-size: var(--font-sm);
  color: var(--text-faint);
}

.phone-value {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

/* ===== 表单区域 ===== */
.form-area {
  width: 100%;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

/* ===== 输入行（复用登录页样式） ===== */
.input-row {
  width: 100%;
  height: 56px;
  display: flex;
  align-items: center;
  background: var(--bg-input);
  border-radius: 14px;
  border: 1.5rpx solid var(--border-default);
  padding: 0 28rpx;
  margin-bottom: var(--space-md);
  transition: border-color 0.2s;
  box-sizing: border-box;
}

.input-row:focus-within {
  border-color: var(--border-focus);
  background: var(--bg-input-focus);
}

.input-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  opacity: 0.45;
}

.input-field {
  flex: 1;
  height: 56px;
  font-size: 30rpx;
  color: var(--text-primary);
  background: transparent;
  line-height: 56px;
}

.input-placeholder {
  color: var(--text-faint);
  font-size: 28rpx;
}

.pwd-toggle {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: var(--space-sm);
}

.pwd-toggle:active { opacity: 0.5; }

.pwd-toggle-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.35;
}

/* ===== 错误提示 ===== */
.error-text {
  font-size: var(--font-sm);
  color: var(--color-error, #FA5151);
  margin-bottom: var(--space-md);
  margin-top: calc(-1 * var(--space-xs));
  padding-left: var(--space-xs);
}

/* ===== 提交按钮 ===== */
.submit-btn {
  width: 100%;
  height: var(--btn-height);
  border-radius: var(--btn-radius);
  background: var(--bg-input);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: var(--text-muted);
  transition: all 0.24s;
  letter-spacing: 4rpx;
  margin-top: var(--space-sm);
}

.submit-btn::after { border: none; }

.submit-btn-active {
  background: var(--brand-gradient);
  color: var(--text-inverse);
  box-shadow: 0 8rpx 28rpx rgba(255, 107, 138, 0.3);
}

.submit-btn-active:active {
  opacity: 0.88;
  transform: scale(0.985);
}

/* ===== 协议 ===== */
.agreement {
  flex-shrink: 0;
  font-size: 11px;
  color: var(--text-faint);
  text-align: center;
  width: 100%;
  padding-bottom: env(safe-area-inset-bottom, 40rpx);
  padding-top: var(--space-md);
}
