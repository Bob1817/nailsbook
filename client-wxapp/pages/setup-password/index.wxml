<!--
  NailBook 设置登录密码页
  微信授权注册后首次设置密码
-->

<view class="setup-root">
  <view class="stub-status"></view>

  <view class="hero">
    <view class="logo-ring">
      <text class="logo-text">N</text>
    </view>
    <text class="app-name">NailBook</text>
  </view>

  <view class="desc-area">
    <text class="desc-title">设置登录密码</text>
    <text class="desc-sub">首次登录请设置密码，后续可使用密码直接登录</text>
    <view wx:if="{{phone}}" class="phone-display">
      <text class="phone-label">手机号</text>
      <text class="phone-value">{{phone}}</text>
    </view>
  </view>

  <view class="form-area">
    <!-- 新密码 -->
    <view class="input-row">
      <image class="input-icon" src="/static/icons/lock.svg" mode="aspectFit" />
      <input
        class="input-field"
        type="{{showPassword ? 'text' : 'password'}}"
        password="{{!showPassword}}"
        value="{{newPassword}}"
        bindinput="onNewPwdInput"
        placeholder="至少 8 位，含字母和数字"
        placeholder-class="input-placeholder"
        focus="{{true}}"
      />
      <view class="pwd-toggle" bindtap="togglePassword">
        <image
          class="pwd-toggle-icon"
          src="{{showPassword ? '/static/icons/eye-open.svg' : '/static/icons/eye-closed.svg'}}"
          mode="aspectFit"
        />
      </view>
    </view>

    <!-- 确认密码 -->
    <view class="input-row">
      <image class="input-icon" src="/static/icons/lock.svg" mode="aspectFit" />
      <input
        class="input-field"
        type="{{showPassword ? 'text' : 'password'}}"
        password="{{!showPassword}}"
        value="{{confirmPassword}}"
        bindinput="onConfirmPwdInput"
        placeholder="再次输入新密码"
        placeholder-class="input-placeholder"
      />
    </view>

    <text wx:if="{{error}}" class="error-text">{{error}}</text>

    <button
      class="submit-btn {{canSubmit ? 'submit-btn-active' : ''}}"
      disabled="{{!canSubmit || loading}}"
      loading="{{loading}}"
      bindtap="handleSubmit"
    >
      确认设置并登录
    </button>
  </view>

  <text class="agreement">设置即表示同意《用户协议》和《隐私政策》</text>
</view>
