.container {
  padding: 0 48rpx;
  padding-top: 80rpx;
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.logo-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--nb-action);
  color: var(--nb-surface);
  font-size: 56rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--nb-ink);
  display: block;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 28rpx;
  color: var(--nb-muted);
  display: block;
}

.form {
  width: 100%;
}

.form-item {
  margin-bottom: 32rpx;
}

.label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--nb-ink);
  display: block;
  margin-bottom: 12rpx;
}

.optional {
  font-weight: normal;
  color: var(--nb-muted);
  font-size: 24rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  background: var(--nb-page);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.phone-display {
  width: 100%;
  height: 88rpx;
  background: var(--nb-page);
  border-radius: 12rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.phone-text {
  font-size: 28rpx;
  color: var(--nb-secondary);
}

/* 邀请码验证状态 */
.invite-status {
  margin-top: 8rpx;
  padding: 8rpx 0;
  font-size: 24rpx;
}

.invite-status.checking {
  color: var(--nb-muted);
}

.invite-status.valid {
  color: var(--nb-success);
}

.invite-status.error {
  color: var(--nb-danger);
}

.mode-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--nb-muted);
}

/* 密码行 */
.password-row {
  position: relative;
  display: flex;
  align-items: center;
}

.password-row .input {
  flex: 1;
  padding-right: 100rpx;
}

.pwd-toggle {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1;
}

.pwd-toggle-text {
  font-size: 24rpx;
  color: var(--nb-ink);
}

/* 按钮 */
.btn-primary {
  width: 100%;
  height: 88rpx;
  background: var(--nb-page);
  color: var(--nb-surface);
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 12rpx;
  border: none;
  margin-top: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary::after {
  border: none;
}

.btn-active {
  background: var(--nb-action);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3);
}

/* 链接行 */
.link-row {
  text-align: center;
  margin-top: 32rpx;
  padding-bottom: 60rpx;
}

.link {
  font-size: 28rpx;
  color: var(--nb-text-link);
}

@import '../../styles/booking-actions.wxss';
.input { height: var(--input-height); min-height: 44px; background: var(--bg-input); border-radius: var(--input-radius); padding: 0 var(--input-padding-h); font-size: var(--font-sm); }
.phone-display { min-height: var(--input-height); border-radius: var(--input-radius); font-size: var(--font-sm); }
.btn-primary.booking-action { height: var(--control-hit-height); min-height: 44px; margin-top: 24rpx; border-radius: 8px; background: var(--nb-action); font-size: var(--font-sm); box-shadow: none; }
