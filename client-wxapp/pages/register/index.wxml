<view class="register-root">
  <nav-bar title="注册" showBack titleCenter customBack bind:back="goBack"/>
  <scroll-view class="register-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="register-content">
      <text class="register-heading">创建账号</text>
      <text class="register-sub">凭邀请加入你的专属美甲服务</text>
      <view class="form-section">
        <text class="field-label">手机号</text>
        <view class="input-row"><text class="input-prefix">+86</text><view class="input-divider"></view><input class="input-field" type="number" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" placeholder="请输入手机号码" placeholder-class="input-placeholder" disabled="{{loading}}"/></view>
        <view class="label-row"><text class="field-label">邀请码 / 激活密钥</text><text class="required-mark">必填</text></view>
        <view class="input-row {{inviteError ? 'input-row-error' : ''}}"><image class="input-icon" src="/static/icons/key.svg" mode="aspectFit"/><input class="input-field" value="{{inviteInput}}" bindinput="onInviteInput" placeholder="粘贴邀请码、邀请链接或激活密钥" placeholder-class="input-placeholder" disabled="{{loading}}"/><text wx:if="{{inviteChecking}}" class="checking-text">核验中</text></view>
        <text wx:if="{{inviteError}}" class="field-message error-message">{{inviteError}}</text>
        <text wx:else class="field-message {{inviteValid || inviteType === 'activationKey' ? 'success-message' : ''}}">{{modeHint}}</text>
        <view wx:if="{{inviteType === 'activationKey'}}" class="conditional-field"><text class="field-label">美甲师姓名</text><view class="input-row"><image class="input-icon" src="/static/icons/technician.svg" mode="aspectFit"/><input class="input-field" value="{{name}}" bindinput="onNameInput" placeholder="请输入真实姓名" placeholder-class="input-placeholder" disabled="{{loading}}"/></view></view>
        <text class="field-label password-label">设置密码</text>
        <view class="input-row"><image class="input-icon" src="/static/icons/lock.svg" mode="aspectFit"/><input class="input-field" type="{{showPassword ? 'text' : 'password'}}" password="{{!showPassword}}" value="{{password}}" bindinput="onPasswordInput" placeholder="至少 8 位，含字母和数字" placeholder-class="input-placeholder" disabled="{{loading}}"/><view class="pwd-toggle" bindtap="togglePassword"><image class="pwd-toggle-icon" src="{{showPassword ? '/static/icons/eye-open.svg' : '/static/icons/eye-closed.svg'}}" mode="aspectFit"/></view></view>
        <text class="field-label">确认密码</text>
        <view class="input-row"><image class="input-icon" src="/static/icons/lock.svg" mode="aspectFit"/><input class="input-field" type="{{showPassword ? 'text' : 'password'}}" password="{{!showPassword}}" value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" placeholder="再次输入密码" placeholder-class="input-placeholder" disabled="{{loading}}"/></view>
        <checkbox-group class="privacy-consent" bindchange="onPrivacyAgreementChange"><label><checkbox color="#287A4B" value="agree" checked="{{privacyAgreed}}"/><text>我已阅读并同意</text></label><text class="privacy-link" catchtap="openUserAgreement">《用户协议》</text><text>和</text><text class="privacy-link" catchtap="openPrivacyPolicy">《隐私政策》</text></checkbox-group>
        <button class="submit-btn booking-action {{canSubmit ? 'submit-btn-active' : ''}}" disabled="{{!canSubmit || loading}}" loading="{{loading}}" bindtap="handleSubmit">注册</button>
        <view class="account-actions"><text class="account-action" bindtap="goBack">已有账号？去登录</text></view>
      </view>
    </view>
  </scroll-view>
</view>
