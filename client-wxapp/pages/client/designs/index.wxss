.container {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 40rpx;
}

/* 创建入口 */
.create-section {
  padding: var(--space-md) 40rpx;
  display: flex;
  gap: 16rpx;
}

.create-card {
  flex: 1;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 28rpx;
  box-shadow: var(--shadow-md), 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
  border: 0;
  position: relative;
  overflow: hidden;
}

.create-card:active {
  transform: scale(0.98);
}

.create-card-content {
  position: relative;
  z-index: 1;
}

.create-tag {
  display: inline-block;
  background: var(--nb-page);
  color: var(--brand-primary);
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
  padding: 6rpx 40rpx;
  border-radius: var(--radius-sm);
  margin-bottom: 20rpx;
}

.create-tag.upload {
  background: var(--nb-page);
  color: var(--nb-ink);
}

.create-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-sm);
  background: var(--brand-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-md), 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
}

.create-icon-wrap.upload {
  background: var(--nb-action);
  box-shadow: var(--shadow-md), 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
}

.create-icon-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.4);
}

.create-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.create-title {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.create-desc {
  font-size: var(--font-xs);
  color: var(--text-muted);
  line-height: 1.4;
}

/* 列表区域 */
.list-section {
  padding: 0 32rpx;
}

.list-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: var(--space-md);
}

.list-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  display: block;
  letter-spacing: -0.5rpx;
}

.list-subtitle {
  font-size: var(--font-sm);
  color: var(--text-muted);
  margin-top: 4rpx;
  display: block;
}

.list-count {
  background: rgba(255, 255, 255, 0.8);
  padding: 8rpx 40rpx;
  border-radius: var(--radius-sm);
  border: 0;
}

.count-text {
  font-size: var(--font-xs);
  color: var(--text-muted);
}

/* 加载中 */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--brand-primary);
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 空状态 */
.empty-wrap, .load-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md), 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
}
.load-error-mark { width:88rpx; height:88rpx; margin-bottom: var(--space-md); border-radius:50%; background:var(--nb-page); color:var(--nb-ink); font-size: var(--font-xl); line-height:88rpx; text-align:center; }
.retry-btn { min-height:88rpx; margin:40rpx 0 0; padding:0 56rpx; border:0; border-radius: var(--radius-xl); background:var(--nb-ink); color: var(--text-inverse); font-size: var(--font-md); line-height:88rpx; }
.retry-btn::after { border:0; }

.empty-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--bg-input);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-md);
}

.empty-icon-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--nb-page);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-icon-dot::after {
  content: '';
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--brand-gradient);
}

.empty-title {
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  color: var(--text-body);
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

/* 设计网格 */
.design-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.design-card {
  position: relative;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--bg-card);
  box-shadow: var(--shadow-md), 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
  width: calc(50% - 8rpx);
}

.design-card:active {
  transform: scale(0.98);
}

.card-tall {
  aspect-ratio: 3/4;
}

.card-square {
  aspect-ratio: 1;
}

.design-img {
  width: 100%;
  height: 100%;
}

.design-img-empty {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--nb-page);
}

.empty-img-icon-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--nb-page);
  opacity: 0.6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-img-icon-dot::after {
  content: '';
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--brand-gradient);
}

/* 状态标签 */
.status-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 6rpx 40rpx;
  border-radius: var(--radius-sm);
}

.status-pending {
  background: rgba(0, 0, 0, 0.2);
  border: 0;
}

.status-quoted {
  background: rgba(0, 0, 0, 0.2);
  border: 0;
}

.status-accepted {
  background: rgba(0, 0, 0, 0.2);
  border: 0;
}

.status-rejected {
  background: rgba(0, 0, 0, 0.2);
  border: 0;
}

.status-converted {
  background: rgba(0, 0, 0, 0.2);
  border: 0;
}

.status-cancelled {
  background: rgba(0, 0, 0, 0.2);
  border: 0;
}

.status-text {
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
}

.status-pending .status-text {
  color: var(--nb-text-link);
}

.status-quoted .status-text {
  color: var(--nb-text-link);
}

.status-accepted .status-text {
  color: var(--nb-success);
}

.status-rejected .status-text {
  color: var(--text-error);
}

.status-converted .status-text {
  color: var(--nb-success);
}

.status-cancelled .status-text {
  color: var(--nb-secondary);
}

/* 设计需求状态：颜色辅助文案，不替代状态文字 */

/* 底部信息 */
.design-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--space-md);
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
}

.design-name {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-inverse);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.design-desc {
  font-size: var(--font-xs);
  color: rgba(255, 255, 255, 0.78);
  margin-top: 4rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.design-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.design-date {
  font-size: var(--font-xs);
  color: rgba(255, 255, 255, 0.72);
}

.design-action {
  font-size: var(--font-xs);
  color: rgba(255, 255, 255, 0.92);
  font-weight: var(--weight-medium);
}

/* 创建入口与设计列表对齐客户端“我的”的卡片规范。 */
.container { background: var(--nb-page); padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.create-section { padding: 24rpx 32rpx 20rpx; gap: 16rpx; }
.create-card { min-height: 216rpx; padding: 24rpx; border-radius: 24rpx; box-shadow: none; box-sizing: border-box; }
.create-tag { margin-bottom: 16rpx; padding: 6rpx 14rpx; border-radius: 12rpx; color: var(--nb-muted); }
.create-icon-wrap,.create-icon-wrap.upload { width: 64rpx; height: 64rpx; margin-bottom: 16rpx; border-radius: 16rpx; background: var(--nb-ink); box-shadow: none; }
.create-title { color: var(--nb-ink); font-size: var(--font-md); font-weight: var(--weight-semibold); }
.create-desc { margin-top: 2rpx; color: var(--nb-muted); font-size: var(--font-xs); }
.list-section { padding: 0 32rpx; }
.list-header { align-items: center; margin-bottom: 16rpx; }
.list-title { color: var(--nb-ink); font-size: var(--font-lg); font-weight: var(--weight-semibold); letter-spacing: 0; }
.list-subtitle { color: var(--nb-muted); font-size: var(--font-xs); }
.list-count { padding: 8rpx 14rpx; border-radius: 14rpx; background: var(--nb-surface); }
.design-grid { gap: 16rpx; }
.design-card { border-radius: 20rpx; box-shadow: none; }
.status-badge { padding: 6rpx 12rpx; border-radius: 12rpx; }
.empty-wrap,.load-error { padding: 64rpx 32rpx; border-radius: 24rpx; box-shadow: none; }
@import '../../../styles/booking-actions.wxss';
.retry-btn.booking-action { min-height:44px; height:44px; margin-top:40rpx; padding:0 24rpx; border-radius:8px; font-size:var(--font-sm); line-height:1.4; }
