.container {
  min-height: 100vh;
  background: #f8f9fc;
  padding-bottom: 40rpx;
}

/* 创建入口 */
.create-section {
  padding: 24rpx 40rpx;
  display: flex;
  gap: 16rpx;
}

.create-card {
  flex: 1;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
}

.create-card:active {
  transform: scale(0.98);
}

.create-card-content {
  position: relative;
  z-index: 1;
}

.create-tag {
  display: inline-block;
  background: #fff1f5;
  color: #FF6B8A;
  font-size: 22rpx;
  font-weight: 500;
  padding: 6rpx 40rpx;
  border-radius: 14rpx;
  margin-bottom: 20rpx;
}

.create-tag.upload {
  background: #ecfdf5;
  color: #10b981;
}

.create-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
}

.create-icon-wrap.upload {
  background: linear-gradient(135deg, #34d399, #10b981);
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
}

.create-icon-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.4);
}

.create-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.create-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.create-desc {
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.4;
}

/* 列表区域 */
.list-section {
  padding: 0 32rpx;
}

.list-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.list-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
  display: block;
  letter-spacing: -0.5rpx;
}

.list-subtitle {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 4rpx;
  display: block;
}

.list-count {
  background: rgba(255, 255, 255, 0.8);
  padding: 8rpx 40rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

.count-text {
  font-size: 22rpx;
  color: #6b7280;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #FF6B8A;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 空状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
}

.empty-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-icon-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF0F3 0%, #F5F3FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-icon-dot::after {
  content: '';
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B8A, #A78BFA);
}

.empty-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #4b5563;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 设计网格 */
.design-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.design-card {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  width: calc(50% - 8rpx);
}

.design-card:active {
  transform: scale(0.98);
}

.card-tall {
  aspect-ratio: 3/4;
}

.card-square {
  aspect-ratio: 1;
}

.design-img {
  width: 100%;
  height: 100%;
}

.design-img-empty {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f1f5f9, #e2e8f0);
}

.empty-img-icon-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF0F3 0%, #F5F3FF 100%);
  opacity: 0.6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-img-icon-dot::after {
  content: '';
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B8A, #A78BFA);
}

/* 状态标签 */
.status-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 6rpx 40rpx;
  border-radius: 14rpx;
}

.status-pending {
  background: rgba(251, 191, 36, 0.2);
  border: 1rpx solid rgba(251, 191, 36, 0.3);
}

.status-quoted {
  background: rgba(59, 130, 246, 0.2);
  border: 1rpx solid rgba(59, 130, 246, 0.3);
}

.status-accepted {
  background: rgba(16, 185, 129, 0.2);
  border: 1rpx solid rgba(16, 185, 129, 0.3);
}

.status-rejected {
  background: rgba(239, 68, 68, 0.2);
  border: 1rpx solid rgba(239, 68, 68, 0.3);
}

.status-converted {
  background: rgba(168, 85, 247, 0.2);
  border: 1rpx solid rgba(168, 85, 247, 0.3);
}

.status-cancelled {
  background: rgba(107, 114, 128, 0.2);
  border: 1rpx solid rgba(107, 114, 128, 0.3);
}

.status-text {
  font-size: 20rpx;
  font-weight: 500;
}

.status-pending .status-text {
  color: #d97706;
}

.status-quoted .status-text {
  color: #2563eb;
}

.status-accepted .status-text {
  color: #059669;
}

.status-rejected .status-text {
  color: #dc2626;
}

.status-converted .status-text {
  color: #9333ea;
}

.status-cancelled .status-text {
  color: #4b5563;
}

/* 底部信息 */
.design-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
}

.design-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.design-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  margin-top: 4rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.design-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.design-date {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.design-action {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
  font-weight: 500;
}
