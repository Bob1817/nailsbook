.container {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 40rpx;
}

/* 创建入口 */
.create-section {
  padding: var(--space-md) 40rpx;
  display: flex;
  gap: 16rpx;
}

.create-card {
  flex: 1;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 28rpx;
  box-shadow: var(--shadow-md), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
}

.create-card:active {
  transform: scale(0.98);
}

.create-card-content {
  position: relative;
  z-index: 1;
}

.create-tag {
  display: inline-block;
  background: #fff1f5;
  color: var(--brand-primary);
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
  padding: 6rpx 40rpx;
  border-radius: var(--radius-sm);
  margin-bottom: 20rpx;
}

.create-tag.upload {
  background: #ecfdf5;
  color: #10b981;
}

.create-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-sm);
  background: var(--brand-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-md), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
}

.create-icon-wrap.upload {
  background: linear-gradient(135deg, #34d399, #10b981);
  box-shadow: var(--shadow-md), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
}

.create-icon-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.4);
}

.create-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.create-title {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.create-desc {
  font-size: var(--font-xs);
  color: var(--text-muted);
  line-height: 1.4;
}

/* 列表区域 */
.list-section {
  padding: 0 32rpx;
}

.list-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: var(--space-md);
}

.list-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  display: block;
  letter-spacing: -0.5rpx;
}

.list-subtitle {
  font-size: var(--font-sm);
  color: var(--text-muted);
  margin-top: 4rpx;
  display: block;
}

.list-count {
  background: rgba(255, 255, 255, 0.8);
  padding: 8rpx 40rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

.count-text {
  font-size: var(--font-xs);
  color: var(--text-muted);
}

/* 加载中 */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--brand-primary);
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 空状态 */
.empty-wrap, .load-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
}
.load-error-mark { width:88rpx; height:88rpx; margin-bottom: var(--space-md); border-radius:50%; background:#fff0f4; color:#c75b83; font-size: var(--font-xl); line-height:88rpx; text-align:center; }
.retry-btn { min-height:88rpx; margin:40rpx 0 0; padding:0 56rpx; border:0; border-radius: var(--radius-xl); background:#1f2937; color: var(--text-inverse); font-size: var(--font-md); line-height:88rpx; }
.retry-btn::after { border:0; }

.empty-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--bg-input);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-md);
}

.empty-icon-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF0F3 0%, #F5F3FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-icon-dot::after {
  content: '';
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--brand-gradient);
}

.empty-title {
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  color: var(--text-body);
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

/* 设计网格 */
.design-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.design-card {
  position: relative;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--bg-card);
  box-shadow: var(--shadow-md), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  width: calc(50% - 8rpx);
}

.design-card:active {
  transform: scale(0.98);
}

.card-tall {
  aspect-ratio: 3/4;
}

.card-square {
  aspect-ratio: 1;
}

.design-img {
  width: 100%;
  height: 100%;
}

.design-img-empty {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f1f5f9, #e2e8f0);
}

.empty-img-icon-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF0F3 0%, #F5F3FF 100%);
  opacity: 0.6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-img-icon-dot::after {
  content: '';
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--brand-gradient);
}

/* 状态标签 */
.status-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 6rpx 40rpx;
  border-radius: var(--radius-sm);
}

.status-pending {
  background: rgba(251, 191, 36, 0.2);
  border: 1rpx solid rgba(251, 191, 36, 0.3);
}

.status-quoted {
  background: rgba(59, 130, 246, 0.2);
  border: 1rpx solid rgba(59, 130, 246, 0.3);
}

.status-accepted {
  background: rgba(16, 185, 129, 0.2);
  border: 1rpx solid rgba(16, 185, 129, 0.3);
}

.status-rejected {
  background: rgba(239, 68, 68, 0.2);
  border: 1rpx solid rgba(239, 68, 68, 0.3);
}

.status-converted {
  background: rgba(168, 85, 247, 0.2);
  border: 1rpx solid rgba(168, 85, 247, 0.3);
}

.status-cancelled {
  background: rgba(107, 114, 128, 0.2);
  border: 1rpx solid rgba(107, 114, 128, 0.3);
}

.status-text {
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
}

.status-pending .status-text {
  color: #d97706;
}

.status-quoted .status-text {
  color: #2563eb;
}

.status-accepted .status-text {
  color: #059669;
}

.status-rejected .status-text {
  color: var(--text-error);
}

.status-converted .status-text {
  color: #9333ea;
}

.status-cancelled .status-text {
  color: var(--text-body);
}

/* 底部信息 */
.design-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--space-md);
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
}

.design-name {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-inverse);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.design-desc {
  font-size: var(--font-xs);
  color: rgba(255, 255, 255, 0.78);
  margin-top: 4rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.design-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.design-date {
  font-size: var(--font-xs);
  color: rgba(255, 255, 255, 0.72);
}

.design-action {
  font-size: var(--font-xs);
  color: rgba(255, 255, 255, 0.92);
  font-weight: var(--weight-medium);
}
