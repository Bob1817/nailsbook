<view class="page">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
  </view>

  <!-- 消息列表 -->
  <scroll-view
    wx:else
    scroll-y
    class="msg-list"
    scroll-into-view="{{scrollToId}}"
    scroll-with-animation
  >
    <view wx:if="{{messages.length === 0}}" class="empty-chat">
      <text class="empty-icon">💬</text>
      <text class="empty-title">开始和{{techName || '美甲师'}}沟通</text>
      <text class="empty-desc">把你的款式灵感、预约想法发给美甲师</text>
    </view>

    <view
      wx:for="{{messages}}"
      wx:key="id"
      id="msg-{{item.id}}"
      class="msg-row {{item.isClient ? 'row-right' : 'row-left'}}"
    >
      <!-- 对方头像 -->
      <view wx:if="{{!item.isClient}}" class="msg-avatar">
        <image wx:if="{{techAvatar}}" src="{{techAvatar}}" mode="aspectFill" class="avatar-img" />
        <view wx:else class="avatar-placeholder">
          <text>{{techName[0] || '师'}}</text>
        </view>
      </view>

      <view class="msg-content-wrap">
        <!-- 图片消息 -->
        <view wx:if="{{item.messageType === 'image' && item.imageUrl}}" class="bubble bubble-{{item.isClient ? 'right' : 'left'}} bubble-img" bindtap="previewImage" data-url="{{item.imageUrl}}">
          <image src="{{item.imageUrl}}" mode="widthFix" class="msg-image" />
        </view>
        <!-- 文字消息 -->
        <view wx:else class="bubble bubble-{{item.isClient ? 'right' : 'left'}}">
          <text class="msg-text">{{item.content}}</text>
        </view>
        <text class="msg-time {{item.isClient ? 'time-right' : 'time-left'}}">{{item.timeStr}}</text>
      </view>

      <!-- 自己头像 -->
      <view wx:if="{{item.isClient}}" class="msg-avatar">
        <view class="avatar-self">
          <text>我</text>
        </view>
      </view>
    </view>

    <view class="list-bottom"></view>
  </scroll-view>

  <!-- 底部输入栏 -->
  <view class="input-bar">
    <view class="input-btn" bindtap="sendImage">
      <text class="input-btn-icon">🖼️</text>
    </view>
    <input
      class="input-field"
      type="text"
      value="{{inputText}}"
      bindinput="onInputChange"
      placeholder="发消息..."
      placeholder-class="input-placeholder"
      confirm-type="send"
      bindconfirm="sendText"
    />
    <button
      class="send-btn {{inputText.length > 0 ? 'send-btn-active' : ''}}"
      bindtap="sendText"
      disabled="{{!inputText || sending}}"
    >
      <text wx:if="{{!sending}}">发送</text>
      <view wx:else class="sending-spinner"></view>
    </button>
  </view>
</view>
