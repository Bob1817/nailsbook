page {
  background: linear-gradient(180deg, #FFFDFD 0%, #F8F3F6 46%, #F4F6FB 100%);
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

/* ===== 加载中 ===== */
.loading-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-spinner, .sending-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(255, 107, 138, 0.25);
  border-top-color: #FF6B8A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.sending-spinner {
  width: 28rpx;
  height: 28rpx;
  border-width: 3rpx;
  border-color: rgba(255, 255, 255, 0.4);
  border-top-color: #fff;
}

@keyframes spin { to { transform: rotate(360deg); } }

/* ===== 日期分隔符 ===== */
.date-separator {
  display: flex;
  justify-content: center;
  padding: 28rpx 0 16rpx;
}

.date-label {
  font-size: 22rpx;
  color: #6b7280;
  background: rgba(255, 255, 255, 0.8);
  padding: 6rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.04);
}

/* ===== 消息列表 ===== */
.msg-list {
  flex: 1;
  min-height: 0;
  padding: 8rpx 0;
}

.empty-chat {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.empty-icon-wrap {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFE2EA 0%, #F4F6FB 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-icon-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  opacity: 0.5;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #6b7280;
  text-align: center;
  line-height: 1.5;
}

.msg-row {
  display: flex;
  align-items: flex-end;
  padding: 8rpx 32rpx;
  gap: 12rpx;
}

.row-right {
  flex-direction: row-reverse;
}

.row-left {
  flex-direction: row;
}

.msg-avatar {
  flex-shrink: 0;
}

.avatar-img {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f0f0f0;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
}

.avatar-placeholder, .avatar-self {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
}

.avatar-placeholder {
  background: linear-gradient(135deg, #FFE0EA, #F4F7FB);
  color: #FF6B8A;
}

.avatar-self {
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
}

.msg-content-wrap {
  max-width: 72%;
  display: flex;
  flex-direction: column;
}

.row-right .msg-content-wrap {
  align-items: flex-end;
}

.row-left .msg-content-wrap {
  align-items: flex-start;
}

/* ===== 消息气泡 ===== */
.bubble {
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  word-break: break-word;
  max-width: 100%;
  position: relative;
}

.bubble-right {
  background: linear-gradient(135deg, #FF6B8A 0%, #FF8FA3 100%);
  border-bottom-right-radius: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 138, 0.15), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
}

.bubble-left {
  background: rgba(255, 255, 255, 0.9);
  border-bottom-left-radius: 8rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
}

.bubble-img {
  padding: 8rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
}

.msg-text {
  font-size: 28rpx;
  line-height: 1.55;
}

.bubble-right .msg-text {
  color: #fff;
}

.bubble-left .msg-text {
  color: #1f2937;
}

.msg-image {
  max-width: 360rpx;
  border-radius: 16rpx;
  display: block;
}

/* 时间戳（内嵌在气泡内） */
.msg-time-inline {
  display: block;
  font-size: 20rpx;
  margin-top: 8rpx;
  opacity: 0.6;
}

.time-right {
  color: rgba(255, 255, 255, 0.7);
  text-align: right;
}

.time-left {
  color: #6b7280;
  text-align: left;
}

.list-bottom {
  height: 0;
}

/* ===== 系统消息 ===== */
.system-msg {
  text-align: center;
  padding: 8rpx 0;
  margin: 4rpx 0;
}

.system-text {
  font-size: 22rpx;
  color: #6b7280;
  background: rgba(255, 255, 255, 0.7);
  padding: 8rpx 32rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
}

/* ===== 预约卡片消息 ===== */
.order-card-msg {
  display: flex;
  border-radius: 20rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  width: 480rpx;
}

.card-right {
  border: 1rpx solid rgba(255, 107, 138, 0.15);
}

.card-accent {
  width: 6rpx;
  flex-shrink: 0;
  background: linear-gradient(180deg, #FF6B8A 0%, #A78BFA 100%);
}

.card-inner {
  flex: 1;
  padding: 24rpx;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.card-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #1f2937;
}

.card-content {
  font-size: 24rpx;
  color: #374151;
  line-height: 1.6;
  display: block;
  white-space: pre-line;
}

.card-action {
  font-size: 24rpx;
  color: #FF6B8A;
  font-weight: 500;
  margin-top: 12rpx;
  display: block;
}

/* ===== 底部输入栏 ===== */
.input-bar {
  position: relative;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.88);
  border-top: 1rpx solid rgba(255, 255, 255, 0.6);
  gap: 12rpx;
}

/* ===== + 下拉菜单 ===== */
.add-menu-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 20;
}

.field-add-active .icon-add { transform: rotate(45deg); transition: transform 0.18s; }

.add-menu {
  position: absolute;
  left: 28rpx;
  bottom: 100%;
  margin-bottom: 14rpx;
  z-index: 30;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 8rpx 0;
  min-width: 248rpx;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.16), 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
  animation: menuPop 0.16s ease-out;
}

@keyframes menuPop {
  from { opacity: 0; transform: translateY(10rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.add-menu-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 28rpx;
}
.add-menu-item:active { background: #f5f6fa; }

.add-menu-divider {
  height: 1rpx;
  background: #f0f1f4;
  margin: 0 20rpx;
}

.add-menu-text {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
}

/* 菜单底部小箭头，指向 + 按钮 */
.add-menu-arrow {
  position: absolute;
  left: 40rpx;
  bottom: -12rpx;
  width: 24rpx;
  height: 24rpx;
  background: #ffffff;
  transform: rotate(45deg);
  border-radius: 0 0 6rpx 0;
  box-shadow: 4rpx 4rpx 10rpx rgba(15, 23, 42, 0.06);
}

/* 菜单图标 */
.add-menu-icon { width: 40rpx; height: 40rpx; position: relative; flex-shrink: 0; }

/* 图片图标 */
.menu-icon-image {
  border: 3rpx solid #5b8def;
  border-radius: 8rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.menu-icon-image::before {
  content: '';
  position: absolute;
  top: 7rpx; left: 8rpx;
  width: 8rpx; height: 8rpx;
  border-radius: 50%;
  background: #5b8def;
}
.menu-icon-image::after {
  content: '';
  position: absolute;
  bottom: 0; left: 4rpx;
  width: 0; height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 14rpx solid #5b8def;
}

/* 预约图标：日历 */
.menu-icon-booking {
  border: 3rpx solid #FF6B8A;
  border-radius: 6rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.menu-icon-booking::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 11rpx;
  background: #FF6B8A;
}
.menu-icon-booking::after {
  content: '';
  position: absolute;
  left: 50%; top: 22rpx;
  transform: translateX(-50%);
  width: 8rpx; height: 8rpx;
  border-radius: 1rpx;
  background: #FF6B8A;
}

/* ===== 输入框（左侧内置 + 号上传图片）===== */
.input-field-wrap {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  background: #f3f4f6;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx 0 10rpx;
  gap: 8rpx;
}

.field-add-btn {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.field-add-btn:active { opacity: 0.55; }

/* + 号图标 */
.icon-add {
  position: relative;
  width: 34rpx;
  height: 34rpx;
}

.icon-add::before,
.icon-add::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  background: #8a93a3;
  border-radius: 3rpx;
}

.icon-add::before {
  width: 30rpx;
  height: 5rpx;
  transform: translate(-50%, -50%);
}

.icon-add::after {
  width: 5rpx;
  height: 30rpx;
  transform: translate(-50%, -50%);
}

.input-field {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: 28rpx;
  color: #1f2937;
  background: transparent;
}

.input-placeholder {
  color: #6b7280;
  font-size: 28rpx;
}

/* ===== 发送按钮 ===== */
.send-btn {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e5e7eb;
  border: none;
  padding: 0;
  line-height: 1;
}

.send-btn::after { border: none; }

.send-btn:active { opacity: 0.85; }

.send-btn-active {
  background: linear-gradient(135deg, #FF6B8A 0%, #FF8FA3 100%);
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 138, 0.3);
}

/* 发送图标：向上箭头（直观表达「发送」）*/
.icon-send {
  position: relative;
  width: 34rpx;
  height: 34rpx;
}

.icon-send::before {
  content: '';
  position: absolute;
  top: 3rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 14rpx solid #9ca3af;
}

.icon-send::after {
  content: '';
  position: absolute;
  top: 15rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 6rpx;
  height: 16rpx;
  background: #9ca3af;
  border-radius: 0 0 3rpx 3rpx;
}

.send-btn-active .icon-send::before { border-bottom-color: #ffffff; }
.send-btn-active .icon-send::after { background: #ffffff; }

/* ===== 预约快捷入口 ===== */
.booking-btn {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF0F3;
}

.booking-btn:active { background: #ffe0e7; }

/* 日历图标：表头 + 框体 + 日期点，直观表达「预约」*/
.icon-calendar {
  position: relative;
  width: 36rpx;
  height: 34rpx;
  border: 3rpx solid #FF6B8A;
  border-radius: 6rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.icon-calendar::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 9rpx;
  background: #FF6B8A;
}

.icon-calendar::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 19rpx;
  transform: translateX(-50%);
  width: 7rpx;
  height: 7rpx;
  border-radius: 1rpx;
  background: #FF6B8A;
}

/* ===== 预约卡片弹层 ===== */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1500;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1501;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 70vh;
  padding-bottom: env(safe-area-inset-bottom);
}

.sheet-show { transform: translateY(0); }

.sheet-handle {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 8rpx;
}

.sheet-handle-bar {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #e5e7eb;
}

.sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 40rpx 24rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.sheet-close {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f3f4f6;
}

.sheet-close:active { background: #e5e7eb; }

.sheet-close-icon {
  width: 18rpx;
  height: 18rpx;
  position: relative;
}

.sheet-close-icon::before,
.sheet-close-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 18rpx;
  height: 3rpx;
  background: #6b7280;
  border-radius: 2rpx;
}

.sheet-close-icon::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.sheet-close-icon::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.sheet-body {
  padding: 24rpx 40rpx;
  overflow-y: auto;
  max-height: 50vh;
}

.order-select-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.order-select-item {
  display: flex;
  align-items: center;
  padding: 4rpx;
  background: #f8f9fc;
  border-radius: 20rpx;
  overflow: hidden;
}

.order-select-item:active { background: #f0f1f5; }

.order-select-accent {
  width: 6rpx;
  align-self: stretch;
  background: linear-gradient(180deg, #FF6B8A 0%, #A78BFA 100%);
  border-radius: 3rpx;
  margin-right: 20rpx;
}

.order-select-info {
  flex: 1;
  min-width: 0;
  padding: 16rpx 0;
}

.order-select-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2937;
  display: block;
}

.order-select-detail {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 4rpx;
  display: block;
}

.order-select-send {
  font-size: 26rpx;
  color: #FF6B8A;
  font-weight: 600;
  flex-shrink: 0;
  padding: 0 24rpx;
}

.empty-orders {
  text-align: center;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-orders-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFE2EA 0%, #F4F6FB 100%);
  margin-bottom: 8rpx;
}

.empty-orders-text {
  font-size: 26rpx;
  color: #6b7280;
}

.go-booking-btn {
  display: inline-block;
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 138, 0.25);
}
