.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f2f3f5;
}

.loading-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-spinner, .sending-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(255,107,138,0.3);
  border-top-color: #FF6B8A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.sending-spinner {
  width: 28rpx;
  height: 28rpx;
  border-width: 3rpx;
  border-color: rgba(255,255,255,0.5);
  border-top-color: #fff;
}

@keyframes spin { to { transform: rotate(360deg); } }

.msg-list {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx 0;
}

.empty-chat {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  text-align: center;
}

.msg-row {
  display: flex;
  align-items: flex-end;
  padding: 12rpx 24rpx;
  gap: 16rpx;
}

.row-right {
  flex-direction: row-reverse;
}

.row-left {
  flex-direction: row;
}

.msg-avatar {
  flex-shrink: 0;
}

.avatar-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.avatar-placeholder, .avatar-self {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.avatar-placeholder {
  background: linear-gradient(135deg, #FFE0EA, #F4F7FB);
  color: #FF6B8A;
}

.avatar-self {
  background: linear-gradient(135deg, #FF6B8A, #FF8FA3);
  color: #fff;
}

.msg-content-wrap {
  max-width: 70%;
  display: flex;
  flex-direction: column;
}

.row-right .msg-content-wrap {
  align-items: flex-end;
}

.row-left .msg-content-wrap {
  align-items: flex-start;
}

.bubble {
  border-radius: 24rpx;
  padding: 20rpx 28rpx;
  word-break: break-word;
  max-width: 100%;
}

.bubble-right {
  background: linear-gradient(135deg, #FF6B8A, #FF8FA3);
  border-bottom-right-radius: 8rpx;
}

.bubble-left {
  background: #fff;
  border-bottom-left-radius: 8rpx;
}

.bubble-img {
  padding: 8rpx;
  background: #fff;
}

.msg-text {
  font-size: 30rpx;
  line-height: 1.6;
}

.bubble-right .msg-text {
  color: #fff;
}

.bubble-left .msg-text {
  color: #1a1a1a;
}

.msg-image {
  max-width: 300rpx;
  border-radius: 16rpx;
  display: block;
}

.msg-time {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 6rpx;
}

.list-bottom {
  height: 20rpx;
}

.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  gap: 16rpx;
}

.input-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.input-btn-icon {
  font-size: 44rpx;
}

.input-field {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #1a1a1a;
}

.input-placeholder {
  color: #bbb;
  font-size: 30rpx;
}

.send-btn {
  flex-shrink: 0;
  height: 72rpx;
  min-width: 120rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  background: #e0e0e0;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 1;
}

.send-btn-active {
  background: linear-gradient(135deg, #FF6B8A, #FF8FA3);
  color: #fff;
}

.send-btn::after {
  border: none;
}
