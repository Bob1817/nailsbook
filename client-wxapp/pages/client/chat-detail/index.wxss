page {
  background: var(--nb-page);
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

/* ===== 加载中 ===== */
.loading-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-spinner, .sending-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(0, 0, 0, 0.25) /* brand-primary-alpha */;
  border-top-color: var(--brand-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.sending-spinner {
  width: 28rpx;
  height: 28rpx;
  border-width: 3rpx;
  border-color: rgba(255, 255, 255, 0.4);
  border-top-color: var(--text-inverse);
}

@keyframes spin { to { transform: rotate(360deg); } }

/* ===== 日期分隔符 ===== */
.date-separator {
  display: flex;
  justify-content: center;
  padding: 28rpx 0 16rpx;
}

.date-label {
  font-size: var(--font-xs);
  color: var(--text-muted);
  background: rgba(255, 255, 255, 0.8);
  padding: 6rpx 24rpx;
  border-radius: var(--radius-md);
  border: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* ===== 消息列表 ===== */
.msg-list {
  flex: 1;
  min-height: 0;
  padding: 8rpx 0;
}

.empty-chat {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.empty-icon-wrap {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--nb-page);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-md);
}

.empty-icon-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: var(--radius-sm);
  background: var(--brand-gradient);
  opacity: 0.5;
}

.empty-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: var(--font-sm);
  color: var(--text-muted);
  text-align: center;
  line-height: var(--leading-normal);
}

.msg-row {
  display: flex;
  align-items: flex-end;
  padding: 8rpx 32rpx;
  gap: 12rpx;
}

.row-right {
  flex-direction: row-reverse;
}

.row-left {
  flex-direction: row;
}

.msg-avatar {
  flex-shrink: 0;
}

.avatar-img {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--nb-page);
  border: 0;
}

.avatar-placeholder, .avatar-self {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm);
  font-weight: var(--weight-semibold);
  border: 0;
}

.avatar-placeholder {
  background: var(--nb-page);
  color: var(--brand-primary);
}

.avatar-self {
  background: var(--brand-gradient);
  color: var(--text-inverse);
}

.msg-content-wrap {
  max-width: 72%;
  display: flex;
  flex-direction: column;
}

.row-right .msg-content-wrap {
  align-items: flex-end;
}

.row-left .msg-content-wrap {
  align-items: flex-start;
}

/* ===== 消息气泡 ===== */
.bubble {
  border-radius: var(--radius-md);
  padding: 16rpx 24rpx;
  word-break: break-word;
  max-width: 100%;
  position: relative;
}

.bubble-right {
  background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-primary-light) 100%);
  border-bottom-right-radius: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15) /* brand-primary-alpha */, 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
}

.bubble-left {
  background: rgba(255, 255, 255, 0.9);
  border-bottom-left-radius: 8rpx;
  border: 0;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06), 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
}

.bubble-img {
  padding: 8rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 0;
}

.msg-text {
  font-size: var(--font-md);
  line-height: 1.55;
}

.bubble-right .msg-text {
  color: var(--text-inverse);
}

.bubble-left .msg-text {
  color: var(--text-primary);
}

.msg-image {
  max-width: 360rpx;
  border-radius: var(--radius-sm);
  display: block;
}

/* 时间戳（内嵌在气泡内） */
.msg-time-inline {
  display: block;
  font-size: var(--font-xs);
  margin-top: 8rpx;
  opacity: 0.6;
}

.time-right {
  color: rgba(255, 255, 255, 0.7);
  text-align: right;
}

.time-left {
  color: var(--text-muted);
  text-align: left;
}

.list-bottom {
  height: 0;
}

/* ===== 系统消息 ===== */
.system-msg {
  text-align: center;
  padding: 8rpx 0;
  margin: 4rpx 0;
}

.system-text {
  font-size: var(--font-xs);
  color: var(--text-muted);
  background: rgba(255, 255, 255, 0.7);
  padding: 8rpx 32rpx;
  border-radius: var(--radius-md);
  border: 0;
}

/* ===== 预约卡片消息 ===== */
.order-card-msg {
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--nb-surface);
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.055);
  border: 0;
  width: 460rpx;
  max-width: 100%;
  box-sizing: border-box;
}

.order-card-msg:active { background:var(--nb-page); }
.card-right { border-color:var(--nb-line); }

.card-inner { padding: 24rpx 24rpx 0; }
.card-header { display: flex; align-items: center; gap: 10rpx; margin-bottom: 12rpx; }
.card-calendar-icon { width: 30rpx; height: 30rpx; flex-shrink: 0; }
.card-label { font-size: 28rpx; font-weight: 600; color: var(--nb-ink); line-height: 1.4; }
.card-kind { margin-left: auto; padding: 2rpx 10rpx; border-radius: 8rpx; background: var(--nb-page); color: var(--nb-secondary); font-size: 22rpx; line-height: 1.4; }
.card-content { display: block; font-size: 26rpx; color: var(--nb-secondary); line-height: 1.55; white-space: pre-line; overflow-wrap: break-word; }
.card-footer { min-height: 88rpx; margin-top: 12rpx; border-top: 0; display: flex; align-items: center; justify-content: space-between; }
.card-action { font-size: 26rpx; color: var(--nb-text-link); font-weight: 500; }
.card-chevron { color: var(--nb-text-link); font-size: 30rpx; line-height: 1; }

/* ===== 底部输入栏 ===== */
.input-bar {
  position: relative;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.88);
  border-top: 0;
  gap: 12rpx;
}

/* ===== + 下拉菜单 ===== */
.add-menu-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 20;
}

.field-add-active { background: var(--nb-active-surface); }

.add-menu {
  position: absolute;
  left: 28rpx;
  bottom: 100%;
  margin-bottom: 14rpx;
  z-index: 30;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 8rpx 0;
  min-width: 248rpx;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.16), 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  animation: menuPop 0.16s ease-out;
}

@keyframes menuPop {
  from { opacity: 0; transform: translateY(10rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.add-menu-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: var(--space-md) 28rpx;
}
.add-menu-item:active { background: var(--bg-page); }

.add-menu-divider {
  height: 1rpx;
  background: var(--nb-page);
  margin: 0 20rpx;
}

.add-menu-text {
  font-size: var(--font-md);
  color: var(--text-primary);
  font-weight: var(--weight-medium);
}

/* 菜单底部小箭头，指向 + 按钮 */
.add-menu-arrow {
  position: absolute;
  left: 40rpx;
  bottom: -12rpx;
  width: 24rpx;
  height: 24rpx;
  background: var(--bg-card);
  transform: rotate(45deg);
  border-radius: 0 0 6rpx 0;
  box-shadow: 4rpx 4rpx 10rpx rgba(0, 0, 0, 0.06);
}

/* 菜单图标 */
.add-menu-icon { width: 40rpx; height: 40rpx; flex-shrink: 0; background: center / contain no-repeat; }


/* ===== 输入框（左侧内置 + 号上传图片）===== */
.input-field-wrap {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  background: var(--bg-input);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx 0 10rpx;
  gap: 8rpx;
}

.field-add-btn {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.field-add-btn:active { opacity: 0.55; }

.input-field {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: var(--font-md);
  color: var(--text-primary);
  background: transparent;
}

.input-placeholder {
  color: var(--text-muted);
  font-size: var(--font-md);
}

/* ===== 发送按钮 ===== */
.send-btn {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--nb-page);
  border: none;
  padding: 0;
  line-height: 1;
}

.send-btn::after { border: none; }

.send-btn:active { opacity: 0.85; }

.send-btn-active {
  background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-primary-light) 100%);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3) /* brand-primary-alpha */;
}

/* ===== 预约快捷入口 ===== */
.booking-btn {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--nb-page);
}

.booking-btn:active { background: var(--nb-page); }

/* ===== 预约卡片弹层 ===== */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1500;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-card);
  border-radius: var(--radius-lg) 32rpx 0 0;
  z-index: 1501;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 70vh;
  padding-bottom: env(safe-area-inset-bottom);
}

.sheet-show { transform: translateY(0); }

.sheet-handle {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 8rpx;
}

.sheet-handle-bar {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--nb-page);
}

.sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 40rpx 24rpx;
  border-bottom: 0;
}

.sheet-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.sheet-close {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--bg-input);
}

.sheet-close:active { background: var(--nb-page); }

.sheet-close-icon {
  width: 18rpx;
  height: 18rpx;
  position: relative;
}

.sheet-close-icon::before,
.sheet-close-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 18rpx;
  height: 3rpx;
  background: var(--nb-muted);
  border-radius: 2rpx;
}

.sheet-close-icon::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.sheet-close-icon::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.sheet-body {
  padding: var(--space-md) 40rpx;
  overflow-y: auto;
  max-height: 50vh;
}

.order-select-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.order-select-item {
  display: flex;
  align-items: center;
  padding: 4rpx;
  background: var(--bg-page);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.order-select-item:active { background: var(--nb-page); }

.order-select-accent {
  width: 6rpx;
  align-self: stretch;
  background: var(--nb-action);
  border-radius: 3rpx;
  margin-right: 20rpx;
}

.order-select-info {
  flex: 1;
  min-width: 0;
  padding: 16rpx 0;
}

.order-select-name {
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  color: var(--text-primary);
  display: block;
}

.order-select-detail {
  font-size: var(--font-sm);
  color: var(--text-muted);
  margin-top: 4rpx;
  display: block;
}

.order-select-send {
  font-size: var(--font-sm);
  color: var(--nb-text-link);
  font-weight: var(--weight-semibold);
  flex-shrink: 0;
  padding: 0 24rpx;
}

.empty-orders {
  text-align: center;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-orders-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--nb-page);
  margin-bottom: 8rpx;
}

.empty-orders-text {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

.go-booking-btn {
  display: inline-block;
  background: var(--brand-gradient);
  color: var(--text-inverse);
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  padding: 16rpx 48rpx;
  border-radius: var(--radius-xl);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25) /* brand-primary-alpha */;
}
/* ===== Conversation surface refinement ===== */
.empty-chat { padding: 72rpx 32rpx; }
.empty-chat-card { width: 100%; padding: 48rpx 36rpx; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; border-radius: 28rpx; background: var(--nb-surface); }

@import '../../../styles/booking-actions.wxss';
.go-booking-btn.booking-action { min-height: 44px; height: var(--control-hit-height); padding: 0 24rpx; border-radius: 8px; font-size: var(--font-sm); box-shadow: none; }
.empty-avatar { width: 96rpx; height: 96rpx; margin-bottom: 24rpx; overflow: hidden; border-radius: 50%; background: var(--nb-soft-surface); }
.empty-avatar-image { width: 100%; height: 100%; display: block; }
.empty-title { margin-bottom: 8rpx; font-size: var(--font-md); }
.empty-desc { max-width: 500rpx; font-size: var(--font-xs); }
.empty-actions { width: 100%; margin-top: 32rpx; display: flex; justify-content: center; gap: 16rpx; }
.empty-action { flex: 1; min-width: 0; min-height: 88rpx; padding: 0 24rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; gap: 10rpx; border-radius: var(--radius-md); background: var(--nb-soft-surface); color: var(--nb-secondary); font-size: var(--font-sm); font-weight: var(--weight-medium); }
.empty-action-icon { width: 28rpx; height: 28rpx; }
.empty-action-primary { background: var(--nb-active-surface); color: var(--nb-ink); }
.input-bar { padding-top: 12rpx; background: var(--nb-surface); box-shadow: 0 -6rpx 20rpx rgba(0, 0, 0, .04); }
.input-field-wrap { height: 88rpx; border-radius: 22rpx; }
.input-field { height: 88rpx; font-size: var(--font-sm); }
.input-placeholder { font-size: var(--font-sm); }
.toolbar-icon { width: 32rpx; height: 32rpx; display: block; }
.send-btn { width: auto; height: 88rpx; min-width: 96rpx; padding: 0 24rpx; border-radius: 22rpx; }
.send-btn-text { font-size: var(--font-sm); font-weight: var(--weight-semibold); color: var(--nb-muted); }
.send-btn-active .send-btn-text { color: var(--nb-inverse); }
.attachment-btn, .booking-btn, .field-add-btn { width: 88rpx; height: 88rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; background: var(--nb-soft-surface); }
.msg-list { padding: 12rpx 0 24rpx; }
.msg-row { padding: 10rpx 28rpx; gap: 14rpx; }
.avatar-img, .avatar-placeholder, .avatar-self { width: 64rpx; height: 64rpx; }
.msg-content-wrap { max-width: 72%; }
.bubble { padding: 16rpx 22rpx 14rpx; border-radius: 20rpx; }
.bubble-left { background: var(--nb-surface); box-shadow: none; }
.bubble-right { background: var(--nb-action); box-shadow: none; }
.msg-text { font-size: var(--font-sm); }
.send-btn-active { background: var(--nb-action); box-shadow: none; }
