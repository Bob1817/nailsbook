.booking-page { height:100vh; display:flex; flex-direction:column; overflow:hidden; background:var(--nb-page); color:var(--nb-ink); box-sizing:border-box; }
.page-scroll { flex:1; min-height:0; }.content { padding:44rpx 32rpx 40rpx; }.hero-copy { padding:0 8rpx; }
.eyebrow,.title,.lead,.artist-kicker,.name,.artist-meta,.bio,.value-title,.value-copy,.section-title,.section-sub,.step-title,.step-description,.invite-label,.invite-help,.availability-title,.availability-copy,.owner-setting-title,.owner-setting-help,.owner-setting-warning,.consent,.state-title,.state-copy { display:block; }
.eyebrow { margin-bottom:16rpx; color:var(--nb-muted); font-size:20rpx; font-weight:600; letter-spacing:3rpx; }.title { max-width:620rpx; font-size:48rpx; font-weight:700; line-height:1.22; letter-spacing:-1rpx; }.lead { max-width:620rpx; margin-top:18rpx; color:var(--nb-secondary); font-size:26rpx; line-height:1.6; }
.card { background:var(--nb-surface); border-radius:28rpx; box-sizing:border-box; }.artist-card { margin-top:36rpx; padding:32rpx; }.artist-header { display:flex; align-items:center; gap:20rpx; }.avatar { width:96rpx; height:96rpx; border-radius:50%; flex-shrink:0; background:var(--nb-soft-surface); }.avatar-default { padding:18rpx; box-sizing:border-box; }.artist-info { flex:1; min-width:0; }.artist-kicker { margin-bottom:4rpx; color:var(--nb-muted); font-size:20rpx; line-height:1.4; }.name { overflow:hidden; color:var(--nb-ink); font-size:34rpx; font-weight:650; line-height:1.35; text-overflow:ellipsis; white-space:nowrap; }.artist-meta { margin-top:4rpx; color:var(--nb-secondary); font-size:22rpx; }
.status-pill { min-height:48rpx; padding:0 14rpx; display:flex; align-items:center; gap:8rpx; flex-shrink:0; border-radius:24rpx; background:var(--nb-soft-surface); color:var(--nb-secondary); font-size:21rpx; }.status-dot { width:10rpx; height:10rpx; border-radius:50%; background:var(--nb-muted); }.status-pill.is-open { color:var(--nb-success); }.status-pill.is-open .status-dot { background:var(--nb-success); }.bio { margin-top:24rpx; color:var(--nb-secondary); font-size:25rpx; line-height:1.6; }.tags { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:20rpx; }.tag { padding:8rpx 16rpx; border-radius:18rpx; background:var(--nb-soft-surface); color:var(--nb-secondary); font-size:21rpx; }
.value-strip { margin-top:28rpx; padding:22rpx 0; display:flex; align-items:center; border-top:1rpx solid var(--nb-border); }.value-item { flex:1; min-width:0; }.value-item + .value-item { padding-left:24rpx; }.value-title { font-size:24rpx; font-weight:600; line-height:1.4; }.value-copy { margin-top:6rpx; color:var(--nb-muted); font-size:21rpx; }.value-divider { width:1rpx; height:54rpx; background:var(--nb-border); }
.section-block { margin-top:40rpx; }.section-heading { padding:0 8rpx 20rpx; display:flex; align-items:flex-start; justify-content:space-between; }.section-title { font-size:32rpx; font-weight:650; line-height:1.4; }.section-sub { margin-top:6rpx; color:var(--nb-muted); font-size:22rpx; line-height:1.5; }.section-index { color:var(--nb-border); font-size:44rpx; font-weight:700; line-height:1; }.steps-card { padding:30rpx 32rpx; border-radius:28rpx; background:var(--nb-surface); }.step { min-height:88rpx; display:flex; align-items:center; gap:22rpx; }.step-marker { width:48rpx; height:48rpx; display:flex; align-items:center; justify-content:center; flex-shrink:0; border-radius:50%; background:var(--nb-action); color:var(--nb-inverse); font-size:22rpx; font-weight:650; }.step-copy { flex:1; min-width:0; }.step-title { font-size:27rpx; font-weight:600; line-height:1.4; }.step-description { margin-top:5rpx; color:var(--nb-muted); font-size:22rpx; line-height:1.45; }.step-line { width:1rpx; height:22rpx; margin:0 0 0 24rpx; background:var(--nb-border); }
.invite-card { min-height:112rpx; margin-top:24rpx; padding:24rpx 28rpx; display:flex; align-items:center; justify-content:space-between; gap:24rpx; border-radius:24rpx; background:var(--nb-surface); }.invite-label { font-size:24rpx; font-weight:600; }.invite-help { margin-top:5rpx; color:var(--nb-muted); font-size:20rpx; }.invite-code { flex-shrink:0; font-size:28rpx; font-weight:700; letter-spacing:2rpx; }
.owner-setting { min-height:112rpx; margin-top:24rpx; padding:24rpx 28rpx; display:flex; align-items:center; gap:24rpx; border-radius:24rpx; background:var(--nb-surface); box-sizing:border-box; }.owner-setting-copy { flex:1; min-width:0; }.owner-setting-title { font-size:24rpx; font-weight:600; line-height:1.4; }.owner-setting-help,.owner-setting-warning { margin-top:6rpx; color:var(--nb-muted); font-size:20rpx; line-height:1.5; }.owner-setting-warning { color:var(--nb-secondary); }
.availability { margin-top:24rpx; padding:24rpx 26rpx; display:flex; align-items:flex-start; gap:18rpx; border-radius:22rpx; background:var(--nb-soft-surface); }.notice-icon { width:36rpx; height:36rpx; display:flex; align-items:center; justify-content:center; flex-shrink:0; border-radius:50%; background:var(--nb-secondary); color:var(--nb-inverse); font-size:22rpx; font-weight:700; }.availability-title { font-size:24rpx; font-weight:600; }.availability-copy { margin-top:5rpx; color:var(--nb-muted); font-size:21rpx; line-height:1.5; }
.action-bar { z-index:10; padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background:var(--nb-surface); box-sizing:border-box; }.share-actions,.guest-actions { display:flex; align-items:center; gap:16rpx; }.booking-page .booking-button { min-height:88rpx; margin:0; padding:0 24rpx; display:flex; align-items:center; justify-content:center; box-sizing:border-box; border:0; border-radius:16rpx; font-size:26rpx; font-weight:650; line-height:1.4; }.booking-button::after { border:0; }.share-actions .booking-button,.guest-actions .booking-button { width:0; flex:1; }.full-button { width:100%; }.booking-page .primary { background:var(--nb-action); color:var(--nb-inverse); }.booking-page .secondary { background:var(--nb-soft-surface); color:var(--nb-secondary); }.booking-page .is-disabled { background:var(--nb-pressed); color:var(--nb-muted); }.booking-page .primary-pressed { background:var(--nb-action-pressed); }.booking-page .pressed { background:var(--nb-pressed); }.consent { margin:14rpx 12rpx 0; color:var(--nb-muted); font-size:19rpx; line-height:1.45; text-align:center; }
.state { margin:32rpx; padding:56rpx 32rpx; text-align:center; color:var(--nb-secondary); font-size:26rpx; line-height:1.6; }.state-title { color:var(--nb-ink); font-size:30rpx; font-weight:650; }.state-copy { margin-top:10rpx; color:var(--nb-muted); font-size:24rpx; }.booking-page .retry { width:100%; margin-top:28rpx; }
@import '../../../styles/booking-actions.wxss';
 .booking-page .booking-button.booking-action { min-height:44px; height:44px; padding:0 24rpx; border-radius:8px; font-size:var(--font-sm); line-height:1.4; box-shadow:none; }
.status-pill.is-open { color:var(--nb-success); background:var(--nb-success-surface); }
