.booking-page { height:100vh; display:flex; flex-direction:column; overflow:hidden; background:var(--nb-page); color:var(--nb-ink); box-sizing:border-box; }
.page-scroll { flex:1; min-height:0; }.content { padding:var(--space-lg) var(--space-lg) var(--space-xl); }
.artist-kicker,.name,.artist-meta,.bio,.invite-label,.invite-help,.availability-title,.availability-copy,.owner-setting-title,.owner-setting-help,.owner-setting-warning,.consent,.state-title,.state-copy,.time-title,.time-sub { display:block; }
.time-card { margin-top:var(--space-md); padding:28rpx var(--space-md) var(--space-xs); }.time-head { padding:0 var(--space-xs) var(--space-xs); }.time-title { font-size:var(--font-md); font-weight:var(--weight-semibold); line-height:1.4; }.time-sub { margin-top:6rpx; color:var(--nb-muted); font-size:var(--font-xs); line-height:1.5; }
.card { background:var(--nb-surface); border-radius:var(--radius-lg); box-sizing:border-box; }.artist-card { margin-top:36rpx; padding:var(--space-lg); }.artist-header { display:flex; align-items:center; gap:20rpx; }.avatar { width:96rpx; height:96rpx; border-radius:50%; flex-shrink:0; background:var(--nb-soft-surface); }.avatar-default { padding:18rpx; box-sizing:border-box; }.artist-info { flex:1; min-width:0; }.artist-kicker { margin-bottom:4rpx; color:var(--nb-muted); font-size:var(--font-xs); line-height:1.4; }.name { overflow:hidden; color:var(--nb-ink); font-size:var(--font-lg); font-weight:var(--weight-semibold); line-height:1.35; text-overflow:ellipsis; white-space:nowrap; }.artist-meta { margin-top:4rpx; color:var(--nb-secondary); font-size:var(--font-xs); }
.status-pill { min-height:48rpx; padding:0 14rpx; display:flex; align-items:center; gap:var(--space-xs); flex-shrink:0; border-radius:var(--radius-full); background:var(--nb-soft-surface); color:var(--nb-secondary); font-size:var(--font-xs); }.status-dot { width:10rpx; height:10rpx; border-radius:50%; background:var(--nb-muted); }.status-pill.is-open { color:var(--nb-success); }.status-pill.is-open .status-dot { background:var(--nb-success); }.bio { margin-top:var(--space-md); color:var(--nb-secondary); font-size:var(--font-sm); line-height:1.6; }.tags { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:20rpx; }.tag { padding:var(--space-xs) var(--space-sm); border-radius:var(--radius-md); background:var(--nb-soft-surface); color:var(--nb-secondary); font-size:var(--font-xs); }
.invite-card { min-height:112rpx; margin-top:var(--space-md); padding:var(--space-md) 28rpx; display:flex; align-items:center; justify-content:space-between; gap:var(--space-md); border-radius:var(--radius-lg); background:var(--nb-surface); }.invite-label { font-size:var(--font-sm); font-weight:var(--weight-semibold); }.invite-help { margin-top:5rpx; color:var(--nb-muted); font-size:var(--font-xs); }.invite-code { flex-shrink:0; font-size:var(--font-md); font-weight:var(--weight-bold); letter-spacing:2rpx; }
.owner-setting { min-height:112rpx; margin-top:var(--space-md); padding:var(--space-md) 28rpx; display:flex; align-items:center; gap:var(--space-md); border-radius:var(--radius-lg); background:var(--nb-surface); box-sizing:border-box; }.owner-setting-copy { flex:1; min-width:0; }.owner-setting-title { font-size:var(--font-sm); font-weight:var(--weight-semibold); line-height:1.4; }.owner-setting-help,.owner-setting-warning { margin-top:6rpx; color:var(--nb-muted); font-size:var(--font-xs); line-height:1.5; }.owner-setting-warning { color:var(--nb-secondary); }
.availability { margin-top:var(--space-md); padding:var(--space-md) 26rpx; display:flex; align-items:flex-start; gap:18rpx; border-radius:var(--radius-md); background:var(--nb-soft-surface); }.notice-icon { width:36rpx; height:36rpx; display:flex; align-items:center; justify-content:center; flex-shrink:0; border-radius:50%; background:var(--nb-secondary); color:var(--nb-inverse); font-size:var(--font-xs); font-weight:var(--weight-bold); }.availability-title { font-size:var(--font-sm); font-weight:var(--weight-semibold); }.availability-copy { margin-top:5rpx; color:var(--nb-muted); font-size:var(--font-xs); line-height:1.5; }
.action-bar { z-index:10; padding:20rpx var(--space-lg) calc(20rpx + env(safe-area-inset-bottom)); background:var(--nb-surface); box-sizing:border-box; }.share-actions,.guest-actions { display:flex; align-items:center; gap:var(--space-sm); }.booking-page .booking-button { min-height:88rpx; margin:0; padding:0 var(--space-md); display:flex; align-items:center; justify-content:center; box-sizing:border-box; border:0; border-radius:var(--radius-sm); font-size:var(--font-sm); font-weight:var(--weight-semibold); line-height:1.4; }.booking-button::after { border:0; }.share-actions .booking-button,.guest-actions .booking-button { width:0; flex:1; }.full-button { width:100%; }.booking-page .primary { background:var(--nb-action); color:var(--nb-inverse); }.booking-page .secondary { background:var(--nb-soft-surface); color:var(--nb-secondary); }.booking-page .is-disabled { background:var(--nb-pressed); color:var(--nb-muted); }.booking-page .primary-pressed { background:var(--nb-action-pressed); }.booking-page .pressed { background:var(--nb-pressed); }.consent { margin:14rpx 12rpx 0; color:var(--nb-muted); font-size:var(--font-xs); line-height:1.45; text-align:center; }
.state { margin:var(--space-lg); padding:56rpx var(--space-lg); text-align:center; color:var(--nb-secondary); font-size:var(--font-sm); line-height:1.6; }.state-title { color:var(--nb-ink); font-size:var(--font-md); font-weight:var(--weight-semibold); }.state-copy { margin-top:10rpx; color:var(--nb-muted); font-size:var(--font-sm); }.booking-page .retry { width:100%; margin-top:28rpx; }
@import '../../../styles/booking-actions.wxss';
 .booking-page .booking-button.booking-action { min-height:44px; height:44px; padding:0 var(--space-md); border-radius:8px; font-size:var(--font-sm); line-height:1.4; box-shadow:none; }
.status-pill.is-open { color:var(--nb-success); background:var(--nb-success-surface); }
