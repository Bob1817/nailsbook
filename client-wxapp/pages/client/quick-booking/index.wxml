<view class="booking-page">
  <nav-bar title="一键预约" showBack/>
  <view wx:if="{{loading}}" class="state">正在加载预约主页…</view>
  <view wx:elif="{{error}}" class="card state">
    <text class="state-title">预约主页暂时无法打开</text><text class="state-copy">{{error}}</text>
    <button class="booking-button secondary retry booking-action" bindtap="loadArtist" hover-class="pressed">重新加载</button>
    <button class="booking-button secondary retry booking-action" bindtap="goHome" hover-class="pressed">进入小程序首页</button>
  </view>
  <block wx:else>
    <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="content">
        <view class="card artist-card">
          <view class="artist-header">
            <image wx:if="{{artist.avatarUrl}}" class="avatar" src="{{artist.avatarUrl}}" mode="aspectFill" aria-label="{{artist.name}}的头像"/>
            <image wx:else class="avatar avatar-default" src="/static/icons/technician.svg" mode="aspectFit" aria-label="美甲师默认头像"/>
            <view class="artist-info"><text class="artist-kicker">你的专属美甲师</text><text class="name">{{artist.name}}</text><text class="artist-meta">{{artist.city || '服务城市待确认'}}</text></view>
            <view class="status-pill {{enabled ? 'is-open' : ''}}"><view class="status-dot"></view><text>{{enabled ? '可预约' : '未开放'}}</text></view>
          </view>
          <text wx:if="{{artist.bio}}" class="bio">{{artist.bio}}</text>
          <view wx:if="{{artist.styleTags.length}}" class="tags"><text wx:for="{{artist.styleTags}}" wx:key="*this" class="tag">{{item}}</text></view>
        </view>

        <view wx:if="{{!owner && enabled && shopName}}" class="card time-card">
          <view class="time-head">
            <text class="time-title">选择时间</text>
            <text class="time-sub">{{startTime ? '已选 ' + serviceDate + ' ' + startTime : shopName + ' · 没想好款式也可以先占时间'}}</text>
          </view>
          <booking-time-picker
            id="timePicker"
            horizontal
            tech-id="{{artist.id}}"
            service-date="{{serviceDate}}"
            start-time="{{startTime}}"
            service-type="shop"
            shop-name="{{shopName}}"
            duration-minutes="120"
            duration-pending
            bindchange="onTimeChange"
          />
        </view>

        <view wx:if="{{owner}}" class="owner-setting">
          <view class="owner-setting-copy">
            <text class="owner-setting-title">开放客户自助选时间</text>
            <text class="owner-setting-help">开启后，客户可从分享页选择时间并提交预约申请</text>
            <text wx:if="{{quickBookingEnabled && !acceptingBookings}}" class="owner-setting-warning">当前已暂停接单，请先在“我的”页开启接受新预约</text>
          </view>
          <nb-switch checked="{{quickBookingEnabled}}" disabled="{{savingAvailability}}" label="开放一键预约" bind:change="onAvailabilityChange"/>
        </view>
        <view wx:if="{{owner}}" class="invite-card"><view><text class="invite-label">分享识别码</text><text class="invite-help">分享时自动携带，客户无需填写</text></view><text class="invite-code">{{artist.invitationCode}}</text></view>
        <view wx:if="{{!enabled}}" class="availability" role="status"><view class="notice-icon">!</view><view><text class="availability-title">暂未开放预约</text><text class="availability-copy">{{owner ? (quickBookingEnabled ? '一键预约已开启，但当前处于暂停接单状态。' : '打开上方开关后，客户即可选择时间并提交预约申请。') : '这位美甲师暂未开放预约，请稍后再试。'}}</text></view></view>
      </view>
    </scroll-view>
    <view class="action-bar">
      <view wx:if="{{owner}}" class="share-actions"><button class="booking-button booking-action primary" open-type="share" hover-class="primary-pressed">发给微信好友</button><button class="booking-button booking-action secondary" bindtap="shareTimeline" hover-class="pressed">分享到朋友圈</button></view>
      <block wx:else>
        <view class="guest-actions">
          <button class="booking-button booking-action primary {{!enabled || submitting ? 'is-disabled' : ''}}" bindtap="bookNow" disabled="{{!enabled || submitting}}" loading="{{submitting}}" hover-class="primary-pressed">{{enabled ? (startTime ? '确认时间，继续' : '继续填写需求') : '暂未开放预约'}}</button>
          <button class="booking-button booking-action secondary" bindtap="viewArtistHome" hover-class="pressed">查看美甲师主页</button>
        </view>
        <text class="consent">继续后可完善款式与需求，价格与时长由美甲师确认。</text>
      </block>
    </view>
  </block>
</view>
