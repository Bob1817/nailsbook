<view class="container">
  <!-- 顶部导航 -->
  <nav-bar title="首页"></nav-bar>

  <!-- 轮播 - 最新作品 -->
  <view class="hero-section">
    <swiper wx:if="{{recentWorks.length > 0}}" class="hero-swiper" autoplay interval="4000" circular current="{{swiperIndex}}" bindchange="onSwiperChange">
      <swiper-item wx:for="{{recentWorks}}" wx:key="id" bindtap="viewWork" data-id="{{item.id}}">
        <view class="hero-item">
          <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" class="hero-img" aria-label="{{item.title || '精选美甲作品'}}" />
          <view wx:else class="hero-img-empty"></view>
          <view class="hero-overlay">
            <view class="hero-bottom-area">
              <view class="hero-bottom-row">
                <view class="hero-info">
                  <text class="hero-info-title">{{item.title}}</text>
                  <view class="hero-info-meta">
                    <text>{{item.technicianName}}</text>
                  </view>
                </view>
                <view class="hero-cta-btn" catchtap="viewWork" data-id="{{item.id}}">
                  <text>查看详情</text>
                  <text class="hero-cta-arrow">›</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <view wx:else class="hero-placeholder">
      <view class="icon-placeholder-circle">
        <view class="icon-placeholder-inner"></view>
      </view>
      <text class="hero-placeholder-text">绑定美甲师后查看最新作品</text>
    </view>

    <view wx:if="{{recentWorks.length > 1}}" class="hero-dots">
      <view
        wx:for="{{recentWorks}}"
        wx:key="id"
        class="hero-dot {{swiperIndex === index ? 'hero-dot-active' : ''}}"
        data-index="{{index}}"
        bindtap="onDotTap"
      ></view>
    </view>
  </view>

  <!-- 我的预约：首屏核心信息，紧跟作品 Hero -->
  <view class="section booking-section booking-section-primary">
    <view class="section-header">
      <text class="section-title">我的预约</text>
      <view wx:if="{{upcomingOrder}}" class="section-more" bindtap="navigateToOrders">查看全部 ›</view>
    </view>
    <text class="section-sub">{{upcomingOrder ? '距离最近的一次预约' : '快速发起你的下一次美甲'}}</text>

    <view wx:if="{{upcomingOrder}}" class="order-card" bindtap="viewUpcomingOrder">
      <view class="order-card-content">
        <view class="order-card-top">
          <view class="order-status-badge">{{upcomingOrder.statusText}}</view>
          <view class="order-countdown"><text class="countdown-dot"></text><text class="countdown-value">{{upcomingOrder.countdown}}</text></view>
        </view>
        <view class="order-card-body">
          <view class="order-date-box"><text class="order-date-month">{{orderMonth}}</text><text class="order-date-day">{{orderDay}}</text><text class="order-date-weekday">{{orderWeekday}}</text></view>
          <view class="order-details">
            <text class="order-service-name">{{upcomingOrder.serviceType}}</text>
            <view class="order-detail-row"><view class="icon icon-clock"></view><text class="order-detail-text">{{upcomingOrder.timeStr}}</text></view>
            <view wx:if="{{upcomingOrder.technician}}" class="order-detail-row"><view class="icon icon-person"></view><text class="order-detail-text order-detail-truncate">{{upcomingOrder.technician.name}}</text></view>
            <view wx:if="{{orderAddress}}" class="order-detail-row"><view class="icon icon-pin"></view><text class="order-detail-text order-detail-address">{{orderAddress}}</text></view>
          </view>
        </view>
        <view class="order-card-actions" catchtap="">
          <view class="order-action-btn" bindtap="navigateToChat"><view class="icon icon-chat-white"></view><text>发消息</text></view>
          <view wx:if="{{upcomingOrder.technician.phone}}" class="order-action-btn" bindtap="callTech"><view class="icon icon-phone-white"></view><text>打电话</text></view>
          <view class="order-action-btn order-action-primary" bindtap="viewUpcomingOrder">查看详情</view>
        </view>
      </view>
    </view>

    <view wx:else class="no-order-card" bindtap="navigateToBooking">
      <view class="no-order-content">
        <view class="no-order-icon-wrap"><view class="no-order-plus"></view></view>
        <view class="no-order-copy"><text class="no-order-title">还没有预约美甲</text><text class="no-order-sub">预约你的下一次美甲</text></view>
        <view class="book-btn"><text>立即预约</text></view>
      </view>
    </view>
  </view>

  <view class="section asset-section">
    <view class="section-header">
      <text class="section-title">我的美甲记录</text>
      <view class="section-more" bindtap="navigateToArchive">查看全部 ›</view>
    </view>
    <text class="section-sub">按时间记录每一次完成的美甲和照片</text>
    <view class="asset-grid">
      <view class="asset-card archive-card" bindtap="navigateToArchive" role="button" aria-label="查看我的美甲记录">
        <text class="asset-eyebrow">NAIL MOMENTS</text>
        <text class="asset-title">我的美甲记录</text>
        <text class="asset-desc">上传照片，也会同步美甲师关联的作品</text>
        <text class="asset-link">查看时间记录 →</text>
      </view>
      <view class="asset-card ai-card" bindtap="navigateToAiPhoto" role="button" aria-label="生成朋友圈分享图">
        <text class="asset-eyebrow">SHARE PHOTO</text>
        <text class="asset-title">生成朋友圈分享图</text>
        <text class="asset-desc">从记录中选图，生成适合分享的画面</text>
        <text class="asset-link">选择照片 →</text>
      </view>
    </view>
  </view>

  <view class="section style-section">
    <view class="section-header">
      <text class="section-title">热门风格</text>
      <view class="section-more" bindtap="navigateToWorks">查看全部 ›</view>
    </view>
    <text class="section-sub">按你的场景，快速找到下一款灵感</text>
    <scroll-view class="style-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="style-row">
        <view wx:for="{{popularStyles}}" wx:key="*this" class="style-chip" bindtap="viewStyle" data-style="{{item}}">{{item}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 精选作品 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">精选作品</text>
      <view class="section-more" bindtap="navigateToWorks">查看全部 ›</view>
    </view>
    <text class="section-sub">设计能力、审美理念与适合你的场景</text>

    <view wx:if="{{featuredWorks.length > 0}}" class="home-works-grid">
      <view
        wx:for="{{featuredWorks}}"
        wx:key="id"
        class="home-work-card"
        bindtap="viewWork"
        data-id="{{item.id}}"
      >
        <view class="home-work-img-wrap {{index % 3 === 0 ? 'home-work-tall' : 'home-work-short'}}">
          <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" class="home-work-img" lazy-load aria-label="{{item.title || '美甲作品'}}" />
          <view wx:else class="home-work-img-empty"></view>
          <view class="home-work-gradient"></view>
          <!-- 顶部：美甲师头像 + 点赞 -->
          <view class="home-work-top">
            <view class="home-work-tech-pill">
              <image wx:if="{{item.technicianAvatarUrl}}" src="{{item.technicianAvatarUrl}}" mode="aspectFill" class="home-work-tech-av" binderror="onWorkAvatarError" data-id="{{item.id}}" lazy-load aria-label="{{item.technicianName || '美甲师'}}的头像" />
              <view wx:else class="home-work-tech-av-fb">
                <text class="home-work-tech-av-char">{{item.techInitial}}</text>
              </view>
              <view class="home-work-tech-info">
                <text class="home-work-tech-name">{{item.technicianName}}</text>

              </view>
            </view>
            <view class="home-work-like-pill">
              <image wx:if="{{item.isLiked}}" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABQAAAASCAYAAABb0P4QAAAAUElEQVR4nGNgQAP/3cP/o2NS5PEqJBVT1TAUQ6lqIDUNG6kG0iSWqZ4OqWEo1txCjsF4DaKZgcQaSrRhxBhKsmH4DCXbMGyGUmwYsqHEqAMAvy56MytYoCsAAAAASUVORK5CYII=" class="heart-icon" />
              <image wx:else src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABQAAAASCAYAAABb0P4QAAAAS0lEQVR4nOXTMQ4AIAgDQP7/aV3RkKbFMtmV5hYg4soqosxhUY0VO1Ar6MR+BUe2bL9DB1p+SweG0BjIojTGoDKG0DZWoc9YRpneBsE8yGLtxtorAAAAAElFTkSuQmCC" class="heart-icon" />
              <text class="home-work-like-num">{{item.likeCount}}</text>
            </view>
          </view>
          <!-- 底部：详情 -->
          <view class="home-work-bottom">
            <text class="home-work-title">{{item.title}}</text>
            <view wx:if="{{item.tags.length > 0}}" class="home-work-tags">
              <block wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">
                <text wx:if="{{index < 2}}" class="home-work-tag">#{{tag}}</text>
              </block>
            </view>
            <view class="home-work-foot-row">
              <text class="home-work-date">{{item.createdAt}}</text>
              <view class="home-work-cta">
                <view class="icon icon-check-circle"></view>
                <text class="home-work-cta-text">查看详情</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{worksLoading}}" class="works-loading">
      <view class="loading-spinner"></view>
    </view>
    <view wx:if="{{!worksHasMore && featuredWorks.length > 0}}" class="works-end">
      <text class="works-end-text">没有更多了</text>
    </view>

    <view wx:if="{{featuredWorks.length === 0 && !worksLoading}}" class="works-empty">
      <view class="works-empty-icon-wrap">
        <view class="icon icon-image-placeholder-lg"></view>
      </view>
      <text class="works-empty-text">暂无作品展示</text>
    </view>
  </view>
</view>

<tab-bar selected="home" />
