<view class="container">
  <!-- 顶部导航 -->
  <nav-bar title="首页"></nav-bar>

  <!-- 轮播 - 最新作品 -->
  <view class="hero-section">
    <swiper wx:if="{{recentWorks.length > 0}}" class="hero-swiper" autoplay="{{recentWorks.length > 1}}" interval="4000" circular="{{recentWorks.length > 1}}" current="{{swiperIndex}}" bindchange="onSwiperChange">
      <swiper-item wx:for="{{recentWorks}}" wx:key="id" bindtap="viewWork" data-id="{{item.id}}">
        <view class="hero-item">
          <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" class="hero-img" aria-label="{{item.title || '精选美甲作品'}}" />
          <view wx:else class="hero-img-empty"></view>
          <view class="hero-overlay">
            <view class="hero-bottom-area">
              <view class="hero-bottom-row">
                <view class="hero-info">
                  <text class="hero-info-title">{{item.title}}</text>
                  <view class="hero-info-meta">
                    <text>{{item.technicianName}}</text>
                  </view>
                </view>
                <view class="hero-cta-btn booking-action" catchtap="viewWork" data-id="{{item.id}}">
                  <text class="hero-cta-label">查看详情</text>
                  <text class="hero-cta-arrow">›</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <view wx:else class="hero-placeholder">
      <view class="icon-placeholder-circle">
        <view class="icon-placeholder-inner"></view>
      </view>
      <text class="hero-placeholder-text">{{heroLoadFailed ? '推荐作品加载失败' : (technicianCount > 0 ? '美甲师暂未设置首页推荐' : (clientLoggedIn ? '绑定美甲师后查看首页推荐' : '暂无公开推荐作品'))}}</text>
      <view class="booking-action hero-empty-action" bindtap="{{heroLoadFailed ? 'loadData' : 'navigateToWorks'}}" role="button">{{heroLoadFailed ? '重新加载' : '浏览作品'}}</view>
    </view>

    <view wx:if="{{recentWorks.length > 1}}" class="hero-dots">
      <view
        wx:for="{{recentWorks}}"
        wx:key="id"
        class="hero-dot {{swiperIndex === index ? 'hero-dot-active' : ''}}"
        data-index="{{index}}"
        bindtap="onDotTap"
      ></view>
    </view>
  </view>

  <!-- 我的预约：首屏核心信息，紧跟作品 Hero -->
  <view class="section booking-section booking-section-primary">
    <view class="section-header">
      <text class="section-title">我的预约</text>
      <view wx:if="{{upcomingOrder}}" class="section-more semantic-link" bindtap="navigateToOrders">查看全部 ›</view>
    </view>
    <text class="section-sub">{{upcomingOrder ? '距离最近的一次预约' : '快速发起你的下一次美甲'}}</text>

    <view wx:if="{{upcomingOrder}}" class="order-card">
      <view class="order-card-content">
        <view class="order-card-top">
          <view class="order-status-badge">{{upcomingOrder.statusText}}</view>
          <view class="order-countdown"><text class="countdown-dot"></text><text class="countdown-value">{{upcomingOrder.countdown}}</text></view>
        </view>
        <view class="order-card-body">
          <view class="order-date-box"><text class="order-date-month">{{orderMonth}}</text><text class="order-date-day">{{orderDay}}</text><text class="order-date-weekday">{{orderWeekday}}</text></view>
          <view class="order-details">
            <text class="order-time-range">{{upcomingOrder.timeStr}}</text>
            <text wx:if="{{orderShopName}}" class="order-shop-name">{{orderShopName}}</text>
            <view wx:if="{{upcomingOrder.technician}}" class="order-detail-row"><image class="icon icon-person" src="/static/icons/client.svg" mode="aspectFit" /><text class="order-detail-text order-detail-truncate">{{upcomingOrder.technician.name}}</text></view>
            <view wx:if="{{orderAddress}}" class="order-detail-row order-address-row">
              <image class="icon icon-pin" src="/static/icons/pin.svg" mode="aspectFit" />
              <text class="order-detail-text order-detail-address">{{orderAddress}}</text>
              <view class="address-nav-action" catchtap="navigateToShop" role="button" aria-label="导航到店"><image class="address-nav-icon" src="/static/icons/navigation.svg" mode="aspectFit" /><text>导航</text></view>
            </view>
            <view wx:if="{{orderShopGuidance}}" class="order-guidance-link" catchtap="openUpcomingGuidance" role="button" aria-label="查看到店指引"><text>查看到店指引</text><text>›</text></view>
          </view>
        </view>
        <view class="order-card-actions" catchtap="">
          <view class="order-action-btn booking-action" bindtap="navigateToChat"><image class="order-action-icon" src="/static/icons/tab-chat.svg" mode="aspectFit" /><text>发消息</text></view>
          <view wx:if="{{upcomingOrder.technician.phone}}" class="order-action-btn booking-action" bindtap="callTech"><image class="order-action-icon order-action-icon-phone" src="/static/icons/phone-white.svg" mode="aspectFit" /><text>打电话</text></view>
          <view class="order-action-btn order-action-primary booking-action" bindtap="viewUpcomingOrder" role="button" aria-label="查看预约详情">查看详情</view>
        </view>
      </view>
    </view>

    <view wx:else class="no-order-card" bindtap="navigateToBooking">
      <view class="no-order-content">
        <view class="no-order-copy"><text class="no-order-title">当前暂无预约</text><text class="no-order-sub">挑选喜欢的款式，快速预约美甲师</text></view>
        <view class="book-btn booking-action"><text>去预约</text><text class="book-btn-arrow">›</text></view>
      </view>
    </view>
  </view>

  <view class="section style-section">
    <view class="section-header">
      <text class="section-title">热门风格</text>
      <view class="section-more semantic-link" bindtap="navigateToWorks">查看全部 ›</view>
    </view>
    <text class="section-sub">按你的场景，快速找到下一款灵感</text>
    <scroll-view class="style-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="style-row">
        <view wx:for="{{popularStyles}}" wx:key="*this" class="style-chip" bindtap="viewStyle" data-style="{{item}}">{{item}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 精选作品 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">精选作品</text>
      <view class="section-more semantic-link" bindtap="navigateToWorks">查看全部 ›</view>
    </view>
    <text class="section-sub">设计能力、审美理念与适合你的场景</text>

    <view wx:if="{{featuredWorks.length}}" class="home-works-grid">
      <view class="home-works-col">
        <view wx:for="{{featuredLeftCol}}" wx:key="id" class="work-card">
          <work-card work="{{item}}" bind:cardtap="onWorkCardTap" bind:artisttap="onArtistTap" bind:liketap="onLikeTap" bind:favoritetap="onFavoriteTap" bind:commenttap="onWorkCardTap" />
        </view>
      </view>
      <view class="home-works-col">
        <view wx:for="{{featuredRightCol}}" wx:key="id" class="work-card">
          <work-card work="{{item}}" bind:cardtap="onWorkCardTap" bind:artisttap="onArtistTap" bind:liketap="onLikeTap" bind:favoritetap="onFavoriteTap" bind:commenttap="onWorkCardTap" />
        </view>
      </view>
    </view>

    <view wx:if="{{worksLoading}}" class="works-loading">
      <view class="loading-spinner"></view>
    </view>
    <view wx:if="{{!worksHasMore && featuredWorks.length > 0}}" class="works-end">
      <text class="works-end-text">没有更多了</text>
    </view>

    <view wx:if="{{featuredWorks.length === 0 && !worksLoading}}" class="works-empty">
      <view class="works-empty-icon-wrap">
        <view class="icon icon-image-placeholder-lg"></view>
      </view>
      <text class="works-empty-text">暂无作品展示</text>
    </view>
  </view>
</view>

<tab-bar selected="home" />
