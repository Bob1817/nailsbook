<view class="container">
  <!-- 顶部导航 -->
  <nav-bar title="首页"></nav-bar>

  <!-- 轮播 - 最新作品 -->
  <view class="hero-section">
    <swiper wx:if="{{recentWorks.length > 0}}" class="hero-swiper" autoplay="{{recentWorks.length > 1}}" interval="4000" circular="{{recentWorks.length > 1}}" current="{{swiperIndex}}" bindchange="onSwiperChange">
      <swiper-item wx:for="{{recentWorks}}" wx:key="id" bindtap="viewWork" data-id="{{item.id}}">
        <view class="hero-item">
          <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" class="hero-img" aria-label="{{item.title || '精选美甲作品'}}" />
          <view wx:else class="hero-img-empty"></view>
          <view class="hero-overlay">
            <view class="hero-bottom-area">
              <view class="hero-bottom-row">
                <view class="hero-info">
                  <text class="hero-info-title">{{item.title}}</text>
                  <view class="hero-info-meta">
                    <text>{{item.technicianName}}</text>
                  </view>
                </view>
                <view class="hero-cta-btn booking-action" catchtap="viewWork" data-id="{{item.id}}">
                  <text class="hero-cta-label">查看详情</text>
                  <text class="hero-cta-arrow">›</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <view wx:else class="hero-placeholder">
      <image class="hero-placeholder-icon" src="/static/icons/image.svg" mode="aspectFit" />
      <text class="hero-placeholder-text">{{heroLoadFailed ? '推荐作品加载失败' : (technicianCount > 0 ? '美甲师暂未设置首页推荐' : (clientLoggedIn ? '绑定美甲师后查看首页推荐' : '暂无公开推荐作品'))}}</text>
      <view class="booking-action hero-empty-action" bindtap="{{heroLoadFailed ? 'loadData' : 'navigateToWorks'}}" role="button">{{heroLoadFailed ? '重新加载' : '浏览作品'}}</view>
    </view>

    <view wx:if="{{recentWorks.length > 1}}" class="hero-dots">
      <view
        wx:for="{{recentWorks}}"
        wx:key="id"
        class="hero-dot {{swiperIndex === index ? 'hero-dot-active' : ''}}"
        data-index="{{index}}"
        bindtap="onDotTap"
      ></view>
    </view>
  </view>

  <!-- 我的预约：首屏核心信息，紧跟作品 Hero -->
  <view class="section booking-section booking-section-primary">
    <view class="section-header">
      <text class="section-title">我的预约</text>
      <view wx:if="{{upcomingOrder}}" class="section-more semantic-link" bindtap="navigateToOrders">查看全部 ›</view>
    </view>

    <view wx:if="{{upcomingOrder}}" class="order-card">
      <view class="order-card-content">
        <view class="order-card-body">
          <view class="order-date-box">
            <text class="order-date-month order-date-sub">{{orderMonth}}</text>
            <text class="order-date-day">{{orderDay}}</text>
            <text class="order-date-weekday">{{orderWeekday}}</text>
          </view>
          <view class="order-details">
            <view class="order-title-row">
              <view class="info-row order-time-row">
                <image class="info-icon" src="/static/icons/clock.svg" mode="aspectFit" />
                <text class="order-time-title order-time-range">{{upcomingOrder.timeStr}}</text>
              </view>
              <view class="order-status-col">
                <view class="status-badge {{upcomingOrder.statusClass}}">{{upcomingOrder.statusText}}</view>
                <text wx:if="{{upcomingOrder.countdownText || upcomingOrder.countdown}}" class="order-countdown-text">{{upcomingOrder.countdownText || (upcomingOrder.countdown === '已开始' ? '已开始' : '还有 ' + upcomingOrder.countdown)}}</text>
              </view>
            </view>
            <view wx:if="{{orderShopName}}" class="info-row">
              <image class="info-icon" src="/static/icons/shop.svg" mode="aspectFit" />
              <text class="info-text info-text-strong order-shop-name">{{orderShopName}}</text>
            </view>
            <view wx:if="{{upcomingOrder.technician}}" class="info-row">
              <image class="info-icon" src="/static/icons/role-client.svg" mode="aspectFit" />
              <text class="info-text">美甲师 {{upcomingOrder.technician.name}}</text>
            </view>
            <view wx:if="{{orderAddress}}" class="info-row info-row-address order-address-row">
              <image class="info-icon" src="/static/icons/pin.svg" mode="aspectFit" />
              <view class="order-detail-address-wrap">
                <text class="info-text info-text-muted order-detail-address">{{orderAddress}}</text>
                <text class="address-nav-action" catchtap="navigateToShop" role="button" aria-label="导航到店"><text class="guidance-sep"> · </text><text class="nav-link-text">导航 ›</text></text>
                <text wx:if="{{orderShopGuidance}}" class="order-guidance-link" catchtap="openUpcomingGuidance" role="button" aria-label="查看到店指引"><text class="guidance-sep"> · </text><text class="guidance-link-text">查看到店指引 ›</text></text>
              </view>
            </view>
          </view>
        </view>
        <view class="order-card-actions" catchtap="">
          <view class="order-action-btn booking-action" bindtap="navigateToChat"><image class="order-action-icon" src="/static/icons/tab-chat.svg" mode="aspectFit" /><text>发消息</text></view>
          <view wx:if="{{upcomingOrder.technician.phone}}" class="order-action-btn booking-action" bindtap="callTech"><image class="order-action-icon order-action-icon-phone" src="/static/icons/phone-white.svg" mode="aspectFit" /><text>打电话</text></view>
          <view class="order-action-btn order-action-primary booking-action" bindtap="viewUpcomingOrder" role="button" aria-label="查看预约详情">查看详情</view>
        </view>
      </view>
    </view>

    <view wx:else class="no-order-card" bindtap="navigateToBooking">
      <view class="no-order-content">
        <view class="no-order-copy" wx:if="{{technician}}">
          <text class="no-order-title">预约专属美甲师 · {{technician.name}}</text>
          <text class="no-order-sub">快捷锁定档期，款式与价格可稍后沟通</text>
        </view>
        <view class="no-order-copy" wx:else>
          <text class="no-order-title">当前暂无预约</text>
          <text class="no-order-sub">挑选喜欢的款式，快速预约美甲师</text>
        </view>
        <view class="book-btn booking-action">
          <text>{{technician ? '快捷预约' : '去预约'}}</text>
          <text class="book-btn-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 精选作品 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">精选作品</text>
      <view class="section-more semantic-link" bindtap="navigateToWorks">查看全部 ›</view>
    </view>

    <view wx:if="{{featuredWorks.length}}" class="home-works-grid">
      <view class="home-works-col" wx:for="{{featuredCols}}" wx:for-item="col" wx:key="id">
        <view wx:for="{{col.items}}" wx:key="id" class="work-card">
          <work-card variant="editorial" work="{{item}}" bind:cardtap="onWorkCardTap" bind:artisttap="onArtistTap" bind:liketap="onLikeTap" bind:favoritetap="onFavoriteTap" bind:commenttap="onWorkCardTap" />
        </view>
      </view>
    </view>

    <view wx:if="{{worksLoading}}" class="works-loading">
      <view class="loading-spinner"></view>
    </view>
    <view wx:if="{{!worksHasMore && featuredWorks.length > 0}}" class="works-end">
      <text class="works-end-text">没有更多了</text>
    </view>

    <view wx:if="{{featuredWorks.length === 0 && !worksLoading}}" class="works-empty">
      <view class="works-empty-icon-wrap">
        <image class="works-empty-icon" src="/static/icons/image.svg" mode="aspectFit" />
      </view>
      <text class="works-empty-text">暂无作品展示</text>
      <text class="works-empty-sub">绑定美甲师后，即可查看TA发布的最新作品</text>
      <view class="works-empty-cta booking-action" bindtap="goBindTech">绑定美甲师</view>
    </view>
  </view>
</view>

<tab-bar selected="home" />
<subscription-onboarding
  visible="{{showSubscriptionOnboarding}}"
  role="client"
  loading="{{subscriptionRequesting}}"
  bindclose="closeSubscriptionOnboarding"
  bindenable="enableFirstSubscription"
/>
