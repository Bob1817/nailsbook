@import '../../../styles/tokens.wxss';

page {
  padding: 0;
  margin: 0;
}

/* ===== 资产卡片网格 ===== */
.asset-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 22rpx; }
.asset-card {
  min-height: 270rpx; padding: var(--space-lg);
  border-radius: var(--radius-lg);
  display: flex; flex-direction: column;
  box-sizing: border-box;
}
.archive-card { background: var(--nb-action); color: var(--text-inverse); }
.ai-card { background: var(--nb-surface); color: var(--nb-ink); box-shadow: var(--shadow-sm); }
.asset-card:active { opacity: 0.88; }
.asset-eyebrow { font-size: var(--font-xs); letter-spacing: 2rpx; opacity: 0.7; font-weight: var(--weight-bold); }
.asset-title { margin-top: 20rpx; font-size: var(--font-md); line-height: var(--leading-tight); font-weight: var(--weight-bold); }
.asset-desc { margin-top: 12rpx; font-size: var(--font-xs); line-height: var(--leading-relaxed); opacity: 0.75; }
.asset-link { margin-top: auto; padding-top: 22rpx; font-size: var(--font-sm); font-weight: var(--weight-semibold); }

/* ===== 预约区域 ===== */
.booking-section { margin-bottom: 18rpx; }
.booking-section-primary { margin-top: var(--space-lg); }

.container {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 0 0 24rpx;
  margin: 0;
}



.order-action-icon { width: var(--icon-sm); height: var(--icon-sm); margin-right: 6rpx; }
.order-action-icon-phone { filter: brightness(0); opacity: .72; }

/* Hero & Works empty icons */
.hero-placeholder-icon {
  width: var(--icon-display);
  height: var(--icon-display);
  margin-bottom: var(--space-md);
  opacity: 0.35;
}

.works-empty-icon {
  width: var(--icon-display);
  height: var(--icon-display);
  opacity: 0.35;
}

/* ===== 轮播 ===== */
.hero-section {
  margin: var(--space-lg) var(--space-xl) 0;
  position: relative;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--bg-card);
  box-shadow: var(--shadow-md);
  border: 0;
}

.hero-swiper {
  width: 100%; height: 620rpx;
  border-radius: 0; overflow: hidden;
  box-shadow: none; margin: 0; padding: 0;
}

.hero-placeholder {
  width: 100%; height: 620rpx;
  background: var(--nb-page);
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
}
.hero-placeholder-text { font-size: var(--font-md); color: var(--text-muted); }

.hero-item { position: relative; width: 100%; height: 620rpx; }
.hero-img { width: 100%; height: 100%; display: block; }
.hero-img-empty { width: 100%; height: 100%; background: var(--nb-page); }

.hero-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.24) 0%, rgba(0, 0, 0, 0.02) 30%, rgba(0, 0, 0, 0.08) 58%, rgba(0, 0, 0, 0.76) 100%);
  padding: var(--space-lg) var(--space-lg) var(--space-lg);
  display: flex; flex-direction: column; justify-content: flex-end;
}

.hero-bottom-area { display: flex; flex-direction: column; }
.hero-bottom-row {
  display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-sm);
}
.hero-info { flex: 1; min-width: 0; }
.hero-info-title {
  font-size: var(--font-lg); font-weight: var(--weight-bold);
  color: var(--text-inverse);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  display: block;
}
.hero-info-meta {
  display: flex; align-items: center; gap: var(--space-xs);
  margin-top: 10rpx;
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.88);
}
.hero-cta-btn {
  flex-shrink: 0; min-height: var(--touch-min);
  background: rgba(0, 0, 0, 0.34);
  color: var(--text-inverse);
  font-size: var(--font-sm); font-weight: var(--weight-semibold);
  padding: 0 var(--space-md);
  border-radius: 36rpx;
  border: 0;
  display: flex; align-items: center; gap: 4rpx;
}
.hero-cta-btn:active { opacity: 0.88; }
.hero-cta-label, .hero-cta-arrow { color: var(--text-inverse); }
.hero-cta-arrow { font-size: var(--font-lg); line-height: 1; }

/* 轮播指示器 */
.hero-dots {
  position: absolute; z-index: 2;
  top: 22rpx; left: 0; right: 0;
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
}
.hero-dot {
  height: 6rpx; width: 6rpx; border-radius: 3rpx;
  background: rgba(255, 255, 255, 0.58);
  transition: width 0.3s;
}
.hero-dot-active { width: 24rpx; background: var(--text-inverse); }

/* ===== 分区 ===== */
.section {
  margin: var(--space-2xl) var(--space-xl) 0;
  position: relative;
}
.section-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: var(--space-md);
}
.section-title {
  font-size: var(--font-lg); font-weight: var(--weight-bold);
  color: var(--text-primary);
  letter-spacing: -0.5rpx;
}
.section-more {
  position: relative;
  font-size: var(--font-sm);
  color: var(--nb-text-link);
  flex-shrink: 0;
  font-weight: var(--weight-medium);
  line-height: 1.4;
  padding: 0 4rpx;
}
.section-more::after {
  content: '';
  position: absolute;
  top: -16rpx;
  bottom: -16rpx;
  left: -16rpx;
  right: -16rpx;
}
.section-more:active {
  opacity: 0.7;
}

/* ===== 预约卡片（有预约） ===== */
.order-card {
  display: flex; position: relative;
  border-radius: var(--radius-xl);
  overflow: hidden;
  background: var(--bg-card);
  border: 0;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .05);
}

.order-card-content { flex: 1; min-width: 0; padding: var(--space-md); }

.status-badge {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  min-height: 38rpx;
  box-sizing: border-box;
  padding: 0 14rpx;
  border-radius: var(--radius-full);
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.2;
}
.status-badge::before {
  content: '';
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
  margin-right: 6rpx;
  flex-shrink: 0;
}
.status-red, .status-amber, .status-purple { background: var(--nb-danger-surface); color: var(--nb-danger); }
.status-blue, .status-orange { background: var(--nb-soft-surface); color: var(--nb-text-link); }
.status-green { background: var(--nb-success-surface); color: var(--nb-success); }
.status-gray { background: var(--bg-input); color: var(--text-body); }

.order-status-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  flex-shrink: 0;
}
.order-countdown-text {
  font-size: 20rpx;
  color: var(--nb-muted);
  line-height: 1.2;
  text-align: right;
  white-space: nowrap;
}

.order-card-body {
  display: flex; align-items: flex-start; gap: 20rpx;
}

.order-date-box {
  width: 112rpx; min-height: 128rpx; flex-shrink: 0;
  border-radius: 16rpx;
  background: var(--nb-page);
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  padding: 10rpx 4rpx;
  box-sizing: border-box;
}
.order-date-month,
.order-date-sub,
.order-date-weekday { font-size: 20rpx; color: var(--nb-muted); font-weight: var(--weight-normal); }
.order-date-day {
  font-size: 34rpx; font-weight: var(--weight-semibold);
  color: var(--nb-ink); line-height: 1.1;
  margin: 2rpx 0;
}

.order-details {
  flex: 1; min-width: 0;
  display: flex; flex-direction: column;
}
.order-title-row {
  display: flex; align-items: flex-start; justify-content: space-between;
  gap: var(--space-xs); margin-bottom: 4rpx;
}
.order-time-row {
  flex: 1; min-width: 0; margin-top: 0; min-height: auto; gap: 8rpx;
}
.order-time-title,
.order-time-range {
  flex: 1; min-width: 0;
  font-size: 28rpx; line-height: 1.3; font-weight: var(--weight-semibold);
  color: var(--nb-ink);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.info-row {
  min-width: 0; min-height: 30rpx; margin-top: 6rpx;
  display: flex; align-items: center; gap: 10rpx;
  line-height: 1.35;
}
.info-icon {
  width: 22rpx; height: 22rpx; flex-shrink: 0;
  display: block; opacity: 0.85;
}
.info-text { flex: 1; min-width: 0; color: var(--nb-secondary); font-size: 24rpx; line-height: 1.35; }
.info-text-strong { color: var(--nb-ink); font-weight: var(--weight-medium); }
.info-text-muted { color: var(--nb-muted); }
.order-shop-name { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.info-row-address { align-items: flex-start; }
.info-row-address .info-icon { margin-top: 5rpx; }
.order-detail-address-wrap {
  flex: 1; min-width: 0; line-height: 1.4;
}
.order-detail-address {
  font-size: 22rpx; color: var(--nb-muted); line-height: 1.4;
}
.guidance-sep {
  font-size: 22rpx; color: var(--nb-muted);
}
.address-nav-action {
  display: inline; position: relative;
  font-size: 22rpx; font-weight: var(--weight-medium);
  white-space: nowrap; color: var(--nb-text-link);
}
.address-nav-action .nav-link-text { color: var(--nb-text-link); }
.address-nav-action::before {
  content: ''; position: absolute;
  top: -16rpx; bottom: -16rpx; left: -8rpx; right: -8rpx;
}
.address-nav-action:active { opacity: 0.68; }

.order-guidance-link {
  display: inline; position: relative;
  font-size: 22rpx; font-weight: var(--weight-medium);
  white-space: nowrap; color: var(--nb-text-link);
}
.order-guidance-link .guidance-link-text { color: var(--nb-text-link); }
.order-guidance-link::before {
  content: ''; position: absolute;
  top: -16rpx; bottom: -16rpx; left: -8rpx; right: -8rpx;
}
.order-guidance-link:active { opacity: 0.68; }

.order-card-actions {
  display: flex; gap: 12rpx;
  margin-top: 16rpx; padding-top: 16rpx;
  border-top: 1rpx solid var(--nb-line);
}
.order-action-btn {
  flex: 1; min-height: 44px;
  display: flex; align-items: center; justify-content: center; gap: 6rpx;
  background: var(--nb-soft-surface);
  color: var(--text-body);
  border-radius: var(--space-xl);
  font-size: var(--font-sm); font-weight: var(--weight-medium);
  border: 0;
}
.order-action-btn:active { opacity: 0.82; }
.order-action-primary {
  background: var(--nb-action);
  color: var(--text-inverse);
  font-weight: var(--weight-semibold);
  border: none; box-shadow: none;
}
.order-action-primary:active { background: var(--nb-action-pressed); opacity: 1; }

/* ===== 预约卡片（无预约） ===== */
.no-order-card {
  display: flex;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--bg-card);
  box-shadow: var(--shadow-lg);
  border: 0;
}
.no-order-card:active { opacity: 0.96; transform: scale(0.995); }

.no-order-content {
  flex: 1; min-width: 0; min-height: 136rpx;
  padding: var(--space-md) var(--space-lg);
  display: flex; align-items: center; gap: 20rpx;
  box-sizing: border-box;
}

.no-order-copy { flex: 1; min-width: 0; }

.no-order-title {
  display: block;
  font-size: var(--font-md); font-weight: var(--weight-semibold);
  color: var(--text-primary);
}
.no-order-sub {
  display: block;
  font-size: var(--font-xs);
  color: var(--text-muted);
  line-height: var(--leading-normal);
  margin-top: var(--space-xs);
}

.book-btn {
  display: flex; align-items: center; flex-shrink: 0;
  min-height: var(--touch-min);
  padding: 0 20rpx 0 var(--space-md);
  gap: var(--space-xs);
  background: var(--bg-tag);
  color: var(--brand-primary);
  font-size: var(--font-sm); font-weight: var(--weight-semibold);
  border-radius: var(--radius-xl);
}
.book-btn:active { opacity: 0.85; }
.book-btn-arrow { font-size: var(--font-lg); line-height: 1; color: var(--nb-inverse); }

/* ===== 首页作品网格（瀑布流，与发现页统一为 flex 双列） ===== */
.home-works-grid {
  width:100%; max-width:100%; min-width:0; overflow:hidden; box-sizing:border-box;
  display: flex; gap: var(--space-sm);
  align-items: flex-start;
}
.home-featured-lead { margin-bottom:var(--space-md); }
.home-works-col {
  flex: 1 1 0; min-width:0; display: flex; flex-direction: column; gap: var(--space-sm);
}

/* ===== 加载 / 空状态 ===== */
.works-loading { display: flex; justify-content: center; padding: var(--space-lg) 0; }
.loading-spinner {
  width: 48rpx; height: 48rpx;
  border: 4rpx solid rgba(0, 0, 0, 0.2) /* brand-primary-alpha */;
  border-top-color: var(--brand-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.works-end { text-align: center; padding: var(--space-lg) 0; }
.works-end-text { font-size: var(--font-sm); color: var(--text-muted); }

.works-empty {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 80rpx var(--space-xl);
  text-align: center;
  box-shadow: var(--shadow-md);
  border: 0;
}
.works-empty-icon-wrap {
  width: 128rpx; height: 128rpx;
  margin: 0 auto var(--space-md);
  border-radius: 50%;
  background: var(--nb-page);
  display: flex; align-items: center; justify-content: center;
}
.works-empty-text { font-size: var(--font-md); color: var(--text-muted); }
.works-empty-sub { display: block; margin-top: var(--space-xs); font-size: var(--font-sm); color: var(--text-faint); }
.works-empty-cta {
  width: 240rpx; height: 72rpx; min-height: 72rpx;
  margin: 28rpx auto 0;
  border-radius: 8px;
  background: var(--nb-action);
  color: var(--nb-inverse);
  font-size: var(--font-sm);
  font-weight: var(--weight-semibold);
}

@import '../../../styles/booking-actions.wxss';
.hero-cta-btn.booking-action,
.order-action-btn.booking-action,
.book-btn.booking-action,
.works-empty-cta.booking-action { min-height: 44px; height: var(--control-hit-height); border-radius: 8px; font-size: var(--font-sm); box-shadow: none; }

.hero-empty-action { margin-top:20rpx; min-height:44px; color:var(--nb-text-link); }
