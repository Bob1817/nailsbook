/* ===== 页面根 ===== */
page {
  background: #f5f6fa;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== Hero 顶部 ===== */
.page-hero {
  flex-shrink: 0;
  background: linear-gradient(135deg, #ff6b8a 0%, #c084fc 100%);
  padding: 28rpx 40rpx 40rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  position: relative;
  overflow: hidden;
}

/* 装饰圆 */
.page-hero::before {
  content: '';
  position: absolute;
  right: -48rpx;
  top: -48rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.10);
  pointer-events: none;
}

.page-hero::after {
  content: '';
  position: absolute;
  right: 80rpx;
  bottom: -70rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.07);
  pointer-events: none;
}

.page-hero:active { opacity: 0.95; }

.hero-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  position: relative;
  z-index: 1;
}

.hero-avatar-wrap { flex-shrink: 0; }

.hero-avatar,
.hero-avatar-ph {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.45);
}

.hero-avatar-ph {
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-avatar-char {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
}

.hero-info {
  flex: 1;
  min-width: 0;
}

.hero-label {
  display: block;
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: rgba(255, 255, 255, 0.60);
  font-weight: 500;
  margin-bottom: 6rpx;
}

.hero-name {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: -0.5rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.hero-phone {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.72);
}

.hero-edit {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 4rpx;
  position: relative;
  z-index: 1;
}

.hero-edit-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.80);
}

.hero-arrow {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.55);
  line-height: 1;
}

/* ===== 滚动内容区 ===== */
.content-scroll {
  flex: 1;
  min-height: 0;
}

.content-area {
  padding: 20rpx 32rpx calc(160rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ===== Section 卡片通用 ===== */
.section-card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  overflow: hidden;
}

.section-head {
  padding: 24rpx 28rpx 16rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
  display: block;
  letter-spacing: -0.3rpx;
}

.section-sub {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
  display: block;
}

/* ===== 我的美甲师 ===== */
.tech-section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx 28rpx 16rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.tech-head-titles { flex: 1; min-width: 0; }
.tech-head-title-row { display: flex; align-items: center; gap: 12rpx; }
.tech-count-chip {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #FF6B8A, #A78BFA);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.bind-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #FF6B8A;
  background: #fff1f5;
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  font-weight: 500;
  white-space: nowrap;
}

.bind-btn:active { background: #ffe4ec; }

.tech-body {
  padding: 12rpx 16rpx 16rpx;
}

/* 无美甲师 */
.no-tech {
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  text-align: center;
}

.no-tech-text {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.no-tech-hint {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.bind-now-btn {
  display: inline-block;
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
  padding: 16rpx 48rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 138, 0.25);
}

.bind-now-btn:active { opacity: 0.85; }

/* 美甲师卡片 */
.tech-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 10rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  background: #fff;
}

.tech-card:last-child { margin-bottom: 0; }

.tech-card-default {
  background: linear-gradient(135deg, #FFF0F5 0%, #FAFBFF 100%);
  border-color: rgba(255, 107, 138, 0.12);
}

.tech-main {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.tech-avatar-wrap { flex-shrink: 0; }

.tech-avatar,
.tech-avatar-placeholder {
  width: 88rpx;
  height: 88rpx;
  border-radius: 18rpx;
}

.tech-avatar-placeholder {
  background: linear-gradient(135deg, #FFE0EA, #F4F7FB);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #FF6B8A;
}

.tech-info { flex: 1; min-width: 0; }

.tech-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.tech-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.default-badge {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #fff;
  background: #FF6B8A;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.tech-city {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 10rpx;
}

.city-icon {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B8A, #A78BFA);
  flex-shrink: 0;
}

.tech-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tech-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #6b7280;
  background: #f9fafb;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.tech-tag-pink  { color: #FF6B8A; background: #fff1f5; }
.tech-tag-active { color: #16a34a; background: #ecfdf5; }
.tech-tag-rest   { color: #9ca3af; background: #f3f4f6; }

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.status-dot-active { background: #22c55e; }
.status-dot-rest   { background: #9ca3af; }

.tech-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

.tech-eye-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #fff1f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

.tech-eye-btn::after {
  content: '';
  width: 18rpx;
  height: 11rpx;
  border: 3rpx solid #FF6B8A;
  border-radius: 50%;
}

.tech-eye-btn:active { background: #ffe0ea; }

.tech-action-btn {
  font-size: 22rpx;
  color: #FF6B8A;
  border: 1rpx solid #FF6B8A;
  padding: 6rpx 18rpx;
  border-radius: 18rpx;
  text-align: center;
  white-space: nowrap;
}

.tech-action-btn:active { background: #fff1f5; }

.tech-action-unbind {
  color: #9ca3af;
  border-color: #e5e7eb;
}

.tech-action-unbind:active { background: #f9fafb; }

/* ===== 菜单列表 ===== */
.menu-list { padding: 8rpx 12rpx; }

.menu-item {
  display: flex;
  align-items: center;
  padding: 18rpx 16rpx;
  border-radius: 16rpx;
  gap: 16rpx;
}

.menu-item:active { background: #f9fafb; }

.menu-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-icon-pink   { background: linear-gradient(135deg, #FFF0F5 0%, #FFF5FF 100%); --ic: #FF6B8A; }
.menu-icon-purple { background: linear-gradient(135deg, #F5F3FF 0%, #EEF2FF 100%); --ic: #8B7CF6; }
.menu-icon-gray   { background: #f3f4f6; --ic: #9ca3af; }

/* ===== 菜单图标（CSS 绘制，--ic 控制主色）===== */
.m-icon { width: 36rpx; height: 36rpx; position: relative; }

/* 定位 pin */
.m-icon-pin::before {
  content: ''; position: absolute; left: 5rpx; top: 3rpx;
  width: 26rpx; height: 26rpx; box-sizing: border-box;
  border: 4rpx solid var(--ic); border-radius: 50% 50% 50% 0;
  transform: rotate(45deg);
}
.m-icon-pin::after {
  content: ''; position: absolute; left: 14rpx; top: 12rpx;
  width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--ic);
}

/* 画笔 design */
.m-icon-design::before {
  content: ''; position: absolute; left: 14rpx; top: 2rpx;
  width: 7rpx; height: 26rpx; background: var(--ic); border-radius: 3rpx 3rpx 0 0;
  transform-origin: center; transform: rotate(45deg);
}
.m-icon-design::after {
  content: ''; position: absolute; left: 4rpx; bottom: 3rpx;
  width: 10rpx; height: 4rpx; background: var(--ic); border-radius: 2rpx;
  transform: rotate(45deg);
}

/* 书签 bookmark */
.m-icon-bookmark::before {
  content: ''; position: absolute; left: 7rpx; top: 4rpx;
  width: 22rpx; height: 28rpx; box-sizing: border-box;
  border: 4rpx solid var(--ic); border-radius: 4rpx 4rpx 0 0;
}
.m-icon-bookmark::after {
  content: ''; position: absolute; left: 7rpx; bottom: 4rpx;
  width: 0; height: 0;
  border-left: 11rpx solid transparent; border-right: 11rpx solid transparent;
  border-bottom: 9rpx solid #fff;
}

/* 心形 heart（旋转方块 + 两圆，稳定不裂）*/
.m-icon-heart {
  transform: rotate(-45deg); width: 22rpx; height: 22rpx; margin: 7rpx;
  background: var(--ic);
}
.m-icon-heart::before,
.m-icon-heart::after {
  content: ''; position: absolute; width: 22rpx; height: 22rpx;
  border-radius: 50%; background: var(--ic);
}
.m-icon-heart::before { top: -11rpx; left: 0; }
.m-icon-heart::after  { left: 11rpx; top: 0; }

/* 对话气泡 chat */
.m-icon-chat::before {
  content: ''; position: absolute; left: 4rpx; top: 5rpx;
  width: 28rpx; height: 22rpx; box-sizing: border-box;
  border: 4rpx solid var(--ic); border-radius: 8rpx;
}
.m-icon-chat::after {
  content: ''; position: absolute; left: 9rpx; bottom: 3rpx;
  width: 0; height: 0;
  border-left: 8rpx solid transparent; border-top: 8rpx solid var(--ic);
}

/* 锁 lock */
.m-icon-lock::before {
  content: ''; position: absolute; left: 9rpx; top: 4rpx;
  width: 18rpx; height: 14rpx; box-sizing: border-box;
  border: 4rpx solid var(--ic); border-bottom: 0; border-radius: 9rpx 9rpx 0 0;
}
.m-icon-lock::after {
  content: ''; position: absolute; left: 5rpx; top: 16rpx;
  width: 26rpx; height: 18rpx; background: var(--ic); border-radius: 5rpx;
}

/* 手册 book */
.m-icon-book::before {
  content: ''; position: absolute; left: 5rpx; top: 4rpx;
  width: 26rpx; height: 28rpx; box-sizing: border-box;
  border: 4rpx solid var(--ic); border-radius: 4rpx;
}
.m-icon-book::after {
  content: ''; position: absolute; left: 17rpx; top: 4rpx;
  width: 3rpx; height: 28rpx; background: var(--ic);
}

/* 文档 doc */
.m-icon-doc::before {
  content: ''; position: absolute; left: 7rpx; top: 3rpx;
  width: 22rpx; height: 30rpx; box-sizing: border-box;
  border: 4rpx solid var(--ic); border-radius: 4rpx;
}
.m-icon-doc::after {
  content: ''; position: absolute; left: 12rpx; top: 13rpx;
  width: 12rpx; height: 3rpx; background: var(--ic);
  box-shadow: 0 7rpx 0 var(--ic);
}

/* 盾牌 shield */
.m-icon-shield::before {
  content: ''; position: absolute; left: 7rpx; top: 4rpx;
  width: 22rpx; height: 22rpx; box-sizing: border-box;
  border: 4rpx solid var(--ic); border-radius: 4rpx 4rpx 50% 50%;
}
.m-icon-shield::after {
  content: ''; position: absolute; left: 16rpx; top: 9rpx;
  width: 4rpx; height: 12rpx; background: var(--ic); border-radius: 2rpx;
}

/* 切换 swap */
.m-icon-swap::before {
  content: ''; position: absolute; left: 5rpx; top: 11rpx;
  width: 26rpx; height: 3rpx; background: var(--ic);
  box-shadow: 0 8rpx 0 var(--ic);
}
.m-icon-swap::after {
  content: ''; position: absolute; left: 24rpx; top: 7rpx;
  width: 10rpx; height: 10rpx; border-right: 3rpx solid var(--ic); border-top: 3rpx solid var(--ic);
  transform: rotate(45deg);
}

/* 信息 info */
.m-icon-info {
  width: 30rpx; height: 30rpx; margin: 3rpx;
  border: 4rpx solid var(--ic); border-radius: 50%; box-sizing: border-box;
}
.m-icon-info::after {
  content: ''; position: absolute; left: 11rpx; top: 8rpx;
  width: 4rpx; height: 4rpx; background: var(--ic); border-radius: 50%;
  box-shadow: 0 6rpx 0 var(--ic), 0 11rpx 0 var(--ic);
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
}

.menu-arrow {
  font-size: 32rpx;
  color: #d1d5db;
  flex-shrink: 0;
}

/* 版本行 */
.version-row {
  display: flex;
  align-items: center;
  padding: 18rpx 28rpx;
  gap: 16rpx;
  border-top: 1rpx solid #f3f4f6;
}

.version-label {
  font-size: 26rpx;
  color: #6b7280;
  font-weight: 400;
}

.version-text {
  font-size: 26rpx;
  color: #9ca3af;
}

/* ===== 退出登录 ===== */
.logout-btn {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 24rpx;
  color: #dc2626;
  font-size: 30rpx;
  text-align: center;
  padding: 28rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
}

.logout-btn:active { opacity: 0.85; }

/* ===== 绑定弹窗 ===== */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.modal-content {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 36rpx 40rpx calc(36rpx + env(safe-area-inset-bottom));
  max-height: 78dvh;
  overflow-y: auto;
  box-shadow: 0 -4rpx 24rpx rgba(15, 23, 42, 0.06);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  background: #f3f4f6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #6b7280;
}

.modal-close:active { background: #e5e7eb; }

.modal-body { margin-bottom: 32rpx; }

.field-label {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}

.code-input-wrap {
  position: relative;
  margin-bottom: 12rpx;
}

.code-input {
  width: 100%;
  height: 96rpx;
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #1f2937;
  box-sizing: border-box;
}

.code-placeholder { color: #d1d5db; }

.code-spinner {
  position: absolute;
  right: 24rpx;
  top: 50%;
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid #FF6B8A;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  transform: translateY(-50%);
}

@keyframes spin {
  from { transform: translateY(-50%) rotate(0deg); }
  to   { transform: translateY(-50%) rotate(360deg); }
}

.field-hint {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.6;
}

.found-tech {
  display: flex;
  align-items: center;
  background: #fff1f5;
  border-radius: 16rpx;
  padding: 24rpx;
  gap: 20rpx;
  margin-top: 24rpx;
}

.found-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.found-avatar-img { width: 100%; height: 100%; }

.found-avatar-char {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF6B8A;
}

.found-info { flex: 1; }

.found-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 4rpx;
}

.found-city {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
}

.modal-btn {
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  padding: 28rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 138, 0.25);
}

.modal-btn:active { opacity: 0.85; }
.modal-btn-disabled { opacity: 0.45; }
