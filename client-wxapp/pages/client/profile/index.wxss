.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 头部 */
.header {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FF6B8A, #FF8FA3);
  padding: 60rpx 32rpx 40rpx;
  gap: 24rpx;
}
.header:active { opacity: 0.9; }

.avatar-wrap { flex-shrink: 0; }

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.3);
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-char {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
}

.user-info { flex: 1; }

.nickname {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 6rpx;
}

.phone {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  margin-bottom: 6rpx;
}

.edit-hint {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}

.header-arrow {
  font-size: 44rpx;
  color: rgba(255,255,255,0.7);
}

/* 分区 */
.section {
  padding: 0 32rpx;
  margin-top: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.bind-btn {
  font-size: 26rpx;
  color: #FF6B8A;
  background: #fff0f5;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

/* 无美甲师 */
.no-tech {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  text-align: center;
}

.no-tech-text {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.bind-now-btn {
  display: inline-block;
  background: linear-gradient(135deg, #FF6B8A, #FF8FA3);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
}

/* 美甲师卡片 */
.tech-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  gap: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.tech-card-default {
  background: linear-gradient(135deg, #FFF0F5, #FAFBFF);
  border: 1rpx solid rgba(255,107,138,0.15);
}

.tech-avatar-wrap { flex-shrink: 0; }

.tech-avatar, .tech-avatar-placeholder {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
}

.tech-avatar-placeholder {
  background: linear-gradient(135deg, #FFE0EA, #F4F7FB);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #FF6B8A;
}

.tech-info { flex: 1; min-width: 0; }

.tech-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.tech-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.default-badge {
  font-size: 20rpx;
  color: #fff;
  background: #FF6B8A;
  padding: 3rpx 12rpx;
  border-radius: 12rpx;
}

.tech-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tech-tag {
  font-size: 22rpx;
  color: #888;
  background: #f5f5f5;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}

.tech-tag-pink {
  color: #FF6B8A;
  background: #fff0f5;
}

.tech-tag-green {
  color: #10b981;
  background: #ecfdf5;
}

.tech-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex-shrink: 0;
}

.tech-action-btn {
  font-size: 24rpx;
  color: #FF6B8A;
  border: 1rpx solid #FF6B8A;
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
  text-align: center;
}

.tech-action-unbind {
  color: #999;
  border-color: #ddd;
}

/* 菜单列表 */
.menu-list {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
  gap: 20rpx;
}

.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: #fafafa; }

.menu-icon { font-size: 36rpx; }
.menu-label { flex: 1; font-size: 30rpx; color: #1a1a1a; }
.menu-arrow { font-size: 40rpx; color: #ccc; }

/* 退出 */
.logout-btn {
  margin: 24rpx 32rpx 0;
  background: #fff;
  border-radius: 24rpx;
  color: #ff4d4f;
  font-size: 30rpx;
  text-align: center;
  padding: 28rpx;
}
.logout-btn:active { opacity: 0.7; }

.version {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #ccc;
  margin-top: 32rpx;
}

/* 绑定弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.modal-content {
  width: 100%;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.modal-close {
  width: 60rpx;
  height: 60rpx;
  background: #f5f5f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666;
}

.modal-body { margin-bottom: 32rpx; }

.field-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.code-input-wrap {
  position: relative;
  margin-bottom: 12rpx;
}

.code-input {
  width: 100%;
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #1a1a1a;
  box-sizing: border-box;
}

.code-placeholder { color: #ccc; }

.code-spinner {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid #FF6B8A;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.field-hint {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.found-tech {
  display: flex;
  align-items: center;
  background: #fff0f5;
  border-radius: 20rpx;
  padding: 24rpx;
  gap: 20rpx;
  margin-top: 24rpx;
}

.found-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.found-avatar-img { width: 100%; height: 100%; }
.found-avatar-char { font-size: 36rpx; font-weight: 700; color: #FF6B8A; }

.found-info { flex: 1; }
.found-name { display: block; font-size: 30rpx; font-weight: 600; color: #1a1a1a; margin-bottom: 6rpx; }
.found-city { display: block; font-size: 24rpx; color: #999; }

.modal-btn {
  background: linear-gradient(135deg, #FF6B8A, #FF8FA3);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  padding: 28rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255,107,138,0.3);
}

.modal-btn:active { opacity: 0.85; }
.modal-btn-disabled { opacity: 0.5; }
