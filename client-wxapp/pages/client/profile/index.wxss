/* ===== 页面根 ===== */
page {
  background: var(--bg-page);
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== Hero 顶部 ===== */
.page-hero {
  flex-shrink: 0;
  background: var(--nb-action);
  padding: 28rpx 40rpx 40rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  position: relative;
  overflow: hidden;
}

/* 装饰圆 */
.page-hero:active { opacity: 0.95; }

.hero-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  position: relative;
  z-index: 1;
}

.hero-avatar-wrap { flex-shrink: 0; }

.hero-avatar,
.hero-avatar-ph {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  border: 0;
}

.hero-avatar-ph {
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-avatar-char {
  font-size: var(--font-2xl);
  font-weight: var(--weight-bold);
  color: var(--text-inverse);
}

.hero-info {
  flex: 1;
  min-width: 0;
}

.hero-label {
  display: block;
  font-size: var(--font-xs);
  letter-spacing: 6rpx;
  color: rgba(255, 255, 255, 0.60);
  font-weight: var(--weight-medium);
  margin-bottom: 6rpx;
}

.hero-name {
  display: block;
  font-size: var(--font-xl);
  font-weight: var(--weight-bold);
  color: var(--text-inverse);
  letter-spacing: -0.5rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.hero-phone {
  display: block;
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.72);
}

.hero-edit {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 4rpx;
  position: relative;
  z-index: 1;
}

.hero-edit-text {
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.80);
}

.hero-arrow {
  font-size: var(--font-lg);
  color: rgba(255, 255, 255, 0.55);
  line-height: 1;
}

/* ===== 滚动内容区 ===== */
.content-scroll {
  flex: 1;
  min-height: 0;
}

.content-area {
  padding: 20rpx 32rpx calc(160rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ===== Section 卡片通用 ===== */
.section-card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md), 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
  border: 0;
  overflow: hidden;
}



.section-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  display: block;
  letter-spacing: -0.3rpx;
}

.section-sub {
  font-size: var(--font-xs);
  color: var(--text-muted);
  margin-top: 4rpx;
  display: block;
}

/* ===== 我的美甲师 ===== */


.tech-head-titles { flex: 1; min-width: 0; }
.tech-head-title-row { display: flex; align-items: center; gap: 12rpx; }
.tech-count-chip {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: var(--radius-sm);
  background: var(--brand-gradient);
  color: var(--text-inverse);
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.bind-btn {
  flex-shrink: 0;
  font-size: var(--font-sm);
  color: var(--brand-primary);
  background: var(--nb-page);
  padding: 10rpx 24rpx;
  border-radius: var(--radius-lg);
  font-weight: var(--weight-medium);
  white-space: nowrap;
}

.bind-btn:active { background: var(--nb-page); }



/* 无美甲师 */
.no-tech {
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  padding: 40rpx 32rpx;
  text-align: center;
}

.no-tech-text {
  display: block;
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.no-tech-hint {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
  margin-bottom: var(--space-md);
  line-height: 1.6;
}

.bind-now-btn {
  display: inline-block;
  background: var(--brand-gradient);
  color: var(--text-inverse);
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  padding: 16rpx 48rpx;
  border-radius: var(--radius-md);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.25) /* brand-primary-alpha */;
}

.bind-now-btn:active { opacity: 0.85; }

/* 美甲师卡片 */


.tech-card:last-child { margin-bottom: 0; }



.tech-main {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.tech-avatar-wrap { flex-shrink: 0; }

.tech-avatar,
.tech-avatar-placeholder {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--card-radius);
}

.tech-avatar-placeholder {
  background: var(--nb-page);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--brand-primary);
}

.tech-info { flex: 1; min-width: 0; }

.tech-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.tech-name {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tech-status-chip {
  flex-shrink: 0;
  font-size: var(--font-xs);
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  font-weight: var(--weight-medium);
  line-height: 30rpx;
}

.tech-status-chip-active {
  color: var(--nb-success);
  background: var(--nb-success-surface);
}

.tech-status-chip-rest {
  color: var(--text-muted);
  background: var(--bg-input);
}

.tech-status-chip-pending {
  color: var(--nb-secondary);
  background: var(--nb-soft-surface);
}

.tech-meta {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 7rpx;
  font-size: var(--font-xs);
  color: var(--text-muted);
}

.tech-meta-separator { color: var(--border-strong); }
.tech-shop-name {
  display: block;
  min-width: 0;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: var(--font-sm);
  line-height: 1.4;
  color: var(--text-secondary);
}



.tech-eye-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--nb-page);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

.tech-eye-btn::after {
  content: '';
  width: 18rpx;
  height: 11rpx;
  border: 0;
  border-radius: 50%;
 background: var(--nb-soft-surface);}

.tech-eye-btn:active { background: var(--nb-page); }

.tech-action-btn {
  font-size: var(--font-xs);
  color: var(--brand-primary);
  border: 0;
  padding: 6rpx 18rpx;
  border-radius: var(--card-radius);
  text-align: center;
  white-space: nowrap;
 background: var(--nb-soft-surface);}

.tech-action-btn:active { background: var(--nb-page); }

.tech-action-unbind {
  color: var(--text-muted);
  border-color: var(--border-default);
}

.tech-action-unbind:active { background: var(--bg-input); }

/* ===== 菜单列表 ===== */
.menu-list { padding: 8rpx 12rpx; }

.menu-item {
  display: flex;
  align-items: center;
  padding: 18rpx 16rpx;
  border-radius: var(--radius-sm);
  gap: 16rpx;
}

.menu-item:active { background: var(--bg-input); }

.menu-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--card-radius);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-icon-pink   { background: var(--nb-page); --ic: var(--brand-primary); }
.menu-icon-purple { background: var(--nb-page); --ic: var(--nb-action); }
.menu-icon-gray   { background: var(--bg-input); --ic: var(--nb-control); }

/* ===== 统一静态图标系统 ===== */
.m-icon { width: 36rpx; height: 36rpx; }

.menu-label {
  flex: 1;
  font-size: var(--font-md);
  color: var(--text-primary);
  font-weight: var(--weight-medium);
}

.menu-arrow {
  font-size: var(--font-lg);
  color: var(--text-muted);
  flex-shrink: 0;
}

/* 版本行 */
.version-row {
  display: flex;
  align-items: center;
  padding: 18rpx 28rpx;
  gap: 16rpx;
  border-top: 0;
}

.version-label {
  font-size: var(--font-sm);
  color: var(--text-muted);
  font-weight: var(--weight-normal);
}

.version-text {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

/* ===== 退出登录 ===== */
.logout-btn {
  background: rgba(255, 255, 255, 0.92);
  border-radius: var(--radius-md);
  color: var(--text-error);
  font-size: var(--font-md);
  text-align: center;
  padding: 28rpx;
  font-weight: var(--weight-medium);
  box-shadow: var(--shadow-md), 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
}

.logout-btn:active { opacity: 0.85; }

.hero-name-row { display:flex; align-items:center; gap:12rpx; min-width:0; }
.menu-value { flex-shrink:0; color:var(--nb-muted); font-size:var(--font-xs); }
.account-logout .menu-label { color:var(--nb-danger); }

/* ===== H5 同步：内容卡片与美甲师信息层级 ===== */
.content-area {
  padding: 28rpx 32rpx calc(160rpx + env(safe-area-inset-bottom));
  gap: 24rpx;
}

/* ===== 身份切换卡片 ===== */
.role-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  border: 0;
}

.role-card:active { opacity: 0.92; }

.role-card-left {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  flex: 1;
  min-width: 0;
}

.role-card-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--card-radius);
  background: var(--nb-page);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.role-card-badge-icon {
  width: 36rpx;
  height: 36rpx;
}

.role-card-info {
  flex: 1;
  min-width: 0;
}

.role-card-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.role-card-title {
  display: block;
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.role-card-sub {
  display: block;
  font-size: var(--font-xs);
  color: var(--text-muted);
}

.role-card-switch-btn {
  position: relative;
  flex-shrink: 0;
  display: flex;
  min-height: var(--control-hit-height);
  padding: 0 28rpx;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: var(--text-inverse);
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  z-index: 0;
}
.role-card-switch-btn::before { content:''; position:absolute; left:0; right:0; top:var(--control-visual-inset); bottom:var(--control-visual-inset); z-index:-1; border-radius:var(--radius-lg); background:var(--text-primary); }

.role-card-switch-btn:active { opacity: 0.82; }

/* 游客标签 */
.role-card-tourist-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  background: var(--nb-page);
  border: 0;
  border-radius: var(--radius-xs);
  font-size: var(--font-xs);
  color: var(--nb-ink);
  font-weight: var(--weight-medium);
  flex-shrink: 0;
  margin-bottom: 4rpx;
}

.role-card-badge-tourist {
  background: var(--nb-page);
}

/* 角色切换底部面板 - 游客 */
.role-sheet-option-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.role-sheet-tourist-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  background: var(--nb-page);
  border: 0;
  border-radius: var(--radius-xs);
  font-size: var(--font-xs);
  color: var(--nb-ink);
  font-weight: var(--weight-medium);
}

.role-sheet-option-icon-tourist {
  background: var(--nb-page);
}

/* ===== 身份切换底部面板 ===== */
.role-sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
  display: flex;
  align-items: flex-end;
  animation: roleSheetFadeIn 0.24s ease-out;
}

@keyframes roleSheetFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.role-sheet {
  width: 100%;
  background: var(--bg-card);
  border-radius: 24rpx 24rpx 0 0;
  padding: var(--space-md) var(--space-lg) calc(var(--space-lg) + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  animation: roleSheetSlideUp 0.28s cubic-bezier(0.32, 0.72, 0, 1);
}

@keyframes roleSheetSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.role-sheet-handle {
  width: 72rpx;
  height: 8rpx;
  background: var(--border-default);
  border-radius: 4rpx;
  align-self: center;
  margin-bottom: var(--space-xs);
}

.role-sheet-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-black);
  color: var(--text-primary);
  text-align: center;
}

.role-sheet-sub {
  font-size: var(--font-sm);
  color: var(--text-faint);
  text-align: center;
  margin-bottom: var(--space-sm);
}

.role-sheet-option {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-md);
  border-radius: var(--radius-md);
  background: var(--bg-input);
}

.role-sheet-option-active {
  background: var(--nb-page);
}

.role-sheet-option-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--card-radius);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.role-sheet-option-icon-img {
  width: 36rpx;
  height: 36rpx;
}

.role-sheet-option-icon-client {
  background: var(--nb-page);
}

.role-sheet-option-icon-tech {
  background: var(--nb-page);
}

.role-sheet-option-info {
  flex: 1;
  min-width: 0;
}

.role-sheet-option-title {
  display: block;
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.role-sheet-option-desc {
  display: block;
  font-size: var(--font-xs);
  color: var(--text-muted);
}

.role-sheet-check {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
}

.role-sheet-check-img {
  width: 48rpx;
  height: 48rpx;
}

.role-sheet-arrow {
  font-size: var(--font-xl);
  color: var(--text-faint);
  flex-shrink: 0;
}

.role-sheet-cancel {
  text-align: center;
  padding: var(--space-md);
  font-size: var(--font-md);
  color: var(--text-muted);
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  margin-top: var(--space-xs);
}

.role-sheet-cancel:active { opacity: 0.7; }

/* ===== H5 同步：内容卡片与美甲师信息层级 ===== */
.section-card {
  border-radius: var(--radius-xl);
  background: rgba(255, 255, 255, 0.96);
  border-color: rgba(0, 0, 0, 0.05);
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.07);
}


.tech-section-card { overflow: visible; }
.tech-count-chip { background: var(--nb-page); color: var(--nb-ink); }
.bind-btn {
  min-height: 72rpx;
  padding: 0 22rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}



.tech-card-primary { display: flex; align-items: flex-start; gap: 12rpx; }
.tech-main { flex: 1; min-width: 0; align-items: center; gap: 20rpx; }
.tech-avatar,
.tech-avatar-placeholder { width: 108rpx; height: 108rpx; border-radius: 30rpx; }
.tech-name { font-size: var(--font-lg); }
.tech-meta { color: var(--text-muted); font-size: var(--font-sm); }
.tech-delete-btn {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: -14rpx -14rpx 0 0;
  border-radius: 50%;
}
.tech-delete-btn:active { opacity: .62; }
.tech-delete-icon {
  width: 30rpx;
  height: 30rpx;
  padding: 11rpx;
  border-radius: 50%;
  background: var(--nb-page);
  opacity: .74;
}
.tech-quick-actions {
  display: flex;
  align-items: center;
  gap: 0;
  margin: 18rpx -28rpx -28rpx;
  border-top: 1rpx solid rgba(0, 0, 0, .05);
  background: var(--bg-card);
  overflow: hidden;
  border-radius: 0 0 var(--radius-lg) var(--radius-lg);
}
.tech-quick-action {
  flex: 1;
  min-width: 0;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  border-radius: 0;
  background: transparent;
  color: var(--text-secondary);
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  white-space: nowrap;
}
.tech-quick-action + .tech-quick-action { position: relative; }
.tech-quick-action + .tech-quick-action::before {
  content: '';
  position: absolute;
  left: 0;
  top: 24rpx;
  width: 1rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, .06);
}
.tech-quick-action:active { background: var(--nb-page); }
.tech-quick-icon { width: 28rpx; height: 28rpx; flex-shrink: 0; opacity: .68; }
.menu-list { padding: 8rpx 16rpx 16rpx; }
.menu-item { min-height: 104rpx; padding: 12rpx 16rpx; border-radius: var(--radius-md); }
.logout-btn { border-radius: var(--radius-lg); box-shadow: 0 16rpx 42rpx rgba(0, 0, 0, 0.07); }

/* ===== 绑定弹窗 ===== */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: flex-end;
  z-index: 1200;
}

.modal-content {
  width: 100%;
  background: var(--bg-card);
  border-radius: var(--radius-md) 24rpx 0 0;
  padding: 36rpx 40rpx calc(36rpx + env(safe-area-inset-bottom));
  max-height: calc(86vh - env(safe-area-inset-bottom));
  overflow-y: auto;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.bind-mode-tabs { display:flex; gap:8rpx; padding:8rpx; margin-bottom:28rpx; border-radius:20rpx; background:var(--bg-input); }
.bind-mode-tab { flex:1; min-height:72rpx; display:flex; align-items:center; justify-content:center; border-radius:16rpx; color:var(--text-muted); font-size:var(--font-sm); }
.bind-mode-tab-active { color:var(--brand-primary); background:var(--bg-card); box-shadow:0 4rpx 16rpx rgba(0, 0, 0, .08); font-weight:var(--weight-semibold); }
.followed-list { display:flex; flex-direction:column; gap:16rpx; max-height:420rpx; overflow-y:auto; }
.followed-item { min-height:112rpx; display:flex; align-items:center; gap:20rpx; padding:16rpx 20rpx; border: 0; border-radius:20rpx; box-sizing:border-box; }
.followed-item-active { border-color:var(--brand-primary); background:var(--nb-page); }
.followed-item-pending { opacity:.58; }
.followed-avatar { width:72rpx; height:72rpx; border-radius:50%; flex-shrink:0; }
.followed-avatar-fallback { display:flex; align-items:center; justify-content:center; background:var(--nb-page); color:var(--brand-primary); }
.followed-info { flex:1; min-width:0; display:flex; flex-direction:column; gap:4rpx; }
.followed-status { flex-shrink:0; color:var(--nb-text-link); font-size:var(--font-xs); }
.followed-state { min-height:180rpx; display:flex; align-items:center; justify-content:center; color:var(--text-muted); font-size:var(--font-sm); text-align:center; }

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.modal-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  background: var(--bg-input);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-md);
  color: var(--text-muted);
}

.modal-close:active { background: var(--nb-page); }

.modal-body { margin-bottom: 32rpx; }
.bind-modal-actions { margin-top: 8rpx; }

.field-label {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
  margin-bottom: 12rpx;
}

.code-input-wrap {
  position: relative;
  margin-bottom: 12rpx;
}

.code-input {
  width: 100%;
  height: 96rpx;
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  padding: 0 28rpx;
  font-size: var(--font-md);
  color: var(--text-primary);
  box-sizing: border-box;
}

.code-placeholder { color: var(--text-muted); }

.code-spinner {
  width: 36rpx;
  height: 36rpx;
  margin-left: 20rpx;
  flex-shrink: 0;
  border: 3rpx solid var(--brand-primary);
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

.field-hint {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
  line-height: 1.6;
}

.bind-note-input {
  width: 100%;
  min-height: 120rpx;
  margin-top: var(--space-md);
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  padding: 20rpx 28rpx;
  font-size: var(--font-md);
  color: var(--text-primary);
  box-sizing: border-box;
}

.found-tech {
  display: flex;
  align-items: center;
  background: var(--nb-page);
  border-radius: var(--radius-sm);
  padding: var(--space-md);
  gap: 20rpx;
  margin-top: var(--space-md);
}

.found-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.found-avatar-img { width: 100%; height: 100%; }

.found-avatar-char {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--brand-primary);
}

.found-info { flex: 1; }

.found-name {
  display: block;
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.found-city {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
}

.modal-btn {
  background: var(--brand-gradient);
  color: var(--text-inverse);
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  text-align: center;
  padding: 28rpx;
  border-radius: var(--radius-md);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25) /* brand-primary-alpha */;
}

.modal-btn:active { opacity: 0.85; }
.modal-btn-disabled { opacity: 0.45; }

.modal-btn-group {
  display: flex;
  gap: 24rpx;
}

.modal-btn-group .modal-btn {
  flex: 1;
}

.modal-btn-group-vertical {
  flex-direction: column;
}

.modal-btn-secondary {
  background: var(--bg-input);
  color: var(--text-primary);
  box-shadow: none;
}

.modal-btn-secondary:active { opacity: 0.75; }

.confirm-text {
  display: block;
  font-size: var(--font-md);
  color: var(--text-primary);
  line-height: 1.7;
  text-align: center;
  padding: 24rpx 12rpx;
}


.page-hero::before {
  content: '';
  position: absolute;
  right: -48rpx;
  top: -48rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.10);
  pointer-events: none;
}
.page-hero::after {
  content: '';
  position: absolute;
  right: 80rpx;
  bottom: -70rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.07);
  pointer-events: none;
}
.section-head {
  padding: var(--space-md) 28rpx 16rpx;
  border-bottom: 0;
}
.tech-section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: var(--space-md) 28rpx 16rpx;
  border-bottom: 0;
}
.tech-body {
  padding: 12rpx 16rpx 16rpx;
}
.tech-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  border-radius: var(--radius-sm);
  padding: 20rpx;
  margin-bottom: 10rpx;
  border: 0;
  background: var(--bg-card);
}
.tech-card-default { background: var(--bg-card); }
.tech-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}
.section-head { padding: 30rpx 32rpx 20rpx; }
.tech-section-head { padding: 32rpx 32rpx 24rpx; border-bottom: 0; }
.tech-body { padding: 0 20rpx 20rpx; }
.tech-card {
  display: block;
  position: relative;
  padding: 28rpx;
  margin-bottom: var(--space-sm);
  border-radius: var(--radius-lg);
  border-color: rgba(0, 0, 0, 0.05);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.055);
  overflow: hidden;
}
.tech-card-pending {
  background: var(--nb-soft-surface);
  box-shadow: none;
  opacity: .82;
}
.tech-card-pending .tech-quick-actions { background: var(--nb-surface); }
.tech-pending-actions .tech-quick-action:first-child { color: var(--nb-secondary); }

/* 客户端“我的”：对齐美甲师端的紧凑文字与图标层级。 */
.content-area { gap: 16rpx; }
.section-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  line-height: 1.4;
  letter-spacing: 0;
}
.section-sub {
  margin-top: 2rpx;
  font-size: var(--font-sm);
  line-height: 1.45;
}
.section-head {
  padding: 22rpx 28rpx 12rpx;
}
.tech-section-head {
  padding: 24rpx 28rpx 16rpx;
}
.tech-head-title-row { gap: 8rpx; }
.tech-count-chip {
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 8rpx;
  line-height: 28rpx;
}
.menu-list { padding: 4rpx 12rpx 12rpx; }
.menu-item {
  min-height: 88rpx;
  padding: 8rpx 12rpx;
  gap: 14rpx;
  border-radius: var(--radius-sm);
}
.menu-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-xs);
}
.m-icon { width: 40rpx; height: 40rpx; }
.menu-label {
  font-size: var(--font-md);
  font-weight: var(--weight-normal);
  line-height: 1.5;
  color: var(--text-secondary);
}
.menu-arrow { font-size: var(--font-md); }
.version-row {
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 8rpx 24rpx;
  gap: 14rpx;
}
.tech-card-default { background: var(--bg-card); }

.logout-btn { color: var(--nb-danger); }

/* 客户端“我的”与美甲师端共用同一信息层级。 */
.page-hero { margin:0 32rpx; padding:24rpx 28rpx; border-radius:24rpx; background:var(--nb-surface); color:var(--nb-ink); }
.page-hero::before,.page-hero::after { display:none; }
.hero-avatar,.hero-avatar-ph { width:96rpx; height:96rpx; background:var(--nb-soft-surface); }
.hero-name { margin-bottom:4rpx; color:var(--nb-ink); font-size:var(--font-lg); font-weight:var(--weight-semibold); }
.hero-phone { color:var(--nb-muted); font-size:var(--font-xs); }
.hero-edit { min-height:88rpx; }
.hero-edit-text { color:var(--nb-text-link); font-size:var(--font-sm); }
.hero-arrow { color:var(--nb-text-link); font-size:var(--font-md); }
.content-area { padding-top:16rpx; }
.section-card { border-radius:24rpx; background:var(--nb-surface); box-shadow:none; }
.section-title { font-size:var(--font-lg); font-weight:var(--weight-semibold); }
.section-sub { margin-top:4rpx; font-size:var(--font-xs); line-height:1.45; }
.menu-item { min-height:104rpx; padding:8rpx 16rpx; gap:16rpx; }
.menu-icon-wrap { width:56rpx; height:56rpx; border-radius:14rpx; }
.m-icon { width:34rpx; height:34rpx; }
.menu-copy { flex:1; min-width:0; }
.menu-label { display:block; color:var(--nb-ink); font-size:var(--font-sm); font-weight:var(--weight-medium); line-height:1.4; }
.menu-desc { display:block; margin-top:4rpx; overflow:hidden; color:var(--nb-muted); font-size:var(--font-xs); line-height:1.35; text-overflow:ellipsis; white-space:nowrap; }
.menu-arrow { flex-shrink:0; color:var(--nb-muted); }
.tech-name { font-size:var(--font-sm); }
.tech-meta,.tech-shop-name { font-size:var(--font-xs); }
.tech-quick-icon { width:32rpx; height:32rpx; }

/* 头像独立操作，阻止冒泡到资料编辑入口。 */
.hero-avatar-wrap {
  position: relative;
  display: block;
  flex: 0 0 116rpx;
  width: 116rpx;
  height: 116rpx;
  min-width: 116rpx;
  min-height: 116rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  line-height: normal;
  text-align: left;
}
.hero-avatar-wrap::after { border: 0; }
.hero-avatar-wrap:active { opacity: .7; }
.hero-avatar,
.hero-avatar-ph { width: 100%; height: 100%; }
.hero-info { display: flex; flex-direction: column; align-items: flex-start; text-align: left; }
.hero-avatar-ph { background: var(--nb-page); }
.hero-default-icon { width: 60rpx; height: 60rpx; }
.hero-camera-icon { position: absolute; right: -2rpx; bottom: -2rpx; width: 32rpx; height: 32rpx; padding: 6rpx; border-radius: 50%; background: var(--nb-surface); }
.hero-uploading { position: absolute; inset: 0; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,.5); color: var(--nb-inverse); font-size: 22rpx; }

/* 头像操作保留独立热区，视觉尺寸与美甲师端一致。 */
.hero-avatar-wrap {
  flex-basis: 96rpx;
  width: 96rpx;
  height: 96rpx;
  min-width: 96rpx;
  min-height: 96rpx;
}
.hero-camera-icon { width: 28rpx; height: 28rpx; padding: 5rpx; }
.modal-content { border-radius: 28rpx 28rpx 0 0; }
.modal-title { font-size: var(--font-lg); font-weight: var(--weight-semibold); }
.modal-btn { min-height: 88rpx; border-radius: 22rpx; }

/* 菜单只保留单行入口，降低连续列表的信息负担。 */
.section-head { padding-bottom: 10rpx; }
.menu-list { padding-top: 0; }
.menu-item { min-height: 88rpx; padding: 4rpx 16rpx; gap: 14rpx; }
.menu-icon-wrap { width: 48rpx; height: 48rpx; border-radius: 12rpx; background: transparent; }
.m-icon { width: 32rpx; height: 32rpx; }
.menu-label { flex: 1; min-width: 0; font-size: var(--font-sm); font-weight: var(--weight-normal); }
.menu-copy,.menu-desc { display: none; }

.tech-section-card { overflow: hidden; }
.tech-section-head { align-items: center; padding: 24rpx 28rpx 18rpx; }
.tech-head-title-row { gap: 10rpx; }
.tech-count-chip {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 17rpx;
  background: var(--nb-soft-surface);
  color: var(--nb-secondary);
  font-size: var(--font-xs);
  line-height: 34rpx;
}
.tech-section-head .bind-btn {
  min-width: 104rpx;
  min-height: 44px;
  padding: 0 4rpx 0 16rpx;
  background: transparent;
  color: var(--nb-text-link);
  box-shadow: none;
}
.bind-btn-arrow { margin-left: 6rpx; font-size: var(--font-md); }
.tech-preview-list { padding: 0 20rpx 20rpx; }
.tech-preview {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 136rpx;
  margin-top: 12rpx;
  padding: 18rpx 16rpx 18rpx 18rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: var(--nb-page);
}
.tech-preview:first-child { margin-top: 0; }
.tech-preview:active { background: var(--nb-pressed); }
.tech-preview-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  background: var(--nb-soft-surface);
}
.tech-preview-info { flex: 1; min-width: 0; }
.tech-preview-name-row { display: flex; align-items: center; gap: 10rpx; min-width: 0; }
.tech-preview-name {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--nb-ink);
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  line-height: 1.4;
}
.tech-default-badge {
  flex-shrink: 0;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: var(--nb-soft-surface);
  color: var(--nb-text-link);
  font-size: var(--font-xs);
  line-height: 1.35;
}
.tech-preview-meta {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--nb-muted);
  font-size: var(--font-xs);
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tech-preview-action {
  width: 44px;
  height: 44px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.tech-preview-arrow { color: var(--nb-muted); font-size: var(--font-lg); }
.tech-preview-footer {
  min-height: 44px;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: var(--nb-soft-surface);
  color: var(--nb-secondary);
  font-size: var(--font-xs);
}
.tech-preview-footer:active { background: var(--nb-pressed); }
.tech-footer-link { flex-shrink: 0; color: var(--nb-text-link); }
.tech-preview-empty {
  min-height: 128rpx;
  margin: 0 20rpx 20rpx;
  padding: 18rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-radius: 20rpx;
  background: var(--nb-page);
}
.tech-preview-empty:active { background: var(--nb-pressed); }
.tech-empty-icon {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: var(--nb-soft-surface);
}
.tech-empty-icon image { width: 42rpx; height: 42rpx; opacity: .72; }
.tech-empty-copy { flex: 1; min-width: 0; }
.tech-empty-title { display: block; color: var(--nb-ink); font-size: var(--font-sm); font-weight: var(--weight-semibold); }
.tech-empty-hint { display: block; margin-top: 6rpx; color: var(--nb-muted); font-size: var(--font-xs); }
