/* ===== 页面根 ===== */
page {
  background: var(--bg-page);
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== Hero 顶部 ===== */
.page-hero {
  flex-shrink: 0;
  background: linear-gradient(135deg, #ff6b8a 0%, #c084fc 100%);
  padding: 28rpx 40rpx 40rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  position: relative;
  overflow: hidden;
}

/* 装饰圆 */
.page-hero::before {
  content: '';
  position: absolute;
  right: -48rpx;
  top: -48rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.10);
  pointer-events: none;
}

.page-hero::after {
  content: '';
  position: absolute;
  right: 80rpx;
  bottom: -70rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.07);
  pointer-events: none;
}

.page-hero:active { opacity: 0.95; }

.hero-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  position: relative;
  z-index: 1;
}

.hero-avatar-wrap { flex-shrink: 0; }

.hero-avatar,
.hero-avatar-ph {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.45);
}

.hero-avatar-ph {
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-avatar-char {
  font-size: var(--font-2xl);
  font-weight: var(--weight-bold);
  color: var(--text-inverse);
}

.hero-info {
  flex: 1;
  min-width: 0;
}

.hero-label {
  display: block;
  font-size: var(--font-xs);
  letter-spacing: 6rpx;
  color: rgba(255, 255, 255, 0.60);
  font-weight: var(--weight-medium);
  margin-bottom: 6rpx;
}

.hero-name {
  display: block;
  font-size: var(--font-xl);
  font-weight: var(--weight-bold);
  color: var(--text-inverse);
  letter-spacing: -0.5rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.hero-phone {
  display: block;
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.72);
}

.hero-edit {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 4rpx;
  position: relative;
  z-index: 1;
}

.hero-edit-text {
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.80);
}

.hero-arrow {
  font-size: var(--font-lg);
  color: rgba(255, 255, 255, 0.55);
  line-height: 1;
}

/* ===== 滚动内容区 ===== */
.content-scroll {
  flex: 1;
  min-height: 0;
}

.content-area {
  padding: 20rpx 32rpx calc(160rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ===== Section 卡片通用 ===== */
.section-card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  overflow: hidden;
}

.section-head {
  padding: var(--space-md) 28rpx 16rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.section-title {
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  display: block;
  letter-spacing: -0.3rpx;
}

.section-sub {
  font-size: var(--font-xs);
  color: var(--text-muted);
  margin-top: 4rpx;
  display: block;
}

/* ===== 我的美甲师 ===== */
.tech-section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: var(--space-md) 28rpx 16rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.tech-head-titles { flex: 1; min-width: 0; }
.tech-head-title-row { display: flex; align-items: center; gap: 12rpx; }
.tech-count-chip {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: var(--radius-sm);
  background: var(--brand-gradient);
  color: var(--text-inverse);
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.bind-btn {
  flex-shrink: 0;
  font-size: var(--font-sm);
  color: var(--brand-primary);
  background: #fff1f5;
  padding: 10rpx 24rpx;
  border-radius: var(--radius-lg);
  font-weight: var(--weight-medium);
  white-space: nowrap;
}

.bind-btn:active { background: #ffe4ec; }

.tech-body {
  padding: 12rpx 16rpx 16rpx;
}

/* 无美甲师 */
.no-tech {
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  padding: 40rpx 32rpx;
  text-align: center;
}

.no-tech-text {
  display: block;
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.no-tech-hint {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
  margin-bottom: var(--space-md);
  line-height: 1.6;
}

.bind-now-btn {
  display: inline-block;
  background: var(--brand-gradient);
  color: var(--text-inverse);
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  padding: 16rpx 48rpx;
  border-radius: var(--radius-md);
  box-shadow: 0 4rpx 16rpx rgba(255,107,138,0.25) /* brand-primary-alpha */;
}

.bind-now-btn:active { opacity: 0.85; }

/* 美甲师卡片 */
.tech-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  border-radius: var(--radius-sm);
  padding: 20rpx;
  margin-bottom: 10rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  background: var(--bg-card);
}

.tech-card:last-child { margin-bottom: 0; }

.tech-card-default {
  background: linear-gradient(135deg, #FFF0F5 0%, #FAFBFF 100%);
  border-color: rgba(255,107,138,0.12) /* brand-primary-alpha */;
}

.tech-main {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.tech-avatar-wrap { flex-shrink: 0; }

.tech-avatar,
.tech-avatar-placeholder {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--card-radius);
}

.tech-avatar-placeholder {
  background: linear-gradient(135deg, #FFE0EA, #F4F7FB);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--brand-primary);
}

.tech-info { flex: 1; min-width: 0; }

.tech-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.tech-name {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.default-badge {
  flex-shrink: 0;
  font-size: var(--font-xs);
  color: var(--text-inverse);
  background: var(--brand-primary);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-xs);
  font-weight: var(--weight-medium);
}

.tech-city {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: var(--font-xs);
  color: var(--text-muted);
  margin-bottom: 10rpx;
}

.city-icon {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--brand-gradient);
  flex-shrink: 0;
}

.tech-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tech-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: var(--font-xs);
  color: var(--text-muted);
  background: var(--bg-input);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-xs);
}

.tech-tag-pink  { color: var(--brand-primary); background: #fff1f5; }
.tech-tag-active { color: #16a34a; background: #ecfdf5; }
.tech-tag-rest   { color: var(--text-muted); background: var(--bg-input); }

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.status-dot-active { background: #22c55e; }
.status-dot-rest   { background: #9ca3af; }

.tech-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

.tech-eye-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #fff1f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

.tech-eye-btn::after {
  content: '';
  width: 18rpx;
  height: 11rpx;
  border: 3rpx solid var(--brand-primary);
  border-radius: 50%;
}

.tech-eye-btn:active { background: #ffe0ea; }

.tech-action-btn {
  font-size: var(--font-xs);
  color: var(--brand-primary);
  border: 1rpx solid #FF6B8A;
  padding: 6rpx 18rpx;
  border-radius: var(--card-radius);
  text-align: center;
  white-space: nowrap;
}

.tech-action-btn:active { background: #fff1f5; }

.tech-action-unbind {
  color: var(--text-muted);
  border-color: var(--border-default);
}

.tech-action-unbind:active { background: var(--bg-input); }

/* ===== 菜单列表 ===== */
.menu-list { padding: 8rpx 12rpx; }

.menu-item {
  display: flex;
  align-items: center;
  padding: 18rpx 16rpx;
  border-radius: var(--radius-sm);
  gap: 16rpx;
}

.menu-item:active { background: var(--bg-input); }

.menu-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--card-radius);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-icon-pink   { background: linear-gradient(135deg, #FFF0F5 0%, #FFF5FF 100%); --ic: var(--brand-primary); }
.menu-icon-purple { background: linear-gradient(135deg, #F5F3FF 0%, #EEF2FF 100%); --ic: #8B7CF6; }
.menu-icon-gray   { background: var(--bg-input); --ic: #9ca3af; }

/* ===== 菜单图标（CSS 绘制，--ic 控制主色）===== */
.m-icon { width: 36rpx; height: 36rpx; position: relative; }

/* 定位 pin */
.m-icon-pin::before {
  content: ''; position: absolute; left: 5rpx; top: 3rpx;
  width: 26rpx; height: 26rpx; box-sizing: border-box;
  border: 4rpx solid var(--ic); border-radius: 50% 50% 50% 0;
  transform: rotate(45deg);
}
.m-icon-pin::after {
  content: ''; position: absolute; left: 14rpx; top: 12rpx;
  width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--ic);
}

/* 画笔 design */
.m-icon-design::before {
  content: ''; position: absolute; left: 14rpx; top: 2rpx;
  width: 7rpx; height: 26rpx; background: var(--ic); border-radius: 3rpx 3rpx 0 0;
  transform-origin: center; transform: rotate(45deg);
}
.m-icon-design::after {
  content: ''; position: absolute; left: 4rpx; bottom: 3rpx;
  width: 10rpx; height: 4rpx; background: var(--ic); border-radius: 2rpx;
  transform: rotate(45deg);
}

/* 书签 bookmark */
.m-icon-bookmark::before {
  content: ''; position: absolute; left: 7rpx; top: 4rpx;
  width: 22rpx; height: 28rpx; box-sizing: border-box;
  border: 4rpx solid var(--ic); border-radius: 4rpx 4rpx 0 0;
}
.m-icon-bookmark::after {
  content: ''; position: absolute; left: 7rpx; bottom: 4rpx;
  width: 0; height: 0;
  border-left: 11rpx solid transparent; border-right: 11rpx solid transparent;
  border-bottom: 9rpx solid #fff;
}

/* 心形 heart（旋转方块 + 两圆，稳定不裂）*/
.m-icon-heart {
  transform: rotate(-45deg); width: 22rpx; height: 22rpx; margin: 7rpx;
  background: var(--ic);
}
.m-icon-heart::before,
.m-icon-heart::after {
  content: ''; position: absolute; width: 22rpx; height: 22rpx;
  border-radius: 50%; background: var(--ic);
}
.m-icon-heart::before { top: -11rpx; left: 0; }
.m-icon-heart::after  { left: 11rpx; top: 0; }

/* 对话气泡 chat */
.m-icon-chat::before {
  content: ''; position: absolute; left: 4rpx; top: 5rpx;
  width: 28rpx; height: 22rpx; box-sizing: border-box;
  border: 4rpx solid var(--ic); border-radius: 8rpx;
}
.m-icon-chat::after {
  content: ''; position: absolute; left: 9rpx; bottom: 3rpx;
  width: 0; height: 0;
  border-left: 8rpx solid transparent; border-top: 8rpx solid var(--ic);
}

/* 锁 lock */
.m-icon-lock::before {
  content: ''; position: absolute; left: 9rpx; top: 4rpx;
  width: 18rpx; height: 14rpx; box-sizing: border-box;
  border: 4rpx solid var(--ic); border-bottom: 0; border-radius: 9rpx 9rpx 0 0;
}
.m-icon-lock::after {
  content: ''; position: absolute; left: 5rpx; top: 16rpx;
  width: 26rpx; height: 18rpx; background: var(--ic); border-radius: 5rpx;
}

/* 手册 book */
.m-icon-book::before {
  content: ''; position: absolute; left: 5rpx; top: 4rpx;
  width: 26rpx; height: 28rpx; box-sizing: border-box;
  border: 4rpx solid var(--ic); border-radius: 4rpx;
}
.m-icon-book::after {
  content: ''; position: absolute; left: 17rpx; top: 4rpx;
  width: 3rpx; height: 28rpx; background: var(--ic);
}

/* 文档 doc */
.m-icon-doc::before {
  content: ''; position: absolute; left: 7rpx; top: 3rpx;
  width: 22rpx; height: 30rpx; box-sizing: border-box;
  border: 4rpx solid var(--ic); border-radius: 4rpx;
}
.m-icon-doc::after {
  content: ''; position: absolute; left: 12rpx; top: 13rpx;
  width: 12rpx; height: 3rpx; background: var(--ic);
  box-shadow: 0 7rpx 0 var(--ic);
}

/* 盾牌 shield */
.m-icon-shield::before {
  content: ''; position: absolute; left: 7rpx; top: 4rpx;
  width: 22rpx; height: 22rpx; box-sizing: border-box;
  border: 4rpx solid var(--ic); border-radius: 4rpx 4rpx 50% 50%;
}
.m-icon-shield::after {
  content: ''; position: absolute; left: 16rpx; top: 9rpx;
  width: 4rpx; height: 12rpx; background: var(--ic); border-radius: 2rpx;
}

/* 切换 swap */
.m-icon-swap::before {
  content: ''; position: absolute; left: 5rpx; top: 11rpx;
  width: 26rpx; height: 3rpx; background: var(--ic);
  box-shadow: 0 8rpx 0 var(--ic);
}
.m-icon-swap::after {
  content: ''; position: absolute; left: 24rpx; top: 7rpx;
  width: 10rpx; height: 10rpx; border-right: 3rpx solid var(--ic); border-top: 3rpx solid var(--ic);
  transform: rotate(45deg);
}

/* 信息 info */
.m-icon-info {
  width: 30rpx; height: 30rpx; margin: 3rpx;
  border: 4rpx solid var(--ic); border-radius: 50%; box-sizing: border-box;
}
.m-icon-info::after {
  content: ''; position: absolute; left: 11rpx; top: 8rpx;
  width: 4rpx; height: 4rpx; background: var(--ic); border-radius: 50%;
  box-shadow: 0 6rpx 0 var(--ic), 0 11rpx 0 var(--ic);
}

.menu-label {
  flex: 1;
  font-size: var(--font-md);
  color: var(--text-primary);
  font-weight: var(--weight-medium);
}

.menu-arrow {
  font-size: var(--font-lg);
  color: var(--text-muted);
  flex-shrink: 0;
}

/* 版本行 */
.version-row {
  display: flex;
  align-items: center;
  padding: 18rpx 28rpx;
  gap: 16rpx;
  border-top: 1rpx solid #f3f4f6;
}

.version-label {
  font-size: var(--font-sm);
  color: var(--text-muted);
  font-weight: var(--weight-normal);
}

.version-text {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

/* ===== 退出登录 ===== */
.logout-btn {
  background: rgba(255, 255, 255, 0.92);
  border-radius: var(--radius-md);
  color: var(--text-error);
  font-size: var(--font-md);
  text-align: center;
  padding: 28rpx;
  font-weight: var(--weight-medium);
  box-shadow: var(--shadow-md), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
}

.logout-btn:active { opacity: 0.85; }

/* ===== H5 同步：内容卡片与美甲师信息层级 ===== */
.content-area {
  padding: 28rpx 32rpx calc(160rpx + env(safe-area-inset-bottom));
  gap: 24rpx;
}

/* ===== 身份切换卡片 ===== */
.role-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.role-card:active { opacity: 0.92; }

.role-card-left {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  flex: 1;
  min-width: 0;
}

.role-card-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--card-radius);
  background: #fff0f5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.role-card-badge-icon {
  width: 36rpx;
  height: 36rpx;
}

.role-card-info {
  flex: 1;
  min-width: 0;
}

.role-card-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.role-card-title {
  display: block;
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.role-card-sub {
  display: block;
  font-size: var(--font-xs);
  color: var(--text-muted);
}

.role-card-switch-btn {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  background: var(--text-primary);
  color: var(--text-inverse);
  border-radius: var(--radius-lg);
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
}

.role-card-switch-btn:active { opacity: 0.82; }

/* 游客标签 */
.role-card-tourist-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  background: #FFF7ED;
  border: 1rpx solid #FDBA74;
  border-radius: var(--radius-xs);
  font-size: var(--font-xs);
  color: #C2410C;
  font-weight: var(--weight-medium);
  flex-shrink: 0;
  margin-bottom: 4rpx;
}

.role-card-badge-tourist {
  background: #FFF7ED;
}

/* 角色切换底部面板 - 游客 */
.role-sheet-option-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.role-sheet-tourist-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  background: #FFF7ED;
  border: 1rpx solid #FDBA74;
  border-radius: var(--radius-xs);
  font-size: var(--font-xs);
  color: #C2410C;
  font-weight: var(--weight-medium);
}

.role-sheet-option-icon-tourist {
  background: #FFF7ED;
}

/* ===== 身份切换底部面板 ===== */
.role-sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
  display: flex;
  align-items: flex-end;
  animation: roleSheetFadeIn 0.24s ease-out;
}

@keyframes roleSheetFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.role-sheet {
  width: 100%;
  background: var(--bg-card);
  border-radius: 24rpx 24rpx 0 0;
  padding: var(--space-md) var(--space-lg) calc(var(--space-lg) + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  animation: roleSheetSlideUp 0.28s cubic-bezier(0.32, 0.72, 0, 1);
}

@keyframes roleSheetSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.role-sheet-handle {
  width: 72rpx;
  height: 8rpx;
  background: var(--border-default);
  border-radius: 4rpx;
  align-self: center;
  margin-bottom: var(--space-xs);
}

.role-sheet-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-black);
  color: var(--text-primary);
  text-align: center;
}

.role-sheet-sub {
  font-size: var(--font-sm);
  color: var(--text-faint);
  text-align: center;
  margin-bottom: var(--space-sm);
}

.role-sheet-option {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-md);
  border-radius: var(--radius-md);
  background: var(--bg-input);
}

.role-sheet-option-active {
  background: #fff0f5;
}

.role-sheet-option-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--card-radius);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.role-sheet-option-icon-img {
  width: 36rpx;
  height: 36rpx;
}

.role-sheet-option-icon-client {
  background: #fff0f5;
}

.role-sheet-option-icon-tech {
  background: #f5f3ff;
}

.role-sheet-option-info {
  flex: 1;
  min-width: 0;
}

.role-sheet-option-title {
  display: block;
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.role-sheet-option-desc {
  display: block;
  font-size: var(--font-xs);
  color: var(--text-muted);
}

.role-sheet-check {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
}

.role-sheet-check-img {
  width: 48rpx;
  height: 48rpx;
}

.role-sheet-arrow {
  font-size: var(--font-xl);
  color: var(--text-faint);
  flex-shrink: 0;
}

.role-sheet-cancel {
  text-align: center;
  padding: var(--space-md);
  font-size: var(--font-md);
  color: var(--text-muted);
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  margin-top: var(--space-xs);
}

.role-sheet-cancel:active { opacity: 0.7; }

/* ===== H5 同步：内容卡片与美甲师信息层级 ===== */
.section-card {
  border-radius: var(--radius-xl);
  background: rgba(255, 255, 255, 0.96);
  border-color: rgba(15, 23, 42, 0.05);
  box-shadow: 0 18rpx 48rpx rgba(15, 23, 42, 0.07);
}
.section-head { padding: 30rpx 32rpx 20rpx; }
.tech-section-head { padding: 32rpx 32rpx 24rpx; border-bottom: 0; }
.tech-section-card { overflow: visible; }
.tech-count-chip { background: #fff1f5; color: #d94f70; }
.bind-btn {
  min-height: 72rpx;
  padding: 0 22rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tech-body { padding: 0 20rpx 20rpx; }
.tech-card {
  display: block;
  position: relative;
  padding: 28rpx;
  margin-bottom: var(--space-sm);
  border-radius: var(--radius-lg);
  border-color: rgba(15, 23, 42, 0.05);
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.055);
}
.tech-card-default {
  background: linear-gradient(135deg, #fff3f6 0%, #ffffff 58%, #fafbff 100%);
  border-color: rgba(255,107,138,0.14) /* brand-primary-alpha */;
}
.tech-card-primary { display: flex; align-items: flex-start; gap: 12rpx; }
.tech-main { align-items: center; gap: 20rpx; }
.tech-avatar,
.tech-avatar-placeholder { width: 108rpx; height: 108rpx; border-radius: 30rpx; }
.tech-name { font-size: var(--font-lg); }
.default-badge {
  color: #d94f70;
  background: var(--bg-card);
  border: 1rpx solid rgba(255,107,138,0.18) /* brand-primary-alpha */;
  padding: 5rpx 14rpx;
  border-radius: var(--radius-sm);
}
.tech-city { margin-bottom: 12rpx; color: var(--text-muted); font-size: var(--font-sm); }
.city-icon { width: 12rpx; height: 12rpx; background: var(--brand-primary); }
.tech-tag { padding: 6rpx 14rpx; border-radius: var(--radius-sm); font-size: var(--font-xs); }
.tech-tag-shop { color: #6d5bd0; background: #f5f3ff; }
.tech-more-btn {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  margin: -16rpx -16rpx 0 0;
  border-radius: 50%;
}
.tech-more-btn:active { background: rgba(15, 23, 42, 0.05); }
.tech-more-dot { width: 7rpx; height: 7rpx; border-radius: 50%; background: #718096; }
.tech-menu-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: transparent;
}
.tech-more-menu {
  position: absolute;
  z-index: 31;
  top: 78rpx;
  right: 22rpx;
  width: 260rpx;
  padding: 10rpx;
  border-radius: var(--radius-md);
  background: var(--bg-card);
  border: 1rpx solid rgba(15, 23, 42, 0.07);
  box-shadow: 0 20rpx 56rpx rgba(15, 23, 42, 0.16);
}
.tech-menu-item {
  min-height: 80rpx;
  padding: 0 20rpx;
  border-radius: var(--card-radius);
  display: flex;
  align-items: center;
  gap: 18rpx;
  color: #2d3748;
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
}
.tech-menu-item:active { background: #f7f8fa; }
.tech-menu-divider { height: 1rpx; margin: 6rpx 12rpx; background: #edf0f4; }
.tech-menu-danger { color: #c2414f; }
.tech-menu-icon { width: 30rpx; height: 30rpx; flex-shrink: 0; position: relative; color: var(--text-muted); }
.tech-menu-icon-info { border: 2rpx solid currentColor; border-radius: 50%; box-sizing: border-box; }
.tech-menu-icon-info::before { content: ''; position: absolute; left: 12rpx; top: 7rpx; width: 3rpx; height: 3rpx; border-radius: 50%; background: currentColor; }
.tech-menu-icon-info::after { content: ''; position: absolute; left: 12rpx; top: 13rpx; width: 3rpx; height: 9rpx; border-radius: 2rpx; background: currentColor; }
.tech-menu-icon-message { border: 2rpx solid currentColor; border-radius: 8rpx; box-sizing: border-box; }
.tech-menu-icon-message::after { content: ''; position: absolute; left: 4rpx; bottom: -6rpx; width: 8rpx; height: 8rpx; border-left: 2rpx solid currentColor; transform: skewY(-35deg); }
.tech-menu-icon-unbind { color: #c2414f; }
.tech-menu-icon-unbind::before,
.tech-menu-icon-unbind::after { content: ''; position: absolute; left: 14rpx; top: 2rpx; width: 2rpx; height: 26rpx; border-radius: 2rpx; background: currentColor; transform: rotate(45deg); }
.tech-menu-icon-unbind::after { transform: rotate(-45deg); }
.menu-list { padding: 8rpx 16rpx 16rpx; }
.menu-item { min-height: 104rpx; padding: 12rpx 16rpx; border-radius: var(--radius-md); }
.logout-btn { border-radius: var(--radius-lg); box-shadow: 0 16rpx 42rpx rgba(15, 23, 42, 0.07); }

/* ===== 绑定弹窗 ===== */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.modal-content {
  width: 100%;
  background: var(--bg-card);
  border-radius: var(--radius-md) 24rpx 0 0;
  padding: 36rpx 40rpx calc(36rpx + env(safe-area-inset-bottom));
  max-height: 78dvh;
  overflow-y: auto;
  box-shadow: 0 -4rpx 24rpx rgba(15, 23, 42, 0.06);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.modal-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  background: var(--bg-input);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-md);
  color: var(--text-muted);
}

.modal-close:active { background: #e5e7eb; }

.modal-body { margin-bottom: 32rpx; }

.field-label {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
  margin-bottom: 12rpx;
}

.code-input-wrap {
  position: relative;
  margin-bottom: 12rpx;
}

.code-input {
  width: 100%;
  height: 96rpx;
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  padding: 0 28rpx;
  font-size: var(--font-md);
  color: var(--text-primary);
  box-sizing: border-box;
}

.code-placeholder { color: var(--text-muted); }

.code-spinner {
  position: absolute;
  right: 24rpx;
  top: 50%;
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid var(--brand-primary);
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  transform: translateY(-50%);
}

@keyframes spin {
  from { transform: translateY(-50%) rotate(0deg); }
  to   { transform: translateY(-50%) rotate(360deg); }
}

.field-hint {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
  line-height: 1.6;
}

.bind-note-input {
  width: 100%;
  min-height: 120rpx;
  margin-top: var(--space-md);
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  padding: 20rpx 28rpx;
  font-size: var(--font-md);
  color: var(--text-primary);
  box-sizing: border-box;
}

.found-tech {
  display: flex;
  align-items: center;
  background: #fff1f5;
  border-radius: var(--radius-sm);
  padding: var(--space-md);
  gap: 20rpx;
  margin-top: var(--space-md);
}

.found-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.found-avatar-img { width: 100%; height: 100%; }

.found-avatar-char {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--brand-primary);
}

.found-info { flex: 1; }

.found-name {
  display: block;
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.found-city {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
}

.modal-btn {
  background: var(--brand-gradient);
  color: var(--text-inverse);
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  text-align: center;
  padding: 28rpx;
  border-radius: var(--radius-md);
  box-shadow: 0 8rpx 24rpx rgba(255,107,138,0.25) /* brand-primary-alpha */;
}

.modal-btn:active { opacity: 0.85; }
.modal-btn-disabled { opacity: 0.45; }

.modal-btn-group {
  display: flex;
  gap: 24rpx;
}

.modal-btn-group .modal-btn {
  flex: 1;
}

.modal-btn-group-vertical {
  flex-direction: column;
}

.modal-btn-secondary {
  background: var(--bg-input);
  color: var(--text-primary);
  box-shadow: none;
}

.modal-btn-secondary:active { opacity: 0.75; }

.confirm-text {
  display: block;
  font-size: var(--font-md);
  color: var(--text-primary);
  line-height: 1.7;
  text-align: center;
  padding: 24rpx 12rpx;
}
