.container {
  min-height: 100vh;
  background: #f8f9fc;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ===== 头部 ===== */
.header {
  position: relative;
  overflow: hidden;
  padding: 60rpx 40rpx 48rpx;
}

.header::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, #FFF5F7 0%, #f8f9fc 100%);
}

.header-card {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: rgba(255,255,255,0.88);
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(0,0,0,0.04);
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
}

.header-card:active {
  transform: scale(0.99);
}

.avatar-wrap {
  flex-shrink: 0;
}

.avatar {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(0,0,0,0.06);
}

.avatar-placeholder {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFE0EA, #F4F7FB);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(0,0,0,0.06);
}

.avatar-char {
  font-size: 52rpx;
  font-weight: 700;
  color: #FF6B8A;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-label {
  display: block;
  font-size: 20rpx;
  text-transform: uppercase;
  letter-spacing: 5rpx;
  color: #9ca3af;
  margin-bottom: 4rpx;
}

.nickname {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 6rpx;
  letter-spacing: -1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.phone {
  display: block;
  font-size: 26rpx;
  color: #4b5563;
  margin-bottom: 4rpx;
}

.edit-hint {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
}

.header-arrow {
  font-size: 36rpx;
  color: #d1d5db;
  flex-shrink: 0;
}

/* ===== 分区 ===== */
.section {
  padding: 0 40rpx;
  margin-top: 24rpx;
}

.section-neg {
  margin-top: -16rpx;
}

.section-card {
  background: rgba(255,255,255,0.88);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
}

.section-card-menu {
  padding: 16rpx;
}

.section-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.section-header-menu {
  padding: 8rpx 16rpx 8rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2937;
  display: block;
  letter-spacing: -0.5rpx;
}

.section-sub {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 6rpx;
  display: block;
}

.bind-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #FF6B8A;
  background: #fff1f5;
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  font-weight: 500;
  white-space: nowrap;
}

/* ===== 无美甲师 ===== */
.no-tech {
  background: #f9fafb;
  border-radius: 24rpx;
  padding: 40rpx;
  text-align: center;
}

.no-tech-text {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.no-tech-hint {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 24rpx;
}

.bind-now-btn {
  display: inline-block;
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
  padding: 16rpx 48rpx;
  border-radius: 24rpx;
}

.bind-now-btn:active {
  opacity: 0.85;
}

/* ===== 美甲师卡片 ===== */
.tech-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  background: rgba(255,255,255,0.78);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  border: 1rpx solid rgba(0,0,0,0.03);
}

.tech-card:last-child {
  margin-bottom: 0;
}

.tech-card-default {
  background: linear-gradient(135deg, #FFF0F5 0%, #FAFBFF 100%);
  border-color: rgba(255,107,138,0.10);
}

.tech-main {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.tech-avatar-wrap {
  flex-shrink: 0;
}

.tech-avatar,
.tech-avatar-placeholder {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
}

.tech-avatar-placeholder {
  background: linear-gradient(135deg, #FFE0EA, #F4F7FB);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #FF6B8A;
}

.tech-info {
  flex: 1;
  min-width: 0;
}

.tech-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.tech-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.default-badge {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #fff;
  background: #FF6B8A;
  padding: 4rpx 16rpx;
  border-radius: 14rpx;
  font-weight: 500;
}

.tech-city {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 10rpx;
}

.city-icon {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF0F3 0%, #F5F3FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.city-icon::after {
  content: '';
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B8A, #A78BFA);
}

.tech-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tech-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #6b7280;
  background: #f9fafb;
  padding: 4rpx 16rpx;
  border-radius: 14rpx;
}

.tech-tag-pink {
  color: #FF6B8A;
  background: #fff1f5;
}

.tech-tag-active {
  color: #16a34a;
  background: #ecfdf5;
}

.tech-tag-rest {
  color: #9ca3af;
  background: #f3f4f6;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.status-dot-active {
  background: #22c55e;
}

.status-dot-rest {
  background: #9ca3af;
}

.tech-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

.tech-eye-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #fff1f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
  position: relative;
}

.tech-eye-btn::after {
  content: '';
  width: 20rpx;
  height: 12rpx;
  border: 3rpx solid #FF6B8A;
  border-radius: 50%;
}

.tech-eye-btn:active {
  background: #ffe0ea;
}

.tech-action-btn {
  font-size: 22rpx;
  color: #FF6B8A;
  border: 1rpx solid #FF6B8A;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  text-align: center;
  white-space: nowrap;
}

.tech-action-btn:active {
  background: #fff1f5;
}

.tech-action-unbind {
  color: #9ca3af;
  border-color: #e5e7eb;
}

.tech-action-unbind:active {
  background: #f9fafb;
}

/* ===== 菜单列表 ===== */
.menu-list {
  padding: 4rpx 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: 24rpx;
  gap: 16rpx;
}

.menu-item:active {
  background: #f9fafb;
}

.menu-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: #f8f9fc;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF0F3 0%, #F5F3FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-icon::after {
  content: '';
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B8A, #A78BFA);
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
}

.menu-arrow {
  font-size: 32rpx;
  color: #d1d5db;
  flex-shrink: 0;
}

/* ===== 版本行 ===== */
.version-row {
  display: flex;
  align-items: center;
  padding: 16rpx;
  gap: 16rpx;
}

.version-text {
  font-size: 26rpx;
  color: #9ca3af;
}

/* ===== 退出 ===== */
.logout-btn {
  background: rgba(255,255,255,0.92);
  border-radius: 24rpx;
  color: #dc2626;
  font-size: 30rpx;
  text-align: center;
  padding: 28rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
}

.logout-btn:active {
  transform: scale(0.98);
}

/* ===== 绑定弹窗 ===== */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.55);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.modal-content {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 36rpx 40rpx;
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
  max-height: 78dvh;
  overflow-y: auto;
  box-shadow: 0 -4rpx 24rpx rgba(15, 23, 42, 0.06);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  background: #f3f4f6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #6b7280;
}

.modal-body {
  margin-bottom: 32rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}

.code-input-wrap {
  position: relative;
  margin-bottom: 12rpx;
}

.code-input {
  width: 100%;
  height: 96rpx;
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #1f2937;
  box-sizing: border-box;
}

.code-placeholder {
  color: #d1d5db;
}

.code-spinner {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid #FF6B8A;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.field-hint {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
}

.found-tech {
  display: flex;
  align-items: center;
  background: #fff1f5;
  border-radius: 16rpx;
  padding: 24rpx;
  gap: 20rpx;
  margin-top: 24rpx;
}

.found-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.found-avatar-img {
  width: 100%;
  height: 100%;
}

.found-avatar-char {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF6B8A;
}

.found-info {
  flex: 1;
}

.found-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 4rpx;
}

.found-city {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
}

.modal-btn {
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  padding: 28rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
}

.modal-btn:active {
  opacity: 0.85;
}

.modal-btn-disabled {
  opacity: 0.5;
}
