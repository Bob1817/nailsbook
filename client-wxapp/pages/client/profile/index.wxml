<view class="page">

  <!-- ===== 顶部个人信息区：白底铺到屏幕顶端与导航栏连成一体，内容自胶囊按钮下方开始 ===== -->
  <view class="profile-top" style="padding-top: {{navBarHeight}}px;">
    <view class="page-hero" bindtap="editProfile">
      <view class="hero-left">
        <button class="hero-avatar-wrap" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" catchtap="preventBubble" aria-label="更换头像，支持 JPG、PNG、WebP，最大5MB">
          <image wx:if="{{avatar}}" src="{{avatar}}" mode="aspectFill" class="hero-avatar" aria-label="我的头像"/>
          <view wx:else class="hero-avatar-ph">
            <image class="hero-default-icon" src="/static/icons/tab-profile.svg" mode="aspectFit" />
            <image class="hero-camera-icon" src="/static/icons/camera.svg" mode="aspectFit" />
          </view>
          <view wx:if="{{avatarUploading}}" class="hero-uploading">上传中</view>
        </button>
        <view class="hero-info">
          <view class="hero-name-row">
            <text class="hero-name">{{nickname}}</text>
          </view>
          <text class="hero-phone">{{phone}}</text>
        </view>
      </view>
      <view class="hero-edit">
        <text class="hero-edit-text">编辑资料</text>
        <text class="hero-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- ===== 可滚动内容 ===== -->
  <scroll-view class="content-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="content-area">

      <!-- 美甲师轮播卡片：直接在头像下方展示 -->
      <view wx:if="{{visibleCount}}" class="tech-carousel-section {{visibleCount === 1 ? 'tech-carousel-section-single' : ''}}">
        <!-- 左滑提示箭头 -->
        <view wx:if="{{visibleCount > 1 && carouselIndex > 0}}" class="tech-carousel-arrow tech-carousel-arrow-left" bindtap="carouselPrev" aria-label="上一位美甲师">
          <text class="tech-carousel-arrow-icon">‹</text>
        </view>
        <scroll-view class="tech-carousel" scroll-x enhanced show-scrollbar="{{false}}" bindscroll="onCarouselScroll" scroll-into-view="{{carouselScrollTarget}}">
          <view class="tech-carousel-track">
            <view wx:for="{{previewTechnicians}}" wx:key="id" id="carousel-{{item.id}}" class="tech-carousel-card {{visibleCount === 1 ? 'tech-carousel-card-single' : ''}}">
              <view class="tech-carousel-head">
                <view class="tech-carousel-head-left" bindtap="viewTechnicianHome" data-id="{{item.id}}" role="button" aria-label="进入{{item.name}}主页">
                  <image class="tech-carousel-avatar" src="{{item.avatar || '/static/icons/technician.svg'}}" mode="aspectFill"/>
                  <view class="tech-carousel-info">
                    <view class="tech-carousel-name-row">
                      <text class="tech-carousel-name">{{item.name}}</text>
                      <text wx:if="{{item.isDefault}}" class="tech-default-mark">默认</text>
                      <view class="tech-carousel-home-link"><text class="tech-carousel-home-text">进入主页</text><text class="tech-carousel-home-arrow">›</text></view>
                    </view>
                    <text wx:if="{{item.shopName}}" class="tech-carousel-shop">{{item.shopName}}</text>
                    <view class="tech-carousel-status-row">
                      <view class="tech-carousel-dot tech-dot-{{item.statusTone}}"></view>
                      <text class="tech-carousel-status tech-status-{{item.statusTone}}">{{item.statusLabel}}</text>
                    </view>
                  </view>
                </view>
                <button size="mini" class="tech-carousel-book booking-action" catchtap="quickBookTechnician" data-id="{{item.id}}" data-can-book="{{item.canBook}}" disabled="{{!item.canBook}}" aria-label="向{{item.name}}发起预约">发起预约</button>
              </view>
              <view class="tech-carousel-relationship">
                <view class="tech-carousel-rel-item"><text class="tech-carousel-rel-value">{{item.relationship.visitsText}}</text><text class="tech-carousel-rel-label">次消费</text></view>
                <view class="tech-carousel-rel-divider"></view>
                <view class="tech-carousel-rel-item"><text class="tech-carousel-rel-value tech-carousel-rel-money">{{item.relationship.lifetimeSpendText}}</text><text class="tech-carousel-rel-label">累计实付</text></view>
                <view class="tech-carousel-rel-divider"></view>
                <view class="tech-carousel-rel-item"><text class="tech-carousel-rel-value">{{item.relationship.lastServiceText}}</text><text class="tech-carousel-rel-label">上次服务</text></view>
              </view>
              <view wx:if="{{privateNotes[item.id]}}" class="tech-carousel-note">
                <text class="tech-carousel-note-label">备注</text>
                <text class="tech-carousel-note-text">{{privateNotes[item.id]}}</text>
              </view>
            </view>
          </view>
        </scroll-view>
        <!-- 右滑提示箭头 -->
        <view wx:if="{{visibleCount > 1 && carouselIndex < visibleCount - 1}}" class="tech-carousel-arrow tech-carousel-arrow-right" bindtap="carouselNext" aria-label="下一位美甲师">
          <text class="tech-carousel-arrow-icon">›</text>
        </view>
        <!-- 指示器 -->
        <view wx:if="{{visibleCount > 1}}" class="tech-carousel-dots" aria-label="左右滑动查看更多美甲师">
          <view wx:for="{{previewTechnicians}}" wx:key="id" class="tech-carousel-dot-indicator {{carouselIndex === index ? 'tech-carousel-dot-active' : ''}}"></view>
        </view>
      </view>

      <!-- 我的服务 -->
      <view class="section-card">
        <view class="section-head">
          <view class="section-head-copy">
            <text class="section-title">我的服务</text>
            <text class="section-sub">管理预约、设计与服务沟通</text>
          </view>
        </view>
        <view class="menu-list">
          <view class="menu-item" bindtap="manageTechnicians">
            <view class="menu-icon-wrap menu-icon-pink"><image class="m-icon" src="/static/icons/technician.svg" mode="aspectFit" /></view>
            <text class="menu-label">我的美甲师</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item" bindtap="navigateToOrders">
            <view class="menu-icon-wrap menu-icon-pink"><image class="m-icon" src="/static/icons/document.svg" mode="aspectFit" /></view>
            <text class="menu-label">我的订单</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item" bindtap="navigateToArchive">
            <view class="menu-icon-wrap menu-icon-pink"><image class="m-icon" src="/static/icons/image.svg" mode="aspectFit" /></view>
            <text class="menu-label">我的美甲记录</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item" bindtap="navigateToDesigns">
            <view class="menu-icon-wrap menu-icon-pink"><image class="m-icon" src="/static/icons/edit.svg" mode="aspectFit" /></view>
            <text class="menu-label">我的设计</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item" bindtap="navigateToFavorites">
            <view class="menu-icon-wrap menu-icon-pink"><image class="m-icon" src="/static/icons/bookmark.svg" mode="aspectFit" /></view>
            <text class="menu-label">我的收藏</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item" bindtap="navigateToLikes">
            <view class="menu-icon-wrap menu-icon-pink"><image class="m-icon" src="/static/icons/social-heart.svg" mode="aspectFit" /></view>
            <text class="menu-label">我的点赞</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item" bindtap="navigateToFeedback">
            <view class="menu-icon-wrap menu-icon-pink"><image class="m-icon" src="/static/icons/tab-chat.svg" mode="aspectFit" /></view>
            <text class="menu-label">问题反馈</text>
            <text class="menu-arrow">›</text>
          </view>
        </view>
      </view>

      <!-- 账户信息 -->
      <view class="section-card">
        <view class="section-head">
          <view class="section-head-copy">
            <text class="section-title">账户信息</text>
            <text class="section-sub">管理个人资料、登录身份与账户安全</text>
          </view>
        </view>
        <view class="menu-list">
          <view class="menu-item" bindtap="navigateToPassword">
            <view class="menu-icon-wrap menu-icon-purple"><image class="m-icon" src="/static/icons/lock.svg" mode="aspectFit" /></view>
            <text class="menu-label">修改密码</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item" bindtap="navigateToManual">
            <view class="menu-icon-wrap menu-icon-purple"><image class="m-icon" src="/static/icons/book.svg" mode="aspectFit" /></view>
            <text class="menu-label">使用手册</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item" bindtap="openAgreement" data-type="user">
            <view class="menu-icon-wrap menu-icon-purple"><image class="m-icon" src="/static/icons/document.svg" mode="aspectFit" /></view>
            <text class="menu-label">用户协议</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item" bindtap="openAgreement" data-type="privacy">
            <view class="menu-icon-wrap menu-icon-purple"><image class="m-icon" src="/static/icons/shield.svg" mode="aspectFit" /></view>
            <text class="menu-label">隐私政策</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item" bindtap="requestAccountDeletion">
            <view class="menu-icon-wrap menu-icon-purple"><image class="m-icon" src="/static/icons/document.svg" mode="aspectFit" /></view>
            <text class="menu-label">账号注销申请</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item" bindtap="switchRole">
            <view class="menu-icon-wrap menu-icon-purple"><image class="m-icon" src="/static/icons/switch.svg" mode="aspectFit" /></view>
            <text class="menu-label">切换角色</text>
            <text class="menu-value">当前：客户</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item" bindtap="switchAccount">
            <view class="menu-icon-wrap menu-icon-purple"><image class="m-icon" src="/static/icons/tab-profile.svg" mode="aspectFit" /></view>
            <text class="menu-label">切换账号</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item" bindtap="navigateToAbout">
            <view class="menu-icon-wrap menu-icon-purple"><image class="m-icon" src="/static/icons/info.svg" mode="aspectFit" /></view>
            <text class="menu-label">关于我们</text>
            <text class="menu-arrow">›</text>
          </view>
        </view>
        <view class="version-row">
          <view class="menu-icon-wrap menu-icon-gray"><image class="m-icon" src="/static/icons/info.svg" mode="aspectFit" /></view>
          <text class="menu-label version-label">版本</text>
          <text class="version-text">1.0.0</text>
        </view>
      </view>

      <view class="logout-btn" bindtap="logout" role="button" aria-label="退出登录">退出登录</view>

    </view>
  </scroll-view>
</view>

<!-- 客户 → 美甲师：确认切换弹窗 -->
<view wx:if="{{showSwitchConfirmModal}}" class="modal-mask" bindtap="closeSwitchConfirmModal">
  <view class="modal-content" catchtap="">
    <view class="modal-header">
      <text class="modal-title">切换身份</text>
      <view class="modal-close" bindtap="closeSwitchConfirmModal">&#x2715;</view>
    </view>
    <view class="modal-body">
      <text class="confirm-text">检测到该手机号已开通美甲师账户，是否切换到美甲师身份？</text>
    </view>
    <view class="modal-btn-group">
      <view class="modal-btn modal-btn-secondary" bindtap="closeSwitchConfirmModal">取消</view>
      <view class="modal-btn" bindtap="confirmSwitchToTechnician">
        <text>{{switchLoading ? '切换中...' : '确认切换'}}</text>
      </view>
    </view>
  </view>
</view>

<!-- 客户 → 美甲师：激活密钥弹窗 -->
<view wx:if="{{showActivateModal}}" class="modal-mask" bindtap="closeActivateModal">
  <view class="modal-content" catchtap="">
    <view class="modal-header">
      <text class="modal-title">开通美甲师账户</text>
      <view class="modal-close" bindtap="closeActivateModal">&#x2715;</view>
    </view>
    <view class="modal-body">
      <text class="field-label">激活密钥</text>
      <view class="code-input-wrap">
        <input
          class="code-input"
          value="{{activationKey}}"
          bindinput="onActivationKeyInput"
          placeholder="请输入超管分配的激活密钥"
          placeholder-class="code-placeholder" confirm-type="done" />
      </view>
      <text class="field-hint">输入激活密钥后即可开通美甲师账户，开通后可管理预约、服务客户并展示作品。</text>
    </view>
    <view class="modal-btn {{!activationKey || activating ? 'modal-btn-disabled' : ''}}" bindtap="activateTechnicianAccount">
      <text>{{activating ? '开通中...' : '立即开通'}}</text>
    </view>
  </view>
</view>

<!-- 美甲师 → 绑定/切换弹窗 -->
<view wx:if="{{showTechSwitchModal}}" class="modal-mask" bindtap="closeTechSwitchModal">
  <view class="modal-content" catchtap="">
    <view class="modal-header">
      <text class="modal-title">绑定美甲师或切换客户</text>
      <view class="modal-close" bindtap="closeTechSwitchModal">&#x2715;</view>
    </view>
    <view class="modal-body">
      <text class="field-label">邀请码 / 邀请链接</text>
      <view class="code-input-wrap">
        <input
          class="code-input"
          value="{{techSwitchInviteCode}}"
          bindinput="onTechSwitchInviteInput"
          placeholder="输入邀请码绑定美甲师"
          placeholder-class="code-placeholder" confirm-type="done" />
        <view wx:if="{{techSwitchCheckingCode}}" class="code-spinner"></view>
      </view>
      <text class="field-hint">输入美甲师邀请码，提交绑定申请，待其通过后即可将其设为专属美甲师。</text>

      <view wx:if="{{techSwitchFoundTech}}" class="found-tech">
        <view class="found-avatar" bindtap="viewTechnicianHome" data-id="{{techSwitchFoundTech.id}}" role="button" aria-label="查看{{techSwitchFoundTech.name || '美甲师'}}主页">
          <image wx:if="{{techSwitchFoundTech.avatarUrl}}" src="{{techSwitchFoundTech.avatarUrl}}" mode="aspectFill" class="found-avatar-img" aria-label="{{techSwitchFoundTech.name || '美甲师'}}的头像"/>
          <image wx:else src="/static/icons/technician.svg" mode="aspectFit" class="nb-default-avatar" aria-label="美甲师默认头像" />
        </view>
        <view class="found-info">
          <text class="found-name">{{techSwitchFoundTech.name}}</text>
          <text class="found-city">{{techSwitchFoundTech.city || '未知城市'}}</text>
        </view>
      </view>
    </view>

    <view class="modal-btn-group modal-btn-group-vertical">
      <view
        class="modal-btn {{!techSwitchFoundTech || techSwitchBinding ? 'modal-btn-disabled' : ''}}"
        bindtap="bindTechnicianFromTechSwitch"
      >
        <text>{{techSwitchBinding ? '申请中...' : '申请绑定'}}</text>
      </view>
      <view class="modal-btn modal-btn-secondary" bindtap="skipToClient">跳过，进入客户账户</view>
    </view>
  </view>
</view>

<tab-bar selected="profile" />
