<nav-bar title="我的"/>
<view class="page">

  <!-- ===== Hero 顶部 ===== -->
  <view class="page-hero" bindtap="editProfile">
    <view class="hero-left">
      <view class="hero-avatar-wrap">
        <image wx:if="{{avatar}}" src="{{avatar}}" mode="aspectFill" class="hero-avatar" aria-label="我的头像"/>
        <view wx:else class="hero-avatar-ph">
          <text class="hero-avatar-char">{{nickname[0] || '我'}}</text>
        </view>
      </view>
      <view class="hero-info">
        <text class="hero-label">PROFILE</text>
        <text class="hero-name">{{nickname}}</text>
        <text class="hero-phone">{{phone}}</text>
      </view>
    </view>
    <view class="hero-edit">
      <text class="hero-edit-text">编辑资料</text>
      <text class="hero-arrow">›</text>
    </view>
  </view>

  <!-- ===== 可滚动内容 ===== -->
  <scroll-view class="content-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="content-area">
      <view wx:if="{{activeTechMenuId !== null}}" class="tech-menu-mask" bindtap="closeTechMenu"></view>

      <!-- 我的美甲师 -->
      <view class="section-card tech-section-card">
        <view class="tech-section-head">
          <view class="tech-head-titles">
            <view class="tech-head-title-row">
              <text class="section-title">我的美甲师</text>
              <view wx:if="{{technicians.length > 0}}" class="tech-count-chip">{{technicians.length}}</view>
            </view>
            <text class="section-sub">查看已绑定的专属美甲师并管理服务对象</text>
          </view>
          <view class="bind-btn" bindtap="openBindModal">+ 绑定新美甲师</view>
        </view>
        <view class="tech-body">
          <view wx:if="{{technicians.length === 0}}" class="no-tech">
            <text class="no-tech-text">暂无绑定的美甲师</text>
            <text class="no-tech-hint">输入邀请码后，即可添加新的专属美甲师</text>
            <view class="bind-now-btn" bindtap="openBindModal">立即绑定</view>
          </view>
          <view
            wx:for="{{technicians}}"
            wx:key="id"
            class="tech-card {{item.isDefault ? 'tech-card-default' : ''}}"
          >
            <view class="tech-card-primary">
              <view class="tech-main">
                <view class="tech-avatar-wrap">
                  <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" class="tech-avatar" aria-label="{{item.name || '美甲师'}}的头像"/>
                  <view wx:else class="tech-avatar-placeholder"><text>{{item.name[0]}}</text></view>
                </view>
                <view class="tech-info">
                  <view class="tech-name-row">
                    <text class="tech-name">{{item.name}}</text>
                    <view wx:if="{{item.isDefault}}" class="default-badge">默认美甲师</view>
                  </view>
                  <view wx:if="{{item.city}}" class="tech-city">
                    <view class="city-icon"></view>
                    <text>服务城市 · {{item.city}}</text>
                  </view>
                  <view class="tech-tags">
                    <text wx:if="{{item.homeService}}" class="tech-tag tech-tag-pink">上门美甲</text>
                    <text wx:if="{{item.shopService}}" class="tech-tag tech-tag-shop">到店美甲</text>
                    <view class="tech-tag {{item.status === 'active' ? 'tech-tag-active' : 'tech-tag-rest'}}">
                      <view class="status-dot {{item.status === 'active' ? 'status-dot-active' : 'status-dot-rest'}}"></view>
                      <text>{{item.status === 'active' ? '接单中' : '休息中'}}</text>
                    </view>
                  </view>
                </view>
              </view>
              <view class="tech-more-btn" catchtap="toggleTechMenu" data-id="{{item.id}}" role="button" aria-label="更多操作">
                <view class="tech-more-dot"></view>
                <view class="tech-more-dot"></view>
                <view class="tech-more-dot"></view>
              </view>
            </view>
            <view wx:if="{{activeTechMenuId === item.id}}" class="tech-more-menu">
              <view class="tech-menu-item" catchtap="viewTechInfo" data-id="{{item.id}}">
                <view class="tech-menu-icon tech-menu-icon-info"></view><text>查看信息</text>
              </view>
              <view class="tech-menu-item" catchtap="messageTechnician" data-id="{{item.id}}" data-name="{{item.name}}">
                <view class="tech-menu-icon tech-menu-icon-message"></view><text>发送消息</text>
              </view>
              <view class="tech-menu-divider"></view>
              <view class="tech-menu-item tech-menu-danger" catchtap="unbindTechnician" data-id="{{item.id}}" data-name="{{item.name}}">
                <view class="tech-menu-icon tech-menu-icon-unbind"></view><text>解除绑定</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 我的服务 -->
      <view class="section-card">
        <view class="section-head">
          <text class="section-title">我的服务</text>
          <text class="section-sub">管理地址、预约、设计与服务沟通</text>
        </view>
        <view class="menu-list">
          <view class="menu-item" bindtap="navigateToAddresses">
            <view class="menu-icon-wrap menu-icon-pink"><view class="m-icon m-icon-pin"></view></view>
            <text class="menu-label">地址管理</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item" bindtap="navigateToDesigns">
            <view class="menu-icon-wrap menu-icon-pink"><view class="m-icon m-icon-design"></view></view>
            <text class="menu-label">我的设计</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item" bindtap="navigateToFavorites">
            <view class="menu-icon-wrap menu-icon-pink"><view class="m-icon m-icon-bookmark"></view></view>
            <text class="menu-label">我的收藏</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item" bindtap="navigateToLikes">
            <view class="menu-icon-wrap menu-icon-pink"><view class="m-icon m-icon-heart"></view></view>
            <text class="menu-label">我的点赞</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item" bindtap="navigateToReferrals">
            <view class="menu-icon-wrap menu-icon-pink"><view class="m-icon m-icon-heart"></view></view>
            <text class="menu-label">推荐好友</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item" bindtap="navigateToFeedback">
            <view class="menu-icon-wrap menu-icon-pink"><view class="m-icon m-icon-chat"></view></view>
            <text class="menu-label">问题反馈</text>
            <text class="menu-arrow">›</text>
          </view>
        </view>
      </view>

      <!-- 更多 -->
      <view class="section-card">
        <view class="section-head">
          <text class="section-title">更多</text>
          <text class="section-sub">账号设置、协议与版本信息</text>
        </view>
        <view class="menu-list">
          <view class="menu-item" bindtap="navigateToPassword">
            <view class="menu-icon-wrap menu-icon-purple"><view class="m-icon m-icon-lock"></view></view>
            <text class="menu-label">修改密码</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item" bindtap="navigateToManual">
            <view class="menu-icon-wrap menu-icon-purple"><view class="m-icon m-icon-book"></view></view>
            <text class="menu-label">使用手册 · 常见问题</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item" bindtap="openAgreement" data-type="user">
            <view class="menu-icon-wrap menu-icon-purple"><view class="m-icon m-icon-doc"></view></view>
            <text class="menu-label">用户协议</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item" bindtap="openAgreement" data-type="privacy">
            <view class="menu-icon-wrap menu-icon-purple"><view class="m-icon m-icon-shield"></view></view>
            <text class="menu-label">隐私政策</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item" bindtap="switchRole">
            <view class="menu-icon-wrap menu-icon-purple"><view class="m-icon m-icon-swap"></view></view>
            <text class="menu-label">切换身份</text>
            <text class="menu-arrow">›</text>
          </view>
        </view>
        <view class="version-row">
          <view class="menu-icon-wrap menu-icon-gray"><view class="m-icon m-icon-info"></view></view>
          <text class="menu-label version-label">版本</text>
          <text class="version-text">1.0.0</text>
        </view>
      </view>

      <!-- 退出登录 -->
      <view class="logout-btn" bindtap="logout">退出登录</view>

    </view>
  </scroll-view>
</view>

<!-- 绑定美甲师弹窗 -->
<view wx:if="{{showBindModal}}" class="modal-mask" bindtap="closeBindModal">
  <view class="modal-content" catchtap="">
    <view class="modal-header">
      <text class="modal-title">绑定美甲师</text>
      <view class="modal-close" bindtap="closeBindModal">&#x2715;</view>
    </view>

    <view class="modal-body">
      <text class="field-label">邀请码</text>
      <view class="code-input-wrap">
        <input
          class="code-input"
          value="{{inviteCode}}"
          bindinput="onInviteCodeInput"
          placeholder="请输入美甲师提供的邀请码"
          placeholder-class="code-placeholder"
        />
        <view wx:if="{{checkingCode}}" class="code-spinner"></view>
      </view>
      <text class="field-hint">输入美甲师邀请码，提交绑定申请，待其通过后生效</text>

      <view wx:if="{{foundTech}}" class="found-tech">
        <view class="found-avatar">
          <image wx:if="{{foundTech.avatarUrl}}" src="{{foundTech.avatarUrl}}" mode="aspectFill" class="found-avatar-img" aria-label="{{foundTech.name || '美甲师'}}的头像"/>
          <text wx:else class="found-avatar-char">{{foundTech.name[0]}}</text>
        </view>
        <view class="found-info">
          <text class="found-name">{{foundTech.name}}</text>
          <text class="found-city">{{foundTech.city || '未知城市'}}</text>
        </view>
      </view>

      <textarea
        wx:if="{{foundTech}}"
        class="bind-note-input"
        value="{{bindNote}}"
        bindinput="onBindNoteInput"
        placeholder="给美甲师留言（可选，如：我是老顾客小红）"
        maxlength="100"
      />
    </view>

    <view
      class="modal-btn {{!foundTech || binding ? 'modal-btn-disabled' : ''}}"
      bindtap="bindTechnician"
    >
      <text>{{binding ? '申请中...' : '申请绑定'}}</text>
    </view>
  </view>
</view>

<tab-bar selected="profile"/>
