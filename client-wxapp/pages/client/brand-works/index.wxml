<nav-bar title="全部作品" showBack/><view class="page"><view wx:if="{{loading}}" class="grid"><view wx:for="{{[1,2,3,4]}}" wx:key="*this" class="skeleton"></view></view><view wx:elif="{{error}}" class="state"><text>作品暂时无法加载</text><button class="booking-action" bindtap="load">重新加载</button></view><view wx:elif="{{!items.length}}" class="state">暂无公开作品</view><view wx:else class="grid"><view wx:for="{{items}}" wx:key="id" class="card" bindtap="view" data-id="{{item.id}}"><image class="image" src="{{item.coverUrl}}" mode="aspectFill" lazy-load aria-label="{{item.title}}"/><text class="name">{{item.title||'美甲作品'}}</text><text class="meta">{{item.style||item.color||'查看案例'}}</text></view></view></view>
