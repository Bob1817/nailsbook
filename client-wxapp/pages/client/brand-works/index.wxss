page{background:#f7f7f7;color:#222}.page{min-height:100vh;padding:24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));box-sizing:border-box}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.card{min-width:0;padding-bottom:18rpx;border:1rpx solid #ddd;border-radius:22rpx;background:#fff;overflow:hidden}.image{width:100%;height:390rpx;display:block;background:#eee}.name,.meta{display:block;margin:14rpx 18rpx 0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.name{font-size:27rpx;font-weight:700}.meta{margin-top:5rpx;color:#6a6a6a;font-size:22rpx}.state{min-height:70vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20rpx;color:#6a6a6a}.state button{min-height:88rpx;padding:0 38rpx;border:2rpx solid #222;border-radius:44rpx;background:#fff}.skeleton{height:470rpx;border-radius:22rpx;background:linear-gradient(90deg,#eee,#fafafa,#eee);background-size:400% 100%;animation:shine 1.3s infinite}@keyframes shine{to{background-position:-100% 0}}
