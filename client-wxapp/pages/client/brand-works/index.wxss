page{background:var(--nb-page);color:var(--nb-ink)}.page{min-height:100vh;padding:24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));box-sizing:border-box}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.card{min-width:0;padding-bottom:18rpx;border: 0;border-radius:22rpx;background:var(--nb-surface);overflow:hidden}.image{width:100%;height:390rpx;display:block;background:var(--nb-page)}.name,.meta{display:block;margin:14rpx 18rpx 0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.name{font-size:27rpx;font-weight:700}.meta{margin-top:5rpx;color:var(--nb-secondary);font-size:22rpx}.state{min-height:70vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20rpx;color:var(--nb-secondary)}.state button{min-height:88rpx;padding:0 38rpx;border: 0;border-radius:44rpx;background:var(--nb-surface)}.skeleton{height:470rpx;border-radius:22rpx;background:var(--nb-page);background-size:400% 100%;animation:shine 1.3s infinite}@keyframes shine{to{background-position:-100% 0}}
@import '../../../styles/booking-actions.wxss';
.state button.booking-action { min-height:44px; height:44px; padding:0 24rpx; border-radius:8px; font-size:var(--font-sm); line-height:1.4; }
