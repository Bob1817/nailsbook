@import '../../../styles/booking-actions.wxss';

.page{min-height:100vh;background:var(--nb-page);padding:20vh 28rpx 40rpx}.card{background:var(--nb-surface);border-radius:28rpx;padding:40rpx;text-align:center}.mark{display:block;margin:auto;width:96rpx;height:96rpx;line-height:96rpx;border-radius:50%;background:var(--nb-page);color:var(--nb-ink);font-size:52rpx}.title{display:block;margin-top:28rpx;font-size:40rpx;font-weight:700}.copy{display:block;margin-top:18rpx;color:var(--nb-secondary);line-height:1.7}.notice{margin-top:24rpx;padding:22rpx;border-radius:16rpx;background:var(--nb-page);color:var(--nb-ink)}.primary,.secondary{min-height:96rpx;margin-top:28rpx;border-radius:48rpx}.primary{background:var(--nb-ink);color:var(--nb-surface)}.secondary{background:var(--nb-page)}.primary::after,.secondary::after{border:0}
