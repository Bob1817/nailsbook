.page{min-height:100vh;background:#f7f5f2;padding:20vh 28rpx 40rpx}.card{background:#fff;border-radius:28rpx;padding:40rpx;text-align:center}.mark{display:block;margin:auto;width:96rpx;height:96rpx;line-height:96rpx;border-radius:50%;background:#e7f5ec;color:#348657;font-size:52rpx}.title{display:block;margin-top:28rpx;font-size:40rpx;font-weight:700}.copy{display:block;margin-top:18rpx;color:#716864;line-height:1.7}.notice{margin-top:24rpx;padding:22rpx;border-radius:16rpx;background:#fff4e5;color:#8a5b18}.primary,.secondary{min-height:96rpx;margin-top:28rpx;border-radius:48rpx}.primary{background:#211b18;color:#fff}.secondary{background:#f7f5f2}.primary::after,.secondary::after{border:0}
