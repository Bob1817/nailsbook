@import '../../../styles/booking-actions.wxss';

.page{min-height:100vh;background:var(--nb-page);padding:20vh 28rpx var(--space-xl)}.card{background:var(--nb-surface);border-radius:var(--radius-lg);padding:var(--space-xl);text-align:center}.mark{display:flex;align-items:center;justify-content:center;margin:auto;width:96rpx;height:96rpx;border-radius:50%;background:var(--nb-action);}.mark-icon{width:48rpx;height:48rpx;}.title{display:block;margin-top:28rpx;font-size:var(--font-xl);font-weight:700}.copy{display:block;margin-top:18rpx;color:var(--nb-secondary);line-height:1.7}.notice{margin-top:var(--space-md);padding:22rpx;border-radius:16rpx;background:var(--nb-page);color:var(--nb-ink)}.primary,.secondary{min-height:96rpx;margin-top:28rpx;border-radius:var(--radius-pill)}.primary{background:var(--nb-ink);color:var(--nb-surface)}.secondary{background:var(--nb-page)}.primary::after,.secondary::after{border:0}
