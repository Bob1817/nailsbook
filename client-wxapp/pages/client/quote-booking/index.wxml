<nav-bar title="选择预约时间" showBack/>
<view class="page">
  <view wx:if="{{loading}}" class="state">正在准备预约信息…</view>
  <view wx:elif="{{error}}" class="state error"><text>{{error}}</text><button bindtap="load">重新加载</button><text class="state-exit" hover-class="link-pressed" bindtap="goHome">进入小程序首页 ›</text></view>
  <block wx:else>
    <view class="quote-summary"><text class="summary-eyebrow">已确认 OnlyNail 报价</text><text class="summary-title">{{quote.technicianName}} · {{quote.shopName || '美甲工作室'}}</text><view class="summary-lines"><view wx:for="{{quote.lines}}" wx:key="id" class="summary-line"><text>{{item.nameSnapshot}} × {{item.quantity}}</text><text>¥{{item.subtotalFen / 100}}</text></view></view><view class="summary-row"><text>客户</text><text>{{client ? client.displayName : '授权登录后自动带入'}}</text></view><text class="summary-total">¥{{quote.finalPriceFen / 100}} · 预计 {{quote.totalDurationMinutes}} 分钟</text></view>
    <view class="time-card"><view class="heading"><text>选择日期和时间</text><text>项目、店铺和价格已由报价单带入</text></view><booking-time-picker horizontal tech-id="{{quote.technicianId}}" service-date="{{serviceDate}}" start-time="{{startTime}}" service-type="shop" shop-name="{{quote.shopName}}" duration-minutes="{{quote.totalDurationMinutes}}" bindchange="onBookingTimeChange"/></view>
    <view class="home-exit"><text class="state-exit" hover-class="link-pressed" bindtap="goHome">进入小程序首页 ›</text></view>
  </block>
</view>
<view wx:if="{{quote}}" class="submit-bar"><button class="primary" bindtap="submit" loading="{{submitting}}" disabled="{{!startTime || submitting}}">确认预约</button></view>
