.container {
  min-height: 100vh;
  background: #f8f9fc;
  padding: 100rpx 48rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo-circle {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  border-radius: 36rpx;
  color: #fff;
  font-size: 56rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1f2937;
}

.login-tabs { display: flex; padding: 8rpx; margin-bottom: 32rpx; border-radius: 18rpx; background: #eef0f4; }
.login-tab { flex: 1; min-height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 14rpx; color: #6b7280; font-size: 27rpx; }
.login-tab-active { color: #1f2937; background: #fff; font-weight: 600; box-shadow: 0 4rpx 14rpx rgba(31, 41, 55, 0.08); }
.wechat-hint { display: block; color: #6b7280; font-size: 25rpx; line-height: 1.6; text-align: center; }

.form-item {
  margin-bottom: 32rpx;
}

.label {
  font-size: 26rpx;
  color: #374151;
  display: block;
  margin-bottom: 12rpx;
}

.input  {
  width: 100%;
  height: 96rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: #1f2937;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: border-color 180ms ease, background-color 180ms ease;
}
.input:focus { border-color:#ff6b8a; background:#fff; }

.readonly {
  width: 100%;
  height: 96rpx;
  background: #f0f0f0;
  border-radius: 14rpx;
  padding: 0 32rpx;
  font-size: 30rpx;
  color: #6b7280;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.readonly-phone {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.readonly-action {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #ff6b8a;
  margin-left: 16rpx;
}

.hint-banner {
  background: #fff7e6;
  color: #fa8c16;
  font-size: 26rpx;
  padding: 20rpx 40rpx;
  border-radius: 14rpx;
  margin-bottom: 32rpx;
  line-height: 1.5;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 48rpx;
}
.btn-primary[disabled] {
  background-color: #6b7280;
}

.link {
  display:inline-flex;
  min-height:88rpx;
  align-items:center;
  font-size: 26rpx;
  color: #ff6b8a;
}

.link-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  margin-top: 32rpx;
}

.link-sep {
  font-size: 24rpx;
  color: #767b84;
}
