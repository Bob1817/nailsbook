.container {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 100rpx 48rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo-circle {
  width: 120rpx;
  height: 120rpx;
  background: var(--brand-gradient);
  border-radius: 36rpx;
  color: var(--text-inverse);
  font-size: 56rpx;
  font-weight: var(--weight-bold);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.title {
  font-size: var(--font-xl);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.login-tabs { display: flex; padding: 8rpx; margin-bottom: 32rpx; border-radius: var(--card-radius); background: var(--nb-page); }
.login-tab { flex: 1; min-height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-sm); color: var(--text-muted); font-size: var(--font-sm); }
.login-tab-active { color: var(--text-primary); background: var(--bg-card); font-weight: var(--weight-semibold); box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.08); }
.wechat-hint { display: block; color: var(--text-muted); font-size: var(--font-sm); line-height: 1.6; text-align: center; }

.form-item {
  margin-bottom: 32rpx;
}

.label {
  font-size: var(--font-sm);
  color: var(--text-body);
  display: block;
  margin-bottom: 12rpx;
}

.input  {
  width: 100%;
  height: 96rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: var(--radius-sm);
  padding: 0 32rpx;
  font-size: var(--font-md);
  color: var(--text-primary);
  box-sizing: border-box;
  border: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.035), inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  transition: border-color 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
}
.input:focus { border-color:var(--nb-link); background: var(--bg-card); box-shadow:0 0 0 6rpx rgba(0, 0, 0, .08); }

.readonly {
  width: 100%;
  height: 96rpx;
  background: var(--nb-page);
  border-radius: var(--radius-sm);
  padding: 0 32rpx;
  font-size: var(--font-md);
  color: var(--text-muted);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  border: 0;
}

.readonly-phone {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.readonly-action {
  flex-shrink: 0;
  font-size: var(--font-sm);
  color: var(--nb-text-link);
  margin-left: 16rpx;
}

.hint-banner {
  background: var(--nb-page);
  color: var(--nb-ink);
  font-size: var(--font-sm);
  padding: 20rpx 40rpx;
  border-radius: var(--radius-sm);
  margin-bottom: 32rpx;
  line-height: var(--leading-normal);
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  background: var(--brand-gradient);
  color: var(--text-inverse);
  border-radius: var(--radius-md);
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 48rpx;
}
.btn-primary[disabled] {
  background-color: var(--text-muted);
}

.link {
  display:inline-flex;
  min-height:88rpx;
  align-items:center;
  font-size: var(--font-sm);
  color: var(--nb-text-link);
}

.link-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  margin-top: 32rpx;
}

.link-sep {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

.guest-row {
  display: flex;
  justify-content: center;
  margin-top: 48rpx;
}

.link-muted {
  display: inline-flex;
  min-height: 88rpx;
  align-items: center;
  font-size: var(--font-sm);
  color: var(--text-muted);
}

@import '../../../styles/booking-actions.wxss';
.input { height: var(--input-height); min-height: 44px; background: var(--bg-input); border-radius: var(--input-radius); padding: 0 var(--input-padding-h); font-size: var(--font-sm); }
.readonly { height: var(--input-height); min-height: 44px; border-radius: var(--input-radius); padding: 0 var(--input-padding-h); font-size: var(--font-sm); }
.btn-primary.booking-action { height: var(--control-hit-height); min-height: 44px; margin-top: 32rpx; border-radius: 8px; background: var(--nb-action); font-size: var(--font-sm); box-shadow: none; }
