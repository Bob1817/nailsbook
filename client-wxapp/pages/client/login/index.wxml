<nav-bar title="登录" transparent/>
<view class="container">

  <view class="header">
    <view class="logo-circle">N</view>
    <text class="title">客户登录</text>
  </view>

  <view wx:if="{{wechatFeatureVisible}}" class="login-tabs">
    <view class="login-tab {{loginMethod === 'wechat' ? 'login-tab-active' : ''}}" data-method="wechat" bindtap="selectLoginMethod">微信授权登录</view>
    <view class="login-tab {{loginMethod === 'phone' ? 'login-tab-active' : ''}}" data-method="phone" bindtap="selectLoginMethod">手机号登录</view>
  </view>

  <view wx:if="{{wechatFeatureVisible && loginMethod === 'wechat'}}" class="form">
    <text class="wechat-hint">微信登录不会自动获取手机号；仅在首次绑定时由您主动授权。</text>
    <button wx:if="{{wechatLinked}}" class="btn-primary booking-action" bindtap="handleWechatLogin" disabled="{{loading || wechatChecking}}">
      {{loading ? '登录中...' : '微信授权登录'}}
    </button>
    <button wx:elif="{{wechatReady}}" class="btn-primary booking-action" open-type="getPhoneNumber" bindgetphonenumber="handleWechatPhone" disabled="{{loading}}">
      授权手机号并登录
    </button>
    <button wx:else class="btn-primary booking-action" bindtap="handleWechatLogin" disabled="{{wechatChecking}}">
      {{wechatChecking ? '正在检查微信登录...' : '重新获取微信登录状态'}}
    </button>
    <view class="link-row"><text class="link" data-method="phone" bindtap="selectLoginMethod">改用手机号登录</text></view>
    <view class="guest-row"><text class="link-muted" bindtap="browseAsGuest">我先逛逛，去看看作品</text></view>
  </view>

  <!-- Step 1: 输入手机号 -->
  <view wx:elif="{{step === 'phone'}}" class="form">
    <view class="form-item">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="请输入手机号" confirm-type="done" cursor-spacing="24"
        value="{{phone}}" data-field="phone" bindinput="onInput"/>
    </view>
    <button class="btn-primary booking-action" bindtap="handlePhoneNext">下一步</button>
    <view class="link-row">
      <text class="link" bindtap="goRoleSelect">返回身份选择</text>
    </view>
    <view class="guest-row"><text class="link-muted" bindtap="browseAsGuest">我先逛逛，去看看作品</text></view>
  </view>

  <!-- Step 2: 登录（已注册） -->
  <view wx:elif="{{loginMethod === 'phone'}}" class="form">
    <view class="form-item">
      <text class="label">手机号</text>
      <view class="readonly">
        <text class="readonly-phone">{{phone}}</text>
        <text class="readonly-action" data-step="phone" bindtap="switchPhase">换个手机号</text>
      </view>
    </view>
    <view class="form-item">
      <text class="label">密码</text>
      <input class="input" type="text" password placeholder="请输入密码" confirm-type="done" cursor-spacing="24"
        value="{{password}}" data-field="password" bindinput="onInput"/>
    </view>
    <button class="btn-primary booking-action" bindtap="handleLogin" disabled="{{loading}}">
      {{loading ? '登录中...' : '登录'}}
    </button>
    <view class="link-row">
      <text class="link semantic-link" bindtap="goForgotPassword">忘记密码？</text>
      <text class="link-sep">|</text>
      <text class="link" bindtap="goRoleSelect">返回选择身份</text>
    </view>
    <view class="guest-row"><text class="link-muted" bindtap="browseAsGuest">我先逛逛，去看看作品</text></view>
  </view>

  <checkbox-group class="privacy-consent" bindchange="onPrivacyAgreementChange">
    <label><checkbox color="#287A4B" value="agree" checked="{{privacyAgreed}}"/><text>我已阅读并同意</text></label>
    <text class="privacy-link" catchtap="openUserAgreement">《用户协议》</text>
    <text>和</text><text class="privacy-link" catchtap="openPrivacyPolicy">《隐私政策》</text>
  </checkbox-group>

</view>
