<nav-bar title="登录" transparent/>
<view class="container">

  <view class="header">
    <view class="logo-circle">N</view>
    <text class="title">客户登录</text>
  </view>

  <!-- Step 1: 输入手机号 -->
  <view wx:if="{{step === 'phone'}}" class="form">
    <view class="form-item">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="请输入手机号" confirm-type="next" cursor-spacing="24"
        value="{{phone}}" data-field="phone" bindinput="onInput"/>
    </view>
    <button class="btn-primary" bindtap="handlePhoneNext">下一步</button>
    <view class="link-row">
      <text class="link" bindtap="goRoleSelect">返回身份选择</text>
    </view>
  </view>

  <!-- Step 2: 登录（已注册） -->
  <view wx:else class="form">
    <view class="form-item">
      <text class="label">手机号</text>
      <view class="readonly">
        <text class="readonly-phone">{{phone}}</text>
        <text class="readonly-action" data-step="phone" bindtap="switchPhase">换个手机号</text>
      </view>
    </view>
    <view class="form-item">
      <text class="label">密码</text>
      <input class="input" type="text" password placeholder="请输入密码" confirm-type="done" cursor-spacing="24"
        value="{{password}}" data-field="password" bindinput="onInput"/>
    </view>
    <button class="btn-primary" bindtap="handleLogin" disabled="{{loading}}">
      {{loading ? '登录中...' : '登录'}}
    </button>
    <view class="link-row">
      <text class="link" bindtap="goForgotPassword">忘记密码？</text>
      <text class="link-sep">|</text>
      <text class="link" bindtap="goRoleSelect">返回选择身份</text>
    </view>
  </view>

</view>
