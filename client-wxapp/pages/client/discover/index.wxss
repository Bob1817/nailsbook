@import '../../../styles/tokens.wxss';

page {
  background: var(--nb-surface);
}

.page {
  min-height: 100vh;
  padding-bottom: 24rpx;
}

/* ===== 头部 sticky ===== */
.discover-head {
  position: sticky; z-index: 10;
  background: rgba(255, 255, 255, 0.72);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  backdrop-filter: blur(20px) saturate(180%);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  padding: var(--space-sm) var(--space-md) 0;
}

/* 搜索栏 */
.search-bar {
  display: flex; align-items: center; gap: 14rpx;
  background: var(--nb-page);
  border-radius: 24rpx;
  height: 88rpx;
  min-height: 88rpx;
  padding: 0 12rpx 0 var(--space-lg);
  margin-bottom: var(--space-sm);
  box-sizing: border-box;
}
.search-bar:active { opacity: 0.8; }

.search-icon {
  width: var(--space-lg); height: var(--space-lg); flex-shrink: 0;
  opacity: 0.45;
}

.search-input {
  font-size: var(--font-sm); flex: 1;
  min-height: var(--touch-min);
  color: var(--text-body);
}
.search-hint { color: var(--text-faint); }

.search-clear {
  display: flex; align-items: center; justify-content: center;
  width: 72rpx; min-height: var(--touch-min); flex-shrink: 0;
}
.clear-icon { width: var(--icon-sm); height: var(--icon-sm); opacity: 0.6; }

/* 分类 pills */
.cats-scroll { white-space: nowrap; }
.cats-bar {
  display: inline-flex;
  gap: 12rpx;
  padding-bottom: var(--space-sm);
  align-items: center;
}
.cat-pill {
  position: relative;
  height: 54rpx;
  min-height: 54rpx;
  padding: 0 24rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  background: var(--nb-page);
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  font-size: 24rpx;
  font-weight: var(--weight-medium);
  color: var(--nb-secondary);
  flex-shrink: 0;
  box-sizing: border-box;
  transition: all 0.15s ease-in-out;
 
}
.cat-pill::after { content:''; position:absolute; top:-16rpx; bottom:-16rpx; left:0; right:0; }
.cat-pill:active {
  background: var(--nb-pressed);
  transform: scale(0.97);
}
.cat-active {
  background: var(--nb-action);
  border-color: var(--nb-action);
  color: var(--nb-inverse);
  font-weight: var(--weight-semibold);
}

/* ===== 瀑布流 ===== */
.waterfall-wrap { padding:var(--space-md) 28rpx 0; }
.featured-work { margin-bottom:34rpx; }
.featured-swiper { width:100%; height:430rpx; }
.featured-slide { width:100%; box-sizing:border-box; }
.hero-work { position:relative; width:100%; height:396rpx; overflow:hidden; border-radius:24rpx; background:var(--nb-page); box-shadow:0 12rpx 32rpx rgba(0, 0, 0, .14); }
.hero-work:active { opacity:.94; }
.hero-work-image { position:absolute; inset:0; width:100%; height:100%; }
.hero-work-shade { position:absolute; inset:0; background:linear-gradient(180deg,rgba(0, 0, 0, .02) 38%,rgba(0, 0, 0, .72) 100%); }
.hero-work-copy { position:absolute; left:24rpx; right:154rpx; bottom:22rpx; color:var(--nb-surface); }
.hero-work-title { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-family:var(--font-display); font-size:var(--font-lg); font-weight:700; line-height:1.3; text-shadow:0 2rpx 8rpx rgba(0,0,0,.28); }
.hero-work-artist { min-width:0; margin-top:10rpx; display:flex; align-items:center; gap:var(--space-xs); }
.hero-work-avatar { width:36rpx; height:36rpx; flex-shrink:0; border-radius:50%; background:var(--nb-page); }
.hero-work-avatar-fallback { display:flex; align-items:center; justify-content:center; color:var(--nb-ink); background:rgba(255,255,255,.9); font-size:var(--font-xs); }
.hero-work-name { flex-shrink:0; max-width:42%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:var(--font-xs); font-weight:600; }
.hero-work-meta { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:rgba(255,255,255,.8); font-size:var(--font-xs); }
.hero-work-link { position:absolute; right:20rpx; bottom:22rpx; min-width:112rpx; min-height:64rpx; padding:0 var(--space-sm); display:flex; align-items:center; justify-content:center; color:var(--nb-surface); background:rgba(0, 0, 0, .38); -webkit-backdrop-filter:blur(16rpx); backdrop-filter:blur(16rpx); border-radius:var(--radius-full); font-size:var(--font-xs); font-weight:600; box-sizing:border-box; }
.hero-work-link::after { content:''; position:absolute; top:50%; left:50%; min-width:88rpx; min-height:88rpx; transform:translate(-50%, -50%); }
.featured-indicators { height:34rpx; display:flex; align-items:flex-end; justify-content:center; gap:10rpx; }
.featured-indicator { width:8rpx; height:8rpx; border-radius:var(--radius-full); background:var(--nb-page); transition:width .22s ease, background-color .22s ease; }
.featured-indicator.is-active { width:24rpx; background:var(--nb-action); }
.all-works-head { margin:2rpx 4rpx 18rpx; display:flex; align-items:baseline; justify-content:space-between; }
.all-works-title { color:var(--nb-ink); font-family:var(--font-display); font-size:var(--font-md); font-weight:700; }
.all-works-count { color:var(--nb-muted); font-size:var(--font-xs); }
.waterfall {
  width: 100%;
  display: flex; gap: 20rpx;
  align-items: flex-start;
}
.col {
  flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 20rpx;
}
.editorial-card { margin-bottom:0; }

/* ===== 骨架屏 ===== */
.skel-mode {
  display: flex; gap: var(--space-sm);
  padding: var(--space-sm); align-items: flex-start;
}
.skel-card {
  border-radius: var(--radius-md);
  background: var(--nb-page);
  background-size: 200% 100%;
  animation: skel 1.4s linear infinite;
  margin-bottom: 12rpx;
}
.skel-tall { height: 400rpx; }
.skel-mid  { height: 320rpx; }

@keyframes skel {
  0%   { background-position: 0 0; }
  100% { background-position: -200% 0; }
}

/* ===== 空状态 ===== */
.empty-wrap {
  padding: 80rpx 60rpx;
  display: flex; flex-direction: column; align-items: center; gap: 20rpx;
}
.empty-art {
  position: relative; width: 128rpx; height: 128rpx; margin-bottom: var(--space-xs);
}
.empty-ring-outer {
  position: absolute; inset: 0; border-radius: 50%;
  border: 1rpx solid var(--nb-line);
  background: transparent;
}
.empty-ring-inner {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: var(--nb-line);
}
.empty-ttl {
  font-size: var(--font-lg); font-weight: var(--weight-semibold);
  color: var(--text-primary);
}
.empty-sub {
  font-size: var(--font-sm); color: var(--text-muted);
  text-align: center; line-height: var(--leading-relaxed);
}
.empty-cta {
  margin-top: var(--space-xs);
  height: var(--btn-height);
  padding: 0 var(--space-3xl);
  border-radius: var(--radius-full);
  background: var(--brand-gradient);
  color: var(--text-inverse);
  font-size: var(--btn-font-size); font-weight: var(--weight-semibold);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.30) /* brand-primary-alpha */;
}
.empty-cta:active { opacity: 0.85; }
.empty-cta.secondary {
  background: var(--bg-card);
  color: var(--text-body);
  border: 0;
  box-shadow: none;
}

.result-summary { padding: var(--space-xs) var(--space-xs) 18rpx; color: var(--text-muted); font-size: var(--font-xs); }

/* ===== 底部加载 ===== */
.bottom-loader {
  display: flex; justify-content: center; padding: var(--space-lg) 0;
}
.spinner {
  width: 44rpx; height: 44rpx;
  border: 3rpx solid rgba(0, 0, 0, 0.2) /* brand-primary-alpha */;
  border-top-color: var(--brand-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

@import '../../../styles/booking-actions.wxss';
.empty-cta.booking-action { height: var(--control-hit-height); min-height: 44px; border-radius: 8px; padding: 0 var(--space-md); font-size: var(--font-sm); box-shadow: none; }

.bottom-end {
  display: flex; justify-content: center; padding: var(--space-lg) 0;
}
.bottom-end-text { font-size: var(--font-sm); color: var(--text-muted); }
