/* ===== 根节点：原生页面滚动，不设高度/flex ===== */
page {
  background: #f0f0f4;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ===== 头部 sticky（top 由 JS 通过 inline style 注入）===== */
.discover-head {
  position: sticky;
  z-index: 10;
  background: #ffffff;
  padding: 16rpx 24rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #f5f6fa;
  border-radius: 44rpx;
  min-height: 88rpx;
  padding: 0 12rpx 0 28rpx;
  margin-bottom: 16rpx;
}

.search-bar:active { opacity: 0.8; }

.search-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  border: 3rpx solid #9ca3af;
  border-radius: 50%;
  position: relative;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: -10rpx;
  bottom: -10rpx;
  width: 10rpx;
  height: 3rpx;
  background: #9ca3af;
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.search-input {
  font-size: 26rpx;
  flex: 1;
  min-height: 88rpx;
  color: #343038;
}

.search-hint { color: #a4a8b1; }

.search-clear {
  position: relative;
  width: 72rpx;
  min-height: 88rpx;
  flex-shrink: 0;
}

.clear-line { position:absolute; left:25rpx; top:43rpx; width:24rpx; height:2rpx; border-radius:2rpx; background:#77717b; }
.clear-a { transform:rotate(45deg); }.clear-b { transform:rotate(-45deg); }

/* 分类 pills */
.cats-scroll { white-space: nowrap; }

.cats-bar {
  display: inline-flex;
  gap: 12rpx;
  padding-bottom: 16rpx;
}

.cat-pill {
  display: inline-flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #6b7280;
  background: #f5f6fa;
  flex-shrink: 0;
  transition: all 0.15s;
}

.cat-pill:active { opacity: 0.75; }

.cat-active {
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 138, 0.28);
}

/* ===== 瀑布流区域（完全照搬作品列表页 works 的成熟写法）===== */
.waterfall-wrap {
  padding: 16rpx 16rpx 0;
}

.waterfall {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* ===== 作品卡片：height:0 + padding-bottom 百分比撑高度（关键）===== */
.card {
  position: relative;
  width: 100%;
  height: 0;
  overflow: hidden;
  border-radius: 20rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.08), 0 1rpx 4rpx rgba(15, 23, 42, 0.04);
}

.card:active { transform: scale(0.984); opacity: 0.94; }

/* 宽高比：用 padding-bottom 百分比，相对卡片宽度自适应 */
.aspect-3-4 { padding-bottom: 133.33%; }
.aspect-4-5 { padding-bottom: 125%; }
.aspect-5-6 { padding-bottom: 120%; }
.aspect-2-3 { padding-bottom: 150%; }

/* 图片与空占位 */
.card-img {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
}

.card-img-empty {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, #f1e8f0, #e8eaf6);
}

/* 遮罩渐变 */
.card-gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.25) 0%,
    transparent 35%,
    transparent 50%,
    rgba(0, 0, 0, 0.72) 100%
  );
}

/* 顶部：美甲师 pill + 点赞 */
.card-top {
  position: absolute;
  top: 0; left: 0; right: 0;
  padding: 14rpx 14rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 2;
}

.card-tech-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(0, 0, 0, 0.32);
  backdrop-filter: blur(6px);
  padding: 7rpx 14rpx 7rpx 7rpx;
  border-radius: 28rpx;
  max-width: 62%;
}

.card-tech-av {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.card-tech-av-ph {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.card-tech-av-char {
  font-size: 16rpx;
  font-weight: 700;
  color: #fff;
}

.card-tech-name {
  font-size: 20rpx;
  font-weight: 500;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-like-pill {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(0, 0, 0, 0.32);
  backdrop-filter: blur(6px);
  padding: 7rpx 14rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
}

.card-like-pill:active { opacity: 0.75; }

/* 心形图标（base64 PNG，与作品列表页/首页一致）*/
.heart-icon {
  width: 22rpx;
  height: 20rpx;
  flex-shrink: 0;
}

.card-like-num {
  font-size: 20rpx;
  color: #fff;
  font-weight: 500;
  line-height: 1;
}

/* 底部：标题 + 标签 + 预约 */
.card-bottom {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 14rpx;
  z-index: 2;
}

.card-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.3;
  margin-bottom: 8rpx;
}

.card-tags {
  display: flex;
  gap: 6rpx;
  margin-bottom: 10rpx;
  flex-wrap: nowrap;
  overflow: hidden;
}

.card-tag {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.16);
  padding: 3rpx 12rpx;
  border-radius: 16rpx;
  white-space: nowrap;
}

.card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-date {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 查看详情：与首页/作品列表页统一 */
.card-cta {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.card-cta-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.78);
}

.icon { flex-shrink: 0; }

.icon-check-circle {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.78);
  position: relative;
}

.icon-check-circle::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 6rpx;
  height: 3rpx;
  border-left: 2rpx solid rgba(255, 255, 255, 0.78);
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.78);
  transform: translate(-55%, -65%) rotate(-45deg);
}

/* ===== 骨架屏 ===== */
.skel-mode {
  display: flex;
  gap: 16rpx;
  padding: 16rpx;
  align-items: flex-start;
}

.skel-card {
  border-radius: 20rpx;
  background: linear-gradient(90deg, #e8e8ee, #f2f2f6, #e8e8ee);
  background-size: 200% 100%;
  animation: skel 1.4s linear infinite;
  margin-bottom: 12rpx;
}

.skel-tall { height: 400rpx; }
.skel-mid  { height: 320rpx; }

@keyframes skel {
  0%   { background-position: 0 0; }
  100% { background-position: -200% 0; }
}

/* ===== 空状态 ===== */
.empty-wrap {
  padding: 80rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.empty-art {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 8rpx;
}

.empty-ring-outer {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFE2EA, #EDE9FE);
}

.empty-ring-inner {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B8A, #A78BFA);
  opacity: 0.6;
}

.empty-ttl {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.empty-sub {
  font-size: 26rpx;
  color: #6b7280;
  text-align: center;
  line-height: 1.7;
}

.empty-cta {
  margin-top: 8rpx;
  height: 88rpx;
  padding: 0 64rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 138, 0.30);
}

.empty-cta:active { opacity: 0.85; }
.empty-cta.secondary { background:#fff; color:#8b526d; border:1rpx solid #dfcbd4; box-shadow:none; }

.result-summary { padding:8rpx 8rpx 18rpx; color:#756b73; font-size:22rpx; }

/* ===== 底部加载 ===== */
.bottom-loader {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.spinner {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid rgba(255, 107, 138, 0.2);
  border-top-color: #FF6B8A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.bottom-end {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.bottom-end-text {
  font-size: 24rpx;
  color: #767b84;
}
