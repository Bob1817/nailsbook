.container {
  min-height: 100vh;
  background: #f8f9fc;
  padding: 60rpx 40rpx 40rpx;
}
.header { margin-bottom: 48rpx; }
.title { display: block; font-size: 48rpx; font-weight: 700; color: #1f2937; margin-bottom: 12rpx; }
.subtitle { display: block; font-size: 28rpx; color: #6b7280; }
.form {
  background: #f8f9fc;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 40rpx;
}
.field { padding: 28rpx 40rpx; border-bottom: 1rpx solid #f5f5f5; }
.field:last-child { border-bottom: none; }
.label { display: block; font-size: 26rpx; color: #374151; margin-bottom: 12rpx; }
.input  { width: 100%; font-size: 28rpx; color: #1f2937; height: 88rpx; padding:0 20rpx; background: #f9fafb; border:2rpx solid transparent; border-radius: 14rpx; box-sizing:border-box;}
.input:focus { border-color:#ff6b8a; background:#fff; }
.placeholder { color: #6b7280; }
.code-row { display: flex; align-items: center; gap: 16rpx; }
.code-input  { flex: 1;  background: #f9fafb; border-radius: 14rpx;}
.code-btn {
  flex-shrink: 0;
  background: #fff0f3;
  color: #FF6B8A;
  font-size: 26rpx;
  font-weight: 600;
  padding: 12rpx 40rpx;
  border-radius: 14rpx;
  white-space: nowrap;
}
.code-btn:active { opacity: 0.8; }
.code-btn-disabled { opacity: 0.5; }
.submit-btn {
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  padding: 28rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
}
.submit-btn:active { opacity: 0.85; }
.btn-disabled { opacity: 0.6; }
