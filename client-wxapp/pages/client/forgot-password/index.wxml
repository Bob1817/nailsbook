<view class="container">
  <view class="header">
    <text class="title">重置密码</text>
    <text class="subtitle">请输入您的手机号和新密码</text>
  </view>

  <view class="form">
    <view class="field">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" placeholder="请输入手机号" placeholder-class="placeholder" />
    </view>
    <view class="field">
      <text class="label">新密码</text>
      <input class="input" password value="{{newPassword}}" bindinput="onNewPasswordInput" placeholder="至少6位" placeholder-class="placeholder" />
    </view>
    <view class="field">
      <text class="label">确认密码</text>
      <input class="input" password value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" placeholder="再次输入新密码" placeholder-class="placeholder" />
    </view>
  </view>

  <view class="submit-btn {{submitting ? 'btn-disabled' : ''}}" bindtap="handleSubmit">
    <text>{{submitting ? '提交中...' : '确认重置'}}</text>
  </view>
</view>
