<nav-bar title="重置密码" showBack/>
<view class="container">
  <view class="header">
    <text class="title">找回密码</text>
    <text class="subtitle">通过注册手机号验证后重置登录密码</text>
  </view>

  <view class="form">
    <view class="field">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" placeholder="请输入手机号" placeholder-class="placeholder" confirm-type="next" cursor-spacing="24" />
    </view>
    <view class="field field-code">
      <text class="label">验证码</text>
      <view class="code-row">
        <input class="input code-input" type="number" maxlength="6" value="{{code}}" bindinput="onCodeInput" placeholder="请输入验证码" placeholder-class="placeholder" confirm-type="next" cursor-spacing="24" />
        <view class="code-btn {{countdown > 0 || sending ? 'code-btn-disabled' : ''}}" bindtap="handleSendCode">
          <text>{{countdown > 0 ? countdown + 's' : sending ? '发送中' : '发送验证码'}}</text>
        </view>
      </view>
    </view>
    <view class="field">
      <text class="label">新密码</text>
      <input class="input" password value="{{newPassword}}" bindinput="onNewPasswordInput" placeholder="至少8位，含字母和数字" placeholder-class="placeholder" confirm-type="next" cursor-spacing="24" />
    </view>
    <view class="field">
      <text class="label">确认密码</text>
      <input class="input" password value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" placeholder="再次输入新密码" placeholder-class="placeholder" confirm-type="done" cursor-spacing="24" />
    </view>
  </view>

  <view class="submit-btn {{submitting ? 'btn-disabled' : ''}}" bindtap="handleSubmit">
    <text>{{submitting ? '提交中...' : '重置密码'}}</text>
  </view>
</view>
