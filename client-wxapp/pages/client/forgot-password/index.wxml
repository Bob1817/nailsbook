<nav-bar title="重置密码" showBack/>
<view class="page">
  <secondary-page-header title="找回密码" subtitle="通过微信手机号授权验证后重置登录密码" />
  <view class="container">
  <view class="form">
    <form-field icon="/static/icons/mobile.svg" type="number" maxlength="{{11}}" value="{{phone}}" placeholder="请输入手机号" bind:input="onPhoneInput" />
    <form-field icon="/static/icons/key.svg" password value="{{newPassword}}" placeholder="新密码，至少 8 位且含字母和数字" bind:input="onNewPasswordInput" />
    <form-field icon="/static/icons/key.svg" password value="{{confirmPassword}}" placeholder="再次输入新密码" bind:input="onConfirmPasswordInput" />
  </view>

  <view class="submit-wrap">
    <button wx:if="{{wechatAvailable}}" class="wechat-submit-btn" open-type="getPhoneNumber" bindgetphonenumber="onWechatPhone" loading="{{submitting}}" disabled="{{submitting}}">微信授权重置密码</button>
    <view wx:elif="{{!wechatChecking}}" class="fallback-card">
      <text class="fallback-text">当前环境暂不支持微信授权验证，请联系客服协助重置密码</text>
      <button class="contact-btn" open-type="contact" show-message-card="true" send-message-title="找回密码">联系客服</button>
    </view>
  </view>
</view>
</view>
