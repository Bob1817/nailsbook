@import '../../../styles/tokens.wxss';

/* ===== 设计稿暖色调系统 ===== */
page {
  --warm-primary: var(--nb-action);
  --warm-primary-dark: var(--nb-action);
  --warm-accent: var(--nb-action);
  --warm-accent-light: var(--nb-soft-surface);
  --warm-cream: var(--nb-page);
  --warm-surface: var(--nb-surface);
  --warm-text-primary: var(--nb-ink);
  --warm-text-secondary: var(--nb-secondary);
  --warm-text-muted: var(--nb-muted);
  --warm-divider: var(--nb-line);
  --warm-gold: var(--nb-action);
  --warm-gold-light: var(--nb-soft-surface);
  --warm-green: var(--nb-success);
  --warm-star: var(--nb-action);
  
  background: var(--nb-page);
  color: var(--nb-ink);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Noto Sans SC', sans-serif;
}

.page { 
  min-height: 100vh;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom, 0px));
}
.owner-menu {
  position: absolute;
  top: 50%;
  right: 20rpx;
  z-index: 30;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  transform: translateY(-50%);
}
.owner-menu image {
  width: 20px;
  height: 20px;
  padding: 4px;
  border-radius: 50%;
  background: rgba(255, 255, 255, .76);
  box-shadow: 0 1px 4px rgba(0, 0, 0, .10);
  transition: transform .15s ease, background-color .15s ease;
}
.owner-menu:active image {
  background: rgba(255, 255, 255, .92);
  transform: scale(.94);
}

/* ===== Section 通用样式 ===== */
.section-block {
  padding: 0 var(--space-xl);
  margin-top: var(--space-xl);
}

/* ===== 加载状态 ===== */
.state {
  min-height: 80vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-md);
  color: var(--warm-text-muted);
}
.loading-spinner {
  width: 48rpx; height: 48rpx;
  border: 4rpx solid var(--warm-divider);
  border-top-color: var(--warm-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.state-title { font-size: var(--font-lg); font-weight: var(--weight-semibold); color: var(--warm-text-primary); }
.retry-btn {
  display: flex;
  align-items: center;
  justify-content: center;  height: 44px;
  min-height: 44px;
  padding: 0 16px;
  border-radius: 8px;
  font-size: var(--font-md);
  line-height: 1;
  box-sizing: border-box;
  border: 0;
  color: var(--warm-primary);
  font-weight: 500;
 background: var(--nb-soft-surface);}

/* ===== Banner 区域 ===== */
.banner-section {
  position: relative;
  height: 360rpx;
  overflow: hidden;
}
.hero-background {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.banner-mosaic {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  position: absolute;
  inset: 0;
  filter: blur(40rpx);
  transform: scale(1.15);
}
.mosaic-img { width: 100%; height: 100%; object-fit: cover; }
.banner-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(0, 0, 0, 0.08), transparent 58%);
}
.banner-gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.02) 24%, rgba(0, 0, 0, 0.34) 56%, rgba(0, 0, 0, 0.86) 100%);
}
.artist-hero-sticky {
  position: sticky;
  z-index: 90;
}
.hero-content-bridge {
  position: absolute;
  left: 0;
  right: 0;
  bottom: -2rpx;
  z-index: 2;
  height: 32rpx;
  border-radius: var(--radius-pill) var(--radius-pill) 0 0;
  background: var(--nb-page);
  pointer-events: none;
}
.availability-title-wrap { display:flex; align-items:baseline; gap:var(--space-sm); min-width:0; }
.availability-headline { font-size:var(--font-xs); color:var(--nb-muted); white-space:nowrap; }
.availability-scroll { width:100%; white-space:nowrap; }
.availability-days { display:inline-flex; gap:12rpx; padding:4rpx 0; }
.availability-day { width:104rpx; min-height:128rpx; padding:var(--space-sm) var(--space-xs); box-sizing:border-box; border-radius:18rpx; background:var(--nb-surface); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4rpx; }
.availability-day.is-full { background:var(--nb-pressed); }
.availability-weekday { font-size:var(--font-xs); color:var(--nb-muted); }
.availability-date { font-size:var(--font-lg); font-weight:var(--weight-semibold); color:var(--nb-ink); }
.availability-status { font-size:var(--font-xs); color:var(--nb-muted); }
.artist-sticky {
  position: relative;
  z-index: 3;
  min-height: 168rpx;
  margin-top: -168rpx;
  padding: 12rpx var(--space-xl) 44rpx;
  display: flex;
  align-items: flex-end;
  box-sizing: border-box;
  background: transparent;
}
.artist-sticky.has-owner-menu .artist-info-row {
  padding-right: 52px;
  box-sizing: border-box;
}
.artist-info-row {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.avatar-wrap {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  overflow: visible;
  flex-shrink: 0;
}
.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  box-sizing: border-box;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.28);
}
.avatar-fallback {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 0;
  background: var(--warm-accent-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: var(--warm-primary);
  font-weight: 600;
}
.online-dot {
  position: absolute;
  bottom: 2rpx;
  right: 2rpx;
  width: 20rpx;
  height: 20rpx;
  background: var(--nb-success);
  border-radius: 50%;
  border: 4rpx solid var(--nb-surface);
}
.artist-detail {
  flex: 1;
  min-width: 0;
}
.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}
.artist-name {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--nb-surface);
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.42);
}

.certification-line {
  display: block;
  margin: 0 0 6rpx;
  color: var(--nb-inverse);
  font-size: var(--font-xs);
  line-height: 1.4;
  opacity: .88;
}
.badge-gold {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx var(--space-sm);
  background: var(--nb-action);
  color: var(--nb-inverse);
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
  border-radius: var(--radius-full);
}
.badge-icon-svg { width: 20rpx; height: 20rpx; }
.meta-row {
  display: flex;
  align-items: center;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.35);
  gap: var(--space-xs);
  flex-wrap: wrap;
  font-size: var(--font-sm);
  color: rgba(255,255,255,0.92);
  margin-bottom: 0;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.2);
}
.meta-icon { width: 28rpx; height: 28rpx; filter: drop-shadow(0 1rpx 2rpx rgba(0,0,0,0.25)); }
.meta-divider { opacity: 0.6; margin: 0 4rpx; }
.btn-icon-svg { width: 18px; height: 18px; flex-shrink: 0; filter: brightness(0) invert(1); }
.btn-text { line-height: 1; }

/* ===== 统计概览 ===== */
.stats-section {
  padding: 0 var(--space-xl);
  margin-top: -40rpx;
  position: relative;
  z-index: 20;
}
.stats-card {
  background: var(--nb-surface);
  border-radius: 32rpx;
  padding: var(--space-lg) var(--space-sm);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--warm-text-primary);
  font-family: 'Georgia', serif;
}
.stat-unit { font-size: var(--font-md); }
.stat-label {
  display: block;
  font-size: var(--font-xs);
  color: var(--warm-text-muted);
  margin-top: var(--space-xs);
  letter-spacing: 2rpx;
}
.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: var(--warm-divider);
}

/* ===== 通用 Section ===== */
.section-header {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: 20rpx;
}
.section-bar {
  width: 6rpx;
  height: 24rpx;
  border-radius: 3rpx;
  background: var(--nb-action);
}
.section-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--nb-ink);
  letter-spacing: -0.2rpx;
  flex: 1;
}
.section-more {
  position: relative;
  font-size: var(--font-sm);
  color: var(--nb-text-link);
  font-weight: 500;
  line-height: 1.4;
  padding: 0 4rpx;
  flex-shrink: 0;
}
.section-more::after {
  content: '';
  position: absolute;
  top: -16rpx;
  bottom: -16rpx;
  left: -16rpx;
  right: -16rpx;
}
.section-more:active {
  opacity: 0.7;
}

/* ===== 关于我 ===== */
.about-card {
  background: var(--nb-surface);
  border-radius: 24rpx;
  padding: var(--space-lg);
  border: 1rpx solid var(--nb-line);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.bio-text {
  font-size: var(--font-sm);
  color: var(--warm-text-secondary);
  line-height: 1.8;
}
.timeline-section {
  margin-top: 0;
  padding-top: 0;
  border-top: 0;
}
.timeline-list { padding-left: var(--space-xs); }
.timeline-item {
  position: relative;
  padding-left: var(--space-xl);
  padding-bottom: 28rpx;
}
.timeline-item:last-child { padding-bottom: 0; }
.timeline-dot {
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 4rpx solid var(--warm-primary);
  background: var(--warm-cream);
  z-index: 2;
}
.timeline-line {
  position: absolute;
  left: 11rpx;
  top: 32rpx;
  bottom: 0;
  width: 2rpx;
  background: linear-gradient(to bottom, var(--warm-primary), var(--warm-accent-light));
}
.timeline-year {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--warm-primary);
}
.timeline-desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--warm-text-secondary);
  margin-top: 6rpx;
}

/* ===== 精选作品 ===== */
.featured-work-grid {
  width: 100%;
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}
.featured-work-col {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.featured-work-item {
  width: 100%;
  min-width: 0;
}

/* ===== 擅长风格 ===== */
.style-scroll {
  white-space: nowrap;
  margin: 0 -40rpx;
  padding: 0 var(--space-xl);
}
.style-list {
  display: inline-flex;
  gap: 20rpx;
  padding-right: var(--space-xl);
}
.style-card {
  position: relative;
  width: 224rpx;
  height: 288rpx;
  border-radius: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.style-card-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.style-card-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 30%, rgba(0, 0, 0, 0.55) 100%);
}
.style-card-text {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  color: var(--nb-surface);
  font-size: var(--font-sm);
  font-weight: 600;
}
.style-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}
.style-chip {
  display: inline-flex;
  align-items: center;
  min-height: 64rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--warm-divider);
  border-radius: var(--radius-sm);
  background: var(--nb-surface);
  color: var(--warm-text-secondary);
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  box-sizing: border-box;
}

/* ===== 服务内容 ===== */
.service-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.service-card {
  background: var(--nb-surface);
  border-radius: 32rpx;
  padding: var(--space-lg);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: flex-start;
  gap: 28rpx;
}
.service-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-md);
  background: var(--warm-accent-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.service-icon-svg { width: 44rpx; height: 44rpx; }
.service-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 12rpx; }
.service-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}
.service-name {
  flex: 1;
  min-width: 0;
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--warm-text-primary);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.service-right-meta {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
}
.service-price {
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--nb-money);
  letter-spacing: 0.2rpx;
}
.service-desc {
  font-size: var(--font-xs);
  color: var(--warm-text-muted);
  line-height: 1.6;
}
.service-duration {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: var(--font-xs);
  color: var(--warm-text-muted);
  padding: 4rpx 12rpx;
  background: var(--warm-accent-light);
  border-radius: var(--radius-full);
}
.duration-icon-svg { width: 20rpx; height: 20rpx; opacity: 0.85; }

/* ===== 店铺信息 ===== */
.shop-card {
  background: var(--nb-surface);
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid var(--nb-line);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.shop-hero-wrap {
  position: relative;
  background: var(--nb-page);
}
.shop-hero {
  width: 100%;
  height: 360rpx;
}
.shop-hero-slide,
.shop-hero-image {
  width: 100%;
  height: 100%;
}
.shop-hero-slide {
  position: relative;
}
.shop-hero-image {
  display: block;
}
.shop-hero-overlay {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  padding: 56rpx var(--space-md) 20rpx;
  background: linear-gradient(transparent, var(--bg-overlay));
}
.shop-hero-tag {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-overlay);
  color: var(--nb-inverse);
  font-size: var(--font-xs);
}
.shop-hero-caption {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--nb-inverse);
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  text-overflow: ellipsis;
  white-space: nowrap;
}
.shop-hero-count {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 6rpx 12rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-overlay);
  color: var(--nb-inverse);
  font-size: var(--font-xs);
  line-height: 1.4;
}
.shop-info { padding: var(--space-md) var(--space-lg) 20rpx; }
.shop-name {
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--warm-text-primary);
  display: block;
  margin-bottom: 20rpx;
}
.shop-detail-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: var(--space-sm);
}
.shop-detail-row:last-of-type { margin-bottom: 0; }
.shop-address-content {
  flex: 1;
  min-width: 0;
  display: block;
}
.detail-icon-wrap {
  width: 32rpx;
  min-height: 38rpx;
  flex: 0 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.detail-icon-svg {
  width: 26rpx;
  height: 26rpx;
  display: block;
  opacity: 0.9;
}
.detail-text {
  font-size: var(--font-sm);
  color: var(--warm-text-secondary);
  line-height: 1.6;
}
.guidance-entry-inline {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: var(--space-xs);
  min-height: auto;
  padding: 0;
  box-sizing: border-box;
  margin-left: var(--space-sm);
  vertical-align: middle;
  background: transparent;
}
.guidance-entry-inline::before { content: ''; position: absolute; inset: -12px -12rpx; }
.guidance-entry-inline:active { opacity: 0.7; }
.guidance-entry-text {
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
  color: var(--nb-text-link);
}
.guidance-entry-arrow {
  font-size: var(--font-sm);
  color: var(--nb-text-link);
}
.shop-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}
.shop-policy-entry {
  min-height: 44px;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: -10rpx;
  color: var(--nb-text-link);
}
.shop-policy-entry:active { opacity: .7; }
.shop-policy-text { font-size: var(--font-sm); font-weight: var(--weight-medium); }
.shop-policy-summary { flex: 1; color: var(--nb-muted); font-size: var(--font-xs); text-align: right; }
.shop-policy-arrow { color: var(--nb-text-link); font-size: var(--font-md); }
.action-btn {
  width: 0;
  min-width: 0;
  margin: 0;  height: 44px;
  min-height: 44px;
  padding: 0 16px;
  border-radius: 8px;
  font-size: var(--font-md);
  line-height: 1;
  box-sizing: border-box;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: var(--warm-accent-light);
  color: var(--warm-primary);
  font-weight: 600;
  border: none;
}
.action-icon-svg { width: 18px; height: 18px; flex-shrink: 0; }

/* ===== 客户评价 ===== */
.review-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.review-card {
  background: var(--nb-surface);
  border-radius: 24rpx;
  padding: var(--space-lg);
  border: 1rpx solid var(--nb-line);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.review-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.review-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.review-avatar-fallback {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--warm-accent-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-md);
  color: var(--warm-primary);
  font-weight: 600;
  flex-shrink: 0;
}
.review-meta { flex: 1; }
.review-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.review-name {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--warm-text-primary);
}
.review-time {
  font-size: var(--font-xs);
  color: var(--warm-text-muted);
}
.review-stars {
  display: flex;
  gap: 4rpx;
  margin-top: var(--space-xs);
}
.star { font-size: var(--font-xs); color: var(--nb-muted); }
.star-filled { color: var(--warm-star); }
.review-content {
  font-size: var(--font-sm);
  color: var(--warm-text-secondary);
  line-height: 1.8;
}

.homepage-comment-list { display: flex; flex-direction: column; gap: var(--space-sm); }
.homepage-comment { display: flex; align-items: flex-start; gap: 20rpx; padding: 28rpx; border-radius: var(--radius-md); background: var(--nb-surface); }
.homepage-comment-avatar { width: 72rpx; height: 72rpx; flex-shrink: 0; border-radius: 50%; background: var(--nb-soft-surface); }
.homepage-comment-body { flex: 1; min-width: 0; }
.homepage-comment-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); }
.homepage-comment-name { min-width: 0; font-size: var(--font-sm); font-weight: var(--weight-semibold); color: var(--nb-ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.homepage-comment-time { flex-shrink: 0; font-size: var(--font-xs); color: var(--nb-muted); }
.homepage-comment-content { display: block; margin-top: var(--space-xs); font-size: var(--font-sm); line-height: 1.6; color: var(--nb-secondary); overflow-wrap: anywhere; }

/* ===== 底部操作栏 ===== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.86);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  backdrop-filter: blur(20px) saturate(180%);
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.04);
}
.bottom-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  padding: 12rpx var(--space-lg) max(12rpx, calc(env(safe-area-inset-bottom, 0px) - 20rpx));
  box-sizing: border-box;
}
.bottom-actions {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
}
.action-icon-btn {
  min-height: 44px;  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  width: 96rpx;
  background: transparent;
  border: none;
  padding: 0;
  line-height: 1;
}
.action-icon-btn::before {
  content: '';
  position: absolute;
  top: -18rpx;
  right: 0;
  bottom: -18rpx;
  left: 0;
}
.action-icon-btn::after { border: none; }
.social-icon-svg { width: 40rpx; height: 40rpx; }
.count-label {
  font-size: var(--font-xs);
  color: var(--warm-text-muted);
  line-height: 1.2;
}
.action-icon-btn.favorited .count-label { color: var(--nb-ink); font-weight: 600; }
.action-icon-btn.followed .count-label { color: var(--warm-primary); font-weight: 600; }
.action-icon-btn.liked .count-label { color: var(--nb-ink); font-weight: 600; }
.btn-book-main {
  width: 0;
  min-width: 0;
  margin: 0;  height: 44px;
  min-height: 44px;
  padding: 0 16px;
  border-radius: 8px;
  font-size: var(--font-md);
  line-height: 1;
  box-sizing: border-box;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: var(--nb-action);
  color: var(--nb-surface);
  font-weight: 700;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.35);
}
/* ===== 空状态 ===== */
.empty-hint {
  padding: 80rpx 0;
  text-align: center;
  color: var(--warm-text-muted);
  font-size: var(--font-sm);
}

/* ===== 绑定弹窗 ===== */
.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: flex-end;
}
.owner-action-panel {
  width: 100%;
  padding: 12rpx var(--space-md) calc(var(--space-sm) + env(safe-area-inset-bottom, 0px));
  box-sizing: border-box;
  border-radius: 32rpx 32rpx 0 0;
  background: var(--nb-surface);
}
.owner-action-item,
.owner-action-cancel {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--nb-ink);
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  line-height: var(--leading-normal);
}
.owner-action-item {
  border-bottom: 1rpx solid var(--nb-line);
}
.owner-action-item:active,
.owner-action-cancel:active {
  background: var(--nb-soft-surface);
}
.owner-action-cancel {
  margin-top: var(--space-xs);
  color: var(--nb-secondary);
}
.modal-panel {
  width: 100%;
  background: var(--nb-surface);
  border-radius: 40rpx 40rpx 0 0;
  padding: var(--space-lg) var(--space-2xl) calc(var(--space-2xl) + env(safe-area-inset-bottom, 0px));
}
.policy-panel {
  width: 100%;
  max-height: 78vh;
  padding: var(--space-md) var(--space-xl) calc(var(--space-lg) + env(safe-area-inset-bottom, 0px));
  box-sizing: border-box;
  border-radius: 32rpx 32rpx 0 0;
  background: var(--nb-surface);
}
.policy-panel-head { display: flex; align-items: flex-start; gap: var(--space-md); }
.policy-panel-title-wrap { flex: 1; min-width: 0; }
.policy-panel-desc { display: block; margin-top: var(--space-xs); color: var(--nb-muted); font-size: var(--font-xs); }
.policy-close {
  min-width: 44px;
  min-height: 44px;
  margin: -10rpx -12rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--nb-text-link);
  font-size: var(--font-sm);
}
.policy-close:active { opacity: .7; }
.policy-list { max-height: 58vh; margin-top: var(--space-md); }
.policy-item { margin-bottom: 12rpx; padding: 20rpx; border-radius: var(--radius-sm); background: var(--nb-page); }
.policy-item:last-child { margin-bottom: 0; }
.policy-item-label { display: block; color: var(--nb-ink); font-size: var(--font-sm); font-weight: var(--weight-semibold); }
.policy-item-content { display: block; margin-top: var(--space-xs); color: var(--nb-secondary); font-size: var(--font-sm); line-height: 1.65; }
.comment-composer { width: 100%; padding: 36rpx var(--space-xl) calc(var(--space-xl) + env(safe-area-inset-bottom, 0px)); box-sizing: border-box; border-radius: 32rpx 32rpx 0 0; background: var(--nb-surface); }
.comment-textarea { width: 100%; min-height: 220rpx; margin-top: 28rpx; padding: var(--space-md); box-sizing: border-box; border-radius: var(--input-radius); background: var(--nb-soft-surface); color: var(--nb-ink); font-size: var(--font-sm); line-height: 1.6; }
.modal-handle {
  width: 64rpx;
  height: 8rpx;
  background: var(--nb-page);
  border-radius: 4rpx;
  margin: 0 auto var(--space-lg);
}
.modal-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--warm-text-primary);
  display: block;
}
.modal-actions {
  display: flex;
  gap: var(--space-sm);
  margin-top: var(--space-lg);
}
.modal-cancel, .modal-confirm {
  height: 44px;
  min-height: 44px;
  padding: 0 16px;
  border-radius: 8px;
  font-size: var(--font-md);
  line-height: 1;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}
.modal-cancel {
  width: 30%;
  border: 0;
  color: var(--warm-text-muted);
}
.modal-confirm {
  flex: 1;
  background: var(--nb-action);
  color: var(--nb-surface);
}
.is-disabled { opacity: 0.5; }

.btn-book-main:active, .action-btn:active, .retry-btn:active, .modal-cancel:active, .modal-confirm:active { opacity: 0.85; }

/* ===== P1 真实化：资质 / 环境 / 保障 / FAQ ===== */
.banner-mosaic-fallback {
  background: linear-gradient(145deg, var(--nb-action) 0%, var(--nb-ink) 55%, var(--nb-secondary) 100%);
}
.philosophy-block {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--warm-divider);
}
.philosophy-label {
  display: block;
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--warm-text-primary);
  margin-bottom: var(--space-xs);
}
.philosophy-text {
  font-size: var(--font-sm);
  color: var(--warm-text-secondary);
  line-height: 1.7;
}
.qualification-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}
.qualification-item {
  background: var(--warm-surface);
  border-radius: 16rpx;
  padding: var(--space-md);
}
.qualification-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: var(--space-xs);
}
.qualification-type {
  font-size: var(--font-xs);
  color: var(--warm-text-muted);
}
.qualification-verified {
  font-size: var(--font-xs);
  color: var(--nb-action);
  background: var(--nb-soft-surface);
  border-radius: var(--radius-full);
  padding: 2rpx 12rpx;
}
.qualification-title {
  display: block;
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--warm-text-primary);
  line-height: 1.4;
}
.qualification-detail {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: var(--warm-text-secondary);
  line-height: 1.5;
}
.kv-row {
  display: flex;
  gap: 20rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--warm-divider);
}
.kv-row:last-child { border-bottom: 0; }
.kv-label {
  flex: 0 0 140rpx;
  font-size: var(--font-sm);
  color: var(--warm-text-muted);
}
.kv-value {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--warm-text-secondary);
  line-height: 1.55;
}
.faq-item {
  padding: var(--space-sm) 0;
  border-bottom: 1rpx solid var(--warm-divider);
}
.faq-item:last-child { border-bottom: 0; }
.faq-q {
  display: block;
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--warm-text-primary);
  margin-bottom: var(--space-xs);
}
.faq-a {
  display: block;
  font-size: var(--font-sm);
  color: var(--warm-text-secondary);
  line-height: 1.55;
}

.positioning-text {
  display: block;
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--warm-text-primary);
  line-height: 1.45;
  margin-bottom: 12rpx;
}
.module-empty {
  padding: 18rpx 0 6rpx;
}
.module-empty-text {
  font-size: var(--font-xs);
  color: var(--warm-text-muted);
  line-height: 1.5;
}

.process-list { margin-top: 0; }
.process-item {
  display: flex;
  gap: var(--space-sm);
  padding: 10rpx 0;
}
.process-no {
  flex: 0 0 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--nb-soft-surface);
  color: var(--warm-text-primary);
  font-size: var(--font-xs);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.process-body { flex: 1; }
.process-name {
  display: block;
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--warm-text-primary);
}
.process-desc {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-xs);
  color: var(--warm-text-secondary);
  line-height: 1.45;
}

/* 公开主页精简展示 */
.compact-card { padding: 28rpx 32rpx; border-radius: 24rpx; }
.bio-summary,.review-summary { display:-webkit-box; overflow:hidden; -webkit-box-orient:vertical; -webkit-line-clamp:3; }
.career-summary-row { min-height:64rpx; display:flex; align-items:flex-start; gap:20rpx; padding:10rpx 0; }
.career-summary-row + .career-summary-row { border-top:1rpx solid var(--nb-line); }
.career-summary-key { flex:0 0 132rpx; color:var(--nb-muted); font-size:var(--font-xs); }
.career-summary-value { flex:1; min-width:0; color:var(--nb-ink); font-size:var(--font-sm); line-height:1.5; }
.compact-shop-card { overflow:hidden; }
.shop-summary-image { width:100%; height:360rpx; display:block; }
.compact-review-card { padding: 28rpx 32rpx; border-radius: 24rpx; }
.profile-detail-panel { width:100%; max-height:82vh; padding:28rpx var(--space-lg) calc(28rpx + env(safe-area-inset-bottom)); border-radius:var(--radius-lg) var(--radius-lg) 0 0; background:var(--nb-surface); box-sizing:border-box; }
.profile-detail-head { min-height:44px; display:flex; align-items:center; justify-content:space-between; gap:var(--space-md); }
.profile-detail-close { min-width:44px; min-height:44px; display:flex; align-items:center; justify-content:flex-end; color:var(--nb-text-link); font-size:var(--font-sm); }
.profile-detail-scroll { max-height:calc(82vh - 120rpx); }
.profile-detail-content { padding:20rpx 0 12rpx; }
.detail-info-block { margin-top:var(--space-md); }
.detail-info-label,.detail-info-value { display:block; }
.detail-info-label { color:var(--nb-muted); font-size:var(--font-xs); }
.detail-info-value { margin-top:var(--space-xs); color:var(--nb-ink); font-size:var(--font-sm); line-height:1.65; }
.detail-shop-swiper { width:100%; height:360rpx; margin-bottom:var(--space-md); border-radius:var(--radius-md); overflow:hidden; background:var(--nb-page); }
.detail-shop-image { width:100%; height:100%; }
.detail-link-row { min-height:44px; margin-top:20rpx; display:flex; align-items:center; justify-content:space-between; color:var(--nb-text-link); font-size:var(--font-sm); }
.detail-review-card { margin-bottom:var(--space-sm); }

/* ===== 分态/来源引导 ===== */
.entry-guide {
  margin: var(--space-md) var(--space-xl) 0;
  padding: 18rpx 22rpx;
  border-radius: var(--radius-sm);
  background: var(--nb-soft-surface);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.entry-guide-label {
  font-size: var(--font-xs);
  color: var(--warm-text-muted);
}
.entry-guide-text {
  font-size: var(--font-sm);
  color: var(--warm-text-secondary);
  line-height: 1.5;
}

/* ===== 美甲师微信咨询名片弹层 ===== */
.nb-contact-sheet {
  width: 100%;
  background: var(--nb-surface);
  border-radius: var(--radius-xl, 32rpx) var(--radius-xl, 32rpx) 0 0;
  padding: var(--space-lg, 32rpx) var(--space-lg, 32rpx) calc(var(--space-xl, 40rpx) + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: slideUp 0.25s ease-out;
}

.nb-contact-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-md, 24rpx);
}

.nb-contact-title {
  font-size: var(--font-lg, 36rpx);
  font-weight: var(--weight-bold, 600);
  color: var(--nb-ink);
}

.nb-contact-close {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--nb-muted);
}

.nb-contact-artist-card {
  display: flex;
  align-items: center;
  gap: var(--space-md, 24rpx);
  padding: var(--space-md, 24rpx);
  background: var(--nb-soft-surface);
  border-radius: var(--radius-lg, 24rpx);
  margin-bottom: var(--space-md, 24rpx);
}

.nb-contact-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--nb-page);
}

.nb-contact-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.nb-contact-name {
  font-size: var(--font-md, 30rpx);
  font-weight: var(--weight-semibold, 600);
  color: var(--nb-ink);
}

.nb-contact-sub {
  font-size: var(--font-xs, 24rpx);
  color: var(--nb-muted);
}

.nb-wechat-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md, 24rpx);
  border: 1rpx solid var(--nb-line);
  border-radius: var(--radius-lg, 24rpx);
  margin-bottom: var(--space-lg, 32rpx);
  background: var(--nb-surface);
}

.nb-wechat-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.nb-wechat-label {
  font-size: var(--font-xs, 24rpx);
  color: var(--nb-muted);
}

.nb-wechat-val {
  font-size: var(--font-md, 30rpx);
  font-weight: var(--weight-medium, 500);
  color: var(--nb-ink);
  font-family: monospace;
}

.nb-wechat-val.is-masked {
  font-size: var(--font-sm, 28rpx);
  color: var(--nb-muted);
}

.nb-wechat-copy-btn {
  height: 44px;
  padding: 0 32rpx;
  border-radius: var(--radius-md, 16rpx);
  background: var(--nb-soft-surface);
  color: var(--nb-ink);
  font-size: var(--font-sm, 28rpx);
  font-weight: var(--weight-medium, 500);
  border: 1rpx solid var(--nb-line);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
}

.nb-wechat-copy-btn::after {
  border: none;
}

.nb-wechat-empty {
  padding: var(--space-md, 24rpx);
  background: var(--nb-soft-surface);
  border-radius: var(--radius-lg, 24rpx);
  margin-bottom: var(--space-lg, 32rpx);
  text-align: center;
}

.nb-wechat-empty-text {
  font-size: var(--font-xs, 24rpx);
  color: var(--nb-muted);
}

.nb-contact-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm, 16rpx);
}

.nb-action-btn {
  height: 44px;
  width: 100%;
  border-radius: var(--radius-md, 16rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: var(--font-md, 30rpx);
  font-weight: var(--weight-medium, 500);
  margin: 0;
  box-sizing: border-box;
}

.nb-action-btn::after {
  border: none;
}

.nb-action-primary {
  background: var(--nb-action);
  color: var(--nb-action-text);
}

.nb-action-ghost {
  background: transparent;
  color: var(--nb-muted);
  border: 1rpx solid var(--nb-line);
}

.nb-action-icon {
  width: 36rpx;
  height: 36rpx;
}

@import '../../../styles/booking-actions.wxss';

