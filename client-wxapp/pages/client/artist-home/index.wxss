@import '../../../styles/tokens.wxss';

/* ===== 设计稿暖色调系统 ===== */
page {
  --warm-primary: #C4937A;
  --warm-primary-dark: #A87B63;
  --warm-accent: #D4A29C;
  --warm-accent-light: #F0DDD6;
  --warm-cream: #FDF8F5;
  --warm-surface: #FFFFFF;
  --warm-text-primary: #3D2C23;
  --warm-text-secondary: #8C7B72;
  --warm-text-muted: #B5A69E;
  --warm-divider: #F0E6E0;
  --warm-gold: #C9A96E;
  --warm-gold-light: #F5ECD7;
  --warm-green: #6DBE7B;
  --warm-star: #E8B945;
  
  background: var(--warm-cream);
  color: var(--warm-text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Noto Sans SC', sans-serif;
}

.page { 
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom, 0px);
}

/* ===== Section 通用样式 ===== */
.section-block {
  padding: 0 40rpx;
  margin-top: 48rpx;
}

/* ===== 加载状态 ===== */
.state {
  min-height: 80vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  color: var(--warm-text-muted);
}
.loading-spinner {
  width: 48rpx; height: 48rpx;
  border: 4rpx solid var(--warm-divider);
  border-top-color: var(--warm-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.state-title { font-size: 32rpx; font-weight: 600; color: var(--warm-text-primary); }
.retry-btn {
  padding: 16rpx 48rpx;
  border: 2rpx solid var(--warm-primary);
  border-radius: 48rpx;
  color: var(--warm-primary);
  font-size: 28rpx;
  font-weight: 500;
}

/* ===== Banner 区域 ===== */
.banner-section {
  position: relative;
  height: 440rpx;
  overflow: hidden;
}
.banner-mosaic {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  position: absolute;
  inset: 0;
  filter: blur(40rpx);
  transform: scale(1.15);
}
.mosaic-img { width: 100%; height: 100%; object-fit: cover; }
.banner-overlay {
  position: absolute;
  inset: 0;
  background: rgba(196, 147, 122, 0.25);
}
.banner-gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(253,248,245,0.1) 0%, rgba(253,248,245,0.05) 40%, rgba(253,248,245,0.6) 100%);
}
.banner-content {
  position: relative;
  z-index: 10;
  padding: 40rpx 40rpx;
  height: 100%;
  display: flex;
  align-items: center;
}
.artist-info-row {
  display: flex;
  align-items: flex-start;
  gap: 32rpx;
}
.avatar-wrap {
  position: relative;
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  overflow: visible;
  flex-shrink: 0;
}
.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 6rpx solid rgba(255,255,255,0.9);
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.15);
}
.avatar-fallback {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 6rpx solid rgba(255,255,255,0.9);
  background: var(--warm-accent-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: var(--warm-primary);
  font-weight: 600;
}
.online-dot {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  width: 28rpx;
  height: 28rpx;
  background: var(--warm-green);
  border-radius: 50%;
  border: 5rpx solid #fff;
}
.artist-detail {
  flex: 1;
  min-width: 0;
  padding-top: 8rpx;
}
.name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.artist-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}
.badge-gold {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #F5ECD7 0%, #E8D5B0 100%);
  color: #9A7D4E;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 24rpx;
}
.badge-icon { font-size: 18rpx; }
.meta-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.92);
  margin-bottom: 24rpx;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.2);
}
.meta-icon { width: 28rpx; height: 28rpx; filter: drop-shadow(0 1rpx 2rpx rgba(0,0,0,0.25)); }
.meta-divider { opacity: 0.6; margin: 0 4rpx; }
.btn-book-now {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #C4937A 0%, #D4A29C 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  min-width: 220rpx;
  box-shadow: 0 4rpx 16rpx rgba(196, 147, 122, 0.35);
}
.btn-icon-svg { width: 30rpx; height: 30rpx; flex-shrink: 0; }
.btn-text { line-height: 1; }

/* ===== 统计概览 ===== */
.stats-section {
  padding: 0 40rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 20;
}
.stats-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx 16rpx;
  box-shadow: 0 4rpx 24rpx rgba(61, 44, 35, 0.08);
  display: flex;
  align-items: center;
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--warm-text-primary);
  font-family: 'Georgia', serif;
}
.stat-unit { font-size: 28rpx; }
.stat-label {
  display: block;
  font-size: 20rpx;
  color: var(--warm-text-muted);
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}
.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: var(--warm-divider);
}

/* ===== 通用 Section ===== */
.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.section-bar {
  width: 6rpx;
  height: 32rpx;
  border-radius: 3rpx;
  background: var(--warm-primary);
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--warm-text-primary);
  flex: 1;
}
.section-more {
  font-size: 24rpx;
  color: var(--warm-text-muted);
}

/* ===== 关于我 ===== */
.about-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 24rpx rgba(61, 44, 35, 0.06);
}
.bio-text {
  font-size: 26rpx;
  color: var(--warm-text-secondary);
  line-height: 1.8;
}
.timeline-section {
  margin-top: 40rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid var(--warm-divider);
}
.timeline-label {
  font-size: 22rpx;
  color: var(--warm-text-muted);
  font-weight: 500;
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
}
.timeline-list { padding-left: 8rpx; }
.timeline-item {
  position: relative;
  padding-left: 40rpx;
  padding-bottom: 28rpx;
}
.timeline-item:last-child { padding-bottom: 0; }
.timeline-dot {
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 4rpx solid var(--warm-primary);
  background: var(--warm-cream);
  z-index: 2;
}
.timeline-line {
  position: absolute;
  left: 11rpx;
  top: 32rpx;
  bottom: 0;
  width: 2rpx;
  background: linear-gradient(to bottom, var(--warm-primary), var(--warm-accent-light));
}
.timeline-year {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--warm-primary);
}
.timeline-desc {
  display: block;
  font-size: 24rpx;
  color: var(--warm-text-secondary);
  margin-top: 6rpx;
}

/* ===== 精选作品 ===== */
.gallery-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.gallery-item {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  aspect-ratio: 3/4;
}
.gallery-img {
  width: 100%;
  height: 100%;
  display: block;
}
.gallery-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.4));
}
.gallery-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(8rpx);
  border-radius: 24rpx;
  font-size: 20rpx;
  color: var(--warm-text-primary);
}

/* ===== 擅长风格 ===== */
.style-scroll {
  white-space: nowrap;
  margin: 0 -40rpx;
  padding: 0 40rpx;
}
.style-list {
  display: inline-flex;
  gap: 20rpx;
  padding-right: 40rpx;
}
.style-card {
  position: relative;
  width: 224rpx;
  height: 288rpx;
  border-radius: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.style-card-bg {
  position: absolute;
  inset: 0;
}
.style-card-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 30%, rgba(61, 44, 35, 0.55) 100%);
}
.style-card-text {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

/* ===== 服务内容 ===== */
.service-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.service-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(61, 44, 35, 0.06);
  display: flex;
  align-items: flex-start;
  gap: 28rpx;
}
.service-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: var(--warm-accent-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.service-icon-svg { width: 44rpx; height: 44rpx; }
.service-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 12rpx; }
.service-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.service-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--warm-text-primary);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.service-right-meta {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
}
.service-price {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--warm-primary);
  letter-spacing: 0.2rpx;
}
.service-desc {
  font-size: 22rpx;
  color: var(--warm-text-muted);
  line-height: 1.6;
}
.service-duration {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  color: var(--warm-text-muted);
  padding: 4rpx 12rpx;
  background: var(--warm-accent-light);
  border-radius: 999rpx;
}
.duration-icon-svg { width: 20rpx; height: 20rpx; opacity: 0.85; }

/* ===== 店铺信息 ===== */
.shop-card {
  background: #fff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(61, 44, 35, 0.06);
}
.map-placeholder {
  height: 256rpx;
  position: relative;
  background: linear-gradient(135deg, #F5E6DC 0%, #E8D5C4 50%, #F0DDD6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}
.map-grid {
  width: 384rpx;
  height: 160rpx;
  opacity: 0.2;
  background: 
    repeating-linear-gradient(0deg, var(--warm-primary) 0px, var(--warm-primary) 1px, transparent 1px, transparent 32rpx),
    repeating-linear-gradient(90deg, var(--warm-primary) 0px, var(--warm-primary) 1px, transparent 1px, transparent 32rpx);
}
.map-pin {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -100%);
}
.map-pin-icon { width: 64rpx; height: 64rpx; filter: drop-shadow(0 4rpx 8rpx rgba(196, 147, 122, 0.35)); }
.shop-info { padding: 28rpx 32rpx 24rpx; }
.shop-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--warm-text-primary);
  display: block;
  margin-bottom: 18rpx;
}
.shop-detail-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.shop-detail-row:last-of-type { margin-bottom: 0; }
.shop-address-content { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.detail-icon-svg {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
  opacity: 0.9;
}
.detail-text {
  font-size: 24rpx;
  color: var(--warm-text-secondary);
  line-height: 1.6;
}
.guidance-entry-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8rpx;
  height: 48rpx;
  padding: 0;
  box-sizing: border-box;
  margin-top: 4rpx;
  background: transparent;
}
.guidance-entry-row::before { content: ''; position: absolute; top: -20rpx; right: 0; bottom: -20rpx; left: 0; }
.guidance-entry-row:active { opacity: 0.7; }
.guidance-entry-text {
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
  color: var(--brand-primary);
}
.guidance-entry-arrow {
  font-size: var(--font-sm);
  color: var(--brand-primary);
}
.shop-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}
.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 88rpx;
  padding: 0;
  background: var(--warm-accent-light);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: var(--warm-primary);
  font-weight: 600;
  border: none;
}
.action-icon-svg { width: 30rpx; height: 30rpx; flex-shrink: 0; }

/* ===== 客户评价 ===== */
.review-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.review-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(61, 44, 35, 0.06);
}
.review-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.review-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.review-avatar-fallback {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--warm-accent-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--warm-primary);
  font-weight: 600;
  flex-shrink: 0;
}
.review-meta { flex: 1; }
.review-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.review-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--warm-text-primary);
}
.review-time {
  font-size: 20rpx;
  color: var(--warm-text-muted);
}
.review-stars {
  display: flex;
  gap: 4rpx;
  margin-top: 8rpx;
}
.star { font-size: 20rpx; color: #ddd; }
.star-filled { color: var(--warm-star); }
.review-content {
  font-size: 24rpx;
  color: var(--warm-text-secondary);
  line-height: 1.8;
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(40rpx);
  box-shadow: 0 -4rpx 24rpx rgba(61, 44, 35, 0.08);
}
.bottom-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 48rpx;
  padding: 12rpx 32rpx 0;
  transform: translateY(12rpx);
}
.bottom-actions {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.action-icon-btn {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  width: 96rpx;
  background: transparent;
  border: none;
  padding: 0;
  line-height: 1;
}
.action-icon-btn::before {
  content: '';
  position: absolute;
  top: -18rpx;
  right: 0;
  bottom: -18rpx;
  left: 0;
}
.action-icon-btn::after { border: none; }
.social-icon-svg { width: 40rpx; height: 40rpx; }
.count-label {
  font-size: 20rpx;
  color: var(--warm-text-muted);
  line-height: 1;
}
.action-icon-btn.favorited .count-label { color: #e74c3c; font-weight: 600; }
.action-icon-btn.followed .count-label { color: var(--warm-primary); font-weight: 600; }
.action-icon-btn.liked .count-label { color: #f59e0b; font-weight: 600; }
.btn-book-main {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 20rpx 32rpx;
  background: linear-gradient(135deg, #C4937A 0%, #D4A29C 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 48rpx;
  border: none;
  min-height: 88rpx;
  box-shadow: 0 8rpx 24rpx rgba(196, 147, 122, 0.35);
}
.safe-area-bottom {
  height: env(safe-area-inset-bottom, 0px);
}

/* ===== 空状态 ===== */
.empty-hint {
  padding: 80rpx 0;
  text-align: center;
  color: var(--warm-text-muted);
  font-size: 26rpx;
}

/* ===== 绑定弹窗 ===== */
.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: flex-end;
}
.modal-panel {
  width: 100%;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 32rpx 48rpx calc(48rpx + env(safe-area-inset-bottom, 0px));
}
.modal-handle {
  width: 64rpx;
  height: 8rpx;
  background: #ddd;
  border-radius: 4rpx;
  margin: 0 auto 32rpx;
}
.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--warm-text-primary);
  display: block;
}
.modal-desc {
  font-size: 24rpx;
  color: var(--warm-text-muted);
  margin-top: 16rpx;
  display: block;
  line-height: 1.6;
}
.modal-input-row {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}
.modal-input {
  flex: 1;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--warm-divider);
  border-radius: 16rpx;
  font-size: 28rpx;
}
.modal-verify-btn {
  width: 160rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--warm-accent-light);
  border-radius: 16rpx;
  color: var(--warm-primary);
  font-size: 28rpx;
  font-weight: 600;
}
.modal-success {
  margin-top: 20rpx;
  color: var(--warm-green);
  font-size: 24rpx;
}
.modal-error {
  display: block;
  margin-top: 16rpx;
  color: #e74c3c;
  font-size: 24rpx;
}
.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}
.modal-cancel, .modal-confirm {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.modal-cancel {
  width: 30%;
  border: 2rpx solid var(--warm-divider);
  color: var(--warm-text-muted);
}
.modal-confirm {
  flex: 1;
  background: linear-gradient(135deg, #C4937A 0%, #D4A29C 100%);
  color: #fff;
}
.is-disabled { opacity: 0.5; }
