page { background: var(--bg-card); color:#282326; }
.page { min-height:100vh; padding:28rpx 30rpx calc(60rpx + env(safe-area-inset-bottom)); box-sizing:border-box; }
.state { min-height:520rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:24rpx; color:#81777c; font-size: var(--font-sm); }
.state-title { color:#342d31; font-size: var(--font-md); font-weight: var(--weight-semibold); }
.retry { min-height:88rpx; padding:0 38rpx; display:flex; align-items:center; border:1rpx solid #ded7db; border-radius: var(--radius-xl); color:#9d466d; }
.profile-head { display:flex; align-items:center; gap:24rpx; }
.avatar { width:142rpx; height:142rpx; border-radius:50%; flex-shrink:0; background:#f3edf0; }
.avatar-fallback { display:flex; align-items:center; justify-content:center; color:#a85678; font-size:46rpx; font-weight: var(--weight-semibold); }
.identity { flex:1; min-width:0; display:flex; flex-direction:column; gap:10rpx; }
.name { color:#282326; font-size: var(--font-lg); font-weight: var(--weight-bold); }
.location { color:#7b7176; font-size: var(--font-xs); line-height:1.45; }
.book-btn { min-width:116rpx; min-height:72rpx; display:flex; align-items:center; justify-content:center; border:2rpx solid #b54f79; border-radius:38rpx; color:#a34269; font-size: var(--font-sm); font-weight: var(--weight-semibold); }
.bio { display:block; margin-top:30rpx; color:#4d4549; font-size: var(--font-sm); line-height:1.7; }
.tags { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:20rpx; }
.tag { padding:9rpx 18rpx; border-radius:22rpx; background:#fff1f5; color:#9d466d; font-size: var(--font-xs); }
.tag-muted { background:#f4f1f3; color:#70666b; }
.stats { display:flex; margin:34rpx 0 30rpx; padding: var(--space-md) 0; border-top:1rpx solid #eee9eb; border-bottom:1rpx solid #eee9eb; }
.stat { flex:1; display:flex; align-items:center; justify-content:center; gap:10rpx; }
.stat-value { color:#2f292c; font-size: var(--font-md); font-weight: var(--weight-bold); }
.stat-label { color:#8a8085; font-size: var(--font-xs); }
.section-head { min-height:88rpx; display:flex; align-items:center; justify-content:space-between; }
.section-title { font-size: var(--font-md); font-weight: var(--weight-bold); }
.section-count { color:#91878c; font-size: var(--font-xs); }
.empty { padding:120rpx 0; text-align:center; color:#968c91; font-size: var(--font-sm); }
.waterfall { display:flex; align-items:flex-start; gap:16rpx; }
.column { flex:1; display:flex; flex-direction:column; gap:24rpx; min-width:0; }
.work-card { overflow:hidden; }
.work-image { width:100%; display:block; border-radius: var(--card-radius); background:#f3eff1; }
.work-tall { height:430rpx; }.work-standard { height:370rpx; }.work-wide { height:320rpx; }
.work-title { display:block; margin-top:12rpx; color:#393236; font-size: var(--font-sm); font-weight: var(--weight-semibold); line-height:1.35; }
.work-tags { display:block; margin-top:6rpx; color:#92878d; font-size: var(--font-xs); line-height:1.4; }
.work-card:active,.book-btn:active,.retry:active { opacity:.68; }
