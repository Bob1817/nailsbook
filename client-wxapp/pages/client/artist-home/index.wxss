@import '../../../styles/tokens.wxss';

/* ===== 设计稿暖色调系统 ===== */
page {
  --warm-primary: var(--nb-action);
  --warm-primary-dark: var(--nb-action);
  --warm-accent: var(--nb-action);
  --warm-accent-light: var(--nb-line);
  --warm-cream: var(--nb-page);
  --warm-surface: var(--nb-surface);
  --warm-text-primary: var(--nb-ink);
  --warm-text-secondary: var(--nb-muted);
  --warm-text-muted: var(--nb-muted);
  --warm-divider: var(--nb-line);
  --warm-gold: var(--nb-action);
  --warm-gold-light: var(--nb-line);
  --warm-green: var(--nb-action);
  --warm-star: var(--nb-action);
  
  background: var(--warm-cream);
  color: var(--warm-text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Noto Sans SC', sans-serif;
}

.page { 
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom, 0px);
}

/* ===== Section 通用样式 ===== */
.section-block {
  padding: 0 40rpx;
  margin-top: 48rpx;
}

/* ===== 加载状态 ===== */
.state {
  min-height: 80vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  color: var(--warm-text-muted);
}
.loading-spinner {
  width: 48rpx; height: 48rpx;
  border: 4rpx solid var(--warm-divider);
  border-top-color: var(--warm-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.state-title { font-size: 32rpx; font-weight: 600; color: var(--warm-text-primary); }
.retry-btn {
  display: flex;
  align-items: center;
  justify-content: center;  height: 44px;
  min-height: 44px;
  padding: 0 16px;
  border-radius: 8px;
  font-size: 14px;
  line-height: 1;
  box-sizing: border-box;
  border: 0;
  color: var(--warm-primary);
  font-weight: 500;
 background: var(--nb-soft-surface);}

/* ===== Banner 区域 ===== */
.banner-section {
  position: relative;
  height: 360rpx;
  overflow: hidden;
}
.hero-background {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.banner-mosaic {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  position: absolute;
  inset: 0;
  filter: blur(40rpx);
  transform: scale(1.15);
}
.mosaic-img { width: 100%; height: 100%; object-fit: cover; }
.banner-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.14);
}
.banner-gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.02) 20%, rgba(0, 0, 0, 0.66) 100%);
}
.banner-content {
  position: relative;
  z-index: 10;
  padding: 0 40rpx 32rpx;
  height: 100%;
  display: flex;
  align-items: flex-end;
  box-sizing: border-box;
}
.artist-info-row {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.avatar-wrap {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  overflow: visible;
  flex-shrink: 0;
}
.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 0;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.15);
}
.avatar-fallback {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 0;
  background: var(--warm-accent-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: var(--warm-primary);
  font-weight: 600;
}
.online-dot {
  position: absolute;
  bottom: 2rpx;
  right: 2rpx;
  width: 20rpx;
  height: 20rpx;
  background: var(--nb-success);
  border-radius: 50%;
  border: 4rpx solid var(--nb-surface);
}
.artist-detail {
  flex: 1;
  min-width: 0;
}
.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}
.artist-name {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--nb-surface);
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}

.certification-line {
  display: block;
  margin: 0 0 6rpx;
  color: var(--nb-inverse);
  font-size: var(--font-xs);
  line-height: 1.4;
  opacity: .88;
}
.badge-gold {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  background: var(--nb-action);
  color: var(--nb-inverse);
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 24rpx;
}
.badge-icon { font-size: 18rpx; }
.meta-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
  font-size: var(--font-sm);
  color: rgba(255,255,255,0.92);
  margin-bottom: 0;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.2);
}
.meta-icon { width: 28rpx; height: 28rpx; filter: drop-shadow(0 1rpx 2rpx rgba(0,0,0,0.25)); }
.meta-divider { opacity: 0.6; margin: 0 4rpx; }
.btn-book-now {
  height: 44px;
  min-height: 44px;
  padding: 0 16px;
  border-radius: 8px;
  font-size: 14px;
  line-height: 1;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: var(--nb-action);
  color: var(--nb-surface);
  font-weight: 600;
  border: none;
  width: 100%;
  max-width: 184px;
  min-width: 0;
  margin: 0;
  margin-top: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.35);
}
.btn-icon-svg { width: 18px; height: 18px; flex-shrink: 0; filter: brightness(0) invert(1); }
.btn-text { line-height: 1; }

/* ===== 统计概览 ===== */
.stats-section {
  padding: 0 40rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 20;
}
.stats-card {
  background: var(--nb-surface);
  border-radius: 32rpx;
  padding: 32rpx 16rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--warm-text-primary);
  font-family: 'Georgia', serif;
}
.stat-unit { font-size: 28rpx; }
.stat-label {
  display: block;
  font-size: 20rpx;
  color: var(--warm-text-muted);
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}
.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: var(--warm-divider);
}

/* ===== 通用 Section ===== */
.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.section-bar {
  width: 6rpx;
  height: 32rpx;
  border-radius: 3rpx;
  background: var(--warm-primary);
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--warm-text-primary);
  flex: 1;
}
.section-more {
  font-size: 24rpx;
  color: var(--nb-text-link);
}

/* ===== 关于我 ===== */
.about-card {
  background: var(--nb-surface);
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}
.bio-text {
  font-size: 26rpx;
  color: var(--warm-text-secondary);
  line-height: 1.8;
}
.timeline-section {
  margin-top: 40rpx;
  padding-top: 32rpx;
  border-top: 0;
}
.timeline-label {
  font-size: 22rpx;
  color: var(--warm-text-muted);
  font-weight: 500;
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
}
.timeline-list { padding-left: 8rpx; }
.timeline-item {
  position: relative;
  padding-left: 40rpx;
  padding-bottom: 28rpx;
}
.timeline-item:last-child { padding-bottom: 0; }
.timeline-dot {
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 4rpx solid var(--warm-primary);
  background: var(--warm-cream);
  z-index: 2;
}
.timeline-line {
  position: absolute;
  left: 11rpx;
  top: 32rpx;
  bottom: 0;
  width: 2rpx;
  background: linear-gradient(to bottom, var(--warm-primary), var(--warm-accent-light));
}
.timeline-year {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--warm-primary);
}
.timeline-desc {
  display: block;
  font-size: 24rpx;
  color: var(--warm-text-secondary);
  margin-top: 6rpx;
}

/* ===== 精选作品 ===== */
.gallery-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.gallery-item {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  aspect-ratio: 3/4;
}
.gallery-img {
  width: 100%;
  height: 100%;
  display: block;
}
.gallery-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.4));
}
.gallery-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(8rpx);
  border-radius: 24rpx;
  font-size: 20rpx;
  color: var(--warm-text-primary);
}

/* ===== 擅长风格 ===== */
.style-scroll {
  white-space: nowrap;
  margin: 0 -40rpx;
  padding: 0 40rpx;
}
.style-list {
  display: inline-flex;
  gap: 20rpx;
  padding-right: 40rpx;
}
.style-card {
  position: relative;
  width: 224rpx;
  height: 288rpx;
  border-radius: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.style-card-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.style-card-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 30%, rgba(0, 0, 0, 0.55) 100%);
}
.style-card-text {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  color: var(--nb-surface);
  font-size: 24rpx;
  font-weight: 600;
}
.style-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.style-chip {
  display: inline-flex;
  align-items: center;
  min-height: 64rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--warm-divider);
  border-radius: var(--radius-sm);
  background: var(--nb-surface);
  color: var(--warm-text-secondary);
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  box-sizing: border-box;
}

/* ===== 服务内容 ===== */
.service-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.service-card {
  background: var(--nb-surface);
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: flex-start;
  gap: 28rpx;
}
.service-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: var(--warm-accent-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.service-icon-svg { width: 44rpx; height: 44rpx; }
.service-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 12rpx; }
.service-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.service-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--warm-text-primary);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.service-right-meta {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
}
.service-price {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--nb-money);
  letter-spacing: 0.2rpx;
}
.service-desc {
  font-size: 22rpx;
  color: var(--warm-text-muted);
  line-height: 1.6;
}
.service-duration {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  color: var(--warm-text-muted);
  padding: 4rpx 12rpx;
  background: var(--warm-accent-light);
  border-radius: 999rpx;
}
.duration-icon-svg { width: 20rpx; height: 20rpx; opacity: 0.85; }

/* ===== 店铺信息 ===== */
.shop-card {
  background: var(--nb-surface);
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}
.shop-hero-wrap {
  position: relative;
  background: var(--nb-page);
}
.shop-hero {
  width: 100%;
  height: 360rpx;
}
.shop-hero-slide,
.shop-hero-image {
  width: 100%;
  height: 100%;
}
.shop-hero-slide {
  position: relative;
}
.shop-hero-image {
  display: block;
}
.shop-hero-overlay {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  padding: 56rpx 24rpx 20rpx;
  background: linear-gradient(transparent, var(--bg-overlay));
}
.shop-hero-tag {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-overlay);
  color: var(--nb-inverse);
  font-size: var(--font-xs);
}
.shop-hero-caption {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--nb-inverse);
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  text-overflow: ellipsis;
  white-space: nowrap;
}
.shop-hero-count {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 6rpx 12rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-overlay);
  color: var(--nb-inverse);
  font-size: var(--font-xs);
  line-height: 1.4;
}
.shop-info { padding: 28rpx 32rpx 24rpx; }
.shop-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--warm-text-primary);
  display: block;
  margin-bottom: 18rpx;
}
.shop-detail-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.shop-detail-row:last-of-type { margin-bottom: 0; }
.shop-address-content {
  flex: 1;
  min-width: 0;
  display: block;
}
.detail-icon-svg {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
  opacity: 0.9;
}
.detail-text {
  font-size: 24rpx;
  color: var(--warm-text-secondary);
  line-height: 1.6;
}
.guidance-entry-inline {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 44px;
  padding: 0;
  box-sizing: border-box;
  margin-left: 16rpx;
  vertical-align: middle;
  background: transparent;
}
.guidance-entry-inline::before { content: ''; position: absolute; inset: 0 -12rpx; }
.guidance-entry-inline:active { opacity: 0.7; }
.guidance-entry-text {
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
  color: var(--nb-text-link);
}
.guidance-entry-arrow {
  font-size: var(--font-sm);
  color: var(--nb-text-link);
}
.shop-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}
.action-btn {
  width: 0;
  min-width: 0;
  margin: 0;  height: 44px;
  min-height: 44px;
  padding: 0 16px;
  border-radius: 8px;
  font-size: 14px;
  line-height: 1;
  box-sizing: border-box;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: var(--warm-accent-light);
  color: var(--warm-primary);
  font-weight: 600;
  border: none;
}
.action-icon-svg { width: 18px; height: 18px; flex-shrink: 0; }

/* ===== 客户评价 ===== */
.review-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.review-card {
  background: var(--nb-surface);
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}
.review-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.review-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.review-avatar-fallback {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--warm-accent-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--warm-primary);
  font-weight: 600;
  flex-shrink: 0;
}
.review-meta { flex: 1; }
.review-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.review-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--warm-text-primary);
}
.review-time {
  font-size: 20rpx;
  color: var(--warm-text-muted);
}
.review-stars {
  display: flex;
  gap: 4rpx;
  margin-top: 8rpx;
}
.star { font-size: 20rpx; color: var(--nb-muted); }
.star-filled { color: var(--warm-star); }
.review-content {
  font-size: 24rpx;
  color: var(--warm-text-secondary);
  line-height: 1.8;
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(40rpx);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.08);
}
.bottom-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 48rpx;
  padding: 12rpx 32rpx 0;
  transform: translateY(12rpx);
}
.bottom-actions {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.action-icon-btn {
  min-height: 44px;  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  width: 96rpx;
  background: transparent;
  border: none;
  padding: 0;
  line-height: 1;
}
.action-icon-btn::before {
  content: '';
  position: absolute;
  top: -18rpx;
  right: 0;
  bottom: -18rpx;
  left: 0;
}
.action-icon-btn::after { border: none; }
.social-icon-svg { width: 40rpx; height: 40rpx; }
.count-label {
  font-size: 20rpx;
  color: var(--warm-text-muted);
  line-height: 1;
}
.action-icon-btn.favorited .count-label { color: var(--nb-ink); font-weight: 600; }
.action-icon-btn.followed .count-label { color: var(--warm-primary); font-weight: 600; }
.action-icon-btn.liked .count-label { color: var(--nb-ink); font-weight: 600; }
.btn-book-main {
  width: 0;
  min-width: 0;
  margin: 0;  height: 44px;
  min-height: 44px;
  padding: 0 16px;
  border-radius: 8px;
  font-size: 14px;
  line-height: 1;
  box-sizing: border-box;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: var(--nb-action);
  color: var(--nb-surface);
  font-weight: 700;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.35);
}
.btn-edit-homepage { width:100%; min-height:88rpx; margin:0; padding:0 32rpx; border:0; border-radius:var(--btn-radius); background:var(--nb-action); color:var(--text-inverse); display:flex; align-items:center; justify-content:center; gap:12rpx; font-size:var(--font-md); font-weight:var(--weight-medium); box-sizing:border-box; }
.btn-edit-homepage::after { border:0; }.btn-edit-homepage:active { background:var(--nb-action-pressed); }
.safe-area-bottom {
  height: env(safe-area-inset-bottom, 0px);
}

/* ===== 空状态 ===== */
.empty-hint {
  padding: 80rpx 0;
  text-align: center;
  color: var(--warm-text-muted);
  font-size: 26rpx;
}

/* ===== 绑定弹窗 ===== */
.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: flex-end;
}
.modal-panel {
  width: 100%;
  background: var(--nb-surface);
  border-radius: 40rpx 40rpx 0 0;
  padding: 32rpx 48rpx calc(48rpx + env(safe-area-inset-bottom, 0px));
}
.modal-handle {
  width: 64rpx;
  height: 8rpx;
  background: var(--nb-page);
  border-radius: 4rpx;
  margin: 0 auto 32rpx;
}
.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--warm-text-primary);
  display: block;
}
.modal-desc {
  font-size: 24rpx;
  color: var(--warm-text-muted);
  margin-top: 16rpx;
  display: block;
  line-height: 1.6;
}
.modal-input-row {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}
.modal-input {
  flex: 1;
  min-width: 0;
  height: var(--input-height);
  min-height: 44px;
  box-sizing: border-box;
  padding: 0 var(--input-padding-h);
  border: 0;
  border-radius: var(--input-radius);
  font-size: var(--font-sm);
 background: var(--nb-soft-surface);}
.modal-placeholder { font-size: var(--font-sm); color: var(--nb-muted); }
.modal-verify-btn {
  height: 44px;
  min-height: 44px;
  padding: 0 16px;
  border-radius: 8px;
  font-size: 14px;
  line-height: 1;
  box-sizing: border-box;
  width: 160rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--warm-accent-light);
  color: var(--warm-primary);
  font-weight: 600;
}
.modal-success {
  margin-top: 20rpx;
  color: var(--warm-green);
  font-size: 24rpx;
}
.modal-error {
  display: block;
  margin-top: 16rpx;
  color: var(--nb-ink);
  font-size: 24rpx;
}
.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}
.modal-cancel, .modal-confirm {
  height: 44px;
  min-height: 44px;
  padding: 0 16px;
  border-radius: 8px;
  font-size: 14px;
  line-height: 1;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}
.modal-cancel {
  width: 30%;
  border: 0;
  color: var(--warm-text-muted);
}
.modal-confirm {
  flex: 1;
  background: var(--nb-action);
  color: var(--nb-surface);
}
.is-disabled { opacity: 0.5; }

.btn-book-now:active, .btn-book-main:active, .action-btn:active, .retry-btn:active, .modal-verify-btn:active, .modal-cancel:active, .modal-confirm:active { opacity: 0.85; }

/* ===== P1 真实化：资质 / 环境 / 保障 / FAQ ===== */
.banner-mosaic-fallback {
  background: linear-gradient(145deg, var(--nb-action) 0%, var(--nb-ink) 55%, var(--nb-secondary) 100%);
}
.philosophy-block {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--warm-divider);
}
.philosophy-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--warm-text-primary);
  margin-bottom: 8rpx;
}
.philosophy-text {
  font-size: 26rpx;
  color: var(--warm-text-secondary);
  line-height: 1.7;
}
.qualification-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.qualification-item {
  background: var(--warm-surface);
  border-radius: 16rpx;
  padding: 24rpx;
}
.qualification-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.qualification-type {
  font-size: 22rpx;
  color: var(--warm-text-muted);
}
.qualification-verified {
  font-size: 20rpx;
  color: var(--nb-action);
  background: var(--nb-soft-surface);
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
}
.qualification-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--warm-text-primary);
  line-height: 1.4;
}
.qualification-detail {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--warm-text-secondary);
  line-height: 1.5;
}
.kv-row {
  display: flex;
  gap: 20rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--warm-divider);
}
.kv-row:last-child { border-bottom: 0; }
.kv-label {
  flex: 0 0 140rpx;
  font-size: 24rpx;
  color: var(--warm-text-muted);
}
.kv-value {
  flex: 1;
  font-size: 26rpx;
  color: var(--warm-text-secondary);
  line-height: 1.55;
}
.faq-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--warm-divider);
}
.faq-item:last-child { border-bottom: 0; }
.faq-q {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--warm-text-primary);
  margin-bottom: 8rpx;
}
.faq-a {
  display: block;
  font-size: 24rpx;
  color: var(--warm-text-secondary);
  line-height: 1.55;
}

.positioning-text {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--warm-text-primary);
  line-height: 1.45;
  margin-bottom: 12rpx;
}
.module-empty {
  padding: 18rpx 0 6rpx;
}
.module-empty-text {
  font-size: 22rpx;
  color: var(--warm-text-muted);
  line-height: 1.5;
}

.process-list { margin-top: 8rpx; }
.process-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--warm-text-primary);
  margin: 8rpx 0 12rpx;
}
.process-item {
  display: flex;
  gap: 16rpx;
  padding: 10rpx 0;
}
.process-no {
  flex: 0 0 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--nb-soft-surface);
  color: var(--warm-text-primary);
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.process-body { flex: 1; }
.process-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--warm-text-primary);
}
.process-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--warm-text-secondary);
  line-height: 1.45;
}

/* ===== 分态/来源引导 ===== */
.entry-guide {
  margin: 24rpx 40rpx 0;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  background: var(--nb-soft-surface);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.entry-guide-label {
  font-size: 20rpx;
  color: var(--warm-text-muted);
}
.entry-guide-text {
  font-size: 24rpx;
  color: var(--warm-text-secondary);
  line-height: 1.5;
}

