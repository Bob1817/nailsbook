<nav-bar title="美甲师主页" showBack/>
<view wx:if="{{previewMode}}" class="preview-mode-bar"><text>主页预览模式</text><view class="edit-chip" bindtap="editSection" data-section="profile">编辑基础资料</view></view>
<view class="page">
  <view wx:if="{{loading}}" class="state">正在加载主页...</view>
  <view wx:elif="{{loadFailed}}" class="state">
    <text class="state-title">主页加载失败</text>
    <view class="retry" bindtap="loadHome">重新加载</view>
  </view>
  <block wx:else>

<!-- 封面图区域 -->
<view class="cover-area">
  <image wx:if="{{artist.coverImageUrl}}" class="cover-image" src="{{artist.coverImageUrl}}" mode="aspectFill"/>
  <view wx:else class="cover-gradient"></view>
  <view class="cover-overlay"></view>
  <view class="cover-content">
    <view class="avatar-row">
      <view class="avatar-wrap">
        <image wx:if="{{artist.avatarUrl}}" class="avatar-img" src="{{artist.avatarUrl}}" mode="aspectFill"/>
        <view wx:else class="avatar-fallback">{{artist.initial}}</view>
        <view wx:if="{{artist.isVerified}}" class="verified-badge">
          <image src="/static/icons/check-circle.svg"/>
        </view>
      </view>
      <view class="avatar-info">
        <view class="name-row">
          <text class="artist-name">{{artist.name}}</text>
        </view>
        <text class="artist-subtitle">{{artist.subtitle || '专业美甲师'}}</text>
        <view class="status-row">
          <view class="status-dot {{artist.status === 'active' ? 'dot-active' : ''}}"></view>
          <text class="status-text">{{artist.status === 'active' ? '可预约' : '休息中'}}</text>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{previewMode}}" class="hero-edit" bindtap="editSection" data-section="hero">编辑封面</view>
</view>

    <!-- 专业标签（始终显示） -->
    <view class="tags-bar">
      <text wx:for="{{displayTags}}" wx:key="*this" class="tag-chip">{{item}}</text>
    </view>

    <!-- 核心数据 -->
    <view class="stats-bar">
      <view class="stat-item">
        <text class="stat-num">{{artist.followerCount || 0}}</text>
        <text class="stat-label">关注</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{artist.likeCount || 0}}</text>
        <text class="stat-label">点赞</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{artist.favoriteCount || 0}}</text>
        <text class="stat-label">收藏</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num accent">{{artist.rating || '暂无'}}</text>
        <text class="stat-label">评分</text>
      </view>
    </view>

    <!-- 关于我（始终显示） -->
    <view class="section">
      <text class="section-title">关于我</text>
      <text class="bio-text">{{artist.bio || '该美甲师还未自我介绍哦～'}}</text>
    </view>

    <!-- 服务内容 -->
    <view class="section section-gray">
      <text class="section-title">服务内容</text>
      <view class="capsule-tags">
        <text wx:for="{{serviceItems}}" wx:key="*this" class="capsule-tag">{{item}}</text>
      </view>

      <!-- 擅长风格 -->
      <view wx:if="{{artist.styleTags.length}}" class="sub-section">
        <text class="sub-title">擅长风格</text>
        <view class="capsule-tags">
          <text wx:for="{{artist.styleTags}}" wx:key="*this" class="capsule-tag style-tag">{{item}}</text>
        </view>
      </view>

      <!-- 服务理念 -->
      <view wx:if="{{artist.servicePhilosophy}}" class="philosophy-box">
        <text class="philosophy-text">"{{artist.servicePhilosophy}}"</text>
      </view>
    </view>

    <!-- 店铺信息 -->
    <view class="section">
      <text class="section-title">店铺信息</text>
      <block wx:if="{{artist.shopAddresses.length}}">
        <view wx:for="{{artist.shopAddresses}}" wx:key="id" class="shop-card">
          <text class="shop-name">{{item.displayName}}</text>
          <view wx:if="{{item.displayAddress}}" class="shop-info-row">
            <text class="shop-info-label">地址</text>
            <text class="shop-info-value">{{item.displayAddress}}</text>
          </view>
          <view wx:if="{{item.businessHoursText}}" class="shop-info-row">
            <text class="shop-info-label">营业</text>
            <text class="shop-info-value">{{item.businessHoursText}}</text>
          </view>
          <view wx:if="{{item.phone}}" class="shop-info-row">
            <text class="shop-info-label">电话</text>
            <text class="shop-info-value">{{item.phone}}</text>
          </view>
          <view wx:if="{{item.wechat}}" class="shop-info-row">
            <text class="shop-info-label">微信</text>
            <text class="shop-info-value">{{item.wechat}}</text>
          </view>
        </view>
      </block>
      <view wx:else class="empty-hint">暂未设置店铺信息</view>
    </view>

    <!-- 专业资质（仅在有数据时显示） -->
    <view wx:if="{{qualifications.length}}" class="section section-gray">
      <view class="section-head">
        <text class="section-title">专业资质</text>
        <text class="section-more">全部 ></text>
      </view>
      <view wx:for="{{qualifications}}" wx:key="id" class="qual-row">
        <view class="qual-icon-wrap qual-type-{{item.type}}">
          <text class="qual-icon">{{item.icon}}</text>
        </view>
        <view class="qual-info">
          <text class="qual-title">{{item.title}}</text>
          <text class="qual-detail">{{item.detail}} · {{item.year}}</text>
        </view>
        <image wx:if="{{item.isVerified}}" class="qual-verified" src="/static/icons/check-circle.svg"/>
      </view>
    </view>

    <!-- 精选作品 -->
    <view class="section">
      <view class="section-head">
        <text class="section-title">精选作品</text>
        <text class="section-more" bindtap="viewAllWorks">查看全部 ></text>
      </view>
      <view wx:if="{{works.length === 0}}" class="empty-hint">暂无作品</view>
      <view wx:else class="works-grid">
        <view wx:for="{{displayWorks}}" wx:key="id" class="work-thumb" bindtap="viewWork" data-id="{{item.id}}">
          <image src="{{item.coverUrl}}" mode="aspectFill" class="work-thumb-img"/>
        </view>
      </view>
    </view>

    <!-- 客户评价（始终显示） -->
    <view class="section section-gray">
      <view class="section-head">
        <text class="section-title">客户评价</text>
        <text wx:if="{{reviews.length}}" class="section-count">{{artist.reviewCount || reviews.length}}条评价</text>
      </view>
      <block wx:if="{{reviews.length}}">
        <view wx:for="{{reviews}}" wx:key="id" class="review-item">
          <view class="review-header">
            <view class="review-avatar">
              <image wx:if="{{item.clientAvatarUrl}}" src="{{item.clientAvatarUrl}}" class="review-avatar-img"/>
              <text wx:else class="review-avatar-text">{{item.initial}}</text>
            </view>
            <view class="review-meta">
              <text class="review-name">{{item.clientName}}</text>
              <view class="review-stars">
                <text wx:for="{{5}}" wx:for-item="star" wx:key="*this" class="star {{star < item.rating ? 'star-filled' : ''}}">★</text>
              </view>
            </view>
          </view>
          <text class="review-content">{{item.content}}</text>
        </view>
      </block>
      <view wx:else class="empty-hint">该美甲师还未有任何评价信息哦～</view>
    </view>

  </block>
</view>

<!-- 底部操作栏 -->
<view wx:if="{{!loading && !loadFailed && !previewMode}}" class="action-bar">
  <button class="action-icon-btn" open-type="share">
    <image src="/static/icons/tab-chat.svg" class="action-icon-img"/>
  </button>
  <view class="action-icon-btn {{isLiked ? 'liked' : ''}}" bindtap="toggleLike">
    <image src="{{isLiked ? '/static/icons/social-heart-active.svg' : '/static/icons/social-heart.svg'}}" class="action-icon-img"/>
  </view>
  <view class="action-icon-btn {{isFavorited ? 'favorited' : ''}}" bindtap="toggleFavorite">
    <image src="{{isFavorited ? '/static/icons/social-star-active.svg' : '/static/icons/social-star.svg'}}" class="action-icon-img"/>
  </view>
  <view class="action-book-btn" bindtap="bookArtist">预约咨询</view>
</view>

<view wx:if="{{!loading && !loadFailed && previewMode}}" class="preview-edit-bar"><view bindtap="editSection" data-section="profile">编辑主页内容</view></view>

<!-- 绑定弹窗 -->
<view wx:if="{{showBindModal}}" class="bind-mask" bindtap="closeBindModal">
  <view class="bind-panel" catchtap="">
    <view class="bind-handle"></view>
    <text class="bind-title">绑定 {{artist.name}}</text>
    <text class="bind-copy">请输入美甲师提供的邀请码。申请通过后，你的预约会默认归属给这位美甲师。</text>
    <view class="bind-input-row">
      <input class="bind-input" value="{{bindInviteCode}}" bindinput="onBindInviteInput" placeholder="邀请码或邀请链接" disabled="{{bindChecking}}"/>
      <view class="verify-btn" bindtap="verifyInviteCode">{{bindChecking ? '验证中' : '验证'}}</view>
    </view>
    <view wx:if="{{bindCandidate}}" class="bind-result"><image src="/static/icons/check-circle.svg"/><text>已确认：{{bindCandidate.name}}</text></view>
    <text wx:if="{{bindError}}" class="bind-error">{{bindError}}</text>
    <view class="bind-actions"><view class="bind-cancel" bindtap="closeBindModal">取消</view><view class="bind-confirm {{!bindCandidate || bindChecking ? 'is-disabled' : ''}}" bindtap="submitBinding">提交绑定申请</view></view>
  </view>
</view>
