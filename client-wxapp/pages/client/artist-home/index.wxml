<nav-bar title="美甲师主页" showBack/>
<view class="page">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="state">
    <view class="loading-spinner"></view>
    <text>正在加载主页...</text>
  </view>
  <view wx:elif="{{loadFailed}}" class="state">
    <text class="state-title">主页加载失败</text>
    <view class="retry-btn booking-action" bindtap="loadHome">重新加载</view>
  </view>
  <block wx:else>

    <!-- ===== 1. 固定主页头部：背景图 + 美甲师信息 ===== -->
    <view class="artist-hero-sticky" style="top: {{navBarHeight}}px;">
      <view class="banner-section">
        <image wx:if="{{heroImageUrl}}" src="{{heroImageUrl}}" mode="aspectFill" class="hero-background" />
        <view class="banner-mosaic" wx:elif="{{bannerImages.length}}">
          <image wx:for="{{bannerImages}}" wx:key="*this" src="{{item}}" mode="aspectFill" class="mosaic-img"/>
        </view>
        <view class="banner-mosaic banner-mosaic-fallback" wx:else></view>
        <view class="banner-overlay"></view>
        <view class="banner-gradient"></view>
      </view>

      <view class="artist-sticky {{isOwner ? 'has-owner-menu' : ''}}">
        <view wx:if="{{isOwner}}" class="owner-menu" bindtap="showOwnerMenu" role="button" aria-label="主页管理">
          <image src="/static/icons/more-horizontal.svg" mode="aspectFit" />
        </view>
        <view class="artist-info-row">
            <!-- 头像 -->
            <view class="avatar-wrap">
              <image wx:if="{{artist.avatarUrl}}" src="{{artist.avatarUrl}}" class="avatar-img" mode="aspectFill"/>
              <view wx:else class="avatar-fallback"><image src="/static/icons/technician.svg" mode="aspectFit" class="nb-default-avatar" aria-label="美甲师默认头像" /></view>
              <view wx:if="{{artist.isOnline}}" class="online-dot"></view>
            </view>

            <!-- 信息区 -->
            <view class="artist-detail">
              <view class="name-row">
                <text class="artist-name">{{artist.name}}</text>
                <view wx:if="{{artist.isVerified}}" class="badge-gold">
                  <text class="badge-icon">✓</text>
                  <text>高级认证</text>
                </view>
              </view>
              <text wx:if="{{artist.certificationTitle}}" class="certification-line">{{artist.certificationTitle}}</text>
              <view class="meta-row">
                <image class="meta-icon" src="/static/icons/pin-light.svg" mode="aspectFit"/>
                <text wx:if="{{artist.city}}">{{artist.city}}</text>
                <text wx:if="{{artist.experienceYears}}"> · 从业{{artist.experienceYears}}年</text>
                <text wx:if="{{artist.specialtiesText}}" class="meta-divider">|</text>
                <text wx:if="{{artist.specialtiesText}}">{{artist.specialtiesText}}</text>
              </view>
            </view>
        </view>
      </view>
      <view class="hero-content-bridge" aria-hidden="true"></view>
    </view>

    <!-- 简介：主页只显示摘要，完整理念按需展开 -->
    <view class="section-block" wx:if="{{brandTagline || artist.bio || aestheticPhilosophy || artist.servicePhilosophy}}">
      <view class="section-header">
        <view class="section-bar"></view>
        <text class="section-title">简介</text>
        <text wx:if="{{aestheticPhilosophy || artist.servicePhilosophy || artist.bio.length > 70}}" class="section-more" bindtap="openAboutDetail">更多 ›</text>
      </view>
      <view class="about-card compact-card" bindtap="openAboutDetail" role="button" aria-label="查看完整简介">
        <text wx:if="{{brandTagline}}" class="positioning-text">{{brandTagline}}</text>
        <text class="bio-text bio-summary">{{artist.bio || brandIntroduction}}</text>
      </view>
    </view>

    <!-- 履历：仅显示一条成长经历和一项认证 -->
    <view class="section-block" wx:if="{{timeline.length || qualifications.length}}">
      <view class="section-header">
        <view class="section-bar"></view>
        <text class="section-title">履历</text>
        <text wx:if="{{timeline.length > 1 || qualifications.length > 1}}" class="section-more" bindtap="openCareerDetail">更多 ›</text>
      </view>
      <view class="about-card compact-card" bindtap="openCareerDetail" role="button" aria-label="查看完整履历">
        <view wx:if="{{timeline.length}}" class="career-summary-row">
          <text class="career-summary-key">{{timeline[0].year}}</text>
          <text class="career-summary-value">{{timeline[0].desc}}</text>
        </view>
        <view wx:if="{{qualifications.length}}" class="career-summary-row">
          <text class="career-summary-key">{{qualifications[0].typeLabel}}</text>
          <text class="career-summary-value">{{qualifications[0].title}}</text>
        </view>
      </view>
    </view>

    <!-- 店铺：地址与操作常驻，环境和服务说明按需展开 -->
    <view class="section-block" wx:if="{{artist.shopName || artist.shopAddress}}">
      <view class="section-header">
        <view class="section-bar"></view>
        <text class="section-title">店铺</text>
        <text wx:if="{{environmentPhotos.length || privacyNote || exclusiveServiceNote || studioPolicyItems.length}}" class="section-more" bindtap="openStudioDetail">更多 ›</text>
      </view>
      <view class="shop-card compact-shop-card">
        <image wx:if="{{environmentPhotos.length}}" class="shop-summary-image" src="{{environmentPhotos[0].imageUrl}}" mode="aspectFill" bindtap="openStudioDetail" aria-label="查看店铺详情" />
        <view class="shop-info">
          <text class="shop-name">{{artist.shopName}}</text>
          <view class="shop-detail-row shop-address-row" wx:if="{{artist.shopAddress}}">
            <view class="detail-icon-wrap"><image class="detail-icon-svg" src="/static/icons/pin.svg" mode="aspectFit"/></view>
            <view class="shop-address-content">
              <text class="detail-text">{{artist.shopAddress}}</text>
              <view wx:if="{{artist._guidance}}" class="guidance-entry-inline" bindtap="openGuidance" role="button" aria-label="查看到店指引"><text class="guidance-entry-text">到店指引</text><text class="guidance-entry-arrow">›</text></view>
            </view>
          </view>
          <view class="shop-detail-row" wx:if="{{artist.businessHours}}"><view class="detail-icon-wrap"><image class="detail-icon-svg" src="/static/icons/clock.svg" mode="aspectFit"/></view><text class="detail-text">{{artist.businessHours}}</text></view>
          <view class="shop-actions">
            <button class="action-btn booking-action" bindtap="openNavigation"><image class="action-icon-svg" src="/static/icons/navigation.svg" mode="aspectFit"/><text>导航</text></button>
            <button class="action-btn booking-action" bindtap="callPhone"><image class="action-icon-svg" src="/static/icons/phone.svg" mode="aspectFit"/><text>电话</text></button>
          </view>
        </view>
      </view>
    </view>

    <!-- 精选作品 -->
    <view class="section-block" wx:if="{{works.length}}">
      <view class="section-header">
        <view class="section-bar"></view>
        <text class="section-title">精选作品</text>
        <text class="section-more" bindtap="viewAllWorks">查看全部 ›</text>
      </view>
      <view class="featured-work-grid">
        <view wx:for="{{displayWorks}}" wx:key="id" class="featured-work-item">
          <work-card work="{{item}}" show-artist="{{false}}" bind:cardtap="viewWork" />
        </view>
      </view>
    </view>

    <!-- 精选评论：客户评价与主页评论统一展示 -->
    <view class="section-block" wx:if="{{featuredComments.length}}">
      <view class="section-header">
        <view class="section-bar"></view>
        <text class="section-title">精选评论</text>
        <text wx:if="{{featuredComments.length > 2}}" class="section-more" bindtap="openReviewDetail">更多 ›</text>
      </view>
      <view class="review-list">
        <view wx:for="{{displayComments}}" wx:key="key" class="review-card compact-review-card">
          <view class="review-header">
            <image wx:if="{{item.clientAvatarUrl}}" src="{{item.clientAvatarUrl}}" class="review-avatar" mode="aspectFill"/>
            <view wx:else class="review-avatar-fallback"><image src="/static/icons/client.svg" mode="aspectFit" class="nb-default-avatar" aria-label="客户默认头像" /></view>
            <view class="review-meta"><view class="review-name-row"><text class="review-name">{{item.clientName}}</text><text class="review-time">{{item.timeAgo}}</text></view><view wx:if="{{item.rating}}" class="review-stars"><text wx:for="{{5}}" wx:for-item="star" wx:key="*this" class="star {{star < item.rating ? 'star-filled' : ''}}">★</text></view></view>
          </view>
          <text class="review-content review-summary">{{item.content}}</text>
        </view>
      </view>
    </view>

    <!-- 占位空间（底部栏高度） -->
    <view style="height: 160rpx;"></view>
  </block>
</view>
<!-- ===== 9. 底部操作栏 ===== -->
<view wx:if="{{!loading && !loadFailed}}" class="bottom-bar">
  <view class="bottom-bar-inner">
    <view class="bottom-actions">
      <view class="action-icon-btn {{isLiked ? 'liked' : ''}}" bindtap="toggleLike">
        <image class="social-icon-svg" src="{{isLiked ? '/static/icons/social-heart-active.svg' : '/static/icons/social-heart.svg'}}" mode="aspectFit"/>
        <text class="count-label">{{likeCount || 0}}</text>
      </view>
      <view class="action-icon-btn {{isFavorited ? 'favorited' : ''}}" bindtap="toggleFavorite">
        <image class="social-icon-svg" src="{{isFavorited ? '/static/icons/social-star-active.svg' : '/static/icons/social-star.svg'}}" mode="aspectFit"/>
        <text class="count-label">{{favoriteCount || 0}}</text>
      </view>
      <view class="action-icon-btn" bindtap="openComments">
        <image class="social-icon-svg" src="/static/icons/social-comment.svg" mode="aspectFit"/>
        <text class="count-label">{{commentCount || 0}}</text>
      </view>
    </view>
    <button class="btn-book-main booking-action {{!isOwner && artist.acceptingBookings === false ? 'is-disabled' : ''}}" style="flex:1 1 0%;width:0;min-width:0;height:44px;min-height:44px;padding:0 16px;box-sizing:border-box;" bindtap="bookArtist" disabled="{{!isOwner && artist.acceptingBookings === false}}">
      <image class="btn-icon-svg" src="/static/icons/calendar.svg" mode="aspectFit"/>
      <text class="btn-text">{{isOwner ? '查看客户预约入口' : (artist.acceptingBookings === false ? '暂未接单' : (availabilitySummary || '发起预约'))}}</text>
    </button>
  </view>
</view>

<view wx:if="{{detailModal}}" class="modal-mask" bindtap="closeDetailModal">
  <view class="profile-detail-panel" catchtap="">
    <view class="profile-detail-head">
      <text class="modal-title">{{detailModal === 'about' ? '个人简介' : (detailModal === 'career' ? '履历与认证' : (detailModal === 'studio' ? '店铺详情' : '精选评论'))}}</text>
      <view class="profile-detail-close" bindtap="closeDetailModal" role="button">关闭</view>
    </view>
    <scroll-view scroll-y class="profile-detail-scroll">
      <view wx:if="{{detailModal === 'about'}}" class="profile-detail-content">
        <text wx:if="{{brandTagline}}" class="positioning-text">{{brandTagline}}</text>
        <text wx:if="{{artist.bio || brandIntroduction}}" class="bio-text">{{artist.bio || brandIntroduction}}</text>
        <view wx:if="{{aestheticPhilosophy}}" class="detail-info-block"><text class="detail-info-label">审美理念</text><text class="detail-info-value">{{aestheticPhilosophy}}</text></view>
        <view wx:if="{{artist.servicePhilosophy}}" class="detail-info-block"><text class="detail-info-label">服务理念</text><text class="detail-info-value">{{artist.servicePhilosophy}}</text></view>
      </view>

      <view wx:elif="{{detailModal === 'career'}}" class="profile-detail-content">
        <view wx:if="{{timeline.length}}" class="timeline-list">
          <view wx:for="{{timeline}}" wx:key="year" class="timeline-item"><view class="timeline-dot"></view><view wx:if="{{index < timeline.length - 1}}" class="timeline-line"></view><view class="timeline-content"><text class="timeline-year">{{item.year}}</text><text class="timeline-desc">{{item.desc}}</text></view></view>
        </view>
        <view wx:if="{{qualifications.length}}" class="qualification-list">
          <view wx:for="{{qualifications}}" wx:key="id" class="qualification-item"><view class="qualification-main"><view class="qualification-head"><text class="qualification-type">{{item.typeLabel}}</text><text wx:if="{{item.isVerified}}" class="qualification-verified">已认证</text></view><text class="qualification-title">{{item.title}}</text><text class="qualification-detail"><text wx:if="{{item.detail}}">{{item.detail}}</text><text wx:if="{{item.organization}}"> · {{item.organization}}</text><text wx:if="{{item.year}}"> · {{item.year}}</text></text></view></view>
        </view>
      </view>

      <view wx:elif="{{detailModal === 'studio'}}" class="profile-detail-content">
        <swiper wx:if="{{environmentPhotos.length}}" class="detail-shop-swiper" circular="{{environmentPhotos.length > 1}}" indicator-dots="{{environmentPhotos.length > 1}}">
          <swiper-item wx:for="{{environmentPhotos}}" wx:key="imageUrl" bindtap="previewEnvPhoto" data-idx="{{index}}"><image class="detail-shop-image" src="{{item.imageUrl}}" mode="aspectFill" lazy-load /></swiper-item>
        </swiper>
        <text class="shop-name">{{artist.shopName}}</text>
        <view wx:if="{{artist.shopAddress}}" class="detail-info-block"><text class="detail-info-label">地址</text><text class="detail-info-value">{{artist.shopAddress}}</text></view>
        <view wx:if="{{artist.businessHours}}" class="detail-info-block"><text class="detail-info-label">营业时间</text><text class="detail-info-value">{{artist.businessHours}}</text></view>
        <view wx:if="{{exclusiveServiceNote}}" class="detail-info-block"><text class="detail-info-label">空间定位</text><text class="detail-info-value">{{exclusiveServiceNote}}</text></view>
        <view wx:if="{{privacyNote}}" class="detail-info-block"><text class="detail-info-label">环境说明</text><text class="detail-info-value">{{privacyNote}}</text></view>
        <view wx:if="{{studioPolicyItems.length}}" class="detail-link-row" bindtap="openStudioPolicies" role="button"><text>服务保障与预约政策</text><text>›</text></view>
      </view>

      <view wx:else class="profile-detail-content">
        <view wx:for="{{featuredComments}}" wx:key="key" class="review-card detail-review-card"><view class="review-header"><image wx:if="{{item.clientAvatarUrl}}" src="{{item.clientAvatarUrl}}" class="review-avatar" mode="aspectFill"/><view wx:else class="review-avatar-fallback"><image src="/static/icons/client.svg" mode="aspectFit" class="nb-default-avatar" /></view><view class="review-meta"><view class="review-name-row"><text class="review-name">{{item.clientName}}</text><text class="review-time">{{item.timeAgo}}</text></view><view wx:if="{{item.rating}}" class="review-stars"><text wx:for="{{5}}" wx:for-item="star" wx:key="*this" class="star {{star < item.rating ? 'star-filled' : ''}}">★</text></view></view></view><text class="review-content">{{item.content}}</text></view>
      </view>
    </scroll-view>
  </view>
</view>

<view wx:if="{{showOwnerMenuSheet}}" class="modal-mask" bindtap="closeOwnerMenu">
  <view class="owner-action-panel" catchtap="">
    <view class="owner-action-item" data-action="edit" catchtap="handleOwnerMenuAction" role="button">编辑主页</view>
    <view class="owner-action-item" data-action="interactions" catchtap="handleOwnerMenuAction" role="button">互动记录</view>
    <view class="owner-action-cancel" catchtap="closeOwnerMenu" role="button">取消</view>
  </view>
</view>

<view wx:if="{{showStudioPolicyModal}}" class="modal-mask" bindtap="closeStudioPolicies">
  <view class="policy-panel" catchtap="">
    <view class="modal-handle"></view>
    <view class="policy-panel-head">
      <view class="policy-panel-title-wrap">
        <text class="modal-title">服务保障与预约政策</text>
        <text class="policy-panel-desc">预约前请确认以下服务说明</text>
      </view>
      <view class="policy-close" bindtap="closeStudioPolicies" role="button" aria-label="关闭政策详情">关闭</view>
    </view>
    <scroll-view scroll-y class="policy-list">
      <view wx:for="{{studioPolicyItems}}" wx:key="key" class="policy-item">
        <text class="policy-item-label">{{item.label}}</text>
        <text class="policy-item-content">{{item.content}}</text>
      </view>
    </scroll-view>
  </view>
</view>

<view wx:if="{{showCommentComposer}}" class="modal-mask" bindtap="closeComments">
  <view class="comment-composer" catchtap="">
    <text class="modal-title">评论美甲师主页</text>
    <textarea class="comment-textarea" value="{{commentDraft}}" bindinput="onCommentInput" maxlength="500" placeholder="分享你对美甲师主页或服务的看法" placeholder-class="modal-placeholder" auto-focus/>
    <view class="modal-actions">
      <view class="modal-cancel booking-action" bindtap="closeComments" role="button">取消</view>
      <view class="modal-confirm booking-action {{!commentDraft || commentSubmitting ? 'is-disabled' : ''}}" bindtap="submitHomepageComment" role="button">{{commentSubmitting ? '发布中' : '发布评论'}}</view>
    </view>
  </view>
</view>
