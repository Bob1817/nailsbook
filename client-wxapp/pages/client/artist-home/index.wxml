<nav-bar title="美甲师主页" showBack/>
<view class="page">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="state">
    <view class="loading-spinner"></view>
    <text>正在加载主页...</text>
  </view>
  <view wx:elif="{{loadFailed}}" class="state">
    <text class="state-title">主页加载失败</text>
    <view class="retry-btn booking-action" bindtap="loadHome">重新加载</view>
  </view>
  <block wx:else>

    <!-- ===== 1. 固定主页头部：背景图 + 美甲师信息 ===== -->
    <view class="artist-hero-sticky" style="top: {{navBarHeight}}px;">
      <view class="banner-section">
        <image wx:if="{{heroImageUrl}}" src="{{heroImageUrl}}" mode="aspectFill" class="hero-background" />
        <view class="banner-mosaic" wx:elif="{{bannerImages.length}}">
          <image wx:for="{{bannerImages}}" wx:key="*this" src="{{item}}" mode="aspectFill" class="mosaic-img"/>
        </view>
        <view class="banner-mosaic banner-mosaic-fallback" wx:else></view>
        <view class="banner-overlay"></view>
        <view class="banner-gradient"></view>
      </view>

      <view class="artist-sticky {{isOwner ? 'has-owner-menu' : ''}}">
        <view wx:if="{{isOwner}}" class="owner-menu" bindtap="showOwnerMenu" role="button" aria-label="主页管理">
          <image src="/static/icons/more-horizontal.svg" mode="aspectFit" />
        </view>
        <view class="artist-info-row">
            <!-- 头像 -->
            <view class="avatar-wrap">
              <image wx:if="{{artist.avatarUrl}}" src="{{artist.avatarUrl}}" class="avatar-img" mode="aspectFill"/>
              <view wx:else class="avatar-fallback"><image src="/static/icons/technician.svg" mode="aspectFit" class="nb-default-avatar" aria-label="美甲师默认头像" /></view>
              <view wx:if="{{artist.isOnline}}" class="online-dot"></view>
            </view>

            <!-- 信息区 -->
            <view class="artist-detail">
              <view class="name-row">
                <text class="artist-name">{{artist.name}}</text>
                <view wx:if="{{artist.isVerified}}" class="badge-gold">
                  <text class="badge-icon">✓</text>
                  <text>高级认证</text>
                </view>
              </view>
              <text wx:if="{{artist.certificationTitle}}" class="certification-line">{{artist.certificationTitle}}</text>
              <view class="meta-row">
                <image class="meta-icon" src="/static/icons/pin-light.svg" mode="aspectFit"/>
                <text wx:if="{{artist.city}}">{{artist.city}}</text>
                <text wx:if="{{artist.experienceYears}}"> · 从业{{artist.experienceYears}}年</text>
                <text wx:if="{{artist.specialtiesText}}" class="meta-divider">|</text>
                <text wx:if="{{artist.specialtiesText}}">{{artist.specialtiesText}}</text>
              </view>
            </view>
        </view>
      </view>
    </view>

    <!-- 统计条：至少 2 项真实指标才展示，避免单独一个数字没有信息量 -->
    <view class="stats-section" wx:if="{{hasRealStats}}">
      <view class="stats-card">
        <view class="stat-item" wx:if="{{artist.workCount}}">
          <text class="stat-num">{{artist.workCount}}</text>
          <text class="stat-label">作品</text>
        </view>
        <view class="stat-divider" wx:if="{{artist.workCount && (artist.rating != null || artist.reviewCount)}}"></view>
        <view class="stat-item" wx:if="{{artist.rating != null}}">
          <text class="stat-num">{{artist.rating}}</text>
          <text class="stat-label">评分</text>
        </view>
        <view class="stat-divider" wx:if="{{artist.rating != null && artist.reviewCount}}"></view>
        <view class="stat-item" wx:if="{{artist.reviewCount}}">
          <text class="stat-num">{{artist.reviewCount}}</text>
          <text class="stat-label">真实评价</text>
        </view>
      </view>
    </view>

    <!-- ===== 自我描述与定位（常驻，首屏可见） ===== -->
    <view class="section-block" wx:if="{{brandTagline || artist.bio || aestheticPhilosophy || artist.servicePhilosophy}}">
      <view class="section-header">
        <view class="section-bar"></view>
        <text class="section-title">自我介绍</text>
      </view>
      <view class="about-card">
        <text wx:if="{{brandTagline}}" class="positioning-text">{{brandTagline}}</text>
        <text wx:if="{{artist.bio}}" class="bio-text">{{artist.bio}}</text>
        <text wx:elif="{{brandIntroduction}}" class="bio-text">{{brandIntroduction}}</text>
        <view class="philosophy-block" wx:if="{{aestheticPhilosophy}}">
          <text class="philosophy-label">审美理念</text>
          <text class="philosophy-text">{{aestheticPhilosophy}}</text>
        </view>
        <view class="philosophy-block" wx:if="{{artist.servicePhilosophy}}">
          <text class="philosophy-label">服务理念</text>
          <text class="philosophy-text">{{artist.servicePhilosophy}}</text>
        </view>
      </view>
    </view>

    <!-- ===== 成长与认证（常驻） ===== -->
    <view class="section-block" wx:if="{{timeline.length || qualifications.length}}">
      <view class="section-header">
        <view class="section-bar"></view>
        <text class="section-title">成长与认证</text>
      </view>
      <view class="about-card">
        <view class="timeline-section" wx:if="{{timeline.length}}">
          <view class="timeline-list">
            <view wx:for="{{timeline}}" wx:key="year" class="timeline-item">
              <view class="timeline-dot {{index < timeline.length - 1 ? 'has-line' : ''}}"></view>
              <view wx:if="{{index < timeline.length - 1}}" class="timeline-line"></view>
              <view class="timeline-content">
                <text class="timeline-year">{{item.year}}</text>
                <text class="timeline-desc">{{item.desc}}</text>
              </view>
            </view>
          </view>
        </view>
        <view class="qualification-list" wx:if="{{qualifications.length}}" style="margin-top:12rpx;">
          <view wx:for="{{qualifications}}" wx:key="id" class="qualification-item">
            <view class="qualification-main">
              <view class="qualification-head">
                <text class="qualification-type">{{item.typeLabel}}</text>
                <text wx:if="{{item.isVerified}}" class="qualification-verified">已认证</text>
              </view>
              <text class="qualification-title">{{item.title}}</text>
              <text class="qualification-detail">
                <text wx:if="{{item.detail}}">{{item.detail}}</text>
                <text wx:if="{{item.organization}}"> · {{item.organization}}</text>
                <text wx:if="{{item.year}}"> · {{item.year}}</text>
              </text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 工作室环境与到店信息 ===== -->
    <view class="section-block" wx:if="{{privacyNote || exclusiveServiceNote || environmentPhotos.length || artist.shopName || artist.shopAddress}}">
      <view class="section-header">
        <view class="section-bar"></view>
        <text class="section-title">工作室</text>
      </view>
      <!-- 空间说明 -->
      <view class="about-card" wx:if="{{privacyNote || exclusiveServiceNote}}">
        <view class="kv-row" wx:if="{{exclusiveServiceNote}}">
          <text class="kv-label">空间定位</text>
          <text class="kv-value">{{exclusiveServiceNote}}</text>
        </view>
        <view class="kv-row" wx:if="{{privacyNote}}">
          <text class="kv-label">私密环境</text>
          <text class="kv-value">{{privacyNote}}</text>
        </view>
      </view>
      <!-- 地址与到店 -->
      <view class="shop-card" style="margin-top:16rpx;" wx:if="{{artist.shopName || artist.shopAddress}}">
        <view class="shop-hero-wrap" wx:if="{{environmentPhotos.length}}">
          <swiper
            class="shop-hero"
            autoplay="{{environmentPhotos.length > 1}}"
            circular="{{environmentPhotos.length > 1}}"
            interval="4000"
            duration="500"
            bindchange="onEnvironmentHeroChange"
            aria-label="工作室环境照片轮播"
          >
            <swiper-item wx:for="{{environmentPhotos}}" wx:key="imageUrl">
              <view
                class="shop-hero-slide"
                bindtap="previewEnvPhoto"
                data-idx="{{index}}"
                role="button"
                aria-label="预览第{{index + 1}}张工作室环境照片"
              >
                <image class="shop-hero-image" src="{{item.imageUrl}}" mode="aspectFill" lazy-load />
                <view class="shop-hero-overlay" wx:if="{{item.caption || item.sceneTag}}">
                  <text class="shop-hero-tag" wx:if="{{item.sceneTag}}">{{item.sceneTag}}</text>
                  <text class="shop-hero-caption" wx:if="{{item.caption}}">{{item.caption}}</text>
                </view>
              </view>
            </swiper-item>
          </swiper>
          <text class="shop-hero-count" wx:if="{{environmentPhotos.length > 1}}">{{environmentHeroIndex + 1}} / {{environmentPhotos.length}}</text>
        </view>
        <view class="shop-info">
          <text class="shop-name">{{artist.shopName}}</text>
          <view class="shop-detail-row shop-address-row" wx:if="{{artist.shopAddress}}">
            <image class="detail-icon-svg" src="/static/icons/pin.svg" mode="aspectFit"/>
            <view class="shop-address-content">
              <text class="detail-text">{{artist.shopAddress}}</text>
              <view wx:if="{{artist._guidance}}" class="guidance-entry-inline" bindtap="openGuidance" role="button" aria-label="查看到店指引">
                <text class="guidance-entry-text">查看到店指引</text>
                <text class="guidance-entry-arrow">›</text>
              </view>
            </view>
          </view>
          <view class="shop-detail-row" wx:if="{{artist.businessHours}}">
            <image class="detail-icon-svg" src="/static/icons/clock.svg" mode="aspectFit"/>
            <text class="detail-text">营业时间：{{artist.businessHours}}</text>
          </view>
          <view wx:if="{{studioPolicyItems.length}}" class="shop-policy-entry" bindtap="openStudioPolicies" role="button" aria-label="查看服务保障与预约政策">
            <image class="detail-icon-svg" src="/static/icons/shield.svg" mode="aspectFit"/>
            <text class="shop-policy-text">服务保障与预约政策</text>
            <text class="shop-policy-summary">共 {{studioPolicyItems.length}} 项</text>
            <text class="shop-policy-arrow">›</text>
          </view>
          <view class="shop-actions">
            <button class="action-btn booking-action" style="flex:1 1 0%;width:0;min-width:0;height:44px;min-height:44px;padding:0 16px;box-sizing:border-box;" bindtap="openNavigation">
              <image class="action-icon-svg" src="/static/icons/navigation.svg" mode="aspectFit"/>
              <text>一键导航</text>
            </button>
            <button class="action-btn booking-action" style="flex:1 1 0%;width:0;min-width:0;height:44px;min-height:44px;padding:0 16px;box-sizing:border-box;" bindtap="callPhone">
              <image class="action-icon-svg" src="/static/icons/phone.svg" mode="aspectFit"/>
              <text>一键拨号</text>
            </button>
          </view>
        </view>
      </view>
    </view>

    <!-- 擅长风格：定位与审美 -->
    <view class="section-block" wx:if="{{artist.styleTags.length}}">
      <view class="section-header">
        <view class="section-bar"></view>
        <text class="section-title">擅长风格</text>
      </view>
      <scroll-view scroll-x class="style-scroll" wx:if="{{stylePhotoCards.length}}">
        <view class="style-list">
          <view wx:for="{{stylePhotoCards}}" wx:key="label" class="style-card" bindtap="viewWork" data-id="{{item.workId}}" role="button" aria-label="查看{{item.label}}风格作品">
            <image class="style-card-image" src="{{item.imageUrl}}" mode="aspectFill" lazy-load />
            <view class="style-card-overlay"></view>
            <text class="style-card-text">{{item.label}}</text>
          </view>
        </view>
      </scroll-view>
      <view class="style-chip-list" wx:if="{{styleTextTags.length}}">
        <text wx:for="{{styleTextTags}}" wx:key="label" class="style-chip">{{item.label}}</text>
      </view>
    </view>

    <!-- ===== 服务流程 ===== -->
    <view class="section-block" wx:if="{{serviceProcess.length}}">
      <view class="section-header">
        <view class="section-bar"></view>
        <text class="section-title">服务流程</text>
      </view>
      <view class="about-card">
        <view wx:if="{{serviceProcess.length}}" class="process-list">
          <view wx:for="{{serviceProcess}}" wx:key="step" class="process-item">
            <view class="process-no">{{item.step}}</view>
            <view class="process-body">
              <text class="process-name">{{item.title}}</text>
              <text class="process-desc" wx:if="{{item.description}}">{{item.description}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 服务内容与价格 -->
    <view class="section-block" wx:if="{{services.length}}">
      <view class="section-header">
        <view class="section-bar"></view>
        <text class="section-title">服务内容</text>
      </view>
      <view class="service-list">
        <view wx:for="{{services}}" wx:key="name" class="service-card">
          <view class="service-icon-wrap">
            <image class="service-icon-svg" src="{{item.icon}}" mode="aspectFit"/>
          </view>
          <view class="service-info">
            <view class="service-top">
              <text class="service-name">{{item.name}}</text>
              <view class="service-right-meta">
                <view class="service-duration" wx:if="{{item.duration}}">
                  <image class="duration-icon-svg" src="/static/icons/clock.svg" mode="aspectFit"/>
                  <text>约{{item.duration}}</text>
                </view>
                <text class="service-price semantic-money" wx:if="{{item.price}}">¥{{item.price}}起</text>
              </view>
            </view>
            <text class="service-desc" wx:if="{{item.desc}}">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- FAQ -->
    <view class="section-block" wx:if="{{faqs.length}}">
      <view class="section-header">
        <view class="section-bar"></view>
        <text class="section-title">常见问题</text>
      </view>
      <view class="about-card">
        <view wx:for="{{faqs}}" wx:key="question" class="faq-item">
          <text class="faq-q">{{item.question}}</text>
          <text class="faq-a">{{item.answer}}</text>
        </view>
      </view>
    </view>

    <!-- ===== 8. 客户评价 ===== -->
    <view class="section-block" wx:if="{{reviews.length}}">
      <view class="section-header">
        <view class="section-bar"></view>
        <text class="section-title">客户评价</text>
        <text wx:if="{{reviews.length}}" class="section-more">查看全部 ›</text>
      </view>
      
      <view class="review-list">
        <view wx:for="{{reviews}}" wx:key="id" class="review-card">
          <view class="review-header">
            <image wx:if="{{item.clientAvatarUrl}}" src="{{item.clientAvatarUrl}}" class="review-avatar" mode="aspectFill"/>
            <view wx:else class="review-avatar-fallback"><image src="/static/icons/client.svg" mode="aspectFit" class="nb-default-avatar" aria-label="客户默认头像" /></view>
            <view class="review-meta">
              <view class="review-name-row">
                <text class="review-name">{{item.clientName}}</text>
                <text class="review-time">{{item.timeAgo || '3天前'}}</text>
              </view>
              <view class="review-stars">
                <text wx:for="{{5}}" wx:for-item="star" wx:key="*this" class="star {{star < item.rating ? 'star-filled' : ''}}">★</text>
              </view>
            </view>
          </view>
          <text class="review-content">{{item.content}}</text>
        </view>
      </view>
    </view>

    <view class="section-block" wx:if="{{homepageComments.length}}">
      <view class="section-header">
        <view class="section-bar"></view>
        <text class="section-title">主页评论</text>
        <text class="section-more" bindtap="openComments">{{commentCount}} 条</text>
      </view>
      <view class="homepage-comment-list">
        <view wx:for="{{homepageComments}}" wx:key="id" class="homepage-comment">
          <image wx:if="{{item.clientAvatarUrl}}" class="homepage-comment-avatar" src="{{item.clientAvatarUrl}}" mode="aspectFill"/>
          <image wx:else class="homepage-comment-avatar" src="/static/icons/client.svg" mode="aspectFit"/>
          <view class="homepage-comment-body">
            <view class="homepage-comment-head"><text class="homepage-comment-name">{{item.clientName}}</text><text class="homepage-comment-time">{{item.timeAgo}}</text></view>
            <text class="homepage-comment-content">{{item.content}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 精选作品（最后：专业证明） ===== -->
    <view class="section-block" wx:if="{{works.length}}">
      <view class="section-header">
        <view class="section-bar"></view>
        <text class="section-title">精选作品</text>
        <text class="section-more" bindtap="viewAllWorks">{{artist.workCount ? artist.workCount + ' 件 · ' : ''}}查看全部 ›</text>
      </view>
      <view class="gallery-grid">
        <view wx:for="{{displayWorks}}" wx:key="id" class="gallery-item" bindtap="viewWork" data-id="{{item.id}}">
          <image src="{{item.coverUrl}}" mode="aspectFill" class="gallery-img"/>
          <view class="gallery-overlay">
            <view class="gallery-tag">
              <text>{{item.styleText || '美甲设计'}} · {{item.duration || '60'}}min</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 占位空间（底部栏高度） -->
    <view style="height: 160rpx;"></view>
  </block>
</view>

<!-- ===== 9. 底部操作栏 ===== -->
<view wx:if="{{!loading && !loadFailed}}" class="bottom-bar">
  <view class="bottom-bar-inner">
    <view class="bottom-actions">
      <view class="action-icon-btn {{isLiked ? 'liked' : ''}}" bindtap="toggleLike">
        <image class="social-icon-svg" src="{{isLiked ? '/static/icons/social-heart-active.svg' : '/static/icons/social-heart.svg'}}" mode="aspectFit"/>
        <text class="count-label">{{likeCount || 0}}</text>
      </view>
      <view class="action-icon-btn {{isFavorited ? 'favorited' : ''}}" bindtap="toggleFavorite">
        <image class="social-icon-svg" src="{{isFavorited ? '/static/icons/social-star-active.svg' : '/static/icons/social-star.svg'}}" mode="aspectFit"/>
        <text class="count-label">{{favoriteCount || 0}}</text>
      </view>
      <view class="action-icon-btn" bindtap="openComments">
        <image class="social-icon-svg" src="/static/icons/social-comment.svg" mode="aspectFit"/>
        <text class="count-label">{{commentCount || 0}}</text>
      </view>
    </view>
    <button class="btn-book-main booking-action" style="flex:1 1 0%;width:0;min-width:0;height:44px;min-height:44px;padding:0 16px;box-sizing:border-box;" bindtap="bookArtist">
      <image class="btn-icon-svg" src="/static/icons/calendar.svg" mode="aspectFit"/>
      <text class="btn-text">发起预约</text>
    </button>
  </view>
  <view class="safe-area-bottom"></view>
</view>

<view wx:if="{{showOwnerMenuSheet}}" class="modal-mask" bindtap="closeOwnerMenu">
  <view class="owner-action-panel" catchtap="">
    <view class="owner-action-item" data-action="edit" catchtap="handleOwnerMenuAction" role="button">编辑主页</view>
    <view class="owner-action-item" data-action="interactions" catchtap="handleOwnerMenuAction" role="button">互动记录</view>
    <view class="owner-action-cancel" catchtap="closeOwnerMenu" role="button">取消</view>
  </view>
</view>

<view wx:if="{{showStudioPolicyModal}}" class="modal-mask" bindtap="closeStudioPolicies">
  <view class="policy-panel" catchtap="">
    <view class="modal-handle"></view>
    <view class="policy-panel-head">
      <view class="policy-panel-title-wrap">
        <text class="modal-title">服务保障与预约政策</text>
        <text class="policy-panel-desc">预约前请确认以下服务说明</text>
      </view>
      <view class="policy-close" bindtap="closeStudioPolicies" role="button" aria-label="关闭政策详情">关闭</view>
    </view>
    <scroll-view scroll-y class="policy-list">
      <view wx:for="{{studioPolicyItems}}" wx:key="key" class="policy-item">
        <text class="policy-item-label">{{item.label}}</text>
        <text class="policy-item-content">{{item.content}}</text>
      </view>
    </scroll-view>
  </view>
</view>

<view wx:if="{{showCommentComposer}}" class="modal-mask" bindtap="closeComments">
  <view class="comment-composer" catchtap="">
    <text class="modal-title">评论美甲师主页</text>
    <textarea class="comment-textarea" value="{{commentDraft}}" bindinput="onCommentInput" maxlength="500" placeholder="分享你对美甲师主页或服务的看法" placeholder-class="modal-placeholder" auto-focus/>
    <view class="modal-actions">
      <view class="modal-cancel booking-action" bindtap="closeComments" role="button">取消</view>
      <view class="modal-confirm booking-action {{!commentDraft || commentSubmitting ? 'is-disabled' : ''}}" bindtap="submitHomepageComment" role="button">{{commentSubmitting ? '发布中' : '发布评论'}}</view>
    </view>
  </view>
</view>

<!-- 绑定弹窗 -->
<view wx:if="{{showBindModal}}" class="modal-mask" bindtap="closeBindModal">
  <view class="modal-panel" catchtap="">
    <view class="modal-handle"></view>
    <text class="modal-title">绑定 {{artist.name}}</text>
    <text class="modal-desc">请输入美甲师提供的邀请码。申请通过后，你的预约会默认归属给这位美甲师。</text>
    <view class="modal-input-row">
      <input class="modal-input" value="{{bindInviteCode}}" bindinput="onBindInviteInput" placeholder="邀请码或邀请链接" placeholder-class="modal-placeholder" aria-label="美甲师邀请码或邀请链接" disabled="{{bindChecking}}" confirm-type="done" />
      <view class="modal-verify-btn booking-action" bindtap="verifyInviteCode" role="button" aria-disabled="{{bindChecking}}">{{bindChecking ? '验证中' : '验证'}}</view>
    </view>
    <view wx:if="{{bindCandidate}}" class="modal-success">
      <text>✓ 已确认：{{bindCandidate.name}}</text>
    </view>
    <text wx:if="{{bindError}}" class="modal-error">{{bindError}}</text>
    <view class="modal-actions">
      <view class="modal-cancel booking-action" bindtap="closeBindModal" role="button">取消</view>
      <view class="modal-confirm booking-action {{!bindCandidate || bindChecking ? 'is-disabled' : ''}}" bindtap="submitBinding" role="button" aria-disabled="{{!bindCandidate || bindChecking}}">提交绑定申请</view>
    </view>
  </view>
</view>
