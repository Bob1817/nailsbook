.container {
  min-height: 100vh;
  background: #f8f9fc;
  padding: 24rpx 40rpx;
  padding-bottom: 200rpx;
}

.menu-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF0F3 0%, #F5F3FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.menu-icon::after {
  content: '';
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B8A, #A78BFA);
}

/* 表单卡片 */
.form-card {
  background: #f8f9fc;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

.form-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #374151;
  display: block;
  margin-bottom: 16rpx;
}

.form-header .form-label {
  margin-bottom: 0;
}

.form-count {
  font-size: 24rpx;
  color: #6b7280;
}

.form-input  {
  width: 100%;
  height: 88rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1f2937;
  box-sizing: border-box;
}

.form-textarea  {
  width: 100%;
  height: 240rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  color: #1f2937;
  box-sizing: border-box;
}

.placeholder {
  color: #6b7280;
}

/* 图片网格 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: calc(33.33% - 11rpx);
  aspect-ratio: 1;
  border-radius: 14rpx;
  overflow: hidden;
}

.image-thumb {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.remove-icon {
  font-size: 28rpx;
  color: #fff;
  line-height: 1;
}

.image-add {
  width: calc(33.33% - 11rpx);
  aspect-ratio: 1;
  border-radius: 14rpx;
  border: 3rpx dashed #d1d5db;
  background: #fffafc;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-add.uploading {
  border-color: #FF6B8A;
}

.upload-loading {
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #FF6B8A;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.add-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.add-icon {
  font-size: 48rpx;
  color: #6b7280;
  line-height: 1;
}

.add-text {
  font-size: 22rpx;
  color: #6b7280;
}

/* 提示卡片 */
.tips-card {
  background: #f8f9fc;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
}

.tips-content {
  display: flex;
  gap: 16rpx;
}

.tips-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.tips-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tips-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #1f2937;
}

.tips-desc {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
}

/* 提交按钮 */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 40rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  border: none;
}

.submit-btn.disabled {
  opacity: 0.5;
}

.submit-btn::after {
  border: none;
}
