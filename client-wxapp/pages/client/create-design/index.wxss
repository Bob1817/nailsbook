@import '../../../styles/tokens.wxss';

.container {
  min-height: 100vh;
  background: var(--bg-page);
  padding: var(--space-md) var(--space-xl);
  padding-bottom: 200rpx;
}

/* 图标占位 */
.menu-icon {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: var(--nb-page);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.menu-icon::after {
  content: ''; width: 12rpx; height: 12rpx; border-radius: 50%;
  background: var(--brand-gradient);
}

/* 表单卡片 */
.form-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: var(--space-lg); margin-bottom: var(--space-md);
  box-shadow: var(--shadow-md);
  border: 0;
}
.form-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 20rpx;
}
.form-label {
  font-size: var(--font-md); font-weight: var(--weight-medium);
  color: var(--text-body); display: block;
  margin-bottom: var(--space-sm);
}
.form-header .form-label { margin-bottom: 0; }
.form-count { font-size: var(--font-sm); color: var(--text-muted); }

.form-input {
  width: 100%; height: var(--input-height);
  background: var(--nb-soft-surface);
  border: 0;
  border-radius: var(--input-radius);
  padding: 0 var(--space-md);
  font-size: var(--font-md); color: var(--text-primary);
  box-sizing: border-box;
}
.form-input:focus {
  background: var(--bg-input-focus);
  border-color: var(--border-focus);
}

.form-textarea {
  width: 100%; height: 240rpx;
  background: var(--nb-soft-surface);
  border: 0;
  border-radius: var(--input-radius);
  padding: 20rpx var(--space-xl);
  font-size: var(--font-md); color: var(--text-primary);
  box-sizing: border-box;
}
.form-textarea:focus {
  background: var(--bg-input-focus);
  border-color: var(--border-focus);
}

.placeholder { color: var(--text-muted); }

/* 图片网格 */
.image-grid { display: flex; flex-wrap: wrap; gap: var(--space-sm); }
.image-item {
  position: relative;
  width: calc(33.33% - 11rpx); aspect-ratio: 1;
  border-radius: var(--radius-sm); overflow: hidden;
}
.image-thumb { width: 100%; height: 100%; }
.image-remove {
  position: absolute; top: var(--space-xs); right: var(--space-xs);
  width: var(--space-xl); height: var(--space-xl);
  background: var(--bg-overlay); border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.remove-icon { font-size: var(--font-md); color: var(--text-inverse); line-height: 1; }

.image-add {
  width: calc(33.33% - 11rpx); aspect-ratio: 1;
  border-radius: var(--radius-sm);
  border: 3rpx dashed var(--text-faint);
  background: var(--bg-tag);
  display: flex; align-items: center; justify-content: center;
}
.image-add.uploading { border-color: var(--brand-primary); }

.upload-loading { display: flex; align-items: center; justify-content: center; }
.loading-spinner {
  width: 48rpx; height: 48rpx;
  border: 4rpx solid var(--brand-primary);
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.add-content { display: flex; flex-direction: column; align-items: center; gap: var(--space-xs); }
.add-icon { font-size: var(--font-2xl); color: var(--text-muted); line-height: 1; }
.add-text { font-size: var(--font-xs); color: var(--text-muted); }

/* 提示卡片 */
.tips-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: var(--space-lg); margin-bottom: var(--space-md);
  box-shadow: var(--shadow-md);
}
.tips-content { display: flex; gap: var(--space-sm); }
.tips-icon { font-size: var(--font-lg); flex-shrink: 0; }
.tips-text { display: flex; flex-direction: column; gap: var(--space-xs); }
.tips-title { font-size: var(--font-sm); font-weight: var(--weight-medium); color: var(--text-primary); }
.tips-desc { font-size: var(--font-sm); color: var(--text-muted); line-height: var(--leading-normal); }

/* 提交按钮 */
.submit-section {
  position: fixed; bottom: 0; left: 0; right: 0;
  padding: var(--space-md) var(--space-xl);
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border-top: 0;
}
.submit-btn {
  width: 100%;
  height: var(--btn-height);
  background: var(--brand-gradient);
  color: var(--text-inverse);
  font-size: var(--btn-font-size); font-weight: var(--weight-semibold);
  border-radius: var(--btn-radius);
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--shadow-md);
  border: none;
}
.submit-btn::after { border: none; }
.submit-btn.disabled { opacity: 0.5; }

@import '../../../styles/booking-actions.wxss';
.form-input { height: var(--input-height); min-height: 44px; font-size: var(--font-sm); }
.form-textarea { font-size: var(--font-sm); }
.submit-btn.booking-action { height: var(--control-hit-height); min-height: 44px; border-radius: 8px; font-size: var(--font-sm); box-shadow: none; }
