<nav-bar title="{{shopView ? '店铺信息' : '到店指引'}}" showBack/>

<view class="container">
  <view wx:if="{{loading}}" class="loading-wrap"><view class="loading-spinner"></view></view>

  <state-card wx:elif="{{loadFailed}}" type="error" title="指引信息加载失败" description="请检查网络后重试" actionText="重新加载" bind:action="loadGuidance">
    <button class="state-btn state-btn-secondary booking-action" bindtap="goHome">进入小程序首页</button>
  </state-card>

  <state-card wx:elif="{{!hasContent}}" icon="/static/icons/shop.svg" title="暂无到店指引" description="美甲师尚未编辑到店指引信息">
    <button class="state-btn state-btn-primary booking-action" bindtap="goHome">进入小程序首页</button>
  </state-card>

  <block wx:else>
    <view class="public-shop-head">
      <text class="public-shop-name">{{shopName}}</text>
      <text class="public-shop-address">{{shopAddress}}</text>
    </view>
    <view wx:if="{{shopView}}" class="public-shop-head">
      <button wx:if="{{guidance.enabled}}" class="btn-navigate booking-action" bindtap="openGuidance" hover-class="is-pressed">查看到店指引 ›</button>
      <text wx:else class="public-shop-address">可通过下方地址导航到店</text>
    </view>
    <!-- Tab 切换 -->
    <view wx:if="{{!shopView}}" class="tabs">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="tab {{activeTab === index ? 'tab-active' : ''}} {{!item.hasContent ? 'tab-empty' : ''}}"
        data-idx="{{index}}"
        bindtap="switchTab"
      >
        <text>{{item.label}}</text>
      </view>
    </view>

    <!-- 按编辑顺序展示文字与图片 -->
    <scroll-view wx:if="{{!shopView}}" scroll-y class="content-area">
      <view class="content-inner">
      <view class="section rich-guide">
        <block wx:for="{{activeBlocks}}" wx:key="id">
          <text wx:if="{{item.type === 'text'}}" class="section-text rich-guide-text">{{item.text}}</text>
          <image wx:else class="guide-img rich-guide-image" src="{{item.url}}" mode="widthFix" data-idx="{{index}}" bindtap="previewImage" lazy-load />
        </block>
        <view wx:if="{{activeBlocks.length === 0}}" class="section-empty"><text>暂无该方式的到店指引</text></view>
      </view>
      </view>
    </scroll-view>

    <!-- 导航到店按钮 -->
    <view class="bottom-bar">
      <button wx:if="{{shopAddress}}" class="btn-navigate btn-secondary booking-action" bindtap="navigateToShop">
        <text>{{shopLocation ? '地图查看与导航' : '查看店铺地址'}}</text>
      </button>
      <button class="btn-navigate booking-action" open-type="share"><text>{{shopView ? '发送店铺信息' : '发送到店指引'}}</text></button>
    </view>
  </block>
</view>
