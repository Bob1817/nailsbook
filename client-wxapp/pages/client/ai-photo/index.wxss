page { background:#faf8f9; color:#392832; }
.page { padding: var(--space-md) 28rpx calc(40rpx + env(safe-area-inset-bottom)); }
.intro { padding:12rpx 4rpx 32rpx; }
.intro-kicker { display:block; color:#a15e7d; font-size: var(--font-xs); letter-spacing:3rpx; font-weight: var(--weight-bold); }
.intro-title { display:block; margin-top:12rpx; font-size: var(--font-lg); line-height:1.35; font-weight: var(--weight-bold); }
.intro-copy { display:block; margin-top:12rpx; color:#7e6974; font-size: var(--font-sm); line-height:1.65; }
.section { margin-bottom:26rpx; padding:28rpx 24rpx; border:1rpx solid #eee4e9; border-radius: var(--radius-lg); background: var(--bg-card); }
.section.compact { padding-bottom:22rpx; }
.section-head { display:flex; min-height:48rpx; align-items:center; justify-content:space-between; }
.step { margin-right:14rpx; color:#b06888; font-size: var(--font-xs); letter-spacing:1rpx; font-weight: var(--weight-bold); }
.section-title { font-size: var(--font-md); font-weight: var(--weight-bold); }
.section-help { display:block; margin-top:6rpx; color:#9a8791; font-size: var(--font-xs); }
.text-action { display:flex; min-height:88rpx; margin:-20rpx -12rpx -20rpx 0; padding:0 12rpx; align-items:center; color:#a05276; font-size: var(--font-xs); font-weight: var(--weight-semibold); }
.selection-count { color:#a05276; font-size: var(--font-xs); font-weight: var(--weight-semibold); }
.appointment-scroll,.option-scroll { width:100%; margin-top:20rpx; white-space:nowrap; }
.appointment-row,.option-row,.filter-row { display:inline-flex; gap:16rpx; padding:2rpx 3rpx 10rpx; }
.appointment-card { position:relative; display:inline-flex; width:520rpx; min-height:176rpx; padding:14rpx; gap:18rpx; border:2rpx solid #eee4e9; border-radius:22rpx; background: var(--bg-card); box-sizing:border-box; }
.appointment-card.selected { border-color:#cf789f; background:#fff8fb; box-shadow:0 8rpx 22rpx rgba(149,77,108,.10); }
.appointment-cover { width:142rpx; height:142rpx; flex:none; border-radius: var(--radius-sm); background:#f2eaee; }
.empty-cover { display:flex; align-items:center; justify-content:center; color:#b596a5; font-size: var(--font-xs); letter-spacing:2rpx; }
.appointment-info { display:flex; min-width:0; flex:1; flex-direction:column; justify-content:center; }
.appointment-date,.appointment-title,.appointment-count { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.appointment-date { color:#9b7c8a; font-size: var(--font-xs); }.appointment-title { margin-top:8rpx; font-size: var(--font-sm); font-weight: var(--weight-bold); }.appointment-count { margin-top:13rpx; color:#876f7b; font-size: var(--font-xs); }
.select-mark,.photo-check { position:absolute; display:flex; align-items:center; justify-content:center; border-radius:50%; border:2rpx solid rgba(255,255,255,.9); color: var(--text-inverse); background:rgba(57,40,50,.35); box-sizing:border-box; }
.select-mark { top:12rpx; right:12rpx; width:40rpx; height:40rpx; }.appointment-card.selected .select-mark { background:#b45f86; }
.state-card { display:flex; min-height:150rpx; margin-top:20rpx; padding:28rpx; flex-direction:column; align-items:center; justify-content:center; border-radius: var(--radius-md); background:#f8f3f5; color:#8e7883; font-size: var(--font-sm); text-align:center; box-sizing:border-box; }
.state-title { color:#5d4652; font-size: var(--font-sm); font-weight: var(--weight-bold); }.state-copy { margin-top:12rpx; line-height:1.6; }
.photo-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:12rpx; margin-top:20rpx; }
.photo-cell,.add-photo { position:relative; aspect-ratio:1; min-height:196rpx; overflow:hidden; border-radius: var(--card-radius); box-sizing:border-box; }
.photo-cell { border:4rpx solid transparent; background:#f3ecef; }.photo-cell.selected { border-color:#c96594; }
.photo-image { width:100%; height:100%; }
.add-photo { display:flex; flex-direction:column; align-items:center; justify-content:center; border:2rpx dashed #d8bdc9; background:#fbf5f8; color:#925e76; }
.add-icon { font-size: var(--font-xl); font-weight:300; }.add-title { margin-top:8rpx; font-size: var(--font-xs); font-weight: var(--weight-semibold); }
.source-badge { position:absolute; left:8rpx; bottom:8rpx; max-width:calc(100% - 16rpx); padding:5rpx 9rpx; overflow:hidden; border-radius:10rpx; background:rgba(35,25,30,.68); color: var(--text-inverse); font-size: var(--font-xs); text-overflow:ellipsis; white-space:nowrap; }
.photo-check { top:7rpx; right:7rpx; width:38rpx; height:38rpx; font-size: var(--font-xs); }.photo-cell.selected .photo-check { background:#b95082; }
.library-tip { padding:22rpx 0 2rpx; color:#9b8791; font-size: var(--font-xs); text-align:center; }
.selected-order { margin-top: var(--space-md); padding-top:20rpx; border-top:1rpx solid #f0e7eb; }.selected-order-title { display:block; margin-bottom:12rpx; color:#725c67; font-size: var(--font-xs); font-weight: var(--weight-bold); }.selected-order-item { display:flex; min-height:96rpx; align-items:center; gap:4rpx; border-bottom:1rpx solid #f4edf0; }.selected-order-preview { width:76rpx; height:76rpx; flex:none; overflow:hidden; border-radius: var(--radius-xs); background:#f2eaee; }.selected-order-image { width:100%; height:100%; }.selected-order-index { width:28rpx; color:#9b7c8a; font-size: var(--font-xs); }.order-move { display:flex; min-width:88rpx; min-height:88rpx; align-items:center; justify-content:center; color:#9a4f71; font-size: var(--font-xs); }.order-move.disabled { color:#cfc2c8; pointer-events:none; }
.crop-editor { margin-top:20rpx; padding:22rpx; border-radius: var(--radius-md); background:#faf5f8; }.crop-editor-head,.crop-label { display:flex; align-items:center; justify-content:space-between; }.crop-editor-head { color:#4f3944; font-size: var(--font-sm); font-weight: var(--weight-bold); }.crop-reset { display:flex; min-height:88rpx; margin:-20rpx -12rpx -20rpx 0; padding:0 12rpx; align-items:center; color:#a05276; font-size: var(--font-xs); }.crop-control { margin-top:14rpx; }.crop-label { color:#765f6b; font-size: var(--font-xs); }.crop-control slider { margin:4rpx 0 0; }.crop-done { display:flex; min-height:88rpx; margin-top:12rpx; align-items:center; justify-content:center; border-radius: var(--radius-xl); background:#a9557d; color: var(--text-inverse); font-size: var(--font-sm); font-weight: var(--weight-bold); }
.template-card { width:196rpx; min-height:250rpx; padding:12rpx; border:2rpx solid transparent; border-radius: var(--radius-md); background:#faf7f8; box-sizing:border-box; }
.template-card.selected { border-color:#d16296; background:#fff8fb; }
.template-swatch { height:126rpx; padding:12rpx; border-radius: var(--radius-sm); box-sizing:border-box; }.swatch-magazine { background:#ede8e5; }.swatch-life { background:#ffece7; }.swatch-art { background:#e7e1d7; }.swatch-festival { background:#64253d; }.swatch-frame { height:100%; border:1rpx solid rgba(255,255,255,.8); background:rgba(255,255,255,.25); }
.option-name,.option-sub { display:block; }.option-name { margin-top:12rpx; font-size: var(--font-sm); font-weight: var(--weight-bold); }.option-sub { margin-top:5rpx; color:#96838d; font-size: var(--font-xs); }
.filter-row { gap:12rpx; }.filter-item { display:flex; min-width:112rpx; min-height:100rpx; padding:10rpx; flex-direction:column; align-items:center; justify-content:center; border:2rpx solid transparent; border-radius: var(--card-radius); background:#faf7f8; color:#725c67; font-size: var(--font-xs); box-sizing:border-box; }.filter-item.selected { border-color:#d16296; color:#914666; background:#fff8fb; }.filter-dot { width:38rpx; height:38rpx; margin-bottom:8rpx; border:1rpx solid rgba(75,55,64,.08); border-radius:50%; }
.intensity-control { margin-top:18rpx; padding-top:16rpx; border-top:1rpx solid #f0e7eb; }.intensity-head { display:flex; padding:0 4rpx; justify-content:space-between; color:#725c67; font-size: var(--font-xs); }.intensity-control slider { margin:12rpx 0 0; }
.poster-title-input { height:88rpx; margin-top:18rpx; padding:0 22rpx; border:1rpx solid #e8dce2; border-radius: var(--card-radius); background:#faf7f8; color:#4d3842; font-size: var(--font-sm); box-sizing:border-box; }
.poster-date-picker { display:flex; min-height:88rpx; margin-top:14rpx; padding:0 22rpx; align-items:center; justify-content:space-between; border:1rpx solid #e8dce2; border-radius: var(--card-radius); background:#faf7f8; color:#725c67; font-size: var(--font-sm); box-sizing:border-box; }.share-copy-input { width:100%; min-height:132rpx; margin-top:14rpx; padding:20rpx 22rpx; border:1rpx solid #e8dce2; border-radius: var(--card-radius); background:#faf7f8; color:#4d3842; font-size: var(--font-sm); line-height:1.55; box-sizing:border-box; }
.result-section { margin-bottom:26rpx; padding:30rpx 24rpx; border-radius: var(--radius-lg); background:#34262d; color: var(--text-inverse); }.result-kicker { display:block; color:#d8a4ba; font-size: var(--font-xs); letter-spacing:3rpx; }.result-title { display:block; margin-top:10rpx; font-size: var(--font-lg); font-weight: var(--weight-bold); }.result-image { width:100%; margin-top:22rpx; border-radius: var(--radius-md); }
.continue-edit { display:flex; min-height:88rpx; margin-top:14rpx; align-items:center; justify-content:center; border:1rpx solid rgba(255,255,255,.28); border-radius: var(--radius-xl); color: var(--text-inverse); font-size: var(--font-sm); }
.share-row { display:flex; gap:14rpx; margin-top:18rpx; }.secondary-btn { display:flex; min-width:0; min-height:88rpx; flex:1; padding:0 18rpx; align-items:center; justify-content:center; border-radius: var(--radius-xl); background: var(--bg-card); color:#604653; font-size: var(--font-sm); font-weight: var(--weight-bold); box-sizing:border-box; }.share-btn { margin:0; line-height:1; }.share-btn::after { border:0; }
.copy-card { margin-top:18rpx; padding:22rpx; border-radius: var(--card-radius); background:rgba(255,255,255,.09); }.copy-head { display:flex; align-items:center; justify-content:space-between; }.copy-label { font-size: var(--font-sm); font-weight: var(--weight-bold); }.copy-btn { display:flex; min-height:88rpx; margin:-20rpx -8rpx -20rpx 0; padding:0 16rpx; align-items:center; color:#f0bfd3; font-size: var(--font-xs); }.copy-content { display:block; margin-top:12rpx; color:#e5dce0; font-size: var(--font-xs); line-height:1.65; white-space:pre-wrap; }
.privacy-note { padding:20rpx 22rpx; border-radius: var(--card-radius); background:#f2edef; color:#81717a; font-size: var(--font-xs); line-height:1.55; }.action-space { height:132rpx; }
.bottom-action { position:fixed; z-index:20; left:0; right:0; bottom:0; display:flex; min-height:112rpx; padding:14rpx 28rpx calc(14rpx + env(safe-area-inset-bottom)); align-items:center; gap:20rpx; border-top:1rpx solid #eadfe4; background:rgba(255,255,255,.96); box-shadow:0 -8rpx 28rpx rgba(56,38,47,.08); box-sizing:content-box; }
.action-summary { display:flex; width:150rpx; flex-direction:column; color:#4c3741; font-size: var(--font-sm); font-weight: var(--weight-bold); }.action-sub { margin-top:5rpx; color:#9a8791; font-size: var(--font-xs); font-weight: var(--weight-normal); }.generate-btn { display:flex; min-height:88rpx; flex:1; align-items:center; justify-content:center; border-radius: var(--radius-xl); color: var(--text-inverse); background:linear-gradient(100deg,#d65f94,#9e62cc); font-size: var(--font-sm); font-weight: var(--weight-bold); }.generate-btn.disabled { opacity:.42; }
.poster-canvas { position:fixed; left:-2000px; top:0; width:600px; height:800px; }
