<view class="page">
  <view class="card">
    <text class="title">把喜欢的美甲服务分享给好友</text>
    <text class="notice">{{rewardNotice}}</text>
    <button wx:if="{{!sharePath}}" class="primary booking-action" bindtap="prepareShare">生成推荐链接</button>
    <button wx:else class="primary booking-action" open-type="share">分享给好友</button>
  </view>

  <view class="fund-card">
    <text class="fund-label">可用美甲基金</text>
    <text class="fund-balance semantic-money">¥{{fundTotals.available}}</text>
    <view class="fund-summary">
      <text>待生效 ¥{{fundTotals.pending}}</text>
      <text>已使用 ¥{{fundTotals.used}}</text>
    </view>
    <view wx:for="{{fundAccounts}}" wx:key="id" class="fund-account">
      <text>{{item.technician.name}}</text>
      <text class="semantic-money">可用 ¥{{item.totals.available}}</text>
    </view>
    <block wx:for="{{fundAccounts}}" wx:key="id" wx:for-item="account">
      <view wx:for="{{account.ledger}}" wx:key="id" wx:for-item="entry" class="ledger-row">
        <view>
          <text class="ledger-source">{{entry.sourceText}}</text>
          <text class="ledger-date">{{entry.createdDate}} · {{account.technician.name}}</text>
        </view>
        <view class="ledger-amount-wrap">
          <text class="semantic-money ledger-amount">{{entry.amount > 0 ? '+' : ''}}¥{{entry.amount}}</text>
          <text class="ledger-status">{{entry.statusText}}</text>
        </view>
      </view>
    </block>
  </view>

  <view class="section-title">推荐状态</view>
  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{!relations.length}}" class="empty">还没有推荐记录</view>
  <view wx:else class="list">
    <view class="relation" wx:for="{{relations}}" wx:key="id">
      <view>
        <text class="name">{{item.referred.nickname || '新客户'}}</text>
        <text class="tech">{{item.technician.name}}</text>
      </view>
      <text class="status">{{item.status === 'pending_first_order' ? '待完成首单' : item.status === 'qualified' ? '已满足奖励资格' : item.status}}</text>
    </view>
  </view>
</view>
