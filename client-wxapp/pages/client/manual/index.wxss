page {
  background: var(--bg-page);
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.scroll { flex: 1; min-height: 0; }

.content {
  padding: var(--space-md) var(--space-lg) calc(var(--space-2xl) + env(safe-area-inset-bottom));
}

/* 区块标题 */
.block-head {
  padding: var(--space-sm) var(--space-xs);
  margin-top: var(--space-xs);
}
.block-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  margin-right: var(--space-sm);
}
.block-sub {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

/* 使用指引 */
.guides {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 12rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}
.guide {
  display: flex;
  gap: 20rpx;
  padding: var(--space-md) 0;
  border-bottom: 0;
}
.guide:last-child { border-bottom: none; }
.guide-num {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--brand-gradient);
  color: var(--text-inverse);
  font-size: var(--font-sm);
  font-weight: var(--weight-bold);
  display: flex;
  align-items: center;
  justify-content: center;
}
.guide-body { flex: 1; min-width: 0; }
.guide-t {
  display: block;
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin-bottom: var(--space-xs);
}
.guide-d {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
  line-height: 1.7;
}

/* 常见问题 */
.faqs {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 4rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}
.faq {
  padding: 28rpx 0;
  border-bottom: 0;
}
.faq:last-child { border-bottom: none; }
.faq-q-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}
.faq-q {
  flex: 1;
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  color: var(--text-primary);
}
.faq-chevron {
  flex-shrink: 0;
  font-size: var(--font-lg);
  color: var(--text-muted);
  transform: rotate(90deg);
  transition: transform 0.2s;
}
.faq-open .faq-chevron { transform: rotate(-90deg); }
.faq-a-wrap {
  margin-top: var(--space-sm);
  padding: 20rpx var(--space-md);
  background: var(--bg-input);
  border-radius: var(--radius-sm);
}
.faq-a {
  font-size: var(--font-sm);
  color: var(--text-body);
  line-height: 1.75;
}

/* 仍有疑问 */
.more {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 56rpx 0 var(--space-sm);
}
.more-text {
  font-size: var(--font-sm);
  color: var(--text-muted);
}
.more-btn {
  height: 80rpx;
  padding: 0 56rpx;
  border-radius: var(--radius-full);
  background: var(--nb-page);
  color: var(--nb-text-link);
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
}
.more-btn:active { background: var(--nb-page); }
