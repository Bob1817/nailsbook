page {
  background: #f5f6fa;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.scroll { flex: 1; min-height: 0; }

.content {
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

/* 区块标题 */
.block-head {
  padding: 16rpx 8rpx;
  margin-top: 8rpx;
}
.block-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
  margin-right: 16rpx;
}
.block-sub {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 使用指引 */
.guides {
  background: #fff;
  border-radius: 24rpx;
  padding: 12rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.05);
}
.guide {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f1f4;
}
.guide:last-child { border-bottom: none; }
.guide-num {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.guide-body { flex: 1; min-width: 0; }
.guide-t {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 8rpx;
}
.guide-d {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.7;
}

/* 常见问题 */
.faqs {
  background: #fff;
  border-radius: 24rpx;
  padding: 4rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.05);
}
.faq {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f1f4;
}
.faq:last-child { border-bottom: none; }
.faq-q-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.faq-q {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2937;
}
.faq-chevron {
  flex-shrink: 0;
  font-size: 36rpx;
  color: #d1d5db;
  transform: rotate(90deg);
  transition: transform 0.2s;
}
.faq-open .faq-chevron { transform: rotate(-90deg); }
.faq-a-wrap {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: #f9fafb;
  border-radius: 16rpx;
}
.faq-a {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.75;
}

/* 仍有疑问 */
.more {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 56rpx 0 16rpx;
}
.more-text {
  font-size: 26rpx;
  color: #9ca3af;
}
.more-btn {
  height: 80rpx;
  padding: 0 56rpx;
  border-radius: 999rpx;
  background: #fff1f5;
  color: #FF6B8A;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.more-btn:active { background: #ffe0ea; }
