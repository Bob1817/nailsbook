page { background: var(--bg-page); }

.page {
  min-height: 100vh;
  background: var(--nb-page);
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 状态筛选：标签横向滚动，新增按钮固定在右侧 */
.filter-bar {
  position: relative;
  z-index: 20;
  padding: 16rpx 24rpx 16rpx 32rpx;
  background: rgba(255, 255, 255, 0.94);
  border-bottom: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.status-scroll { width: 598rpx; flex-shrink: 0; white-space: nowrap; }
.status-list { display: inline-flex; align-items: center; gap: 12rpx; padding-right: 4rpx; }
.status-tab {
  position: relative;
  min-height: var(--control-hit-height);
  padding: 0 24rpx;
  background: transparent;
  color: var(--text-muted);
  font-size: var(--font-sm);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  z-index: 0;
}
.status-tab::before { content:''; position:absolute; left:0; right:0; top:var(--control-visual-inset); bottom:var(--control-visual-inset); z-index:-1; border-radius:var(--radius-lg); background:var(--bg-page); }
.status-tab:active::before { background: var(--nb-page); }
.status-tab-active { color: var(--text-inverse); font-weight: var(--weight-semibold); }
.status-tab-active::before { background:var(--brand-primary); }
.filter-create {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--bg-card);
  border: 0;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}
.filter-create:active { transform: scale(0.95); }
.filter-create-plus { width: 36rpx; height: 36rpx; position: relative; }
.filter-create-plus::before,
.filter-create-plus::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  background: var(--brand-primary);
  border-radius: 2rpx;
  transform: translate(-50%, -50%);
}
.filter-create-plus::before { width: 32rpx; height: 3rpx; }
.filter-create-plus::after { width: 3rpx; height: 32rpx; }

.list-area { padding: var(--space-md) 40rpx 0; }

/* 骨架屏 */
.skel-list { display: flex; flex-direction: column; gap: 24rpx; }
.skel-card {
  height: 300rpx;
  border-radius: 32rpx;
  background: var(--nb-page);
  background-size: 200% 100%;
  animation: skel 1.4s linear infinite;
}
@keyframes skel {
  0% { background-position: 0 0; }
  100% { background-position: -200% 0; }
}

/* 空状态 */
.empty-wrap {
  margin-top: 32rpx;
  padding: 96rpx 48rpx;
  border-radius: 56rpx;
  background: var(--bg-card);
  border: 0;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty-art {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 32rpx;
}
.empty-ring { position: absolute; inset: 0; border-radius: 50%; background: var(--bg-input); }
.empty-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid var(--nb-line);
  border-radius: var(--radius-sm);
  transform: translate(-50%, -50%);
}
.empty-ttl { font-size: var(--font-md); color: var(--text-muted); }
.empty-sub { display:block; margin-top:14rpx; color:var(--nb-muted); font-size: var(--font-sm); line-height:1.6; text-align:center; }
.empty-cta {
  min-height: 88rpx;
  margin-top: 32rpx;
  padding: 0 48rpx;
  border-radius: var(--radius-xl);
  background: var(--brand-primary);
  color: var(--text-inverse);
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty-cta:active { opacity: 0.86; }

/* H5 同款预约卡片 */
.order-list { display: flex; flex-direction: column; gap: 24rpx; }
.order-card {
  border-radius: 32rpx;
  overflow: hidden;
  background: var(--bg-card);
  border: 0;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}
.order-card:active { transform: scale(0.99); }
.order-card-content { padding: 24rpx 28rpx 16rpx; }

.status-badge {
  flex-shrink: 0;
  padding: 8rpx 22rpx;
  border-radius: 22rpx;
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
}
.status-amber, .status-blue, .status-purple, .status-orange { background: var(--nb-soft-surface); color: var(--nb-text-link); }
.status-green { background: var(--nb-success-surface); color: var(--nb-success); }
.status-gray { background: var(--bg-input); color: var(--text-body); }
.status-red { background: var(--nb-danger-surface); color: var(--nb-danger); }

.order-card-body { display: flex; align-items: flex-start; gap: 20rpx; }
.order-date-box {
  width: 112rpx;
  min-height: 128rpx;
  flex-shrink: 0;
  border-radius: var(--radius-lg);
  background: var(--nb-page);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.order-date-day { font-size: var(--font-2xl); font-weight: var(--weight-bold); color: var(--brand-primary); line-height: 1; }
.order-date-sub { font-size: var(--font-xs); font-weight: var(--weight-medium); color: var(--brand-primary); }
.order-date-weekday { margin-top: 8rpx; font-size: var(--font-xs); color: rgba(0, 0, 0, 0.72) /* brand-primary-alpha */; }

.order-details { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.order-title-row { display: flex; align-items: flex-start; gap: 16rpx; margin-bottom:8rpx; }
.order-time-row { flex:1; min-width:0; margin-top:0; }
.order-time-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: var(--weight-bold);
  color: var(--nb-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.info-row { min-width:0; min-height:40rpx; margin-top:6rpx; display:flex; align-items:flex-start; gap:10rpx; line-height:1.4; }
.info-icon {
  width: 28rpx;
  height: 28rpx;
  margin-top:2rpx;
  flex-shrink: 0;
}
.info-text { flex:1; min-width:0; color:var(--text-body); font-size:var(--font-sm); line-height:1.4; }
.info-text-strong { color:var(--text-primary); font-weight:var(--weight-medium); }
.info-text-muted { color:var(--text-muted); }
.order-detail-address { display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; }
.order-guidance-link { position:relative; min-height:44rpx; color:var(--nb-text-link); font-weight:var(--weight-medium); }
.order-guidance-link::before { content:''; position:absolute; top:-20rpx; right:0; bottom:-24rpx; left:-12rpx; }
.order-guidance-link:active { opacity:.68; }
.payment-row { margin-top:8rpx; }
.payment-summary { color:var(--nb-money); font-weight:var(--weight-medium); font-variant-numeric:tabular-nums; }
/* 卡片底部：未开始显示倒计时，终态显示详情入口 */
.order-footer {
  min-height: 88rpx;
  margin-top: 16rpx;
  padding: 14rpx 0;
  box-sizing: border-box;
  border-top: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: var(--text-muted);
  font-size: var(--font-sm);
}
.order-footer:active { opacity:.68; }
.footer-prompt { flex:1; min-width:0; display:flex; align-items:center; gap:12rpx; }
.footer-prompt-copy { min-width:0; display:flex; flex-direction:column; justify-content:center; gap:4rpx; }
.countdown-main,.countdown-next { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; line-height:1.35; }
.countdown-main { color:var(--nb-secondary); font-weight: var(--weight-semibold); }
.countdown-next { color:var(--nb-muted); font-size: var(--font-xs); }
.footer-action { min-height:60rpx; flex-shrink:0; padding-left:12rpx; display:flex; align-items:center; justify-content:flex-end; gap:8rpx; color:var(--nb-text-link); font-size:var(--font-sm); font-weight:var(--weight-semibold); }
.footer-clock {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}
.footer-chevron {
  width: 16rpx;
  height: 16rpx;
  flex-shrink: 0;
  margin-right: 4rpx;
  border-right: 3rpx solid var(--nb-line);
  border-top: 3rpx solid var(--nb-line);
  transform: rotate(45deg);
}

/* Text navigation has no decorative pill. Keep existing hit-area sizing. */
.footer-action { color: var(--nb-text-link, #245EA8); background: transparent; border-color: transparent; box-shadow: none; }
.footer-action:active { background: transparent; opacity: .7; }

/* 与“我的”页一致的紧凑卡片和文字层级。 */
.filter-bar { padding: 12rpx 24rpx 12rpx 32rpx; background: var(--nb-surface); }
.status-scroll { flex: 1; width: auto; min-width: 0; }
.status-tab { min-height: 88rpx; padding: 0 20rpx; font-size: var(--font-sm); }
.filter-create { width: 72rpx; height: 72rpx; border-radius: 20rpx; box-shadow: none; background: var(--nb-page); }
.filter-create-plus { width: 28rpx; height: 28rpx; }
.filter-create-plus::before { width: 26rpx; }
.filter-create-plus::after { height: 26rpx; }
.list-area { padding: 20rpx 32rpx 0; }
.order-list { gap: 16rpx; }
.order-card { border-radius: 24rpx; box-shadow: none; }
.order-card-content { padding: 24rpx; }
.order-date-box { width: 104rpx; min-height: 120rpx; border-radius: 18rpx; }
.order-time-title { font-size: var(--font-md); font-weight: var(--weight-semibold); }
.info-text { font-size: var(--font-xs); }
.empty-wrap { margin-top: 16rpx; padding: 72rpx 40rpx; border-radius: 24rpx; box-shadow: none; }
