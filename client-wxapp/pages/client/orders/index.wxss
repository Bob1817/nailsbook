page { background: var(--bg-page); }

.page {
  min-height: 100vh;
  background: var(--nb-page);
  padding-bottom: 24rpx;
}

/* 状态筛选：标签横向滚动，新增按钮固定在右侧 */
/* 状态筛选：标签横向滚动，新增按钮固定在右侧 */
.filter-bar {
  position: sticky;
  top: 0;
  z-index: 20;
  padding: 14rpx var(--space-md) 14rpx var(--space-lg);
  background: rgba(255, 255, 255, 0.72);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  backdrop-filter: blur(20px) saturate(180%);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}
.status-scroll { flex: 1; min-width: 0; white-space: nowrap; }
.status-list { display: inline-flex; align-items: center; gap: 12rpx; padding-right: 4rpx; }
.status-tab {
  position: relative;
  height: 54rpx;
  min-height: 54rpx;
  padding: 0 22rpx;
  border-radius: var(--radius-full);
  background: var(--nb-page);
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  color: var(--nb-secondary);
  font-size: 24rpx;
  font-weight: var(--weight-medium);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  transition: all 0.15s ease-in-out;
}
.status-tab::after { content:''; position:absolute; top:-16rpx; bottom:-16rpx; left:0; right:0; }
.status-tab:active {
  background: var(--nb-pressed);
  transform: scale(0.97);
}
.status-tab-active {
  background: var(--nb-action);
  border-color: var(--nb-action);
  color: var(--nb-inverse);
  font-weight: var(--weight-semibold);
}
.filter-create {
  position: relative;
  width: 54rpx;
  height: 54rpx;
  min-height: 54rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--nb-page);
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease-in-out;
}
.filter-create::after { content:''; position:absolute; top:-16rpx; bottom:-16rpx; left:0; right:0; }
.filter-create:active {
  background: var(--nb-pressed);
  transform: scale(0.95);
}
.filter-create-icon { width: 24rpx; height: 24rpx; display: block; }

.list-area { padding: var(--space-md) var(--space-xl) 0; }

.booking-reminder-card {
  min-height: 112rpx;
  margin-bottom: var(--space-md);
  padding: var(--space-md);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: var(--space-md);
  border-radius: 24rpx;
  background: var(--bg-card);
}
.booking-reminder-copy { flex: 1; min-width: 0; }
.booking-reminder-title {
  display: block;
  color: var(--text-primary);
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
}
.booking-reminder-desc {
  display: block;
  margin-top: 6rpx;
  color: var(--text-muted);
  font-size: var(--font-xs);
  line-height: 1.5;
}
.booking-reminder-action {
  flex-shrink: 0;
  min-width: 152rpx;
  min-height: var(--touch-min);
  margin: 0;
  padding: 0 var(--space-md);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: var(--radius-md);
  background: var(--nb-ink);
  color: var(--text-inverse);
  font-size: var(--font-sm);
  font-weight: var(--weight-semibold);
  line-height: 1;
}
.booking-reminder-action::after { border: 0; }
.booking-reminder-action:active { opacity: .82; }

/* 骨架屏 */
.skel-list { display: flex; flex-direction: column; gap: var(--space-md); }
.skel-card {
  height: 300rpx;
  border-radius: 32rpx;
  background: var(--nb-page);
  background-size: 200% 100%;
  animation: skel 1.4s linear infinite;
}
@keyframes skel {
  0% { background-position: 0 0; }
  100% { background-position: -200% 0; }
}

/* 空状态 */
.empty-wrap {
  margin-top: var(--space-lg);
  padding: 96rpx var(--space-2xl);
  border-radius: 56rpx;
  background: var(--bg-card);
  border: 0;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty-art {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin-bottom: var(--space-lg);
}
.empty-ring { position: absolute; inset: 0; border-radius: 50%; background: var(--bg-input); }
.empty-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid var(--nb-line);
  border-radius: var(--radius-sm);
  transform: translate(-50%, -50%);
}
.empty-ttl { font-size: var(--font-md); color: var(--text-muted); }
.empty-sub { display:block; margin-top:14rpx; color:var(--nb-muted); font-size: var(--font-sm); line-height:1.6; text-align:center; }
.empty-cta {
  min-height: 88rpx;
  margin-top: var(--space-lg);
  padding: 0 var(--space-2xl);
  border-radius: var(--radius-xl);
  background: var(--brand-primary);
  color: var(--text-inverse);
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty-cta:active { opacity: 0.86; }

/* H5 同款预约卡片 */
.order-list { display: flex; flex-direction: column; gap: var(--space-md); }
.order-card {
  border-radius: 32rpx;
  overflow: hidden;
  background: var(--bg-card);
  border: 0;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}
.order-card:active { transform: scale(0.99); }
.order-card-content { padding: var(--space-md) var(--space-md) 0; }

.status-badge {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  min-height: 38rpx;
  box-sizing: border-box;
  padding: 0 14rpx;
  border-radius: var(--radius-full);
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.2;
}
.status-badge::before {
  content: '';
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
  margin-right: 6rpx;
  flex-shrink: 0;
}
.status-red, .status-amber, .status-purple { background: var(--nb-danger-surface); color: var(--nb-danger); }
.status-blue, .status-orange { background: var(--nb-soft-surface); color: var(--nb-text-link); }
.status-green { background: var(--nb-success-surface); color: var(--nb-success); }
.status-gray { background: var(--bg-input); color: var(--text-body); }

.order-card-body { display: flex; align-items: flex-start; gap: 20rpx; }
.order-date-box {
  width: 112rpx;
  min-height: 128rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  background: var(--nb-page);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 4rpx;
  box-sizing: border-box;
}
.order-date-day { font-size: 34rpx; font-weight: var(--weight-semibold); color: var(--nb-ink); line-height: 1.1; margin: 2rpx 0; }
.order-date-sub { font-size: 20rpx; font-weight: var(--weight-normal); color: var(--nb-muted); }
.order-date-weekday { font-size: 20rpx; color: var(--nb-muted); }

.order-details { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.order-title-row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-xs); margin-bottom: 4rpx; }
.order-time-row { flex: 1; min-width: 0; margin-top: 0; min-height: auto; gap: 8rpx; }
.order-time-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: var(--weight-semibold);
  color: var(--nb-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.info-row {
  min-width: 0;
  min-height: 30rpx;
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  line-height: 1.35;
}
.info-icon {
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
  display: block;
  opacity: 0.85;
}
.info-text { flex: 1; min-width: 0; color: var(--nb-secondary); font-size: 24rpx; line-height: 1.35; }
.info-text-strong { color: var(--nb-ink); font-weight: var(--weight-medium); }
.info-text-muted { color: var(--nb-muted); }
.info-row-address { align-items: flex-start; }
.info-row-address .info-icon { margin-top: 5rpx; }
.order-detail-address-wrap {
  flex: 1;
  min-width: 0;
  line-height: 1.4;
}
.order-detail-address {
  font-size: 22rpx;
  color: var(--nb-muted);
  line-height: 1.4;
}
.order-guidance-link {
  display: inline;
  position: relative;
  font-size: 22rpx;
  font-weight: var(--weight-medium);
  white-space: nowrap;
}
.order-guidance-link .info-text { color:var(--nb-text-link); }
.guidance-sep {
  font-size: 22rpx;
  color: var(--nb-muted);
}
.order-guidance-link::before {
  content: '';
  position: absolute;
  top: -14rpx;
  right: -8rpx;
  bottom: -14rpx;
  left: -8rpx;
}
.order-guidance-link:active { opacity: .68; }
.payment-row { margin-top: 8rpx; }
.payment-summary { color: var(--nb-money); font-weight: var(--weight-medium); font-size: 24rpx; font-variant-numeric: tabular-nums; }

/* 卡片底部：未开始显示倒计时，终态显示详情入口 */
.order-footer {
  min-height: 56rpx;
  margin-top: 16rpx;
  padding: 10rpx 0 12rpx;
  box-sizing: border-box;
  border-top: 1rpx solid var(--nb-line);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  color: var(--nb-muted);
  font-size: var(--font-sm);
}
.order-footer:active { opacity: .68; }
.footer-prompt { flex: 1; min-width: 0; display: flex; align-items: center; gap: 10rpx; }
.footer-prompt-copy { min-width: 0; display: flex; flex-direction: column; justify-content: center; gap: 2rpx; }
.countdown-main, .countdown-next { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; line-height: 1.35; }
.countdown-main { color: var(--nb-secondary); font-weight: var(--weight-medium); font-size: 22rpx; }
.countdown-next { color: var(--nb-muted); font-size: 20rpx; }
.footer-action {
  position: relative;
  min-height: 44rpx;
  flex-shrink: 0;
  padding-left: 12rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
  color: var(--nb-text-link);
  font-size: 24rpx;
  font-weight: var(--weight-medium);
  background: transparent;
  border-color: transparent;
  box-shadow: none;
}
.footer-action::after {
  content: '';
  position: absolute;
  top: -20rpx;
  bottom: -20rpx;
  left: -20rpx;
  right: 0;
}
.footer-action:active { background: transparent; opacity: .7; }
.footer-clock {
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
  opacity: 0.8;
}
.footer-chevron {
  width: 12rpx;
  height: 12rpx;
  flex-shrink: 0;
  margin-right: 4rpx;
  border-right: 2.5rpx solid var(--nb-muted);
  border-top: 2.5rpx solid var(--nb-muted);
  transform: rotate(45deg);
}
