page { background: var(--bg-page); }

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff8fa 0%, #f8f9fc 24%, #f5f6f8 100%);
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 状态筛选：标签横向滚动，新增按钮固定在右侧 */
.filter-bar {
  position: relative;
  z-index: 20;
  padding: 16rpx 24rpx 16rpx 32rpx;
  background: rgba(255, 255, 255, 0.94);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.status-scroll { width: 598rpx; flex-shrink: 0; white-space: nowrap; }
.status-list { display: inline-flex; align-items: center; gap: 12rpx; padding-right: 4rpx; }
.status-tab {
  position: relative;
  min-height: var(--control-hit-height);
  padding: 0 24rpx;
  background: transparent;
  color: var(--text-muted);
  font-size: var(--font-sm);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  z-index: 0;
}
.status-tab::before { content:''; position:absolute; left:0; right:0; top:var(--control-visual-inset); bottom:var(--control-visual-inset); z-index:-1; border-radius:var(--radius-lg); background:var(--bg-page); }
.status-tab:active::before { background: #edf0f4; }
.status-tab-active { color: var(--text-inverse); font-weight: var(--weight-semibold); }
.status-tab-active::before { background:var(--brand-primary); }
.filter-create {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--bg-card);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}
.filter-create:active { transform: scale(0.95); }
.filter-create-plus { width: 36rpx; height: 36rpx; position: relative; }
.filter-create-plus::before,
.filter-create-plus::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  background: var(--brand-primary);
  border-radius: 2rpx;
  transform: translate(-50%, -50%);
}
.filter-create-plus::before { width: 32rpx; height: 3rpx; }
.filter-create-plus::after { width: 3rpx; height: 32rpx; }

.list-area { padding: var(--space-md) 40rpx 0; }

/* 骨架屏 */
.skel-list { display: flex; flex-direction: column; gap: 24rpx; }
.skel-card {
  height: 300rpx;
  border-radius: 32rpx;
  background: linear-gradient(90deg, #ebebef, #f5f6fa, #ebebef);
  background-size: 200% 100%;
  animation: skel 1.4s linear infinite;
}
@keyframes skel {
  0% { background-position: 0 0; }
  100% { background-position: -200% 0; }
}

/* 空状态 */
.empty-wrap {
  margin-top: 32rpx;
  padding: 96rpx 48rpx;
  border-radius: 56rpx;
  background: var(--bg-card);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty-art {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 32rpx;
}
.empty-ring { position: absolute; inset: 0; border-radius: 50%; background: var(--bg-input); }
.empty-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #cbd5e1;
  border-radius: var(--radius-sm);
  transform: translate(-50%, -50%);
}
.empty-ttl { font-size: var(--font-md); color: var(--text-muted); }
.empty-sub { display:block; margin-top:14rpx; color:#8a94a3; font-size: var(--font-sm); line-height:1.6; text-align:center; }
.empty-cta {
  min-height: 88rpx;
  margin-top: 32rpx;
  padding: 0 48rpx;
  border-radius: var(--radius-xl);
  background: var(--brand-primary);
  color: var(--text-inverse);
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty-cta:active { opacity: 0.86; }

/* H5 同款预约卡片 */
.order-list { display: flex; flex-direction: column; gap: 24rpx; }
.order-card {
  border-radius: 32rpx;
  overflow: hidden;
  background: var(--bg-card);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}
.order-card:active { transform: scale(0.99); }
.order-card-content { padding: 24rpx 28rpx 16rpx; }

.status-badge {
  flex-shrink: 0;
  padding: 8rpx 22rpx;
  border-radius: 22rpx;
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
}
.status-amber { background: #fff4e6; color: #b45309; }
.status-blue { background: #eff6ff; color: #1d4ed8; }
.status-purple { background: #f5f3ff; color: #6d28d9; }
.status-green { background: #ecfdf5; color: #047857; }
.status-orange { background: #fff7ed; color: #c2410c; }
.status-gray { background: var(--bg-input); color: var(--text-body); }
.status-red { background: #fef2f2; color: #b91c1c; }

.order-card-body { display: flex; align-items: flex-start; gap: 20rpx; }
.order-date-box {
  width: 112rpx;
  min-height: 128rpx;
  flex-shrink: 0;
  border-radius: var(--radius-lg);
  background: linear-gradient(180deg, #fff5f7 0%, #ffe8ee 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.order-date-day { font-size: var(--font-2xl); font-weight: var(--weight-bold); color: var(--brand-primary); line-height: 1; }
.order-date-sub { font-size: var(--font-xs); font-weight: var(--weight-medium); color: var(--brand-primary); }
.order-date-weekday { margin-top: 8rpx; font-size: var(--font-xs); color: rgba(255,107,138,0.72) /* brand-primary-alpha */; }

.order-details { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.order-title-row { display: flex; align-items: flex-start; gap: 16rpx; margin-bottom:8rpx; }
.order-time-row { flex:1; min-width:0; margin-top:0; }
.order-time-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: var(--weight-bold);
  color: #1a1a2e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.info-row { min-width:0; min-height:40rpx; margin-top:6rpx; display:flex; align-items:flex-start; gap:10rpx; line-height:1.4; }
.info-icon {
  width: 28rpx;
  height: 28rpx;
  margin-top:2rpx;
  flex-shrink: 0;
}
.info-text { flex:1; min-width:0; color:var(--text-body); font-size:var(--font-sm); line-height:1.4; }
.info-text-strong { color:var(--text-primary); font-weight:var(--weight-medium); }
.info-text-muted { color:var(--text-muted); }
.order-detail-address { display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; }
.order-guidance-link { position:relative; min-height:44rpx; color:var(--brand-primary); font-weight:var(--weight-medium); }
.order-guidance-link::before { content:''; position:absolute; top:-20rpx; right:0; bottom:-24rpx; left:-12rpx; }
.order-guidance-link:active { opacity:.68; }
.payment-row { margin-top:8rpx; }
.payment-summary { color:var(--brand-primary); font-weight:var(--weight-medium); }
/* 卡片底部：未开始显示倒计时，终态显示详情入口 */
.order-footer {
  min-height: 88rpx;
  margin-top: 16rpx;
  padding: 14rpx 0;
  box-sizing: border-box;
  border-top: 1rpx solid #edf2f7;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: var(--text-muted);
  font-size: var(--font-sm);
}
.order-footer:active { opacity:.68; }
.footer-prompt { flex:1; min-width:0; display:flex; align-items:center; gap:12rpx; }
.footer-prompt-copy { min-width:0; display:flex; flex-direction:column; justify-content:center; gap:4rpx; }
.countdown-main,.countdown-next { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; line-height:1.35; }
.countdown-main { color:#605762; font-weight: var(--weight-semibold); }
.countdown-next { color:#98909a; font-size: var(--font-xs); }
.footer-action { min-height:60rpx; flex-shrink:0; padding-left:12rpx; display:flex; align-items:center; justify-content:flex-end; gap:8rpx; color:var(--brand-primary); font-size:var(--font-sm); font-weight:var(--weight-semibold); }
.footer-clock {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  border: 2rpx solid var(--brand-primary);
  border-radius: 50%;
  position: relative;
}
.footer-clock::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 5rpx;
  width: 2rpx;
  height: 8rpx;
  border-radius: 1rpx;
  background: var(--brand-primary);
  transform: translateX(-50%);
}
.footer-clock::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 7rpx;
  height: 2rpx;
  border-radius: 1rpx;
  background: var(--brand-primary);
}
.footer-chevron {
  width: 16rpx;
  height: 16rpx;
  flex-shrink: 0;
  margin-right: 4rpx;
  border-right: 3rpx solid #cbd5e1;
  border-top: 3rpx solid #cbd5e1;
  transform: rotate(45deg);
}
