page { background: #f5f6fa; }

.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ===== Hero 顶部 ===== */
.page-hero {
  background: linear-gradient(135deg, #ff6b8a 0%, #c084fc 100%);
  padding: 28rpx 40rpx 44rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-left {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.hero-count {
  font-size: 60rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

.hero-unit {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 400;
}

.hero-cta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 72rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1.5rpx solid rgba(255, 255, 255, 0.4);
}
.hero-cta:active { background: rgba(255, 255, 255, 0.32); }

.hero-cta-plus {
  font-size: 34rpx;
  font-weight: 300;
  color: #fff;
  line-height: 1;
  margin-top: -2rpx;
}

.hero-cta-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

/* ===== 吸顶 Tabs（满屏宽，超出横向滚动）===== */
.tabs-bar {
  position: sticky;
  z-index: 10;
  background: #f5f6fa;
  padding: 16rpx 0 14rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.tab-scroll {
  width: 100%;
  white-space: nowrap;
}

/* 左右内边距放在列表上，保证首/尾按钮不被裁切、可完整滑入 */
.tab-list {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 32rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: 30rpx;
  background: #fff;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  font-size: 24rpx;
  color: #6b7280;
  flex-shrink: 0;
}
.tab-item:active { background: #f3f4f6; }

.tab-active {
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  border-color: transparent;
  color: #fff;
  font-weight: 600;
}

/* ===== 列表区 ===== */
.list-area {
  padding: 20rpx 32rpx 0;
}

/* 骨架屏 */
.skel-list { display: flex; flex-direction: column; gap: 16rpx; }

.skel-card {
  height: 260rpx;
  border-radius: 24rpx;
  background: linear-gradient(90deg, #ebebef, #f5f6fa, #ebebef);
  background-size: 200% 100%;
  animation: skel 1.4s linear infinite;
}

@keyframes skel {
  0%   { background-position: 0 0; }
  100% { background-position: -200% 0; }
}

/* 空状态 */
.empty-wrap {
  margin: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-art {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 12rpx;
}

.empty-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF0F3 0%, #F5F3FF 100%);
}

.empty-dot {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B8A, #A78BFA);
}

.empty-ttl {
  font-size: 30rpx;
  font-weight: 600;
  color: #374151;
}

.empty-sub {
  font-size: 24rpx;
  color: #9ca3af;
  text-align: center;
  padding: 0 40rpx;
  line-height: 1.6;
}

.empty-cta {
  margin-top: 8rpx;
  height: 80rpx;
  padding: 0 56rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 138, 0.28);
}
.empty-cta:active { opacity: 0.85; }

/* ===== 预约卡片（与首页「我的预约」统一）===== */
.order-list { display: flex; flex-direction: column; gap: 16rpx; }

.order-card {
  display: flex;
  border-radius: 24rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}
.order-card:active { opacity: 0.96; transform: scale(0.995); }

.order-accent {
  width: 8rpx;
  flex-shrink: 0;
  background: linear-gradient(180deg, #FF6B8A 0%, #A78BFA 100%);
}

.order-card-content {
  flex: 1;
  min-width: 0;
  padding: 24rpx 28rpx 20rpx;
}

/* 顶部：美甲师 + 状态 */
.order-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.otc-tech {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.otc-avatar-wrap, .otc-avatar-ph {
  width: 52rpx; height: 52rpx;
  border-radius: 50%;
  flex-shrink: 0;
  overflow: hidden;
}
.otc-avatar { width: 52rpx; height: 52rpx; }
.otc-avatar-ph {
  background: linear-gradient(135deg, #FFE0EA, #EDE9FE);
  display: flex; align-items: center; justify-content: center;
}
.otc-avatar-char {
  font-size: 24rpx;
  font-weight: 700;
  color: #ff6b8a;
}

.otc-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 状态徽标 */
.status-badge {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  border-radius: 18rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.status-amber  { background: #fff4e6; color: #d97706; }
.status-blue   { background: #e6f7ff; color: #1d4ed8; }
.status-purple { background: #f3e8ff; color: #7c3aed; }
.status-green  { background: #dcfce7; color: #16a34a; }
.status-orange { background: #fff7ed; color: #ea580c; }
.status-gray   { background: #f3f4f6; color: #6b7280; }
.status-red    { background: #fef2f2; color: #dc2626; }

/* 内容：日期 + 详情 */
.order-card-body {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.order-date-box {
  width: 96rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0;
  background: linear-gradient(180deg, #FFF5F7 0%, #FFF0F3 100%);
  border-radius: 16rpx;
}
.order-date-day {
  font-size: 44rpx;
  font-weight: 700;
  color: #FF6B8A;
  line-height: 1;
}
.order-date-sub {
  font-size: 20rpx;
  color: rgba(255, 107, 138, 0.6);
  margin-top: 6rpx;
  font-weight: 500;
}

.order-details {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding-top: 2rpx;
}
.order-service-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: -0.5rpx;
  margin-bottom: 2rpx;
}
.order-detail-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}
.order-detail-text {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.4;
}
.order-detail-truncate {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.info-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}
.info-icon-time {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23d1d5db' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'/><polyline points='12 6 12 12 16 14'/></svg>");
}
.info-icon-loc {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23d1d5db' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z'/><circle cx='12' cy='10' r='3'/></svg>");
}

/* 底部：价格 / 报价操作 */
.order-card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18rpx;
  border-top: 1rpx solid #f5f6fa;
  min-height: 60rpx;
}

.foot-left { flex: 1; min-width: 0; }

.price-tag {
  font-size: 30rpx;
  font-weight: 700;
  color: #ff6b8a;
}

.foot-hint {
  font-size: 22rpx;
  color: #9ca3af;
}

.foot-arrow {
  font-size: 36rpx;
  color: #d1d5db;
  line-height: 1;
  flex-shrink: 0;
}

/* 报价操作按钮 */
.foot-actions {
  display: flex;
  gap: 10rpx;
  flex-shrink: 0;
}

.act-btn {
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 500;
}

.act-reject {
  background: #f3f4f6;
  color: #4b5563;
}
.act-reject:active { background: #e5e7eb; }

.act-accept {
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 138, 0.2);
}
.act-accept:active { opacity: 0.9; }
