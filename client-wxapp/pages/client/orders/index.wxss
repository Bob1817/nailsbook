page { background: #f8f9fc; }

.page {
  min-height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ===== 固定头部 ===== */
.header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(248,249,252,0.92);
  padding: 20rpx 40rpx 0;
}

/* 分类标签 */
.tab-scroll {
  white-space: nowrap;
}

.tab-list {
  display: inline-flex;
  gap: 12rpx;
  padding-bottom: 4rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  background: #fff;
  border: 1rpx solid rgba(0,0,0,0.06);
  font-size: 26rpx;
  color: #6b7280;
  flex-shrink: 0;
}

.tab-item:active {
  background: #f3f4f6;
}

.tab-active {
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  border-color: transparent;
  color: #fff;
  font-weight: 600;
}

/* ===== CTA 横幅 ===== */
.cta-banner {
  margin: 16rpx 0 0;
  display: flex;
  border-radius: 20rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.cta-banner:active {
  opacity: 0.96;
  transform: scale(0.995);
}

.cta-accent {
  width: 8rpx;
  flex-shrink: 0;
  background: linear-gradient(180deg, #FF6B8A 0%, #A78BFA 100%);
}

.cta-inner {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx;
  gap: 16rpx;
}

.cta-left {
  flex: 1;
  min-width: 0;
}

.cta-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 6rpx;
}

.cta-desc {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.4;
}

.cta-arrow {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 138, 0.18);
}

/* ===== 列表区 ===== */
.list-area {
  padding: 24rpx 40rpx;
}

/* 骨架屏 */
.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.skel-card {
  height: 220rpx;
  border-radius: 24rpx;
  background: linear-gradient(90deg, #f0f1f5, #f8f9fc, #f0f1f5);
  background-size: 200% 100%;
  animation: skel 1.4s linear infinite;
}

@keyframes skel {
  0% { background-position: 0 0; }
  100% { background-position: -200% 0; }
}

/* 空状态 */
.empty-card {
  margin: 80rpx 0;
  padding: 60rpx 40rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(15,23,42,0.06), 0 1rpx 4rpx rgba(15,23,42,0.03);
  border: 1rpx solid rgba(0,0,0,0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF0F3 0%, #F5F3FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.empty-icon-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
}

.empty-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #9ca3af;
}

/* ===== 预约卡 ===== */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.order-card {
  display: flex;
  border-radius: 24rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.order-card:active {
  opacity: 0.96;
  transform: scale(0.995);
}

.card-accent {
  width: 8rpx;
  flex-shrink: 0;
  background: linear-gradient(180deg, #FF6B8A 0%, #A78BFA 100%);
}

.card-body {
  flex: 1;
  min-width: 0;
  padding: 24rpx 24rpx 20rpx;
}

/* 卡片顶部：状态 */
.card-top {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-bottom: 18rpx;
}

.status-badge {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  border-radius: 18rpx;
  font-size: 22rpx;
  font-weight: 500;
}

/* Status colors */
.status-amber { background: #fff4e6; color: #d97706; }
.status-blue { background: #e6f7ff; color: #1d4ed8; }
.status-purple { background: #f3e8ff; color: #7c3aed; }
.status-green { background: #dcfce7; color: #16a34a; }
.status-orange { background: #fff7ed; color: #ea580c; }
.status-gray { background: #f3f4f6; color: #6b7280; }
.status-red { background: #fef2f2; color: #dc2626; }

/* 卡片主体：日期块 + 详情 */
.card-main {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.date-block {
  width: 88rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
  background: linear-gradient(180deg, #FFF5F7 0%, #FFF0F3 100%);
  border-radius: 14rpx;
}

.date-day {
  font-size: 40rpx;
  font-weight: 700;
  color: #FF6B8A;
  line-height: 1;
}

.date-sub {
  font-size: 20rpx;
  color: rgba(255, 107, 138, 0.6);
  margin-top: 4rpx;
  font-weight: 500;
}

.detail-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.detail-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: -0.5rpx;
  margin-bottom: 2rpx;
}

.detail-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.detail-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.detail-dot-time {
  background: #d1d5db;
}

.detail-dot-loc {
  background: #d1d5db;
}

.detail-text {
  font-size: 24rpx;
  color: #6b7280;
}

.truncate-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-footer {
  margin-top: 4rpx;
}

.quote-pill {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(255, 107, 138, 0.08);
  font-size: 22rpx;
  color: #FF6B8A;
  font-weight: 500;
}

.footer-hint {
  font-size: 22rpx;
  color: #9ca3af;
}

/* 卡片底部操作 */
.card-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f3f4f6;
}

.action-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 500;
}

.action-reject {
  background: #f8f9fc;
  color: #4b5563;
  border: 1rpx solid #f0f0f4;
}

.action-reject:active {
  background: #f0f1f5;
}

.action-accept {
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 138, 0.18);
}

.action-accept:active {
  opacity: 0.9;
}
