<nav-bar title="{{tradeView ? '我的订单' : '预约'}}"/>

<view class="filter-bar">
  <scroll-view scroll-x class="status-scroll" enhanced show-scrollbar="{{false}}">
    <view class="status-list">
      <view
        wx:for="{{tabs}}"
        wx:key="value"
        class="status-tab {{currentStatus === item.value ? 'status-tab-active' : ''}}"
        bindtap="switchStatus"
        data-status="{{item.value}}"
      >{{item.label}}</view>
    </view>
  </scroll-view>
  <view class="filter-create" bindtap="createOrder" role="button" aria-label="发起预约">
    <view class="filter-create-plus"></view>
  </view>
</view>

<view class="page">
  <!-- ===== 列表区（原生页面滚动）===== -->
  <view class="list-area">

    <!-- 骨架屏 -->
    <view wx:if="{{loading && orders.length === 0}}" class="skel-list">
      <view wx:for="{{[1,2,3]}}" wx:key="*this" class="skel-card"></view>
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{!loading && orders.length === 0}}" class="empty-wrap">
      <view class="empty-art">
        <view class="empty-ring"></view>
        <view class="empty-dot"></view>
      </view>
      <text class="empty-ttl">{{emptyTitle}}</text>
      <text class="empty-sub">{{emptyCopy}}</text>
      <view class="empty-cta" bindtap="createOrder">立即预约</view>
    </view>

    <!-- 预约卡片列表（与首页「我的预约」卡片统一）-->
    <view wx:else class="order-list">
      <view
        wx:for="{{orders}}"
        wx:key="id"
        class="order-card"
        bindtap="viewOrder"
        data-id="{{item.id}}"
      >
        <view class="order-card-content">
          <!-- 内容：日期 + 详情 -->
          <view class="order-card-body">
            <view class="order-date-box">
              <text class="order-date-sub">{{item._monthText}}</text>
              <text class="order-date-day">{{item._dayText}}</text>
              <text class="order-date-weekday">{{item._weekdayText}}</text>
            </view>
            <view class="order-details">
              <view class="order-title-row">
                <view class="info-row order-time-row">
                  <image class="info-icon" src="/static/icons/clock.svg" mode="aspectFit" />
                  <text class="order-time-title">{{item._timeTitleText}}</text>
                </view>
                <view class="status-badge {{item._statusClass}}">{{item.statusText}}</view>
              </view>
              <view class="info-row">
                <image class="info-icon" src="{{item._isShopService ? '/static/icons/shop.svg' : '/static/icons/tab-home.svg'}}" mode="aspectFit" />
                <text class="info-text">{{item._serviceModeText}}</text>
              </view>
              <view wx:if="{{item.technician && item.technician.name}}" class="info-row">
                <image class="info-icon" src="/static/icons/client.svg" mode="aspectFit" />
                <text class="info-text">美甲师 {{item.technician.name}}</text>
              </view>
              <view wx:if="{{item._isShopService && item._shopNameText}}" class="info-row">
                <image class="info-icon" src="/static/icons/shop.svg" mode="aspectFit" />
                <text class="info-text info-text-strong">{{item._shopNameText}}</text>
              </view>
              <view class="info-row info-row-address">
                <image class="info-icon" src="/static/icons/pin.svg" mode="aspectFit" />
                <text class="info-text info-text-muted order-detail-address">{{item._addressText}}</text>
              </view>
              <view wx:if="{{item._hasShopGuidance}}" class="info-row order-guidance-link" catchtap="openShopGuidance" data-id="{{item.id}}" role="button" aria-label="查看到店指引">
                <image class="info-icon" src="/static/icons/navigation.svg" mode="aspectFit" />
                <text class="info-text">查看到店指引 ›</text>
              </view>
              <view class="info-row payment-row">
                <image class="info-icon" src="/static/icons/wallet.svg" mode="aspectFit" />
                <text class="info-text payment-summary">{{item._paymentSummary}}</text>
              </view>
            </view>
          </view>

          <view class="order-footer" catchtap="viewOrder" data-id="{{item.id}}" role="button" aria-label="查看预约详情">
            <view class="footer-prompt">
              <image class="footer-clock" src="/static/icons/clock.svg" mode="aspectFit" aria-hidden="true" />
              <view class="footer-prompt-copy">
                <text class="countdown-main">{{item._isTerminal ? item.statusText : item._countdownText}}</text>
                <text class="countdown-next">{{item._nextStepText}}</text>
              </view>
            </view>
            <view class="footer-action"><text class="semantic-link">查看详情</text><view class="footer-chevron"></view></view>
          </view>
        </view>
      </view>
    </view>

  </view>
</view>

<tab-bar selected="orders"/>
