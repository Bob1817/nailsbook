<nav-bar title="我的预约" showBack/>
<view class="page">
  <!-- 固定头部：状态标签 + 发起预约横幅 -->
  <view class="header">
    <!-- 状态标签 -->
    <scroll-view scroll-x class="tab-scroll" enhanced show-scrollbar="{{false}}">
      <view class="tab-list">
        <view
          wx:for="{{tabs}}"
          wx:key="value"
          class="tab-item {{currentStatus === item.value ? 'tab-active' : ''}}"
          bindtap="switchStatus"
          data-status="{{item.value}}"
        >{{item.label}}</view>
      </view>
    </scroll-view>

    <!-- CTA 发起预约横幅 -->
    <view class="cta-banner" bindtap="createOrder">
      <view class="cta-accent"></view>
      <view class="cta-inner">
        <view class="cta-left">
          <text class="cta-title">发起预约</text>
          <text class="cta-desc">选择时间、服务与地址，快速安排你的下一次美甲</text>
        </view>
        <view class="cta-arrow">→</view>
      </view>
    </view>
  </view>

  <!-- 预约列表 -->
  <view class="list-area">
    <!-- 骨架屏 -->
    <view wx:if="{{loading && orders.length === 0}}" class="skeleton-list">
      <view wx:for="{{[1,2,3]}}" wx:key="*this" class="skel-card"></view>
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{!loading && orders.length === 0}}" class="empty-card">
      <view class="empty-icon-wrap">
        <view class="empty-icon-dot"></view>
      </view>
      <text class="empty-title">暂无预约</text>
    </view>

    <!-- 预约卡片列表 -->
    <view wx:else class="order-list">
      <view
        wx:for="{{orders}}"
        wx:key="id"
        class="order-card"
        bindtap="viewOrder"
        data-id="{{item.id}}"
      >
        <view class="card-accent"></view>
        <view class="card-body">
          <!-- 顶部：状态 -->
          <view class="card-top">
            <view class="status-badge {{item._statusClass}}">{{item.statusText}}</view>
          </view>

          <!-- 主体：日期块 + 详情 -->
          <view class="card-main">
            <view class="date-block">
              <text class="date-day">{{item._dayText}}</text>
              <text class="date-sub">{{item._monthText}}</text>
            </view>
            <view class="detail-col">
              <text class="detail-title">{{item._titleText}}</text>
              <view class="detail-row" wx:if="{{item._timeRangeText}}">
                <view class="detail-dot detail-dot-time"></view>
                <text class="detail-text">{{item._timeRangeText}}</text>
              </view>
              <view class="detail-row">
                <view class="detail-dot detail-dot-loc"></view>
                <text class="detail-text truncate-text">{{item._addressText}}</text>
              </view>
              <view class="detail-footer">
                <text wx:if="{{item.quotePrice}}" class="quote-pill">报价 ¥{{item._priceText}}</text>
                <text wx:elif="{{item._footerText}}" class="footer-hint">{{item._footerText}}</text>
              </view>
            </view>
          </view>

          <!-- 卡片底部操作（报价待确认） -->
          <view wx:if="{{item.status === 'quoted'}}" class="card-actions" catchtap="">
            <view class="action-btn action-reject" catchtap="rejectQuote" data-id="{{item.id}}">拒绝</view>
            <view class="action-btn action-accept" catchtap="acceptQuote" data-id="{{item.id}}">接受报价</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

<tab-bar selected="orders" />
