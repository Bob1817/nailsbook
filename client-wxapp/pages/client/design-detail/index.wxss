.container {
  min-height: 100vh;
  background: #f8f9fc;
  padding-bottom: 200rpx;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #FF6B8A;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-spinner.small {
  width: 32rpx;
  height: 32rpx;
  border-width: 3rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 错误状态 */
.error-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.error-text {
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 24rpx;
}

.btn-back {
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 48rpx;
  border-radius: 24rpx;
  border: none;
}

.btn-back::after {
  border: none;
}

/* 内容区域 */
.content {
  padding: 24rpx 40rpx;
}

/* 设计信息卡片 */
.design-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.title-wrap {
  flex: 1;
}

.design-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  display: block;
}

.design-date {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 4rpx;
  display: block;
}

.action-btns {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn.delete {
  background: #fef2f2;
}

/* CSS icon: edit */
.action-icon-edit {
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid #6b7280;
  border-radius: 2rpx;
  position: relative;
  transform: rotate(-45deg);
}

.action-icon-edit::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 4rpx solid transparent;
  border-right: 4rpx solid transparent;
  border-top: 6rpx solid #6b7280;
}

/* CSS icon: delete */
.action-icon-delete {
  width: 16rpx;
  height: 18rpx;
  border: 3rpx solid #dc2626;
  border-radius: 0 0 3rpx 3rpx;
  border-top: none;
  position: relative;
}

.action-icon-delete::before {
  content: '';
  position: absolute;
  top: -6rpx;
  left: -5rpx;
  right: -5rpx;
  height: 3rpx;
  background: #dc2626;
  border-radius: 2rpx;
}

/* 图片画廊 */
.image-gallery {
  margin-bottom: 24rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.gallery-img {
  width: calc(33.33% - 8rpx);
  aspect-ratio: 1;
  border-radius: 14rpx;
}

/* 描述 */
.desc-section {
  padding: 20rpx;
  background: #f9fafb;
  border-radius: 14rpx;
}

.desc-text {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.6;
}

/* 状态卡片 */
.status-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

.status-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.status-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-icon-wrap.status-pending {
  background: #fff7ed;
}

.status-icon-wrap.status-quoted {
  background: #eff6ff;
}

.status-icon-wrap.status-accepted {
  background: #ecfdf5;
}

.status-icon-wrap.status-converted {
  background: #faf5ff;
}

.status-icon-wrap.status-cancelled {
  background: #f9fafb;
}

.status-dot-icon {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B8A, #A78BFA);
}

.status-info {
  flex: 1;
}

.status-label {
  font-size: 24rpx;
  color: #6b7280;
  display: block;
}

.status-value {
  font-size: 28rpx;
  font-weight: 500;
  margin-top: 4rpx;
  display: block;
}

.status-value.status-pending {
  color: #d97706;
}

.status-value.status-quoted {
  color: #2563eb;
}

.status-value.status-accepted {
  color: #059669;
}

.status-value.status-converted {
  color: #9333ea;
}

.status-value.status-cancelled {
  color: #4b5563;
}

/* 报价信息 */
.quote-section {
  border-top: 1rpx solid #f3f4f6;
  padding-top: 24rpx;
}

.tech-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tech-avatar-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f1f5f9;
  overflow: hidden;
}

.tech-avatar {
  width: 100%;
  height: 100%;
}

.tech-avatar-text {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #FF6B8A;
  font-weight: 600;
}

.tech-detail {
  flex: 1;
}

.tech-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2937;
  display: block;
}

.tech-label {
  font-size: 22rpx;
  color: #6b7280;
  display: block;
}

.price-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: #fff5f7;
  border-radius: 14rpx;
  margin-bottom: 16rpx;
}

.price-label {
  font-size: 26rpx;
  color: #1f2937;
}

.price-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF6B8A;
}

.remark-wrap {
  padding: 16rpx;
  background: #f9fafb;
  border-radius: 14rpx;
}

.remark-label {
  font-size: 22rpx;
  color: #6b7280;
  display: block;
  margin-bottom: 8rpx;
}

.remark-text {
  font-size: 26rpx;
  color: #4b5563;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.95);
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  padding: 20rpx 40rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.btn-group {
  display: flex;
  gap: 16rpx;
}

.btn-quote {
  flex: 1;
  height: 88rpx;
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  border: none;
}

.btn-quote::after {
  border: none;
}

.btn-book {
  flex: 1;
  height: 88rpx;
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  border: none;
}

.btn-book.full {
  flex: 1;
}

.btn-book::after {
  border: none;
}

.btn-view-order {
  flex: 1;
  height: 88rpx;
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  border: none;
}

.btn-view-order::after {
  border: none;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}

.modal-content {
  width: 100%;
  max-width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  max-height: 80vh;
  overflow-y: auto;
}

.edit-modal {
  max-width: 650rpx;
}

.modal-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #fff1f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
}

.modal-icon-wrap.danger {
  background: #fef2f2;
}

.modal-icon-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B8A, #A78BFA);
}

.modal-icon-dot.danger {
  background: #dc2626;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  display: block;
  margin-bottom: 8rpx;
}

.modal-desc {
  font-size: 24rpx;
  color: #6b7280;
}

/* 弹窗中的美甲师信息 */
.modal-tech {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  margin-bottom: 24rpx;
}

.modal-tech-avatar-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f1f5f9;
  overflow: hidden;
}

.modal-tech-avatar {
  width: 100%;
  height: 100%;
}

.modal-tech-avatar-text {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #FF6B8A;
  font-weight: 600;
}

.modal-tech-info {
  flex: 1;
}

.modal-tech-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2937;
  display: block;
}

.modal-tech-label {
  font-size: 22rpx;
  color: #6b7280;
  display: block;
}

/* 弹窗操作按钮 */
.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.btn-cancel {
  flex: 1;
  height: 88rpx;
  background: #f1f5f9;
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-cancel::after {
  border: none;
}

.btn-confirm {
  flex: 1;
  height: 88rpx;
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-confirm.disabled {
  opacity: 0.5;
}

.btn-confirm::after {
  border: none;
}

.btn-danger {
  flex: 1;
  height: 88rpx;
  background: #fef2f2;
  color: #dc2626;
  border: 1rpx solid #fecaca;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-danger.disabled {
  opacity: 0.5;
}

.btn-danger::after {
  border: none;
}

/* 编辑表单 */
.edit-form {
  margin-bottom: 24rpx;
}

.form-group {
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #374151;
  margin-bottom: 12rpx;
  display: block;
}

.form-input  {
  width: 100%;
  height: 88rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #1f2937;
  box-sizing: border-box;
}

.form-textarea  {
  width: 100%;
  height: 200rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  color: #1f2937;
  box-sizing: border-box;
}

.placeholder {
  color: #6b7280;
}

.form-hint {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 8rpx;
  display: block;
}

/* 编辑图片 */
.edit-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.edit-img-item {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 14rpx;
  overflow: hidden;
}

.edit-img {
  width: 100%;
  height: 100%;
}

.edit-img-remove {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 32rpx;
  height: 32rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.remove-icon {
  font-size: 24rpx;
  color: #fff;
}

.edit-img-add {
  width: 120rpx;
  height: 120rpx;
  border-radius: 14rpx;
  border: 3rpx dashed #d1d5db;
  background: #f9fafb;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-img-add.uploading {
  border-color: #FF6B8A;
}

.add-icon {
  font-size: 40rpx;
  color: #6b7280;
}
