<work-detail-view
  sharePath="{{sharePath}}"
  visitorInfo="{{visitorInfo}}"
  isLoggedIn="{{isLoggedIn}}"
  work="{{work}}"
  imageUrls="{{work.imageUrls}}"
  comments="{{work.comments}}"
  loading="{{loading}}"
  loadFailed="{{error}}"
  loadErrorText="{{errorMessage}}"
  loadErrorDescription="{{errorDescription}}"
  canRetryLoad="{{canRetry}}"
  canComment="{{false}}"
  bind:back="goBack"
  bind:retry="loadWork"
  bind:book="bookSameStyle"
  bind:contact="contactArtist"
  bind:viewworks="viewMoreWorks"
  bind:like="goToLogin"
  bind:favorite="goToLogin"
  bind:commentfocus="goToLogin"
  bind:commentlocked="goToLogin"
  bind:artist="goToArtist"
/>
