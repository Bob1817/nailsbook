<nav-bar title="作品详情" showBack light/>
<view class="container">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
  </view>

  <!-- 错误状态 -->
  <view wx:elif="{{error}}" class="error-wrap">
    <text class="error-text">作品不存在或已下架</text>
    <button class="btn-back" bindtap="goBack">返回</button>
  </view>

  <!-- 内容 -->
  <view wx:else class="content">

    <!-- 图片轮播 -->
    <view class="image-section">
      <swiper
        class="image-swiper"
        autoplay="{{false}}"
        circular
        bindchange="onSwiperChange"
      >
        <swiper-item
          wx:for="{{work.imageUrls}}"
          wx:key="*this"
          bindtap="previewImage"
          data-url="{{item}}"
        >
          <image src="{{item}}" mode="aspectFill" class="work-image" />
        </swiper-item>
      </swiper>

      <!-- 指示器 -->
      <view wx:if="{{work.imageUrls.length > 1}}" class="indicator">
        <view
          wx:for="{{work.imageUrls}}"
          wx:key="*this"
          class="dot {{index === imageIndex ? 'active' : ''}}"
        ></view>
      </view>
    </view>

    <!-- 信息面板 -->
    <view class="info-panel">
      <!-- 标题和描述 -->
      <view class="title-section">
        <text class="work-title">{{work.title || '未命名作品'}}</text>
        <text wx:if="{{work.description}}" class="work-desc">{{work.description}}</text>
      </view>

      <!-- 标签 -->
      <view wx:if="{{work.tags && work.tags.length > 0}}" class="tags-section">
        <view
          wx:for="{{work.tags}}"
          wx:key="*this"
          class="tag"
        >
          <text class="tag-text">#{{item}}</text>
        </view>
      </view>

      <!-- 美甲师信息 -->
      <view wx:if="{{work.technician}}" class="tech-section" bindtap="goToArtist">
        <view class="tech-avatar-wrap">
          <image wx:if="{{work.technician.avatarUrl}}" src="{{work.technician.avatarUrl}}" mode="aspectFill" class="tech-avatar" />
          <text wx:else class="tech-avatar-text">{{work.technician.name[0]}}</text>
        </view>
        <view class="tech-info">
          <text class="tech-name">{{work.technician.name}}</text>
          <text class="tech-label">美甲师</text>
        </view>
        <text class="tech-arrow">›</text>
      </view>

      <!-- 操作按钮 -->
      <view class="actions-section">
        <button class="action-btn" bindtap="goToLogin">
          <view class="menu-icon icon-heart"></view>
          <text class="action-text">喜欢</text>
          <text wx:if="{{work.likeCount > 0}}" class="action-count">{{work.likeCount}}</text>
        </button>
        <button class="action-btn" bindtap="goToLogin">
          <view class="menu-icon icon-bookmark"></view>
          <text class="action-text">收藏</text>
        </button>
        <button class="action-btn share" open-type="share">
          <view class="menu-icon icon-share"></view>
          <text class="action-text">分享</text>
        </button>
      </view>

      <!-- 评论区 -->
      <view class="comments-section">
        <view class="comments-header">
          <text class="comments-title">评论</text>
          <text class="comments-count">{{work.commentCount || 0}} 条</text>
        </view>

        <view wx:if="{{work.comments && work.comments.length > 0}}" class="comments-list">
          <view
            wx:for="{{work.comments}}"
            wx:key="id"
            class="comment-item"
          >
            <view class="comment-avatar-wrap">
              <image wx:if="{{item.user.avatarUrl}}" src="{{item.user.avatarUrl}}" mode="aspectFill" class="comment-avatar" />
              <text wx:else class="comment-avatar-text">{{item.user.name[0]}}</text>
            </view>
            <view class="comment-content">
              <view class="comment-header">
                <text class="comment-name">{{item.user.name}}</text>
                <text wx:if="{{item.user.role === 'technician'}}" class="comment-badge">美甲师</text>
              </view>
              <text class="comment-text">{{item.content}}</text>
            </view>
          </view>
        </view>

        <view wx:else class="comments-empty">
          <text class="empty-text">暂无评论</text>
        </view>
      </view>
    </view>

    <!-- 底部评论输入框 -->
    <view class="bottom-bar">
      <button class="comment-input" bindtap="goToLogin">
        <text class="input-placeholder">添加评论…</text>
      </button>
      <view class="book-same-btn" bindtap="goToLogin">
        <text class="book-same-text">预约同款</text>
      </view>
    </view>
  </view>
</view>
