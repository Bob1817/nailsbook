.container {
  min-height: 100vh;
  width: 100%;
  padding: 0;
  background: var(--bg-card);
  position: relative;
  box-sizing: border-box;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--nb-surface);
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 错误状态 */
.error-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: var(--space-2xl);
}

.error-text {
  font-size: var(--font-md);
  color: var(--text-muted);
  margin-bottom: var(--space-md);
}
.error-sub { margin-bottom:var(--space-lg); color: var(--text-muted); font-size: var(--font-sm); }
.btn-retry { min-height:88rpx; margin:0 0 20rpx; padding:0 56rpx; border:0; border-radius: var(--radius-xl); background:var(--nb-ink); color: var(--text-inverse); font-size: var(--font-md); line-height:88rpx; }
.btn-retry::after { border:0; }

.btn-back {
  min-height: 88rpx;
  background: var(--brand-primary);
  color: var(--text-inverse);
  font-size: var(--font-md);
  padding: var(--space-sm) var(--space-2xl);
  border-radius: var(--radius-xl);
  border: none;
}

.btn-back::after {
  border: none;
}

/* 内容 */
.content {
  min-height: 100vh;
  width: 100%;
  background: var(--bg-card);
}

/* 顶部返回按钮 */
.top-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  padding: var(--space-md);
  padding-top: calc(var(--space-md) + env(safe-area-inset-top));
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.20);
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: var(--font-lg);
  color: var(--text-inverse);
}

/* 图片轮播 */
.image-section {
  position: relative;
  width: 100%;
  height: 55vh;
  margin: 0;
  background: var(--nb-page);
  overflow: hidden;
}

.image-swiper {
  width: 100%;
  height: 100%;
}

.work-image {
  display: block;
  width: 100%;
  height: 100%;
}

.indicator {
  position: absolute;
  bottom: 24rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 12rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
}

.dot.active {
  background: var(--bg-gradient-entry);
  width: 32rpx;
  border-radius: 6rpx;
}

/* 信息面板 */
.info-panel {
  position: relative;
  z-index: 2;
  width: 100%;
  margin-top: -40rpx;
  background: var(--bg-card);
  border-radius: 40rpx 40rpx 0 0;
  padding: 38rpx var(--space-lg) 200rpx;
  box-shadow: 0 -10rpx 30rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
}

/* 标题和描述 */
.title-section {
  margin-bottom: var(--space-md);
}

.work-title {
  display: block;
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.work-desc {
  display: block;
  font-size: var(--font-md);
  color: var(--text-muted);
  line-height: 1.6;
}

/* 标签 */
.tags-section {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: var(--space-md);
}

.tag {
  padding: var(--space-xs) var(--space-xl);
  background: var(--nb-page);
  border-radius: var(--radius-sm);
}

.tag-text {
  font-size: var(--font-xs);
  color: var(--nb-secondary);
  font-weight: var(--weight-medium);
}

/* 美甲师信息 */
.tech-section {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: 20rpx 0;
  border-top: 0;
  border-bottom: 0;
  margin-bottom: var(--space-md);
}

.tech-avatar-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--nb-page);
  overflow: hidden;
}

.tech-avatar {
  width: 100%;
  height: 100%;
}

.tech-avatar-text {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-md);
  color: var(--brand-primary);
  font-weight: var(--weight-semibold);
}

.tech-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.tech-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.tech-name {
  display: inline;
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  color: var(--text-primary);
}

.tech-label {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 10rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-xs);
  background: var(--warm-accent-light);
  color: var(--warm-accent);
}

.tech-meta {
  font-size: var(--font-xs);
  line-height: 1.4;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tech-meta-join {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  flex-wrap: wrap;
}
.tech-meta-item {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--text-secondary);
}
.tech-meta-dot {
  color: var(--text-muted);
  font-size: var(--font-xs);
}

.tech-arrow {
  font-size: var(--font-lg);
  color: var(--text-muted);
}

/* 操作按钮 */
.actions-section {
  display: flex;
  gap: var(--space-sm);
  margin-bottom: var(--space-lg);
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  padding: 20rpx;
  background: var(--bg-input);
  border-radius: var(--radius-md);
  border: none;
}

.action-btn::after {
  border: none;
}

.action-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.action-text {
  font-size: var(--font-sm);
  color: var(--text-body);
  font-weight: var(--weight-medium);
}

.action-count {
  font-size: var(--font-xs);
  color: var(--text-muted);
}

/* 评论区 */
.comments-section {
  margin-bottom: var(--space-lg);
}

.comments-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.comments-title {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.comments-count {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

.comments-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.comment-item {
  display: flex;
  gap: var(--space-sm);
}

.comment-avatar-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bg-input);
  overflow: hidden;
  flex-shrink: 0;
}

.comment-avatar {
  width: 100%;
  height: 100%;
}

.comment-avatar-text {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm);
  color: var(--text-muted);
  font-weight: var(--weight-semibold);
}

.comment-content {
  flex: 1;
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  padding: var(--space-sm) var(--space-xl);
}

.comment-header {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  margin-bottom: var(--space-xs);
}

.comment-name {
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  color: var(--text-body);
}

.comment-badge {
  font-size: var(--font-xs);
  color: var(--nb-secondary);
  background: var(--nb-page);
  padding: 2rpx var(--space-xl);
  border-radius: 10rpx;
}

.comment-text {
  font-size: var(--font-sm);
  color: var(--text-body);
  line-height: var(--leading-normal);
}

.comments-empty {
  padding: var(--space-xl);
  text-align: center;
  background: var(--bg-input);
  border-radius: var(--radius-sm);
}

.empty-text {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

/* 底部评论输入框 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--space-sm) var(--space-xl);
  padding-bottom: calc(var(--space-sm) + env(safe-area-inset-bottom));
  background: var(--bg-page);
  border-top: 0;
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.comment-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  background: var(--nb-soft-surface);
  border-radius: var(--radius-md);
  padding: 0 var(--space-lg);
  display: flex;
  align-items: center;
  border: 0;
}

.book-same-btn {
  flex-shrink: 0;
  height: 88rpx;
  padding: 0 36rpx;
  border-radius: var(--radius-md);
  background: var(--brand-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.3) /* brand-primary-alpha */;
}
.book-same-btn:active { opacity: 0.85; }
.book-same-text {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-inverse);
  white-space: nowrap;
}

.comment-input::after {
  border: none;
}

.input-placeholder  {
  font-size: var(--font-md);
  color: var(--text-muted);
}

/* ===== 美甲师微信咨询名片弹层 ===== */
.nb-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-overlay, rgba(0, 0, 0, 0.45));
  z-index: 999;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.nb-contact-sheet {
  background: var(--nb-surface);
  border-radius: var(--radius-xl, 32rpx) var(--radius-xl, 32rpx) 0 0;
  padding: var(--space-lg, 32rpx) var(--space-lg, 32rpx) calc(var(--space-xl, 40rpx) + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: slideUp 0.25s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.nb-contact-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-md, 24rpx);
}

.nb-contact-title {
  font-size: var(--font-lg, 36rpx);
  font-weight: var(--weight-bold, 600);
  color: var(--nb-ink);
}

.nb-contact-close {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--nb-muted);
}

.nb-contact-artist-card {
  display: flex;
  align-items: center;
  gap: var(--space-md, 24rpx);
  padding: var(--space-md, 24rpx);
  background: var(--nb-soft-surface);
  border-radius: var(--radius-lg, 24rpx);
  margin-bottom: var(--space-md, 24rpx);
}

.nb-contact-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--nb-page);
}

.nb-contact-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.nb-contact-name {
  font-size: var(--font-md, 30rpx);
  font-weight: var(--weight-semibold, 600);
  color: var(--nb-ink);
}

.nb-contact-sub {
  font-size: var(--font-xs, 24rpx);
  color: var(--nb-muted);
}

.nb-wechat-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md, 24rpx);
  border: 1rpx solid var(--nb-line);
  border-radius: var(--radius-lg, 24rpx);
  margin-bottom: var(--space-lg, 32rpx);
  background: var(--nb-surface);
}

.nb-wechat-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.nb-wechat-label {
  font-size: var(--font-xs, 24rpx);
  color: var(--nb-muted);
}

.nb-wechat-val {
  font-size: var(--font-md, 30rpx);
  font-weight: var(--weight-medium, 500);
  color: var(--nb-ink);
  font-family: monospace;
}

.nb-wechat-val.is-masked {
  font-size: var(--font-sm, 28rpx);
  color: var(--nb-muted);
}

.nb-wechat-copy-btn {
  height: 44px;
  padding: 0 32rpx;
  border-radius: var(--radius-md, 16rpx);
  background: var(--nb-soft-surface);
  color: var(--nb-ink);
  font-size: var(--font-sm, 28rpx);
  font-weight: var(--weight-medium, 500);
  border: 1rpx solid var(--nb-line);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
}

.nb-wechat-copy-btn::after {
  border: none;
}

.nb-wechat-empty {
  padding: var(--space-md, 24rpx);
  background: var(--nb-soft-surface);
  border-radius: var(--radius-lg, 24rpx);
  margin-bottom: var(--space-lg, 32rpx);
  text-align: center;
}

.nb-wechat-empty-text {
  font-size: var(--font-xs, 24rpx);
  color: var(--nb-muted);
}

.nb-contact-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm, 16rpx);
}

.nb-action-btn {
  height: 44px;
  width: 100%;
  border-radius: var(--radius-md, 16rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: var(--font-md, 30rpx);
  font-weight: var(--weight-medium, 500);
  margin: 0;
  box-sizing: border-box;
}

.nb-action-btn::after {
  border: none;
}

.nb-action-primary {
  background: var(--nb-action);
  color: var(--nb-action-text);
}

.nb-action-ghost {
  background: transparent;
  color: var(--nb-muted);
  border: 1rpx solid var(--nb-line);
}

.nb-action-icon {
  width: 36rpx;
  height: 36rpx;
}

