.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 32rpx;
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.faq-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.faq-item {
  padding: 0 32rpx;
}

.faq-border {
  border-bottom: 1rpx solid #f5f5f5;
}

.faq-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  gap: 20rpx;
}

.faq-q {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 1.5;
}

.faq-arrow {
  font-size: 36rpx;
  color: #ccc;
  transition: transform 0.2s;
  display: inline-block;
}

.arrow-open {
  transform: rotate(90deg);
}

.faq-answer {
  padding-bottom: 28rpx;
}

.faq-a {
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
}

.contact-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  gap: 24rpx;
  margin-bottom: 16rpx;
}
.contact-card:active { opacity: 0.7; }

.contact-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: #fff0f5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.contact-icon { font-size: 40rpx; }

.contact-info {
  flex: 1;
}

.contact-title {
  display: block;
  font-size: 30rpx;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}

.contact-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.arrow {
  font-size: 40rpx;
  color: #ccc;
}

.contact-tip {
  display: block;
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
  padding: 0 4rpx;
}
