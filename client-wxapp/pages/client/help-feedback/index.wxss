.container {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 32rpx;
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  display: block;
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin-bottom: var(--space-sm);
  padding: 0 4rpx;
}

.faq-card {
  background: var(--bg-page);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.faq-item {
  padding: 0 32rpx;
}

.faq-border {
  border-bottom: 0;
}

.faq-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  gap: 20rpx;
}

.faq-q {
  flex: 1;
  font-size: var(--font-md);
  color: var(--text-primary);
  line-height: var(--leading-normal);
}

.faq-arrow {
  font-size: var(--font-lg);
  color: var(--text-muted);
  transition: transform 0.2s;
  display: inline-block;
}

.arrow-open {
  transform: rotate(90deg);
}

.faq-answer {
  padding-bottom: 28rpx;
}

.faq-a {
  font-size: var(--font-sm);
  color: var(--text-body);
  line-height: 1.7;
}

.contact-card {
  display: flex;
  align-items: center;
  background: var(--bg-page);
  border-radius: var(--radius-md);
  padding: 28rpx 40rpx;
  gap: 24rpx;
  margin-bottom: var(--space-sm);
}
.contact-card:active { opacity: 0.7; }

.contact-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-tag);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.contact-icon { font-size: var(--font-xl); }

/* CSS Icon: Chat Bubble */
.menu-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  vertical-align: middle;
}
.icon-chat {
  width: 28rpx;
  height: 24rpx;
  position: relative;
}
.icon-chat::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 18rpx;
  border-radius: 6rpx;
  background: var(--brand-primary);
}
.icon-chat::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 6rpx;
  width: 0;
  height: 0;
  border-left: 5rpx solid transparent;
  border-right: 5rpx solid transparent;
  border-top: 7rpx solid var(--brand-primary);
}

.contact-info {
  flex: 1;
}

.contact-title {
  display: block;
  font-size: var(--font-md);
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.contact-desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
}

.arrow {
  font-size: var(--font-xl);
  color: var(--text-muted);
}

.contact-tip {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
  line-height: 1.6;
  padding: 0 4rpx;
}
