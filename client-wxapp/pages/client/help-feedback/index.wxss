.container {
  min-height: 100vh;
  background: #f8f9fc;
  padding: 32rpx;
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.faq-card {
  background: #f8f9fc;
  border-radius: 24rpx;
  overflow: hidden;
}

.faq-item {
  padding: 0 32rpx;
}

.faq-border {
  border-bottom: 1rpx solid #f5f5f5;
}

.faq-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  gap: 20rpx;
}

.faq-q {
  flex: 1;
  font-size: 28rpx;
  color: #1f2937;
  line-height: 1.5;
}

.faq-arrow {
  font-size: 36rpx;
  color: #9ca3af;
  transition: transform 0.2s;
  display: inline-block;
}

.arrow-open {
  transform: rotate(90deg);
}

.faq-answer {
  padding-bottom: 28rpx;
}

.faq-a {
  font-size: 26rpx;
  color: #374151;
  line-height: 1.7;
}

.contact-card {
  display: flex;
  align-items: center;
  background: #f8f9fc;
  border-radius: 24rpx;
  padding: 28rpx 40rpx;
  gap: 24rpx;
  margin-bottom: 16rpx;
}
.contact-card:active { opacity: 0.7; }

.contact-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 14rpx;
  background: #fff0f5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.contact-icon { font-size: 40rpx; }

/* CSS Icon: Chat Bubble */
.menu-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  vertical-align: middle;
}
.icon-chat {
  width: 28rpx;
  height: 24rpx;
  position: relative;
}
.icon-chat::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 18rpx;
  border-radius: 6rpx;
  background: #ff6b8a;
}
.icon-chat::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 6rpx;
  width: 0;
  height: 0;
  border-left: 5rpx solid transparent;
  border-right: 5rpx solid transparent;
  border-top: 7rpx solid #ff6b8a;
}

.contact-info {
  flex: 1;
}

.contact-title {
  display: block;
  font-size: 30rpx;
  color: #1f2937;
  margin-bottom: 6rpx;
}

.contact-desc {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
}

.arrow {
  font-size: 40rpx;
  color: #9ca3af;
}

.contact-tip {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.6;
  padding: 0 4rpx;
}
