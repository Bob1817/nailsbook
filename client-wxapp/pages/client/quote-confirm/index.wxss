.quote-to-artist-btn { width:100%; min-height:96rpx; margin:0; display:flex; align-items:center; justify-content:center; border-radius:var(--radius-lg); background:var(--nb-action); color:var(--text-inverse); font-size:var(--font-sm); font-weight:var(--weight-semibold); }
.quote-to-home-btn { width:100%; min-height:88rpx; margin:0; display:flex; align-items:center; justify-content:center; border-radius:var(--radius-lg); background:var(--nb-soft-surface); color:var(--text-secondary); font-size:var(--font-sm); }

