<nav-bar title="我的点赞" showBack/>
<view class="page">
  <collection-overview title="喜欢过的作品" subtitle="从点赞记录里继续发现相似灵感" count="{{works.length}}" show-count="{{!loading && !loadFailed}}" />

  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
  </view>

  <state-card wx:elif="{{loadFailed}}" class="booking-action" type="error" title="点赞记录加载失败" description="请检查网络后重新加载" actionText="重新加载" bind:action="loadLikes" />

  <state-card wx:elif="{{works.length === 0}}" class="booking-action" icon="/static/icons/social-heart.svg" title="还没有点赞的作品" description="去发现喜欢的美甲作品并点赞吧" actionText="发现作品" bind:action="goWorks" />

  <view wx:else class="waterfall-wrap">
    <view class="waterfall">
      <view class="col" wx:for="{{waterfallCols}}" wx:for-item="col" wx:key="id">
        <view wx:for="{{col.items}}" wx:key="id" class="w-card">
          <work-card variant="editorial" work="{{item}}" bind:cardtap="viewWork" bind:artisttap="viewArtist" bind:liketap="toggleLike"/>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{hasMore}}" class="page-hint">继续下滑加载更多</view>

</view>
