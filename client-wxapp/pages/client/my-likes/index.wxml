<nav-bar title="我的点赞" showBack/>
<view class="page">

  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
  </view>

  <view wx:elif="{{loadFailed}}" class="empty-wrap">
    <text class="empty-title">点赞记录加载失败</text>
    <text class="empty-desc">请检查网络后重新加载</text>
    <view class="go-btn" bindtap="loadLikes">重新加载</view>
  </view>

  <view wx:elif="{{works.length === 0}}" class="empty-wrap">
    <view class="empty-icon"><view class="empty-heart"></view></view>
    <text class="empty-title">还没有点赞的作品</text>
    <text class="empty-desc">去发现喜欢的美甲作品并点赞吧</text>
    <view class="go-btn" bindtap="goWorks">发现作品</view>
  </view>

  <view wx:else class="waterfall-wrap">
    <view class="waterfall">
      <!-- 左列 -->
      <view class="col">
        <view wx:for="{{leftCol}}" wx:key="id" class="w-card {{item.aspect}}" bindtap="viewWork" data-id="{{item.id}}">
          <work-card work="{{item}}"/>
        </view>
      </view>
      <!-- 右列 -->
      <view class="col">
        <view wx:for="{{rightCol}}" wx:key="id" class="w-card {{item.aspect}}" bindtap="viewWork" data-id="{{item.id}}">
          <work-card work="{{item}}"/>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{hasMore}}" class="page-hint">继续下滑加载更多</view>

</view>
