<view class="container">
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
  </view>

  <view wx:elif="{{works.length === 0}}" class="empty-wrap">
    <text class="empty-icon">❤️</text>
    <text class="empty-title">还没有点赞的作品</text>
    <text class="empty-desc">去发现喜欢的美甲作品并点赞吧</text>
    <view class="go-btn" bindtap="goWorks">去浏览</view>
  </view>

  <view wx:else class="grid">
    <view
      wx:for="{{works}}"
      wx:key="id"
      class="work-card"
      bindtap="viewWork"
      data-id="{{item.id}}"
    >
      <view class="work-img-wrap">
        <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" class="work-img" />
        <view wx:else class="work-img-placeholder">
          <text class="placeholder-icon">🖼️</text>
        </view>
        <view class="like-badge">
          <text class="like-icon">❤️</text>
          <text class="like-count">{{item.likeCount}}</text>
        </view>
      </view>
      <view class="work-meta">
        <text class="tech-name">{{item.technicianName}}</text>
        <text class="work-title">{{item.title}}</text>
      </view>
    </view>
  </view>
</view>
