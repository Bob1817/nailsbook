page { background: var(--bg-page-alt); }

.page {
  min-height: 100vh;
  padding-bottom: calc(var(--space-xl) + env(safe-area-inset-bottom));
}

/* ===== 加载中 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 160rpx 0;
}
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(0, 0, 0, 0.2) /* brand-primary-alpha */;
  border-top-color: var(--brand-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }


/* ===== 瀑布流（与发现/作品列表页一致）===== */
.waterfall-wrap { padding: var(--space-md) 28rpx 0; }

.waterfall {
  width:100%; max-width:100%; min-width:0; overflow:hidden; box-sizing:border-box;
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.col {
  flex: 1 1 0; min-width:0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ===== 作品卡片：height:0 + padding-bottom 百分比 ===== */
.w-card { width:100%; box-sizing:border-box; }
.w-card:active { transform: scale(0.984); opacity: 0.94; }

.page-hint { padding:28rpx 0 var(--space-xl); color:var(--nb-secondary); font-size: var(--font-xs); text-align:center; }
.waterfall-wrap{padding-top:var(--space-md)}.empty-wrap{margin:var(--space-md) var(--space-lg);padding:96rpx var(--space-xl);border-radius:24rpx;background:var(--nb-surface)}.empty-icon{width:96rpx;height:96rpx;margin-bottom:22rpx;background:var(--nb-soft-surface)}.go-btn{border-radius:16rpx;background:var(--nb-action);box-shadow:none;font-size:var(--font-sm)}

@import '../../../styles/booking-actions.wxss';
.go-btn.booking-action { min-height: 44px; height: var(--control-hit-height); border-radius: 8px; padding: 0 var(--space-md); font-size: var(--font-sm); box-shadow: none; }
