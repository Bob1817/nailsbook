page { background: var(--bg-page-alt); }

.page {
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* ===== 加载中 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 160rpx 0;
}
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(0, 0, 0, 0.2) /* brand-primary-alpha */;
  border-top-color: var(--brand-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ===== 空状态 ===== */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 60rpx;
}
.empty-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--nb-page);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}
.empty-heart {
  width: 40rpx;
  height: 40rpx;
  transform: rotate(-45deg);
  background: var(--brand-primary);
  position: relative;
}
.empty-heart::before,
.empty-heart::after {
  content: '';
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--brand-primary);
}
.empty-heart::before { top: -20rpx; left: 0; }
.empty-heart::after { left: 20rpx; top: 0; }
.empty-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin-bottom: 12rpx;
}
.empty-desc {
  font-size: var(--font-sm);
  color: var(--text-muted);
  margin-bottom: 36rpx;
  text-align: center;
}
.go-btn {
  min-height: 88rpx;
  padding: 0 56rpx;
  border-radius: 999rpx;
  background: var(--brand-gradient);
  color: var(--text-inverse);
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.28) /* brand-primary-alpha */;
}
.go-btn:active { opacity: 0.85; }

/* ===== 瀑布流（与发现/作品列表页一致）===== */
.waterfall-wrap { padding: 24rpx 28rpx 0; }

.waterfall {
  width:100%; max-width:100%; min-width:0; overflow:hidden; box-sizing:border-box;
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.col {
  flex: 1 1 0; width:calc((100% - 20rpx) / 2); min-width:0; max-width:calc((100% - 20rpx) / 2);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ===== 作品卡片：height:0 + padding-bottom 百分比 ===== */
.w-card { width:100%; box-sizing:border-box; }
.w-card:active { transform: scale(0.984); opacity: 0.94; }

.page-hint { padding:28rpx 0 40rpx; color:var(--nb-secondary); font-size: var(--font-xs); text-align:center; }
.waterfall-wrap{padding-top:24rpx}.empty-wrap{margin:24rpx 32rpx;padding:96rpx 40rpx;border-radius:24rpx;background:var(--nb-surface)}.empty-icon{width:96rpx;height:96rpx;margin-bottom:22rpx;background:var(--nb-soft-surface)}.go-btn{border-radius:16rpx;background:var(--nb-action);box-shadow:none;font-size:var(--font-sm)}

@import '../../../styles/booking-actions.wxss';
.go-btn.booking-action { min-height: 44px; height: var(--control-hit-height); border-radius: 8px; padding: 0 24rpx; font-size: var(--font-sm); box-shadow: none; }
