page { background: var(--bg-page-alt); }

.page {
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* ===== 加载中 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 160rpx 0;
}
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255,107,138,0.2) /* brand-primary-alpha */;
  border-top-color: var(--brand-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ===== 空状态 ===== */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 60rpx;
}
.empty-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFE2EA, #EDE9FE);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}
.empty-heart {
  width: 40rpx;
  height: 40rpx;
  transform: rotate(-45deg);
  background: var(--brand-primary);
  position: relative;
}
.empty-heart::before,
.empty-heart::after {
  content: '';
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--brand-primary);
}
.empty-heart::before { top: -20rpx; left: 0; }
.empty-heart::after { left: 20rpx; top: 0; }
.empty-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin-bottom: 12rpx;
}
.empty-desc {
  font-size: var(--font-sm);
  color: var(--text-muted);
  margin-bottom: 36rpx;
  text-align: center;
}
.go-btn {
  min-height: 88rpx;
  padding: 0 56rpx;
  border-radius: 999rpx;
  background: var(--brand-gradient);
  color: var(--text-inverse);
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255,107,138,0.28) /* brand-primary-alpha */;
}
.go-btn:active { opacity: 0.85; }

/* ===== 瀑布流（与发现/作品列表页一致）===== */
.waterfall-wrap { padding: 20rpx 16rpx 0; }

.waterfall {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* ===== 作品卡片：height:0 + padding-bottom 百分比 ===== */
.w-card {
  position: relative;
  width: 100%;
  height: 0;
  overflow: hidden;
  border-radius: var(--radius-md);
  box-sizing: border-box;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.08), 0 1rpx 4rpx rgba(15, 23, 42, 0.04);
}
.w-card:active { transform: scale(0.984); opacity: 0.94; }

.aspect-3-4 { padding-bottom: 133.33%; }
.aspect-4-5 { padding-bottom: 125%; }
.aspect-5-6 { padding-bottom: 120%; }
.page-hint { padding:28rpx 0 40rpx; color:#81717a; font-size: var(--font-xs); text-align:center; }
