<page-meta page-style="background: var(--nb-surface);"/>
<nav-bar title="{{isEdit ? '编辑上门地址' : '新增上门地址'}}" showBack/>
<secondary-page-header title="上门服务地点" subtitle="地址仅用于上门预约，保存后可在地址管理中修改。"/>
<view class="address-edit-page">
  <view class="address-section">
    <text class="address-section-title">联系信息</text>
    <form-field class="contact-field" outlined required label="联系人" placeholder="姓名" value="{{contactName}}" data-field="contactName" bindinput="onInput" disabled="{{submitting}}"/>
    <form-field outlined required label="手机号" type="number" maxlength="11" placeholder="服务时可联系的手机号" value="{{contactPhone}}" data-field="contactPhone" bindinput="onInput" disabled="{{submitting}}"/>
  </view>
  <view class="address-section">
    <text class="address-section-title">地址与位置</text>
    <form-field outlined required label="所在地区" custom-control disabled="{{submitting || choosingLocation}}">
      <picker slot="control" class="region-picker" mode="region" value="{{[province, city, district]}}" bindchange="onRegionChange" disabled="{{submitting || choosingLocation}}"><view class="region-value {{city ? '' : 'is-placeholder'}}"><text>{{city ? province + ' ' + city + ' ' + district : '请选择省市区'}}</text><text>›</text></view></picker>
    </form-field>
    <location-field required confirmed="{{latitude != null && longitude != null}}" value="{{locationName}}" loading="{{choosingLocation}}" disabled="{{submitting}}" hint="先选择省市区，再确认地图地点。修改地区或详细地址后需要重新选点。" bindchoose="chooseMapLocation"/>
    <form-field class="detail-field" outlined required label="详细地址" value="{{detailAddress}}" placeholder="地图选点后自动填入" data-field="detailAddress" bindinput="onInput" disabled="{{submitting || choosingLocation}}"/>
    <form-field outlined label="楼栋门牌" value="{{doorInfo}}" placeholder="例如 2 栋 301（选填）" data-field="doorInfo" bindinput="onInput" cursor-spacing="120" disabled="{{submitting}}"/>
  </view>
  <view class="address-default-row"><view><text class="address-default-title">设为常用地址</text><text class="address-default-note">{{lockDefault ? '需保留一个常用地址' : '多个地址时，仍需手动确认'}}</text></view><nb-switch checked="{{isDefault}}" disabled="{{lockDefault || submitting}}" bindchange="onDefaultChange" label="设为常用地址"/></view>
</view>
<bottom-action-bar class="page-actions" primary-label="{{isEdit ? '保存修改' : '保存地址'}}" loading="{{submitting}}" disabled="{{choosingLocation}}" bindprimary="handleSubmit"/>
