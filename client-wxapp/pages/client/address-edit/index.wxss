.address-edit-page{padding:0 var(--page-padding-h) var(--space-lg);background:var(--nb-surface)}
.address-section{padding:var(--space-lg) 0;border-bottom:1rpx solid var(--nb-line)}
.address-section:first-child{padding-top:0}.address-section-title{display:block;font-size:var(--font-md);font-weight:var(--weight-semibold);line-height:1.5;margin-bottom:var(--space-lg)}
.region-picker{display:block;width:100%}.region-value{display:flex;align-items:center;justify-content:space-between;gap:var(--space-sm);min-height:var(--input-height);font-size:var(--font-sm);line-height:1.5;color:var(--nb-ink)}
.is-placeholder{color:var(--nb-muted)}.address-default-row{display:flex;align-items:center;justify-content:space-between;gap:var(--space-md);padding:var(--space-lg) 0;min-height:44px}
.address-default-title{font-size:var(--font-sm);font-weight:var(--weight-medium)}.address-default-note{display:block;font-size:var(--font-xs);color:var(--nb-secondary);line-height:1.5;margin-top:var(--space-xs)}

.region-value{height:var(--input-height);min-height:44px}
