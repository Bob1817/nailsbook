.container {
  min-height: 100vh;
  background: #f8f9fc;
  padding-bottom: 160rpx;
}

.section {
  background: #f8f9fc;
  margin-bottom: 16rpx;
  padding: 0 32rpx;
}

.form-item {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.form-item:last-child { border-bottom: none; }

.label {
  width: 160rpx;
  font-size: 28rpx;
  color: #1f2937;
  flex-shrink: 0;
}

.input  {
  flex: 1;
  height: 96rpx;
  font-size: 28rpx;
  color: #1f2937;
 background: #f9fafb; border-radius: 14rpx;}

.location-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
}
.location-label {
  font-size: 28rpx;
  color: #1f2937;
}
.location-hint {
  font-size: 26rpx;
  color: #ff6b8a;
}

.default-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 0 32rpx;
}

.footer {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: #f8f9fc;
  padding: 24rpx 40rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.06);
}
.btn-save {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-save[disabled] { opacity: 0.5; }

/* CSS Icon: Location Pin */
.menu-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  vertical-align: middle;
}
.icon-location {
  width: 20rpx;
  height: 26rpx;
  position: relative;
}
.icon-location::before {
  content: '';
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 2.5rpx solid #ff6b8a;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  box-sizing: border-box;
}
.icon-location::after {
  content: '';
  position: absolute;
  width: 0;
  height: 0;
  border-left: 5rpx solid transparent;
  border-right: 5rpx solid transparent;
  border-top: 8rpx solid #ff6b8a;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
}
