.page {
  padding: 24rpx 32rpx 200rpx;
  background: #f8f9fc;
  min-height: 100vh;
}

/* ===== Section Cards ===== */
.section {
  background: rgba(255,255,255,0.88);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
}

.section-head { margin-bottom: 24rpx; }
.section-title { display: block; font-size: 30rpx; font-weight: 600; color: #1f2937; }
.section-sub { display: block; font-size: 24rpx; color: #6b7280; margin-top: 6rpx; }

/* ===== Tech Cards ===== */
.tech-list { display: flex; flex-direction: column; gap: 16rpx; }

.tech-card {
  display: flex; align-items: center; gap: 20rpx;
  padding: 24rpx; border-radius: 24rpx; background: #f8f9fa;
  border: 2rpx solid transparent;
}

.tech-card-active {
  background: linear-gradient(135deg, #fff0f5, #faffff);
  border-color: rgba(255,107,138,0.25);
}

.tech-avatar {
  width: 80rpx; height: 80rpx; border-radius: 18rpx;
  overflow: hidden; background: linear-gradient(135deg, #ffe0ea, #e8d5ff);
  flex-shrink: 0; display: flex; align-items: center; justify-content: center;
}

.tech-avatar-img { width: 100%; height: 100%; }
.tech-avatar-text { font-size: 32rpx; font-weight: 600; color: #ff6b8a; }

.tech-info { flex: 1; min-width: 0; }
.tech-name-row { display: flex; align-items: center; gap: 12rpx; }
.tech-name { font-size: 28rpx; font-weight: 600; color: #1f2937; }
.tech-city { font-size: 24rpx; color: #6b7280; margin-top: 4rpx; display: block; }

.tech-tags { display: flex; gap: 10rpx; margin-top: 10rpx; }
.tag {
  font-size: 22rpx; color: #ff6b8a; background: #fff0f5;
  padding: 4rpx 18rpx; border-radius: 20rpx; font-weight: 500;
}

.badge-default {
  font-size: 20rpx; color: #ff6b8a; background: #fff0f5;
  padding: 2rpx 16rpx; border-radius: 20rpx; font-weight: 500;
}

.radio-circle {
  width: 40rpx; height: 40rpx; border-radius: 50%; border: 3rpx solid #d1d5db;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}

.radio-active { background: #ff6b8a; border-color: #ff6b8a; }
.radio-check { color: #fff; font-size: 24rpx; font-weight: 700; }

/* ===== Segmented Control ===== */
.segment-wrap {
  display: flex; background: #f1f5f9; border-radius: 16rpx; padding: 6rpx;
}

.content-segment { margin-bottom: 24rpx; }

.segment-item {
  flex: 1; text-align: center; padding: 16rpx 0; border-radius: 12rpx;
  font-size: 26rpx; color: #6b7280; font-weight: 500;
}

.segment-active {
  background: #fff; color: #1f2937;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.segment-text { font-size: 26rpx; }

.single-type {
  display: flex; align-items: center; gap: 12rpx;
  padding: 16rpx 0;
}

.single-type-label { font-size: 28rpx; font-weight: 500; color: #1f2937; }
.single-type-badge {
  font-size: 20rpx; color: #6b7280; background: #f1f5f9;
  padding: 4rpx 16rpx; border-radius: 14rpx;
}

/* ===== Address Cards ===== */
.addr-list { display: flex; flex-direction: column; gap: 16rpx; }

.addr-card {
  display: flex; align-items: flex-start; gap: 16rpx;
  padding: 20rpx; border-radius: 20rpx; background: #f8f9fa;
  border: 2rpx solid transparent;
}

.addr-card-active {
  background: linear-gradient(135deg, #fff0f5, #faffff);
  border-color: rgba(255,107,138,0.25);
}

.addr-info { flex: 1; min-width: 0; }
.addr-name-row { display: flex; align-items: center; gap: 12rpx; }
.addr-name { font-size: 28rpx; font-weight: 500; color: #1f2937; }
.addr-phone { font-size: 24rpx; color: #6b7280; }
.addr-detail { font-size: 24rpx; color: #374151; margin-top: 8rpx; display: block; line-height: 1.5; }

/* ===== Service Cards ===== */
.service-list { display: flex; flex-direction: column; gap: 16rpx; }

.service-card {
  display: flex; align-items: flex-start; gap: 16rpx;
  padding: 20rpx; border-radius: 20rpx; background: #f8f9fa;
  border: 2rpx solid transparent;
}

.service-card-active {
  background: linear-gradient(135deg, #fff0f5, #faffff);
  border-color: rgba(255,107,138,0.25);
}

.type-info { flex: 1; min-width: 0; }
.type-label { font-size: 28rpx; font-weight: 500; color: #1f2937; display: block; }
.type-desc { font-size: 24rpx; color: #6b7280; margin-top: 4rpx; display: block; }

/* ===== Calendar ===== */
.calendar { margin-top: 8rpx; }

.calendar-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 0 20rpx;
}

.calendar-title { font-size: 28rpx; font-weight: 600; color: #1f2937; }

.cal-nav-btn {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: #f1f5f9; display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; color: #374151; font-weight: 600;
}

.cal-nav-btn:active { background: #e2e8f0; }

.calendar-weekdays {
  display: grid; grid-template-columns: repeat(7, 1fr);
  margin-bottom: 8rpx;
}

.weekday-cell {
  text-align: center; font-size: 22rpx; color: #6b7280;
  font-weight: 500; padding: 8rpx 0;
}

.calendar-grid {
  display: grid; grid-template-columns: repeat(7, 1fr);
  gap: 6rpx;
}

.day-cell-wrap {
  display: flex; align-items: center; justify-content: center;
  height: 72rpx;
}

.day-cell {
  width: 60rpx; height: 60rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}

.day-empty { background: transparent; }

.day-disabled { opacity: 0.3; }
.day-disabled .day-text { color: #6b7280; }

.day-selected { background: #ff6b8a; }
.day-text-selected { color: #fff !important; font-weight: 600; }

.day-today { border: 2rpx solid #ff6b8a; }

.day-text { font-size: 26rpx; color: #1f2937; }

/* ===== Time Grid ===== */
.time-grid {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 16rpx; margin-top: 24rpx;
}

.time-item {
  position: relative;
  text-align: center; padding: 16rpx 0; border-radius: 16rpx;
  font-size: 26rpx; font-weight: 500; background: #f8f9fa; color: #374151;
}

.time-item-active {
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff; box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
}

.time-item-occupied {
  opacity: 0.4;
}

.time-item-occupied .time-text {
  text-decoration: line-through;
}

.occupied-label {
  position: absolute; bottom: 4rpx; left: 50%; transform: translateX(-50%);
  font-size: 16rpx; color: #ef4444; white-space: nowrap;
}

.warn-text { font-size: 24rpx; color: #dc2626; margin-top: 16rpx; }

/* ===== Custom Form ===== */
.custom-form { margin-top: 16rpx; }

.form-field { margin-bottom: 24rpx; }
.form-label { display: block; font-size: 26rpx; font-weight: 500; color: #1f2937; margin-bottom: 12rpx; }
.form-label-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.link-btn { font-size: 26rpx; color: #ff6b8a; font-weight: 500; }

.form-input {
  background: #f9fafb; padding: 20rpx 28rpx; border-radius: 16rpx;
  font-size: 28rpx; border: 2rpx solid transparent;
}

.form-textarea {
  background: #f9fafb; padding: 20rpx 28rpx; border-radius: 16rpx;
  font-size: 28rpx; width: 100%; height: 160rpx;
  border: 2rpx solid transparent; box-sizing: border-box;
}

.image-grid { display: flex; gap: 16rpx; flex-wrap: wrap; }
.image-item { position: relative; width: 160rpx; height: 160rpx; border-radius: 16rpx; overflow: hidden; }
.preview-img { width: 100%; height: 100%; }
.remove-btn {
  position: absolute; top: 4rpx; right: 4rpx; width: 36rpx; height: 36rpx;
  background: #ff4d4f; color: #fff; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; font-size: 22rpx;
}

.add-image {
  width: 160rpx; height: 160rpx; border-radius: 16rpx;
  border: 2rpx dashed #d1d5db; display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; color: #6b7280; background: #f9fafb;
}

.selected-works { display: flex; gap: 12rpx; flex-wrap: wrap; margin-bottom: 16rpx; }
.selected-work-item { position: relative; width: 120rpx; height: 120rpx; border-radius: 14rpx; overflow: hidden; }
.work-thumb { width: 100%; height: 100%; }

.work-selector {
  background: #f9fafb; border-radius: 16rpx; padding: 16rpx;
  max-height: 400rpx; overflow-y: auto; display: flex; flex-wrap: wrap; gap: 12rpx;
}

.work-option { position: relative; width: 30%; border-radius: 14rpx; overflow: hidden; border: 2rpx solid transparent; }
.work-option-active { border-color: #ff6b8a; }
.work-option-img { width: 100%; height: 160rpx; }
.work-check {
  position: absolute; top: 4rpx; right: 4rpx; width: 32rpx; height: 32rpx;
  background: #ff6b8a; color: #fff; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; font-size: 20rpx;
}

/* ===== Remark ===== */
.remark-input {
  width: 100%; height: 160rpx; background: #f9fafb; border-radius: 16rpx;
  padding: 20rpx 28rpx; font-size: 28rpx; box-sizing: border-box;
  border: 2rpx solid transparent;
}

/* ===== Empty & Misc ===== */
.empty-hint { text-align: center; padding: 32rpx; color: #6b7280; font-size: 26rpx; }

.add-addr-btn {
  margin-top: 16rpx; display: inline-block; background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%); color: #fff;
  font-size: 26rpx; padding: 12rpx 36rpx; border-radius: 24rpx;
}

/* ===== Submit Bar ===== */
.submit-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: rgba(255,255,255,0.92);
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.04);
  z-index: 50;
}

.submit-btn {
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%); color: #fff;
  font-size: 30rpx; font-weight: 600; text-align: center;
  padding: 28rpx; border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
}

.submit-btn:active { opacity: 0.85; }
.btn-disabled { opacity: 0.5; }

/* ===== Shop Confirm Modal ===== */
.modal-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4); z-index: 120;
  display: flex; align-items: flex-end; justify-content: center;
}

.modal-panel {
  width: 100%; background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 20rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));
}

.modal-handle {
  width: 64rpx; height: 8rpx; border-radius: 4rpx;
  background: #d1d5db; margin: 0 auto 24rpx;
}

.modal-title {
  display: block; font-size: 32rpx; font-weight: 600; color: #1f2937;
  text-align: center; margin-bottom: 28rpx;
}

.modal-shop-info { margin-bottom: 20rpx; }
.modal-shop-name { display: block; font-size: 28rpx; font-weight: 600; color: #1f2937; margin-bottom: 6rpx; }
.modal-shop-addr { display: block; font-size: 24rpx; color: #6b7280; line-height: 1.5; }

.modal-date-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 0; border-top: 1rpx solid #f3f4f6; margin-bottom: 28rpx;
}

.modal-date-label { font-size: 26rpx; color: #6b7280; }
.modal-date-value { font-size: 26rpx; font-weight: 500; color: #1f2937; }

.modal-btns { display: flex; gap: 20rpx; }

.modal-btn {
  flex: 1; text-align: center; padding: 24rpx 0; border-radius: 24rpx;
  font-size: 28rpx; font-weight: 600;
}

.modal-btn-cancel { background: #f1f5f9; color: #6b7280; }
.modal-btn-confirm {
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%); color: #fff;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
}

.modal-btn:active { opacity: 0.85; }
