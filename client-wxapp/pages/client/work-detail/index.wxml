<nav-bar title="作品详情" showBack light/>
<view class="container">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
  </view>

  <!-- 错误状态 -->
  <view wx:elif="{{loadFailed}}" class="error-wrap">
    <text class="error-text">{{loadErrorText}}</text>
    <text wx:if="{{canRetryLoad}}" class="error-sub">请检查网络后重新加载</text>
    <button wx:if="{{canRetryLoad}}" class="btn-retry" bindtap="loadWork">重新加载</button>
    <button class="btn-back" bindtap="goBack">返回</button>
  </view>

  <!-- 内容 -->
  <view wx:else class="content">

    <!-- 图片轮播 -->
    <view class="image-section">
      <swiper
        class="image-swiper"
        current="{{currentImageIndex}}"
        circular="{{imageUrls.length > 1}}"
        bindchange="onImageSwiperChange"
      >
        <swiper-item
          wx:for="{{imageUrls}}"
          wx:key="*this"
          bindtap="previewImage"
          data-url="{{item}}"
        >
          <image src="{{item}}" mode="aspectFill" class="work-image" aria-label="{{work.title || '美甲作品'}}第{{index + 1}}张图片" />
        </swiper-item>
      </swiper>

      <!-- 指示器 -->
      <view wx:if="{{imageUrls.length > 1}}" class="indicator">
        <view
          wx:for="{{imageUrls}}"
          wx:key="*this"
          class="dot {{index === currentImageIndex ? 'active' : ''}}"
        ></view>
      </view>
    </view>

    <!-- 信息面板 -->
    <view class="info-panel">
      <!-- 标题和描述 -->
      <view class="title-section">
        <text class="work-title">{{work.title || '未命名作品'}}</text>
        <text wx:if="{{work.description}}" class="work-desc">{{work.description}}</text>
      </view>

      <!-- 标签 -->
      <view wx:if="{{work.tags.length > 0}}" class="tags-section">
        <view
          wx:for="{{work.tags}}"
          wx:key="*this"
          class="tag"
        >
          <text class="tag-text">#{{item}}</text>
        </view>
      </view>

      <!-- 美甲师信息 -->
      <view wx:if="{{techName}}" class="tech-section" bindtap="viewArtist">
        <view class="tech-avatar-wrap">
          <image wx:if="{{techAvatar}}" src="{{techAvatar}}" mode="aspectFill" class="tech-avatar" aria-label="{{techName || '美甲师'}}的头像" />
          <text wx:else class="tech-avatar-text">{{techName[0]}}</text>
        </view>
        <view class="tech-info">
          <text class="tech-name">{{techName}}</text>
          <text class="tech-label">美甲师</text>
        </view>
        <text class="tech-arrow">›</text>
      </view>

      <!-- 操作按钮（登录态：实际交互） -->
      <view class="actions-section">
        <button class="action-btn" bindtap="toggleLike">
          <image wx:if="{{work.isLiked}}" src="data:image/svg+xml;base64," class="action-icon" />
          <image wx:else src="data:image/svg+xml;base64," class="action-icon" />
          <text class="action-text">喜欢</text>
          <text wx:if="{{work.likeCount > 0}}" class="action-count">{{work.likeCount}}</text>
        </button>
        <button class="action-btn" bindtap="toggleFavorite">
          <image wx:if="{{work.isFavorited}}" src="data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iI2Y1OWUwYiIgZD0iTTEyIDIuNmwyLjcgNS44NiA2LjMuNjYtNC43IDQuMjcgMS4zIDYuMjJMMTIgMTYuOTZsLTUuNiAzLjY1IDEuMy02LjIyLTQuNy00LjI3IDYuMy0uNjZ6Ii8+PC9zdmc+" class="action-icon" />
          <image wx:else src="data:image/svg+xml;base64," class="action-icon" />
          <text class="action-text">收藏</text>
        </button>
        <button class="action-btn share" open-type="share">
          <image src="data:image/svg+xml;base64," class="action-icon" />
          <text class="action-text">分享</text>
        </button>
      </view>

      <!-- 评论区 -->
      <view id="work-comments" class="comments-section">
        <view class="comments-header">
          <text class="comments-title">评论</text>
          <text class="comments-count">{{comments.length}} 条</text>
        </view>

        <view wx:if="{{commentsLoading}}" class="comments-empty">
          <text class="empty-text">评论加载中…</text>
        </view>
        <view wx:elif="{{commentsFailed}}" class="comments-empty">
          <text class="empty-text">评论加载失败</text>
          <view class="comment-retry" bindtap="loadComments">重新加载</view>
        </view>
        <view wx:elif="{{comments.length > 0}}" class="comments-list">
          <view
            wx:for="{{comments}}"
            wx:key="id"
            class="comment-item"
            bindtap="onTapComment"
            data-item="{{item}}"
          >
            <view class="comment-avatar-wrap" catchtap="viewCommentArtist" data-role="{{item.userRole}}" role="button" aria-label="{{item.userRole === 'technician' ? '查看美甲师主页' : '用户头像'}}">
              <image wx:if="{{item.userAvatar}}" src="{{item.userAvatar}}" mode="aspectFill" class="comment-avatar" lazy-load aria-label="{{item.userName || '用户'}}的头像" />
              <text wx:else class="comment-avatar-text">{{item.userName[0] || '用'}}</text>
            </view>
            <view class="comment-content">
              <view class="comment-header">
                <text class="comment-name">{{item.userName || '匿名用户'}}</text>
                <text wx:if="{{item.userRole === 'technician'}}" class="comment-badge">美甲师</text>
                <text class="comment-time">{{item.createdAtText}}</text>
              </view>
              <text class="comment-text">{{item.content}}</text>
              <!-- 回复 -->
              <view wx:if="{{item.replies.length > 0}}" class="replies-list">
                <view wx:for="{{item.replies}}" wx:for-item="reply" wx:key="id" class="comment-item reply-item">
                  <view class="reply-avatar-wrap" catchtap="viewCommentArtist" data-role="{{reply.userRole}}">
                    <image wx:if="{{reply.userAvatar}}" src="{{reply.userAvatar}}" mode="aspectFill" class="reply-avatar" lazy-load />
                    <text wx:else class="reply-avatar-text">{{reply.userName[0] || '用'}}</text>
                  </view>
                  <view class="comment-content reply-content">
                    <view class="comment-header">
                      <text class="comment-name">{{reply.userName || '匿名用户'}}</text>
                      <text class="comment-time">{{reply.createdAtText}}</text>
                    </view>
                    <text class="comment-text">{{reply.content}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view wx:else class="comments-empty">
          <text class="empty-text">暂无评论，欢迎添加第一条评论</text>
        </view>
      </view>
    </view>

    <!-- 底部评论输入框（与未登录态一致） -->
    <view class="bottom-bar">
      <view wx:if="{{replyingTo}}" class="reply-indicator">
        <text class="reply-indicator-text">回复 <text class="reply-indicator-name">@{{replyingTo.name}}</text></text>
        <view class="reply-cancel-btn" bindtap="cancelReply">✕</view>
      </view>
      <view wx:if="{{commentText}}" class="input-with-send">
        <input
          class="comment-input"
          placeholder="{{replyingTo ? '回复 @' + replyingTo.name + '...' : '添加评论…'}}"
          value="{{commentText}}"
          focus="{{commentFocused}}"
          bindinput="onCommentInput"
          bindconfirm="submitComment"
          confirm-type="send"
        />
        <view class="send-btn {{submittingComment ? 'is-disabled' : ''}}" bindtap="submitComment">
          <text class="send-text">{{submittingComment ? '发送中' : '发送'}}</text>
        </view>
      </view>
      <block wx:else>
        <input
          class="comment-input"
          placeholder="{{replyingTo ? '回复 @' + replyingTo.name + '...' : '添加评论…'}}"
          value="{{commentText}}"
          focus="{{commentFocused}}"
          bindinput="onCommentInput"
          bindconfirm="submitComment"
          confirm-type="send"
        />
      </block>
      <view class="book-same-btn" bindtap="bookSameStyle">
        <text class="book-same-text">预约同款</text>
      </view>
    </view>
  </view>
</view>
