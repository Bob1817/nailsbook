<!-- Loading -->
<view wx:if="{{loading}}" class="loading-screen">
  <view class="loading-spinner"></view>
</view>

<view wx:elif="{{work.id}}" class="page">
  <!-- 左上角玻璃胶囊，与微信胶囊水平对齐 -->
  <view class="header">
    <view class="header-pill" bindtap="goBack">
      <view class="header-close-circle">
        <view class="header-x-l1"></view>
        <view class="header-x-l2"></view>
      </view>
      <view class="header-text">
        <text class="header-name">{{techName || '美甲师'}}</text>
        <text class="header-sub">作品详情</text>
      </view>
    </view>
  </view>

  <!-- Image Slider: 55vh -->
  <view class="image-area">
    <swiper class="image-swiper" current="{{currentImageIndex}}" bindchange="onImageSwiperChange" circular="{{imageUrls.length > 1}}">
      <swiper-item wx:for="{{imageUrls}}" wx:key="index">
        <image src="{{item}}" mode="aspectFill" class="slide-image" bindtap="openViewer" data-index="{{index}}" />
      </swiper-item>
    </swiper>
    <view wx:if="{{imageUrls.length > 1}}" class="image-dots">
      <view wx:for="{{imageUrls}}" wx:key="index" class="dot {{currentImageIndex === index ? 'dot-active' : ''}}"></view>
    </view>
  </view>

  <!-- 白色信息面板（可上滑展开） -->
  <view class="info-panel" style="transform: translateY({{panelOffset}}rpx); {{isDragging ? '' : 'transition: transform 0.3s cubic-bezier(0.4,0,0.2,1);'}}">
    <!-- 拖拽手柄 -->
    <view class="drag-handle" bindtouchstart="onDragStart" bindtouchmove="onDragMove" bindtouchend="onDragEnd">
      <view class="drag-bar"></view>
    </view>
    <!-- 标题区 -->
    <view class="title-block">
      <text class="work-title">{{work.title || '未命名作品'}}</text>
      <text wx:if="{{work.description}}" class="work-desc">{{work.description}}</text>
      <view wx:if="{{work.tags.length > 0}}" class="tags-row">
        <text wx:for="{{work.tags}}" wx:key="*this" class="tag">#{{item}}</text>
      </view>
    </view>

    <!-- 评论区 -->
    <scroll-view class="comments-section" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="comments-inner">
      <view class="comments-header">
        <text class="comments-title">评论</text>
        <text class="comments-count">{{comments.length}} 条</text>
      </view>

      <view wx:if="{{comments.length > 0}}" class="comments-list">
        <view wx:for="{{comments}}" wx:key="id" class="comment-item" bindtap="onTapComment" data-item="{{item}}">
          <view class="comment-avatar-wrap">
            <image wx:if="{{item.userAvatar}}" src="{{item.userAvatar}}" mode="aspectFill" class="comment-avatar" />
            <view wx:else class="comment-avatar-placeholder {{item.userRole === 'technician' ? 'comment-avatar-tech' : ''}}">
              <text class="avatar-text">{{item.userName[0] || '用'}}</text>
            </view>
          </view>
          <view class="comment-body">
            <view class="comment-bubble">
              <view class="comment-name-row">
                <text class="comment-name">{{item.userName || '匿名用户'}}</text>
                <text wx:if="{{item.userRole === 'technician'}}" class="role-badge">美甲师</text>
                <text class="comment-time">{{item.createdAtText}}</text>
              </view>
              <text class="comment-content">{{item.content}}</text>
            </view>
            <view wx:if="{{item.replies.length > 0}}" class="replies-list">
              <view wx:for="{{item.replies}}" wx:for-item="reply" wx:key="id" class="comment-item">
                <view class="reply-avatar-wrap">
                  <image wx:if="{{reply.userAvatar}}" src="{{reply.userAvatar}}" mode="aspectFill" class="reply-avatar" />
                  <view wx:else class="reply-avatar-placeholder">
                    <text class="avatar-text">{{reply.userName[0] || '用'}}</text>
                  </view>
                </view>
                <view class="comment-body">
                  <view class="comment-bubble">
                    <view class="comment-name-row">
                      <text class="comment-name">{{reply.userName || '匿名用户'}}</text>
                      <text class="comment-time">{{reply.createdAtText}}</text>
                    </view>
                    <text class="comment-content">{{reply.content}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view wx:else class="comments-empty">
        <text class="empty-text">暂无评论，欢迎添加第一条评论</text>
      </view>
      </view>
    </scroll-view>

    <!-- 底部评论输入栏 + 点赞/收藏/咨询图标 -->
    <view class="comment-input-bar">
      <view wx:if="{{replyingTo}}" class="reply-indicator">
        <text class="reply-indicator-text">回复 <text class="reply-indicator-name">@{{replyingTo.name}}</text></text>
        <view class="reply-cancel-btn" bindtap="cancelReply">
          <view class="icon-close-sm"></view>
        </view>
      </view>
      <view class="input-row">
        <input
          class="comment-input"
          placeholder="{{replyingTo ? '回复 @' + replyingTo.name + '...' : '说点什么...'}}"
          value="{{commentText}}"
          bindinput="onCommentInput"
          bindconfirm="submitComment"
          confirm-type="send"
        />
        <!-- 发送（有文字时替换图标） -->
        <view wx:if="{{commentText}}" class="send-btn" bindtap="submitComment">
          <text class="send-text">发送</text>
        </view>
        <block wx:else>
          <!-- 爱心 + 数字 -->
          <view class="bar-btn bar-first" bindtap="toggleLike">
            <image wx:if="{{work.isLiked}}" src="data:image/png;base64," class="bar-icon-img" />
            <image wx:else src="data:image/png;base64," class="bar-icon-img" />
            <text class="bar-num {{work.isLiked ? 'bar-num-liked' : ''}}">{{work.likeCount || 0}}</text>
          </view>
          <!-- 收藏 + 数字 -->
          <view class="bar-btn" bindtap="toggleFavorite">
            <image wx:if="{{work.isFavorited}}" src="data:image/png;base64," class="bar-icon-img" />
            <image wx:else src="data:image/png;base64," class="bar-icon-img" />
            <text class="bar-num {{work.isFavorited ? 'bar-num-star' : ''}}">{{work.favoriteCount || 0}}</text>
          </view>
          <!-- 咨询 -->
          <view class="bar-btn" bindtap="contactTech">
            <image src="data:image/png;base64," class="bar-icon-img" />
          </view>
        </block>
      </view>
    </view>
  </view>

  <!-- Fullscreen Image Viewer -->
  <view wx:if="{{viewerOpen}}" class="viewer-overlay">
    <cover-view class="viewer-close" bindtap="closeViewer">
      <cover-view class="viewer-close-icon">
        <cover-view class="viewer-x-line1"></cover-view>
        <cover-view class="viewer-x-line2"></cover-view>
      </cover-view>
    </cover-view>
    <cover-view wx:if="{{imageUrls.length > 1}}" class="viewer-counter">
      <cover-view class="viewer-counter-text">{{viewerIndex + 1}} / {{imageUrls.length}}</cover-view>
    </cover-view>
    <swiper class="viewer-swiper" current="{{viewerIndex}}" bindchange="onViewerSwiperChange" circular="{{false}}">
      <swiper-item wx:for="{{imageUrls}}" wx:key="index">
        <image src="{{item}}" mode="aspectFit" class="viewer-image" bindtap="closeViewer" />
      </swiper-item>
    </swiper>
    <cover-view wx:if="{{imageUrls.length > 1}}" class="viewer-dots">
      <cover-view wx:for="{{imageUrls}}" wx:key="index" class="viewer-dot {{viewerIndex === index ? 'viewer-dot-active' : ''}}"></cover-view>
    </cover-view>
  </view>
</view>
