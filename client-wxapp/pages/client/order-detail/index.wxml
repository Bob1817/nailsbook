<nav-bar title="预约详情" showBack/>
<view wx:if="{{loading}}" class="loading-page">
  <view class="spinner"></view>
  <text class="loading-text">加载中...</text>
</view>

<view wx:elif="{{!order}}" class="loading-page">
  <text class="loading-text">预约不存在</text>
</view>

<view wx:else class="page">
  <!-- ============ 状态头 ============ -->
  <view class="status-hero {{order._statusTone}}">
    <view class="hero-row">
      <text class="hero-status">{{order._statusLabel}}</text>
      <text class="hero-type">{{order._typeLabel}}</text>
    </view>
    <text class="hero-order-no">预约号 {{order.orderNo}}</text>
    <text wx:if="{{order._statusDesc}}" class="hero-desc">{{order._statusDesc}}</text>
  </view>

  <!-- ============ 美甲师卡片 ============ -->
  <view class="card tech-card card-overlap">
    <view class="tech-row">
      <view class="tech-avatar">
        <image wx:if="{{order.techAvatar}}" src="{{order.techAvatar}}" mode="aspectFill" class="tech-avatar-img" />
        <text wx:else class="tech-avatar-char">{{order.techName[0]}}</text>
      </view>
      <view class="tech-info">
        <text class="tech-name">{{order.techName}}</text>
        <text class="tech-label">服务美甲师</text>
      </view>
      <view class="tech-actions">
        <view wx:if="{{order.techPhone}}" class="round-btn" catchtap="callTech">
          <view class="btn-icon-phone"></view>
        </view>
        <view class="round-btn round-chat" catchtap="goChat">
          <view class="btn-icon-chat"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- ============ 服务信息 ============ -->
  <view class="card">
    <text class="card-title">服务信息</text>

    <view class="info-row">
      <text class="info-label">服务方式</text>
      <text class="info-value">{{order._typeLabel}}</text>
    </view>

    <view class="info-row">
      <text class="info-label">预约时间</text>
      <text class="info-value">{{order._dateLabel}} {{order._timeRange}}</text>
    </view>

    <view wx:if="{{order.address}}" class="info-row">
      <text class="info-label">{{order._isShop ? '到店地址' : '上门地址'}}</text>
      <view class="info-value-block">
        <text class="addr-text">{{order.address}}</text>
        <view class="copy-link" catchtap="copyAddress">复制</view>
      </view>
    </view>

    <view class="info-row">
      <text class="info-label">服务项目</text>
      <text class="info-value">{{order.serviceName}}</text>
    </view>

    <view wx:if="{{order.durationMinutes > 0}}" class="info-row">
      <text class="info-label">预计时长</text>
      <text class="info-value">{{order.durationMinutes}}分钟</text>
    </view>
  </view>

  <!-- ============ 价格信息 ============ -->
  <view wx:if="{{order._showPriceCard}}" class="card">
    <text class="card-title">{{order.status === 'pending_agree' ? '美甲师报价' : '费用信息'}}</text>

    <view class="price-row">
      <text class="price-label">报价金额</text>
      <text class="price-main">{{order._priceText}}</text>
    </view>

    <view wx:if="{{order.depositAmount > 0}}" class="deposit-box">
      <view class="deposit-top">
        <text class="deposit-cap">定金（线下支付）</text>
        <text class="deposit-state {{order.depositPaid ? 'deposit-paid' : 'deposit-unpaid'}}">
          {{order.depositPaid ? '已支付' : '待支付'}}
        </text>
      </view>
      <text class="deposit-amount">¥{{order.depositAmount}}</text>
      <text class="deposit-hint">
        {{order.depositPaid ? '美甲师已确认收到定金' : '请线下支付定金后，点击下方按钮确认'}}
      </text>
    </view>
  </view>

  <!-- ============ 备注 ============ -->
  <view wx:if="{{order.remark}}" class="card">
    <text class="card-title">备注</text>
    <text class="remark-text">{{order.remark}}</text>
  </view>

  <!-- ============ 底部操作栏 ============ -->
  <view wx:if="{{order._actions.length > 0}}" class="bottom-actions">
    <view
      wx:for="{{order._actions}}"
      wx:key="key"
      class="action-btn {{item.style}}"
      bindtap="onAction"
      data-key="{{item.key}}"
    >
      {{item.label}}
    </view>
  </view>
</view>

<!-- ============ 拒绝报价底部弹层 ============ -->
<view wx:if="{{showReject}}" class="sheet-mask" bindtap="closeReject"></view>
<view class="sheet {{showReject ? 'sheet-show' : ''}}" catchtap="">
  <view class="sheet-header">
    <text class="sheet-title">拒绝报价</text>
    <view class="sheet-close" bindtap="closeReject">&#x2715;</view>
  </view>

  <view class="sheet-body">
    <view class="form-item">
      <text class="form-label">拒绝原因（选填）</text>
      <textarea
        class="form-textarea"
        placeholder="告诉美甲师你为什么拒绝该报价，便于重新协商"
        value="{{rejectReason}}"
        bindinput="onRejectReasonInput"
        maxlength="200"
      />
    </view>

    <view class="reason-chips">
      <view
        wx:for="{{rejectReasons}}"
        wx:key="*this"
        class="reason-chip"
        bindtap="onPickReason"
        data-reason="{{item}}"
      >{{item}}</view>
    </view>
  </view>

  <view class="sheet-footer">
    <view class="action-btn action-danger {{submitting ? 'is-disabled' : ''}}" bindtap="submitReject">
      {{submitting ? '提交中...' : '确认拒绝'}}
    </view>
  </view>
</view>

<!-- ============ 编辑预约底部弹层 ============ -->
<view wx:if="{{showEdit}}" class="sheet-mask" bindtap="closeEdit"></view>
<view class="sheet {{showEdit ? 'sheet-show' : ''}}" catchtap="">
  <view class="sheet-header">
    <text class="sheet-title">修改预约</text>
    <view class="sheet-close" bindtap="closeEdit">&#x2715;</view>
  </view>
  <view class="sheet-body">
    <view class="form-item">
      <text class="form-label">预约日期</text>
      <picker mode="date" value="{{editDate}}" bindchange="onEditDateChange">
        <view class="picker-row"><text class="picker-value">{{editDate || '请选择'}}</text></view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">预约时间</text>
      <picker mode="selector" range="{{editTimeSlots}}" bindchange="onEditTimeChange">
        <view class="picker-row"><text class="picker-value">{{editTime || '请选择'}}</text></view>
      </picker>
    </view>
    <view class="form-item" wx:if="{{editAddresses.length > 0}}">
      <text class="form-label">上门地址</text>
      <view class="addr-select-list">
        <view wx:for="{{editAddresses}}" wx:key="id"
          class="addr-select-item {{editAddressId === item.id ? 'addr-select-active' : ''}}"
          bindtap="onEditAddressSelect" data-id="{{item.id}}">
          <text class="addr-select-name">{{item.contactName}} {{item.contactPhone}}</text>
          <text class="addr-select-detail">{{item.province}}{{item.city}}{{item.district}}{{item.detailAddress}}</text>
        </view>
      </view>
    </view>
  </view>
  <view class="sheet-footer">
    <view class="action-btn action-primary {{savingEdit ? 'is-disabled' : ''}}" bindtap="saveEdit">
      {{savingEdit ? '保存中...' : '保存修改'}}
    </view>
  </view>
</view>
