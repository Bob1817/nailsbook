page { background: var(--bg-page); }

.page {
  min-height: 100vh;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* ===== 加载/空状态 ===== */
.loading-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}
.spinner {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid var(--nb-line);
  border-top-color: var(--brand-primary);
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: var(--font-sm); color: var(--text-muted); }
.load-error { min-height:100vh; box-sizing:border-box; padding:120rpx 48rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; background:var(--nb-page); text-align:center; }
.load-error-mark { width:88rpx; height:88rpx; margin-bottom:28rpx; border-radius:50%; background:var(--nb-page); color:var(--nb-ink); font-size: var(--font-xl); line-height:88rpx; }
.load-error-title { color:var(--nb-ink); font-size: var(--font-lg); font-weight: var(--weight-semibold); }.load-error-desc { margin-top:12rpx; color:var(--nb-secondary); font-size: var(--font-sm); }
.retry-btn { min-height:88rpx; margin:44rpx 0 0; padding:0 56rpx; border:0; border-radius: var(--radius-xl); background:var(--nb-ink); color: var(--text-inverse); font-size: var(--font-md); line-height:88rpx; }.retry-btn::after { border:0; }

/* ===== 状态头 ===== */
.status-hero {
  padding: 60rpx 40rpx 48rpx;
  background: var(--nb-page);
  color: var(--text-primary);
}
.status-hero.tone-gray,
.status-hero.tone-red,
.status-hero.tone-emerald,
.status-hero.tone-sky,
.status-hero.tone-purple {
  background: var(--nb-page);
}

.hero-row {
  display: flex; align-items: center; justify-content: space-between;
  gap: 16rpx;
}
.hero-status {
  font-size: var(--font-xl); font-weight: var(--weight-bold); color: var(--text-primary);
  letter-spacing: -1rpx;
}
.hero-type {
  padding: 8rpx 40rpx;
  border-radius: 999rpx;
  border: 0;
  background: rgba(0, 0, 0, 0.04);
  font-size: var(--font-xs);
  color: var(--text-body);
}
.hero-order-no {
  display: block;
  margin-top: 14rpx;
  font-size: var(--font-xs);
  color: var(--text-muted);
}
.hero-desc {
  display: block;
  margin-top: 18rpx;
  font-size: var(--font-sm);
  line-height: var(--leading-normal);
  color: var(--text-body);
}

/* ===== 卡片 ===== */
.card {
  margin: 20rpx 40rpx 0;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 28rpx;
  box-shadow: var(--shadow-md), 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
}
.card-overlap { margin-top: -28rpx; }
.source-work-card { min-height: 112rpx; display: flex; align-items: center; gap: 20rpx; }
.source-work-cover { width: 88rpx; height: 88rpx; flex-shrink: 0; border-radius: var(--radius-sm); background: var(--nb-page); }
.source-work-copy { flex: 1; min-width: 0; }
.source-work-label, .source-work-title, .source-work-price { display: block; }
.source-work-label { color: var(--nb-muted); font-size: var(--font-xs); }
.source-work-title { margin-top: 6rpx; overflow: hidden; color: var(--nb-ink); font-size: var(--font-sm); font-weight: var(--weight-semibold); text-overflow: ellipsis; white-space: nowrap; }
.source-work-price { margin-top: 6rpx; color: var(--nb-money); font-size: var(--font-sm); font-weight: var(--weight-bold); }
.source-work-arrow { color: var(--nb-muted); font-size: var(--font-xl); }

.card-title {
  display: block;
  font-size: var(--font-md); font-weight: var(--weight-semibold); color: var(--text-primary);
  margin-bottom: 20rpx;
}
.review-hint { display: block; color: var(--nb-secondary); font-size: var(--font-xs); line-height: 1.6; }
.rating-row { display: flex; gap: 14rpx; margin-top: var(--space-md); }
.rating-btn { width: 88rpx; height: 88rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--nb-secondary); background: var(--nb-page); font-size: var(--font-sm); font-weight: var(--weight-bold); }
.rating-active { color: var(--text-inverse); background: var(--nb-action); }
.rating-caption { display: block; margin-top: 12rpx; color: var(--nb-ink); font-size: var(--font-xs); font-weight: var(--weight-semibold); }
.review-input { width: 100%; height: 190rpx; margin-top: 22rpx; padding: 22rpx; border-radius: var(--card-radius); background: var(--nb-page); font-size: var(--font-sm); line-height: 1.6; box-sizing: border-box; }
.review-photos { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 22rpx; }
.review-photo-wrap, .review-photo-add { width: 150rpx; height: 150rpx; border-radius: var(--radius-sm); }
.review-photo-wrap { position: relative; }
.review-photo { width: 100%; height: 100%; border-radius: var(--radius-sm); }
.review-photo-remove { position: absolute; top: -22rpx; right: -22rpx; width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; }
.review-photo-remove::after { content: '×'; width: 44rpx; height: 44rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--text-inverse); background: rgba(0, 0, 0, .76); font-size: var(--font-sm); }
.review-photo-add { display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--nb-muted); background: var(--nb-page); border: 1rpx dashed var(--nb-line); font-size: var(--font-xs); }
.review-photo-plus { font-size: var(--font-xl); line-height: 1; margin-bottom: 8rpx; }
.photo-consent { min-height: 112rpx; margin-top: var(--space-md); padding: 20rpx; border-radius: var(--card-radius); display: flex; align-items: center; gap: 20rpx; background: var(--nb-page); }
.consent-copy { flex: 1; min-width: 0; }
.consent-title, .consent-desc { display: block; }
.consent-title { color: var(--nb-ink); font-size: var(--font-sm); font-weight: var(--weight-bold); }
.consent-desc { margin-top: 7rpx; color: var(--nb-muted); font-size: var(--font-xs); line-height: var(--leading-normal); }
.review-save { min-height: 88rpx; margin-top: var(--space-md); border-radius: var(--radius-xl); display: flex; align-items: center; justify-content: center; color: var(--text-inverse); background: var(--nb-action); font-size: var(--font-sm); font-weight: var(--weight-bold); }

/* ===== 美甲师卡 ===== */
.tech-card { padding: var(--space-md) 40rpx; }
.tech-row { display: flex; align-items: center; gap: 20rpx; }
.tech-avatar {
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  background: var(--nb-page);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.tech-avatar-img { width: 100%; height: 100%; }
.tech-avatar-char { font-size: var(--font-lg); font-weight: var(--weight-bold); color: var(--brand-primary); }

.tech-info { flex: 1; min-width: 0; }
.tech-name { display: block; font-size: var(--font-lg); font-weight: var(--weight-semibold); color: var(--text-primary); }
.tech-label { display: block; margin-top: 4rpx; font-size: var(--font-sm); color: var(--text-muted); }

.tech-actions { display: flex; gap: 12rpx; }
.round-btn {
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  background: var(--nb-page);
  color: var(--nb-text-link);
  display: flex; align-items: center; justify-content: center;
  font-size: var(--font-lg);
}
.round-btn:active { background: var(--nb-page); }

.contact-action-icon { width: 38rpx; height: 38rpx; }

/* ===== 信息行 ===== */
.info-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 0;
  gap: 24rpx;
}
.info-row:last-child { border-bottom: none; }
.address-row { align-items: flex-start; }

.info-label {
  flex-shrink: 0;
  width: 140rpx;
  font-size: var(--font-sm);
  color: var(--text-muted);
}
.info-value {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--text-primary);
  line-height: var(--leading-normal);
  word-break: break-all;
}
.info-value-block {
  flex: 1;
  min-width: 0;
  position: relative;
  display: flex;
  flex-direction: column;
}
.price-invalid { color:var(--nb-muted); text-decoration:line-through; }
.address-main-row {
  display: flex;
  align-items: flex-start;
  padding-right: 88rpx;
  gap: 12rpx;
}
.addr-text {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--text-primary);
  line-height: var(--leading-normal);
}
.copy-link {
  width: 88rpx;
  height: 88rpx;
  position: absolute;
  top: -28rpx;
  right: 0;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.copy-link-label {
  min-width: 68rpx;
  height: 48rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: var(--nb-page);
  color: var(--nb-text-link);
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
}
.copy-link:active .copy-link-label { background: var(--nb-page); }

/* ===== 到店指引入口 ===== */
.guidance-row {
  position: relative;
  height: 48rpx;
  margin-top: 4rpx;
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
  gap: 8rpx;
  box-sizing: border-box;
}
.guidance-row::before { content: ''; position: absolute; top: -20rpx; right: 0; bottom: -20rpx; left: 0; }
.guidance-row:active { opacity: 0.7; }
.guidance-row-text {
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
  color: var(--nb-text-link);
}
.guidance-row-arrow {
  font-size: var(--font-sm);
  color: var(--nb-text-link);
}

/* ===== 线下付款提示 ===== */
.offline-payment-note {
  display: block;
  margin-top: 12rpx;
  font-size: var(--font-xs);
  color: var(--text-muted);
  line-height: var(--leading-normal);
}

/* ===== 价格 ===== */
.price-row {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 0;
}
.price-label { font-size: var(--font-sm); color: var(--text-muted); }
.price-main {
  font-size: var(--font-xl);
  font-weight: var(--weight-semibold);
  line-height: 1;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}
.actual-payment-row .price-label { color: var(--text-primary); font-weight: var(--weight-semibold); }
.actual-payment-value {
  color: var(--nb-money);
  font-size: var(--font-xl);
  font-weight: var(--weight-bold);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

/* 定金标注 */
.price-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.deposit-note {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-xs);
  color: var(--text-muted);
  line-height: var(--leading-normal);
}

/* 定金盒 */
.deposit-box {
  margin-top: 8rpx;
  padding: 20rpx 40rpx;
  background: var(--nb-page);
  border-radius: var(--radius-sm);
}
.deposit-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.deposit-cap { font-size: var(--font-sm); color: var(--nb-ink); }
.deposit-state {
  padding: 4rpx 40rpx;
  border-radius: 999rpx;
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
}
.deposit-paid { background: var(--nb-page); color: var(--nb-ink); }
.deposit-unpaid { background: var(--nb-page); color: var(--nb-ink); }
.deposit-amount {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--nb-money);
  font-variant-numeric: tabular-nums;
}
.deposit-hint {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-xs);
  color: var(--nb-ink);
  line-height: var(--leading-normal);
}

/* ===== 备注 ===== */
.remark-text {
  display: block;
  padding: 20rpx;
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  line-height: 1.6;
  color: var(--text-body);
}

/* ===== 底部操作栏 ===== */
.bottom-actions {
  position: fixed;
  left: 0; right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.92);
  padding: 16rpx 40rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  display: flex;
  gap: 16rpx;
  z-index: 100;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
}
.action-btn:active { opacity: 0.85; }

.action-primary {
  background: var(--nb-action);
  color: var(--text-inverse);
  box-shadow: none;
}
.action-ghost {
  background: var(--nb-page);
  color: var(--brand-primary);
}
.action-danger {
  background: var(--nb-danger-surface);
  color: var(--nb-danger);
  border: 0;
}
.is-disabled { opacity: 0.5; }

/* ===== 底部弹层 ===== */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 200;
}
.sheet {
  position: fixed;
  left: 0; right: 0;
  bottom: 0;
  z-index: 201;
  background: var(--bg-card);
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.25s ease-out;
}
.sheet-show { transform: translateY(0); }

.sheet-header {
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 0;
}
.sheet-title { font-size: var(--font-lg); font-weight: var(--weight-semibold); color: var(--text-primary); }
.sheet-close {
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  background: var(--nb-page);
  color: var(--text-muted);
  display: flex; align-items: center; justify-content: center;
  font-size: var(--font-md);
}

.sheet-body {
  padding: var(--space-md) 40rpx;
  flex: 1;
}

.sheet-footer {
  padding: 16rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 0;
}
.sheet-footer .action-btn { width: 100%; }

/* ===== 更多操作列表弹层 ===== */
.action-sheet-body {
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
}
.action-sheet-item {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
}
.action-sheet-item + .action-sheet-item { margin-top: 12rpx; }
.action-sheet-item:active { opacity: 0.85; }
.action-sheet-item.action-primary {
  background: var(--brand-gradient);
  color: var(--text-inverse);
}
.action-sheet-item.action-ghost {
  background: var(--nb-page);
  color: var(--brand-primary);
}
.action-sheet-item.action-danger {
  background: var(--nb-danger-surface);
  color: var(--nb-danger);
  border: 0;
}

/* ===== 表单 ===== */
.form-item { margin-bottom: 28rpx; }
.form-label {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-body);
  margin-bottom: 12rpx;
  font-weight: var(--weight-medium);
}
.form-textarea  {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 40rpx;
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  font-size: var(--font-md);
  line-height: var(--leading-normal);
  color: var(--text-primary);
  box-sizing: border-box;
}

.reason-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.reason-chip {
  padding: 10rpx 40rpx;
  border-radius: 999rpx;
  background: var(--nb-page);
  color: var(--brand-primary);
  font-size: var(--font-sm);
}
.reason-chip:active { background: var(--nb-page); }

/* 编辑弹层样式 */
.picker-row { padding: 16rpx 0; }
.picker-value { font-size: var(--font-md); color: var(--text-primary); }
.addr-select-list { display: flex; flex-direction: column; gap: 12rpx; }
.addr-select-item { padding: 16rpx 40rpx; border-radius: var(--radius-sm); background: var(--nb-page); border: 0; }
.addr-select-active { background: var(--nb-page); border-color: rgba(0, 0, 0, 0.25) /* brand-primary-alpha */; }
.addr-select-name { font-size: var(--font-sm); font-weight: var(--weight-medium); color: var(--text-primary); display: block; }
.addr-select-detail { font-size: var(--font-xs); color: var(--text-muted); display: block; margin-top: 4rpx; }

.fund-discount-box { margin-top: var(--space-md); padding: var(--space-md); border-radius: var(--radius-md); background:var(--nb-page); }
.fund-discount-head,.fund-input-row { min-height:88rpx; display:flex; align-items:center; justify-content:space-between; gap:20rpx; }
.fund-max { color:var(--nb-ink); }
.fund-input-row input { min-height:88rpx; flex:1; text-align:right; }
.fund-payable { display:block; text-align:right; color:var(--nb-secondary); font-size: var(--font-sm); }
.price-discount { color:var(--nb-money); }

.actual-payment-value, .deposit-amount, .price-discount, .payment-remaining, .price-subtotal { color:var(--nb-money); font-variant-numeric:tabular-nums; }

@import '../../../styles/booking-form.wxss';
@import '../../../styles/booking-actions.wxss';
.review-input { font-size: var(--font-sm); border-radius: var(--input-radius); }
.payment-summary { margin-top: var(--space-md); padding-top:20rpx; border-top: 0; }
.status-hero.tone-emerald .hero-status { color:var(--nb-success); }
.status-hero.tone-sky .hero-status { color:var(--nb-text-link); }
.status-hero.tone-red .hero-status { color:var(--nb-danger); }
.payment-remaining { font-weight: var(--weight-bold); color:var(--nb-money); }
.payment-count { display:block; margin-top:12rpx; color: var(--text-muted); font-size: var(--font-xs); }
.price-lines { margin-bottom:20rpx; padding-bottom:16rpx; border-bottom: 0; }
.price-line { min-height:52rpx; display:flex; align-items:center; justify-content:space-between; gap:20rpx; color:var(--nb-secondary); font-size:25rpx; }
.price-subtotal { margin-top:8rpx; color:var(--nb-money); font-weight:600; }
.price-discount { color:var(--nb-money); }
.retry-btn.booking-action { min-height:44px; height:44px; margin-top:44rpx; padding:0 24rpx; border-radius:8px; font-size:var(--font-sm); line-height:1.4; }
