page { background: #f8f9fc; }

.page {
  min-height: 100vh;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* ===== 加载/空状态 ===== */
.loading-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}
.spinner {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid #ffd8e3;
  border-top-color: #ff6b8a;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 26rpx; color: #6b7280; }
.load-error { min-height:100vh; box-sizing:border-box; padding:120rpx 48rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; background:#f7f5f6; text-align:center; }
.load-error-mark { width:88rpx; height:88rpx; margin-bottom:28rpx; border-radius:50%; background:#fff0f4; color:#c75b83; font-size:44rpx; line-height:88rpx; }
.load-error-title { color:#382a31; font-size:32rpx; font-weight:600; }.load-error-desc { margin-top:12rpx; color:#796872; font-size:25rpx; }
.retry-btn { min-height:88rpx; margin:44rpx 0 0; padding:0 56rpx; border:0; border-radius:44rpx; background:#1f2937; color:#fff; font-size:28rpx; line-height:88rpx; }.retry-btn::after { border:0; }

/* ===== 状态头 ===== */
.status-hero {
  padding: 60rpx 40rpx 48rpx;
  background: linear-gradient(180deg, #FFF5F7 0%, #f8f9fc 100%);
  color: #1f2937;
}
.status-hero.tone-gray,
.status-hero.tone-red,
.status-hero.tone-emerald,
.status-hero.tone-sky,
.status-hero.tone-purple {
  background: linear-gradient(180deg, #FFF5F7 0%, #f8f9fc 100%);
}

.hero-row {
  display: flex; align-items: center; justify-content: space-between;
  gap: 16rpx;
}
.hero-status {
  font-size: 44rpx; font-weight: 700; color: #1f2937;
  letter-spacing: -1rpx;
}
.hero-type {
  padding: 8rpx 40rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.1);
  background: rgba(0, 0, 0, 0.04);
  font-size: 22rpx;
  color: #4b5563;
}
.hero-order-no {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #6b7280;
}
.hero-desc {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #4b5563;
}

/* ===== 卡片 ===== */
.card {
  margin: 20rpx 40rpx 0;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
}
.card-overlap { margin-top: -28rpx; }
.source-work-card { min-height: 112rpx; display: flex; align-items: center; gap: 20rpx; }
.source-work-cover { width: 88rpx; height: 88rpx; flex-shrink: 0; border-radius: 16rpx; background: #f5f0f3; }
.source-work-copy { flex: 1; min-width: 0; }
.source-work-label, .source-work-title { display: block; }
.source-work-label { color: #9a8790; font-size: 21rpx; }
.source-work-title { margin-top: 6rpx; overflow: hidden; color: #33282d; font-size: 26rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.source-work-arrow { color: #ad9ca4; font-size: 40rpx; }

.card-title {
  display: block;
  font-size: 28rpx; font-weight: 600; color: #1f2937;
  margin-bottom: 20rpx;
}
.review-hint { display: block; color: #84727b; font-size: 22rpx; line-height: 1.6; }
.rating-row { display: flex; gap: 14rpx; margin-top: 24rpx; }
.rating-btn { width: 88rpx; height: 88rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #75636c; background: #f5f1f3; font-size: 25rpx; font-weight: 700; }
.rating-active { color: #fff; background: #ec4899; }
.rating-caption { display: block; margin-top: 12rpx; color: #a04b72; font-size: 22rpx; font-weight: 600; }
.review-input { width: 100%; height: 190rpx; margin-top: 22rpx; padding: 22rpx; border-radius: 18rpx; background: #f8f6f7; font-size: 24rpx; line-height: 1.6; box-sizing: border-box; }
.review-photos { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 22rpx; }
.review-photo-wrap, .review-photo-add { width: 150rpx; height: 150rpx; border-radius: 16rpx; }
.review-photo-wrap { position: relative; }
.review-photo { width: 100%; height: 100%; border-radius: 16rpx; }
.review-photo-remove { position: absolute; top: -22rpx; right: -22rpx; width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; }
.review-photo-remove::after { content: '×'; width: 44rpx; height: 44rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; background: rgba(38, 27, 33, .76); font-size: 25rpx; }
.review-photo-add { display: flex; flex-direction: column; align-items: center; justify-content: center; color: #9a8790; background: #faf5f7; border: 1rpx dashed #d8c7cf; font-size: 20rpx; }
.review-photo-plus { font-size: 40rpx; line-height: 1; margin-bottom: 8rpx; }
.photo-consent { min-height: 112rpx; margin-top: 24rpx; padding: 20rpx; border-radius: 18rpx; display: flex; align-items: center; gap: 20rpx; background: #fff5f8; }
.consent-copy { flex: 1; min-width: 0; }
.consent-title, .consent-desc { display: block; }
.consent-title { color: #4b3741; font-size: 24rpx; font-weight: 700; }
.consent-desc { margin-top: 7rpx; color: #8d7a84; font-size: 20rpx; line-height: 1.5; }
.review-save { min-height: 88rpx; margin-top: 24rpx; border-radius: 44rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: #ec4899; font-size: 26rpx; font-weight: 700; }

/* ===== 美甲师卡 ===== */
.tech-card { padding: 24rpx 40rpx; }
.tech-row { display: flex; align-items: center; gap: 20rpx; }
.tech-avatar {
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  background: #f8dce7;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.tech-avatar-img { width: 100%; height: 100%; }
.tech-avatar-char { font-size: 36rpx; font-weight: 700; color: #ff6b8a; }

.tech-info { flex: 1; min-width: 0; }
.tech-name { display: block; font-size: 32rpx; font-weight: 600; color: #1f2937; }
.tech-label { display: block; margin-top: 4rpx; font-size: 24rpx; color: #6b7280; }

.tech-actions { display: flex; gap: 12rpx; }
.round-btn {
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  background: #FFF1F6;
  color: #ff6b8a;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx;
}
.round-btn:active { background: #ffe0eb; }

/* CSS icons for phone and chat */
.btn-icon-phone {
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid #ff6b8a;
  border-radius: 50%;
  position: relative;
}

.btn-icon-phone::after {
  content: '';
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 8rpx;
  height: 8rpx;
  background: #ff6b8a;
  border-radius: 50%;
}

.btn-icon-chat {
  width: 22rpx;
  height: 18rpx;
  border: 3rpx solid #ff6b8a;
  border-radius: 4rpx;
  position: relative;
}

.btn-icon-chat::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 4rpx;
  width: 0;
  height: 0;
  border-left: 6rpx solid #ff6b8a;
  border-right: 6rpx solid transparent;
  border-top: 6rpx solid #ff6b8a;
  border-bottom: 6rpx solid transparent;
}

/* ===== 信息行 ===== */
.info-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f0f3;
  gap: 24rpx;
}
.info-row:last-child { border-bottom: none; }

.info-label {
  flex-shrink: 0;
  width: 140rpx;
  font-size: 26rpx;
  color: #6b7280;
}
.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #1f2937;
  line-height: 1.5;
  word-break: break-all;
}
.info-value-block {
  flex: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}
.addr-text {
  flex: 1;
  font-size: 26rpx;
  color: #1f2937;
  line-height: 1.5;
}
.copy-link { min-height: 88rpx;
  flex-shrink: 0;
  padding: 4rpx 40rpx;
  border-radius: 14rpx;
  background: #FFF1F6;
  color: #ff6b8a;
  font-size: 22rpx;
  font-weight: 600;
}
.copy-link:active { background: #ffe0eb; }

/* ===== 价格 ===== */
.price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 16rpx;
}
.price-label { font-size: 26rpx; color: #6b7280; }
.price-main {
  font-size: 48rpx; font-weight: 700; color: #ff6b8a;
  letter-spacing: -1rpx;
}

/* 定金盒 */
.deposit-box {
  margin-top: 8rpx;
  padding: 20rpx 40rpx;
  background: #FFF8EE;
  border-radius: 14rpx;
}
.deposit-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.deposit-cap { font-size: 24rpx; color: #c97f1a; }
.deposit-state {
  padding: 4rpx 40rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
}
.deposit-paid { background: #e3f6ec; color: #067b4a; }
.deposit-unpaid { background: #fff2dc; color: #c97f1a; }
.deposit-amount {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #c97f1a;
}
.deposit-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #b08a4a;
  line-height: 1.5;
}

/* ===== 备注 ===== */
.remark-text {
  display: block;
  padding: 20rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #374151;
}

/* ===== 底部操作栏 ===== */
.bottom-actions {
  position: fixed;
  left: 0; right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.92);
  padding: 16rpx 40rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 24rpx rgba(15, 23, 42, 0.06);
  display: flex;
  gap: 16rpx;
  z-index: 100;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.action-btn:active { opacity: 0.85; }

.action-primary {
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
}
.action-ghost {
  background: #FFF1F6;
  color: #ff6b8a;
}
.action-danger {
  background: #fef2f2;
  color: #dc2626;
  border: 1rpx solid #fecaca;
}
.is-disabled { opacity: 0.5; }

/* ===== 底部弹层 ===== */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 200;
}
.sheet {
  position: fixed;
  left: 0; right: 0;
  bottom: 0;
  z-index: 201;
  background: #ffffff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.25s ease-out;
}
.sheet-show { transform: translateY(0); }

.sheet-header {
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f5f0f3;
}
.sheet-title { font-size: 32rpx; font-weight: 600; color: #1f2937; }
.sheet-close {
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  background: #f5f1f3;
  color: #6b7280;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx;
}

.sheet-body {
  padding: 24rpx 40rpx;
  flex: 1;
}

.sheet-footer {
  padding: 16rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f5f0f3;
}
.sheet-footer .action-btn { width: 100%; }

/* ===== 表单 ===== */
.form-item { margin-bottom: 28rpx; }
.form-label {
  display: block;
  font-size: 26rpx;
  color: #374151;
  margin-bottom: 12rpx;
  font-weight: 500;
}
.form-textarea  {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 40rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #1f2937;
  box-sizing: border-box;
}

.reason-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.reason-chip {
  padding: 10rpx 40rpx;
  border-radius: 999rpx;
  background: #FFF1F6;
  color: #ff6b8a;
  font-size: 24rpx;
}
.reason-chip:active { background: #ffe0eb; }

/* 编辑弹层样式 */
.picker-row { padding: 16rpx 0; }
.picker-value { font-size: 28rpx; color: #1f2937; }
.addr-select-list { display: flex; flex-direction: column; gap: 12rpx; }
.addr-select-item { padding: 16rpx 40rpx; border-radius: 14rpx; background: #f8f9fa; border: 2rpx solid transparent; }
.addr-select-active { background: #fff0f3; border-color: rgba(255,107,138,0.25); }
.addr-select-name { font-size: 26rpx; font-weight: 500; color: #1f2937; display: block; }
.addr-select-detail { font-size: 22rpx; color: #6b7280; display: block; margin-top: 4rpx; }
