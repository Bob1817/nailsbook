<nav-bar title="我的收藏" showBack/>
<view class="page">
  <collection-overview title="收藏灵感" subtitle="集中查看你想再次参考的作品" count="{{works.length}}" show-count="{{!loading && !loadFailed}}" />

  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
  </view>

  <state-card wx:elif="{{loadFailed}}" class="booking-action" type="error" title="收藏加载失败" description="请检查网络后重新加载" actionText="重新加载" bind:action="loadFavorites" />

  <state-card wx:elif="{{works.length === 0}}" class="booking-action" icon="/static/icons/bookmark.svg" title="暂无收藏作品" description="去浏览并收藏你喜欢的作品吧" actionText="发现作品" bind:action="goWorks" />

  <view wx:else class="waterfall-wrap">
    <view class="waterfall">
      <view class="col" wx:for="{{waterfallCols}}" wx:for-item="col" wx:key="id">
        <view wx:for="{{col.items}}" wx:key="id" class="w-card">
          <work-card variant="editorial" work="{{item}}" bind:cardtap="viewWork" bind:artisttap="viewArtist" bind:liketap="toggleFavorite"/>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{hasMore}}" class="page-hint">继续下滑加载更多</view>

</view>
