<nav-bar title="收藏" showBack/>
<view class="container">
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
  </view>

  <view wx:elif="{{works.length === 0}}" class="empty-wrap">
    <view class="menu-icon empty-icon"></view>
    <text class="empty-title">暂无收藏作品</text>
    <text class="empty-desc">去浏览并收藏你喜欢的作品吧</text>
    <view class="go-btn" bindtap="goHome">去逛逛</view>
  </view>

  <view wx:else class="grid">
    <view
      wx:for="{{works}}"
      wx:key="id"
      class="work-card"
      bindtap="viewWork"
      data-id="{{item.id}}"
    >
      <view class="work-img-wrap">
        <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" class="work-img" />
        <view wx:else class="work-img-placeholder">
          <view class="menu-icon placeholder-icon"></view>
        </view>
        <view class="menu-icon fav-icon"></view>
      </view>
      <view class="work-meta">
        <text class="tech-name">{{item.technicianName}}</text>
        <text class="work-title">{{item.title}}</text>
      </view>
    </view>
  </view>
</view>
