<nav-bar title="我的收藏" showBack/>
<view class="page">
  <collection-overview title="收藏灵感" subtitle="集中查看你想再次参考的作品" count="{{works.length}}" show-count="{{!loading && !loadFailed}}" />

  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
  </view>

  <view wx:elif="{{loadFailed}}" class="empty-wrap">
    <text class="empty-title">收藏加载失败</text>
    <text class="empty-desc">请检查网络后重新加载</text>
    <view class="go-btn booking-action" bindtap="loadFavorites">重新加载</view>
  </view>

  <view wx:elif="{{works.length === 0}}" class="empty-wrap">
    <view class="empty-icon"><view class="empty-bookmark"></view></view>
    <text class="empty-title">暂无收藏作品</text>
    <text class="empty-desc">去浏览并收藏你喜欢的作品吧</text>
    <view class="go-btn booking-action" bindtap="goWorks">发现作品</view>
  </view>

  <view wx:else class="waterfall-wrap">
    <view class="waterfall">
      <!-- 左列 -->
      <view class="col">
        <view wx:for="{{leftCol}}" wx:key="id" class="w-card">
          <work-card work="{{item}}" bind:cardtap="viewWork" bind:artisttap="viewArtist" bind:liketap="toggleFavorite"/>
        </view>
      </view>
      <!-- 右列 -->
      <view class="col">
        <view wx:for="{{rightCol}}" wx:key="id" class="w-card">
          <work-card work="{{item}}" bind:cardtap="viewWork" bind:artisttap="viewArtist" bind:liketap="toggleFavorite"/>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{hasMore}}" class="page-hint">继续下滑加载更多</view>

</view>
