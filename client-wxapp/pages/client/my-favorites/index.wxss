page { background: #f0f0f4; }

.page {
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* ===== 加载中 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 160rpx 0;
}
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255, 107, 138, 0.2);
  border-top-color: #FF6B8A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ===== 空状态 ===== */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 60rpx;
}
.empty-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFE2EA, #EDE9FE);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}
.empty-bookmark {
  width: 40rpx;
  height: 50rpx;
  background: #FF6B8A;
  position: relative;
  border-radius: 4rpx 4rpx 0 0;
}
.empty-bookmark::after {
  content: '';
  position: absolute;
  left: 0; bottom: 0;
  width: 0; height: 0;
  border-left: 20rpx solid transparent;
  border-right: 20rpx solid transparent;
  border-bottom: 16rpx solid #FFE2EA;
}
.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 12rpx;
}
.empty-desc {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 36rpx;
  text-align: center;
}
.go-btn {
  min-height: 88rpx;
  padding: 0 56rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 138, 0.28);
}
.go-btn:active { opacity: 0.85; }

/* ===== 瀑布流（与发现/作品列表页一致）===== */
.waterfall-wrap { padding: 20rpx 16rpx 0; }

.waterfall {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* ===== 作品卡片：height:0 + padding-bottom 百分比 ===== */
.w-card {
  position: relative;
  width: 100%;
  height: 0;
  overflow: hidden;
  border-radius: 20rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.08), 0 1rpx 4rpx rgba(15, 23, 42, 0.04);
}
.w-card:active { transform: scale(0.984); opacity: 0.94; }

.aspect-3-4 { padding-bottom: 133.33%; }
.aspect-4-5 { padding-bottom: 125%; }
.aspect-5-6 { padding-bottom: 120%; }
.page-hint { padding:28rpx 0 40rpx; color:#81717a; font-size:22rpx; text-align:center; }
