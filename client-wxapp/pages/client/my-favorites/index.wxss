.container {
  min-height: 100vh;
  background: #f8f9fc;
  padding: 16rpx;
}

.menu-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF0F3 0%, #F5F3FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.menu-icon::after {
  content: '';
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B8A, #A78BFA);
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #FF6B8A;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 60rpx;
}

.empty-icon {
  margin-bottom: 24rpx;
  width: 80rpx;
  height: 80rpx;
}
.empty-icon::after {
  width: 28rpx;
  height: 28rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #9ca3af;
  margin-bottom: 40rpx;
}

.go-btn {
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 60rpx;
  border-radius: 24rpx;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.work-card {
  background: #f8f9fc;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
}

.work-card:active {
  opacity: 0.85;
}

.work-img-wrap {
  position: relative;
  aspect-ratio: 4/5;
}

.work-img {
  width: 100%;
  height: 100%;
}

.work-img-placeholder {
  width: 100%;
  height: 100%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-icon {
  width: 60rpx;
  height: 60rpx;
}
.placeholder-icon::after {
  width: 20rpx;
  height: 20rpx;
}

.fav-icon {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
}

.work-meta {
  padding: 16rpx 40rpx;
}

.tech-name {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 4rpx;
}

.work-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
