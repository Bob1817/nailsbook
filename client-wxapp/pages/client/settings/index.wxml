<nav-bar title="编辑资料" showBack/>
<view class="profile-editor">
  <view class="editor-card">
    <view class="editor-row">
      <text class="editor-label">名称</text>
      <input class="editor-input" type="nickname" value="{{nickname}}" bindinput="onNicknameInput" placeholder="请输入名称" placeholder-class="editor-placeholder" maxlength="20" confirm-type="done" cursor-spacing="24" aria-label="名称" />
    </view>
    <view class="editor-row editor-row-last">
      <text class="editor-label">手机号码</text>
      <text class="editor-phone">{{phone}}</text>
    </view>
  </view>
  <text class="editor-note">手机号码用于账号登录，换绑功能暂未开放。</text>
  <button class="booking-action editor-save" bindtap="saveProfile" disabled="{{saving}}" loading="{{saving}}">{{saving ? '保存中' : '保存修改'}}</button>
</view>
