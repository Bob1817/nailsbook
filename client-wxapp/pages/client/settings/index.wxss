.container {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 40rpx 40rpx;
}

.menu-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF0F3 0%, #F5F3FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.menu-icon::after {
  content: '';
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--brand-gradient);
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.avatar-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: var(--space-sm);
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFE0EA, #F4F7FB);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-icon { font-size: 64rpx; }

.avatar-uploading {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: rgba(0,0,0,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255,255,255,0.4);
  border-top-color: var(--text-inverse);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.avatar-hint {
  font-size: var(--font-sm);
  color: var(--brand-primary);
}

.form-section {
  background: var(--bg-page);
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-bottom: 40rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--border-card);
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: var(--font-md);
  color: var(--text-primary);
  width: 140rpx;
  flex-shrink: 0;
}

.form-input  {
  flex: 1;
  font-size: var(--font-md);
  color: var(--text-primary);
  text-align: right;
 height:88rpx; padding:0 20rpx; background: var(--bg-input); border:2rpx solid transparent; border-radius: var(--radius-sm); box-sizing:border-box;}
.form-input:focus { border-color: var(--brand-primary); background: var(--bg-card); }

.form-placeholder {
  color: var(--text-muted);
}

.save-btn {
  width:100%;
  min-height:88rpx;
  background: var(--brand-gradient);
  color: var(--text-inverse);
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  text-align: center;
  padding: 28rpx;
  border-radius: var(--radius-md);
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-md), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  border:0;
  line-height:1;
}
.save-btn::after { border:0; }
.save-btn[disabled] { opacity:.5; }

.save-btn:active { opacity: 0.85; }
.save-btn.saving { opacity: 0.6; }

.logout-btn {
  color: var(--text-error);
  font-size: var(--font-md);
  text-align: center;
  padding: 28rpx;
  background: var(--bg-page);
  border-radius: var(--radius-md);
  margin-top: var(--space-md);
}
.logout-btn:active { opacity: 0.7; }
