.container {
  min-height: 100vh;
  background: #f8f9fc;
  padding: 40rpx 40rpx;
}

.menu-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF0F3 0%, #F5F3FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.menu-icon::after {
  content: '';
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B8A, #A78BFA);
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.avatar-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFE0EA, #F4F7FB);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-icon { font-size: 64rpx; }

.avatar-uploading {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: rgba(0,0,0,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255,255,255,0.4);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.avatar-hint {
  font-size: 26rpx;
  color: #FF6B8A;
}

.form-section {
  background: #f8f9fc;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 40rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 30rpx;
  color: #1f2937;
  width: 140rpx;
  flex-shrink: 0;
}

.form-input  {
  flex: 1;
  font-size: 28rpx;
  color: #1f2937;
  text-align: right;
 height:88rpx; padding:0 20rpx; background: #f9fafb; border:2rpx solid transparent; border-radius: 14rpx; box-sizing:border-box;}
.form-input:focus { border-color:#ff6b8a; background:#fff; }

.form-placeholder {
  color: #6b7280;
}

.save-btn {
  width:100%;
  min-height:88rpx;
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  padding: 28rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  border:0;
  line-height:1;
}
.save-btn::after { border:0; }
.save-btn[disabled] { opacity:.5; }

.save-btn:active { opacity: 0.85; }
.save-btn.saving { opacity: 0.6; }

.logout-btn {
  color: #dc2626;
  font-size: 30rpx;
  text-align: center;
  padding: 28rpx;
  background: #f8f9fc;
  border-radius: 24rpx;
  margin-top: 24rpx;
}
.logout-btn:active { opacity: 0.7; }
