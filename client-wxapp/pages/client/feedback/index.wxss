page { height: 100%; overflow: hidden; background: var(--nb-page); color: var(--nb-ink); }
.page { height: calc(100vh - 176rpx); box-sizing: border-box; }
.section-title { padding: 28rpx var(--space-lg) var(--space-sm); font-size: var(--font-lg); font-weight: var(--weight-semibold); }
.records { padding: 0 var(--space-md) calc(var(--space-xl) + env(safe-area-inset-bottom)); }
.record { margin-bottom: var(--space-sm); padding: 26rpx var(--space-md) 22rpx; border-radius: 24rpx; background: var(--nb-surface); }
.record:active { opacity: .72; }
.record-head,.record-foot,.detail-status,.sheet-head,.label-row,.picker-row { display: flex; align-items: center; justify-content: space-between; }
.record-type { color: var(--nb-secondary); font-size: var(--font-xs); }
.status { padding: 6rpx 12rpx; border-radius: var(--radius-full); font-size: var(--font-xs); color: var(--nb-secondary); background: var(--nb-soft-surface); }
.status.processing { color: var(--nb-text-link); background: var(--nb-soft-surface); border: 1rpx solid var(--nb-border); }
.status.resolved { color: var(--nb-success); background: var(--nb-success-surface); }
.record-title { display: block; margin-top: 14rpx; font-size: var(--font-md); font-weight: var(--weight-semibold); line-height: 1.45; }
.record-content { display: -webkit-box; margin-top: var(--space-xs); overflow: hidden; -webkit-line-clamp: 2; -webkit-box-orient: vertical; color: var(--nb-muted); font-size: var(--font-sm); line-height: 1.55; }
.record-foot { margin-top: 22rpx; padding-top: 18rpx; border-top: 1rpx solid var(--nb-border); color: var(--nb-muted); font-size: var(--font-xs); }
.result { color: var(--nb-ink); font-weight: var(--weight-medium); }
.state,.empty { margin: 0 var(--space-md); min-height: 280rpx; padding: var(--space-2xl) var(--space-lg); box-sizing: border-box; border-radius: 24rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--nb-surface); color: var(--nb-muted); font-size: var(--font-sm); }
.empty-title { color: var(--nb-ink); font-size: var(--font-md); font-weight: var(--weight-semibold); }
.empty-sub { margin-top: 10rpx; text-align: center; line-height: 1.5; }
.retry { margin-top: var(--space-md); min-height: 88rpx; padding: 0 var(--space-lg); border: 1rpx solid var(--nb-border); border-radius: 16rpx; background: var(--nb-surface); color: var(--nb-ink); font-size: var(--font-sm); }
.retry::after { border: 0; }
.empty-action { margin-top: 28rpx; }
.floating-add { position: fixed; right: 40rpx; bottom: calc(32rpx + env(safe-area-inset-bottom)); z-index: 120; width: 108rpx; height: 108rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(29, 29, 31, 0.72) /* brand-primary-alpha */; border: 1rpx solid rgba(255, 255, 255, 0.24); -webkit-backdrop-filter: blur(18rpx) saturate(125%); backdrop-filter: blur(18rpx) saturate(125%); box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.35) /* brand-primary-alpha */; }
.floating-add:active { transform: scale(.92); }
.floating-add::after { border: 0; }
.floating-add-icon { width: var(--icon-md); height: var(--icon-md); }
.overlay { position: fixed; inset: 0; z-index: 300; display: flex; align-items: flex-end; background: rgba(0,0,0,.42); }
.sheet { width: 100%; max-height: 88vh; box-sizing: border-box; border-radius: 32rpx 32rpx 0 0; overflow: hidden; background: var(--nb-surface); }
.sheet-handle { width: 72rpx; height: 8rpx; margin: var(--space-sm) auto 6rpx; border-radius: var(--radius-full); background: var(--nb-border); }
.sheet-head { padding: 18rpx var(--space-lg) var(--space-md); }
.sheet-title,.sheet-sub { display: block; }
.sheet-title { font-size: var(--font-xl); font-weight: var(--weight-semibold); }
.sheet-sub { margin-top: 6rpx; color: var(--nb-muted); font-size: var(--font-xs); }
.close { width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: flex-end; }
.sheet-close-icon { width: var(--icon-sm); height: var(--icon-sm); }
.form-scroll { max-height: 58vh; padding: 0 var(--space-lg); box-sizing: border-box; }
.field { margin-bottom: 26rpx; }
.label,.label-row { margin-bottom: 12rpx; color: var(--nb-ink); font-size: var(--font-sm); font-weight: var(--weight-medium); }
.label { display: block; }
.label-row text:last-child { color: var(--nb-muted); font-size: var(--font-xs); font-weight: var(--weight-regular); }
input,.picker-row,textarea { width: 100%; box-sizing: border-box; border-radius: 16rpx; background: var(--nb-soft-surface); color: var(--nb-ink); font-size: var(--font-sm); }
input,.picker-row { min-height: 88rpx; padding: 0 22rpx; }
textarea { height: 220rpx; padding: 22rpx; line-height: 1.55; }
.ph { color: var(--nb-muted); }
.chevron { color: var(--nb-muted); line-height: 1; }
.sheet-footer { padding: 18rpx var(--space-lg) calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--nb-border); }
.detail-sheet { min-height: 56vh; }
.detail-scroll { max-height: 64vh; padding: 0 var(--space-lg) calc(var(--space-lg) + env(safe-area-inset-bottom)); box-sizing: border-box; }
.detail-status { justify-content: flex-start; gap: var(--space-sm); color: var(--nb-muted); font-size: var(--font-xs); }
.detail-title { display: block; margin-top: var(--space-md); font-size: var(--font-lg); font-weight: var(--weight-semibold); }
.detail-content { display: block; margin-top: 14rpx; color: var(--nb-secondary); font-size: var(--font-sm); line-height: 1.7; white-space: pre-wrap; }
.reply-box { margin-top: var(--space-lg); padding: var(--space-md); border-radius: var(--radius-md); background: var(--nb-soft-surface); }
.reply-box.has-reply { border-left: 6rpx solid var(--nb-action); }
.reply-label,.reply-content,.reply-date { display: block; }
.reply-label { font-size: var(--font-sm); font-weight: var(--weight-semibold); }
.reply-content { margin-top: 12rpx; color: var(--nb-secondary); font-size: var(--font-sm); line-height: 1.65; white-space: pre-wrap; }
.reply-date { margin-top: var(--space-sm); color: var(--nb-muted); font-size: var(--font-xs); }

@import '../../../styles/booking-actions.wxss';
.retry.booking-action { min-height: 44px; height: var(--control-hit-height); margin-top: var(--space-md); padding: 0 var(--space-md); border-radius: 8px; font-size: var(--font-sm); }
