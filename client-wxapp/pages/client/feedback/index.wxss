page {
  background: var(--bg-page);
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.content {
  flex: 1;
  min-height: 0;
  padding: var(--space-md) 32rpx;
}

/* 引导 */
.intro { padding: 8rpx 8rpx 24rpx; }
.intro-title {
  display: block;
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  margin-bottom: 8rpx;
}
.intro-sub {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
}

/* 卡片 */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 8rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.05);
}

.field {
  position: relative;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--border-card);
}
.field:last-child { border-bottom: none; }

.field-label {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
  margin-bottom: var(--space-sm);
}

.field-input {
  width: 100%;
  height: 88rpx;
  padding:0 18rpx;
  border:2rpx solid transparent;
  border-radius: var(--radius-sm);
  background: var(--bg-input);
  box-sizing:border-box;
  font-size: var(--font-md);
  color: var(--text-primary);
}
.field-input:focus,.field-area:focus { border-color: var(--brand-primary); background: var(--bg-card); }

.ph { color: #c4c9d4; }

.field-count {
  position: absolute;
  right: 0;
  top: 26rpx;
  font-size: var(--font-xs);
  color: #c4c9d4;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding:0 18rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-input);
}
.picker-value { font-size: var(--font-md); color: var(--text-primary); }
.picker-arrow { font-size: var(--font-lg); color: var(--text-muted); transform: rotate(90deg); }

.field-textarea .field-count {
  position: static;
  display: block;
  text-align: right;
  margin-top: 12rpx;
}

.field-area {
  width: 100%;
  min-height: 200rpx;
  font-size: var(--font-md);
  color: var(--text-primary);
  line-height: 1.6;
  padding:18rpx;
  border:2rpx solid transparent;
  border-radius: var(--radius-sm);
  background: var(--bg-input);
  box-sizing:border-box;
}

/* 底部提交 */
.footer {
  flex-shrink: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg-page);
}
.submit-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: var(--brand-gradient);
  color: var(--text-inverse);
  border-radius: var(--radius-md);
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
}
.submit-btn::after { border: none; }
.submit-btn.disabled { opacity: 0.6; }
