page {
  background: var(--nb-page);
}

.page {
  min-height: 100vh;
  background: var(--nb-page);
  padding-bottom: 24rpx;
}

/* ===== 固定 Tab 栏（吸附在 nav-bar 下方）===== */
.tabs-bar {
  position: sticky;
  top: 0;
  z-index: 20;
  background: rgba(255, 255, 255, 0.72);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  backdrop-filter: blur(20px) saturate(180%);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  padding: 14rpx var(--space-lg);
}

.content-area {
  padding: 28rpx var(--space-xl) 24rpx;
}

/* ===== Tab 栏 ===== */
.tab-scroll {
  white-space: nowrap;
}

.tab-bar-inner {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
}

.tab-pill {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 56rpx;
  min-height: 56rpx;
  padding: 0 22rpx;
  border-radius: var(--radius-full);
  background: var(--nb-page);
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  flex-shrink: 0;
  box-sizing: border-box;
  transition: all 0.15s ease-in-out;
}
.tab-pill::after { content:''; position:absolute; top:-16rpx; bottom:-16rpx; left:0; right:0; }

/* 44px 移动端触控热区保证 */
.tab-pill:active {
  background: var(--nb-pressed);
  transform: scale(0.97);
}

.tab-pill-active {
  background: var(--nb-action);
  border-color: var(--nb-action);
}

.tab-label {
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  color: var(--nb-secondary);
  line-height: 1;
}

.tab-pill-active .tab-label {
  color: var(--nb-inverse);
  font-weight: var(--weight-semibold);
}

.tab-count {
  font-size: 20rpx;
  color: var(--nb-muted);
  font-weight: var(--weight-medium);
  background: rgba(0, 0, 0, 0.06);
  padding: 2rpx 10rpx;
  border-radius: var(--radius-full);
  line-height: 1.2;
}

.tab-pill-active .tab-count {
  background: #FFFFFF;
  color: var(--nb-action);
  font-weight: var(--weight-semibold);
}

.badge-reminder { background:var(--nb-page); color:var(--nb-ink); }

/* ===== 消息卡片 ===== */
.msg-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.msg-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 28rpx var(--space-lg);
  background: rgba(255, 255, 255, 0.86);
  border-radius: var(--radius-lg);
  border: 0;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.08), 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
}

.msg-card:active { background: rgba(255, 255, 255, 0.92); }

.msg-avatar-wrap {
  position: relative;
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
}

.msg-avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
}

.msg-avatar-placeholder {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
  background: var(--nb-page);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.msg-avatar-char {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--brand-primary);
}
.msg-semantic-icon {
  width: 48rpx;
  height: 48rpx;
}

/* 在线状态指示器 */
.msg-online-dot {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--nb-muted);
  border: 0;
  box-shadow: none;
}

.msg-body {
  flex: 1;
  min-width: 0;
}

.msg-top-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.msg-name {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.msg-type-badge {
  flex-shrink: 0;
  padding: 4rpx 18rpx;
  border-radius: var(--radius-md);
}

.msg-type-badge-text {
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
}

.badge-chat {
  background: var(--nb-page);
}
.badge-chat .msg-type-badge-text { color: var(--nb-ink); }

.badge-booking {
  background: var(--nb-page);
}
.badge-booking .msg-type-badge-text { color: var(--nb-ink); }

.badge-service {
  background: var(--nb-page);
}
.badge-service .msg-type-badge-text { color: var(--nb-ink); }

.badge-system {
  background: var(--bg-input);
}
.badge-system .msg-type-badge-text { color: var(--text-muted); }

.msg-preview {
  font-size: var(--font-sm);
  color: var(--text-muted);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.msg-right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  padding-top: 4rpx;
  min-width: 80rpx;
}

.msg-time {
  font-size: var(--font-sm);
  color: var(--text-muted);
  font-weight: var(--weight-normal);
}

/* 未读数字徽章 */
.msg-unread-badge {
  min-width: 36rpx;
  height: 36rpx;
  border-radius: var(--card-radius);
  background: var(--nb-success);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3) /* brand-primary-alpha */;
}

.msg-unread-num {
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
  color: var(--text-inverse);
  line-height: 1;
}

/* ===== 空态 ===== */
.empty-card {
  margin: 80rpx 0;
  padding: 72rpx var(--space-2xl);
  background: rgba(255, 255, 255, 0.86);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-sm);
  border: 0;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.08), 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
}
.load-error { margin:80rpx 0; padding:72rpx var(--space-2xl); border: 0; border-radius: var(--radius-lg); background:rgba(255,255,255,.86); box-shadow:0 20rpx 60rpx rgba(0, 0, 0, .08); display:flex; flex-direction:column; align-items:center; gap:var(--space-sm); text-align:center; }
.load-error-mark { width:88rpx; height:88rpx; margin-bottom:12rpx; border-radius:50%; background:var(--nb-page); color:var(--nb-ink); font-size: var(--font-xl); line-height:88rpx; text-align:center; }
.retry-btn { min-height:88rpx; margin:28rpx 0 0; padding:0 56rpx; border:0; border-radius: var(--radius-xl); background:var(--nb-ink); color: var(--text-inverse); font-size: var(--font-md); line-height:88rpx; }
.retry-btn::after { border:0; }

.empty-icon-wrap {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--nb-page);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.empty-icon-inner {
  width: 52rpx;
  height: 52rpx;
  border-radius: var(--radius-sm);
  background: var(--brand-gradient);
  opacity: 0.5;
}

.empty-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.empty-sub {
  font-size: var(--font-sm);
  color: var(--text-muted);
  text-align: center;
  line-height: 1.6;
}

/* ===== 骨架屏 ===== */
.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.skeleton-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx var(--space-lg);
  background: rgba(255, 255, 255, 0.86);
  border-radius: var(--radius-lg);
  border: 0;
}

.skel-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
  background: var(--nb-page);
  animation: skel 1.4s linear infinite;
}

.skel-lines {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.skel-line {
  height: 24rpx;
  border-radius: var(--radius-xs);
  background: var(--nb-page);
  animation: skel 1.4s linear infinite;
}

.skel-line-wide { width: 70%; }
.skel-line-narrow { width: 45%; }

@keyframes skel {
  0% { opacity: 1; }
  50% { opacity: 0.4; }
  100% { opacity: 1; }
}

/* ===== 通知详情弹窗 ===== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1500;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-sheet {
  width: 100%;
  background: rgba(255, 255, 255, 0.94);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  backdrop-filter: blur(24px) saturate(180%);
  border-top: 1rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 -16rpx 48rpx rgba(0, 0, 0, 0.08);
  border-radius: var(--radius-lg) 32rpx 0 0;
  padding: var(--space-xl) var(--space-xl) calc(var(--space-2xl) + env(safe-area-inset-bottom));
  max-height: 70vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-md);
}

.modal-type-badge {
  padding: var(--space-xs) var(--space-md);
  border-radius: var(--radius-md);
}

.modal-close {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-input);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.modal-close:active { background: var(--nb-page); }

.modal-close-icon {
  width: var(--icon-sm, 28rpx);
  height: var(--icon-sm, 28rpx);
}

.modal-name {
  display: block;
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin-bottom: var(--space-sm);
}

.modal-preview {
  display: block;
  font-size: var(--font-md);
  color: var(--text-body);
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.modal-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 28rpx;
}

.modal-meta-text {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

.modal-meta-dot {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: var(--space-xl);
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-xl);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn:active { opacity: 0.85; }

.modal-btn-close {
  background: var(--bg-input);
}

.modal-btn-close-text {
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  color: var(--text-body);
}

.modal-btn-primary {
  background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-primary-light) 100%);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25) /* brand-primary-alpha */;
}

.modal-btn-primary-text {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-inverse);
}

/* ===== 为 tabBar 预留空间 ===== */
.page { padding-bottom: 0; }

@import '../../../styles/booking-actions.wxss';
.retry-btn.booking-action { min-height: 44px; height: var(--control-hit-height); margin-top: 28rpx; padding: 0 var(--space-md); border-radius: 8px; background: var(--nb-action); font-size: var(--font-sm); line-height: 1.4; box-shadow: none; }
.modal-btn.booking-action { height: var(--control-hit-height); min-height: 44px; border-radius: 8px; }
.modal-btn.booking-action text { font-size: var(--font-sm); }

.msg-online-dot.is-online { background:var(--nb-success); }
.msg-online-dot.is-offline { background:var(--nb-muted); }
