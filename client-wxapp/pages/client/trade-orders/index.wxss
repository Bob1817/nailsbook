.page{min-height:100vh;background:var(--nb-page);padding:0 28rpx 48rpx;box-sizing:border-box}.tabs{margin:0 -28rpx;background:var(--nb-surface);border-top: 0;border-bottom: 0;}.tabs-inner{display:flex;padding:20rpx 28rpx;gap:16rpx}.tab{min-width:136rpx;height:72rpx;display:flex;align-items:center;justify-content:center;border-radius:36rpx;background:var(--nb-page);color:var(--nb-muted);font-size:28rpx}.tab.active{background:var(--nb-ink);color:var(--nb-surface)}.list{padding-top:24rpx}.order-card{margin-bottom:24rpx;padding:28rpx;background:var(--nb-surface);border: 0;border-radius:24rpx;box-shadow:0 8rpx 24rpx rgba(0, 0, 0, .05)}.order-head,.order-foot{display:flex;align-items:center;justify-content:space-between}.trade-no{font-size:23rpx;color:var(--nb-muted)}.status{font-size:25rpx;color:var(--nb-ink)}.status-paid{color:var(--nb-ink)}.status-cancelled{color:var(--nb-muted)}.order-title{display:block;margin-top:22rpx;font-size:34rpx;font-weight:600;color:var(--nb-ink)}.order-meta{display:block;margin-top:10rpx;font-size:25rpx;color:var(--nb-muted)}.amount-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:26rpx;padding:22rpx 0;border-top: 0;border-bottom: 0;}.amount-grid view{display:flex;flex-direction:column;gap:8rpx}.amount-grid text{font-size:23rpx;color:var(--nb-muted)}.amount-grid strong{font-size:29rpx;color:var(--nb-ink)}.order-foot{min-height:72rpx;font-size:25rpx;color:var(--nb-muted)}.pay-link{color:var(--nb-ink);font-weight:600}.empty{margin-top:180rpx;display:flex;flex-direction:column;align-items:center;gap:18rpx;color:var(--nb-muted);font-size:27rpx}.empty-title{font-size:34rpx;color:var(--nb-ink);font-weight:600}
.status-completed{color:var(--nb-ink)}.amount-value{font-size:29rpx!important;color:var(--nb-ink)!important;font-weight:600}

/* 交易字段统一语义色 */
.status { color:var(--nb-secondary); }
.status-paid { color:var(--nb-success); }
.status-cancelled { color:var(--nb-danger); }
.amount-grid strong, .amount-value { color:var(--nb-money)!important; font-variant-numeric:tabular-nums; }
.pay-link { color:var(--nb-text-link); }

.pay-link { color:var(--nb-text-link); background:transparent; box-shadow:none; }
