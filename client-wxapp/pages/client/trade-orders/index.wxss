.page{min-height:100vh;background:#f7f7f9;padding:0 28rpx 48rpx;box-sizing:border-box}.tabs{margin:0 -28rpx;background:#fff;border-top:1rpx solid #eee;border-bottom:1rpx solid #eee}.tabs-inner{display:flex;padding:20rpx 28rpx;gap:16rpx}.tab{min-width:136rpx;height:72rpx;display:flex;align-items:center;justify-content:center;border-radius:36rpx;background:#f5f6f8;color:#737b89;font-size:28rpx}.tab.active{background:#202937;color:#fff}.list{padding-top:24rpx}.order-card{margin-bottom:24rpx;padding:28rpx;background:#fff;border:1rpx solid #e8e8e8;border-radius:24rpx;box-shadow:0 8rpx 24rpx rgba(29,35,44,.05)}.order-head,.order-foot{display:flex;align-items:center;justify-content:space-between}.trade-no{font-size:23rpx;color:#949aa5}.status{font-size:25rpx;color:#a33b60}.status-paid{color:#18865b}.status-cancelled{color:#9297a0}.order-title{display:block;margin-top:22rpx;font-size:34rpx;font-weight:600;color:#202733}.order-meta{display:block;margin-top:10rpx;font-size:25rpx;color:#8a909b}.amount-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:26rpx;padding:22rpx 0;border-top:1rpx solid #eee;border-bottom:1rpx solid #eee}.amount-grid view{display:flex;flex-direction:column;gap:8rpx}.amount-grid text{font-size:23rpx;color:#969ca6}.amount-grid strong{font-size:29rpx;color:#252b35}.order-foot{min-height:72rpx;font-size:25rpx;color:#7d8490}.pay-link{color:#a33b60;font-weight:600}.empty{margin-top:180rpx;display:flex;flex-direction:column;align-items:center;gap:18rpx;color:#949aa5;font-size:27rpx}.empty-title{font-size:34rpx;color:#3b424d;font-weight:600}
.status-completed{color:#18865b}.amount-value{font-size:29rpx!important;color:#252b35!important;font-weight:600}
