<nav-bar title="我的订单" showBack="{{true}}" backUrl="/pages/client/profile/index"/>
<view class="page">
  <scroll-view scroll-x class="tabs" enhanced show-scrollbar="{{false}}">
    <view class="tabs-inner">
      <view wx:for="{{tabs}}" wx:key="value" class="tab {{active === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="switchTab">{{item.label}}</view>
    </view>
  </scroll-view>
  <view wx:if="{{loading}}" class="empty">订单加载中...</view>
  <view wx:elif="{{!list.length}}" class="empty"><text class="empty-title">暂无相关订单</text><text>双方确认报价后，支付订单会显示在这里</text></view>
  <view wx:else class="list">
    <view wx:for="{{list}}" wx:key="id" class="order-card" bindtap="openOrder" data-id="{{item.bookingId}}">
      <view class="order-head"><text class="trade-no">{{item.tradeNo}}</text><text class="status {{item._statusClass}}">{{item._statusText}}</text></view>
      <text class="order-title">{{item._title}}</text>
      <text class="order-meta">{{item._artist}} · 创建于 {{item._created}}</text>
      <view class="amount-grid">
        <view><text>订单金额</text><text class="amount-value semantic-money">¥{{item._total}}</text></view>
        <view><text>定金</text><text class="amount-value semantic-money">¥{{item._deposit}}</text></view>
        <view><text>尾款</text><text class="amount-value semantic-money">¥{{item._balance}}</text></view>
      </view>
      <view class="order-foot"><text>已支付 ¥{{item._paid}}</text><text wx:if="{{item.status === 'pending'}}" class="pay-link">待支付 ¥{{item._remaining}} ›</text><text wx:else class="semantic-link">查看详情 ›</text></view>
    </view>
  </view>
</view>
