<page-meta page-style="background: var(--nb-surface);"/>
<nav-bar title="{{isSelectMode ? '选择上门地址' : '上门地址管理'}}" showBack/>
<secondary-page-header title="你的上门地址" subtitle="{{isSelectMode ? '请选择本次服务地点，常用地址不会自动替你确认。' : '仅用于上门美甲。预约中保存的地址也会显示在这里。'}}"/>
<view class="address-page">
  <state-card compact wx:if="{{loading}}" type="loading" title="正在获取地址"/>
  <state-card compact wx:elif="{{loadFailed}}" type="error" title="地址加载失败" description="请检查网络后重试" bindaction="loadAddresses"/>
  <state-card compact wx:elif="{{addresses.length === 0}}" icon="/static/icons/pin.svg" title="添加第一个上门地址" description="保存常用服务地点，下次预约更方便。"/>
  <view wx:else class="address-list">
    <address-card wx:for="{{addresses}}" wx:key="id" address="{{item}}" selectable="{{isSelectMode}}" selected="{{isSelectMode && item.id === selectedAddressId}}" manage data-id="{{item.id}}" data-default="{{item.isDefault}}" bindselect="{{isSelectMode ? 'selectAddress' : 'editAddress'}}" bindedit="editAddress" bindremove="deleteAddress" binddefaultchange="setDefault"/>
  </view>
</view>
<bottom-action-bar class="page-actions" wx:if="{{!loading && !loadFailed}}" primary-label="{{isSelectMode && addresses.length ? '确认使用此地址' : '新增地址'}}" secondary-label="{{isSelectMode && addresses.length ? '新增地址' : ''}}" disabled="{{isSelectMode && addresses.length && !selectedAddressId}}" bindprimary="onPrimaryAction" bindsecondary="addAddress"/>
