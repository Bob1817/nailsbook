page {
  background: var(--bg-page);
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.scroll {
  flex: 1;
  min-height: 0;
}

.doc {
  padding: var(--space-md) 36rpx calc(48rpx + env(safe-area-inset-bottom));
}

.doc-title {
  display: block;
  font-size: var(--font-xl);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  margin-bottom: 10rpx;
}

.doc-updated {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
  margin-bottom: 28rpx;
}

.doc-intro {
  display: block;
  font-size: var(--font-md);
  color: var(--text-body);
  line-height: 1.8;
  margin-bottom: var(--space-sm);
}

.sec { margin-top: 28rpx; }

.sec-h {
  display: block;
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.sec-p {
  display: block;
  font-size: var(--font-md);
  color: var(--text-body);
  line-height: 1.85;
  margin-bottom: 8rpx;
}

.doc-foot {
  margin-top: 48rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e5e7eb;
}

.doc-foot-text {
  font-size: var(--font-sm);
  color: #c4c9d4;
}
