page {
  padding: 0;
  margin: 0;
  background: #f8f9fc;
}

.page {
  min-height: 100vh;
  background: #f8f9fc;
  padding-bottom: 120rpx;
}

/* ===== 内容区 ===== */
.content { padding: 24rpx 32rpx; }

/* ===== 区域标题 ===== */
.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-titles { flex: 1; min-width: 0; }
.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}
.section-sub {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.count-badge {
  background: #fff;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  flex-shrink: 0;
  margin-top: 4rpx;
}
.count-text { font-size: 22rpx; color: #6b7280; font-weight: 500; }

/* ===== 排序 tabs ===== */
.sort-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.sort-tab {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #6b7280;
  background: #fff;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.sort-tab:active { opacity: 0.8; }

.sort-tab-active {
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 138, 0.2);
}

/* 排序箭头 */
.sort-arrow {
  width: 0; height: 0;
  margin-left: 6rpx;
  border-left: 7rpx solid transparent;
  border-right: 7rpx solid transparent;
}
.sort-arrow-down {
  border-top: 8rpx solid #9ca3af;
  border-bottom: none;
}
.sort-arrow-up {
  border-bottom: 8rpx solid #fff;
  border-top: none;
}
.sort-tab:not(.sort-tab-active) .sort-arrow-up {
  border-bottom-color: #9ca3af;
}

/* ===== 美甲师筛选 pills ===== */
.tech-scroll {
  margin-bottom: 20rpx;
  white-space: nowrap;
}

.tech-pills {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx 0;
}

.tech-pill {
  display: inline-flex;
  align-items: center;
  height: 60rpx;
  padding: 0 28rpx;
  border-radius: 36rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #6b7280;
  background: #fff;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.03);
  flex-shrink: 0;
}
.tech-pill:active { opacity: 0.8; }

.tech-pill-active {
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 138, 0.2);
}

/* ===== 筛选空状态 ===== */
.filter-empty {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}
.filter-empty-text { font-size: 28rpx; color: #9ca3af; }

/* ===== 瀑布流 ===== */
.waterfall {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* ===== 卡片 ===== */
.card-img-wrap {
  position: relative;
  width: 100%;
  height: 0;
  overflow: hidden;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}
.card-img-wrap:active { transform: scale(0.985); opacity: 0.95; }

/* 宽高比：3:4, 4:5, 5:6 */
.aspect-3-4 { padding-bottom: 133.33%; }
.aspect-4-5 { padding-bottom: 125%; }
.aspect-5-6 { padding-bottom: 120%; }

.card-img {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
}
.card-img-empty {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: linear-gradient(135deg, #f1f5f9, #e2e8f0);
}

/* 渐变遮罩 */
.card-gradient {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.18) 40%, rgba(0,0,0,0.78) 100%);
}

/* 顶部：美甲师 + 点赞 */
.card-top {
  position: absolute;
  top: 0; left: 0; right: 0;
  padding: 16rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  z-index: 1;
}

.card-tech-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(0, 0, 0, 0.36);
  padding: 8rpx 14rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  max-width: 65%;
}

.card-tech-av {
  width: 36rpx; height: 36rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.card-tech-av-fallback {
  width: 36rpx; height: 36rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.card-tech-av-char { font-size: 18rpx; font-weight: 600; color: #fff; }

.card-tech-info { min-width: 0; }
.card-tech-name {
  display: block;
  font-size: 20rpx;
  font-weight: 500;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-like-pill {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(0, 0, 0, 0.36);
  padding: 8rpx 14rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
}
.card-like-num { font-size: 20rpx; color: #fff; font-weight: 500; }

/* 底部：详情信息 */
.card-bottom {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 16rpx;
  z-index: 1;
}

.card-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.3;
}

.card-tags {
  display: flex;
  gap: 8rpx;
  margin-top: 10rpx;
}
.card-tag {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.18);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.card-foot-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}
.card-date { font-size: 20rpx; color: rgba(255, 255, 255, 0.52); }

.card-cta {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.card-cta-text { font-size: 20rpx; color: rgba(255, 255, 255, 0.78); }

/* ===== Flat Icons ===== */
.icon { flex-shrink: 0; }

/* SVG 爱心图标 */
.heart-icon {
  width: 22rpx;
  height: 20rpx;
  flex-shrink: 0;
}

.icon-check-circle {
  width: 20rpx; height: 20rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.78);
  position: relative;
}
.icon-check-circle::after {
  content: '';
  position: absolute;
  width: 6rpx; height: 3rpx;
  border-left: 2rpx solid rgba(255, 255, 255, 0.78);
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.78);
  transform: rotate(-45deg);
  top: 5rpx; left: 4rpx;
}

/* Hero placeholder icon (reused from home) */
.icon-placeholder-circle {
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  background: rgba(255,107,138,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon-placeholder-inner {
  width: 32rpx; height: 32rpx;
  border-radius: 50%;
  background: rgba(255,107,138,0.3);
}

/* ===== 加载中 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255, 107, 138, 0.2);
  border-top-color: #ff6b8a;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ===== 空状态 ===== */
.empty-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 100rpx 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}
.empty-icon-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}
.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #9ca3af;
  margin-bottom: 8rpx;
}
.empty-sub {
  display: block;
  font-size: 26rpx;
  color: #d1d5db;
}
