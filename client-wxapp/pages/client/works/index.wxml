<nav-bar title="{{businessPage ? '美甲师主页' : '作品'}}" showBack="{{true}}"></nav-bar>

<view class="page">
  <!-- 内容区 -->
  <view class="content">
    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="loading-wrap">
      <view class="spinner"></view>
    </view>

    <view wx:elif="{{loadFailed}}" class="load-error" aria-live="polite">
      <view class="load-error-mark">!</view>
      <text class="empty-title">作品加载失败</text>
      <text class="empty-sub">请检查网络后重试</text>
      <button class="retry-btn" bindtap="retryLoad">重新加载</button>
    </view>

    <block wx:else>
      <view wx:if="{{businessPage && artist}}" class="business-card">
        <view class="business-profile">
          <image wx:if="{{artist.avatarUrl}}" class="business-avatar" src="{{artist.avatarUrl}}" mode="aspectFill" aria-label="{{artist.name}}的头像" />
          <view wx:else class="business-avatar business-avatar-fallback">{{artist.initial}}</view>
          <view class="business-copy">
            <text class="business-name">{{artist.name}}</text>
            <text class="business-area">{{artist.city || '本地'}}{{artist.serviceArea ? ' · ' + artist.serviceArea : ''}}</text>
          </view>
          <button class="share-card-btn" open-type="share" aria-label="分享美甲师名片">分享名片</button>
        </view>

        <view class="business-tags">
          <text wx:if="{{artist.shopService}}" class="business-tag">到店服务</text>
          <text wx:if="{{artist.homeService}}" class="business-tag">上门服务</text>
          <text class="business-tag business-tag-muted">{{availabilityText}}</text>
        </view>

        <view wx:if="{{serviceItems.length}}" class="business-section">
          <text class="business-section-title">服务项目</text>
          <view class="service-list">
            <view wx:for="{{serviceItems}}" wx:key="id" class="service-row">
              <view class="service-copy">
                <text class="service-name">{{item.name}}</text>
                <text wx:if="{{item.durationMinutes}}" class="service-meta">约 {{item.durationMinutes}} 分钟</text>
              </view>
              <text wx:if="{{item.price !== undefined && item.price !== null}}" class="service-price">¥{{item.price}} 起</text>
            </view>
          </view>
        </view>

        <view wx:if="{{shopAddresses.length}}" class="business-section">
          <text class="business-section-title">服务地址</text>
          <view wx:for="{{shopAddresses}}" wx:key="id" class="address-row">
            <text class="address-name">{{item.name || '工作室'}}</text>
            <text class="address-detail">{{item.displayAddress}}</text>
          </view>
        </view>

        <button class="business-book-btn" bindtap="bookArtist">查看可约时间并预约</button>
      </view>

      <!-- 空状态 -->
      <view wx:if="{{works.length === 0}}" class="empty-card">
        <view class="empty-icon-wrap">
          <view class="icon-placeholder-circle">
            <view class="icon-placeholder-inner"></view>
          </view>
        </view>
        <text class="empty-title">暂无公开作品</text>
        <text class="empty-sub">{{businessPage ? '可以先查看服务并发起预约' : '你绑定的美甲师暂时还没有发布作品'}}</text>
      </view>

      <!-- 有作品时 -->
      <block wx:else>
      <!-- 区域标题 -->
      <view class="section-head">
        <view class="section-titles">
          <text class="section-title">{{businessPage ? '作品画册' : (keyword ? keyword + '灵感' : '精选作品')}}</text>
          <text class="section-sub">{{businessPage ? '浏览公开作品，选择喜欢的款式' : (keyword ? '为你筛选相关风格作品' : '来自你已绑定美甲师的作品画册')}}</text>
        </view>
        <view wx:if="{{totalCount > 0}}" class="count-badge">
          <text class="count-text">{{totalCount}} 条动态</text>
        </view>
      </view>

      <!-- 排序 tabs -->
      <view wx:if="{{!businessPage}}" class="sort-tabs">
        <view
          wx:for="{{sortTabs}}"
          wx:key="key"
          class="sort-tab {{sortBy === item.key ? 'sort-tab-active' : ''}}"
          bindtap="switchSort"
          data-key="{{item.key}}"
        >
          <text>{{item.label}}</text>
          <view class="sort-arrow {{sortBy === item.key ? (sortDirs[item.key] === 'asc' ? 'sort-arrow-up' : 'sort-arrow-down') : 'sort-arrow-down'}}"></view>
        </view>
      </view>

      <!-- 美甲师筛选 pills -->
      <scroll-view wx:if="{{!businessPage}}" scroll-x class="tech-scroll" enhanced show-scrollbar="{{false}}">
        <view class="tech-pills">
          <view
            wx:for="{{techFilters}}"
            wx:key="*this"
            class="tech-pill {{selectedTech === item ? 'tech-pill-active' : ''}}"
            bindtap="switchTech"
            data-name="{{item}}"
          >{{item}}</view>
        </view>
      </scroll-view>

      <!-- 筛选为空 -->
      <view wx:if="{{filteredWorks.length === 0}}" class="filter-empty">
        <text class="filter-empty-text">当前筛选下暂无作品动态</text>
      </view>

      <!-- 瀑布流 -->
      <view wx:else class="waterfall">
        <!-- 左列 -->
        <view class="col">
          <view wx:for="{{leftCol}}" wx:key="id" class="card-img-wrap {{item.aspect}}" bindtap="viewWork" data-id="{{item.id}}">
            <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" class="card-img" lazy-load aria-label="{{item.title}}" />
            <view wx:else class="card-img card-img-empty"></view>
            <view class="card-gradient"></view>
            <view class="card-top">
              <view class="card-tech-pill" catchtap="viewArtist" data-id="{{item.technicianId}}">
                <image wx:if="{{item.technicianAvatarUrl}}" src="{{item.technicianAvatarUrl}}" mode="aspectFill" class="card-tech-av" binderror="onAvatarError" data-id="{{item.id}}" lazy-load aria-label="{{item.technicianName}}的头像" />
                <view wx:else class="card-tech-av-fallback">
                  <text class="card-tech-av-char">{{item.techInitial}}</text>
                </view>
                <view class="card-tech-info">
                  <text class="card-tech-name">{{item.technicianName}}</text>

                </view>
              </view>
              <view class="card-like-pill">
                <image wx:if="{{item.isLiked}}" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABQAAAASCAYAAABb0P4QAAAAUElEQVR4nGNgQAP/3cP/o2NS5PEqJBVT1TAUQ6lqIDUNG6kG0iSWqZ4OqWEo1txCjsF4DaKZgcQaSrRhxBhKsmH4DCXbMGyGUmwYsqHEqAMAvy56MytYoCsAAAAASUVORK5CYII=" class="heart-icon" />
                <image wx:else src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABQAAAASCAYAAABb0P4QAAAAS0lEQVR4nOXTMQ4AIAgDQP7/aV3RkKbFMtmV5hYg4soqosxhUY0VO1Ar6MR+BUe2bL9DB1p+SweG0BjIojTGoDKG0DZWoc9YRpneBsE8yGLtxtorAAAAAElFTkSuQmCC" class="heart-icon" />
                <text class="card-like-num">{{item.likeCount}}</text>
              </view>
            </view>
            <view class="card-bottom">
              <text class="card-title">{{item.title}}</text>
              <view wx:if="{{item.tags.length > 0}}" class="card-tags">
                <block wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">
                  <text wx:if="{{index < 2}}" class="card-tag">#{{tag}}</text>
                </block>
              </view>
              <view class="card-foot-row">
                <text class="card-date">{{item.dateStr}}</text>
                <view class="card-cta">
                  <view class="icon icon-check-circle"></view>
                  <text class="card-cta-text">查看详情</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 右列 -->
        <view class="col">
          <view wx:for="{{rightCol}}" wx:key="id" class="card-img-wrap {{item.aspect}}" bindtap="viewWork" data-id="{{item.id}}">
            <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" class="card-img" lazy-load aria-label="{{item.title}}" />
            <view wx:else class="card-img card-img-empty"></view>
            <view class="card-gradient"></view>
            <view class="card-top">
              <view class="card-tech-pill" catchtap="viewArtist" data-id="{{item.technicianId}}">
                <image wx:if="{{item.technicianAvatarUrl}}" src="{{item.technicianAvatarUrl}}" mode="aspectFill" class="card-tech-av" binderror="onAvatarError" data-id="{{item.id}}" lazy-load aria-label="{{item.technicianName}}的头像" />
                <view wx:else class="card-tech-av-fallback">
                  <text class="card-tech-av-char">{{item.techInitial}}</text>
                </view>
                <view class="card-tech-info">
                  <text class="card-tech-name">{{item.technicianName}}</text>

                </view>
              </view>
              <view class="card-like-pill">
                <image wx:if="{{item.isLiked}}" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABQAAAASCAYAAABb0P4QAAAAUElEQVR4nGNgQAP/3cP/o2NS5PEqJBVT1TAUQ6lqIDUNG6kG0iSWqZ4OqWEo1txCjsF4DaKZgcQaSrRhxBhKsmH4DCXbMGyGUmwYsqHEqAMAvy56MytYoCsAAAAASUVORK5CYII=" class="heart-icon" />
                <image wx:else src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABQAAAASCAYAAABb0P4QAAAAS0lEQVR4nOXTMQ4AIAgDQP7/aV3RkKbFMtmV5hYg4soqosxhUY0VO1Ar6MR+BUe2bL9DB1p+SweG0BjIojTGoDKG0DZWoc9YRpneBsE8yGLtxtorAAAAAElFTkSuQmCC" class="heart-icon" />
                <text class="card-like-num">{{item.likeCount}}</text>
              </view>
            </view>
            <view class="card-bottom">
              <text class="card-title">{{item.title}}</text>
              <view wx:if="{{item.tags.length > 0}}" class="card-tags">
                <block wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">
                  <text wx:if="{{index < 2}}" class="card-tag">#{{tag}}</text>
                </block>
              </view>
              <view class="card-foot-row">
                <text class="card-date">{{item.dateStr}}</text>
                <view class="card-cta">
                  <view class="icon icon-check-circle"></view>
                  <text class="card-cta-text">查看详情</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
      </block>
    </block>
  </view>
</view>
