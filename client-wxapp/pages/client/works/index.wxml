<nav-bar title="作品" showBack="{{true}}"></nav-bar>

<view class="page">
  <!-- 内容区 -->
  <view class="content">
    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="loading-wrap">
      <view class="spinner"></view>
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{works.length === 0}}" class="empty-card">
      <view class="empty-icon-wrap">
        <view class="icon-placeholder-circle">
          <view class="icon-placeholder-inner"></view>
        </view>
      </view>
      <text class="empty-title">暂无作品</text>
      <text class="empty-sub">你绑定的美甲师暂时还没有发布作品</text>
    </view>

    <!-- 有作品时 -->
    <block wx:else>
      <!-- 区域标题 -->
      <view class="section-head">
        <view class="section-titles">
          <text class="section-title">最新动态</text>
          <text class="section-sub">来自你已绑定美甲师的作品发布</text>
        </view>
        <view wx:if="{{totalCount > 0}}" class="count-badge">
          <text class="count-text">{{totalCount}} 条动态</text>
        </view>
      </view>

      <!-- 排序 tabs -->
      <view class="sort-tabs">
        <view
          wx:for="{{sortTabs}}"
          wx:key="key"
          class="sort-tab {{sortBy === item.key ? 'sort-tab-active' : ''}}"
          bindtap="switchSort"
          data-key="{{item.key}}"
        >
          <text>{{item.label}}</text>
          <view class="sort-arrow {{sortBy === item.key ? (sortDirs[item.key] === 'asc' ? 'sort-arrow-up' : 'sort-arrow-down') : 'sort-arrow-down'}}"></view>
        </view>
      </view>

      <!-- 美甲师筛选 pills -->
      <scroll-view scroll-x class="tech-scroll" enhanced show-scrollbar="{{false}}">
        <view class="tech-pills">
          <view
            wx:for="{{techFilters}}"
            wx:key="*this"
            class="tech-pill {{selectedTech === item ? 'tech-pill-active' : ''}}"
            bindtap="switchTech"
            data-name="{{item}}"
          >{{item}}</view>
        </view>
      </scroll-view>

      <!-- 筛选为空 -->
      <view wx:if="{{filteredWorks.length === 0}}" class="filter-empty">
        <text class="filter-empty-text">当前筛选下暂无作品动态</text>
      </view>

      <!-- 瀑布流 -->
      <view wx:else class="waterfall">
        <!-- 左列 -->
        <view class="col">
          <view wx:for="{{leftCol}}" wx:key="id" class="card-img-wrap {{item.aspect}}" bindtap="viewWork" data-id="{{item.id}}">
            <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" class="card-img" lazy-load />
            <view wx:else class="card-img card-img-empty"></view>
            <view class="card-gradient"></view>
            <view class="card-top">
              <view class="card-tech-pill">
                <image wx:if="{{item.technicianAvatarUrl}}" src="{{item.technicianAvatarUrl}}" mode="aspectFill" class="card-tech-av" binderror="onAvatarError" data-id="{{item.id}}" />
                <view wx:else class="card-tech-av-fallback">
                  <text class="card-tech-av-char">{{item.techInitial}}</text>
                </view>
                <view class="card-tech-info">
                  <text class="card-tech-name">{{item.technicianName}}</text>

                </view>
              </view>
              <view class="card-like-pill">
                <image wx:if="{{item.isLiked}}" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABQAAAASCAYAAABb0P4QAAAAUElEQVR4nGNgQAP/3cP/o2NS5PEqJBVT1TAUQ6lqIDUNG6kG0iSWqZ4OqWEo1txCjsF4DaKZgcQaSrRhxBhKsmH4DCXbMGyGUmwYsqHEqAMAvy56MytYoCsAAAAASUVORK5CYII=" class="heart-icon" />
                <image wx:else src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABQAAAASCAYAAABb0P4QAAAAS0lEQVR4nOXTMQ4AIAgDQP7/aV3RkKbFMtmV5hYg4soqosxhUY0VO1Ar6MR+BUe2bL9DB1p+SweG0BjIojTGoDKG0DZWoc9YRpneBsE8yGLtxtorAAAAAElFTkSuQmCC" class="heart-icon" />
                <text class="card-like-num">{{item.likeCount}}</text>
              </view>
            </view>
            <view class="card-bottom">
              <text class="card-title">{{item.title}}</text>
              <view class="card-meta-row">
                <text class="card-source">来自 {{item.technicianName}}</text>
                <text class="card-comments">{{item.commentCount}} 条评论</text>
              </view>
              <view wx:if="{{item.tags.length > 0}}" class="card-tags">
                <block wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">
                  <text wx:if="{{index < 2}}" class="card-tag">#{{tag}}</text>
                </block>
              </view>
              <view class="card-foot-row">
                <text class="card-date">{{item.dateStr}}</text>
                <view class="card-cta">
                  <view class="icon icon-check-circle"></view>
                  <text class="card-cta-text">查看详情</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 右列 -->
        <view class="col">
          <view wx:for="{{rightCol}}" wx:key="id" class="card-img-wrap {{item.aspect}}" bindtap="viewWork" data-id="{{item.id}}">
            <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" class="card-img" lazy-load />
            <view wx:else class="card-img card-img-empty"></view>
            <view class="card-gradient"></view>
            <view class="card-top">
              <view class="card-tech-pill">
                <image wx:if="{{item.technicianAvatarUrl}}" src="{{item.technicianAvatarUrl}}" mode="aspectFill" class="card-tech-av" binderror="onAvatarError" data-id="{{item.id}}" />
                <view wx:else class="card-tech-av-fallback">
                  <text class="card-tech-av-char">{{item.techInitial}}</text>
                </view>
                <view class="card-tech-info">
                  <text class="card-tech-name">{{item.technicianName}}</text>

                </view>
              </view>
              <view class="card-like-pill">
                <image wx:if="{{item.isLiked}}" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABQAAAASCAYAAABb0P4QAAAAUElEQVR4nGNgQAP/3cP/o2NS5PEqJBVT1TAUQ6lqIDUNG6kG0iSWqZ4OqWEo1txCjsF4DaKZgcQaSrRhxBhKsmH4DCXbMGyGUmwYsqHEqAMAvy56MytYoCsAAAAASUVORK5CYII=" class="heart-icon" />
                <image wx:else src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABQAAAASCAYAAABb0P4QAAAAS0lEQVR4nOXTMQ4AIAgDQP7/aV3RkKbFMtmV5hYg4soqosxhUY0VO1Ar6MR+BUe2bL9DB1p+SweG0BjIojTGoDKG0DZWoc9YRpneBsE8yGLtxtorAAAAAElFTkSuQmCC" class="heart-icon" />
                <text class="card-like-num">{{item.likeCount}}</text>
              </view>
            </view>
            <view class="card-bottom">
              <text class="card-title">{{item.title}}</text>
              <view class="card-meta-row">
                <text class="card-source">来自 {{item.technicianName}}</text>
                <text class="card-comments">{{item.commentCount}} 条评论</text>
              </view>
              <view wx:if="{{item.tags.length > 0}}" class="card-tags">
                <block wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">
                  <text wx:if="{{index < 2}}" class="card-tag">#{{tag}}</text>
                </block>
              </view>
              <view class="card-foot-row">
                <text class="card-date">{{item.dateStr}}</text>
                <view class="card-cta">
                  <view class="icon icon-check-circle"></view>
                  <text class="card-cta-text">查看详情</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
