.container {
  min-height: 100vh;
  background: #f8f9fc;
  padding: 0 40rpx;
  padding-top: 40rpx;
}

.menu-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF0F3 0%, #F5F3FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.menu-icon::after {
  content: '';
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B8A, #A78BFA);
}

/* 头部 */
.header {
  text-align: center;
  margin-bottom: 48rpx;
}

.logo-circle {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #6b7280;
}

/* 表单 */
.form {
  background: #f8f9fc;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
}

/* 提示横幅 */
.hint-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff7ed;
  border-radius: 14rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.hint-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.hint-text {
  font-size: 26rpx;
  color: #92400e;
  line-height: 1.4;
}

/* 表单项 */
.form-item {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #374151;
  margin-bottom: 12rpx;
}

.input-wrap  {
  position: relative;
}

.input  {
  width: 100%;
  height: 88rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1f2937;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.input:focus  {
  border-color: #FF6B8A;
  background: linear-gradient(180deg, #fff8fb 0%, #ffffff 34%, #f8f9fc 100%);
}

.input-error  {
  border-color: #dc2626;
}

.readonly {
  width: 100%;
  height: 88rpx;
  background: #f3f4f6;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #6b7280;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.spinner {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(255, 107, 138, 0.3);
  border-top-color: #FF6B8A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 错误和成功提示 */
.error-text {
  display: block;
  font-size: 24rpx;
  color: #dc2626;
  margin-top: 8rpx;
}

.success-text {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #10b981;
  margin-top: 8rpx;
}

.success-icon {
  font-weight: 700;
}

/* 按钮 */
.btn-primary {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  opacity: 0.5;
}

/* 底部链接 */
.footer-links {
  text-align: center;
  margin-top: 24rpx;
}

.link {
  font-size: 28rpx;
  color: #FF6B8A;
  font-weight: 500;
}
