<nav-bar title="注册" showBack transparent/>
<view class="container">
  <view class="header">
    <view class="logo-circle">N</view>
    <text class="title">创建账号</text>
    <text class="subtitle">注册后即可预约美甲服务</text>
  </view>

  <view class="form">
    <view class="hint-banner">
      <view class="menu-icon"></view>
      <text class="hint-text">该手机号未注册，请输入美甲师邀请码完成注册</text>
    </view>

    <view class="form-item">
      <text class="label">手机号</text>
      <view class="readonly">{{phone}}</view>
    </view>

    <view class="form-item">
      <text class="label">美甲师邀请码</text>
      <view class="input-wrap">
        <input
          class="input {{inviteCodeError ? 'input-error' : ''}}"
          placeholder="向你的美甲师索要邀请码"
          value="{{inviteCode}}"
          data-field="inviteCode"
          bindinput="onInput"
          confirm-type="next"
          cursor-spacing="24"
        />
        <view wx:if="{{checkingCode}}" class="spinner"></view>
      </view>
      <text wx:if="{{inviteCodeError}}" class="error-text">{{inviteCodeError}}</text>
      <text wx:if="{{foundTech}}" class="success-text">
        <text class="success-icon">✓</text>
        美甲师：{{foundTech.name}}
      </text>
    </view>

    <view class="form-item">
      <text class="label">设置密码</text>
      <input
        class="input {{passwordError ? 'input-error' : ''}}"
        type="text"
        password
        placeholder="至少 8 位，含字母和数字"
        value="{{password}}"
        data-field="password"
        bindinput="onInput"
        confirm-type="next"
        cursor-spacing="24"
      />
      <text wx:if="{{passwordError}}" class="error-text">{{passwordError}}</text>
    </view>

    <view class="form-item">
      <text class="label">确认密码</text>
      <input
        class="input {{confirmPasswordError ? 'input-error' : ''}}"
        type="text"
        password
        placeholder="再次输入密码"
        value="{{confirmPassword}}"
        data-field="confirmPassword"
        bindinput="onInput"
        confirm-type="done"
        cursor-spacing="24"
      />
      <text wx:if="{{confirmPasswordError}}" class="error-text">{{confirmPasswordError}}</text>
    </view>

    <button class="btn-primary" bindtap="handleRegister" disabled="{{loading}}">
      {{loading ? '注册中...' : '注册并登录'}}
    </button>

    <view class="footer-links">
      <text class="link" bindtap="goBack">换个手机号</text>
    </view>
  </view>
</view>
