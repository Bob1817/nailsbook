.container {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 200rpx;
}

.menu-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF0F3 0%, #F5F3FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.menu-icon::after {
  content: '';
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--brand-gradient);
}

/* 步骤指示器 */
.steps-bar {
  background: rgba(255, 255, 255, 0.82);
  padding: var(--space-md) 40rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  z-index: 1;
}

.step-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--bg-input);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.step-item.active .step-circle {
  background: var(--brand-primary);
}

.step-item.completed .step-circle {
  background: #10b981;
}

.step-num {
  font-size: var(--font-sm);
  color: var(--text-muted);
  font-weight: var(--weight-medium);
}

.step-item.active .step-num {
  color: var(--text-inverse);
}

.step-check {
  font-size: var(--font-sm);
  color: var(--text-inverse);
}

.step-name {
  font-size: var(--font-xs);
  color: var(--text-muted);
}

.step-item.active .step-name {
  color: var(--brand-primary);
}

.step-item.completed .step-name {
  color: #10b981;
}

.step-line-wrap {
  position: absolute;
  top: 48rpx;
  left: 80rpx;
  right: 80rpx;
  display: flex;
  gap: 0;
}

.step-line {
  flex: 1;
  height: 4rpx;
  background: var(--bg-input);
}

.step-line.completed {
  background: #10b981;
}

/* 步骤内容 */
.step-content {
  padding: var(--space-md) 40rpx;
}

.step-panel {
  background: var(--bg-page);
  border-radius: var(--radius-md);
  padding: 32rpx;
  box-shadow: var(--shadow-md), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

.panel-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--space-md);
}

.panel-title {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.panel-subtitle {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

/* 基础款式网格 */
.style-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.style-card {
  width: calc(50% - 8rpx);
  aspect-ratio: 4/5;
  border-radius: var(--radius-sm);
  overflow: hidden;
  position: relative;
}

.style-card.selected {
  box-shadow: 0 0 0 4rpx var(--brand-primary);
}

.style-img {
  width: 100%;
  height: 100%;
}

.style-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
}

.style-name {
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  color: var(--text-inverse);
}

.style-check {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--brand-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-icon {
  font-size: var(--font-sm);
  color: var(--text-inverse);
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--bg-input);
  margin: 24rpx 0;
}

/* 上传区域 */
.upload-section {
  margin-top: var(--space-md);
}

.upload-hint {
  font-size: var(--font-sm);
  color: var(--text-muted);
  margin-bottom: var(--space-sm);
  display: block;
}

.preview-wrap {
  position: relative;
  aspect-ratio: 16/9;
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.preview-remove {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 48rpx;
  height: 48rpx;
  background: var(--bg-overlay);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.remove-icon {
  font-size: var(--font-lg);
  color: var(--text-inverse);
}

.upload-btn {
  width: 100%;
  aspect-ratio: 16/9;
  border-radius: var(--radius-sm);
  border: 3rpx dashed #d1d5db;
  background: #fffafc;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-btn.uploading {
  border-color: var(--brand-primary);
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--brand-primary);
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.upload-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.upload-icon {
  font-size: var(--font-2xl);
}

.upload-text {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

/* 甲型网格 */
.shape-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.shape-card {
  width: calc(33.33% - 11rpx);
  padding: var(--space-md) 40rpx;
  border-radius: var(--radius-sm);
  border: 2rpx solid #f1f5f9;
  background: var(--bg-page);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.shape-card.selected {
  border-color: var(--brand-primary);
  background: #fff1f5;
}

.shape-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-input);
  display: flex;
  align-items: center;
  justify-content: center;
}

.shape-icon {
  font-size: var(--font-lg);
}

.shape-name {
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  color: var(--text-primary);
}

.shape-desc {
  font-size: var(--font-xs);
  color: var(--text-muted);
}

/* 颜色网格 */
.color-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.color-item {
  width: calc(20% - 20rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 0;
}

.color-item.selected {
  background: #fff1f5;
  border-radius: var(--radius-sm);
}

.color-circle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 4rpx solid #e5e7eb;
  position: relative;
}

.color-item.selected .color-circle {
  border-color: var(--brand-primary);
  transform: scale(1.1);
}

.color-check {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-mark {
  font-size: var(--font-md);
  color: var(--brand-primary);
  font-weight: bold;
}

.color-name {
  font-size: var(--font-xs);
  color: var(--text-primary);
}

/* 配饰网格 */
.element-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.element-card {
  width: calc(25% - 12rpx);
  padding: 20rpx 40rpx;
  border-radius: var(--radius-sm);
  border: 2rpx solid #f1f5f9;
  background: var(--bg-page);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.element-card.selected {
  border-color: var(--brand-primary);
  background: #fff1f5;
}

.element-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fff1f5, #f3e8ff);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm);
  font-weight: var(--weight-bold);
  color: #a14d72;
}

.element-name {
  font-size: var(--font-xs);
  color: var(--text-primary);
}

/* 预览卡片 */
.preview-card {
  background: var(--bg-page);
  border-radius: var(--radius-sm);
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.preview-image-wrap {
  aspect-ratio: 1;
  background: var(--bg-input);
}

.preview-main-img {
  width: 100%;
  height: 100%;
}

.preview-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF0F3 0%, #F5F3FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.7;
}
.placeholder-icon::after {
  content: '';
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: var(--brand-gradient);
  opacity: 0.5;
}

.preview-info {
  padding: var(--space-md);
}

.preview-title-wrap {
  margin-bottom: var(--space-sm);
}

.form-label {
  font-size: var(--font-sm);
  color: var(--text-muted);
  margin-bottom: 8rpx;
  display: block;
}

.form-input  {
  width: 100%;
  height: 88rpx;
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  padding: 0 20rpx;
  font-size: var(--font-md);
  color: var(--text-primary);
  box-sizing: border-box;
}

.form-textarea  {
  width: 100%;
  height: 160rpx;
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  padding: 16rpx 40rpx;
  font-size: var(--font-md);
  color: var(--text-primary);
  box-sizing: border-box;
}

.placeholder {
  color: var(--text-muted);
}

.preview-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: var(--space-sm);
}

.tag {
  padding: 6rpx 40rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-xs);
}

.shape-tag {
  background: var(--bg-input);
  color: var(--text-primary);
}

.color-tag {
  color: var(--text-inverse);
}

.element-tag {
  background: var(--bg-input);
  color: var(--text-primary);
}

.preview-desc-wrap {
  margin-top: var(--space-sm);
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.94);
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  padding: 20rpx 40rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.bottom-actions {
  display: flex;
  gap: 16rpx;
}

.btn-prev {
  flex: 1;
  height: 88rpx;
  background: var(--bg-input);
  color: var(--text-primary);
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-prev::after {
  border: none;
}

.btn-next {
  flex: 1;
  height: 88rpx;
  background: var(--brand-gradient);
  color: var(--text-inverse);
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-md), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  border: none;
}

.btn-next::after {
  border: none;
}

.btn-submit {
  flex: 1;
  height: 88rpx;
  background: var(--brand-gradient);
  color: var(--text-inverse);
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-md), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  border: none;
}

.btn-submit.disabled {
  opacity: 0.5;
}

.btn-submit::after {
  border: none;
}
