<nav-bar title="服务与价格" showBack/><view class="page"><block wx:if="{{loading}}"><view class="skeleton" wx:for="{{[1,2,3,4]}}" wx:key="*this"></view></block><view wx:elif="{{error}}" class="state"><text>服务暂时无法加载</text><button class="booking-action" bindtap="load" data-reset="true">重新加载</button></view><view wx:elif="{{!items.length}}" class="state">暂无可预约服务</view><view wx:else><view wx:for="{{items}}" wx:key="id" class="card"><view class="copy"><text class="name">{{item.name}}</text><text class="desc">{{item.description || '预约后与美甲师确认细节'}}</text><text wx:if="{{item.durationMinutes}}" class="duration">预计 {{item.durationMinutes}} 分钟</text></view><view class="action" bindtap="book" data-id="{{item.id}}"><text class="price semantic-money">{{item.priceText}}</text><text>选择预约</text></view></view><view wx:if="{{loadingMore}}" class="more">正在加载...</view></view></view>
