page{background:var(--nb-page);color:var(--nb-ink)}.page{min-height:100vh;padding:var(--space-md) 28rpx calc(var(--space-xl) + env(safe-area-inset-bottom));box-sizing:border-box}.card{min-height:160rpx;margin-bottom:18rpx;padding:26rpx;display:flex;align-items:center;gap:18rpx;border: 0;border-radius:24rpx;background:var(--nb-surface)}.copy{flex:1;min-width:0}.name,.desc,.duration,.price{display:block}.name{font-size:var(--font-md);font-weight:700}.desc,.duration{margin-top:var(--space-xs);color:var(--nb-secondary);font-size:var(--font-sm);line-height:1.45}.action{min-width:180rpx;min-height:96rpx;display:flex;flex-direction:column;align-items:flex-end;justify-content:center;color:var(--nb-ink);font-size:var(--font-sm);font-weight:650}.price{margin-bottom:7rpx;color:var(--nb-money);font-size:var(--font-md);font-variant-numeric:tabular-nums}.state{min-height:70vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20rpx;color:var(--nb-secondary)}.state button{min-height:88rpx;padding:0 38rpx;border: 0;border-radius:var(--radius-xl);background:var(--nb-surface)}.skeleton{height:160rpx;margin-bottom:18rpx;border-radius:24rpx;background:var(--nb-page);background-size:400% 100%;animation:shine 1.3s infinite}.more{padding:var(--space-md);text-align:center;color:var(--nb-text-link)}@keyframes shine{to{background-position:-100% 0}}
@import '../../../styles/booking-actions.wxss';
.state button.booking-action { min-height:44px; height:44px; padding:0 var(--space-md); border-radius:8px; font-size:var(--font-sm); line-height:1.4; }
