page{background:#f7f7f7;color:#222}.page{min-height:100vh;padding:24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));box-sizing:border-box}.card{min-height:160rpx;margin-bottom:18rpx;padding:26rpx;display:flex;align-items:center;gap:18rpx;border:1rpx solid #ddd;border-radius:24rpx;background:#fff}.copy{flex:1;min-width:0}.name,.desc,.duration,.price{display:block}.name{font-size:30rpx;font-weight:700}.desc,.duration{margin-top:8rpx;color:#6a6a6a;font-size:24rpx;line-height:1.45}.action{min-width:180rpx;min-height:96rpx;display:flex;flex-direction:column;align-items:flex-end;justify-content:center;color:#9d174d;font-size:24rpx;font-weight:650}.price{margin-bottom:7rpx;color:#222;font-size:30rpx}.state{min-height:70vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20rpx;color:#6a6a6a}.state button{min-height:88rpx;padding:0 38rpx;border:2rpx solid #222;border-radius:44rpx;background:#fff}.skeleton{height:160rpx;margin-bottom:18rpx;border-radius:24rpx;background:linear-gradient(90deg,#eee,#fafafa,#eee);background-size:400% 100%;animation:shine 1.3s infinite}.more{padding:24rpx;text-align:center;color:#6a6a6a}@keyframes shine{to{background-position:-100% 0}}
