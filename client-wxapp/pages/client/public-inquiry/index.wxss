@import '../../../styles/booking-actions.wxss';

.page{min-height:100vh;background:var(--nb-page);padding:28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));box-sizing:border-box}.intro,.form,.success{background:var(--nb-surface);border-radius:28rpx;padding:32rpx;margin-bottom:24rpx}.title,.success-title{display:block;font-size:42rpx;font-weight:700;color:var(--nb-ink)}.sub,.work,.success-copy{display:block;margin-top:12rpx;color:var(--nb-secondary);line-height:1.6}.work{color:var(--nb-ink)}.form label{display:block;font-size:28rpx;font-weight:600;margin:28rpx 0 12rpx}input,.picker,textarea{width:100%;min-height:88rpx;background:var(--nb-page);border-radius:18rpx;padding:22rpx;box-sizing:border-box;font-size:30rpx}textarea{height:220rpx}.privacy{display:flex!important;align-items:flex-start;gap:12rpx;font-weight:400!important;color:var(--nb-secondary);line-height:1.5}.primary{min-height:96rpx;margin-top:32rpx;border:0;border-radius:48rpx;background:var(--nb-ink);color:var(--nb-surface);font-size:32rpx}.primary::after{border:0}.success{text-align:center;margin-top:20vh}.success-mark{display:block;margin:auto auto 28rpx;width:96rpx;height:96rpx;line-height:96rpx;border-radius:50%;background:var(--nb-page);color:var(--nb-ink);font-size:52rpx}.success-copy{margin:22rpx 0}
.form input,.form .picker,.form textarea{font-size:var(--font-sm);border-radius:var(--input-radius)}.primary.booking-action{min-height:44px;height:44px;border-radius:8px;font-size:var(--font-sm);line-height:1.4}
