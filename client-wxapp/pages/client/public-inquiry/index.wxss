.page{min-height:100vh;background:#f7f5f2;padding:28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));box-sizing:border-box}.intro,.form,.success{background:#fff;border-radius:28rpx;padding:32rpx;margin-bottom:24rpx}.title,.success-title{display:block;font-size:42rpx;font-weight:700;color:#211b18}.sub,.work,.success-copy{display:block;margin-top:12rpx;color:#716864;line-height:1.6}.work{color:#9b6155}.form label{display:block;font-size:28rpx;font-weight:600;margin:28rpx 0 12rpx}input,.picker,textarea{width:100%;min-height:88rpx;background:#f7f5f2;border-radius:18rpx;padding:22rpx;box-sizing:border-box;font-size:30rpx}textarea{height:220rpx}.privacy{display:flex!important;align-items:flex-start;gap:12rpx;font-weight:400!important;color:#716864;line-height:1.5}.primary{min-height:96rpx;margin-top:32rpx;border:0;border-radius:48rpx;background:#211b18;color:#fff;font-size:32rpx}.primary::after{border:0}.success{text-align:center;margin-top:20vh}.success-mark{display:block;margin:auto auto 28rpx;width:96rpx;height:96rpx;line-height:96rpx;border-radius:50%;background:#e7f5ec;color:#348657;font-size:52rpx}.success-copy{margin:22rpx 0}
