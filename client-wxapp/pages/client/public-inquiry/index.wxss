@import '../../../styles/booking-actions.wxss';

.page{min-height:100vh;background:var(--nb-page);padding:28rpx 28rpx calc(var(--space-2xl) + env(safe-area-inset-bottom));box-sizing:border-box}.intro,.form,.success{background:var(--nb-surface);border-radius:var(--radius-lg);padding:var(--space-lg);margin-bottom:var(--space-md)}.title,.success-title{display:block;font-size:var(--font-xl);font-weight:700;color:var(--nb-ink)}.sub,.work,.success-copy{display:block;margin-top:12rpx;color:var(--nb-secondary);line-height:1.6}.work{color:var(--nb-ink)}.form label{display:block;font-size:var(--font-md);font-weight:600;margin:28rpx 0 12rpx}input,.picker,textarea{width:100%;min-height:88rpx;background:var(--nb-page);border-radius:18rpx;padding:22rpx;box-sizing:border-box;font-size:var(--font-md)}textarea{height:220rpx}.privacy{display:flex!important;align-items:flex-start;gap:12rpx;font-weight:400!important;color:var(--nb-secondary);line-height:1.5}.primary{min-height:96rpx;margin-top:var(--space-lg);border:0;border-radius:var(--radius-pill);background:var(--nb-ink);color:var(--nb-surface);font-size:var(--font-lg)}.primary::after{border:0}.success{text-align:center;margin-top:20vh}.success-mark{display:flex;align-items:center;justify-content:center;margin:auto auto 28rpx;width:96rpx;height:96rpx;border-radius:50%;background:var(--nb-action);}.success-mark-icon{width:48rpx;height:48rpx;}.success-copy{margin:22rpx 0}
.form input,.form .picker,.form textarea{font-size:var(--font-sm);border-radius:var(--input-radius)}.primary.booking-action{min-height:44px;height:44px;border-radius:8px;font-size:var(--font-sm);line-height:1.4}
