<nav-bar title="快速咨询" showBack/>
<view class="page"><block wx:if="{{success}}"><view class="success"><text class="success-mark">✓</text><text class="success-title">咨询已提交</text><text class="success-copy">{{techName}}会尽快与你联系，请留意你填写的联系方式。</text><button class="primary" bindtap="back">完成</button></view></block><block wx:else><view class="intro"><text class="title">告诉我你的美甲想法</text><text class="sub">咨询对象：{{techName}}</text><text wx:if="{{workTitle}}" class="work">意向作品：{{workTitle}}</text></view><view class="form"><label>昵称 *</label><input value="{{nickname}}" data-field="nickname" bindinput="input" placeholder="怎么称呼你"/><label>联系方式 *</label><input value="{{contact}}" data-field="contact" bindinput="input" placeholder="微信号或手机号"/><label>具体需求 *</label><textarea value="{{requirement}}" data-field="requirement" bindinput="input" maxlength="1000" placeholder="喜欢的风格、颜色、甲型或其他要求"/><label>预算范围</label><input value="{{budget}}" data-field="budget" bindinput="input" placeholder="例如 200–300 元"/><label>期望日期</label><picker mode="date" value="{{expectedDate}}" bindchange="dateChange"><view class="picker">{{expectedDate || '选择日期（可选）'}}</view></picker><checkbox-group bindchange="privacyChange"><label class="privacy"><checkbox value="agree" checked="{{privacyAgreed}}"/><text>我同意将以上信息用于本次咨询和后续联系</text></label></checkbox-group><button class="primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">提交咨询</button></view></block></view>
