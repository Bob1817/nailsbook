<nav-bar title="营销工具" showBack/>
<view class="page">
  <view class="tool-list">
    <button wx:for="{{tools}}" wx:key="key" class="tool-row" data-key="{{item.key}}" bindtap="openTool" hover-class="is-pressed" aria-label="{{item.label}}">
      <image class="tool-icon" src="{{item.icon}}" mode="aspectFit"/>
      <text class="tool-title">{{item.label}}</text>
    </button>
  </view>
</view>
