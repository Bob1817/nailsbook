page {
  background: var(--bg-card);
}

.page {
  box-sizing: border-box;
  width: 100%;
  padding: var(--space-lg) var(--space-md) calc(var(--space-2xl) + env(safe-area-inset-bottom));
}

.tool-list {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-sm);
  width: 100%;
}

/* Keep native button sizing from narrowing grid cells. */
.tool-list > button.tool-row {
  box-sizing: border-box;
  width: 100%;
  max-width: none;
  min-width: 0;
  min-height: 112px;
  margin: 0;
  padding: var(--space-lg) var(--space-xs);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-md);
  border: 0;
  border-radius: var(--radius-md);
  background: var(--nb-soft-surface);
  text-align: center;
  line-height: 1.5;
}

.tool-row::after {
  border: 0;
}

.tool-list > button.tool-row.is-pressed,
.tool-list > button.tool-row:active,
.tool-list > button.tool-row:focus {
  background: var(--nb-pressed);
}

.tool-icon {
  width: 28px;
  height: 28px;
  flex: 0 0 28px;
}

.tool-title {
  width: 100%;
  color: var(--text-primary);
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  text-align: center;
  overflow-wrap: anywhere;
}
