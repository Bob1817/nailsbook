@import '../../../styles/booking-actions.wxss';
.page{min-height:100vh;background:var(--nb-page);color:var(--nb-ink)}.settings-page{padding:24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));box-sizing:border-box}.security-title,.security-sub,.section-title,.section-note,.label,.tip,.danger-title,.danger-copy{display:block}.security-card{min-height:112rpx;padding:22rpx 28rpx;display:flex;align-items:center;gap:20rpx;border-radius:24rpx;background:var(--nb-surface)}.security-icon{width:48rpx;height:48rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:var(--nb-success);color:var(--nb-inverse);font-size:24rpx}.security-title{font-size:26rpx;font-weight:600}.security-sub{margin-top:5rpx;color:var(--nb-muted);font-size:21rpx}.section-heading{padding:34rpx 8rpx 16rpx;display:flex;align-items:center;justify-content:space-between}.section-title{font-size:28rpx;font-weight:650}.section-note{color:var(--nb-muted);font-size:21rpx}.form-card{overflow:hidden;border-radius:24rpx;background:var(--nb-surface)}.field{padding:26rpx 28rpx;border-bottom:1rpx solid var(--nb-border)}.field:last-child{border-bottom:0}.label{margin-bottom:12rpx;font-size:var(--font-sm);font-weight:var(--weight-medium)}.input{width:100%;height:var(--input-height);min-height:44px;padding:0 var(--input-padding-h);box-sizing:border-box;border-radius:var(--input-radius);background:var(--bg-input);color:var(--nb-ink);font-size:var(--font-sm)}.ph{color:var(--nb-muted);font-size:var(--font-sm)}.save-btn{min-height:88rpx;margin-top:24rpx;display:flex;align-items:center;justify-content:center;border-radius:16rpx;background:var(--nb-action);color:var(--nb-inverse);font-size:var(--font-sm);font-weight:var(--weight-semibold)}.save-btn:active{background:var(--nb-action-pressed)}.btn-disabled{opacity:.6}.tip{margin-top:14rpx;color:var(--nb-muted);font-size:20rpx;line-height:1.5;text-align:center}.danger-section{margin-top:52rpx}.danger-section>.section-title{padding:0 8rpx 16rpx}.danger-card{min-height:112rpx;padding:22rpx 28rpx;display:flex;align-items:center;justify-content:space-between;gap:20rpx;border-radius:24rpx;background:var(--nb-surface)}.danger-title{font-size:25rpx;font-weight:600}.danger-copy{margin-top:5rpx;color:var(--nb-muted);font-size:20rpx;line-height:1.45}.danger-link{min-height:88rpx;display:flex;align-items:center;flex-shrink:0;color:var(--nb-danger);font-size:22rpx}
