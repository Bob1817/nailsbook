.container { min-height: 100vh; background: linear-gradient(180deg, #fff8fb 0%, #ffffff 34%, #f8f9fc 100%); padding: 32rpx; }
.section-title-row { margin-bottom: 16rpx; }
.section-title { font-size: 28rpx; font-weight: 600; color: #1f2937; }
.form { background: linear-gradient(180deg, #fff8fb 0%, #ffffff 34%, #f8f9fc 100%); border-radius: 24rpx; overflow: hidden; margin-bottom: 32rpx; }
.field { padding: 28rpx 40rpx; border-bottom: 1rpx solid #f5f5f5; }
.field:last-child { border-bottom: none; }
.label { display: block; font-size: 26rpx; color: #374151; margin-bottom: 12rpx; }
.input  { width: 100%; font-size: 28rpx; color: #1f2937; height: 88rpx;  background: #f9fafb; border-radius: 14rpx;}
.ph { color: #6b7280; }
.save-btn { background: linear-gradient(135deg, #ff6b8a, #8b5cf6); color: #fff; font-size: 30rpx; font-weight: 600; text-align: center; padding: 28rpx; border-radius: 48rpx; box-shadow: 0 8rpx 24rpx rgba(255,107,138,0.3); margin-bottom: 24rpx; }
.save-btn:active { opacity: 0.85; }
.btn-disabled { opacity: 0.6; }
.tip { display: block; text-align: center; font-size: 24rpx; color: #6b7280; }
