<nav-bar title="账号安全" showBack/>
<view class="page">
  <secondary-page-header title="保护你的账号" subtitle="定期更新密码，避免在多个平台重复使用同一密码。" />
  <view class="settings-page">
  <view class="security-card"><view class="security-icon">✓</view><view><text class="security-title">账号状态正常</text><text class="security-sub">密码与登录信息由平台安全保护</text></view></view>
  <view class="section-heading"><text class="section-title">修改密码</text><text class="section-note">至少 6 位字符</text></view>
  <view class="form-card">
    <view class="field"><text class="label">当前密码</text><input class="input" password value="{{oldPassword}}" bindinput="onOldInput" placeholder="输入当前密码" placeholder-class="ph" confirm-type="done"/></view>
    <view class="field"><text class="label">新密码</text><input class="input" password value="{{newPassword}}" bindinput="onNewInput" placeholder="输入至少 6 位新密码" placeholder-class="ph" confirm-type="done"/></view>
    <view class="field"><text class="label">确认新密码</text><input class="input" password value="{{confirmPassword}}" bindinput="onConfirmInput" placeholder="再次输入新密码" placeholder-class="ph" confirm-type="done"/></view>
  </view>
  <view class="save-btn booking-action {{saving ? 'btn-disabled' : ''}}" bindtap="changePassword"><text>{{saving ? '修改中...' : '确认修改密码'}}</text></view><text class="tip">修改成功后，其他设备上的登录状态可能失效。</text>
  <view class="danger-section"><text class="section-title">账号管理</text><view class="danger-card" bindtap="requestAccountDeletion" role="button"><view><text class="danger-title">注销账号</text><text class="danger-copy">永久删除账号前，平台会再次确认相关条件</text></view><text class="danger-link">申请注销 ›</text></view></view>
</view>
</view>
