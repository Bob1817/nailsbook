page{background:var(--nb-page);color:var(--nb-ink)}.page{min-height:100vh;padding: var(--space-md) 28rpx 48rpx;box-sizing:border-box}.state{display:flex;min-height:420rpx;flex-direction:column;align-items:center;justify-content:center;color:var(--nb-secondary);font-size: var(--font-sm);text-align:center}.state-title{color:var(--nb-ink);font-size: var(--font-md);font-weight: var(--weight-bold)}.state-copy{margin-top:12rpx}.retry{display:flex;min-height:88rpx;margin-top:20rpx;padding:0 38rpx;align-items:center;border-radius: var(--radius-xl);background: var(--bg-tag);color:var(--nb-ink)}.list{display:flex;flex-direction:column;gap:20rpx}.card{padding:26rpx;border: 0;border-radius: var(--radius-md);background: var(--bg-card)}.card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}.title,.meta{display:block}.title{font-size: var(--font-md);font-weight: var(--weight-bold)}.meta{margin-top:8rpx;color:var(--nb-secondary);font-size: var(--font-xs)}.status{padding:8rpx 16rpx;border-radius: var(--card-radius);background:var(--nb-page);color:var(--nb-ink);font-size: var(--font-xs)}.description{display:block;margin-top:18rpx;color:var(--nb-secondary);font-size: var(--font-sm);line-height:1.6}.photos{margin-top:18rpx;white-space:nowrap}.photo-row{display:inline-flex;gap:12rpx}.photo{width:170rpx;height:170rpx;border-radius: var(--radius-sm);background:var(--nb-page)}.quote-summary{display:flex;margin-top:20rpx;align-items:center;justify-content:space-between;color:var(--nb-secondary);font-size: var(--font-xs)}.price{color:var(--nb-ink);font-size: var(--font-md);font-weight: var(--weight-bold)}.quote-btn{display:flex;min-height:88rpx;margin-top:20rpx;align-items:center;justify-content:center;border-radius: var(--radius-xl);background:var(--nb-action);color: var(--text-inverse);font-size: var(--font-sm);font-weight: var(--weight-bold)}.mask{position:fixed;z-index:100;inset:0;display:flex;align-items:flex-end;background:rgba(0,0,0,.48)}.sheet{width:100%;padding:30rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));border-radius:30rpx 30rpx 0 0;background: var(--bg-card);box-sizing:border-box}.sheet-title{display:block;font-size: var(--font-lg);font-weight: var(--weight-bold)}.label{display:block;margin:24rpx 0 10rpx;color:var(--nb-secondary);font-size: var(--font-sm)}.input,.textarea{width:100%;padding:0 22rpx;border: 0;border-radius: var(--radius-sm);background:var(--nb-page);box-sizing:border-box}.input{height:88rpx}.textarea{height:150rpx;padding-top:20rpx}.sheet-actions{display:flex;gap:14rpx;margin-top:26rpx}.cancel,.submit{display:flex;min-height:88rpx;flex:1;align-items:center;justify-content:center;border-radius: var(--radius-xl);font-size: var(--font-sm);font-weight: var(--weight-bold)}.cancel{background:var(--nb-page);color:var(--nb-secondary)}.submit{background:var(--nb-action);color: var(--text-inverse)}
.price{color:var(--nb-money);font-variant-numeric:tabular-nums}
