page{background:#faf8f9;color:#382a31}.page{min-height:100vh;padding: var(--space-md) 28rpx 48rpx;box-sizing:border-box}.state{display:flex;min-height:420rpx;flex-direction:column;align-items:center;justify-content:center;color:#796872;font-size: var(--font-sm);text-align:center}.state-title{color:#382a31;font-size: var(--font-md);font-weight: var(--weight-bold)}.state-copy{margin-top:12rpx}.retry{display:flex;min-height:88rpx;margin-top:20rpx;padding:0 38rpx;align-items:center;border-radius: var(--radius-xl);background: var(--bg-tag);color:#a34f75}.list{display:flex;flex-direction:column;gap:20rpx}.card{padding:26rpx;border:1rpx solid #eee4e9;border-radius: var(--radius-md);background: var(--bg-card)}.card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}.title,.meta{display:block}.title{font-size: var(--font-md);font-weight: var(--weight-bold)}.meta{margin-top:8rpx;color:#806d77;font-size: var(--font-xs)}.status{padding:8rpx 16rpx;border-radius: var(--card-radius);background:#fff1f5;color:#a34f75;font-size: var(--font-xs)}.description{display:block;margin-top:18rpx;color:#695761;font-size: var(--font-sm);line-height:1.6}.photos{margin-top:18rpx;white-space:nowrap}.photo-row{display:inline-flex;gap:12rpx}.photo{width:170rpx;height:170rpx;border-radius: var(--radius-sm);background:#f2eaee}.quote-summary{display:flex;margin-top:20rpx;align-items:center;justify-content:space-between;color:#725f68;font-size: var(--font-xs)}.price{color:#b34e7d;font-size: var(--font-md);font-weight: var(--weight-bold)}.quote-btn{display:flex;min-height:88rpx;margin-top:20rpx;align-items:center;justify-content:center;border-radius: var(--radius-xl);background:linear-gradient(100deg,#d65f94,#9e62cc);color: var(--text-inverse);font-size: var(--font-sm);font-weight: var(--weight-bold)}.mask{position:fixed;z-index:100;inset:0;display:flex;align-items:flex-end;background:rgba(0,0,0,.48)}.sheet{width:100%;padding:30rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));border-radius:30rpx 30rpx 0 0;background: var(--bg-card);box-sizing:border-box}.sheet-title{display:block;font-size: var(--font-lg);font-weight: var(--weight-bold)}.label{display:block;margin:24rpx 0 10rpx;color:#695761;font-size: var(--font-sm)}.input,.textarea{width:100%;padding:0 22rpx;border:1rpx solid #eadde3;border-radius: var(--radius-sm);background:#faf7f8;box-sizing:border-box}.input{height:88rpx}.textarea{height:150rpx;padding-top:20rpx}.sheet-actions{display:flex;gap:14rpx;margin-top:26rpx}.cancel,.submit{display:flex;min-height:88rpx;flex:1;align-items:center;justify-content:center;border-radius: var(--radius-xl);font-size: var(--font-sm);font-weight: var(--weight-bold)}.cancel{background:#f3eef0;color:#705d66}.submit{background:#b65380;color: var(--text-inverse)}
