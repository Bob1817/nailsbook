<nav-bar title="行程"/>
<view class="page">
  <!-- ===== 固定头部 ===== -->
  <view class="head">
    <!-- 日期条：今天固定 + 未来滚动 + 更多 -->
    <view class="date-strip">
      <view
        class="date-cell today-cell {{activeIsToday ? 'date-cell-active' : ''}}"
        bindtap="resetToday"
      >
        <view class="date-week-row"><text class="date-week">今天</text><view class="date-statuses"><view wx:for="{{todayIncome.statuses}}" wx:for-item="status" wx:key="tone" class="date-status-dot status-{{status.tone}}" aria-label="{{status.label}}"></view></view></view>
        <text class="date-day">{{todayDay}}</text>
        <text wx:if="{{todayIncome.text}}" class="date-income {{todayIncome.type === 'actual' ? 'date-income-actual' : 'date-income-estimated'}}">{{todayIncome.text}}</text>
      </view>
      <scroll-view scroll-x class="date-scroll" enhanced show-scrollbar="{{false}}">
        <view class="date-scroll-inner">
          <view
            wx:for="{{dateStrip}}"
            wx:key="key"
            class="date-cell {{activeKey === item.key ? 'date-cell-active' : ''}}"
            bindtap="onPickDate"
            data-key="{{item.key}}"
          >
            <view class="date-week-row"><text class="date-week">周{{item.week}}</text><view class="date-statuses"><view wx:for="{{item.income.statuses}}" wx:for-item="status" wx:key="tone" class="date-status-dot status-{{status.tone}}" aria-label="{{status.label}}"></view></view></view>
        <text class="date-day">{{item.day}}</text>
            <text wx:if="{{item.income.text}}" class="date-income {{item.income.type === 'actual' ? 'date-income-actual' : 'date-income-estimated'}}">{{item.income.text}}</text>
          </view>
        </view>
      </scroll-view>
      <view class="more-btn" bindtap="openCalendar">
        <text class="more-text semantic-link">更多</text>
      </view>
    </view>

    <!-- tab -->
    <view class="tabs">
      <view class="tabs-left">
        <view
          class="tab {{scheduleTab === 'trips' ? 'tab-active' : ''}}"
          bindtap="onTabChange"
          data-tab="trips"
        >
          <text>今日行程</text>
          <view wx:if="{{scheduleTab === 'trips'}}" class="tab-line"></view>
        </view>
        <view
          class="tab {{scheduleTab === 'all' ? 'tab-active' : ''}}"
          bindtap="onTabChange"
          data-tab="all"
        >
          <text>当日预约</text>
          <view wx:if="{{scheduleTab === 'all'}}" class="tab-line"></view>
        </view>
      </view>
      <view class="tab-more-wrap">
        <view class="tab-more-btn" bindtap="toggleMoreMenu">
          <text class="tab-more-text semantic-link">更多</text>
          <view class="tab-more-arrow {{showMoreMenu ? 'tab-more-arrow-up' : ''}}"></view>
        </view>
        <view wx:if="{{showMoreMenu}}" class="tab-more-dropdown">
          <view class="tab-more-item" bindtap="goAllItineraries">
            <text>全部行程</text>
          </view>
          <view class="tab-more-item" bindtap="goAllBookings">
            <text>全部预约</text>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{showMoreMenu}}" class="tab-more-mask" bindtap="toggleMoreMenu"></view>
  </view>

  <!-- ===== 可滚动列表 ===== -->
  <scroll-view
    scroll-y
    class="list-scroll"
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="list-area">
      <view wx:if="{{bookingDayReady && activeKey >= todayKey}}"
        class="booking-day-control {{dayAccepting ? '' : 'booking-day-control-paused'}} {{daySaving ? 'booking-day-control-saving' : ''}}"
        bindtap="toggleBookingDay" hover-class="booking-day-pressed" role="switch"
        aria-checked="{{dayAccepting}}" aria-label="{{activeLabel}}当日接单，当前{{dayAccepting ? '已开放' : '已关闭'}}">
        <view class="booking-day-icon-wrap"><image class="booking-day-icon" src="/static/icons/calendar.svg" mode="aspectFit" /></view>
        <view class="booking-day-copy">
          <view class="booking-day-title-row">
            <text class="booking-day-title">当日接单</text>
            <text class="booking-day-status">{{dayAccepting ? '已开放' : '已关闭'}}</text>
          </view>
          <text class="booking-day-description">{{daySaving ? '正在更新设置…' : (dayAccepting ? activeLabel + '，客户可提交新的预约申请' : activeLabel + '，暂停接收新的预约申请')}}</text>
        </view>
        <view class="booking-day-switch {{dayAccepting ? 'booking-day-switch-on' : ''}}">
          <view class="booking-day-switch-knob"></view>
        </view>
      </view>
      <view wx:if="{{taskFilter === 'pending'}}" class="conflict-alert">待处理预约：点击卡片进入预约详情完成报价或确认排期。</view>
      <view wx:if="{{summary.conflicts}}" class="conflict-alert">检测到 {{summary.conflicts}} 个时间重叠的预约，请逐一核对并调整。</view>
      <view wx:if="{{loading}}" class="skeleton-list">
        <view wx:for="{{[1,2]}}" wx:key="*this" class="skel-card"></view>
      </view>

      <view wx:elif="{{listOrders.length === 0}}" class="empty-card">
        <text class="empty-title">{{taskFilter === 'pending' ? '暂无待处理预约' : (scheduleTab === 'trips' ? '当日暂无行程' : '当日暂无预约')}}</text>
        <text class="empty-sub">{{taskFilter === 'pending' ? '需要报价或确认排期的预约会显示在这里' : (scheduleTab === 'trips' ? '已确认排期的预约会显示在这里' : '换个日期看看')}}</text>
      </view>

      <view wx:else class="trip-list">
        <technician-booking-card
          wx:for="{{listOrders}}"
          wx:key="id"
          order="{{item}}"
          variant="schedule"
          bind:open="onBookingCardOpen"
          bind:quote="onBookingCardQuote"
          bind:withdrawquote="onBookingCardWithdrawQuote"
          bind:editbooking="onBookingCardEditBooking"
          bind:reject="onBookingCardReject"
          bind:cancel="onBookingCardCancel"
          bind:complete="onBookingCardComplete"
          bind:confirmed="onBookingCardConfirmed"
          bind:rebook="onBookingCardRebook"
          bind:record="onBookingCardRecord"
          bind:uploadwork="onBookingCardUploadWork"
          bind:viewwork="onBookingCardViewWork"
        />
      </view>
    </view>
  </scroll-view>
</view>

<!-- 日历弹窗 -->
<view wx:if="{{showCalendar}}" class="calendar-overlay" bindtap="closeCalendar">
  <view class="calendar-panel" catchtap="noop">
    <view class="calendar-header">
      <view class="calendar-legend"><text class="legend-actual">实际收入</text><text class="legend-estimated">预计收入</text><text class="legend-cancelled">取消</text><text class="legend-refunded">退款</text></view>
      <view class="calendar-close-icon" bindtap="closeCalendar" role="button" aria-label="关闭"><image class="calendar-close-svg" src="/static/icons/close.svg" mode="aspectFit" /></view>
    </view>

    <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="calendar-scroll" scroll-into-view="{{calendarScrollTarget}}" scroll-with-animation>
      <view wx:for="{{calendarYears}}" wx:for-index="yearIndex" wx:key="year" class="calendar-year">
        <view class="year-header" bindtap="toggleCalendarYear" data-year-index="{{yearIndex}}" role="button" aria-expanded="{{item.expanded}}" aria-label="{{item.year}}年排期与收入，点击{{item.expanded ? '收起' : '展开'}}">
          <view class="year-header-left">
            <text class="year-title">{{item.year}}年</text>
            <view class="year-disclosure {{item.expanded ? 'year-disclosure-open' : ''}}"></view>
          </view>
          <view class="period-totals">
            <text wx:if="{{item.totals.actualText}}" class="total-actual"><text class="total-tag-label">实收</text>{{item.totals.actualText}}</text>
            <text wx:if="{{item.totals.estimatedText}}" class="total-estimated"><text class="total-tag-label">预估</text>{{item.totals.estimatedText}}</text>
          </view>
        </view>
        <block wx:if="{{item.expanded}}">
        <view wx:for="{{item.months}}" wx:for-item="month" wx:for-index="monthIndex" wx:key="id" id="{{month.id}}" class="calendar-month {{month.expanded ? 'calendar-month-expanded' : 'calendar-month-collapsed'}}">
          <view class="month-header" bindtap="toggleCalendarMonth" data-year-index="{{yearIndex}}" data-month-index="{{monthIndex}}" role="button" aria-expanded="{{month.expanded}}" aria-label="{{month.month}}月排期与收入，点击{{month.expanded ? '收起' : '展开'}}">
            <view class="month-header-left">
              <text class="month-title">{{month.month}}月</text>
              <text wx:if="{{month.expanded}}" class="month-active-badge">展开中</text>
            </view>
            <view class="month-header-right">
              <view wx:if="{{month.totals.actualText || month.totals.estimatedText}}" class="period-totals">
                <text wx:if="{{month.totals.actualText}}" class="total-actual"><text class="total-tag-label">实收</text>{{month.totals.actualText}}</text>
                <text wx:if="{{month.totals.estimatedText}}" class="total-estimated"><text class="total-tag-label">预估</text>{{month.totals.estimatedText}}</text>
              </view>
              <text wx:else class="month-empty-text">暂无排期</text>
              <view class="month-disclosure {{month.expanded ? 'month-disclosure-open' : ''}}"></view>
            </view>
          </view>
          <block wx:if="{{month.expanded}}">
          <view class="calendar-month-body">
            <view class="calendar-weekdays"><text wx:for="{{weekdays}}" wx:key="*this" class="calendar-weekday">{{item}}</text></view>
            <view class="calendar-days">
              <view wx:for="{{month.days}}" wx:for-item="day" wx:key="key" class="calendar-day {{day.empty ? 'calendar-day-empty' : ''}} {{day.isToday ? 'calendar-today' : ''}} {{day.isSelected ? 'calendar-selected' : ''}} {{day.isBeforeRegistration ? 'calendar-before-registration' : ''}}" bindtap="onCalendarDayTap" data-date="{{day.date}}">
                <block wx:if="{{!day.empty}}">
                  <view class="date-number-row"><text class="calendar-day-num">{{day.day}}</text><view class="date-statuses"><view wx:for="{{day.income.statuses}}" wx:for-item="status" wx:key="tone" class="date-status-dot status-{{status.tone}}" aria-label="{{status.label}}"></view></view></view>
                  <text wx:if="{{day.income.text}}" class="calendar-income {{day.income.type === 'actual' ? 'calendar-income-actual' : 'calendar-income-estimated'}}">{{day.income.text}}</text>
                </block>
              </view>
            </view>
          </view>
          </block>
        </view>
        </block>
      </view>
      <view class="calendar-bottom-space"></view>
    </scroll-view>
  </view>
</view>

<tab-bar wx:if="{{!showCalendar}}" selected="orders" id="tabBar" placeholder="{{false}}" />
