page {
  background: var(--nb-page);
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== 固定头部 ===== */
.head {
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.78);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  backdrop-filter: blur(20px) saturate(180%);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  padding: var(--space-md) var(--space-xl) 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 日期条 */
.date-strip {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: stretch;
  gap: 12rpx;
}
.date-scroll { flex: 1; min-width: 0; white-space: nowrap; }
.date-scroll-inner { display: inline-flex; gap: 12rpx; }

.more-btn {
  flex-shrink: 0;
  width: 96rpx;
  min-width: 96rpx;
  height: 126rpx;
  min-height: 126rpx;
  padding: 0;
  border-radius: var(--radius-lg);
  background: var(--nb-page);
  border: 1rpx solid var(--nb-line);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}
.more-btn:active { background: var(--nb-pressed); }
.more-text { font-size: var(--font-sm); color: var(--nb-muted); font-weight: var(--weight-medium); }

.date-cell {
  flex-shrink: 0;
  width: 96rpx;
  padding: 14rpx 0;
  border-radius: var(--radius-lg);
  background: var(--nb-page);
  border: 1rpx solid var(--nb-line);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  position: relative;
  min-height: 126rpx;
  box-sizing: border-box;
}
.today-cell { flex-shrink: 0; }
.date-week { font-size: var(--font-xs); color: var(--nb-muted); }
.date-day { font-size: var(--font-md); font-weight: var(--weight-bold); color: var(--nb-ink); }
.date-cell-active {
  background: var(--nb-action);
  border-color: var(--nb-action);
}
.date-cell-active .date-week,
.date-cell-active .date-day { color: var(--nb-inverse); }
.date-income { max-width: 88rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--font-xs); line-height: var(--leading-tight); font-weight: var(--weight-semibold); }
.date-income-estimated { color: var(--nb-money); }
.date-income-actual { color: var(--nb-money); }
.date-cell-active .date-income-estimated { color:var(--nb-inverse); }
.date-cell-active .date-income-actual { color:var(--nb-inverse); }



/* ===== tab ===== */
.tabs {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx;
}
.tabs-left {
  display: flex;
  gap: var(--space-xl);
}
.tab {
  position: relative;
  padding: var(--space-sm) 4rpx;
  font-size: var(--font-md);
  color: var(--text-muted);
  font-weight: var(--weight-medium);
  min-height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  line-height: 1.4;
  transition: color 0.15s ease;
}
.tab-active {
  color: var(--text-primary);
  font-weight: var(--weight-semibold);
}
.tab-line {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 8rpx;
  width: 28rpx;
  height: 2rpx;
  border-radius: 1rpx;
  background: var(--nb-secondary);
}

/* ===== 更多下拉菜单 ===== */
.tab-more-wrap {
  position: relative;
  z-index: 10;
  flex-shrink: 0;
}
.tab-more-btn {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  padding: 10rpx var(--space-md);
  border-radius: var(--radius-md);
  background: rgba(0, 0, 0, 0.08) /* brand-primary-alpha */;
  min-height: 88rpx;
  box-sizing: border-box;
  line-height: 1.4;
}
.tab-more-btn:active { background: rgba(0, 0, 0, 0.16) /* brand-primary-alpha */; }
.tab-more-text {
  font-size: var(--font-sm);
  color: var(--nb-text-link);
  font-weight: var(--weight-medium);
}
.tab-more-arrow {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid var(--brand-primary);
  border-bottom: 3rpx solid var(--brand-primary);
  transform: rotate(45deg);
  margin-top: -4rpx;
  transition: transform 0.2s ease;
}
.tab-more-arrow-up {
  transform: rotate(-135deg);
  margin-top: 4rpx;
}
.tab-more-dropdown {
  position: absolute;
  top: calc(100% + 8rpx);
  right: 0;
  background: var(--bg-card);
  border-radius: var(--radius-sm);
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.12);
  min-width: 220rpx;
  overflow: hidden;
  z-index: 20;
}
.tab-more-item {
  padding: var(--space-md) var(--space-lg);
  font-size: var(--font-md);
  color: var(--text-primary);
  white-space: nowrap;
}
.tab-more-item:active { background: var(--bg-page); }
.tab-more-item + .tab-more-item {
  border-top: 0;
}
.tab-more-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9;
}

/* ===== 可滚动列表 ===== */
.list-scroll {
  flex: 1;
  min-height: 0;
}

.list-area {
  padding: var(--space-sm) var(--space-lg) calc(140rpx + env(safe-area-inset-bottom));
}
.conflict-alert { margin-bottom: var(--space-sm); padding:20rpx var(--space-md); border: 0; border-radius: var(--radius-sm); background:var(--nb-page); color:var(--nb-ink); font-size: var(--font-xs); line-height:1.55; }

.skeleton-list { display: flex; flex-direction: column; gap: var(--space-sm); }
.skel-card {
  height: 200rpx;
  border-radius: var(--card-radius);
  background: var(--bg-input);
  animation: skel 1.4s linear infinite;
}
@keyframes skel { 0%{opacity:1;} 50%{opacity:0.5;} 100%{opacity:1;} }

.empty-card {
  margin: 80rpx 0;
  padding: 60rpx var(--space-xl);
  background: var(--bg-card);
  border-radius: var(--card-radius);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  border: 0;
  box-shadow: var(--shadow-lg);
}
.empty-title { font-size: var(--font-md); font-weight: var(--weight-semibold); color: var(--text-primary); }
.empty-sub { font-size: var(--font-sm); color: var(--text-muted); text-align: center; }

/* ===== 行程卡 ===== */
.trip-list { display: flex; flex-direction: column; gap: var(--space-sm); }

/* ===== 日历弹窗 ===== */
.calendar-overlay {
  position: fixed;
  inset: 0;
  z-index: 1200;
  background: rgba(0, 0, 0, 0.42);
  display: flex;
  align-items: flex-end;
}

.calendar-panel {
  width: 100%;
  height: 88vh;
  background: var(--nb-page);
  border-radius: 36rpx 36rpx 0 0;
  box-shadow: 0 -20rpx 64rpx rgba(0, 0, 0, 0.16);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx var(--space-lg) 18rpx;
  flex-shrink: 0;
  background: var(--nb-surface);
  border-bottom: 1rpx solid var(--nb-line);
}
.calendar-close-icon {
  width: 72rpx;
  height: 72rpx;
  min-width: 44px;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--nb-page);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  flex-shrink: 0;
}
.calendar-close-svg {
  width: 24rpx;
  height: 24rpx;
}
.calendar-close-icon:active {
  background: var(--nb-pressed);
}
.calendar-legend {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0;
  border: 0;
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
  color: var(--nb-secondary);
}
.calendar-legend text {
  display: inline-flex;
  align-items: center;
}
.calendar-legend text::before {
  content: '';
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  margin-right: 6rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.legend-actual { color: var(--nb-ink); }
.legend-actual::before { background: var(--nb-success); }
.legend-estimated { color: var(--nb-ink); }
.legend-estimated::before { background: var(--nb-text-link); }
.legend-cancelled { color: var(--nb-secondary); }
.legend-cancelled::before { background: var(--nb-muted); }
.legend-refunded { color: var(--nb-secondary); }
.legend-refunded::before { background: var(--nb-danger); }

.calendar-scroll {
  flex: 1;
  min-height: 0;
  background: var(--nb-page);
}
.calendar-year {
  padding: 0 var(--space-lg);
  margin-bottom: var(--space-sm);
}

/* ===== 年份栏（吸顶、简洁层次） ===== */
.year-header {
  position: sticky;
  top: 0;
  z-index: 3;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 16rpx 0 16rpx;
  background: rgba(245, 245, 247, 0.95);
  backdrop-filter: blur(20rpx);
}
.year-header-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.year-title {
  font-size: 34rpx;
  font-weight: var(--weight-bold);
  color: var(--nb-ink);
}
.year-disclosure {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--nb-muted);
  border-right: 3rpx solid var(--nb-muted);
  transform: rotate(45deg);
  transition: transform 0.2s ease;
  flex-shrink: 0;
}
.year-disclosure-open {
  transform: rotate(135deg);
  border-color: var(--nb-ink);
}

/* ===== 收入汇总胶囊 ===== */
.period-totals {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  min-width: 0;
}
.period-totals text {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: var(--weight-semibold);
  font-variant-numeric: tabular-nums;
  box-sizing: border-box;
}
.total-tag-label {
  font-size: 20rpx;
  font-weight: var(--weight-normal);
  margin-right: 4rpx;
  opacity: 0.85;
}
.total-actual {
  color: var(--nb-success);
  background: var(--nb-success-surface);
  border: 1rpx solid rgba(40, 122, 75, 0.15);
}
.total-estimated {
  color: var(--nb-text-link);
  background: var(--nb-soft-surface);
  border: 1rpx solid rgba(36, 94, 168, 0.15);
}

/* ===== 月份卡片结构 ===== */
.calendar-month {
  scroll-margin-top: 88rpx;
  box-sizing: border-box;
  transition: all 0.2s ease-in-out;
}

/* 收起状态的月份卡片（紧凑实体卡片，告别空旷） */
.calendar-month-collapsed {
  background: var(--nb-surface);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  border-radius: var(--radius-lg);
  margin-bottom: 14rpx;
  padding: 0 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}
.calendar-month-collapsed:active {
  background: var(--nb-pressed);
  transform: scale(0.99);
}
.calendar-month-collapsed .month-header {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

/* 展开状态的月份卡片（独立凸起日历模块，层级清晰） */
.calendar-month-expanded {
  background: var(--nb-surface);
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  border-radius: var(--radius-xl);
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 24rpx;
  padding: 0 16rpx 20rpx;
}
.calendar-month-expanded .month-header {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 8rpx 18rpx;
  border-bottom: 1rpx solid var(--nb-line);
  margin-bottom: 8rpx;
}

/* 月份头部左右布局 */
.month-header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.month-title {
  font-size: 30rpx;
  font-weight: var(--weight-bold);
  color: var(--nb-ink);
}
.month-active-badge {
  font-size: 20rpx;
  font-weight: var(--weight-medium);
  color: var(--nb-text-link);
  background: var(--nb-soft-surface);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-full);
  line-height: 1.4;
}
.month-header-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.month-empty-text {
  font-size: 24rpx;
  color: var(--nb-muted);
  font-weight: var(--weight-normal);
}
.month-disclosure {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--nb-muted);
  border-right: 3rpx solid var(--nb-muted);
  transform: rotate(45deg); /* › */
  transition: transform 0.2s ease, border-color 0.15s ease;
  flex-shrink: 0;
  margin-left: 6rpx;
}
.month-disclosure-open {
  transform: rotate(135deg); /* ⌄ */
  border-color: var(--nb-ink);
}

.calendar-month-body {
  width: 100%;
}

.calendar-weekdays {
  display: flex;
  margin: 12rpx 0 var(--space-xs);
}

.calendar-weekday {
  flex: 1;
  text-align: center;
  font-size: var(--font-xs);
  color: var(--nb-muted);
  font-weight: var(--weight-semibold);
}

.calendar-days {
  display: flex;
  flex-wrap: wrap;
}

.calendar-day {
  width: calc(100% / 7);
  height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  position: relative;
  border-radius: var(--card-radius);
  box-sizing: border-box;
}
.calendar-day-empty { pointer-events:none; }
.calendar-before-registration { opacity:.28; pointer-events:none; }

.calendar-day-num {
  font-size: var(--font-md);
  color: var(--text-primary);
  font-weight: var(--weight-medium);
}

.calendar-today .calendar-day-num {
  color: var(--brand-primary);
  font-weight: var(--weight-bold);
}

.calendar-selected {
  background: var(--nb-action);
}

.calendar-selected .calendar-day-num {
  color: var(--text-inverse);
  font-weight: var(--weight-bold);
}
.calendar-income { max-width:76rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size: var(--font-xs); line-height:1.2; font-weight: var(--weight-semibold); }
.calendar-income-estimated { color:var(--nb-money); }
.calendar-income-actual { color:var(--nb-money); }
.calendar-selected .calendar-income-estimated { color:var(--nb-inverse); }
.calendar-selected .calendar-income-actual { color:var(--nb-inverse); }


.calendar-bottom-space { height:calc(40rpx + env(safe-area-inset-bottom)); }

/* Text navigation has no decorative pill. Keep existing hit-area sizing. */
.more-btn, .more-text, .tab-more-btn, .tab-more-text { color: var(--nb-text-link, #245EA8); background: transparent; border-color: transparent; box-shadow: none; }
.more-btn:active, .more-text:active, .tab-more-btn:active, .tab-more-text:active { background: transparent; opacity: .7; }

/* 顶部状态点跟随星期，完整月历跟随日期；不占用金额空间。 */
.date-week-row, .date-number-row { position:relative; display:flex; align-items:center; justify-content:center; }
.date-statuses { position:absolute; left:100%; margin-left:5rpx; display:flex; flex-direction:column; gap:3rpx; }
.date-status-dot { width:6rpx; height:6rpx; border-radius:50%; flex-shrink:0; border:0; box-shadow:none; }
.status-income { background:var(--nb-success); }
.status-cancelled { background:var(--nb-muted); }
.status-refunded { background:var(--nb-danger); }

.legend-actual::before { background: var(--nb-success); }
.legend-estimated::before { background: var(--nb-text-link); }
.legend-cancelled::before { background: var(--nb-muted); }
.legend-refunded::before { background: var(--nb-danger); }

.booking-day-control {
  min-height: 120rpx; box-sizing: border-box; display: flex; align-items: center; gap: 20rpx;
  padding: 20rpx 22rpx; margin-bottom: var(--space-sm); border-radius: var(--radius-lg);
  background: var(--nb-surface);
}
.booking-day-control-paused { background: var(--nb-soft-surface); }
.booking-day-control-saving { opacity: .65; }
.booking-day-pressed { background: var(--nb-pressed); }
.booking-day-icon-wrap {
  width: 64rpx; height: 64rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center;
  border-radius: 18rpx; background: var(--nb-soft-surface);
}
.booking-day-control-paused .booking-day-icon-wrap { background: var(--nb-surface); }
.booking-day-icon { width: 30rpx; height: 30rpx; }
.booking-day-copy { flex: 1; min-width: 0; }
.booking-day-title-row { display: flex; align-items: center; gap: 12rpx; }
.booking-day-title { color: var(--nb-ink); font-size: var(--font-sm); font-weight: var(--weight-semibold); }
.booking-day-status {
  padding: 3rpx 10rpx; border-radius: var(--radius-full); background: var(--nb-success-surface);
  color: var(--nb-success); font-size: var(--font-xs); font-weight: var(--weight-medium); line-height: 1.4;
}
.booking-day-control-paused .booking-day-status { background: var(--nb-surface); color: var(--nb-muted); }
.booking-day-description { display: block; margin-top: 6rpx; color: var(--nb-muted); font-size: var(--font-xs); line-height: 1.45; }
.booking-day-switch {
  position: relative; width: 76rpx; height: 44rpx; flex-shrink: 0; border-radius: var(--radius-full);
  background: var(--nb-control); transition: background .18s ease;
}
.booking-day-switch-on { background: var(--nb-success); }
.booking-day-switch-knob {
  position: absolute; top: 6rpx; left: 6rpx; width: 32rpx; height: 32rpx;
  border-radius: 50%; background: var(--nb-surface); transition: transform .18s ease;
}
.booking-day-switch-on .booking-day-switch-knob { transform: translateX(32rpx); }
.total-actual, .total-estimated { font-variant-numeric: tabular-nums; }
