page {
  background: var(--bg-gradient-entry);
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== 固定头部 ===== */
.head {
  flex-shrink: 0;
  background: var(--bg-card);
  padding: var(--space-md) 40rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 日期条 */
.date-strip {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: stretch;
  gap: 12rpx;
}
.date-scroll { flex: 1; min-width: 0; white-space: nowrap; }
.date-scroll-inner { display: inline-flex; gap: 12rpx; }

.more-btn {
  flex-shrink: 0;
  width: 96rpx;
  min-width: 96rpx;
  padding: 14rpx 0;
  border-radius: var(--card-radius);
  background: var(--bg-input);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}
.more-btn:active { background: var(--bg-input); }
.more-text { font-size: var(--font-sm); color: var(--text-muted); font-weight: var(--weight-medium); }

.date-cell {
  flex-shrink: 0;
  width: 96rpx;
  padding: 14rpx 0;
  border-radius: var(--card-radius);
  background: var(--bg-input);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  position: relative;
  min-height: 126rpx;
  box-sizing: border-box;
}
.today-cell { flex-shrink: 0; }
.date-week { font-size: var(--font-xs); color: var(--text-muted); }
.date-day { font-size: var(--font-md); font-weight: var(--weight-bold); color: var(--text-primary); }
.date-cell-active {
  background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-primary-light) 100%);
}
.date-cell-active .date-week,
.date-cell-active .date-day { color: var(--text-inverse); }
.date-income { max-width:88rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size: var(--font-xs); line-height: var(--leading-tight); font-weight: var(--weight-semibold); }
.date-income-estimated { color:#a85578; }
.date-income-actual { color:#4f7f68; }
.date-cell-active .date-income-estimated { color:#fff0a8; }
.date-cell-active .date-income-actual { color:#baf5d0; }

.date-dot {
  position: absolute;
  bottom: 5rpx;
  width: 8rpx; height: 8rpx;
  border-radius: 50%;
  background: var(--brand-gradient);
}
.date-dot.dot-light { background: rgba(255, 255, 255, 0.8); }

/* ===== tab ===== */
.tabs {
  margin-top: 20rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 4rpx;
}
.tabs-left {
  display: flex;
  gap: 40rpx;
}
.tab {
  position: relative;
  padding: 16rpx 0;
  font-size: var(--font-md);
  color: var(--text-muted);
  font-weight: var(--weight-medium);
  min-height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}
.tab-active { color: var(--text-primary); font-weight: var(--weight-semibold); }
.tab-line {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--brand-primary);
}

/* ===== 更多下拉菜单 ===== */
.tab-more-wrap {
  position: relative;
  z-index: 10;
  flex-shrink: 0;
}
.tab-more-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 24rpx;
  border-radius: var(--radius-md);
  background: rgba(255,107,138,0.08) /* brand-primary-alpha */;
  margin-bottom: 8rpx;
}
.tab-more-btn:active { background: rgba(255,107,138,0.16) /* brand-primary-alpha */; }
.tab-more-text {
  font-size: var(--font-sm);
  color: var(--brand-primary);
  font-weight: var(--weight-medium);
}
.tab-more-arrow {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid var(--brand-primary);
  border-bottom: 3rpx solid var(--brand-primary);
  transform: rotate(45deg);
  margin-top: -4rpx;
  transition: transform 0.2s ease;
}
.tab-more-arrow-up {
  transform: rotate(-135deg);
  margin-top: 4rpx;
}
.tab-more-dropdown {
  position: absolute;
  top: calc(100% + 8rpx);
  right: 0;
  background: var(--bg-card);
  border-radius: var(--radius-sm);
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.12);
  min-width: 220rpx;
  overflow: hidden;
  z-index: 20;
}
.tab-more-item {
  padding: var(--space-md) 32rpx;
  font-size: var(--font-md);
  color: var(--text-primary);
  white-space: nowrap;
}
.tab-more-item:active { background: var(--bg-page); }
.tab-more-item + .tab-more-item {
  border-top: 1rpx solid #f0f0f0;
}
.tab-more-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9;
}

/* ===== 可滚动列表 ===== */
.list-scroll {
  flex: 1;
  min-height: 0;
}

.list-area {
  padding: 16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}
.conflict-alert { margin-bottom: var(--space-sm); padding:20rpx 24rpx; border:1rpx solid #f3c4c9; border-radius: var(--radius-sm); background:#fff3f4; color:#a93f4b; font-size: var(--font-xs); line-height:1.55; }

.skeleton-list { display: flex; flex-direction: column; gap: 16rpx; }
.skel-card {
  height: 200rpx;
  border-radius: var(--card-radius);
  background: var(--bg-input);
  animation: skel 1.4s linear infinite;
}
@keyframes skel { 0%{opacity:1;} 50%{opacity:0.5;} 100%{opacity:1;} }

.empty-card {
  margin: 80rpx 0;
  padding: 60rpx 40rpx;
  background: var(--bg-card);
  border-radius: var(--card-radius);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  border: 2rpx solid rgba(255,107,138,0.08) /* brand-primary-alpha */;
  box-shadow: var(--shadow-lg);
}
.empty-title { font-size: var(--font-md); font-weight: var(--weight-semibold); color: var(--text-primary); }
.empty-sub { font-size: var(--font-sm); color: var(--text-muted); text-align: center; }

/* ===== 行程卡 ===== */
.trip-list { display: flex; flex-direction: column; gap: 16rpx; }
.trip-card {
  background: var(--bg-card);
  border-radius: var(--card-radius);
  padding: var(--space-md);
  border: 2rpx solid rgba(255,107,138,0.08) /* brand-primary-alpha */;
  box-shadow: var(--shadow-lg);
}
.trip-card:active { background: #fef7f9; }
.trip-conflict { margin-top:14rpx; padding:14rpx 18rpx; border-radius: var(--radius-xs); background:#fff0f1; color:#b13e4a; font-size: var(--font-xs); font-weight: var(--weight-semibold); }

.trip-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.trip-time {
  width: 88rpx;
  flex-shrink: 0;
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
}
.trip-avatar {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  background: var(--bg-page);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.trip-avatar-img { width: 100%; height: 100%; }
.trip-avatar-char { font-size: var(--font-sm); font-weight: var(--weight-semibold); color: var(--text-muted); }

.trip-info { flex: 1; min-width: 0; }
.trip-name { display: block; font-size: var(--font-md); font-weight: var(--weight-semibold); color: var(--text-primary); }
.trip-svc {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-xs);
  color: var(--text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.trip-status {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
}
.tone-orange  { background: #fff2dc; color: #c97f1a; }
.tone-purple  { background: #f0e9ff; color: #7c5dd4; }
.tone-yellow  { background: #fff8d6; color: #a48313; }
.tone-emerald { background: #e3f6ec; color: #067b4a; }
.tone-teal    { background: #d8f1ee; color: #107d70; }
.tone-sky     { background: #dbecff; color: #1f6dd6; }
.tone-gray    { background: #f4f5f7; color: #8a8f98; }
.tone-red     { background: #ffe5e6; color: #c5333d; }

.trip-addr {
  margin-top: var(--space-sm);
  padding: 12rpx 16rpx;
  background: var(--bg-input);
  border-radius: var(--radius-xs);
  font-size: var(--font-xs);
  line-height: var(--leading-normal);
  color: var(--text-muted);
}

.trip-actions {
  margin-top: var(--space-sm);
  display: flex;
  gap: 12rpx;
}
.trip-btn {
  flex: 1;
  min-height: 72rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
}
.trip-btn:active { opacity: 0.85; }
.trip-primary {
  background: var(--brand-gradient);
  color: var(--text-inverse);
}
.trip-ghost {
  background: var(--bg-card);
  color: var(--text-body);
  border: 2rpx solid rgba(255,107,138,0.15) /* brand-primary-alpha */;
}

/* ===== 日历弹窗 ===== */
.calendar-overlay {
  position: fixed;
  inset: 0;
  z-index: 1200;
  background: rgba(25, 20, 24, 0.42);
  display: flex;
  align-items: flex-end;
}

.calendar-panel {
  width: 100%;
  height: 88vh;
  background: var(--bg-card);
  border-radius: 36rpx 36rpx 0 0;
  box-shadow: 0 -20rpx 64rpx rgba(41, 25, 35, 0.16);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 32rpx 12rpx;
  flex-shrink: 0;
  border-bottom: 1rpx solid #f0e8ec;
}
.calendar-close-icon { width:88rpx; height:88rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; background:#f7f4f6; color:#6b5f66; font-size:42rpx; line-height:1; }
.calendar-close-icon:active { background:#eee8eb; }
.calendar-legend { display:flex; justify-content:flex-start; gap:20rpx; padding:0; border:0; font-size: var(--font-xs); font-weight: var(--weight-semibold); }
.calendar-legend text::before { content:''; display:inline-block; width:12rpx; height:12rpx; margin-right:8rpx; border-radius:50%; }
.legend-actual { color:#4f7f68; }.legend-actual::before { background:#6ca887; }
.legend-estimated { color:#a85578; }.legend-estimated::before { background:#d4779e; }
.calendar-scroll { flex:1; min-height:0; }
.calendar-year { padding:0 32rpx; }
.year-header { position:sticky; top:0; z-index:3; min-height:96rpx; display:flex; align-items:center; justify-content:space-between; gap:20rpx; background:rgba(255,255,255,.96); border-bottom:1rpx solid #eee6ea; }
.year-title { font-size: var(--font-lg); font-weight: var(--weight-bold); color: var(--text-primary); }
.period-title { min-height:88rpx; display:flex; align-items:center; gap:14rpx; }
.disclosure { width:14rpx; height:14rpx; border-right:3rpx solid #9a8f96; border-bottom:3rpx solid #9a8f96; transform:rotate(45deg); transition:transform .2s ease; }
.disclosure-open { transform:rotate(225deg); }
.disclosure-small { width:12rpx; height:12rpx; border-width:2rpx; }
.period-totals { display:flex; align-items:center; justify-content:flex-end; gap:12rpx; min-width:0; }
.period-totals text { padding:7rpx 12rpx; border-radius:999rpx; font-size: var(--font-xs); line-height:1.2; font-weight: var(--weight-bold); }
.total-actual { color:#47765f; background:#edf8f1; }
.total-estimated { color:#a54c72; background: var(--bg-tag); }
.calendar-month { scroll-margin-top:96rpx; padding:26rpx 0 34rpx; border-bottom:1rpx solid #f1eaed; }
.month-header { min-height:88rpx; display:flex; align-items:center; justify-content:space-between; gap:18rpx; }
.month-title { font-size: var(--font-md); font-weight: var(--weight-bold); color:#30272c; }

.calendar-weekdays {
  display: flex;
  margin: 12rpx 0 8rpx;
}

.calendar-weekday {
  flex: 1;
  text-align: center;
  font-size: var(--font-xs);
  color: #9a8f96;
  font-weight: var(--weight-semibold);
}

.calendar-days {
  display: flex;
  flex-wrap: wrap;
}

.calendar-day {
  width: calc(100% / 7);
  height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  position: relative;
  border-radius: var(--card-radius);
  box-sizing: border-box;
}
.calendar-day-empty { pointer-events:none; }
.calendar-before-registration { opacity:.28; pointer-events:none; }

.calendar-day-num {
  font-size: var(--font-md);
  color: var(--text-primary);
  font-weight: var(--weight-medium);
}

.calendar-today .calendar-day-num {
  color: var(--brand-primary);
  font-weight: var(--weight-bold);
}

.calendar-selected {
  background: linear-gradient(135deg, #ff6b8a 0%, #8b5cf6 100%);
}

.calendar-selected .calendar-day-num {
  color: var(--text-inverse);
  font-weight: var(--weight-bold);
}
.calendar-income { max-width:76rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size: var(--font-xs); line-height:1.2; font-weight: var(--weight-semibold); }
.calendar-income-estimated { color:#a85578; }
.calendar-income-actual { color:#4f7f68; }
.calendar-selected .calendar-income-estimated { color:#fff0a8; }
.calendar-selected .calendar-income-actual { color:#baf5d0; }

.calendar-selected .calendar-day-dot {
  background: var(--bg-card);
}

.calendar-day-dot {
  position:absolute;
  bottom:7rpx;
  width:7rpx;
  height:7rpx;
  border-radius: 50%;
  background: var(--brand-gradient);
}
.calendar-bottom-space { height:calc(40rpx + env(safe-area-inset-bottom)); }
