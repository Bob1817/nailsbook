page {
  background: linear-gradient(180deg, #fff8fb 0%, #ffffff 34%, #f8f9fc 100%);
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== 固定头部 ===== */
.head {
  flex-shrink: 0;
  background: #ffffff;
  padding: 24rpx 40rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 日期条 */
.date-strip {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: stretch;
  gap: 12rpx;
}
.date-scroll { flex: 1; min-width: 0; white-space: nowrap; }
.date-scroll-inner { display: inline-flex; gap: 12rpx; }

.more-btn {
  flex-shrink: 0;
  width: 96rpx;
  min-width: 96rpx;
  padding: 14rpx 0;
  border-radius: 18rpx;
  background: #f9fafb;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}
.more-btn:active { background: #f3f4f6; }
.more-text { font-size: 24rpx; color: #6b7280; font-weight: 500; }

.date-cell {
  flex-shrink: 0;
  width: 96rpx;
  padding: 14rpx 0;
  border-radius: 18rpx;
  background: #f9fafb;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  position: relative;
  min-height: 88rpx;
  box-sizing: border-box;
}
.today-cell { justify-content: center; flex-shrink: 0; }
.date-week { font-size: 22rpx; color: #6b7280; }
.date-day { font-size: 30rpx; font-weight: 700; color: #1f2937; }
.date-cell-active {
  background: linear-gradient(135deg, #ff6b8a 0%, #ff8fa3 100%);
}
.date-cell-active .date-week,
.date-cell-active .date-day { color: #fff; }

.date-dot {
  position: absolute;
  bottom: 8rpx;
  width: 8rpx; height: 8rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b8a, #8b5cf6);
}
.date-dot.dot-light { background: rgba(255, 255, 255, 0.8); }

/* ===== 汇总卡 ===== */
.summary-card {
  margin-top: 24rpx;
  display: flex;
  align-items: stretch;
  background: #ffffff;
  border-radius: 18rpx;
  padding: 28rpx 20rpx;
  border: 2rpx solid rgba(255, 107, 138, 0.08);
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.05);
}

.sum-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.sum-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1;
}

.sum-num-price {
  color: #ff6b8a;
}

.sum-unit {
  font-size: 24rpx;
  font-weight: 500;
  color: #6b7280;
  margin-left: 2rpx;
}

.sum-label {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 500;
}

.sum-divider {
  width: 2rpx;
  background: rgba(255, 107, 138, 0.08);
  flex-shrink: 0;
  margin: 4rpx 0;
}

/* ===== tab ===== */
.tabs {
  margin-top: 16rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 4rpx;
}
.tabs-left {
  display: flex;
  gap: 40rpx;
}
.tab {
  position: relative;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #6b7280;
  font-weight: 500;
  min-height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}
.tab-active { color: #1f2937; font-weight: 600; }
.tab-line {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 4rpx;
  border-radius: 2rpx;
  background: #ff6b8a;
}

/* ===== 更多下拉菜单 ===== */
.tab-more-wrap {
  position: relative;
  z-index: 10;
  flex-shrink: 0;
}
.tab-more-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255,107,138,0.08);
  margin-bottom: 8rpx;
}
.tab-more-btn:active { background: rgba(255,107,138,0.16); }
.tab-more-text {
  font-size: 24rpx;
  color: #ff6b8a;
  font-weight: 500;
}
.tab-more-arrow {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid #ff6b8a;
  border-bottom: 3rpx solid #ff6b8a;
  transform: rotate(45deg);
  margin-top: -4rpx;
  transition: transform 0.2s ease;
}
.tab-more-arrow-up {
  transform: rotate(-135deg);
  margin-top: 4rpx;
}
.tab-more-dropdown {
  position: absolute;
  top: calc(100% + 8rpx);
  right: 0;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.12);
  min-width: 220rpx;
  overflow: hidden;
  z-index: 20;
}
.tab-more-item {
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #1f2937;
  white-space: nowrap;
}
.tab-more-item:active { background: #f8f9fc; }
.tab-more-item + .tab-more-item {
  border-top: 1rpx solid #f0f0f0;
}
.tab-more-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9;
}

/* ===== 可滚动列表 ===== */
.list-scroll {
  flex: 1;
  min-height: 0;
}

.list-area {
  padding: 16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}
.conflict-alert { margin-bottom:16rpx; padding:20rpx 24rpx; border:1rpx solid #f3c4c9; border-radius:16rpx; background:#fff3f4; color:#a93f4b; font-size:22rpx; line-height:1.55; }

.skeleton-list { display: flex; flex-direction: column; gap: 16rpx; }
.skel-card {
  height: 200rpx;
  border-radius: 18rpx;
  background: #f3f4f6;
  animation: skel 1.4s linear infinite;
}
@keyframes skel { 0%{opacity:1;} 50%{opacity:0.5;} 100%{opacity:1;} }

.empty-card {
  margin: 80rpx 0;
  padding: 60rpx 40rpx;
  background: #fff;
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  border: 2rpx solid rgba(255, 107, 138, 0.08);
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.05);
}
.empty-title { font-size: 28rpx; font-weight: 600; color: #1f2937; }
.empty-sub { font-size: 24rpx; color: #6b7280; text-align: center; }

/* ===== 行程卡 ===== */
.trip-list { display: flex; flex-direction: column; gap: 16rpx; }
.trip-card {
  background: #fff;
  border-radius: 18rpx;
  padding: 24rpx;
  border: 2rpx solid rgba(255, 107, 138, 0.08);
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.05);
}
.trip-card:active { background: #fef7f9; }
.trip-conflict { margin-top:14rpx; padding:14rpx 18rpx; border-radius:12rpx; background:#fff0f1; color:#b13e4a; font-size:21rpx; font-weight:600; }

.trip-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.trip-time {
  width: 88rpx;
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}
.trip-avatar {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  background: #f7f7f7;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.trip-avatar-img { width: 100%; height: 100%; }
.trip-avatar-char { font-size: 26rpx; font-weight: 600; color: #6b7280; }

.trip-info { flex: 1; min-width: 0; }
.trip-name { display: block; font-size: 28rpx; font-weight: 600; color: #1f2937; }
.trip-svc {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6b7280;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.trip-status {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 500;
}
.tone-orange  { background: #fff2dc; color: #c97f1a; }
.tone-purple  { background: #f0e9ff; color: #7c5dd4; }
.tone-yellow  { background: #fff8d6; color: #a48313; }
.tone-emerald { background: #e3f6ec; color: #067b4a; }
.tone-teal    { background: #d8f1ee; color: #107d70; }
.tone-sky     { background: #dbecff; color: #1f6dd6; }
.tone-gray    { background: #f4f5f7; color: #8a8f98; }
.tone-red     { background: #ffe5e6; color: #c5333d; }

.trip-addr {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #6b7280;
}

.trip-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
}
.trip-btn {
  flex: 1;
  min-height: 72rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
}
.trip-btn:active { opacity: 0.85; }
.trip-primary {
  background: linear-gradient(135deg, #ff6b8a, #8b5cf6);
  color: #fff;
}
.trip-ghost {
  background: #fff;
  color: #374151;
  border: 2rpx solid rgba(255, 107, 138, 0.15);
}

/* ===== 日历弹窗 ===== */
.calendar-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
}

.calendar-panel {
  width: 100%;
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 32rpx 64rpx rgba(0, 0, 0, 0.15);
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.calendar-nav {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f9fafb;
  display: flex;
  align-items: center;
  justify-content: center;
}

.calendar-nav:active { background: #f3f4f6; }

.calendar-nav-icon {
  font-size: 36rpx;
  color: #374151;
  font-weight: 600;
}

.calendar-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.calendar-weekdays {
  display: flex;
  margin-bottom: 16rpx;
}

.calendar-weekday {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 500;
}

.calendar-days {
  display: flex;
  flex-wrap: wrap;
}

.calendar-day {
  width: calc(100% / 7);
  height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  position: relative;
}

.calendar-day-num {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
}

.calendar-other-month .calendar-day-num {
  color: #767b84;
}

.calendar-today .calendar-day-num {
  color: #ff6b8a;
  font-weight: 700;
}

.calendar-selected {
  background: linear-gradient(135deg, #ff6b8a 0%, #8b5cf6 100%);
  border-radius: 16rpx;
}

.calendar-selected .calendar-day-num {
  color: #fff;
  font-weight: 700;
}

.calendar-selected .calendar-day-dot {
  background: #fff;
}

.calendar-day-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b8a, #8b5cf6);
}

.calendar-close {
  margin-top: 24rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.calendar-close:active { background: #e5e7eb; }

.calendar-close-text {
  font-size: 28rpx;
  color: #374151;
  font-weight: 500;
}
