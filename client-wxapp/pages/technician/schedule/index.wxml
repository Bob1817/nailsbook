<view class="container">

  <!-- Week strip -->
  <view class="week-strip">
    <view
      class="day-cell {{item.date === selectedDate ? 'selected' : ''}}"
      wx:for="{{days}}"
      wx:key="date"
      bindtap="selectDay"
      data-date="{{item.date}}"
    >
      <text class="day-dow">{{item.dow}}</text>
      <text class="day-num">{{item.dayNum}}</text>
    </view>
  </view>

  <!-- Orders for selected day -->
  <view class="date-header">
    <text class="date-text">{{selectedDate}}</text>
    <text class="count-text">{{dayOrders.length}} 个预约</text>
  </view>

  <view wx:if="{{loading}}" class="empty">
    <text class="empty-text">正在加载预约…</text>
  </view>

  <view wx:elif="{{loadFailed}}" class="empty">
    <text class="empty-text">预约加载失败</text>
    <view class="retry-button booking-action" bindtap="retryLoad">重新加载</view>
  </view>

  <view wx:elif="{{dayOrders.length === 0}}" class="empty">
    <text class="empty-text">今天暂无预约</text>
  </view>

  <view wx:else class="order-list">
    <view
      class="order-card"
      wx:for="{{dayOrders}}"
      wx:key="id"
      bindtap="goOrderDetail"
      data-id="{{item.id}}"
    >
      <view class="order-time-col">
        <text class="order-time">{{item.timeStr}}</text>
      </view>
      <view class="order-body">
        <text class="order-client">{{item.customerName || '客户'}}</text>
        <text class="order-services">{{item.typeLabel}}</text>
        <text class="order-status {{item.statusTone}}">{{item.statusLabel}}</text>
      </view>
    </view>
  </view>

</view>
