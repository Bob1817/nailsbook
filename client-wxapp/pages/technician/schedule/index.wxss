.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.week-strip {
  display: flex;
  background: #fff;
  padding: 16rpx 0 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.day-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
  border-radius: 12rpx;
  margin: 0 4rpx;
  min-height: 88rpx;
  box-sizing: border-box;
}
.day-cell.selected {
  background: #ff6b9d;
}
.day-dow {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}
.day-cell.selected .day-dow { color: rgba(255,255,255,0.8); }
.day-num {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.day-cell.selected .day-num { color: #fff; }

.date-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 16rpx;
}
.date-text { font-size: 28rpx; font-weight: 600; color: #333; }
.count-text { font-size: 24rpx; color: #999; }

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}
.empty-text { font-size: 30rpx; color: #999; }
.retry-button {
  display: flex;
  min-height: 88rpx;
  margin-top: 24rpx;
  padding: 0 40rpx;
  align-items: center;
  border-radius: 44rpx;
  background: #fff0f5;
  color: #a34f75;
}

.order-list { padding: 0 16rpx; }

.order-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  padding: 28rpx 24rpx;
  align-items: center;
}

.order-time-col {
  width: 100rpx;
  flex-shrink: 0;
  text-align: center;
}
.order-time {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff6b9d;
}

.order-body {
  flex: 1;
  margin-left: 24rpx;
}
.order-client {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}
.order-services {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}
.order-status {
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  background: #f5f5f5;
  color: #999;
}
.order-status.tone-orange,
.order-status.tone-yellow { background: #fff7e6; color: #a45100; }
.order-status.tone-purple { background: #f5efff; color: #6f45a8; }
.order-status.tone-sky { background: #e8f6ff; color: #176ca4; }
.order-status.tone-emerald,
.order-status.tone-teal { background: #eaf8f1; color: #267558; }
.order-status.tone-gray { background: #f5f5f5; color: #696969; }
.order-status.tone-red { background: #fff0f0; color: #a53c3c; }
