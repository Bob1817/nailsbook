@import '../../../styles/booking-actions.wxss';

.container {
  min-height: 100vh;
  background: var(--bg-page);
}

.week-strip {
  display: flex;
  background: var(--bg-card);
  padding: 16rpx 0 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.day-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
  border-radius: var(--radius-xs);
  margin: 0 4rpx;
  min-height: 88rpx;
  box-sizing: border-box;
}
.day-cell.selected {
  background: var(--nb-action);
}
.day-dow {
  font-size: var(--font-xs);
  color: var(--text-faint);
  margin-bottom: 8rpx;
}
.day-cell.selected .day-dow { color: rgba(255,255,255,0.8); }
.day-num {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}
.day-cell.selected .day-num { color: var(--text-inverse); }

.date-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md) 32rpx 16rpx;
}
.date-text { font-size: var(--font-md); font-weight: var(--weight-semibold); color: var(--text-primary); }
.count-text { font-size: var(--font-sm); color: var(--text-faint); }

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}
.empty-text { font-size: var(--font-md); color: var(--text-faint); }
.retry-button {
  margin-top: var(--space-md);
  padding: 0 24rpx;
  min-width: 112px;
  background: var(--bg-tag);
  color: var(--nb-ink);
}

.order-list {
  padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
