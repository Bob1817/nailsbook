@import '../../../styles/booking-actions.wxss';

.container {
  min-height: 100vh;
  background: var(--bg-page);
}

.week-strip {
  display: flex;
  background: var(--bg-card);
  padding: 16rpx 0 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.day-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
  border-radius: var(--radius-xs);
  margin: 0 4rpx;
  min-height: 88rpx;
  box-sizing: border-box;
}
.day-cell.selected {
  background: var(--nb-action);
}
.day-dow {
  font-size: var(--font-xs);
  color: var(--text-faint);
  margin-bottom: 8rpx;
}
.day-cell.selected .day-dow { color: rgba(255,255,255,0.8); }
.day-num {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}
.day-cell.selected .day-num { color: var(--text-inverse); }

.date-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md) 32rpx 16rpx;
}
.date-text { font-size: var(--font-md); font-weight: var(--weight-semibold); color: var(--text-primary); }
.count-text { font-size: var(--font-sm); color: var(--text-faint); }

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}
.empty-text { font-size: var(--font-md); color: var(--text-faint); }
.retry-button {
  margin-top: var(--space-md);
  padding: 0 24rpx;
  min-width: 112px;
  background: var(--bg-tag);
  color: var(--nb-ink);
}

.order-list { padding: 0 16rpx; }

.order-card {
  display: flex;
  background: var(--bg-card);
  border-radius: var(--radius-sm);
  margin-bottom: var(--space-sm);
  padding: 28rpx 24rpx;
  align-items: center;
}

.order-time-col {
  width: 100rpx;
  flex-shrink: 0;
  text-align: center;
}
.order-time {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--nb-ink);
}

.order-body {
  flex: 1;
  margin-left: 24rpx;
}
.order-client {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}
.order-services {
  font-size: var(--font-sm);
  color: var(--text-muted);
  display: block;
  margin-bottom: 8rpx;
}
.order-status {
  font-size: var(--font-xs);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  background: var(--bg-page);
  color: var(--text-faint);
}
.order-status.tone-orange,
.order-status.tone-yellow,
.order-status.tone-purple,
.order-status.tone-sky { background: var(--nb-soft-surface); color: var(--nb-text-link); }
.order-status.tone-emerald,
.order-status.tone-teal { background: var(--nb-success-surface); color: var(--nb-success); }
.order-status.tone-gray { background: var(--bg-page); color: var(--text-muted); }
.order-status.tone-red { background: var(--nb-danger-surface); color: var(--nb-danger); }
