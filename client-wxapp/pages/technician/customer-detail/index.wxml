<nav-bar title="客户详情" showBack/>
<view wx:if="{{loading}}" class="loading-page">
  <view class="spinner"></view>
  <text class="loading-text">加载中...</text>
</view>

<view wx:elif="{{loadFailed}}" class="load-error" aria-live="polite">
  <view class="load-error-mark">!</view>
  <text class="load-error-title">{{loadErrorText}}</text>
  <text wx:if="{{customerId}}" class="load-error-desc">请检查网络后重试</text>
  <button wx:if="{{customerId}}" class="retry-btn booking-action" bindtap="loadCustomer">重新加载</button>
</view>

<view wx:else class="page {{customer.archiveEligible ? 'page-with-archive' : ''}}">
  <!-- ============ Header ============ -->
  <view class="header">
    <view class="header-row">
      <view class="cu-avatar">
        <image wx:if="{{customer.avatarUrl && !customer._avatarFailed}}" src="{{customer.avatarUrl}}" mode="aspectFill" class="cu-avatar-img" binderror="onAvatarError" aria-label="{{customer._displayName}}的头像" />
        <image wx:else src="/static/icons/client.svg" mode="aspectFit" class="nb-default-avatar" aria-label="客户默认头像" />
      </view>
      <view class="cu-info">
        <text class="cu-name">{{customer._displayName}}</text>
        <text wx:if="{{customer.phone}}" class="cu-phone">{{customer._phoneMasked}}</text>
      </view>
      <view wx:if="{{customer.phone}}" class="round-btn" catchtap="callCustomer" role="button" aria-label="拨打客户电话"><image class="phone-icon" src="/static/icons/phone-white.svg" mode="aspectFit" /></view>
    </view>

    <!-- 悬浮统计卡 -->
    <view class="stats-card">
      <view class="stat-item">
        <text class="semantic-money stat-value">{{customer._totalSpentText}}</text>
        <text class="stat-label">累计消费</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{customer._completedServices}}</text>
        <text class="stat-label">服务次数</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{customer._recentLabel}}</text>
        <text class="stat-label">最近服务</text>
      </view>
    </view>
  </view>

  <!-- ============ 经营摘要 ============ -->
  <view class="card business-card">
    <view class="card-head">
      <text class="card-title">经营摘要</text>
      <text class="lifecycle-summary">{{customer._lifecycleLabel}}</text>
    </view>
    <view class="summary-grid">
      <view class="summary-item">
        <text class="summary-label">首次服务</text>
        <text class="summary-value">{{customer._firstServiceText}}</text>
      </view>
      <view class="summary-item">
        <text class="summary-label">最近服务</text>
        <text class="summary-value">{{customer._lastServiceText}}</text>
      </view>
      <view class="summary-item">
        <text class="summary-label">平均客单价</text>
        <text class="semantic-money summary-value">{{customer._averageTicketText}}</text>
      </view>
      <view class="summary-item">
        <text class="summary-label">服务周期</text>
        <text class="summary-value">{{customer._serviceCycleText}}</text>
      </view>
    </view>
    <view class="next-service-row">
      <view>
        <text class="summary-label">预计下次服务</text>
        <text class="next-service-value">{{customer._expectedNextServiceText}}</text>
      </view>
      <text class="cycle-hint">{{customer._serviceCycleHint}}</text>
    </view>
    <text class="lifecycle-explanation">{{customer._lifecycleReason}}。仅统计已完成服务与确认收入。</text>
  </view>

  <view class="card customer-memory-card">
    <view class="card-head"><text class="card-title">美甲档案</text><view class="card-action" bindtap="addProfileFact" role="button">新增</view></view>
    <text class="memory-private">稳定信息 · 仅美甲师可见</text>
    <view wx:for="{{customer._profileGroups}}" wx:key="key" class="memory-group">
      <text class="memory-group-title">{{item.title}}</text>
      <view wx:for="{{item.items}}" wx:for-item="fact" wx:key="_key" class="memory-row">
        <view class="memory-copy">
          <text>{{fact.content}}</text>
          <text wx:if="{{fact._confirmedText}}" class="memory-date">最近确认 {{fact._confirmedText}}</text>
        </view>
      </view>
    </view>
    <text wx:if="{{!customer._profileGroups.length}}" class="muted">暂无稳定档案，可新增或确认客户自述</text>

    <view wx:if="{{customer._pendingFacts.length}}" class="memory-pending">
      <text class="memory-pending-title">待确认的新发现</text>
      <view wx:for="{{customer._pendingFacts}}" wx:key="_key" class="memory-pending-row">
        <view class="memory-copy"><text>{{item._categoryText}}：{{item.content}}</text></view>
        <view class="fact-action" data-id="{{item.id}}" data-status="active" catchtap="updateFactStatus" role="button" aria-label="确认这条档案信息">确认</view>
        <view class="fact-action" data-id="{{item.id}}" data-status="inactive" catchtap="updateFactStatus" role="button" aria-label="忽略这条档案信息">忽略</view>
      </view>
    </view>

    <view wx:if="{{customer._selfReported.length}}" class="memory-pending">
      <text class="memory-pending-title">客户自述 · 待确认</text>
      <view wx:for="{{customer._selfReported}}" wx:key="content" class="memory-pending-row">
        <view class="memory-copy"><text>{{item.label}}：{{item.content}}</text></view>
        <view class="fact-action" data-category="{{item.category}}" data-content="{{item.content}}" catchtap="confirmSelfReported" role="button" aria-label="确认客户自述并写入档案">确认</view>
      </view>
    </view>
  </view>

  <!-- ============ 标签 ============ -->
  <view class="card card-gap">
    <view class="card-head">
      <text class="card-title">客户标签</text>
      <view class="card-action" bindtap="openTagEdit">
        {{customer._tags.length > 0 ? '编辑' : '+ 添加'}}
      </view>
    </view>
    <view wx:if="{{customer._tags.length > 0}}" class="tag-list">
      <text wx:for="{{customer._tags}}" wx:key="*this" class="tag">{{item}}</text>
    </view>
    <text wx:else class="muted">暂无标签，点击「+ 添加」为客户打标签</text>
  </view>

  <!-- ============ 基础信息 ============ -->
  <view class="card">
    <text class="card-title">基础信息</text>

    <view class="info-row info-action-row remark-row">
      <text class="info-label">客户备注</text>
      <view class="remark-value-wrap">
        <text class="remark-value">{{customer._remarkName || '未设置'}}</text>
        <text wx:if="{{customer._accountName}}" class="account-name">（{{customer._accountName}}）</text>
      </view>
      <view class="inline-action" bindtap="openRemarkEdit" role="button" aria-label="更改客户备注">更改</view>
    </view>
    <view wx:if="{{customer._genderText}}" class="info-row">
      <text class="info-label">性别</text>
      <text class="info-value">{{customer._genderText}}</text>
    </view>
    <view wx:if="{{customer._birthdayText}}" class="info-row">
      <text class="info-label">生日</text>
      <text class="info-value">{{customer._birthdayText}}</text>
    </view>
    <view wx:if="{{customer.address}}" class="info-row info-action-row">
      <text class="info-label">地址</text>
      <text class="addr-text">{{customer.address}}</text>
      <view class="inline-action" catchtap="copyAddress" role="button" aria-label="复制客户地址">复制</view>
    </view>
    <view class="info-row info-action-row">
      <text class="info-label">其他备注</text>
      <text class="info-value">{{customer.notes || '暂无备注'}}</text>
      <view class="inline-action" bindtap="openNotesEdit" role="button" aria-label="编辑其他备注">编辑</view>
    </view>
    <view class="info-row">
      <text class="info-label">客户来源</text>
      <text class="info-value">{{customer._sourceLabel}}</text>
    </view>
  </view>

  <!-- ============ 关联作品 ============ -->
  <view wx:if="{{customer._serviceRecords.length === 0 && customer.relatedWorks.length}}" class="card">
    <view class="card-head">
      <text class="card-title">关联作品（{{customer.relatedWorks.length}}）</text>
    </view>
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="work-scroll">
      <view class="work-row">
        <view wx:for="{{customer.relatedWorks}}" wx:key="id" class="related-work" bindtap="goWorkDetail" data-id="{{item.id}}">
          <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" class="related-work-image" lazy-load aria-label="{{item.title || '客户关联作品'}}"/>
          <view wx:else class="related-work-image related-work-placeholder"></view>
          <text class="related-work-title">{{item.title || '未命名作品'}}</text>
          <text class="related-work-meta">{{item._dateText}}</text>
          <text class="related-work-permission">已授权：{{item._permissionText}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- ============ 美甲记录 ============ -->
  <view wx:if="{{customer._serviceRecords.length}}" class="card service-history-card">
    <view class="card-head">
      <text class="card-title">美甲记录（{{customer._serviceRecords.length}}）</text>
    </view>
    <view wx:for="{{customer._serviceRecords}}" wx:key="id" class="service-history-row" bindtap="openServiceRecord" data-order-id="{{item.orderId}}" data-mode="{{item.status === 'complete' ? 'record' : 'edit'}}" role="button" aria-label="查看本次美甲记录">
      <view class="service-history-head">
        <view class="service-history-copy">
          <text class="service-history-title">{{item._dateText}}</text>
          <text class="service-history-desc">{{item._serviceTitle}}</text>
        </view>
        <text class="record-status">{{item._statusText}}</text>
      </view>
      <view class="record-foot">
        <text class="service-history-meta">{{item._photoCountsText}}</text>
        <text wx:if="{{item._missingText}}" class="record-missing">{{item._missingText}} · 去补全</text>
      </view>
    </view>
  </view>

  <!-- ============ 底部操作 ============ -->
  <view class="bottom-actions">
    <view class="action-btn action-primary booking-action" bindtap="newOrder" role="button">为客户创建预约</view>
    <view wx:if="{{customer.archiveEligible}}" class="archive-btn {{archiving ? 'is-disabled' : ''}}" role="button" aria-disabled="{{archiving}}" bindtap="archiveCustomer">{{archiving ? '正在归档…' : '归档长期未互动客户'}}</view>
  </view>
</view>

<!-- ============ 其他备注编辑弹窗 ============ -->
<view wx:if="{{showNotesEdit}}" class="remark-modal-mask" bindtap="closeNotesEdit">
  <view class="remark-modal" catchtap="">
    <text class="remark-modal-title">编辑其他备注</text>
    <textarea
      class="notes-input"
      maxlength="500"
      placeholder="记录无法归类的其他信息"
      placeholder-class="customer-form-placeholder"
      value="{{notesDraft}}"
      bindinput="onNotesInput"
      focus="{{showNotesEdit}}"
      confirm-type="done" />
    <view class="remark-modal-actions">
      <view class="remark-modal-btn remark-cancel booking-action {{savingNotes ? 'is-disabled' : ''}}" bindtap="closeNotesEdit" role="button" aria-disabled="{{savingNotes}}">取消</view>
      <view class="remark-modal-btn remark-confirm booking-action {{savingNotes ? 'is-disabled' : ''}}" bindtap="saveNotes" role="button" aria-disabled="{{savingNotes}}">{{savingNotes ? '保存中' : '保存'}}</view>
    </view>
  </view>
</view>

<!-- ============ 客户备注编辑弹窗 ============ -->
<view wx:if="{{showRemarkEdit}}" class="remark-modal-mask" bindtap="closeRemarkEdit">
  <view class="remark-modal" catchtap="">
    <text class="remark-modal-title">更改客户备注</text>
    <text class="remark-modal-help">客户本人名称：{{customer._accountName || '未设置'}}</text>
    <input
      class="remark-input"
      disabled="{{savingRemark}}"
      maxlength="30"
      placeholder="输入便于识别的客户备注"
      placeholder-class="customer-form-placeholder"
      value="{{remarkDraft}}"
      bindinput="onRemarkInput"
      focus="{{showRemarkEdit}}"
      confirm-type="done"
      bindconfirm="saveRemark"
    />
    <view class="remark-modal-actions">
      <view class="remark-modal-btn remark-cancel booking-action {{savingRemark ? 'is-disabled' : ''}}" bindtap="closeRemarkEdit" role="button" aria-disabled="{{savingRemark}}">取消</view>
      <view class="remark-modal-btn remark-confirm booking-action {{savingRemark ? 'is-disabled' : ''}}" bindtap="saveRemark" role="button" aria-disabled="{{savingRemark}}">{{savingRemark ? '保存中' : '保存备注'}}</view>
    </view>
  </view>
</view>

<!-- ============ 标签编辑底部弹层 ============ -->
<view wx:if="{{showTagEdit}}" class="sheet-mask" bindtap="closeTagEdit"></view>
<view class="sheet {{showTagEdit ? 'sheet-show' : ''}}" catchtap="">
  <view class="sheet-header">
    <text class="sheet-title">编辑标签</text>
    <view class="sheet-close {{savingTags ? 'is-disabled' : ''}}" bindtap="closeTagEdit" role="button" aria-label="关闭标签编辑" aria-disabled="{{savingTags}}">✕</view>
  </view>

  <scroll-view scroll-y class="sheet-body">
    <text class="sub-label">当前标签（点击移除）</text>
    <view class="tag-list editable">
      <view
        wx:for="{{editTags}}"
        wx:key="*this"
        class="tag tag-removable {{savingTags ? 'is-disabled' : ''}}"
        role="button" aria-disabled="{{savingTags}}"
        bindtap="removeTag"
        data-tag="{{item}}"
      >{{item}} ✕</view>
      <text wx:if="{{editTags.length === 0}}" class="muted">暂无标签</text>
    </view>

    <text wx:if="{{availableTags.length > 0}}" class="sub-label">可选标签（点击添加）</text>
    <view wx:if="{{availableTags.length > 0}}" class="tag-list">
      <view
        wx:for="{{availableTags}}"
        wx:key="*this"
        class="tag tag-addable {{savingTags ? 'is-disabled' : ''}}"
        role="button" aria-disabled="{{savingTags}}"
        bindtap="addExistingTag"
        data-tag="{{item}}"
      >+ {{item}}</view>
    </view>

    <text class="sub-label">新增客户标签</text>
    <view class="new-tag-row">
      <input
        class="new-tag-input"
        placeholder-class="customer-form-placeholder"
        disabled="{{savingTags}}"
        placeholder="输入新标签，保存后自动纳入标签管理"
        maxlength="12"
        value="{{newTag}}"
        bindinput="onNewTagInput"
        bindconfirm="addNewTag" confirm-type="done" />
      <view class="new-tag-btn booking-action {{savingTags ? 'is-disabled' : ''}}" role="button" aria-disabled="{{savingTags}}" bindtap="addNewTag">添加</view>
    </view>
  </scroll-view>

  <view class="sheet-footer">
    <view class="action-btn action-primary booking-action {{savingTags ? 'is-disabled' : ''}}" role="button" aria-disabled="{{savingTags}}" bindtap="saveTags">
      {{savingTags ? '保存中...' : '保存标签'}}
    </view>
  </view>
</view>
