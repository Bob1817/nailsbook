page { background: var(--nb-page); }

.page {
  min-height: 100vh;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}
.page-with-archive { padding-bottom: calc(292rpx + env(safe-area-inset-bottom)); }

/* ===== 加载/空 ===== */
.loading-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}
.spinner {
  width: 48rpx; height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid var(--nb-line);
  border-top-color: var(--nb-ink);
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: var(--font-sm); color: var(--nb-muted); }
.load-error { min-height:100vh; box-sizing:border-box; padding:120rpx 48rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; background:var(--nb-page); text-align:center; }
.load-error-mark { width:88rpx; height:88rpx; margin-bottom:28rpx; border-radius:50%; background:var(--nb-page); color:var(--nb-ink); font-size: var(--font-xl); line-height:88rpx; }
.load-error-title { color:var(--nb-ink); font-size: var(--font-lg); font-weight: var(--weight-semibold); }.load-error-desc { margin-top:12rpx; color:var(--nb-secondary); font-size: var(--font-sm); }
.retry-btn { min-height:88rpx; margin:44rpx 0 0; padding:0 56rpx; border:0; border-radius: var(--radius-xl); background:var(--nb-ink); color: var(--nb-inverse); font-size: var(--font-md); line-height:88rpx; }.retry-btn::after { border:0; }

/* ===== Header ===== */
.header {
  position: relative;
  background: var(--nb-surface);
  border-bottom: 1rpx solid var(--nb-line);
  padding: 44rpx 40rpx 120rpx;
}
.header-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.cu-avatar {
  width: 112rpx; height: 112rpx;
  border-radius: 50%;
  background: var(--nb-soft-surface);
  border: 2rpx solid var(--nb-line);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.cu-avatar-img { width: 100%; height: 100%; }
.cu-avatar-char { font-size: var(--font-2xl); font-weight: var(--weight-bold); color: var(--nb-ink); }

.cu-info { flex: 1; min-width: 0; }
.cu-name {
  display: block;
  font-size: var(--font-xl); font-weight: var(--weight-bold); color: var(--nb-ink);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.remark-row { align-items:center; }
.remark-value-wrap { flex:1; min-width:0; display:flex; align-items:center; overflow:hidden; white-space:nowrap; }
.remark-value { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--nb-ink); font-size:var(--font-sm); }
.account-name { flex-shrink:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--nb-muted); font-size:var(--font-sm); }
.cu-phone {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: var(--nb-muted);
}
.round-btn {
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  background: var(--nb-action);
  border: 0;
  color: var(--nb-inverse);
  font-size: var(--font-lg);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.round-btn:active { opacity: 0.82; }
.phone-icon { width:44rpx; height:44rpx; }

/* 悬浮统计卡 */
.stats-card {
  position: absolute;
  left: 32rpx; right: 32rpx;
  bottom: -56rpx;
  background: var(--nb-surface);
  border: 1rpx solid var(--nb-line);
  border-radius: var(--radius-lg);
  padding: 28rpx 40rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.stat-value {
  font-size: var(--font-lg); font-weight: var(--weight-bold); color: var(--nb-ink);
  letter-spacing: -0.5rpx;
}
.stat-label { font-size: var(--font-xs); color: var(--nb-muted); }
.stat-divider {
  width: 1rpx; height: 48rpx;
  background: var(--nb-line);
}

/* ===== 卡片 ===== */
.card {
  margin: var(--space-md) var(--space-xl) 0;
  background: var(--nb-surface);
  border: 1rpx solid var(--nb-line);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.card-gap { margin-top: 84rpx; }
.business-card { margin-top: 84rpx; }
.business-card + .card-gap { margin-top: var(--space-md); }

.card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-sm); margin-bottom: var(--space-md); }
.card-head .card-title { margin-bottom: 0; flex: 1; min-width: 0; }
.card-title { display: block; font-size: var(--font-lg); font-weight: var(--weight-bold); color: var(--nb-ink); line-height: 1.2; margin-bottom: var(--space-md); }

.card-action {
  display: inline-flex; align-items: center; justify-content: center;
  font-size: var(--font-sm); color: var(--nb-text-link); font-weight: var(--weight-semibold);
  padding: 12rpx 8rpx;
  line-height: 1;
}
.lifecycle-summary { padding:7rpx 18rpx; border-radius:999rpx; background: var(--nb-soft-surface); color:var(--nb-ink); font-size: var(--font-xs); font-weight: var(--weight-bold); }
.summary-grid { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; }
.summary-item { padding:20rpx; border-radius: var(--radius-md); background:var(--nb-soft-surface); }
.summary-label,.summary-value,.next-service-value,.cycle-hint { display:block; }
.summary-label { color:var(--nb-muted); font-size: var(--font-xs); }
.summary-value { margin-top:8rpx; color:var(--nb-ink); font-size: var(--font-sm); font-weight: var(--weight-bold); }
.next-service-row { margin-top: var(--space-sm); padding: 20rpx; border-radius: var(--radius-md); background: var(--nb-soft-surface); display:flex; align-items:center; justify-content:space-between; gap:20rpx; }
.next-service-value { margin-top:8rpx; color:var(--nb-ink); font-size: var(--font-md); font-weight: var(--weight-bold); }
.cycle-hint { max-width:260rpx; color:var(--nb-secondary); font-size: var(--font-xs); line-height:1.45; text-align:right; }
.lifecycle-explanation { display:block; margin-top: var(--space-sm); color:var(--nb-muted); font-size: var(--font-xs); line-height:1.55; }

.muted {
  font-size: var(--font-sm);
  color: var(--text-muted);
  line-height: 1.6;
}
.work-scroll { width:100%; white-space:nowrap; }
.work-row { display:inline-flex; gap:18rpx; padding:2rpx 2rpx 10rpx; }
.related-work { width:260rpx; padding:14rpx; border-radius: var(--radius-md); background:var(--nb-page); border: 0; box-sizing:border-box; }
.related-work:active { background: var(--bg-tag); }.related-work-image { width:232rpx; height:180rpx; border-radius:15rpx; display:block; }.related-work-placeholder { background:var(--nb-page); }
.related-work-title,.related-work-meta,.related-work-permission { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.related-work-title { margin-top:13rpx; color:var(--nb-ink); font-size: var(--font-sm); font-weight: var(--weight-bold); }.related-work-meta { margin-top:6rpx; color:var(--nb-muted); font-size: var(--font-xs); }.related-work-permission { margin-top:7rpx; color:var(--nb-ink); font-size: var(--font-xs); }

/* 标签 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.tag {
  padding: 8rpx 40rpx;
  border-radius: 999rpx;
  background: var(--nb-page);
  color: var(--nb-secondary);
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
}
.tag-removable { min-height:88rpx; display:flex; align-items:center; background:var(--nb-page); color: var(--nb-secondary); }
.tag-addable { min-height:88rpx; display:flex; align-items:center; background:var(--nb-page); color: var(--text-muted); }
.tag-list.editable { margin-bottom: 8rpx; }

/* 信息行 */
.info-row {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 0;
  gap: 24rpx;
}
.info-action-row { display:grid; grid-template-columns:120rpx minmax(0,1fr) auto; align-items:center; gap:24rpx; }
.info-row:last-child { border-bottom: none; }
.info-label {
  flex-shrink: 0;
  width: 120rpx;
  font-size: var(--font-sm);
  color: var(--text-muted);
}
.info-value {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--text-primary);
  line-height: var(--leading-normal);
  word-break: break-all;
}
.addr-text {
  min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
  font-size: var(--font-sm); color: var(--text-primary); line-height: var(--leading-normal);
}
.inline-action { display:inline-flex; align-items:center; justify-content:center; color:var(--nb-text-link); font-size:var(--font-xs); font-weight:var(--weight-semibold); padding: 12rpx 8rpx; line-height: 1; }
.notes-input { width:100%; min-height:160rpx; padding:20rpx; border-radius: var(--radius-md); box-sizing:border-box; background: var(--bg-input); color: var(--text-primary); font-size: var(--font-sm); line-height:1.55; }

/* ===== 底部操作 ===== */
.bottom-actions {
  position: fixed;
  left: 0; right: 0;
  bottom: 0;
  background: var(--nb-surface);
  border-top: 1rpx solid var(--nb-line);
  padding: 16rpx 40rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
  z-index: 100;
}
.action-btn {
  height: 88rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-md); font-weight: var(--weight-semibold);
  display: flex; align-items: center; justify-content: center;
}
.action-btn:active { opacity: 0.85; }
.action-primary {
  background: var(--nb-action);
  color: var(--nb-inverse);
  box-shadow: none;
}
.archive-btn {
  min-height: 88rpx;
  margin-top: 12rpx;
  border: 0;
  border-radius: var(--radius-md);
  background: var(--nb-soft-surface);
  color: var(--nb-secondary);
  font-size: var(--font-sm);
  line-height: 88rpx;
  text-align: center;
}
.archive-btn:active { background: var(--nb-page); }
.is-disabled { opacity: 0.5; }

/* ===== 底部弹层 ===== */
.sheet-mask {
  position: fixed; inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 200;
}
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 201;
  background: var(--nb-surface);
  border-top: 1rpx solid var(--nb-line);
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.25s ease-out;
}
.sheet-show { transform: translateY(0); }
.sheet-header {
  flex-shrink: 0;
  padding: 28rpx 32rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 0;
}
.sheet-title { font-size: var(--font-lg); font-weight: var(--weight-semibold); color: var(--text-primary); }
.sheet-close {
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  background: var(--nb-page);
  display: flex; align-items: center; justify-content: center;
}
.sheet-close-icon {
  width: var(--icon-sm);
  height: var(--icon-sm);
}
.tag-removable {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}
.tag-remove-icon {
  width: var(--icon-xs);
  height: var(--icon-xs);
  opacity: 0.6;
}
.sheet-body {
  width: 100%;
  padding: 8rpx 32rpx 24rpx;
  box-sizing: border-box;
  max-height: 60vh;
}
.sheet-footer {
  flex-shrink: 0;
  padding: 16rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 0;
}

.sub-label {
  display: block;
  font-size: var(--font-sm);
  color: var(--nb-secondary);
  margin: 20rpx 0 12rpx;
}
.sub-label:first-child { margin-top: 0; }

.new-tag-row {
  width: 100%;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 112rpx;
  gap: 12rpx;
  align-items: center;
  box-sizing: border-box;
}
.new-tag-input  {
  width: 100%;
  min-width: 0;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  font-size: var(--font-md);
  color: var(--text-primary);
}
.new-tag-btn {
  position: relative;
  width: 112rpx;
  padding: 0;
  height: 88rpx;
  color: var(--nb-text-link);
  font-size: var(--font-sm); font-weight: var(--weight-semibold);
  display: flex; align-items: center; justify-content: center;
  z-index: 0;
}
.new-tag-btn { background:var(--nb-page); }
.tag { color:var(--nb-secondary); }

/* ===== 客户备注弹窗 ===== */
.remark-modal-mask { position:fixed; inset:0; z-index:300; display:flex; padding:0 48rpx; box-sizing:border-box; align-items:center; justify-content:center; background:rgba(0, 0, 0, .42); }
.remark-modal { width:100%; padding:40rpx; box-sizing:border-box; border-radius:28rpx; background:var(--nb-surface); border: 1rpx solid var(--nb-line); box-shadow:0 24rpx 64rpx rgba(0, 0, 0, .18); }
.remark-modal-title { display:block; color:var(--nb-ink); font-size:var(--font-lg); font-weight:var(--weight-bold); }
.remark-modal-help { display:block; margin-top:10rpx; overflow:hidden; color:var(--nb-muted); font-size:var(--font-sm); text-overflow:ellipsis; white-space:nowrap; }
.remark-input { height:96rpx; margin-top:28rpx; padding:0 24rpx; box-sizing:border-box; border: 1rpx solid var(--nb-line); border-radius:20rpx; background: var(--nb-soft-surface); color:var(--nb-ink); font-size:var(--font-md); }
.remark-modal-actions { display:flex; gap:16rpx; margin-top:28rpx; }
.remark-modal-btn { flex:1; display:flex; min-height:88rpx; align-items:center; justify-content:center; border-radius:var(--radius-md); font-size:var(--font-md); font-weight:var(--weight-semibold); }
.remark-cancel { border: 0; color:var(--nb-secondary); background: var(--nb-soft-surface); }
.remark-confirm { background:var(--nb-action); color:var(--nb-inverse); }

/* Text navigation has no decorative pill. Keep existing hit-area sizing. */
.order-detail-btn, .order-detail-btn::before { color: var(--nb-text-link, #245EA8); background: transparent; border-color: transparent; box-shadow: none; }
.order-detail-btn:active { background: transparent; opacity: .7; }
@import '../../../styles/booking-actions.wxss';
.customer-form-placeholder { color: var(--nb-muted); font-size: var(--font-sm); }
.remark-input, .new-tag-input { min-width: 0; box-sizing: border-box; font-size: var(--font-sm); border-radius: var(--input-radius); }
.remark-input, .new-tag-input { height: var(--input-height); min-height: 44px; padding: 0 var(--input-padding-h); }
.retry-btn.booking-action { min-height:44px; height:44px; margin-top:44rpx; padding:0 24rpx; border-radius:8px; font-size:var(--font-sm); line-height:1.4; }
/* 客户档案：固定分类列、连续内容列，日期作为次级信息。 */
.customer-memory-card .card-head { align-items:flex-start; gap:var(--space-sm); margin-bottom:var(--space-md); }
.memory-heading { flex:1; min-width:0; }
.customer-memory-card .card-title { font-size:var(--font-md); line-height:1.5; margin-bottom:0; }
.customer-memory-card .card-action {
  position: relative;
  flex-shrink: 0;
  padding: 0 4rpx;
  line-height: 1.5;
}
.customer-memory-card .card-action::after {
  content: '';
  position: absolute;
  top: -16rpx;
  bottom: -16rpx;
  left: -16rpx;
  right: -16rpx;
}
.customer-memory-card .card-action:active { opacity:.7; }
.memory-private,.memory-date { color:var(--text-muted); font-size:var(--font-xs); }
.memory-private { display:block; margin-top:var(--space-xs); line-height:1.5; }
.memory-group { display:grid; grid-template-columns:112rpx minmax(0,1fr); align-items:start; gap:var(--space-md); margin-top:var(--space-md); }
.memory-group-title { display:block; color:var(--nb-secondary); font-size:var(--font-sm); font-weight:var(--weight-semibold); line-height:1.6; }
.memory-facts { min-width:0; }
.memory-row + .memory-row { margin-top:var(--space-sm); }
.memory-copy { flex:1; min-width:0; color:var(--text-primary); font-size:var(--font-sm); overflow-wrap:anywhere; word-break:break-word; }
.memory-copy text { display:block; line-height:1.6; }
.memory-date { margin-top:4rpx; }
.memory-group-head { min-height:44px; display:flex; align-items:center; justify-content:space-between; gap:var(--space-sm); }
.customer-traits { margin-top:var(--space-md); }
.customer-traits .memory-group-head { position:relative; min-height:0; padding-right:44px; align-items:flex-start; }
.customer-traits .fact-action { position:absolute; top:0; right:0; align-items:flex-start; line-height:1.6; }
.customer-traits .tag-list { margin-top:var(--space-xs); padding-right:calc(44px + var(--space-xs)); gap:var(--space-xs); }
.customer-traits .tag { max-width:100%; box-sizing:border-box; padding:8rpx 16rpx; border-radius:var(--radius-xs); font-size:var(--font-xs); line-height:1.5; overflow-wrap:anywhere; }
.memory-empty { display:block; margin-top:var(--space-sm); }
.memory-pending { margin-top:var(--space-lg); padding:var(--space-sm); border-radius:var(--radius-sm); background:var(--nb-page); }
.memory-pending-title { display:block; margin-bottom:var(--space-xs); color:var(--nb-ink); font-size:var(--font-sm); font-weight:var(--weight-semibold); }
.memory-pending-row { display:flex; flex-wrap:wrap; align-items:center; column-gap:var(--space-xs); padding:var(--space-xs) 0; }
.memory-pending-row .memory-copy { flex-basis:100%; }
.fact-action { min-height:44px; min-width:44px; box-sizing:border-box; display:flex; flex-shrink:0; align-items:center; justify-content:center; padding:0 12rpx; color:var(--nb-text-link); font-size:var(--font-sm); }
.fact-action:active { opacity:.7; }
.service-history-row { min-height:44px; display:flex; align-items:center; gap:20rpx; padding:24rpx 0; border-top:1rpx solid var(--nb-line); }
.service-history-row:active { opacity:.72; }
.service-history-time { flex:1; min-width:0; }
.service-history-title,.service-history-label,.service-history-value { display:block; }
.service-history-title { margin-top:8rpx; color:var(--nb-ink); font-size:var(--font-sm); font-weight:var(--weight-semibold); line-height:1.4; }
.service-history-label { color:var(--nb-muted); font-size:var(--font-xs); }
.service-history-metrics { display:flex; flex:0 0 286rpx; gap:20rpx; }
.service-history-metric { flex:1; min-width:0; }
.service-history-value { margin-top:8rpx; overflow:hidden; color:var(--nb-secondary); font-size:var(--font-sm); font-weight:var(--weight-semibold); line-height:1.4; text-overflow:ellipsis; white-space:nowrap; }
.service-history-price { color:var(--nb-money); }
.service-history-arrow { flex-shrink:0; color:var(--nb-muted); font-size:var(--font-md); }
