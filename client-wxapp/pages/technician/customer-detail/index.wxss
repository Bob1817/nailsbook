page { background: var(--bg-gradient-entry); }

.page {
  min-height: 100vh;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}
.page-with-archive { padding-bottom: calc(292rpx + env(safe-area-inset-bottom)); }

/* ===== 加载/空 ===== */
.loading-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}
.spinner {
  width: 48rpx; height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid var(--nb-line);
  border-top-color: var(--brand-primary);
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: var(--font-sm); color: var(--text-muted); }
.load-error { min-height:100vh; box-sizing:border-box; padding:120rpx 48rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; background:var(--nb-page); text-align:center; }
.load-error-mark { width:88rpx; height:88rpx; margin-bottom:28rpx; border-radius:50%; background:var(--nb-page); color:var(--nb-ink); font-size: var(--font-xl); line-height:88rpx; }
.load-error-title { color:var(--nb-ink); font-size: var(--font-lg); font-weight: var(--weight-semibold); }.load-error-desc { margin-top:12rpx; color:var(--nb-secondary); font-size: var(--font-sm); }
.retry-btn { min-height:88rpx; margin:44rpx 0 0; padding:0 56rpx; border:0; border-radius: var(--radius-xl); background:var(--nb-ink); color: var(--text-inverse); font-size: var(--font-md); line-height:88rpx; }.retry-btn::after { border:0; }

/* ===== Header ===== */
.header {
  position: relative;
  background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-primary-light) 50%, var(--brand-primary-light) 100%);
  padding: 56rpx 40rpx 130rpx;
}
.header-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.cu-avatar {
  width: 112rpx; height: 112rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  border: 0;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.cu-avatar-img { width: 100%; height: 100%; }
.cu-avatar-char { font-size: var(--font-2xl); font-weight: var(--weight-bold); color: var(--text-inverse); }

.cu-info { flex: 1; min-width: 0; }
.cu-name {
  display: block;
  font-size: var(--font-xl); font-weight: var(--weight-bold); color: var(--text-inverse);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.16);
}
.remark-row { align-items:center; }
.remark-value-wrap { flex:1; min-width:0; display:flex; align-items:center; overflow:hidden; white-space:nowrap; }
.remark-value { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--text-primary); font-size:var(--font-sm); }
.account-name { flex-shrink:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--text-muted); font-size:var(--font-sm); }
.cu-phone {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.85);
}
.round-btn {
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  border: 0;
  color: var(--text-inverse);
  font-size: var(--font-lg);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.round-btn:active { background: rgba(255, 255, 255, 0.35); }
.phone-icon { width:44rpx; height:44rpx; }

/* 悬浮统计卡 */
.stats-card {
  position: absolute;
  left: 32rpx; right: 32rpx;
  bottom: -56rpx;
  background: var(--bg-gradient-entry);
  border-radius: var(--radius-lg);
  padding: 28rpx 40rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.12);
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.stat-value {
  font-size: var(--font-lg); font-weight: var(--weight-bold); color: var(--text-primary);
  letter-spacing: -0.5rpx;
}
.stat-label { font-size: var(--font-xs); color: var(--text-muted); }
.stat-divider {
  width: 1rpx; height: 48rpx;
  background: var(--nb-page);
}

/* ===== 卡片 ===== */
.card {
  margin: 20rpx 40rpx 0;
  background: var(--bg-gradient-entry);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.05);
}
.card-gap { margin-top: 84rpx; }
.business-card { margin-top: 84rpx; }
.business-card + .card-gap { margin-top: 20rpx; }

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.card-head .card-title { margin-bottom: 0; }
.card-title {
  display: block;
  font-size: var(--font-md); font-weight: var(--weight-semibold); color: var(--text-primary);
  margin-bottom: 20rpx;
}
.card-action {
  position: relative;
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm); font-weight: var(--weight-semibold); color: var(--nb-text-link);
  padding: 0 28rpx;
  background: transparent;
  z-index: 0;
}
.card-action::before { content:''; position:absolute; left:8rpx; right:8rpx; top:12rpx; bottom:12rpx; z-index:-1; border-radius:999rpx; background:var(--nb-page); }
.lifecycle-summary { padding:7rpx 18rpx; border-radius:999rpx; background: var(--bg-tag); color:var(--nb-ink); font-size: var(--font-xs); font-weight: var(--weight-bold); }
.summary-grid { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; }
.summary-item { padding:20rpx; border-radius: var(--radius-md); background:var(--nb-page); }
.summary-label,.summary-value,.next-service-value,.cycle-hint { display:block; }
.summary-label { color:var(--nb-muted); font-size: var(--font-xs); }
.summary-value { margin-top:8rpx; color:var(--nb-ink); font-size: var(--font-sm); font-weight: var(--weight-bold); }
.next-service-row { margin-top:18rpx; padding:22rpx; border-radius: var(--radius-md); background: var(--bg-tag); display:flex; align-items:center; justify-content:space-between; gap:20rpx; }
.next-service-value { margin-top:8rpx; color:var(--nb-ink); font-size: var(--font-md); font-weight: var(--weight-bold); }
.cycle-hint { max-width:260rpx; color:var(--nb-secondary); font-size: var(--font-xs); line-height:1.45; text-align:right; }
.lifecycle-explanation { display:block; margin-top:18rpx; color:var(--nb-muted); font-size: var(--font-xs); line-height:1.55; }

.muted {
  font-size: var(--font-sm);
  color: var(--text-muted);
  line-height: 1.6;
}
.work-scroll { width:100%; white-space:nowrap; }
.work-row { display:inline-flex; gap:18rpx; padding:2rpx 2rpx 10rpx; }
.related-work { width:260rpx; padding:14rpx; border-radius: var(--radius-md); background:var(--nb-page); border: 0; box-sizing:border-box; }
.related-work:active { background: var(--bg-tag); }.related-work-image { width:232rpx; height:180rpx; border-radius:15rpx; display:block; }.related-work-placeholder { background:var(--nb-page); }
.related-work-title,.related-work-meta,.related-work-permission { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.related-work-title { margin-top:13rpx; color:var(--nb-ink); font-size: var(--font-sm); font-weight: var(--weight-bold); }.related-work-meta { margin-top:6rpx; color:var(--nb-muted); font-size: var(--font-xs); }.related-work-permission { margin-top:7rpx; color:var(--nb-ink); font-size: var(--font-xs); }

/* 标签 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.tag {
  padding: 8rpx 40rpx;
  border-radius: 999rpx;
  background: var(--nb-page);
  color: var(--nb-secondary);
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
}
.tag-removable { min-height:88rpx; display:flex; align-items:center; background:var(--nb-page); color: var(--nb-secondary); }
.tag-addable { min-height:88rpx; display:flex; align-items:center; background:var(--nb-page); color: var(--text-muted); }
.tag-list.editable { margin-bottom: 8rpx; }

/* 信息行 */
.info-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 0;
  gap: 24rpx;
}
.info-action-row { display:grid; grid-template-columns:120rpx minmax(0,1fr) 104rpx; min-height:88rpx; align-items:center; gap:24rpx; }
.info-row:last-child { border-bottom: none; }
.info-label {
  flex-shrink: 0;
  width: 120rpx;
  font-size: var(--font-sm);
  color: var(--text-muted);
}
.info-value {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--text-primary);
  line-height: var(--leading-normal);
  word-break: break-all;
}
.addr-text {
  min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
  font-size: var(--font-sm); color: var(--text-primary); line-height: var(--leading-normal);
}
.inline-action { position:relative; display:flex; width:104rpx; min-height:88rpx; align-items:center; justify-content:center; color:var(--nb-text-link); font-size:var(--font-xs); font-weight:var(--weight-semibold); z-index:0; }
.inline-action::before { content:''; position:absolute; left:4rpx; right:4rpx; top:12rpx; bottom:12rpx; z-index:-1; border-radius:999rpx; background:var(--nb-page); }
.inline-action:active::before { background:var(--nb-page); }
.follow-input { width:100%; min-height:176rpx; padding:22rpx; border-radius: var(--radius-md); box-sizing:border-box; background:var(--nb-page); color:var(--nb-ink); font-size: var(--font-sm); line-height:1.55; }
.follow-plan-row { margin-top: var(--space-sm); display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.follow-date,.follow-add,.follow-complete { position:relative; min-height:88rpx; display:flex; align-items:center; justify-content:center; font-size: var(--font-sm); z-index:0; }
.follow-date::before { content:''; position:absolute; left:0; right:0; top:12rpx; bottom:12rpx; z-index:-1; border-radius:999rpx; }
.follow-date { padding:0 24rpx; color:var(--nb-secondary); }
.follow-date::before { background:var(--nb-page); }
.follow-add { padding:0 30rpx; color:var(--nb-ink); font-weight: var(--weight-bold); }
.follow-add { background:var(--bg-tag); }
.follow-list { margin-top: var(--space-md); display:flex; flex-direction:column; gap:14rpx; }
.follow-item { display:flex; align-items:center; gap:16rpx; padding:20rpx; border-radius: var(--radius-md); background:var(--nb-page); }
.follow-main { flex:1; min-width:0; }
.follow-content,.follow-meta { display:block; }
.follow-content { color:var(--nb-ink); font-size: var(--font-sm); line-height: var(--leading-normal); }
.follow-meta { margin-top:7rpx; color:var(--nb-muted); font-size: var(--font-xs); }
.follow-complete { flex-shrink:0; min-width:112rpx; padding:0 20rpx; color:var(--nb-ink); font-weight: var(--weight-bold); }
.follow-complete { background:var(--nb-page); }

/* 预约记录：复用全部预约卡片 */
.booking-section { margin: 28rpx 32rpx 0; }
.booking-section > .card-title { margin: 0 8rpx 24rpx; }
.order-list { display: flex; flex-direction: column; gap: 16rpx; }

/* ===== 底部操作 ===== */
.bottom-actions {
  position: fixed;
  left: 0; right: 0;
  bottom: 0;
  background: var(--bg-gradient-entry);
  padding: 16rpx 40rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}
.action-btn {
  height: 88rpx;
  border-radius: var(--btn-radius);
  font-size: var(--font-md); font-weight: var(--weight-semibold);
  display: flex; align-items: center; justify-content: center;
}
.action-btn:active { opacity: 0.85; }
.action-primary {
  background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-primary-light) 100%);
  color: var(--text-inverse);
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.22);
}
.archive-btn {
  min-height: 88rpx;
  margin-top: 12rpx;
  border: 0;
  border-radius: var(--radius-xl);
  background: var(--nb-soft-surface);
  color: var(--text-body);
  font-size: var(--font-sm);
  line-height: 88rpx;
  text-align: center;
}
.archive-btn:active { background: var(--bg-page); }
.is-disabled { opacity: 0.5; }

/* ===== 底部弹层 ===== */
.sheet-mask {
  position: fixed; inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 200;
}
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 201;
  background: var(--bg-gradient-entry);
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.25s ease-out;
}
.sheet-show { transform: translateY(0); }
.sheet-header {
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 0;
}
.sheet-title { font-size: var(--font-lg); font-weight: var(--weight-semibold); color: var(--text-primary); }
.sheet-close {
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  background: var(--nb-page);
  color: var(--text-muted);
  font-size: var(--font-md);
  display: flex; align-items: center; justify-content: center;
}
.sheet-body {
  padding: var(--space-md) 40rpx;
  max-height: 60vh;
}
.sheet-footer {
  padding: 16rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 0;
}

.sub-label {
  display: block;
  font-size: var(--font-sm);
  color: var(--nb-secondary);
  margin: 20rpx 0 12rpx;
}
.sub-label:first-child { margin-top: 0; }

.new-tag-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}
.new-tag-input  {
  flex: 1;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  font-size: var(--font-md);
  color: var(--text-primary);
}
.new-tag-btn {
  position: relative;
  flex-shrink: 0;
  padding: 0 32rpx;
  height: 88rpx;
  color: var(--nb-text-link);
  font-size: var(--font-sm); font-weight: var(--weight-semibold);
  display: flex; align-items: center; justify-content: center;
  z-index: 0;
}
.new-tag-btn { background:var(--nb-page); }
.tag { color:var(--nb-secondary); }

/* ===== 客户备注弹窗 ===== */
.remark-modal-mask { position:fixed; inset:0; z-index:300; display:flex; padding:0 48rpx; box-sizing:border-box; align-items:center; justify-content:center; background:rgba(0, 0, 0, .42); }
.remark-modal { width:100%; padding:40rpx; box-sizing:border-box; border-radius:28rpx; background:var(--bg-card); box-shadow:0 24rpx 64rpx rgba(0, 0, 0, .18); }
.remark-modal-title { display:block; color:var(--text-primary); font-size:var(--font-lg); font-weight:var(--weight-bold); }
.remark-modal-help { display:block; margin-top:10rpx; overflow:hidden; color:var(--text-muted); font-size:var(--font-sm); text-overflow:ellipsis; white-space:nowrap; }
.remark-input { height:96rpx; margin-top:28rpx; padding:0 24rpx; box-sizing:border-box; border: 0; border-radius:20rpx; background: var(--nb-soft-surface); color:var(--text-primary); font-size:var(--font-md); }
.remark-modal-actions { display:flex; gap:16rpx; margin-top:28rpx; }
.remark-modal-btn { flex:1; display:flex; min-height:88rpx; align-items:center; justify-content:center; border-radius:999rpx; font-size:var(--font-md); font-weight:var(--weight-semibold); }
.remark-cancel { border: 0; color:var(--text-body); }
.remark-confirm { background:var(--brand-primary); color:var(--text-inverse); }

/* Text navigation has no decorative pill. Keep existing hit-area sizing. */
.order-detail-btn, .order-detail-btn::before { color: var(--nb-text-link, #245EA8); background: transparent; border-color: transparent; box-shadow: none; }
.order-detail-btn:active { background: transparent; opacity: .7; }
@import '../../../styles/booking-actions.wxss';
.customer-form-placeholder { color: var(--nb-muted); font-size: var(--font-sm); }
.follow-input, .remark-input, .new-tag-input { min-width: 0; box-sizing: border-box; font-size: var(--font-sm); border-radius: var(--input-radius); }
.remark-input, .new-tag-input { height: var(--input-height); min-height: 44px; padding: 0 var(--input-padding-h); }
.retry-btn.booking-action { min-height:44px; height:44px; margin-top:44rpx; padding:0 24rpx; border-radius:8px; font-size:var(--font-sm); line-height:1.4; }
