page { background: linear-gradient(180deg, #fff8fb 0%, #ffffff 34%, #f8f9fc 100%); }

.page {
  min-height: 100vh;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* ===== 加载/空 ===== */
.loading-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}
.spinner {
  width: 48rpx; height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid #ffd8e3;
  border-top-color: #ff6b8a;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 26rpx; color: #6b7280; }
.load-error { min-height:100vh; box-sizing:border-box; padding:120rpx 48rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; background:#f7f5f6; text-align:center; }
.load-error-mark { width:88rpx; height:88rpx; margin-bottom:28rpx; border-radius:50%; background:#fff0f4; color:#c75b83; font-size:44rpx; line-height:88rpx; }
.load-error-title { color:#382a31; font-size:32rpx; font-weight:600; }.load-error-desc { margin-top:12rpx; color:#796872; font-size:25rpx; }
.retry-btn { min-height:88rpx; margin:44rpx 0 0; padding:0 56rpx; border:0; border-radius:44rpx; background:#1f2937; color:#fff; font-size:28rpx; line-height:88rpx; }.retry-btn::after { border:0; }

/* ===== Header ===== */
.header {
  position: relative;
  background: linear-gradient(135deg, #ff6b8a 0%, #ff8fa3 50%, #ff8fa3 100%);
  padding: 56rpx 40rpx 90rpx;
}
.header-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.cu-avatar {
  width: 112rpx; height: 112rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.cu-avatar-img { width: 100%; height: 100%; }
.cu-avatar-char { font-size: 48rpx; font-weight: 700; color: #fff; }

.cu-info { flex: 1; min-width: 0; }
.cu-name {
  display: block;
  font-size: 40rpx; font-weight: 700; color: #fff;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  text-shadow: 0 2rpx 6rpx rgba(112, 35, 71, 0.16);
}
.cu-phone {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}
.round-btn {
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  color: #fff;
  font-size: 34rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.round-btn:active { background: rgba(255, 255, 255, 0.35); }
.btn-icon-phone { position:relative; width:34rpx; height:34rpx; border:5rpx solid #fff; border-top-color:transparent; border-right-color:transparent; border-radius:8rpx 8rpx 8rpx 18rpx; transform:rotate(-42deg); box-sizing:border-box; }
.btn-icon-phone::before,.btn-icon-phone::after { content:''; position:absolute; width:13rpx; height:7rpx; border-radius:5rpx; background:#fff; }
.btn-icon-phone::before { left:-7rpx; top:-2rpx; }.btn-icon-phone::after { right:-7rpx; bottom:-2rpx; }

/* 悬浮统计卡 */
.stats-card {
  position: absolute;
  left: 32rpx; right: 32rpx;
  bottom: -56rpx;
  background: linear-gradient(180deg, #fff8fb 0%, #ffffff 34%, #f8f9fc 100%);
  border-radius: 28rpx;
  padding: 28rpx 40rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 16rpx 36rpx rgba(57, 30, 43, 0.12);
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.stat-value {
  font-size: 34rpx; font-weight: 700; color: #1f2937;
  letter-spacing: -0.5rpx;
}
.stat-label { font-size: 22rpx; color: #6b7280; }
.stat-divider {
  width: 1rpx; height: 48rpx;
  background: #f0eaed;
}

/* ===== 卡片 ===== */
.card {
  margin: 20rpx 40rpx 0;
  background: linear-gradient(180deg, #fff8fb 0%, #ffffff 34%, #f8f9fc 100%);
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 24rpx rgba(36, 27, 41, 0.05);
}
.card-gap { margin-top: 84rpx; }
.business-card { margin-top: 84rpx; }
.business-card + .card-gap { margin-top: 20rpx; }

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.card-head .card-title { margin-bottom: 0; }
.card-title {
  display: block;
  font-size: 28rpx; font-weight: 600; color: #1f2937;
  margin-bottom: 20rpx;
}
.card-action {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  font-size: 24rpx; font-weight: 600; color: #ff6b8a;
  padding: 6rpx 40rpx;
  border-radius: 999rpx;
  background: #FFF1F6;
}
.lifecycle-summary { padding:7rpx 18rpx; border-radius:999rpx; background:#fff0f5; color:#b43e6f; font-size:21rpx; font-weight:700; }
.summary-grid { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; }
.summary-item { padding:20rpx; border-radius:20rpx; background:#faf5f7; }
.summary-label,.summary-value,.next-service-value,.cycle-hint { display:block; }
.summary-label { color:#8b7b84; font-size:22rpx; }
.summary-value { margin-top:8rpx; color:#33252d; font-size:26rpx; font-weight:700; }
.next-service-row { margin-top:18rpx; padding:22rpx; border-radius:20rpx; background:#fff0f5; display:flex; align-items:center; justify-content:space-between; gap:20rpx; }
.next-service-value { margin-top:8rpx; color:#b43e6f; font-size:28rpx; font-weight:700; }
.cycle-hint { max-width:260rpx; color:#8b6879; font-size:20rpx; line-height:1.45; text-align:right; }
.lifecycle-explanation { display:block; margin-top:18rpx; color:#8b7b84; font-size:21rpx; line-height:1.55; }

.muted {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.6;
}
.work-scroll { width:100%; white-space:nowrap; }
.work-row { display:inline-flex; gap:18rpx; padding:2rpx 2rpx 10rpx; }
.related-work { width:260rpx; padding:14rpx; border-radius:20rpx; background:#faf5f7; border:1rpx solid #f0e2e8; box-sizing:border-box; }
.related-work:active { background:#fff0f5; }.related-work-image { width:232rpx; height:180rpx; border-radius:15rpx; display:block; }.related-work-placeholder { background:linear-gradient(145deg,#f4e5eb,#e9e3f3); }
.related-work-title,.related-work-meta,.related-work-permission { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.related-work-title { margin-top:13rpx; color:#392a32; font-size:25rpx; font-weight:700; }.related-work-meta { margin-top:6rpx; color:#94838c; font-size:19rpx; }.related-work-permission { margin-top:7rpx; color:#a04c72; font-size:19rpx; }

/* 标签 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.tag {
  padding: 8rpx 40rpx;
  border-radius: 999rpx;
  background: #FFF1F6;
  color: #ff6b8a;
  font-size: 24rpx;
  font-weight: 500;
}
.tag-removable { min-height:88rpx; display:flex; align-items:center; background:#ffe0eb; color:#dc2626; }
.tag-addable { min-height:88rpx; display:flex; align-items:center; background:#F5F1F3; color:#6b7280; }
.tag-list.editable { margin-bottom: 8rpx; }

/* 信息行 */
.info-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f0f3;
  gap: 24rpx;
}
.info-row:last-child { border-bottom: none; }
.info-label {
  flex-shrink: 0;
  width: 120rpx;
  font-size: 26rpx;
  color: #6b7280;
}
.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #1f2937;
  line-height: 1.5;
  word-break: break-all;
}
.info-value-block {
  flex: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}
.addr-text {
  flex: 1;
  font-size: 26rpx; color: #1f2937; line-height: 1.5;
}
.copy-link { min-height: 88rpx;
  flex-shrink: 0;
  padding: 4rpx 40rpx;
  border-radius: 14rpx;
  background: #FFF1F6;
  color: #ff6b8a;
  font-size: 22rpx; font-weight: 600;
}
.follow-input { width:100%; min-height:176rpx; padding:22rpx; border-radius:20rpx; box-sizing:border-box; background:#faf5f7; color:#33252d; font-size:26rpx; line-height:1.55; }
.follow-plan-row { margin-top:16rpx; display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.follow-date,.follow-add,.follow-complete { min-height:88rpx; display:flex; align-items:center; justify-content:center; border-radius:22rpx; font-size:24rpx; }
.follow-date { padding:0 24rpx; background:#f5f1f3; color:#6b5d65; }
.follow-add { padding:0 30rpx; background:#fff0f5; color:#b43e6f; font-weight:700; }
.follow-list { margin-top:24rpx; display:flex; flex-direction:column; gap:14rpx; }
.follow-item { display:flex; align-items:center; gap:16rpx; padding:20rpx; border-radius:20rpx; background:#faf7f8; }
.follow-main { flex:1; min-width:0; }
.follow-content,.follow-meta { display:block; }
.follow-content { color:#33252d; font-size:25rpx; line-height:1.5; }
.follow-meta { margin-top:7rpx; color:#94838c; font-size:20rpx; }
.follow-complete { flex-shrink:0; min-width:112rpx; padding:0 20rpx; background:#e8f7ee; color:#238b57; font-weight:700; }

/* 预约记录 */
.order-list { display: flex; flex-direction: column; gap: 16rpx; }

.order-card {
  background: #f9f4f6;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
}

.order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.order-date { font-size: 24rpx; color: #6b7280; }

.order-status {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 20rpx; font-weight: 600;
  flex-shrink: 0;
}
.tone-orange  { background: #fff2dc; color: #c97f1a; }
.tone-purple  { background: #f0e9ff; color: #7c5dd4; }
.tone-yellow  { background: #fff8d6; color: #a48313; }
.tone-emerald { background: #e3f6ec; color: #067b4a; }
.tone-teal    { background: #d8f1ee; color: #107d70; }
.tone-sky     { background: #dbecff; color: #1f6dd6; }
.tone-gray    { background: #f4f5f7; color: #8a8f98; }
.tone-red     { background: #ffe5e6; color: #c5333d; }

.order-mid {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.order-type {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx; font-weight: 600;
}
.type-home { background: #e3f6ec; color: #067b4a; }
.type-shop { background: #dbecff; color: #1f6dd6; }
.order-svc-name {
  font-size: 28rpx; font-weight: 500; color: #1f2937;
  flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.order-bot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.order-price {
  font-size: 32rpx; font-weight: 700; color: #ff6b8a;
}
.order-price-pending {
  font-size: 26rpx; font-weight: 500; color: #6b7280;
}
.order-detail-btn {
  min-height: 88rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #ff6b8a;
  font-size: 24rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  border: 1rpx solid #ffd0de;
}
.order-detail-btn:active { opacity: 0.7; }

/* ===== 底部操作 ===== */
.bottom-actions {
  position: fixed;
  left: 0; right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #fff8fb 0%, #ffffff 34%, #f8f9fc 100%);
  padding: 16rpx 40rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}
.action-btn {
  height: 88rpx;
  border-radius: 48rpx;
  font-size: 30rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
}
.action-btn:active { opacity: 0.85; }
.action-primary {
  background: linear-gradient(135deg, #ff6b8a 0%, #ff8fa3 100%);
  color: #fff;
  box-shadow: 0 8rpx 16rpx rgba(255, 95, 134, 0.22);
}
.is-disabled { opacity: 0.5; }

/* ===== 底部弹层 ===== */
.sheet-mask {
  position: fixed; inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 200;
}
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 201;
  background: linear-gradient(180deg, #fff8fb 0%, #ffffff 34%, #f8f9fc 100%);
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.25s ease-out;
}
.sheet-show { transform: translateY(0); }
.sheet-header {
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f5f0f3;
}
.sheet-title { font-size: 32rpx; font-weight: 600; color: #1f2937; }
.sheet-close {
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  background: #f5f1f3;
  color: #6b7280;
  font-size: 28rpx;
  display: flex; align-items: center; justify-content: center;
}
.sheet-body {
  padding: 24rpx 40rpx;
  max-height: 60vh;
}
.sheet-footer {
  padding: 16rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f5f0f3;
}

.sub-label {
  display: block;
  font-size: 24rpx;
  color: #7f7681;
  margin: 20rpx 0 12rpx;
}
.sub-label:first-child { margin-top: 0; }

.new-tag-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}
.new-tag-input  {
  flex: 1;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #1f2937;
}
.new-tag-btn {
  flex-shrink: 0;
  padding: 0 32rpx;
  height: 88rpx;
  border-radius: 14rpx;
  background: #FFF1F6;
  color: #ff6b8a;
  font-size: 26rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
}
