page { background: var(--bg-gradient-entry); }

.page {
  min-height: 100vh;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}
.page-with-archive { padding-bottom: calc(292rpx + env(safe-area-inset-bottom)); }

/* ===== 加载/空 ===== */
.loading-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}
.spinner {
  width: 48rpx; height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid #ffd8e3;
  border-top-color: var(--brand-primary);
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: var(--font-sm); color: var(--text-muted); }
.load-error { min-height:100vh; box-sizing:border-box; padding:120rpx 48rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; background:#f7f5f6; text-align:center; }
.load-error-mark { width:88rpx; height:88rpx; margin-bottom:28rpx; border-radius:50%; background:#fff0f4; color:#c75b83; font-size: var(--font-xl); line-height:88rpx; }
.load-error-title { color:#382a31; font-size: var(--font-lg); font-weight: var(--weight-semibold); }.load-error-desc { margin-top:12rpx; color:#796872; font-size: var(--font-sm); }
.retry-btn { min-height:88rpx; margin:44rpx 0 0; padding:0 56rpx; border:0; border-radius: var(--radius-xl); background:#1f2937; color: var(--text-inverse); font-size: var(--font-md); line-height:88rpx; }.retry-btn::after { border:0; }

/* ===== Header ===== */
.header {
  position: relative;
  background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-primary-light) 50%, var(--brand-primary-light) 100%);
  padding: 56rpx 40rpx 90rpx;
}
.header-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.cu-avatar {
  width: 112rpx; height: 112rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.cu-avatar-img { width: 100%; height: 100%; }
.cu-avatar-char { font-size: var(--font-2xl); font-weight: var(--weight-bold); color: var(--text-inverse); }

.cu-info { flex: 1; min-width: 0; }
.cu-name {
  display: block;
  font-size: var(--font-xl); font-weight: var(--weight-bold); color: var(--text-inverse);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  text-shadow: 0 2rpx 6rpx rgba(112, 35, 71, 0.16);
}
.remark-row { align-items:center; }
.remark-value-wrap { flex:1; min-width:0; display:flex; align-items:center; overflow:hidden; white-space:nowrap; }
.remark-value { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--text-primary); font-size:var(--font-sm); }
.account-name { flex-shrink:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--text-muted); font-size:var(--font-sm); }
.cu-phone {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.85);
}
.round-btn {
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  color: var(--text-inverse);
  font-size: var(--font-lg);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.round-btn:active { background: rgba(255, 255, 255, 0.35); }
.phone-icon { width:44rpx; height:44rpx; }

/* 悬浮统计卡 */
.stats-card {
  position: absolute;
  left: 32rpx; right: 32rpx;
  bottom: -56rpx;
  background: var(--bg-gradient-entry);
  border-radius: var(--radius-lg);
  padding: 28rpx 40rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 16rpx 36rpx rgba(57, 30, 43, 0.12);
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.stat-value {
  font-size: var(--font-lg); font-weight: var(--weight-bold); color: var(--text-primary);
  letter-spacing: -0.5rpx;
}
.stat-label { font-size: var(--font-xs); color: var(--text-muted); }
.stat-divider {
  width: 1rpx; height: 48rpx;
  background: #f0eaed;
}

/* ===== 卡片 ===== */
.card {
  margin: 20rpx 40rpx 0;
  background: var(--bg-gradient-entry);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: 0 12rpx 24rpx rgba(36, 27, 41, 0.05);
}
.card-gap { margin-top: 84rpx; }
.business-card { margin-top: 84rpx; }
.business-card + .card-gap { margin-top: 20rpx; }

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.card-head .card-title { margin-bottom: 0; }
.card-title {
  display: block;
  font-size: var(--font-md); font-weight: var(--weight-semibold); color: var(--text-primary);
  margin-bottom: 20rpx;
}
.card-action {
  position: relative;
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm); font-weight: var(--weight-semibold); color: var(--brand-primary);
  padding: 0 28rpx;
  background: transparent;
  z-index: 0;
}
.card-action::before { content:''; position:absolute; left:8rpx; right:8rpx; top:12rpx; bottom:12rpx; z-index:-1; border-radius:999rpx; background:#FFF1F6; }
.lifecycle-summary { padding:7rpx 18rpx; border-radius:999rpx; background: var(--bg-tag); color:#b43e6f; font-size: var(--font-xs); font-weight: var(--weight-bold); }
.summary-grid { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; }
.summary-item { padding:20rpx; border-radius: var(--radius-md); background:#faf5f7; }
.summary-label,.summary-value,.next-service-value,.cycle-hint { display:block; }
.summary-label { color:#8b7b84; font-size: var(--font-xs); }
.summary-value { margin-top:8rpx; color:#33252d; font-size: var(--font-sm); font-weight: var(--weight-bold); }
.next-service-row { margin-top:18rpx; padding:22rpx; border-radius: var(--radius-md); background: var(--bg-tag); display:flex; align-items:center; justify-content:space-between; gap:20rpx; }
.next-service-value { margin-top:8rpx; color:#b43e6f; font-size: var(--font-md); font-weight: var(--weight-bold); }
.cycle-hint { max-width:260rpx; color:#8b6879; font-size: var(--font-xs); line-height:1.45; text-align:right; }
.lifecycle-explanation { display:block; margin-top:18rpx; color:#8b7b84; font-size: var(--font-xs); line-height:1.55; }

.muted {
  font-size: var(--font-sm);
  color: var(--text-muted);
  line-height: 1.6;
}
.work-scroll { width:100%; white-space:nowrap; }
.work-row { display:inline-flex; gap:18rpx; padding:2rpx 2rpx 10rpx; }
.related-work { width:260rpx; padding:14rpx; border-radius: var(--radius-md); background:#faf5f7; border:1rpx solid #f0e2e8; box-sizing:border-box; }
.related-work:active { background: var(--bg-tag); }.related-work-image { width:232rpx; height:180rpx; border-radius:15rpx; display:block; }.related-work-placeholder { background:linear-gradient(145deg,#f4e5eb,#e9e3f3); }
.related-work-title,.related-work-meta,.related-work-permission { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.related-work-title { margin-top:13rpx; color:#392a32; font-size: var(--font-sm); font-weight: var(--weight-bold); }.related-work-meta { margin-top:6rpx; color:#94838c; font-size: var(--font-xs); }.related-work-permission { margin-top:7rpx; color:#a04c72; font-size: var(--font-xs); }

/* 标签 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.tag {
  padding: 8rpx 40rpx;
  border-radius: 999rpx;
  background: #FFF1F6;
  color: var(--brand-primary);
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
}
.tag-removable { min-height:88rpx; display:flex; align-items:center; background:#ffe0eb; color: var(--text-error); }
.tag-addable { min-height:88rpx; display:flex; align-items:center; background:#F5F1F3; color: var(--text-muted); }
.tag-list.editable { margin-bottom: 8rpx; }

/* 信息行 */
.info-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f0f3;
  gap: 24rpx;
}
.info-action-row { display:grid; grid-template-columns:120rpx minmax(0,1fr) 104rpx; min-height:88rpx; align-items:center; gap:24rpx; }
.info-row:last-child { border-bottom: none; }
.info-label {
  flex-shrink: 0;
  width: 120rpx;
  font-size: var(--font-sm);
  color: var(--text-muted);
}
.info-value {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--text-primary);
  line-height: var(--leading-normal);
  word-break: break-all;
}
.addr-text {
  min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
  font-size: var(--font-sm); color: var(--text-primary); line-height: var(--leading-normal);
}
.inline-action { position:relative; display:flex; width:104rpx; min-height:88rpx; align-items:center; justify-content:center; color:var(--brand-primary); font-size:var(--font-xs); font-weight:var(--weight-semibold); z-index:0; }
.inline-action::before { content:''; position:absolute; left:4rpx; right:4rpx; top:12rpx; bottom:12rpx; z-index:-1; border-radius:999rpx; background:#FFF1F6; }
.inline-action:active::before { background:#ffe5ee; }
.follow-input { width:100%; min-height:176rpx; padding:22rpx; border-radius: var(--radius-md); box-sizing:border-box; background:#faf5f7; color:#33252d; font-size: var(--font-sm); line-height:1.55; }
.follow-plan-row { margin-top: var(--space-sm); display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.follow-date,.follow-add,.follow-complete { position:relative; min-height:88rpx; display:flex; align-items:center; justify-content:center; font-size: var(--font-sm); z-index:0; }
.follow-date::before,.follow-add::before,.follow-complete::before { content:''; position:absolute; left:0; right:0; top:12rpx; bottom:12rpx; z-index:-1; border-radius:999rpx; }
.follow-date { padding:0 24rpx; color:#6b5d65; }
.follow-date::before { background:#f5f1f3; }
.follow-add { padding:0 30rpx; color:#b43e6f; font-weight: var(--weight-bold); }
.follow-add::before { background:var(--bg-tag); }
.follow-list { margin-top: var(--space-md); display:flex; flex-direction:column; gap:14rpx; }
.follow-item { display:flex; align-items:center; gap:16rpx; padding:20rpx; border-radius: var(--radius-md); background:#faf7f8; }
.follow-main { flex:1; min-width:0; }
.follow-content,.follow-meta { display:block; }
.follow-content { color:#33252d; font-size: var(--font-sm); line-height: var(--leading-normal); }
.follow-meta { margin-top:7rpx; color:#94838c; font-size: var(--font-xs); }
.follow-complete { flex-shrink:0; min-width:112rpx; padding:0 20rpx; color:#238b57; font-weight: var(--weight-bold); }
.follow-complete::before { background:#e8f7ee; }

/* 预约记录 */
.order-list { display: flex; flex-direction: column; gap: 16rpx; }

.order-card {
  background: #f9f4f6;
  border-radius: var(--radius-md);
  padding: var(--space-md) 28rpx;
}

.order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.order-date { font-size: var(--font-sm); color: var(--text-muted); }

.order-status {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: var(--font-xs); font-weight: var(--weight-semibold);
  flex-shrink: 0;
}
.tone-orange  { background: #fff2dc; color: #c97f1a; }
.tone-purple  { background: #f0e9ff; color: #7c5dd4; }
.tone-yellow  { background: #fff8d6; color: #a48313; }
.tone-emerald { background: #e3f6ec; color: #067b4a; }
.tone-teal    { background: #d8f1ee; color: #107d70; }
.tone-sky     { background: #dbecff; color: #1f6dd6; }
.tone-gray    { background: #f4f5f7; color: #8a8f98; }
.tone-red     { background: #ffe5e6; color: #c5333d; }

.order-mid {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.order-type {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: var(--font-xs); font-weight: var(--weight-semibold);
}
.type-home { background: #e3f6ec; color: #067b4a; }
.type-shop { background: #dbecff; color: #1f6dd6; }
.order-svc-name {
  font-size: var(--font-md); font-weight: var(--weight-medium); color: var(--text-primary);
  flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.order-bot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.order-price {
  font-size: var(--font-lg); font-weight: var(--weight-bold); color: var(--brand-primary);
}
.order-price-pending {
  font-size: var(--font-sm); font-weight: var(--weight-medium); color: var(--text-muted);
}
.order-detail-btn {
  position: relative;
  min-height: 88rpx;
  padding: 0 32rpx;
  color: var(--brand-primary);
  font-size: var(--font-sm); font-weight: var(--weight-semibold);
  display: flex; align-items: center; justify-content: center;
  z-index: 0;
}
.order-detail-btn::before { content:''; position:absolute; left:0; right:0; top:12rpx; bottom:12rpx; z-index:-1; border:1rpx solid #ffd0de; border-radius:999rpx; background:var(--bg-card); }
.order-detail-btn:active { opacity: 0.7; }

/* ===== 底部操作 ===== */
.bottom-actions {
  position: fixed;
  left: 0; right: 0;
  bottom: 0;
  background: var(--bg-gradient-entry);
  padding: 16rpx 40rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}
.action-btn {
  height: 88rpx;
  border-radius: var(--btn-radius);
  font-size: var(--font-md); font-weight: var(--weight-semibold);
  display: flex; align-items: center; justify-content: center;
}
.action-btn:active { opacity: 0.85; }
.action-primary {
  background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-primary-light) 100%);
  color: var(--text-inverse);
  box-shadow: 0 8rpx 16rpx rgba(255, 95, 134, 0.22);
}
.archive-btn {
  min-height: 88rpx;
  margin-top: 12rpx;
  border: 2rpx solid var(--border-default);
  border-radius: var(--radius-xl);
  background: var(--bg-card);
  color: var(--text-body);
  font-size: var(--font-sm);
  line-height: 88rpx;
  text-align: center;
}
.archive-btn:active { background: var(--bg-page); }
.is-disabled { opacity: 0.5; }

/* ===== 底部弹层 ===== */
.sheet-mask {
  position: fixed; inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 200;
}
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 201;
  background: var(--bg-gradient-entry);
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.25s ease-out;
}
.sheet-show { transform: translateY(0); }
.sheet-header {
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f5f0f3;
}
.sheet-title { font-size: var(--font-lg); font-weight: var(--weight-semibold); color: var(--text-primary); }
.sheet-close {
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  background: #f5f1f3;
  color: var(--text-muted);
  font-size: var(--font-md);
  display: flex; align-items: center; justify-content: center;
}
.sheet-body {
  padding: var(--space-md) 40rpx;
  max-height: 60vh;
}
.sheet-footer {
  padding: 16rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f5f0f3;
}

.sub-label {
  display: block;
  font-size: var(--font-sm);
  color: #7f7681;
  margin: 20rpx 0 12rpx;
}
.sub-label:first-child { margin-top: 0; }

.new-tag-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}
.new-tag-input  {
  flex: 1;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  font-size: var(--font-md);
  color: var(--text-primary);
}
.new-tag-btn {
  position: relative;
  flex-shrink: 0;
  padding: 0 32rpx;
  height: 88rpx;
  color: var(--brand-primary);
  font-size: var(--font-sm); font-weight: var(--weight-semibold);
  display: flex; align-items: center; justify-content: center;
  z-index: 0;
}
.new-tag-btn::before { content:''; position:absolute; left:0; right:0; top:12rpx; bottom:12rpx; z-index:-1; border-radius:999rpx; background:#FFF1F6; }

/* ===== 客户备注弹窗 ===== */
.remark-modal-mask { position:fixed; inset:0; z-index:300; display:flex; padding:0 48rpx; box-sizing:border-box; align-items:center; justify-content:center; background:rgba(31,24,28,.42); }
.remark-modal { width:100%; padding:40rpx; box-sizing:border-box; border-radius:28rpx; background:var(--bg-card); box-shadow:0 24rpx 64rpx rgba(43,31,38,.18); }
.remark-modal-title { display:block; color:var(--text-primary); font-size:var(--font-lg); font-weight:var(--weight-bold); }
.remark-modal-help { display:block; margin-top:10rpx; overflow:hidden; color:var(--text-muted); font-size:var(--font-sm); text-overflow:ellipsis; white-space:nowrap; }
.remark-input { height:96rpx; margin-top:28rpx; padding:0 24rpx; box-sizing:border-box; border:2rpx solid var(--border-default); border-radius:20rpx; background:var(--bg-input); color:var(--text-primary); font-size:var(--font-md); }
.remark-modal-actions { display:flex; gap:16rpx; margin-top:28rpx; }
.remark-modal-btn { flex:1; display:flex; min-height:88rpx; align-items:center; justify-content:center; border-radius:999rpx; font-size:var(--font-md); font-weight:var(--weight-semibold); }
.remark-cancel { border:2rpx solid var(--border-default); color:var(--text-body); }
.remark-confirm { background:var(--brand-primary); color:var(--text-inverse); }
