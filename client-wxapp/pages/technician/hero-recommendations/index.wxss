@import '../../../styles/tokens.wxss';
@import '../../../styles/booking-actions.wxss';
.page { min-height:100vh; background:var(--nb-page); color:var(--nb-ink); }
.content { padding:24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); }
.heading { margin-bottom:24rpx; }
.title { display:block; font-size:var(--font-md); font-weight:var(--weight-semibold); }
.hint { display:block; margin-top:12rpx; color:var(--nb-muted); font-size:var(--font-xs); line-height:1.6; }
.work-row { padding:24rpx; margin-bottom:20rpx; border-radius:20rpx; background:var(--nb-surface); }
.work-main { display:flex; gap:20rpx; align-items:center; }
.cover { width:128rpx; height:128rpx; border-radius:12rpx; flex-shrink:0; background:var(--nb-page); }
.work-info { min-width:0; }
.work-title { font-size:var(--font-sm); overflow:hidden; text-overflow:ellipsis; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; text-align:left; }
.actions { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12rpx; margin-top:20rpx; }
.booking-action { width:100%; margin:0; background:var(--nb-soft-surface); color:var(--nb-secondary); }
.booking-action::after,.choice::after { border:0; }
.booking-action:active,.choice:active { background:var(--nb-pressed); }
.booking-action[disabled],.choice[disabled] { background:var(--nb-pressed); color:var(--nb-control); }
.add { background:var(--nb-action); color:var(--nb-inverse); }
.add:active { background:var(--nb-action-pressed); }
.state { padding:40rpx 0; font-size:var(--font-sm); color:var(--nb-muted); line-height:1.6; }
.mask { position:fixed; inset:0; z-index:1000; background:rgba(0,0,0,.4); display:flex; align-items:flex-end; }
.sheet { width:100%; box-sizing:border-box; border-radius:24rpx 24rpx 0 0; background:var(--nb-surface); padding:24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); }
.sheet-head { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.sheet-head .sheet-close { width:auto; min-width:44px; padding:0 24rpx; margin-left:auto; margin-right:0; flex-shrink:0; }
.choices { display:block; width:100%; height:50vh; max-height:60vh; margin-top:16rpx; }
button.choice { width:100%; min-height:144rpx; padding:16rpx; margin:0 0 12rpx; display:flex; align-items:center; gap:20rpx; box-sizing:border-box; text-align:left; line-height:normal; background:var(--nb-soft-surface); color:var(--nb-ink); border-radius:16rpx; }
.choice-cover { width:112rpx; height:112rpx; border-radius:12rpx; flex-shrink:0; background:var(--nb-page); }
.choice-copy { min-width:0; flex:1; display:flex; flex-direction:column; align-items:flex-start; gap:10rpx; }
.choice-title { width:100%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:var(--font-sm); font-weight:var(--weight-semibold); color:var(--nb-ink); }
.choice-meta { font-size:var(--font-xs); line-height:1.5; color:var(--nb-muted); }
.choice-arrow { flex-shrink:0; padding:0 8rpx; font-size:var(--font-lg); color:var(--nb-muted); }
