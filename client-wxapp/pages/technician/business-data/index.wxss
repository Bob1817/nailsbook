page { background:linear-gradient(180deg,#fff8fb 0%,#fff 34%,#f8f9fc 100%); }
.page { min-height:100vh; padding: var(--space-md) 40rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing:border-box; }
.loading-card,.section-card { margin-bottom: var(--space-md); padding:32rpx; border:1rpx solid rgba(255,107,138,.08); border-radius: var(--radius-lg); background: var(--bg-card); box-shadow:0 10rpx 26rpx rgba(15,23,42,.05); }
.loading-card { color: var(--text-muted); text-align:center; }
.summary-hero { position:relative; overflow:hidden; margin-bottom: var(--space-md); padding:38rpx 34rpx 30rpx; border-radius: var(--radius-lg); color: var(--text-inverse); background:linear-gradient(135deg,#ff668e,#f478a6 52%,#8b5cf6); box-shadow:0 20rpx 42rpx rgba(180,72,126,.2); }
.hero-caption { display:block; font-size: var(--font-sm); color:rgba(255,255,255,.82); }
.hero-value { display:block; margin-top:10rpx; font-size:60rpx; line-height:1.1; font-weight: var(--weight-bold); }
.hero-note { display:block; margin-top:10rpx; font-size: var(--font-xs); color:rgba(255,255,255,.72); }
.hero-grid { display:grid; grid-template-columns:repeat(3,1fr); margin-top:32rpx; padding-top:24rpx; border-top:1rpx solid rgba(255,255,255,.22); }
.hero-grid view { min-height:88rpx; display:flex; flex-direction:column; justify-content:center; border-right:1rpx solid rgba(255,255,255,.18); }
.hero-grid view:last-child { border-right:0; padding-left:18rpx; }.hero-grid view:nth-child(2) { padding-left:18rpx; }
.hero-grid text:first-child { font-size: var(--font-md); font-weight: var(--weight-bold); }.hero-grid text:last-child { margin-top:7rpx; font-size: var(--font-xs); color:rgba(255,255,255,.78); }
.section-title { display:block; font-size: var(--font-md); font-weight: var(--weight-bold); color: var(--text-primary); }
.section-head { display:flex; align-items:center; justify-content:space-between; }.section-link { min-height:88rpx; display:flex; align-items:center; color: var(--brand-primary); font-size: var(--font-sm); }
.export-button { min-height:88rpx; margin:0; padding:0 24rpx; display:flex; align-items:center; justify-content:center; border:0; border-radius:22rpx; background:#fff1f6; color:#db5278; font-size: var(--font-sm); font-weight: var(--weight-semibold); line-height:1; }.export-button::after { border:0; }.export-button:active { background:#ffe4ed; }.export-button[disabled] { color:#aa8793; background:#f8f2f4; }
.export-actions { display:flex; align-items:center; gap:12rpx; }
.trend-head { flex-direction:column; align-items:stretch; gap:20rpx; }
.trend-head .section-title { white-space:nowrap; }
.trend-head .export-actions { width:100%; }
.trend-head .export-button { flex:1 1 0; min-width:0; padding:0 16rpx; }
.metric-grid { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; margin-top: var(--space-md); }
.metric { min-height:152rpx; padding:22rpx; border-radius: var(--radius-md); background:#fff8fb; box-sizing:border-box; }.metric:active { background:#fff1f6; }
.metric-value,.metric-label,.metric-note { display:block; }.metric-value { font-size: var(--font-lg); font-weight: var(--weight-bold); color: var(--text-primary); }.metric-label { margin-top:8rpx; font-size: var(--font-sm); color: var(--text-body); }.metric-note { margin-top:6rpx; font-size: var(--font-xs); color:#8d8590; }
.sub-title { display:block; margin-top: var(--space-md); font-size: var(--font-sm); font-weight: var(--weight-semibold); color: var(--text-body); }.sub-title-gap { margin-top:34rpx; }
.trend-list { margin-top:14rpx; }.trend-row { min-height:72rpx; display:grid; grid-template-columns:.8fr 1.3fr 1fr; align-items:center; border-bottom:1rpx solid #f3edf0; font-size: var(--font-xs); color: var(--text-muted); }.trend-row text:last-child { text-align:right; font-weight: var(--weight-semibold); color: var(--text-body); }
.empty { display:block; margin-top:18rpx; padding:28rpx; border-radius: var(--card-radius); background:#faf7f8; color: var(--text-faint); font-size: var(--font-xs); text-align:center; }
.rank-row { min-height:88rpx; display:flex; align-items:center; justify-content:space-between; gap:16rpx; color: var(--text-body); font-size: var(--font-sm); }.rank-row view { display:flex; align-items:center; gap:14rpx; }.rank-label { width:40rpx; height:40rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; background:#fff1f6; color: var(--brand-primary); font-weight: var(--weight-bold); }.rank-row>text:last-child { color: var(--text-muted); }.divider { height:1rpx; margin:12rpx 0; background:#f1e8ed; }
.data-row,.reminder-row { min-height:108rpx; display:flex; align-items:center; justify-content:space-between; gap:18rpx; border-bottom:1rpx solid #f3edf0; }.data-row:last-child,.reminder-row:last-child { border-bottom:0; }.data-row view,.reminder-row view { min-width:0; }.data-row view text,.reminder-row view text { display:block; }.data-row view text:first-child,.reminder-row view text:first-child { color: var(--text-body); font-size: var(--font-sm); font-weight: var(--weight-semibold); }.data-row view text:last-child,.reminder-row view text:last-child { margin-top:7rpx; color:#8d8590; font-size: var(--font-xs); line-height:1.45; }.data-row>text,.reminder-row>text { flex-shrink:0; color: var(--brand-primary); font-size: var(--font-sm); font-weight: var(--weight-semibold); }
