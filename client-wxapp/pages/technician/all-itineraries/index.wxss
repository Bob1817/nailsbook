page {
  background: var(--bg-gradient-entry);
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== 统计栏 ===== */
.page-header {
  flex-shrink: 0;
  padding: 16rpx 40rpx 12rpx;
}
.page-count { font-size: var(--font-sm); color: var(--text-muted); }

/* ===== 列表 ===== */
.list-scroll { flex: 1; min-height: 0; }
.list-area { padding: 16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); }

/* ===== 骨架/空状态 ===== */
.skeleton-list { display: flex; flex-direction: column; gap: 16rpx; }
.skel-card {
  height: 200rpx;
  border-radius: var(--card-radius);
  background: var(--bg-input);
  animation: skel 1.4s linear infinite;
}
@keyframes skel { 0%{opacity:1;} 50%{opacity:0.5;} 100%{opacity:1;} }

.empty-card {
  margin: 80rpx 0;
  padding: 60rpx 40rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  border: 2rpx solid var(--border-light);
  box-shadow: var(--shadow-lg);
}
.empty-title { font-size: var(--font-md); font-weight: var(--weight-semibold); color: var(--text-primary); }
.empty-sub { font-size: var(--font-sm); color: var(--text-muted); text-align: center; }
.retry-btn { display:flex; min-height:var(--touch-min); margin-top:22rpx; padding:0 38rpx; align-items:center; justify-content:center; border-radius: var(--btn-radius); background: var(--bg-tag); color:var(--brand-primary); font-size: var(--font-sm); font-weight: var(--weight-semibold); }

/* ===== 行程卡片 ===== */
.trip-list { display: flex; flex-direction: column; gap: 16rpx; }
.trip-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  border: 2rpx solid var(--border-light);
  box-shadow: var(--shadow-lg);
}
.trip-card:active { background: #fef7f9; }

.trip-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.trip-time {
  width: 88rpx;
  flex-shrink: 0;
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
}
.trip-avatar {
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  background: var(--bg-page);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.trip-avatar-img { width: 100%; height: 100%; }
.trip-avatar-char { font-size: var(--font-sm); font-weight: var(--weight-semibold); color: var(--text-muted); }

.trip-info { flex: 1; min-width: 0; }
.trip-name { display: block; font-size: var(--font-md); font-weight: var(--weight-semibold); color: var(--text-primary); }
.trip-svc {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-xs);
  color: var(--text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.trip-status {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-xs);
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
}
.tone-orange  { background: var(--tone-amber-bg); color: var(--tone-amber-text); }
.tone-purple  { background: var(--tone-purple-bg); color: var(--tone-purple-text); }
.tone-yellow  { background: var(--tone-yellow-bg); color: var(--tone-yellow-text); }
.tone-emerald { background: var(--tone-emerald-bg); color: var(--tone-emerald-text); }
.tone-teal    { background: var(--tone-teal-bg); color: var(--tone-teal-text); }
.tone-sky     { background: var(--tone-sky-bg); color: var(--tone-sky-text); }
.tone-gray    { background: var(--tone-gray-bg); color: var(--tone-gray-text); }
.tone-red     { background: var(--tone-rose-bg); color: var(--tone-rose-text); }

.trip-addr {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  background: var(--bg-gradient-entry);
  border-radius: var(--radius-md);
  font-size: var(--font-xs);
  line-height: var(--leading-normal);
  color: var(--text-muted);
  border: 1rpx solid var(--border-neutral);
}

.trip-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
}
.trip-btn {
  flex: 1;
  min-height: var(--touch-min);
  height: var(--touch-min);
  border-radius: var(--btn-radius);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: var(--font-sm);
  font-weight: var(--weight-semibold);
}
.trip-btn:active { opacity: 0.85; }
.trip-primary {
  background: var(--brand-gradient);
  color: var(--text-inverse);
  box-shadow: 0 8rpx 18rpx rgba(255, 107, 138, 0.22);
}
.trip-ghost {
  background: var(--bg-card);
  color: var(--brand-primary);
  border: 2rpx solid var(--border-light);
}
