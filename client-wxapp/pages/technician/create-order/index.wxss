@import '../../../styles/booking-form.wxss';
@import '../../../styles/booking-actions.wxss';
page { background: var(--bg-page); color: var(--text-primary); }
.booking-page { padding: var(--space-md) var(--space-md) calc(220rpx + env(safe-area-inset-bottom)); }
.section { padding: var(--space-md); margin-bottom: var(--space-md); background: var(--bg-card); border-radius: var(--radius-card); }
.section-title, .section-sub, .field-label { display: block; margin-bottom: var(--space-sm); }
.section-sub { color: var(--text-secondary); }
.form-input { background: var(--bg-page); margin-bottom: var(--space-sm); }
.service-choice { display: flex; align-items: center; min-height: 44px; font-size: var(--font-sm); }
.customer-button { width: 100%; margin: 12rpx 0; }
.selected { border: 1px solid var(--text-primary); }
.picker-value { display: flex; align-items: center; }
.remark-input { width: 100%; padding: 20rpx; box-sizing: border-box; margin-top: var(--space-sm); background: var(--bg-page); }
.reference { display: inline-flex; flex-direction: column; width: 180rpx; margin: var(--space-xs); }
.reference image { width: 180rpx; height: 180rpx; }
.submit-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx var(--space-md) calc(20rpx + env(safe-area-inset-bottom)); background: rgba(255, 255, 255, 0.86); -webkit-backdrop-filter: blur(20px) saturate(180%); backdrop-filter: blur(20px) saturate(180%); border-top: 1rpx solid rgba(0, 0, 0, 0.06); box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.04); }
.submit-btn { background: var(--text-primary); color: var(--bg-card); }
