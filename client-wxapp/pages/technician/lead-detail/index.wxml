<nav-bar title="线索详情" showBack/><view class="page" wx:if="{{lead}}"><view class="card"><view class="head"><text class="name">{{lead.nickname || '匿名咨询'}}</text><text>{{lead.statusText}}</text></view><text class="row">联系方式：{{lead.contact || '未填写'}}</text><text class="row">来源：{{lead.sourceText}}</text><text wx:if="{{lead.sourceWork}}" class="row">意向作品：{{lead.sourceWork.title}}</text><text class="row">需求：{{lead.requirement || '未填写'}}</text><text class="row">预算：{{lead.budget || '未填写'}}</text><text class="row {{lead.overdue ? 'overdue' : ''}}">{{lead.overdue ? '跟进已逾期：' : '下次跟进：'}}{{lead.nextText || '未设置'}}</text></view><view class="card"><text class="title">添加跟进</text><textarea data-field="content" value="{{content}}" bindinput="input" placeholder="记录沟通结果和下一步动作" confirm-type="done" /><picker mode="date" bindchange="date"><view class="field">{{nextFollowUpAt || '设置下次跟进日期'}}</view></picker><button class="primary" bindtap="follow">保存跟进</button></view><view class="card"><text class="title">线索状态</text><view class="actions"><button data-status="following_up" bindtap="status">跟进中</button><button data-status="paused" bindtap="status">暂缓</button></view><picker range="{{lostReasons}}" range-key="1" bindchange="reason"><view class="field">{{lostReason || '选择未成交原因'}}</view></picker><button class="danger" data-status="lost" bindtap="status">标记未成交</button><view class="actions"><button bindtap="customer">转为客户</button><button class="primary" bindtap="booking">转为预约</button></view></view><view class="card"><text class="title">操作时间线</text><view wx:for="{{lead.timeline}}" wx:key="id" class="timeline"><view class="dot"></view><view><text class="event">{{item.title}}</text><text class="time">{{item.time}}</text></view></view></view></view>
