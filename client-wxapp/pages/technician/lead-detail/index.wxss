.page{min-height:100vh;background:var(--nb-page);padding:24rpx}.card{background:var(--nb-surface);border-radius:24rpx;padding:28rpx;margin-bottom:20rpx}.head,.actions{display:flex;gap:14rpx;justify-content:space-between}.name,.title{font-size:32rpx;font-weight:700}.row{display:block;margin-top:16rpx;color:var(--nb-secondary)}.overdue{color:var(--nb-ink);font-weight:600}textarea,.field{width:100%;min-height:88rpx;background:var(--nb-page);border-radius:16rpx;padding:20rpx;box-sizing:border-box;margin-top:18rpx}textarea{height:180rpx}button{min-height:88rpx;margin-top:18rpx;border-radius:18rpx;flex:1}.primary{background:var(--nb-ink);color:var(--nb-surface)}.danger{color:var(--nb-ink);background:var(--nb-page)}.timeline{display:flex;gap:18rpx;padding:22rpx 0;border-bottom: 0;}.dot{width:16rpx;height:16rpx;margin-top:10rpx;border-radius:50%;background:var(--nb-action)}.event,.time{display:block}.time{margin-top:8rpx;color:var(--nb-muted);font-size:24rpx}
@import '../../../styles/booking-actions.wxss';
.page button.booking-action { min-height:44px; height:44px; margin-top:18rpx; border-radius:8px; font-size:var(--font-sm); line-height:1.4; }
.page textarea,.page .field { font-size:var(--font-sm); border-radius:var(--input-radius); }
