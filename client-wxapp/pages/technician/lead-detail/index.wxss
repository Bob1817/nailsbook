.page{min-height:100vh;background:#f7f5f2;padding:24rpx}.card{background:#fff;border-radius:24rpx;padding:28rpx;margin-bottom:20rpx}.head,.actions{display:flex;gap:14rpx;justify-content:space-between}.name,.title{font-size:32rpx;font-weight:700}.row{display:block;margin-top:16rpx;color:#5e5550}.overdue{color:#c64141;font-weight:600}textarea,.field{width:100%;min-height:88rpx;background:#f7f5f2;border-radius:16rpx;padding:20rpx;box-sizing:border-box;margin-top:18rpx}textarea{height:180rpx}button{min-height:88rpx;margin-top:18rpx;border-radius:18rpx;flex:1}.primary{background:#211b18;color:#fff}.danger{color:#b22f2f;background:#fff0f0}.timeline{display:flex;gap:18rpx;padding:22rpx 0;border-bottom:1rpx solid #eee}.dot{width:16rpx;height:16rpx;margin-top:10rpx;border-radius:50%;background:#9b6155}.event,.time{display:block}.time{margin-top:8rpx;color:#8b817c;font-size:24rpx}
