<view class="page">
  <!-- Loading -->
  <view wx:if="{{loading}}" class="loading-screen">
    <view class="loading-spinner"></view>
  </view>

  <view wx:elif="{{loadFailed}}" class="load-error" aria-live="polite">
    <view class="load-error-mark">!</view>
    <text class="load-error-title">{{loadErrorText}}</text>
    <text wx:if="{{canRetryLoad}}" class="load-error-desc">请检查网络后重试</text>
    <button wx:if="{{canRetryLoad}}" class="retry-btn" bindtap="loadWork">重新加载</button>
    <button class="back-btn-error" bindtap="goBack">返回</button>
  </view>

  <view wx:elif="{{work.id}}" class="detail-container">
    <!-- 固定关闭按钮（左上角） -->
    <view class="header-fixed">
      <view class="header-btn" bindtap="goBack">
        <view class="header-close-icon"></view>
      </view>
    </view>

    <!-- Image Slider -->
    <view class="image-slider">
      <scroll-view
        scroll-x
        enhanced
        show-scrollbar="{{false}}"
        scroll-into-view="{{scrollTarget}}"
        bindscroll="onImageScroll"
        class="image-scroll"
      >
        <view class="image-list">
          <view
            wx:for="{{imageUrls}}"
            wx:key="index"
            id="img-{{index}}"
            class="image-item"
            bindtap="openViewer"
            data-index="{{index}}"
          >
            <image src="{{item}}" mode="aspectFill" class="slide-image" aria-label="{{work.title || '美甲作品'}}第{{index + 1}}张图片" />
          </view>
        </view>
      </scroll-view>
      <!-- Image indicators -->
      <view wx:if="{{imageUrls.length > 1}}" class="image-dots">
        <view
          wx:for="{{imageUrls}}"
          wx:key="index"
          class="dot {{index === currentImageIndex ? 'dot-active' : ''}}"
        ></view>
      </view>
    </view>

    <!-- White Info Panel -->
    <view class="info-panel">
      <!-- Title block -->
      <view class="title-block">
        <view class="title-row">
          <text class="work-title">{{work.title || '未命名作品'}}</text>
          <text wx:if="{{work.price}}" class="work-price">¥{{work.price}}</text>
        </view>
        <text wx:if="{{work.shareEventCount}}" class="share-stat">分享传播 {{work.shareEventCount}} 次</text>
        <text wx:if="{{work.description}}" class="work-desc">{{work.description}}</text>
        <view wx:if="{{work.designIdea || work.suitableScene || work.recommendationScore}}" class="work-aesthetic">
          <text wx:if="{{work.designIdea}}" class="work-aesthetic-line">设计理念 · {{work.designIdea}}</text>
          <text wx:if="{{work.suitableScene}}" class="work-aesthetic-line">适合场景 · {{work.suitableScene}}</text>
          <text wx:if="{{work.recommendationScore}}" class="work-aesthetic-line">推荐指数 · {{work.recommendationScore}} / 5</text>
        </view>
        <view wx:if="{{work.tags && work.tags.length > 0}}" class="tags-row">
          <text wx:for="{{work.tags}}" wx:key="*this" class="tag">#{{item}}</text>
        </view>
        <view wx:if="{{work.visibilityScope === 'authorized_clients' && work.clientAccesses.length}}" class="access-summary">
          <text class="access-summary-label">客户专属作品</text>
          <text class="access-summary-name">已关联 {{work.clientAccesses[0].customer.name}}</text>
          <text class="access-summary-permissions">{{work.clientAccesses[0].canShare ? '可分享' : '不可分享'}} · {{work.clientAccesses[0].canFavorite ? '可收藏' : '不可收藏'}} · {{work.clientAccesses[0].canComment ? '可评论' : '不可评论'}}</text>
        </view>
      </view>

      <!-- Comments section -->
      <view class="comments-section">
        <view class="comments-header">
          <text class="comments-title">评论</text>
          <text class="comments-count">{{visibleComments.length}} 条</text>
        </view>

        <view wx:if="{{visibleComments.length > 0}}" class="comments-list">
          <view wx:for="{{visibleComments}}" wx:key="id" class="comment-item">
            <view class="comment-avatar-wrap">
              <image wx:if="{{item.user.avatarUrl}}" src="{{item.user.avatarUrl}}" class="comment-avatar" lazy-load aria-label="{{item.user.name || '用户'}}的头像" />
              <view wx:else class="comment-avatar-placeholder {{item.user.role === 'technician' ? 'avatar-tech' : ''}}">
                <text class="avatar-text">{{item.user.name[0]}}</text>
              </view>
            </view>
            <view class="comment-body">
              <view class="comment-bubble">
                <view class="comment-name-row">
                  <text class="comment-name">{{item.user.name}}</text>
                  <text wx:if="{{item.user.role === 'technician'}}" class="role-badge">美甲师</text>
                  <text wx:if="{{item.isPinned}}" class="pin-badge">置顶</text>
                  <text class="comment-time">{{item.createdAtText}}</text>
                </view>
                <text class="comment-content" bindtap="replyComment" data-comment="{{item}}">{{item.content}}</text>
              </view>
              <!-- Replies -->
              <view wx:if="{{item.replies && item.replies.length > 0}}" class="replies-list">
                <view wx:for="{{item.replies}}" wx:for-item="reply" wx:key="id" class="reply-item">
                  <view class="comment-avatar-wrap reply-avatar-wrap">
                    <image wx:if="{{reply.user.avatarUrl}}" src="{{reply.user.avatarUrl}}" class="comment-avatar reply-avatar" lazy-load aria-label="{{reply.user.name || '用户'}}的头像" />
                    <view wx:else class="comment-avatar-placeholder reply-avatar-placeholder {{reply.user.role === 'technician' ? 'avatar-tech' : ''}}">
                      <text class="avatar-text">{{reply.user.name[0]}}</text>
                    </view>
                  </view>
                  <view class="comment-body">
                    <view class="comment-bubble">
                      <view class="comment-name-row">
                        <text class="comment-name">{{reply.user.name}}</text>
                        <text wx:if="{{reply.user.role === 'technician'}}" class="role-badge">美甲师</text>
                        <text class="comment-time">{{reply.createdAtText}}</text>
                      </view>
                      <text class="comment-content" bindtap="replyComment" data-comment="{{reply}}">{{reply.content}}</text>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view wx:else class="comments-empty">
          <text class="empty-text">暂无评论</text>
        </view>

        <!-- Hidden comments -->
        <view wx:if="{{hiddenComments.length > 0}}" class="hidden-section">
          <view class="hidden-toggle" bindtap="toggleHiddenComments">
            <text class="hidden-toggle-text">{{showHidden ? '收起隐藏评论' : '查看 ' + hiddenComments.length + ' 条隐藏评论'}}</text>
          </view>
          <view wx:if="{{showHidden}}" class="comments-list">
            <view wx:for="{{hiddenComments}}" wx:key="id" class="comment-item comment-hidden">
              <view class="comment-avatar-wrap">
          <image wx:if="{{item.user.avatarUrl}}" src="{{item.user.avatarUrl}}" class="comment-avatar" lazy-load aria-label="{{item.user.nickname || '用户'}}的头像" />
                <view wx:else class="comment-avatar-placeholder">
                  <text class="avatar-text">{{item.user.name[0]}}</text>
                </view>
              </view>
              <view class="comment-body">
                <view class="comment-bubble">
                  <view class="comment-name-row">
                    <text class="comment-name">{{item.user.name}}</text>
                    <text class="hidden-badge">已隐藏</text>
                    <text class="comment-time">{{item.createdAtText}}</text>
                  </view>
                  <text class="comment-content">{{item.content}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 底部占位（为固定评论输入栏留空间） -->
      <view class="bottom-spacer"></view>
    </view>
  </view>

  <!-- 固定底部评论输入栏 -->
  <view wx:if="{{work.id && !loading}}" class="comment-input-bar">
    <view class="detail-social-row">
      <view class="detail-social-btn {{work.isLiked ? 'is-active-like' : ''}}" bindtap="toggleLike" role="button" aria-label="点赞"><image src="{{work.isLiked ? '/static/icons/social-heart-active.svg' : '/static/icons/social-heart.svg'}}"/><text>{{work.likeCount || 0}}</text></view>
      <view class="detail-social-btn {{work.isFavorited ? 'is-active-favorite' : ''}}" bindtap="toggleFavorite" role="button" aria-label="收藏"><image src="{{work.isFavorited ? '/static/icons/social-star-active.svg' : '/static/icons/social-star.svg'}}"/><text>{{work.favoriteCount || 0}}</text></view>
      <view class="detail-social-btn" bindtap="focusComment" role="button" aria-label="评论"><image src="/static/icons/social-comment.svg"/><text>{{work.commentCount || comments.length || 0}}</text></view>
    </view>
    <view wx:if="{{replyingTo}}" class="reply-hint">
      <text class="reply-hint-text">回复 <text class="reply-name">@{{replyingTo.name}}</text></text>
      <view class="reply-cancel" bindtap="cancelReply">
        <view class="reply-cancel-icon"></view>
      </view>
    </view>
    <view class="input-row">
      <input
        class="comment-input"
        placeholder="{{replyingTo ? '回复 @' + replyingTo.name + '...' : '添加评论...'}}"
        value="{{commentText}}"
        focus="{{commentFocused}}"
        bindinput="onCommentInput"
        bindconfirm="submitComment"
        confirm-type="send"
        adjust-position="{{true}}"
        cursor-spacing="20"
      />
      <view class="send-btn {{commentText ? '' : 'send-disabled'}}" bindtap="submitComment">
        <text class="send-text">发送</text>
      </view>
    </view>
  </view>

  <!-- Fullscreen Image Viewer -->
  <view wx:if="{{viewerOpen}}" class="viewer-overlay">
    <cover-view class="viewer-close" style="top: {{viewerCloseTop}}px" bindtap="closeViewer">
      <cover-view class="viewer-close-icon">✕</cover-view>
    </cover-view>
    <cover-view wx:if="{{imageUrls.length > 1}}" class="viewer-counter">
      <cover-view class="viewer-counter-text">{{viewerIndex + 1}} / {{imageUrls.length}}</cover-view>
    </cover-view>
    <swiper
      class="viewer-swiper"
      current="{{viewerIndex}}"
      bindchange="onViewerSwiperChange"
      circular="{{false}}"
    >
      <swiper-item wx:for="{{imageUrls}}" wx:key="index">
      <image src="{{item}}" mode="aspectFit" class="viewer-image" bindtap="closeViewer" aria-label="{{work.title || '美甲作品'}}大图" />
      </swiper-item>
    </swiper>
    <cover-view wx:if="{{imageUrls.length > 1}}" class="viewer-dots">
      <cover-view
        wx:for="{{imageUrls}}"
        wx:key="index"
        class="viewer-dot {{index === viewerIndex ? 'viewer-dot-active' : ''}}"
      ></cover-view>
    </cover-view>
  </view>

</view>
