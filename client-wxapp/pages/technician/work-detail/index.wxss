.page {
  min-height: 100vh;
  background: var(--bg-card);
}

/* Loading */
.loading-screen {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background: var(--nb-ink);
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: var(--text-inverse);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
.load-error { min-height:100vh; box-sizing:border-box; padding:120rpx 48rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; background:var(--nb-page); text-align:center; }
.load-error-mark { width:88rpx; height:88rpx; margin-bottom:28rpx; border-radius:50%; background:var(--nb-page); color:var(--nb-ink); font-size: var(--font-xl); line-height:88rpx; }
.load-error-title { color:var(--nb-ink); font-size: var(--font-lg); font-weight: var(--weight-semibold); }.load-error-desc { margin-top:12rpx; color:var(--nb-secondary); font-size: var(--font-sm); }
.retry-btn,.back-btn-error { min-height:88rpx; padding:0 56rpx; border:0; border-radius: var(--radius-xl); font-size: var(--font-md); line-height:88rpx; }.retry-btn { margin:44rpx 0 0; background:var(--nb-ink); color: var(--text-inverse); }.back-btn-error { margin:20rpx 0 0; background:var(--nb-page); color:var(--nb-secondary); }.retry-btn::after,.back-btn-error::after { border:0; }

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* Detail container - full page scroll */
.detail-container {
  min-height: 100vh;
  position: relative;
  padding-bottom: 160rpx;
}

/* Fixed header (close button top-left) */
.header-fixed {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 20;
  padding: 80rpx 0 16rpx 32rpx;
}
.header-edit-fixed {
  position: fixed;
  top: 0;
  right: 0;
  z-index: 20;
  padding: 80rpx 32rpx 16rpx 0;
}

.header-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-btn:active {
  background: rgba(0, 0, 0, 0.55);
}
.header-edit-btn { background: rgba(0, 0, 0, 0.42); }
.header-edit-icon { width: 36rpx; height: 36rpx; filter: brightness(0) invert(1); }

/* CSS close icon */
.header-close-icon {
  width: 20rpx;
  height: 20rpx;
  position: relative;
}

.header-close-icon::before,
.header-close-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 20rpx;
  height: 3rpx;
  background: var(--bg-card);
  border-radius: 2rpx;
}

.header-close-icon::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.header-close-icon::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

/* Image Slider */
.image-slider {
  position: relative;
  height: 750rpx;
  background: var(--nb-ink);
}

.image-scroll {
  height: 100%;
  white-space: nowrap;
}

.image-list {
  display: flex;
  height: 100%;
}

.image-item {
  flex-shrink: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.slide-image {
  width: 100%;
  height: 100%;
}

.image-dots {
  position: absolute;
  bottom: 24rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 12rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
}

.dot-active {
  background: var(--bg-card);
}

/* White Info Panel */
.info-panel {
  position: relative;
  z-index: 10;
  margin-top: -48rpx;
  background: var(--bg-card);
  border-radius: 56rpx 56rpx 0 0;
  box-shadow: 0 -24rpx 80rpx rgba(0, 0, 0, 0.06);
}

/* Title block */
.title-block {
  padding: 40rpx 40rpx 32rpx;
}

.title-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.work-title {
  font-size: var(--font-xl);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  line-height: 1.3;
  flex: 1;
}

.work-price {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--nb-money);
  flex-shrink: 0;
}
.share-stat { display:inline-flex; margin-top:12rpx; padding:7rpx 16rpx; border-radius: var(--card-radius); color:var(--nb-ink); background:var(--nb-page); font-size: var(--font-xs); font-weight: var(--weight-semibold); }

.work-desc {
  display: block;
  margin-top: var(--space-sm);
  font-size: var(--font-md);
  line-height: 1.6;
  color: var(--text-muted);
}
.work-aesthetic { margin-top:20rpx; padding:20rpx 22rpx; border-radius: var(--card-radius); background:var(--nb-page); }
.work-aesthetic-line { display:block; color:var(--nb-secondary); font-size: var(--font-xs); line-height:1.65; }

.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.tag {
  font-size: var(--font-xs);
  color: var(--nb-secondary);
  background: var(--nb-page);
  padding: 6rpx 20rpx;
  border-radius: var(--radius-md);
}

.access-summary { margin-top: var(--space-md); padding: var(--space-md); border-radius: var(--radius-md); background:var(--nb-page); border: 0; }
.access-summary-label,.access-summary-name,.access-summary-permissions { display:block; }
.access-summary-label { color:var(--nb-ink); font-size: var(--font-xs); font-weight: var(--weight-bold); letter-spacing:1rpx; }
.access-summary-name { margin-top:10rpx; color:var(--nb-ink); font-size: var(--font-sm); font-weight: var(--weight-bold); }
.access-summary-permissions { margin-top:8rpx; color:var(--nb-secondary); font-size: var(--font-xs); line-height: var(--leading-normal); }

/* Comments section - regular block, no scroll */
.comments-section {
  border-top: 0;
  padding: 32rpx 40rpx;
}

.comments-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-md);
}

.comments-title {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.comments-count {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

.comments-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.comment-item {
  display: flex;
  gap: 20rpx;
}

.comment-avatar-wrap {
  flex-shrink: 0;
}

.comment-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
}

.comment-avatar-placeholder {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--nb-page);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-tech {
  background: var(--brand-primary);
}

.avatar-text {
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
  color: var(--text-inverse);
}

.comment-body {
  flex: 1;
  min-width: 0;
}

.comment-bubble {
  background: var(--bg-input);
  border-radius: var(--radius-md);
  padding: 16rpx 24rpx;
}

.comment-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.comment-name {
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
  color: var(--text-body);
}

.role-badge {
  font-size: var(--font-xs);
  color: var(--nb-secondary);
  background: var(--nb-page);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-xs);
}

.pin-badge {
  font-size: var(--font-xs);
  color: var(--nb-ink);
  background: var(--nb-page);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-xs);
}

.hidden-badge {
  font-size: var(--font-xs);
  color: var(--text-muted);
  background: var(--nb-page);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-xs);
}

.comment-time {
  font-size: var(--font-xs);
  color: var(--text-muted);
  margin-left: auto;
}

.comment-content {
  font-size: var(--font-sm);
  color: var(--text-primary);
  line-height: var(--leading-normal);
}

.comment-hidden {
  opacity: 0.6;
}

/* Replies */
.replies-list {
  margin-top: var(--space-sm);
  padding-left: 16rpx;
  border-left: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.reply-avatar-wrap {
  flex-shrink: 0;
}

.reply-avatar,
.reply-avatar-placeholder {
  width: 44rpx;
  height: 44rpx;
}

/* Comments empty */
.comments-empty {
  background: var(--bg-input);
  border-radius: var(--radius-md);
  padding: 48rpx 32rpx;
  text-align: center;
}

.empty-text {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

/* Hidden comments */
.hidden-section {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 2rpx dashed var(--nb-line);
}

.hidden-toggle {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: var(--space-md);
}

.hidden-toggle-text {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

/* Bottom spacer for fixed input bar */
.bottom-spacer {
  height: 160rpx;
}

/* Fixed comment input bar (bottom) */
.comment-input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: var(--nb-soft-surface);
  border-top: 0;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.06);
}
.detail-social-row { min-height:88rpx; display:flex; align-items:center; justify-content:flex-end; gap:8rpx; }
.detail-social-btn { min-width:88rpx; min-height:88rpx; display:flex; align-items:center; justify-content:center; gap:8rpx; color:var(--nb-muted); font-size:24rpx; }
.detail-social-btn image { width:34rpx; height:34rpx; }
.detail-social-btn:active { opacity:.5; }
.detail-social-btn.is-active-like { color:var(--nb-ink); }
.detail-social-btn.is-active-favorite { color:var(--nb-ink); }

.reply-hint {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: var(--space-sm);
}

.reply-hint-text {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

.reply-name {
  color: var(--brand-primary);
  font-weight: var(--weight-medium);
}

.reply-cancel {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--bg-input);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* CSS close icon for reply cancel */
.reply-cancel-icon {
  width: 14rpx;
  height: 14rpx;
  position: relative;
}

.reply-cancel-icon::before,
.reply-cancel-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 14rpx;
  height: 2rpx;
  background: var(--nb-muted);
  border-radius: 1rpx;
}

.reply-cancel-icon::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.reply-cancel-icon::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.comment-input {
  flex: 1;
  height: 80rpx;
  border-radius: var(--radius-xl);
  border: 0;
  background: var(--nb-soft-surface);
  padding: 0 32rpx;
  font-size: var(--font-md);
  color: var(--text-primary);
}

.send-btn {
  height: 88rpx;
  padding: 0 32rpx;
  border-radius: var(--radius-xl);
  background: var(--brand-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.send-disabled {
  opacity: 0.4;
}

.send-text {
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  color: var(--text-inverse);
}

/* Fullscreen Viewer */
.viewer-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 300;
  background: var(--nb-ink);
}

.viewer-close {
  position: fixed;
  left: 32rpx;
  z-index: 310;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
}

.viewer-close-icon {
  font-size: var(--font-lg);
  color: var(--text-inverse);
  line-height: 72rpx;
  text-align: center;
  width: 72rpx;
}

.viewer-counter {
  position: fixed;
  top: 80rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 310;
  background: rgba(255, 255, 255, 0.15);
  padding: 8rpx 24rpx;
  border-radius: var(--radius-md);
}

.viewer-counter-text {
  font-size: var(--font-sm);
  color: var(--text-inverse);
  white-space: nowrap;
}

.viewer-swiper {
  width: 100%;
  height: 100%;
}

.viewer-image {
  width: 100%;
  height: 100%;
}

.viewer-dots {
  position: fixed;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  left: 0;
  right: 0;
  z-index: 310;
  display: flex;
  justify-content: center;
  gap: 12rpx;
}

.viewer-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.4);
}

.viewer-dot-active {
  background: var(--bg-card);
}

/* Delete confirm */
.confirm-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
}

.confirm-dialog {
  width: 100%;
  max-width: 560rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 48rpx;
  box-shadow: 0 32rpx 64rpx rgba(0, 0, 0, 0.15);
}

.confirm-message {
  display: block;
  font-size: var(--font-md);
  color: var(--text-body);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.confirm-actions {
  display: flex;
  gap: 24rpx;
}

.confirm-btn {
  flex: 1;
  height: 80rpx;
  border-radius: var(--radius-xl);
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-cancel {
  border: 0;
}

.confirm-ok {
  background: var(--nb-action);
}

.confirm-btn-text {
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  color: var(--text-body);
}

.confirm-ok-text {
  color: var(--text-inverse);
}
