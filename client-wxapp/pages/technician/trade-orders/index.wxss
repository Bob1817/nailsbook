.page{min-height:100vh;background:var(--nb-page);padding:0 28rpx var(--space-2xl);box-sizing:border-box}
.tabs{margin:0 -28rpx;background:var(--nb-surface);border-bottom:1rpx solid var(--nb-line);}
.tabs-inner{display:flex;padding:14rpx 28rpx;gap:12rpx;align-items:center;}
.tab{position:relative;height:54rpx;min-height:54rpx;padding:0 24rpx;display:inline-flex;align-items:center;justify-content:center;border-radius:var(--radius-full);background:var(--nb-page);border:1rpx solid rgba(0, 0, 0, 0.08);color:var(--nb-secondary);font-size:24rpx;font-weight:var(--weight-medium);box-sizing:border-box;flex-shrink:0;transition:all 0.15s ease-in-out;}
.tab::after{content:'';position:absolute;top:-16rpx;bottom:-16rpx;left:0;right:0;}
.tab:active{background:var(--nb-pressed);transform:scale(0.97);}
.tab.active{background:var(--nb-action);border-color:var(--nb-action);color:var(--nb-inverse);font-weight:var(--weight-semibold);}
.list{padding-top:var(--space-md)}.order-card{margin-bottom:var(--space-md);padding:28rpx;background:var(--nb-surface);border: 0;border-radius:24rpx;box-shadow:0 8rpx 24rpx rgba(0, 0, 0, .05)}.order-head{display:flex;justify-content:space-between;gap:20rpx}.trade-no{font-size:var(--font-xs);color:var(--nb-muted)}.status{font-size:var(--font-sm);color:var(--nb-ink)}.status-paid{color:var(--nb-ink)}.status-cancelled{color:var(--nb-muted)}.order-title{display:block;margin-top:22rpx;font-size:var(--font-lg);font-weight:600;color:var(--nb-ink)}.order-meta{display:block;margin-top:10rpx;font-size:var(--font-sm);color:var(--nb-muted)}.amount-row{display:grid;grid-template-columns:repeat(3,1fr);margin-top:var(--space-md);padding:22rpx 0;border-top: 0;border-bottom: 0;}.amount-row view{display:flex;flex-direction:column;gap:var(--space-xs)}.amount-row text{font-size:var(--font-xs);color:var(--nb-muted)}.amount-row strong{font-size:var(--font-md);color:var(--nb-ink)}.order-foot{min-height:72rpx;display:flex;align-items:center;justify-content:flex-end;color:var(--nb-muted);font-size:var(--font-sm)}.empty{margin-top:180rpx;display:flex;flex-direction:column;align-items:center;gap:18rpx;color:var(--nb-muted);font-size:var(--font-md)}.empty-title{font-size:var(--font-lg);color:var(--nb-ink);font-weight:600}
.status-completed{color:var(--nb-ink)}.amount-value{font-size:var(--font-md)!important;color:var(--nb-ink)!important;font-weight:600}

/* 交易字段统一语义色 */
.status { color:var(--nb-secondary); }
.status-paid { color:var(--nb-success); }
.status-cancelled { color:var(--nb-danger); }
.status-completed { color:var(--nb-secondary); }
.amount-row strong, .amount-value { color:var(--nb-money)!important; font-variant-numeric:tabular-nums; }
