<nav-bar title="我的订单" showBack="{{true}}" backUrl="/pages/technician/profile/index"/>
<view class="page">
  <scroll-view scroll-x class="tabs" enhanced show-scrollbar="{{false}}"><view class="tabs-inner"><view wx:for="{{tabs}}" wx:key="value" class="tab {{active===item.value?'active':''}}" data-value="{{item.value}}" bindtap="switchTab">{{item.label}}</view></view></scroll-view>
  <view wx:if="{{loading}}" class="empty">订单加载中...</view>
  <view wx:elif="{{!list.length}}" class="empty"><text class="empty-title">暂无相关订单</text><text>双方确认报价后的交易订单会显示在这里</text></view>
  <view wx:else class="list"><view wx:for="{{list}}" wx:key="id" class="order-card" bindtap="openOrder" data-id="{{item.bookingId}}"><view class="order-head"><text class="trade-no">{{item.tradeNo}}</text><text class="status status-{{item.status}}">{{item._statusText}}</text></view><text class="order-title">{{item._title}}</text><text class="order-meta">客户：{{item._customer}} · {{item._created}}</text><view class="amount-row"><view><text>订单金额</text><text class="amount-value semantic-money">¥{{item._total}}</text></view><view><text>已支付</text><text class="amount-value semantic-money">¥{{item._paid}}</text></view><view><text>待支付</text><text class="amount-value semantic-money">¥{{item._remaining}}</text></view></view><view class="order-foot semantic-link">查看关联预约 ›</view></view></view>
</view>
