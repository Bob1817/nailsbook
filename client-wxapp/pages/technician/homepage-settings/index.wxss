page { background:var(--nb-page); color:var(--nb-ink); }.page { min-height:100vh; box-sizing:border-box; }
.page-content { padding:24rpx 24rpx calc(180rpx + env(safe-area-inset-bottom)); }
.section-title,.section-sub,.row-title,.row-desc { display:block; }
.preview-link,.small-action { min-height:88rpx; display:flex; align-items:center; font-size:var(--font-sm); font-weight:var(--weight-medium); }
.section-card { margin-bottom:20rpx; padding:28rpx; border-radius:24rpx; background:var(--nb-surface); box-shadow:var(--shadow-sm); }.status-card { min-height:112rpx; display:flex; align-items:center; justify-content:space-between; gap:24rpx; box-sizing:border-box; }.row-copy { flex:1; min-width:0; }
.section-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:24rpx; margin-bottom:24rpx; }.section-heading>view { flex:1; min-width:0; }.section-title { font-size:var(--font-md); font-weight:var(--weight-semibold); line-height:1.35; }.section-sub,.row-desc { margin-top:8rpx; color:var(--nb-muted); font-size:var(--font-xs); line-height:1.45; }.section-badge,.section-count { flex-shrink:0; padding:6rpx 14rpx; border-radius:999rpx; background:var(--nb-soft-surface); color:var(--nb-secondary); font-size:var(--font-xs); }
.row-title { color:var(--nb-ink); font-size:var(--font-sm); font-weight:var(--weight-medium); line-height:1.4; }
.hero-editor { position:relative; width:100%; height:320rpx; margin:0; padding:0; overflow:hidden; border:0; border-radius:20rpx; background:var(--nb-soft-surface); color:var(--nb-ink); line-height:normal; text-align:left; }.hero-editor::after { border:0; }.hero-editor.uploading { opacity:.72; }.hero-preview { width:100%; height:100%; }.hero-empty { height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; }.upload-symbol { width:72rpx; height:72rpx; border-radius:50%; background:var(--nb-surface); color:var(--nb-secondary); display:flex; align-items:center; justify-content:center; font-size:42rpx; }.upload-title { margin-top:16rpx; font-size:var(--font-sm); font-weight:var(--weight-medium); }.upload-help { margin-top:8rpx; color:var(--nb-muted); font-size:var(--font-xs); }.hero-change { position:absolute; right:18rpx; bottom:18rpx; min-height:72rpx; padding:0 24rpx; border-radius:999rpx; background:rgba(29,29,31,.84); color:var(--text-inverse); display:flex; align-items:center; font-size:var(--font-xs); }
.avatar-row { min-height:120rpx; margin-top:20rpx; display:flex; align-items:center; gap:18rpx; }.avatar { width:88rpx; height:88rpx; border-radius:50%; background:var(--nb-soft-surface); flex-shrink:0; }.avatar-fallback { display:flex; align-items:center; justify-content:center; }.avatar-copy { flex:1; min-width:0; }.small-action { padding:0 4rpx 0 20rpx; }
.field { margin-top:28rpx; }.field:first-of-type { margin-top:0; }.field-pair { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; }.label-row { display:flex; align-items:center; justify-content:space-between; gap:20rpx; }.label { display:block; margin-bottom:12rpx; color:var(--nb-ink); font-size:var(--font-sm); font-weight:var(--weight-medium); }.label-row .label { margin-bottom:0; }.counter,.field-value { color:var(--nb-muted); font-size:var(--font-xs); }
.input,.picker { min-height:88rpx; }.input,.textarea,.picker { width:100%; padding:0 22rpx; border:0; border-radius:var(--radius-sm); background:var(--nb-soft-surface); color:var(--nb-ink); font-size:var(--font-sm); box-sizing:border-box; }.picker { display:flex; align-items:center; justify-content:space-between; }.picker-arrow,.entry-arrow { color:var(--nb-muted); font-size:var(--font-lg); }.textarea { height:200rpx; padding:20rpx 22rpx; line-height:1.55; }.textarea.compact { height:152rpx; }.experience-field slider { margin:14rpx 0 0; }.slider-scale { display:flex; justify-content:space-between; color:var(--nb-muted); font-size:var(--font-xs); }
.selected-styles { margin-bottom:20rpx; display:flex; flex-direction:column; gap:12rpx; }.selected-style { min-height:88rpx; padding:0 20rpx; border-radius:16rpx; background:var(--nb-soft-surface); display:flex; align-items:center; gap:16rpx; color:var(--nb-secondary); font-size:var(--font-sm); }.selected-style-order { width:40rpx; height:40rpx; border-radius:50%; background:var(--nb-action); color:var(--text-inverse); display:flex; align-items:center; justify-content:center; font-size:var(--font-xs); }.selected-style-remove { margin-left:auto; color:var(--nb-muted); font-size:var(--font-xs); }.skill-list { display:flex; flex-wrap:wrap; gap:12rpx; }.skill-chip { min-height:72rpx; padding:0 22rpx; border-radius:999rpx; background:var(--nb-soft-surface); color:var(--nb-secondary); display:flex; align-items:center; font-size:var(--font-xs); }.skill-chip.selected { background:var(--nb-action); color:var(--text-inverse); }
.entry-row { min-height:112rpx; display:flex; align-items:center; justify-content:space-between; gap:24rpx; }.entry-row+ .entry-row { border-top:1rpx solid var(--nb-divider); }.entry-row>view { flex:1; min-width:0; }.entry-row.single { margin-top:16rpx; border-top:1rpx solid var(--nb-divider); }.content-state { min-height:144rpx; display:flex; align-items:center; justify-content:center; color:var(--nb-muted); font-size:var(--font-xs); }
.works-scroll { width:100%; white-space:nowrap; }.works-row { display:inline-flex; gap:16rpx; padding:4rpx 4rpx 16rpx; }.work-option { position:relative; width:176rpx; opacity:.62; }.work-option.selected { opacity:1; }.work-cover { width:176rpx; height:216rpx; border-radius:18rpx; background:var(--nb-soft-surface); display:block; }.work-option.selected .work-cover { box-shadow:0 0 0 4rpx var(--nb-action); }.work-check { position:absolute; top:10rpx; right:10rpx; width:28rpx; height:28rpx; border-radius:50%; background:var(--nb-surface); color:var(--nb-success); display:flex; align-items:center; justify-content:center; font-size:18rpx; font-weight:var(--weight-bold); }.work-name { display:block; margin-top:10rpx; overflow:hidden; text-overflow:ellipsis; color:var(--nb-secondary); font-size:var(--font-xs); }
.review-list { display:flex; flex-direction:column; gap:12rpx; }.review-option { min-height:104rpx; padding:18rpx 20rpx; border-radius:16rpx; background:var(--nb-soft-surface); display:flex; align-items:center; justify-content:space-between; gap:20rpx; }.review-option.selected { background:var(--nb-active-surface); }.review-option>view { flex:1; min-width:0; }.review-rating,.review-content { display:block; }.review-rating { color:var(--nb-ink); font-size:var(--font-xs); font-weight:var(--weight-medium); }.review-content { margin-top:7rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--nb-muted); font-size:var(--font-xs); }.review-status { color:var(--nb-text-link); font-size:var(--font-xs); }
.footer { position:fixed; left:0; right:0; bottom:0; z-index:30; padding:16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); background:var(--nb-surface); box-shadow:0 -2rpx 16rpx rgba(0,0,0,.06); }.save { width:100%; min-height:96rpx; margin:0; padding:0 32rpx; border:0; border-radius:var(--btn-radius); background:var(--nb-action); color:var(--text-inverse); display:flex; align-items:center; justify-content:center; font-size:var(--font-md); font-weight:var(--weight-medium); box-sizing:border-box; }.save::after { border:0; }.save:active { background:var(--nb-action-pressed); }.disabled { opacity:.5; }

@import '../../../styles/booking-form.wxss';
@import '../../../styles/booking-actions.wxss';

.hero-recommendation-entry { margin:24rpx 32rpx; padding:20rpx 24rpx; min-height:44px; box-sizing:border-box; display:flex; align-items:center; justify-content:space-between; gap:16rpx; background:var(--nb-surface); border-radius:16rpx; color:var(--nb-text-link); font-size:var(--font-sm); }
.hero-recommendation-entry:active { background:var(--nb-pressed); }
