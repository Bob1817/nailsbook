<nav-bar title="我的主页" showBack/>
<view class="page">
  <view class="preview-bar"><text>公开主页内容配置</text><view class="preview-button" bindtap="preview">预览主页</view></view>
  <view class="publish-row"><view><text>主页公开状态</text><text>{{publicationStatus === 'published' ? '客户可查看' : '仅自己预览'}}</text></view><switch checked="{{publicationStatus === 'published'}}" color="#8f284c" bindchange="togglePublication"/></view>
  <view class="hero-editor" bindtap="chooseHero">
    <image wx:if="{{heroImageUrl}}" src="{{heroImageUrl}}" mode="aspectFill" class="hero-preview"/>
    <view wx:else class="hero-empty">上传主页背景图</view>
    <view class="hero-change">更换背景图</view>
  </view>
  <view class="preview">
    <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill" aria-label="主页头像"/>
    <view wx:else class="avatar avatar-fallback">{{name[0] || '美'}}</view>
    <view class="preview-copy"><text class="preview-name">{{name || '美甲师'}}</text><text class="preview-area">{{city || '城市待完善'}}{{serviceArea ? ' · ' + serviceArea : ''}}</text></view>
    <view class="change-avatar" bindtap="chooseAvatar">更换头像</view>
  </view>
  <view class="form">
    <view class="field"><text class="label">主页名称</text><input class="input" value="{{name}}" bindinput="onInput" data-field="name" maxlength="20" placeholder="输入展示名称"/></view>
    <view class="field"><text class="label">主页 Slogan</text><input class="input" value="{{tagline}}" bindinput="onInput" data-field="tagline" maxlength="80" placeholder="一句话表达你的审美与价值"/></view>
    <view class="field experience-field">
      <view class="label-row"><text class="label">从业经验</text><text class="experience-value">{{experienceYears}} 年</text></view>
      <slider min="1" max="30" step="1" value="{{experienceYears}}" activeColor="#8f284c" backgroundColor="#e8e0e4" block-color="#8f284c" block-size="22" bindchange="onExperienceChange" bindchanging="onExperienceChange"/>
      <view class="slider-scale"><text>1 年</text><text>30 年以上</text></view>
    </view>
    <view class="field"><text class="label">认证展示</text><input class="input" value="{{certificationTitle}}" bindinput="onInput" data-field="certificationTitle" placeholder="如 平台认证美甲师"/></view>
    <view class="field">
      <view class="label-row"><text class="label">擅长领域</text><text class="skill-limit">{{specialties.length}}/3</text></view>
      <text class="skill-help">像填写简历技能一样选择最能代表你的美甲能力</text>
      <view class="skill-list">
        <view wx:for="{{specialtyOptions}}" wx:key="*this" class="skill-chip {{selectedSpecialtyMap[item] ? 'selected' : ''}}" bindtap="toggleSpecialty" data-value="{{item}}">{{item}}</view>
      </view>
      <text wx:if="{{specialties.length === 0}}" class="skill-empty">-</text>
    </view>
    <view class="field"><view class="label-row"><text class="label">自我介绍</text><text class="counter">{{artistIntroduction.length}}/1000</text></view><textarea class="textarea" value="{{artistIntroduction}}" bindinput="onInput" data-field="artistIntroduction" maxlength="1000" placeholder="介绍你的经历、风格和服务理念"/></view>
    <view class="field"><text class="label">审美宣言</text><textarea class="textarea compact" value="{{aestheticPhilosophy}}" bindinput="onInput" data-field="aestheticPhilosophy" maxlength="1000" placeholder="例如：让指尖成为安静但有力量的自我表达"/></view>
    <view class="field"><text class="label">所在城市</text><picker mode="region" bindchange="onCityChange"><view class="picker">{{city || '选择城市'}}<text>›</text></view></picker></view>
    <view class="field"><text class="label">服务区域</text><picker mode="region" bindchange="onServiceAreaChange"><view class="picker">{{serviceArea || '选择服务区域'}}<text>›</text></view></picker></view>
  </view>
  <view class="link-group">
    <view class="works-entry" bindtap="openSection" data-url="/pages/technician/services/index"><text>服务范围与价格</text><text>›</text></view>
    <view class="works-entry" bindtap="openSection" data-url="/pages/technician/service-time/index"><text>工作时间安排</text><text>›</text></view>
    <view class="works-entry" bindtap="openSection" data-url="/pages/technician/shop-management/index"><text>签约店铺与地址</text><text>›</text></view>
  </view>
  <view class="works-section">
    <view class="works-head"><view><text class="works-title">主页精选作品</text><text class="works-sub">从公开作品中选择，最多 6 个</text></view></view>
    <view wx:if="{{worksLoading}}" class="works-state">正在加载作品...</view>
    <view wx:elif="{{works.length === 0}}" class="works-state">暂无公开作品，先去上传作品</view>
    <scroll-view wx:else scroll-x class="works-scroll" enhanced show-scrollbar="{{false}}">
      <view class="works-row">
        <view wx:for="{{works}}" wx:key="id" class="work-option {{item.selected ? 'selected' : ''}}" bindtap="toggleHomepageWork" data-id="{{item.id}}">
          <image class="work-cover" src="{{item.coverUrl}}" mode="aspectFill" aria-label="{{item.title}}"/>
          <view class="work-check">{{item.selected ? '✓' : ''}}</view>
          <text class="work-name">{{item.title}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="works-entry" bindtap="goWorks"><text>上传或管理更多作品</text><text>›</text></view>
  </view>
  <view class="works-section">
    <view class="works-head"><view><text class="works-title">主页展示评论</text><text class="works-sub">选择最多 3 条真实评价</text></view></view>
    <view wx:if="{{reviews.length}}" class="review-list">
      <view wx:for="{{reviews}}" wx:key="id" class="review-option {{item.selected ? 'selected' : ''}}" bindtap="toggleReview" data-id="{{item.id}}">
        <view><text class="review-rating">{{item.rating || 5}}.0</text><text class="review-content">{{item.content || '客户真实评价'}}</text></view><text>{{item.selected ? '已展示' : '选择'}}</text>
      </view>
    </view>
    <view wx:else class="works-state">暂无可公开展示的真实评价</view>
  </view>
  <view class="save {{saving ? 'disabled' : ''}}" bindtap="save">{{saving ? '保存中...' : '保存主页'}}</view>
</view>
