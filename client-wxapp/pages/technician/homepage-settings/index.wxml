<nav-bar title="我的主页" showBack/>
<view class="page">
  <view class="preview">
    <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill" aria-label="主页头像"/>
    <view wx:else class="avatar avatar-fallback">{{name[0] || '美'}}</view>
    <view class="preview-copy"><text class="preview-name">{{name || '美甲师'}}</text><text class="preview-area">{{city || '城市待完善'}}{{serviceArea ? ' · ' + serviceArea : ''}}</text></view>
    <view class="change-avatar" bindtap="chooseAvatar">更换头像</view>
  </view>
  <view class="form">
    <view class="field"><text class="label">主页名称</text><input class="input" value="{{name}}" bindinput="onInput" data-field="name" maxlength="20" placeholder="输入展示名称"/></view>
    <view class="field"><view class="label-row"><text class="label">个人简介</text><text class="counter">{{bio.length}}/200</text></view><textarea class="textarea" value="{{bio}}" bindinput="onInput" data-field="bio" maxlength="200" placeholder="介绍你的风格、经验和擅长方向"/></view>
    <view class="field"><text class="label">所在城市</text><picker mode="region" bindchange="onCityChange"><view class="picker">{{city || '选择城市'}}<text>›</text></view></picker></view>
    <view class="field"><text class="label">服务区域</text><picker mode="region" bindchange="onServiceAreaChange"><view class="picker">{{serviceArea || '选择服务区域'}}<text>›</text></view></picker></view>
  </view>
  <view class="works-section">
    <view class="works-head"><view><text class="works-title">主页精选作品</text><text class="works-sub">从公开作品中选择，最多 6 个</text></view></view>
    <view wx:if="{{worksLoading}}" class="works-state">正在加载作品...</view>
    <view wx:elif="{{works.length === 0}}" class="works-state">暂无公开作品，先去上传作品</view>
    <scroll-view wx:else scroll-x class="works-scroll" enhanced show-scrollbar="{{false}}">
      <view class="works-row">
        <view wx:for="{{works}}" wx:key="id" class="work-option {{item.selected ? 'selected' : ''}}" bindtap="toggleHomepageWork" data-id="{{item.id}}">
          <image class="work-cover" src="{{item.coverUrl}}" mode="aspectFill" aria-label="{{item.title}}"/>
          <view class="work-check">{{item.selected ? '✓' : ''}}</view>
          <text class="work-name">{{item.title}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="works-entry" bindtap="goWorks"><text>上传或管理更多作品</text><text>›</text></view>
  </view>
  <view class="save {{saving ? 'disabled' : ''}}" bindtap="save">{{saving ? '保存中...' : '保存主页'}}</view>
</view>
