<nav-bar title="服务时间" showBack/>
<view class="container">
  <view wx:if="{{loading}}" class="loading-wrap"><view class="loading-spinner"></view></view>

  <view wx:elif="{{loadFailed}}" class="load-error" aria-live="polite">
    <view class="load-error-mark">!</view>
    <text class="load-error-title">服务时间加载失败</text>
    <text class="load-error-desc">为避免覆盖已有设置，请重新加载后再编辑</text>
    <button class="retry-btn" bindtap="loadSchedule">重新加载</button>
  </view>

  <view wx:else>
    <view class="card">
      <view wx:for="{{schedule}}" wx:key="day" class="day-item {{index < schedule.length - 1 ? 'item-border' : ''}}">
        <view class="day-left">
          <text class="day-label">{{item.label}}</text>
          <text wx:if="{{item.enabled}}" class="day-time">{{item.startTime}} - {{item.endTime}}</text>
          <text wx:else class="day-off">休息</text>
        </view>
        <switch checked="{{item.enabled}}" bindchange="toggleDay" data-idx="{{index}}" color="#FF6B8A" />
      </view>
    </view>

    <text class="tip">开启的工作日将对客户显示为可预约时间段</text>

    <view class="save-btn {{saving ? 'btn-disabled' : ''}}" bindtap="save">
      <text>{{saving ? '保存中...' : '保存'}}</text>
    </view>
  </view>
</view>
