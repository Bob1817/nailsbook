.container { min-height: 100vh; background: linear-gradient(180deg, #fff8fb 0%, #ffffff 34%, #f8f9fc 100%); padding: 32rpx; }
.loading-wrap { display: flex; justify-content: center; padding: 200rpx 0; }
.loading-spinner { width: 60rpx; height: 60rpx; border: 4rpx solid #FF6B8A; border-top-color: transparent; border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.load-error { display:flex; min-height:420rpx; flex-direction:column; align-items:center; justify-content:center; padding:60rpx 32rpx; text-align:center; }
.load-error-mark { width:88rpx; height:88rpx; margin-bottom:28rpx; border-radius:50%; background:#fff0f4; color:#c75b83; font-size:44rpx; line-height:88rpx; text-align:center; }
.load-error-title { margin-bottom:12rpx; color:#374151; font-size:32rpx; font-weight:600; }
.load-error-desc { color:#7d6c75; font-size:25rpx; line-height:1.6; }
.retry-btn { min-height:88rpx; margin:44rpx 0 0; padding:0 56rpx; border:0; border-radius:44rpx; background:#1f2937; color:#fff; font-size:28rpx; line-height:88rpx; }
.retry-btn::after { border:0; }
.card { background: linear-gradient(180deg, #fff8fb 0%, #ffffff 34%, #f8f9fc 100%); border-radius: 24rpx; overflow: hidden; margin-bottom: 24rpx; }
.day-item { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 40rpx; }
.item-border { border-bottom: 1rpx solid #f5f5f5; }
.day-left { flex: 1; }
.day-label { display: block; font-size: 30rpx; font-weight: 600; color: #1f2937; margin-bottom: 6rpx; }
.day-time { font-size: 24rpx; color: #FF6B8A; }
.day-off { font-size: 24rpx; color: #6b7280; }
.tip { display: block; font-size: 24rpx; color: #6b7280; margin-bottom: 32rpx; }
.save-btn { background: linear-gradient(135deg, #ff6b8a, #8b5cf6); color: #fff; font-size: 30rpx; font-weight: 600; text-align: center; padding: 28rpx; border-radius: 48rpx; box-shadow: 0 8rpx 24rpx rgba(255,107,138,0.3); }
.save-btn:active { opacity: 0.85; }
.btn-disabled { opacity: 0.6; }
