.container { min-height: 100vh; background: var(--nb-page); padding: var(--space-lg); }
.loading-wrap { display: flex; justify-content: center; padding: 200rpx 0; }
.loading-spinner { width: 60rpx; height: 60rpx; border: 4rpx solid var(--nb-action); border-top-color: transparent; border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.load-error { display:flex; min-height:420rpx; flex-direction:column; align-items:center; justify-content:center; padding:60rpx var(--space-lg); text-align:center; }
.load-error-mark { width:88rpx; height:88rpx; margin-bottom:28rpx; border-radius:50%; background:var(--nb-soft-surface); color:var(--nb-ink); font-size: var(--font-xl); line-height:88rpx; text-align:center; }
.load-error-title { margin-bottom:12rpx; color: var(--nb-ink); font-size: var(--font-lg); font-weight: var(--weight-semibold); }
.load-error-desc { color:var(--nb-secondary); font-size: var(--font-sm); line-height:1.6; }
.retry-btn { min-height:88rpx; margin:44rpx 0 0; padding:0 56rpx; border:0; border-radius: var(--radius-xl); background:var(--nb-ink); color: var(--text-inverse); font-size: var(--font-md); line-height:88rpx; }
.retry-btn::after { border:0; }
.card { background: var(--nb-surface); border: 1rpx solid var(--nb-line); border-radius: 24rpx; overflow: hidden; margin-bottom: var(--space-md); box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04); }
.day-item { display: flex; align-items: center; justify-content: space-between; padding: 28rpx var(--space-xl); }
.item-border { border-bottom: 1rpx solid var(--nb-line); }
.day-left { flex: 1; }
.day-label { display: block; font-size: var(--font-md); font-weight: 700; color: var(--nb-ink); margin-bottom: 6rpx; }
.day-time { font-size: var(--font-sm); color: var(--nb-action); font-weight: 600; }
.day-off { font-size: var(--font-sm); color: var(--nb-muted); }
.tip { display: block; font-size: var(--font-sm); color: var(--nb-muted); margin-bottom: var(--space-lg); }
.save-btn { background: var(--nb-action); color: var(--nb-surface); font-size: var(--font-md); font-weight: 700; text-align: center; padding: 28rpx; border-radius: 12rpx; box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.16); }
.save-btn:active { opacity: 0.85; }
.btn-disabled { opacity: 0.6; }
@import '../../../styles/booking-actions.wxss';
.retry-btn.booking-action { min-height:44px; height:44px; margin-top:44rpx; padding:0 var(--space-md); border-radius:8px; font-size:var(--font-sm); line-height:1.4; }
.save-btn { min-height:44px; height:44px; padding:0 var(--space-md); border-radius:8px; font-size:var(--font-sm); line-height:1.4; box-shadow:none; display:flex; align-items:center; justify-content:center; }
