<nav-bar title="我的报价" showBack />
<view class="page">
  <!-- 顶部状态切换标签 -->
  <view class="tab-bar">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab-item {{activeTab === item.key ? 'is-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="switchTab"
      role="tab"
      aria-selected="{{activeTab === item.key}}"
    >
      <text class="tab-label">{{item.label}}</text>
      <text class="tab-count" wx:if="{{stats[item.key] > 0}}">{{stats[item.key]}}</text>
      <view class="tab-indicator" wx:if="{{activeTab === item.key}}"></view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="state-box">
    <text class="state-text">正在加载报价记录…</text>
  </view>

  <view wx:elif="{{!displayQuotes.length}}" class="empty-box">
    <view class="empty-icon-wrap">
      <image class="empty-icon" src="/static/icons/calendar.svg" mode="aspectFit" />
    </view>
    <text class="empty-title">暂无相关报价单</text>
    <text class="empty-sub">针对咨询意向客户，可在首页或营销工具中快速生成组合报价并转发</text>
    <button class="primary empty-btn" bindtap="createNewQuote">新建快捷报价</button>
  </view>

  <!-- 报价单卡片列表 -->
  <view wx:else class="quote-list">
    <view wx:for="{{displayQuotes}}" wx:key="id" class="quote-card">
      <!-- 头部：单号与状态 -->
      <view class="card-head">
        <view class="head-left">
          <text class="quote-no">NO. {{item.quoteNo}}</text>
          <text class="quote-time">{{item._createdTimeText}}</text>
        </view>
        <view class="status-pill {{item._statusTone}}">
          <text>{{item._statusLabel}}</text>
        </view>
      </view>

      <!-- 客户与需求说明 -->
      <view class="client-row">
        <view class="client-avatar-fallback">{{item._clientName[0] || '客'}}</view>
        <view class="client-info">
          <text class="client-name">{{item._clientName}}</text>
          <text wx:if="{{item.requirement}}" class="quote-requirement">需求：{{item.requirement}}</text>
        </view>
      </view>

      <!-- 服务明细与价格 -->
      <view class="quote-body">
        <view class="services-row">
          <text class="services-label">方案明细</text>
          <text class="services-content">{{item._linesSummary}}</text>
        </view>
        <view class="price-row">
          <view class="price-left">
            <text class="price-symbol">¥</text>
            <text class="price-value">{{item._priceText}}</text>
            <text wx:if="{{item._hasDiscount}}" class="price-original">原价 ¥{{item._linesTotalText}}</text>
          </view>
          <view wx:if="{{item._hasDiscount}}" class="discount-badge">
            <text>已优惠 ¥{{item._discountText}}</text>
          </view>
        </view>
      </view>

      <!-- 状态分支 1：待回复（可进入报价页查看并转发） -->
      <view wx:if="{{item._category === 'pending'}}" class="card-footer pending-footer">
        <text class="pending-tip">客户尚未回复，可进入查看报价单或继续转发给客户</text>
        <button class="action-btn-primary" data-id="{{item.id}}" bindtap="openQuoteDetail">
          查看并转发
        </button>
      </view>

      <!-- 状态分支 2：已拒绝（展示拒绝原因，报价已失效） -->
      <view wx:elif="{{item.status === 'declined'}}" class="card-footer declined-footer">
        <view class="decline-box">
          <text class="decline-title">客户反馈原因：</text>
          <text class="decline-reason">{{item.declineReason || '客户暂未选择原因'}}</text>
        </view>
        <text class="invalid-tip">报价已失效</text>
      </view>

      <!-- 状态分支 3：已过期或已撤回 -->
      <view wx:elif="{{item.status === 'expired' || item.status === 'withdrawn'}}" class="card-footer expired-footer">
        <text class="invalid-tip">超过有效期，报价方案已失效</text>
      </view>

      <!-- 状态分支 4：已同意并成单（展示关联预约信息与查看详情） -->
      <view wx:elif="{{item._category === 'booked'}}" class="card-footer booked-footer">
        <view wx:if="{{item._order}}" class="order-box">
          <view class="order-info-line">
            <text class="order-label">已转为正式预约：</text>
            <text class="order-value">NO. {{item._order.orderNo}}</text>
          </view>
          <view class="order-info-line">
            <text class="order-label">预约时间：</text>
            <text class="order-value">{{item._order._displayTime || item._order.serviceDate}}</text>
          </view>
          <view wx:if="{{item.shopName}}" class="order-info-line">
            <text class="order-label">服务门店：</text>
            <text class="order-value">{{item.shopName}}</text>
          </view>
        </view>
        <view wx:else class="order-box">
          <text class="order-label">客户已同意报价，正在等待选定预约时间</text>
        </view>
        <button wx:if="{{item._order}}" class="action-btn-secondary" data-order-id="{{item._order.id}}" bindtap="openOrderDetail">
          查看预约详情 ›
        </button>
      </view>
    </view>
  </view>
</view>
