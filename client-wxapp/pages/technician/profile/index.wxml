<view class="container">
  <!-- 用户信息头部 -->
  <view class="header" bindtap="editProfile">
    <view class="avatar-wrap">
      <image wx:if="{{userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" mode="aspectFill" class="avatar" />
      <view wx:else class="avatar-placeholder">
        <text class="avatar-char">{{userInfo.name ? userInfo.name[0] : '师'}}</text>
      </view>
    </view>
    <view class="user-info">
      <text class="name">{{userInfo.name || '美甲师'}}</text>
      <text class="phone">{{userInfo.phone}}</text>
      <view class="status-row">
        <view class="status-dot {{userInfo.status === 'active' ? 'dot-green' : 'dot-grey'}}"></view>
        <text class="status-text">{{userInfo.status === 'active' ? '接单中' : '休息中'}}</text>
        <view class="toggle-status-btn" catchtap="toggleStatus">
          {{userInfo.status === 'active' ? '暂停接单' : '开启接单'}}
        </view>
      </view>
    </view>
    <text class="header-arrow">›</text>
  </view>

  <!-- 统计 -->
  <view class="stats-row">
    <view class="stat-item">
      <text class="stat-num">{{stats.worksCount}}</text>
      <text class="stat-label">作品</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{stats.customersCount}}</text>
      <text class="stat-label">客户</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{stats.ordersCount}}</text>
      <text class="stat-label">预约</text>
    </view>
  </view>

  <!-- 邀请码 -->
  <view class="invite-card" bindtap="shareInvite">
    <view class="invite-info">
      <text class="invite-label">我的邀请码</text>
      <text class="invite-code">{{userInfo.invitationCode || '暂无邀请码'}}</text>
    </view>
    <view class="invite-copy">复制分享</view>
  </view>

  <!-- 工具菜单 -->
  <view class="section">
    <text class="section-title">工具</text>
    <view class="menu-list">
      <view class="menu-item" bindtap="navigateToServices">
        <text class="menu-icon">💅</text><text class="menu-label">服务管理</text><text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="navigateToWorks">
        <text class="menu-icon">🖼️</text><text class="menu-label">作品管理</text><text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="navigateToHomeService">
        <text class="menu-icon">🚗</text><text class="menu-label">上门设置</text><text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="navigateToServiceTime">
        <text class="menu-icon">⏰</text><text class="menu-label">服务时间</text><text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="navigateToShops">
        <text class="menu-icon">🏪</text><text class="menu-label">店铺管理</text><text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="navigateToTagManagement">
        <text class="menu-icon">🏷️</text><text class="menu-label">标签管理</text><text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="navigateToSubscription">
        <text class="menu-icon">⭐</text><text class="menu-label">订阅套餐</text><text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 设置菜单 -->
  <view class="section">
    <text class="section-title">设置</text>
    <view class="menu-list">
      <view class="menu-item" bindtap="editProfile">
        <text class="menu-icon">⚙️</text><text class="menu-label">个人设置</text><text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="navigateToAccountSecurity">
        <text class="menu-icon">🔐</text><text class="menu-label">账号与安全</text><text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="navigateToHelp">
        <text class="menu-icon">❓</text><text class="menu-label">帮助与反馈</text><text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="navigateToAbout">
        <text class="menu-icon">ℹ️</text><text class="menu-label">关于我们</text><text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="switchRole">
        <text class="menu-icon">🔄</text><text class="menu-label">切换身份</text><text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 退出 -->
  <view class="logout-btn" bindtap="logout">退出登录</view>
</view>
