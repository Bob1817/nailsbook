<nav-bar title="我的"/>
<view class="page">
  <!-- ============ Header ============ -->
  <view class="header">
    <view class="header-row">
      <view class="avatar-wrap" bindtap="editProfile">
        <image wx:if="{{userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" mode="aspectFill" class="avatar" aria-label="{{userInfo.name || '美甲师'}}的头像" />
        <view wx:else class="avatar-placeholder">
          <image src="/static/icons/technician.svg" mode="aspectFit" class="nb-default-avatar" aria-label="美甲师默认头像" />
        </view>
      </view>
      <view class="user-info" bindtap="editProfile">
        <view class="name-row">
          <text class="name">{{userInfo.name || '美甲师'}}</text>
          <text class="role-tag">美甲师</text>
        </view>
        <text class="phone">{{userInfo.phoneDisplay}}</text>
      </view>
      <button class="profile-share-btn booking-action" hover-class="profile-share-pressed" open-type="share" aria-label="分享名片"><image class="profile-share-icon" src="/static/icons/share.svg" mode="aspectFit" aria-hidden="true" /><text>分享名片</text></button>
    </view>


  </view>

  <view class="card availability-card">
    <text class="card-title availability-title">预约设置</text>
    <view class="availability-row availability-module">
      <view class="status-copy">
        <text class="status-label">接受新预约</text>
        <text class="profile-helper accepting-helper">{{savingAccepting ? '正在保存…' : acceptingHint}}</text>
      </view>
      <nb-switch checked="{{acceptingEnabled}}" disabled="{{savingAccepting}}" bindchange="onAcceptingChange" label="接受新预约，{{acceptingEnabled ? '已开启，点击暂停' : '已关闭，点击开启'}}"/>
    </view>
    <view class="profile-schedule-row availability-module" bindtap="openScheduleModal" role="button" aria-label="设置工作时间" hover-class="profile-pressed">
      <view class="status-copy">
        <text class="status-label">工作时间</text>
        <text class="profile-helper">{{scheduleSummary}}</text>
      </view>
      <text class="semantic-link profile-link">修改 ›</text>
    </view>
  </view>

  <!-- ============ 新手引导卡 ============ -->
  <view wx:if="{{needsSetup}}" class="setup-guide-card">
    <view class="setup-guide-head">
      <view class="setup-guide-title-row">
        <text class="setup-guide-title">完成设置，开始接单</text>
        <view class="setup-guide-badge">待完善</view>
      </view>
      <text class="setup-guide-desc">以下信息全部完成后，才能开启接单并接受客户预约</text>
    </view>
    <view class="setup-steps">
      <view wx:for="{{setupSteps}}" wx:key="key" class="setup-step" bindtap="goSetupStep" data-route="{{item.route}}">
        <view class="setup-step-left">
          <view class="setup-step-icon-wrap {{item.done ? 'setup-step-done' : ''}}">
            <text>{{item.done ? '✓' : index + 1}}</text>
          </view>
          <view class="setup-step-text">
            <text class="setup-step-label">{{item.label}}</text>
            <text class="setup-step-hint">{{item.hint}}</text>
          </view>
        </view>
        <view class="setup-step-action">
          <text class="setup-step-btn">{{item.done ? '查看' : '去完善'}}</text>
          <text class="setup-step-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ============ 我的预约 ============ -->
  <view class="card card-gap">
    <view class="card-head">
      <text class="card-title">预约管理</text>
      <view class="card-more semantic-link" bindtap="goAllOrders">全部预约 ›</view>
    </view>
    <view class="order-grid">
      <view
        wx:for="{{orderShortcuts}}"
        wx:key="status"
        class="order-cell" role="button" hover-class="profile-tile-pressed"
        bindtap="goOrderStatus"
        data-status="{{item.status}}"
      >
        <view class="order-cell-badge order-bg-{{item.status}} {{item.count > 0 ? 'has-count' : ''}}">
          <image class="order-cell-icon" src="{{item.icon}}" mode="aspectFit" />
        </view>
        <view wx:if="{{item.count > 0}}" class="count-badge">{{item.count > 99 ? '99+' : item.count}}</view>
        <text class="order-cell-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-head">
      <text class="card-title">经营概览</text>
      <view class="card-more semantic-link" bindtap="openStatsDetail" role="button">查看详情 ›</view>
    </view>
    <view class="profile-summary">
      <view class="stat-item" bindtap="openStatsDetail" role="button">
        <text class="stat-value semantic-money">{{stats.monthlyRevenue}}</text>
        <text class="stat-label">本月已完成收入</text>
      </view>
      <view class="stat-item" bindtap="goStatsOrders" role="button">
        <text class="stat-value">{{stats.monthOrders}}</text>
        <text class="stat-label">本月预约</text>
      </view>
      <view class="stat-item" bindtap="goStatsCustomers" role="button">
        <text class="stat-value">{{stats.customers}}</text>
        <text class="stat-label">总客户</text>
      </view>
    </view>
  </view>

  <!-- ============ 工具 ============ -->
  <view class="card">
    <text class="card-title">经营工具</text>
    <view class="tool-grid">
      <view
        wx:for="{{tools}}"
        wx:key="key"
        class="tool-cell" role="button" hover-class="profile-tile-pressed"
        bindtap="onTool"
        data-key="{{item.key}}"
      >
        <view class="tool-icon-bg tool-bg-{{item.key}}">
          <image class="tool-icon" src="{{item.icon}}" mode="aspectFit" />
          <!-- 服务开启状态点 -->
          <view wx:if="{{item.key === 'shops' && shopServiceOn}}" class="tool-status-dot dot-on"></view>
        </view>
        <text class="tool-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="card profile-invite-entry" bindtap="openInviteDetail" role="button" hover-class="profile-pressed">
    <view><text class="status-label">邀请客户</text><text class="profile-helper">通过邀请码建立客户绑定</text></view>
    <text class="menu-arrow">›</text>
  </view>

  <!-- ============ 设置 ============ -->
  <view class="card">
    <text class="card-title">账号与设置</text>
    <view class="menu-list">
      <view class="menu-item" bindtap="editProfile">
        <image class="menu-icon" src="/static/icons/tab-profile.svg" mode="aspectFit" aria-hidden="true" /><text class="menu-label">个人资料</text><text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="navigateToAccountSecurity">
        <image class="menu-icon" src="/static/icons/shield.svg" mode="aspectFit" aria-hidden="true" /><text class="menu-label">账号与安全</text><text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="navigateToHelp">
        <image class="menu-icon" src="/static/icons/tab-chat.svg" mode="aspectFit" aria-hidden="true" /><text class="menu-label">帮助与反馈</text><text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="navigateToAbout">
        <image class="menu-icon" src="/static/icons/info.svg" mode="aspectFit" aria-hidden="true" /><text class="menu-label">关于我们</text><text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="switchRole">
        <image class="menu-icon" src="/static/icons/switch.svg" mode="aspectFit" aria-hidden="true" /><text class="menu-label">切换角色</text><text class="menu-value">当前：美甲师</text><text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="switchAccount">
        <image class="menu-icon" src="/static/icons/tab-profile.svg" mode="aspectFit" aria-hidden="true" /><text class="menu-label">切换账号</text><text class="menu-arrow">›</text>
      </view>
      <view class="menu-item account-logout" bindtap="logout">
        <image class="menu-icon" src="/static/icons/lock.svg" mode="aspectFit" aria-hidden="true" /><text class="menu-label">退出登录</text><text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <text class="version">NailBook v1.0.0</text>
</view>

<!-- 低频信息按需展开，保留全部原有指标及邀请码操作。 -->
<view wx:if="{{showStatsDetail || showInviteDetail}}" class="ws-overlay" bindtap="closeProfileDetail">
  <view class="ws-sheet profile-detail-sheet" catchtap="preventBubble">
    <view class="ws-header">
      <text class="ws-title">{{showStatsDetail ? '经营详情' : '邀请客户'}}</text>
      <view class="ws-close semantic-link" bindtap="closeProfileDetail" role="button" aria-label="关闭详情">关闭</view>
    </view>
    <scroll-view scroll-y class="profile-detail-body">
      <block wx:if="{{showStatsDetail}}">
    <view class="profile-detail-stats">
      <!-- 第一行：预约维度 -->
      <view class="stats-row">
        <view class="stat-item" bindtap="goStatsOrders">
          <text class="stat-value">{{stats.todayOrders}}</text>
          <text class="stat-label">今日预约</text>
        </view>

        <view class="stat-item" bindtap="goStatsOrders">
          <text class="stat-value">{{stats.monthOrders}}</text>
          <text class="stat-label">本月预约</text>
        </view>

        <view class="stat-item" bindtap="goStatsPending">
          <text class="stat-value {{stats.pendingTotal > 0 ? 'stat-value-alert' : ''}}">{{stats.pendingTotal}}</text>
          <text class="stat-label">待处理</text>
        </view>
      </view>



      <view class="stats-row business-row">
        <view class="stat-item">
          <text class="semantic-money stat-value business-value">{{stats.monthlyRevenue}}</text>
          <text class="stat-label">本月已完成收入</text>
        </view>

        <view class="stat-item">
          <text class="stat-value business-value">{{stats.rating}}</text>
          <text class="stat-label">客户评分</text>
        </view>
      </view>



      <view class="stats-row business-row">
        <view class="stat-item">
          <text class="stat-value business-value {{stats.averageTicket && stats.averageTicket !== '待积累' ? 'semantic-money' : 'profile-muted'}}">{{stats.averageTicket || '待积累'}}</text>
          <text class="stat-label">平均客单价</text>
        </view>

        <view class="stat-item">
          <text class="stat-value business-value">{{stats.repeatRate || '待积累'}}</text>
          <text class="stat-label">客户复购率</text>
        </view>
      </view>



      <!-- 第二行：客户与作品维度 -->
      <view class="stats-row">
        <view class="stat-item" bindtap="goStatsCustomers">
          <text class="stat-value">{{stats.customers}}</text>
          <text class="stat-label">总客户</text>
        </view>

        <view class="stat-item" bindtap="goStatsCustomers">
          <text class="stat-value">{{stats.newCustomers}}</text>
          <text class="stat-label">本月新客</text>
        </view>

        <view class="stat-item" bindtap="goStatsWorks">
          <text class="stat-value">{{stats.works}}</text>
          <text class="stat-label">总作品</text>
        </view>
      </view>
    </view>
      </block>
      <block wx:else>
  <!-- ============ 邀请码 ============ -->
  <view class="profile-invite-content">
    <view class="invite-head">
      <view>
        <text class="card-title">邀请客户</text>
        <text class="invite-sub">客户打开邀请后，微信授权注册即可自动绑定你</text>
      </view>
    </view>
    <view wx:if="{{userInfo.invitationCode}}" class="invite-actions">
      <button class="invite-action invite-primary booking-action" open-type="share" data-invite="client" hover-class="profile-pressed">发送给微信好友</button>
      <button class="invite-action invite-secondary booking-action" bindtap="copyInviteLink" loading="{{inviteLinkLoading}}" disabled="{{inviteLinkLoading}}" hover-class="profile-pressed">复制专属邀请链接</button>
      <text wx:if="{{inviteLink}}" class="profile-helper">链接有效至 {{inviteLinkExpires}}，过期后可重新生成</text>
      <text class="profile-helper">新客户注册后自动绑定；已有客户的默认美甲师不会被更换。</text>
    </view>
    <view class="invite-code-row">
      <view class="invite-code-block">
        <text class="invite-code-cap">我的邀请码</text>
        <text class="invite-code">{{userInfo.invitationCode || '暂无'}}</text>
      </view>
      <view wx:if="{{userInfo.invitationCode}}" class="invite-copy semantic-link" bindtap="copyInvite">复制</view>
    </view>
  </view>


      </block>
    </scroll-view>
  </view>
</view>

<!-- ========== 工作时间设置弹窗 ========== -->
<view wx:if="{{showScheduleModal}}" class="ws-overlay" bindtap="closeScheduleModal">
  <view class="ws-sheet" catchtap="preventBubble">
    <!-- Header -->
    <view class="ws-header">
      <text class="ws-title">工作时间设置</text>
      <view class="ws-close" bindtap="closeScheduleModal">
        <text class="ws-close-icon">✕</text>
      </view>
    </view>

    <scroll-view scroll-y class="ws-body" enhanced show-scrollbar="{{false}}">
      <!-- 新增方案按钮 -->
      <view class="ws-add-btn" bindtap="addScheme">
        <text class="ws-add-icon">+</text>
        <text class="ws-add-text">新增方案</text>
      </view>

      <!-- 方案列表 -->
      <view class="ws-scheme-list">
        <view
          wx:for="{{schedule.schemes}}"
          wx:key="id"
          class="ws-scheme-card"
          bindtap="editScheme"
          data-index="{{index}}"
        >
          <view class="ws-scheme-row">
            <view class="ws-scheme-info">
              <view class="ws-scheme-name-row">
                <text class="ws-scheme-name">{{item.label}}</text>
                <view wx:if="{{item.id === schedule.activeSchemeId}}" class="ws-active-badge">
                  <text class="ws-active-badge-text">当前</text>
                </view>
              </view>
              <text class="ws-scheme-summary">{{item._summary}}</text>
            </view>
            <nb-switch checked="{{item.id === schedule.activeSchemeId}}" catchchange="toggleSchemeActive" data-id="{{item.id}}" label="{{item.label}}，{{item.id === schedule.activeSchemeId ? '当前启用' : '点击启用'}}"/>
          </view>
        </view>
      </view>

      <!-- 休息日设置 -->
      <view class="ws-rest-section">
        <view class="ws-rest-head">
          <text class="ws-rest-title">休息日设置</text>
          <text class="ws-rest-link" bindtap="openRestDayCalendar">设置休息日</text>
        </view>
        <view wx:if="{{schedule.restDays.length > 0}}" class="ws-rest-tags">
          <view wx:for="{{schedule.restDays}}" wx:key="*this" class="ws-rest-tag">
            <text class="ws-rest-tag-text">{{item}}</text>
            <text class="ws-rest-tag-x" catchtap="removeRestDay" data-date="{{item}}">×</text>
          </view>
        </view>
        <text wx:else class="ws-rest-empty">暂无设置休息日</text>
      </view>

      <!-- 底部留白给保存按钮 -->
      <view style="height: 32rpx;"></view>
    </scroll-view>

    <!-- 保存按钮（固定在底部） -->
    <view class="ws-footer">
      <view class="ws-save-btn {{savingSchedule ? 'ws-save-disabled' : ''}}" bindtap="saveSchedule">
        <text class="ws-save-text">{{savingSchedule ? '保存中...' : '保存工作时间'}}</text>
      </view>
    </view>
  </view>
</view>

<!-- ========== 方案编辑器弹窗 ========== -->
<view wx:if="{{showSchemeEditor}}" class="se-overlay" catchtap="closeSchemeEditor">
  <view class="se-sheet" catchtap="preventBubble">
    <!-- Header -->
    <view class="se-header">
      <text class="se-title">工作时间方案</text>
    </view>

    <scroll-view scroll-y class="se-body" enhanced show-scrollbar="{{false}}">
      <!-- 错误提示 -->
      <view wx:if="{{schemeError}}" class="se-error">
        <text class="se-error-text">{{schemeError}}</text>
      </view>

      <!-- 时间范围 -->
      <view class="se-section">
        <text class="se-label">工作时间</text>
        <view class="se-time-row">
          <view class="se-time-col">
            <text class="se-time-sublabel">开始</text>
            <picker mode="multiSelector" range="{{[timeOptions]}}" value="{{[startTimeIdx]}}" bindchange="onStartTimeChange">
              <view class="se-time-picker">
                <text class="se-time-value">{{editingScheme.startTime}}</text>
                <text class="se-time-arrow">▾</text>
              </view>
            </picker>
          </view>
          <text class="se-time-dash">—</text>
          <view class="se-time-col">
            <text class="se-time-sublabel">结束</text>
            <picker mode="multiSelector" range="{{[timeOptions]}}" value="{{[endTimeIdx]}}" bindchange="onEndTimeChange">
              <view class="se-time-picker">
                <text class="se-time-value">{{editingScheme.endTime}}</text>
                <text class="se-time-arrow">▾</text>
              </view>
            </picker>
          </view>
        </view>
      </view>

      <!-- 应用范围（星期） -->
      <view class="se-section">
        <text class="se-label">应用范围</text>
        <view class="se-day-grid">
          <view
            wx:for="{{dayKeys}}"
            wx:key="*this"
            class="se-day-btn {{selectedDaysMap[item] ? 'se-day-active' : ''}}"
            bindtap="toggleSchemeDay"
            data-day="{{item}}"
          >
            <text class="se-day-text">{{dayLabels[item]}}</text>
          </view>
        </view>
      </view>

      <!-- 方案标签 -->
      <view class="se-section">
        <text class="se-label">方案标签</text>
        <input
          class="se-label-input"
          placeholder="如：日常、周末"
          value="{{editingScheme.label}}"
          bindinput="onSchemeLabelInput" confirm-type="done" />
      </view>
    </scroll-view>

    <!-- Footer -->
    <view class="se-footer">
      <view wx:if="{{editingScheme.days.length > 0}}" class="se-delete-btn semantic-danger" bindtap="deleteScheme">
        <text class="se-delete-text semantic-danger">删除</text>
      </view>
      <view class="se-footer-right">
        <view class="se-cancel-btn" bindtap="closeSchemeEditor">
          <text class="se-cancel-text">取消</text>
        </view>
        <view class="se-save-btn" bindtap="saveScheme">
          <text class="se-save-text">保存</text>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 休息日日历 -->
<rest-day-calendar
  wx:if="{{showScheduleModal}}"
  show="{{showRestDayCalendar}}"
  value="{{schedule.restDays}}"
  bindconfirm="onRestDayConfirm"
  bindclose="closeRestDayCalendar"
/>

<!-- ========== 服务类型引导弹窗（仅工作时间设置时触发） ========== -->
<view wx:if="{{showServiceTypeModal}}" class="st-overlay" bindtap="closeServiceTypeModal">
  <view class="st-sheet" catchtap="preventBubble">
    <!-- Header -->
    <view class="st-header">
      <view class="st-header-info">
        <text class="st-title">开启服务类型</text>
        <text class="st-subtitle">需要先开启到店服务，才能设置工作时间</text>
      </view>
      <view class="st-close" bindtap="closeServiceTypeModal">
        <text class="st-close-icon">✕</text>
      </view>
    </view>

    <scroll-view scroll-y class="st-body" enhanced show-scrollbar="{{false}}">
      <!-- 到店服务配置 -->
      <view>
        <view wx:if="{{shopLoading}}" class="st-loading">
          <view class="loading-spinner"></view>
        </view>
        <view wx:else>
          <!-- 店铺列表 -->
          <view wx:if="{{shopList.length > 0}}" class="st-shop-list">
            <view wx:for="{{shopList}}" wx:key="name" class="st-shop-card">
              <view class="st-shop-info">
                <text class="st-shop-name">{{item.name}}</text>
                <text class="st-shop-address">{{item.detailAddress || item.address}}</text>
                <text wx:if="{{item.phone}}" class="st-shop-phone">电话：{{item.phone}}</text>
              </view>
              <view class="st-shop-actions">
                <view class="st-shop-edit" bindtap="openShopForm" data-shop="{{item}}">编辑</view>
                <view class="st-shop-delete semantic-danger" bindtap="deleteShop" data-name="{{item.name}}" data-address="{{item.detailAddress || item.address}}">删除</view>
              </view>
            </view>
          </view>

          <!-- 空状态 -->
          <view wx:if="{{shopList.length === 0 && !showShopForm}}" class="st-empty">
            <view class="st-empty-icon st-empty-shop-icon"></view>
            <text class="st-empty-text">还没有店铺</text>
            <text class="st-empty-sub">添加店铺信息，方便客户到店</text>
          </view>

          <!-- 添加店铺按钮 -->
          <view wx:if="{{!showShopForm}}" class="st-add-shop-btn" bindtap="openShopForm">
            <text class="st-add-icon">+</text>
            <text>{{shopList.length > 0 ? '添加更多店铺' : '添加第一个店铺'}}</text>
          </view>

          <!-- 店铺表单 -->
          <view wx:if="{{showShopForm}}" class="st-shop-form">
            <view class="st-form-header">
              <text class="st-form-title">{{editingShop ? '编辑店铺' : '添加店铺'}}</text>
              <view class="st-form-close" bindtap="closeShopForm">✕</view>
            </view>
            <view class="st-field">
              <text class="st-field-label">店铺名称 *</text>
              <input class="st-field-input" value="{{shopName}}" bindinput="onShopNameInput" placeholder="请输入店铺名称" confirm-type="done" />
            </view>
            <view class="st-field">
              <text class="st-field-label">详细地址 *</text>
              <input class="st-field-input" value="{{shopAddress}}" bindinput="onShopAddressInput" placeholder="请输入地址" confirm-type="done" />
            </view>
            <view class="st-field">
              <text class="st-field-label">联系电话（选填）</text>
              <input class="st-field-input" type="number" value="{{shopPhone}}" bindinput="onShopPhoneInput" placeholder="选填" confirm-type="done" />
            </view>
            <view class="st-save-btn {{shopSaving ? 'st-save-disabled' : ''}}" bindtap="saveShop">
              <text>{{shopSaving ? '保存中...' : '保存店铺'}}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>

<tab-bar selected="profile" />
