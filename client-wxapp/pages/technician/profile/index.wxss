}

.st-tab-icon {
  color: #6b7280;
  flex-shrink: 0;
}
.st-tab-active .st-tab-icon {
  color: #ff6b8a;
}
.st-tab-icon-home {
  position: relative;
  width: 34rpx;
  height: 28rpx;
  margin-top: 6rpx;
  border: 3rpx solid currentColor;
  border-radius: 5rpx;
  box-sizing: border-box;
}
.st-tab-icon-home::before {
  content: '';
  position: absolute;
  left: 5rpx;
  top: -11rpx;
  width: 18rpx;
  height: 18rpx;
  border-left: 3rpx solid currentColor;
  border-top: 3rpx solid currentColor;
  background: inherit;
  transform: rotate(45deg);
}
.st-tab-icon-shop {
  position: relative;
  width: 36rpx;
  height: 30rpx;
  margin-top: 4rpx;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
  box-sizing: border-box;
}
.st-tab-icon-shop::before {
  content: '';
  position: absolute;
  left: -3rpx;
  top: -8rpx;
  width: 36rpx;
  height: 8rpx;
  border: 3rpx solid currentColor;
  border-radius: 5rpx 5rpx 2rpx 2rpx;
  box-sizing: border-box;
}

.st-tab-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
}
.st-tab-active .st-tab-text {
  color: #ff6b8a;
}

.st-tab-dot {
  position: absolute;
