  align-items: center;
  justify-content: center;
}
.se-day-btn:active { background: #e5e7eb; }

.se-day-active {
  background: linear-gradient(135deg, #ff6b8a, #8b5cf6);
}
.se-day-active:active { opacity: 0.85; }

.se-day-text {
  font-size: 26rpx;
