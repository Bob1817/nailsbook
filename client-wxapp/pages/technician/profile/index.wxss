/* ===== 工作时间设置弹窗 ===== */
.ws-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.4);
}

.ws-sheet {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  max-height: 80vh;
  background: #ffffff;
  border-radius: 48rpx 48rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.ws-header {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 40rpx;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.ws-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
}

.ws-close {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ws-close:active { background: #e5e7eb; }
.ws-close-icon { font-size: 28rpx; color: #6b7280; font-weight: 600; }

.ws-body {
  flex: 1;
  min-height: 0;
  padding: 24rpx 0;
  overflow: hidden;
}

/* 新增方案按钮 */
.ws-add-btn {
  height: 88rpx;
  border-radius: 16rpx;
  background: #f7f3f5;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 0 40rpx 24rpx;
}
.ws-add-btn:active { background: #ece8eb; }
.ws-add-icon { font-size: 32rpx; color: #6b7280; font-weight: 600; }
.ws-add-text { font-size: 28rpx; font-weight: 600; color: #6b7280; }

/* 方案列表 */
.ws-scheme-list {
  background: #ffffff;
  border-radius: 18rpx;
  border: 2rpx solid rgba(255, 107, 138, 0.08);
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.05);
  overflow: hidden;
  margin: 0 40rpx 24rpx;
}

.ws-scheme-card {
  padding: 28rpx;
}
.ws-scheme-card:active { background: #fefbfc; }
.ws-scheme-card + .ws-scheme-card {
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.ws-scheme-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ws-scheme-info {
  flex: 1;
  min-width: 0;
}

.ws-scheme-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ws-scheme-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.ws-active-badge {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #EEF9F1;
}
.ws-active-badge-text {
  font-size: 20rpx;
  font-weight: 600;
  color: #31B46C;
}

.ws-scheme-summary {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

/* 开关 */
.ws-switch {
  width: 112rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: #ddd8de;
  position: relative;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.ws-switch-on {
  background: #31B46C;
}

.ws-switch-knob {
  position: absolute;
  top: 20rpx;
  left: 8rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(29, 35, 53, 0.18);
  transition: left 0.2s;
}

.ws-switch-on .ws-switch-knob {
  left: 56rpx;
}

/* 休息日设置 */
.ws-rest-section {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 28rpx;
  border: 2rpx solid rgba(255, 107, 138, 0.08);
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.05);
  margin: 0 40rpx 24rpx;
}

.ws-rest-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.ws-rest-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.ws-rest-link {
  font-size: 26rpx;
  font-weight: 500;
  color: #ff6b8a;
}
.ws-rest-link:active { opacity: 0.7; }

.ws-rest-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ws-rest-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f2f0f3;
}

.ws-rest-tag-text {
  font-size: 22rpx;
  font-weight: 500;
  color: #6b7280;
}

.ws-rest-tag-x {
  font-size: 28rpx;
  color: #6b7280;
  line-height: 1;
  padding: 0 4rpx;
}
.ws-rest-tag-x:active { color: #6b7280; }

.ws-rest-empty {
  font-size: 26rpx;
  color: #6b7280;
}

/* 保存按钮 */
.ws-footer {
  padding: 16rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
  background: #ffffff;
}

.ws-save-btn {
  height: 88rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #ff6b8a, #8b5cf6);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(255, 94, 147, 0.25);
}
.ws-save-btn:active { opacity: 0.85; }
.ws-save-disabled { opacity: 0.6; }
.ws-save-text { font-size: 30rpx; font-weight: 600; color: #ffffff; }

/* ===== 方案编辑器弹窗 ===== */
.se-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1100;
  background: rgba(0, 0, 0, 0.5);
}

.se-sheet {
  position: absolute;
