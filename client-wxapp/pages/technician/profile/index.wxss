.tool-bg-homeService  { background: #FFF7ED; }
.tool-bg-serviceTime  { background: #F0FDF4; }
.tool-bg-shops        { background: #EFF6FF; }
.tool-bg-tags         { background: #FEFCE8; }
.tool-bg-subscription { background: #FDF4FF; }

