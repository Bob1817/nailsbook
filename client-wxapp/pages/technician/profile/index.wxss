page { background: var(--bg-gradient-entry); }

.page {
  min-height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ===== Header ===== */
.header {
  position: relative;
  background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-primary-light) 50%, var(--brand-primary-light) 100%);
  padding: 64rpx 40rpx 32rpx;
}
.header-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.avatar-wrap { flex-shrink: 0; }
.avatar, .avatar-placeholder {
  width: 112rpx; height: 112rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
}
.avatar-placeholder {
  background: rgba(255, 255, 255, 0.22);
  display: flex; align-items: center; justify-content: center;
}
.avatar-char { font-size: var(--font-2xl); font-weight: var(--weight-bold); color: var(--text-inverse); }

.user-info { flex: 1; min-width: 0; }
.name {
  display: block;
  font-size: var(--font-xl); font-weight: var(--weight-bold); color: var(--text-inverse);
  text-shadow: 0 2rpx 6rpx rgba(112, 35, 71, 0.16);
}
.phone {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.85);
}
.profile-share-btn { min-width:176rpx; height:88rpx; margin:0; padding:0 22rpx; display:flex; align-items:center; justify-content:center; gap:10rpx; border:1rpx solid rgba(255,255,255,.28); border-radius:999rpx; background:rgba(255,255,255,.18); color: var(--text-inverse); font-size: var(--font-sm); font-weight: var(--weight-semibold); line-height:1; }
.profile-share-btn::after { border:none; }
.profile-share-btn:active { background:rgba(255,255,255,.3); }
.profile-share-icon { position:relative; width:28rpx; height:28rpx; border:3rpx solid currentColor; border-radius:6rpx; box-sizing:border-box; }
.profile-share-icon::before { content:''; position:absolute; width:14rpx; height:14rpx; left:4rpx; top:-10rpx; border-top:3rpx solid currentColor; border-left:3rpx solid currentColor; transform:rotate(45deg); }

/* 接单状态切换 */
.status-bar {
  min-height: 88rpx;
  margin-top: 20rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.status-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}
.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.dot-on { background: #4ade80; box-shadow: 0 0 8rpx rgba(74, 222, 128, 0.9); }
.dot-off { background: rgba(255, 255, 255, 0.55); }
.status-label {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-inverse);
  line-height: 1;
}
.status-action-hint { color:rgba(255,255,255,.72); font-size:22rpx; }

.status-schedule-btn {
  width: 88rpx;
  height: 88rpx;
  margin-right: -20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.status-schedule-btn:active { opacity: 0.65; }
.status-schedule-icon-svg {
  width: 28rpx; height: 28rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23ffffff' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'/><polyline points='12 6 12 12 16 14'/></svg>");
}

/* 数据概览悬浮卡（分组清晰） */
.stats-card {
  margin-top: var(--space-md);
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  border: 2rpx solid var(--border-light);
  box-shadow: var(--shadow-lg);
  overflow: hidden;
}
.stats-row {
  display: flex;
  align-items: stretch;
  padding: 24rpx 20rpx;
}
.stats-h-divider {
  height: 1rpx;
  background: var(--bg-gradient-entry);
  margin: 0 28rpx;
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 4rpx 0;
}
.stat-item:active { opacity: 0.6; }
.stat-value { font-size: var(--font-lg); font-weight: var(--weight-bold); color: var(--text-primary); line-height: 1.1; }
.stat-value-alert { color: var(--brand-primary); }
.stat-label { font-size: var(--font-xs); color: var(--text-muted); text-align: center; line-height: 1.35; }
.stat-divider { width: 1rpx; align-self: stretch; background: var(--bg-gradient-entry); flex-shrink: 0; margin: 6rpx 0; }
.business-row { min-height: 92rpx; }
.business-value { font-size: var(--font-lg); color: var(--brand-primary); }
/* 分组背景：每两组之间用微弱背景区分 */
.stats-card .stats-row:nth-child(5) { background: linear-gradient(180deg, rgba(255,248,251,0.5) 0%, transparent 100%); }
.stats-card .stats-row:nth-child(1) { background: linear-gradient(180deg, transparent 0%, rgba(255,248,251,0.5) 100%); }

/* ===== 卡片 ===== */
.card {
  margin: 16rpx 40rpx 0;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  border: 2rpx solid var(--border-light);
  box-shadow: var(--shadow-lg);
}
.card-gap { margin-top: 16rpx; }

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-md);
}
.card-head .card-title { margin-bottom: 0; }
.card-title {
  display: block;
  font-size: var(--font-md); font-weight: var(--weight-semibold); color: var(--text-primary);
  margin-bottom: var(--space-md);
}
.card-more {
  min-height: 88rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  font-size: var(--font-sm);
  color: var(--brand-primary);
  font-weight: var(--weight-medium);
}

/* ===== 我的预约 ===== */
.order-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 8rpx;
}
.order-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.order-cell:active { opacity: 0.7; }
.order-cell-badge {
  position: relative;
  width: 88rpx; height: 88rpx;
  border-radius: var(--card-radius);
  display: flex; align-items: center; justify-content: center;
}
.order-cell-badge.has-count { box-shadow: 0 0 0 2rpx rgba(255,107,138,0.18) /* brand-primary-alpha */; }
.order-cell-icon {
  width: 44rpx; height: 44rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}
.count-badge {
  position: absolute;
  top: -8rpx; right: -8rpx;
  min-width: 32rpx; height: 32rpx;
  padding: 0 8rpx;
  background: var(--brand-gradient);
  border-radius: 999rpx;
  color: var(--text-inverse); font-size: var(--font-xs); font-weight: var(--weight-bold);
  display: flex; align-items: center; justify-content: center;
  border: 2rpx solid #fff;
}
.order-cell-label {
  font-size: var(--font-xs);
  color: var(--text-muted);
  text-align: center;
}

/* ===== 邀请码 ===== */
.invite-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.invite-sub {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-xs);
  color: var(--text-muted);
}
.invite-code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 40rpx;
  background: var(--bg-gradient-entry);
  border-radius: var(--radius-sm);
  border: 1rpx dashed #f2cdd9;
}
.invite-code-block { display: flex; flex-direction: column; gap: 6rpx; }
.invite-code-cap { font-size: var(--font-xs); color: var(--text-muted); }
.invite-code {
  font-size: var(--font-lg); font-weight: var(--weight-bold); color: var(--brand-primary);
  letter-spacing: 3rpx;
}
.invite-copy {
  padding: 0 40rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--btn-radius);
  background: #FFF1F6;
  color: var(--brand-primary);
  font-size: var(--font-sm); font-weight: var(--weight-semibold);
}

/* ===== 工具网格 ===== */
.tool-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx 8rpx;
}
.tool-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.tool-cell:active { opacity: 0.7; }
.tool-icon-bg {
  position: relative;
  width: 88rpx; height: 88rpx;
  border-radius: var(--card-radius);
  display: flex; align-items: center; justify-content: center;
}
.tool-icon {
  width: 44rpx; height: 44rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}
.tool-label { font-size: var(--font-xs); color: var(--text-muted); text-align: center; }

/* 服务开启状态点 */
.tool-status-dot {
  position: absolute;
  top: 6rpx; right: 6rpx;
  width: 16rpx; height: 16rpx;
  border-radius: 50%;
  border: 3rpx solid #fff;
}
.dot-on  { background: #22c55e; }
.dot-off { background: #d1d5db; }

/* ===== 新手引导卡 ===== */
.setup-guide-card {
  margin: 20rpx 40rpx 0;
  background: linear-gradient(135deg, #fff8fb 0%, #fdf4ff 100%);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(255,107,138,0.12) /* brand-primary-alpha */;
  border: 1rpx solid #fde4ec;
}
.setup-guide-head { margin-bottom: 28rpx; }
.setup-guide-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.setup-guide-title {
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
}
.setup-guide-badge {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff6b8a, #a855f7);
  color: var(--text-inverse);
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
}
.setup-guide-desc {
  font-size: var(--font-sm);
  color: var(--text-muted);
  line-height: var(--leading-normal);
}

.setup-steps {
  background: rgba(255, 255, 255, 0.7);
  border-radius: var(--radius-md);
  overflow: hidden;
}
.setup-step {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md) 28rpx;
}
.setup-step:active { background: rgba(255,107,138,0.05) /* brand-primary-alpha */; }
.setup-step-divider {
  height: 1rpx;
  margin: 0 28rpx;
  background: rgba(0, 0, 0, 0.05);
}
.setup-step-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}
.setup-step-icon-wrap {
  width: 72rpx; height: 72rpx;
  border-radius: var(--radius-sm);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  background: #fde8f0;
  color: var(--brand-primary);
  font-size: 26rpx;
  font-weight: var(--weight-semibold);
}
.setup-step-done { background:#e8f7ee; color:#168a4a; }
.setup-step-icon-home { background: #fde8f0; }
.setup-step-icon-shop { background: #dbeafe; }
.setup-step-icon-svg {
  width: 40rpx; height: 40rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}
.setup-step-home-svg {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23f43f5e' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'/><polyline points='9 22 9 12 15 12 15 22'/></svg>");
}
.setup-step-shop-svg {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%233b82f6' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z'/><line x1='3' y1='6' x2='21' y2='6'/><path d='M16 10a4 4 0 0 1-8 0'/></svg>");
}
.setup-step-text { flex: 1; min-width: 0; }
.setup-step-label {
  display: block;
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin-bottom: 4rpx;
}
.setup-step-hint {
  display: block;
  font-size: var(--font-xs);
  color: var(--text-muted);
}
.setup-step-action {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}
.setup-step-btn {
  font-size: var(--font-sm);
  font-weight: var(--weight-semibold);
  color: var(--brand-primary);
}
.setup-step-arrow {
  font-size: var(--font-lg);
  color: var(--brand-primary);
  line-height: 1;
}

/* ===== 设置菜单 ===== */
.menu-list { display: flex; flex-direction: column; }
.menu-item {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255,107,138,0.08) /* brand-primary-alpha */;
}
.menu-item:last-child { border-bottom: none; }
.menu-item:active { opacity: 0.6; }
.menu-icon { position:relative; width:40rpx; height:40rpx; margin-right:20rpx; flex-shrink:0; color:#9d5274; box-sizing:border-box; }
.icon-settings { border:4rpx solid currentColor; border-radius:50%; box-shadow:inset 0 0 0 7rpx #fff; background:currentColor; }
.icon-settings::before,.icon-settings::after { content:''; position:absolute; left:14rpx; top:-7rpx; width:4rpx; height:46rpx; border-radius:3rpx; background:currentColor; transform-origin:center; }
.icon-settings::after { transform:rotate(90deg); }
.icon-lock { top:10rpx; height:28rpx; border:4rpx solid currentColor; border-radius:7rpx; }
.icon-lock::before { content:''; position:absolute; left:7rpx; top:-18rpx; width:18rpx; height:18rpx; border:4rpx solid currentColor; border-bottom:0; border-radius: var(--radius-xs) 12rpx 0 0; box-sizing:border-box; }
.icon-help,.icon-about { display:flex; align-items:center; justify-content:center; border:4rpx solid currentColor; border-radius:50%; font-size: var(--font-sm); font-weight:800; }
.icon-help::before { content:'?'; }.icon-about::before { content:'i'; }
.icon-switch::before,.icon-switch::after { content:''; position:absolute; left:3rpx; width:30rpx; height:12rpx; border-top:4rpx solid currentColor; border-right:4rpx solid currentColor; }
.icon-switch::before { top:7rpx; transform:skewX(35deg); }.icon-switch::after { bottom:5rpx; transform:rotate(180deg) skewX(35deg); }
.menu-label { flex: 1; font-size: var(--font-md); color: var(--text-primary); }
.menu-arrow { font-size: var(--font-lg); color: var(--text-muted); }

/* ===== 退出 ===== */
.logout-btn {
  margin: 32rpx 40rpx 0;
  height: 88rpx;
  border-radius: var(--btn-radius);
  background: var(--bg-card);
  border: 2rpx solid rgba(255,107,138,0.08) /* brand-primary-alpha */;
  color: var(--text-error);
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-lg);
}
.logout-btn:active { opacity: 0.8; }
.version {
  display: block;
  margin-top: var(--space-md);
  text-align: center;
  font-size: var(--font-xs);
  color: var(--text-muted);
}

/* ===== 我的预约：per-status 背景色（收束到 粉/紫/蓝 三色系） ===== */
.order-bg-pending_quote   { background: var(--tone-blue-bg); }
.order-bg-pending_confirm { background: var(--tone-amber-bg); }
.order-bg-pending_home    { background: var(--tone-rose-bg); }
.order-bg-pending_shop    { background: var(--tone-sky-bg); }
.order-bg-in_progress     { background: var(--tone-purple-bg); }

/* ===== 我的预约：per-status SVG 图标 ===== */
.order-icon-pending_quote {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%236366f1' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z'/></svg>");
}
.order-icon-pending_confirm {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23f59e0b' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'/><polyline points='12 6 12 12 16 14'/></svg>");
}
.order-icon-pending_home {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23f43f5e' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z'/><circle cx='12' cy='10' r='3'/></svg>");
}
.order-icon-pending_shop {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%233b82f6' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z'/><line x1='3' y1='6' x2='21' y2='6'/><path d='M16 10a4 4 0 0 1-8 0'/></svg>");
}
.order-icon-in_progress {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23a855f7' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><polygon points='13 2 3 14 12 14 11 22 21 10 12 10 13 2'/></svg>");
}

/* ===== 工具：per-key 背景色（收束到 粉/紫/蓝 三色系） ===== */
.tool-bg-services     { background: var(--bg-tag); }     /* 粉 */
.tool-bg-homepage     { background: var(--bg-tag); }     /* 粉 */
.tool-bg-works        { background: var(--tone-blue-bg); } /* 蓝 */
.tool-bg-marketing    { background: var(--tone-purple-bg); } /* 紫 */
.tool-bg-designs      { background: var(--bg-tag); }     /* 粉 */
.tool-bg-homeService  { background: var(--tone-amber-bg); } /* 琥珀 */
.tool-bg-serviceTime  { background: var(--tone-teal-bg); }  /* 青绿 */
.tool-bg-shops        { background: var(--tone-sky-bg); }   /* 天蓝 */
.tool-bg-tags         { background: var(--tone-yellow-bg); }/* 黄 */
.tool-bg-referrals    { background: var(--tone-emerald-bg); }/* 绿 */
.tool-bg-subscription { background: var(--tone-purple-bg); }/* 紫 */

/* ===== 工具：per-key SVG 图标 ===== */
.tool-icon-homepage {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23c0527f' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='8' r='4'/><path d='M4 21a8 8 0 0 1 16 0'/><path d='M18 3h3v3'/></svg>");
}
.tool-icon-services {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23ff6b8a' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='6' cy='6' r='3'/><circle cx='6' cy='18' r='3'/><line x1='20' y1='4' x2='8.12' y2='15.88'/><line x1='14.47' y1='14.48' x2='20' y2='20'/><line x1='8.12' y1='8.12' x2='12' y2='12'/></svg>");
}
.tool-icon-works {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%236366f1' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='3' width='18' height='18' rx='2' ry='2'/><circle cx='8.5' cy='8.5' r='1.5'/><polyline points='21 15 16 10 5 21'/></svg>");
}
.tool-icon-marketing {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23ec4899' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'><path d='M3 11l18-7-7 18-3-8-8-3z'/><path d='M11 14L21 4'/></svg>");
}
.tool-icon-designs {
