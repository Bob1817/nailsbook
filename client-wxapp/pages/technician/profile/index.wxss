/* ===== 工作时间设置弹窗 ===== */
.ws-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.4);
}

.ws-sheet {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  max-height: 80vh;
  background: var(--bg-card);
  border-radius: var(--btn-radius) 48rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.ws-header {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 40rpx;
  background: var(--bg-card);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.ws-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
}

.ws-close {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-input);
  display: flex;
  align-items: center;
  justify-content: center;
}
.ws-close:active { background: #e5e7eb; }
.ws-close-icon { font-size: var(--font-md); color: var(--text-muted); font-weight: var(--weight-semibold); }

.ws-body {
  flex: 1;
  min-height: 0;
  padding: var(--space-md) 0;
  overflow: hidden;
}

/* 新增方案按钮 */
.ws-add-btn {
  height: 88rpx;
  border-radius: var(--radius-sm);
  background: #f7f3f5;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 0 40rpx 24rpx;
}
.ws-add-btn:active { background: #ece8eb; }
.ws-add-icon { font-size: var(--font-lg); color: var(--text-muted); font-weight: var(--weight-semibold); }
.ws-add-text { font-size: var(--font-md); font-weight: var(--weight-semibold); color: var(--text-muted); }

/* 方案列表 */
.ws-scheme-list {
  background: var(--bg-card);
  border-radius: var(--card-radius);
  border: 2rpx solid rgba(255,107,138,0.08) /* brand-primary-alpha */;
  box-shadow: var(--shadow-lg);
  overflow: hidden;
  margin: 0 40rpx 24rpx;
}

.ws-scheme-card {
  padding: 28rpx;
}
.ws-scheme-card:active { background: #fefbfc; }
.ws-scheme-card + .ws-scheme-card {
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.ws-scheme-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ws-scheme-info {
  flex: 1;
  min-width: 0;
}

.ws-scheme-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ws-scheme-name {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.ws-active-badge {
  padding: 4rpx 16rpx;
  border-radius: var(--radius-md);
  background: #EEF9F1;
}
.ws-active-badge-text {
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
  color: #31B46C;
}

.ws-scheme-summary {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--text-muted);
}

/* 开关 */
.ws-switch {
  width: 112rpx;
  height: 88rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ws-switch-track {
  position: relative;
  width: 104rpx;
  height: 60rpx;
  border-radius: 999rpx;
  background: #ddd8de;
  transition: background 0.2s;
}

.ws-switch-knob {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--bg-card);
  box-shadow: 0 4rpx 12rpx rgba(29, 35, 53, 0.18);
  transition: left 0.2s;
}

.ws-switch-on { background: #31B46C; }
.ws-switch-on .ws-switch-knob { left: 50rpx; }

/* 休息日设置 */
.ws-rest-section {
  background: var(--bg-card);
  border-radius: var(--card-radius);
  padding: 28rpx;
  border: 2rpx solid rgba(255,107,138,0.08) /* brand-primary-alpha */;
  box-shadow: var(--shadow-lg);
  margin: 0 40rpx 24rpx;
}

.ws-rest-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.ws-rest-title {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.ws-rest-link {
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  color: var(--brand-primary);
}
.ws-rest-link:active { opacity: 0.7; }

.ws-rest-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ws-rest-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f2f0f3;
}

.ws-rest-tag-text {
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
  color: var(--text-muted);
}

.ws-rest-tag-x {
  font-size: var(--font-md);
  color: var(--text-muted);
  line-height: 1;
  padding: 0 4rpx;
}
.ws-rest-tag-x:active { color: var(--text-muted); }

.ws-rest-empty {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

/* 保存按钮 */
.ws-footer {
  padding: 16rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
  background: var(--bg-card);
}

.ws-save-btn {
  height: 88rpx;
  border-radius: var(--btn-radius);
  background: var(--brand-gradient);
