.container { min-height: 100vh; background: #f5f5f5; padding-bottom: 120rpx; }

/* 头部 */
.header { display: flex; align-items: center; background: linear-gradient(135deg, #FF6B8A, #FF8FA3); padding: 60rpx 32rpx 40rpx; gap: 24rpx; }
.header:active { opacity: 0.9; }
.avatar-wrap { flex-shrink: 0; }
.avatar { width: 120rpx; height: 120rpx; border-radius: 50%; border: 4rpx solid rgba(255,255,255,0.3); }
.avatar-placeholder { width: 120rpx; height: 120rpx; border-radius: 50%; background: rgba(255,255,255,0.25); display: flex; align-items: center; justify-content: center; }
.avatar-char { font-size: 48rpx; font-weight: 700; color: #fff; }
.user-info { flex: 1; }
.name { display: block; font-size: 36rpx; font-weight: 700; color: #fff; margin-bottom: 6rpx; }
.phone { display: block; font-size: 26rpx; color: rgba(255,255,255,0.8); margin-bottom: 12rpx; }
.status-row { display: flex; align-items: center; gap: 12rpx; }
.status-dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.dot-green { background: #4ade80; }
.dot-grey { background: rgba(255,255,255,0.5); }
.status-text { font-size: 24rpx; color: rgba(255,255,255,0.9); }
.toggle-status-btn { font-size: 22rpx; color: rgba(255,255,255,0.8); background: rgba(0,0,0,0.2); padding: 6rpx 16rpx; border-radius: 20rpx; }
.header-arrow { font-size: 44rpx; color: rgba(255,255,255,0.7); }

/* 统计 */
.stats-row { display: flex; align-items: center; background: #fff; padding: 28rpx 40rpx; margin: 0; }
.stat-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat-num { font-size: 40rpx; font-weight: 700; color: #1a1a1a; margin-bottom: 6rpx; }
.stat-label { font-size: 24rpx; color: #999; }
.stat-divider { width: 1rpx; height: 60rpx; background: #f0f0f0; }

/* 邀请码 */
.invite-card { margin: 20rpx 32rpx; background: linear-gradient(135deg, #FFF0F5, #F8F4FF); border-radius: 20rpx; padding: 24rpx 28rpx; display: flex; align-items: center; justify-content: space-between; }
.invite-card:active { opacity: 0.8; }
.invite-info { }
.invite-label { display: block; font-size: 24rpx; color: #999; margin-bottom: 6rpx; }
.invite-code { font-size: 36rpx; font-weight: 700; color: #FF6B8A; letter-spacing: 2rpx; }
.invite-copy { font-size: 26rpx; color: #FF6B8A; background: rgba(255,107,138,0.1); padding: 14rpx 24rpx; border-radius: 16rpx; }

/* 分区 */
.section { padding: 20rpx 32rpx 0; }
.section-title { display: block; font-size: 28rpx; font-weight: 600; color: #666; margin-bottom: 12rpx; }

/* 菜单 */
.menu-list { background: #fff; border-radius: 24rpx; overflow: hidden; margin-bottom: 4rpx; }
.menu-item { display: flex; align-items: center; padding: 26rpx 28rpx; border-bottom: 1rpx solid #f5f5f5; gap: 16rpx; }
.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: #fafafa; }
.menu-icon { font-size: 32rpx; }
.menu-label { flex: 1; font-size: 30rpx; color: #1a1a1a; }
.menu-arrow { font-size: 40rpx; color: #ccc; }

/* 退出 */
.logout-btn { margin: 24rpx 32rpx 0; background: #fff; border-radius: 24rpx; color: #ff4d4f; font-size: 30rpx; text-align: center; padding: 28rpx; }
.logout-btn:active { opacity: 0.7; }
