  background: var(--bg-card);
  border-radius: var(--card-radius);
  border: 2rpx solid rgba(255,107,138,0.08) /* brand-primary-alpha */;
  box-shadow: var(--shadow-lg);
  margin-bottom: var(--space-sm);
}
.st-shop-card:last-child {
  margin-bottom: 0;
}

.st-shop-info {
  margin-bottom: var(--space-sm);
}

.st-shop-name {
  display: block;
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.st-shop-address {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
  margin-bottom: 4rpx;
}

.st-shop-phone {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
}

.st-shop-actions {
  display: flex;
  gap: 16rpx;
}

.st-shop-edit,
.st-shop-delete {
  flex: 1;
  height: 72rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
}

.st-shop-edit {
  background: var(--bg-input);
  color: var(--text-body);
}
.st-shop-edit:active { background: #e5e7eb; }

.st-shop-delete {
  background: #fef2f2;
  color: var(--text-error);
}
.st-shop-delete:active { background: #fee2e2; }

/* 空状态 */
.st-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.st-empty-icon {
  margin-bottom: var(--space-sm);
}
.st-empty-shop-icon {
  position: relative;
  width: 88rpx;
  height: 70rpx;
  border: 4rpx solid #d9a0b9;
  border-radius: var(--radius-xs);
  box-sizing: border-box;
}
.st-empty-shop-icon::before {
  content: '';
  position: absolute;
  left: -4rpx;
  top: -18rpx;
  width: 88rpx;
  height: 20rpx;
  border: 4rpx solid #d9a0b9;
  border-radius: 10rpx 10rpx 4rpx 4rpx;
  box-sizing: border-box;
}

.st-empty-text {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.st-empty-sub {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

/* 添加店铺按钮 */
.st-add-shop-btn {
  height: 88rpx;
  border-radius: var(--radius-sm);
  background: #f7f3f5;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 0 40rpx 24rpx;
}
.st-add-shop-btn:active { background: #ece8eb; }
.st-add-icon {
  font-size: var(--font-lg);
  color: var(--text-muted);
  font-weight: var(--weight-semibold);
}
.st-add-shop-btn text {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-muted);
}

/* 店铺表单 */
.st-shop-form {
  margin: 0 40rpx 24rpx;
  padding: 28rpx;
  background: var(--bg-card);
  border-radius: var(--card-radius);
  border: 2rpx solid rgba(255,107,138,0.08) /* brand-primary-alpha */;
  box-shadow: var(--shadow-lg);
}

.st-form-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-md);
}

.st-form-title {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.st-form-close {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-input);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm);
  color: var(--text-muted);
}
.st-form-close:active { background: #e5e7eb; }
