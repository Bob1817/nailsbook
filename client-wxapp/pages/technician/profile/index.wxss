page { background: linear-gradient(180deg, #fff8fb 0%, #ffffff 34%, #f8f9fc 100%); }

.page {
  min-height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ===== Header ===== */
.header {
  position: relative;
  background: linear-gradient(135deg, #ff6b8a 0%, #ff8fa3 50%, #ff8fa3 100%);
  padding: 64rpx 40rpx 90rpx;
}
.header-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.avatar-wrap { flex-shrink: 0; }
.avatar, .avatar-placeholder {
  width: 112rpx; height: 112rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
}
.avatar-placeholder {
  background: rgba(255, 255, 255, 0.22);
  display: flex; align-items: center; justify-content: center;
}
.avatar-char { font-size: 48rpx; font-weight: 700; color: #fff; }

.user-info { flex: 1; min-width: 0; }
.name {
  display: block;
  font-size: 40rpx; font-weight: 700; color: #fff;
  text-shadow: 0 2rpx 6rpx rgba(112, 35, 71, 0.16);
}
.phone {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}
.edit-arrow {
  font-size: 44rpx;
  color: rgba(255, 255, 255, 0.7);
  flex-shrink: 0;
}

/* 接单状态切换 */
.status-bar {
  margin-top: 28rpx;
  padding: 20rpx 40rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.status-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}
.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.dot-on { background: #4ade80; box-shadow: 0 0 8rpx rgba(74, 222, 128, 0.9); }
.dot-off { background: rgba(255, 255, 255, 0.55); }
.status-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1;
}

.status-schedule-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.status-schedule-btn:active { background: rgba(255, 255, 255, 0.3); }
.status-schedule-icon { font-size: 28rpx; line-height: 1; }

/* 数据概览悬浮卡 */
.stats-card {
  position: absolute;
  left: 32rpx; right: 32rpx;
  bottom: -64rpx;
  background: #ffffff;
  border-radius: 18rpx;
  padding: 28rpx 40rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid rgba(255, 107, 138, 0.08);
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.05);
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.stat-item:active { opacity: 0.6; }
.stat-value { font-size: 40rpx; font-weight: 700; color: #1f2937; line-height: 1.1; }
.stat-label { font-size: 22rpx; color: #9ca3af; }
.stat-divider { width: 1rpx; height: 48rpx; background: #f0eaed; }

/* ===== 卡片 ===== */
.card {
  margin: 20rpx 40rpx 0;
  background: #ffffff;
  border-radius: 18rpx;
  padding: 28rpx;
  border: 2rpx solid rgba(255, 107, 138, 0.08);
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.05);
}
.card-gap { margin-top: 96rpx; }

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.card-head .card-title { margin-bottom: 0; }
.card-title {
  display: block;
  font-size: 30rpx; font-weight: 600; color: #1f2937;
  margin-bottom: 24rpx;
}
.card-more { font-size: 24rpx; color: #ff6b8a; font-weight: 500; }

/* ===== 我的预约 ===== */
.order-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 8rpx;
}
.order-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.order-cell:active { opacity: 0.7; }
.order-cell-badge {
  position: relative;
  width: 88rpx; height: 88rpx;
  border-radius: 18rpx;
  background: #FFF4F7;
  display: flex; align-items: center; justify-content: center;
}
.order-cell-badge.has-count { background: #FFE9F0; }
.order-cell-icon { font-size: 36rpx; }
.count-badge {
  position: absolute;
  top: -8rpx; right: -8rpx;
  min-width: 32rpx; height: 32rpx;
  padding: 0 8rpx;
  background: linear-gradient(135deg, #ff6b8a, #8b5cf6);
  border-radius: 999rpx;
  color: #fff; font-size: 18rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  border: 2rpx solid #fff;
}
.order-cell-label {
  font-size: 22rpx;
  color: #6b7280;
  text-align: center;
}

/* ===== 邀请码 ===== */
.invite-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.invite-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6b7280;
}
.invite-share-btn {
  margin: 0;
  padding: 0 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #ff6b8a, #8b5cf6);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  flex-shrink: 0;
}
.invite-share-btn::after { border: none; }

.invite-code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 40rpx;
  background: linear-gradient(180deg, #fff8fb 0%, #ffffff 34%, #f8f9fc 100%);
  border-radius: 14rpx;
  border: 1rpx dashed #f2cdd9;
}
.invite-code-block { display: flex; flex-direction: column; gap: 6rpx; }
.invite-code-cap { font-size: 20rpx; color: #9ca3af; }
.invite-code {
  font-size: 36rpx; font-weight: 700; color: #ff6b8a;
  letter-spacing: 3rpx;
}
.invite-copy {
  padding: 0 40rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 48rpx;
  background: #FFF1F6;
  color: #ff6b8a;
  font-size: 24rpx; font-weight: 600;
}

/* ===== 工具网格 ===== */
.tool-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx 8rpx;
}
.tool-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.tool-cell:active { opacity: 0.7; }
.tool-icon-bg {
  width: 88rpx; height: 88rpx;
  border-radius: 18rpx;
  background: #FFF4F7;
  display: flex; align-items: center; justify-content: center;
}
.tool-icon { font-size: 40rpx; }
.tool-label { font-size: 22rpx; color: #6b7280; text-align: center; }

/* ===== 设置菜单 ===== */
.menu-list { display: flex; flex-direction: column; }
.menu-item {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 107, 138, 0.08);
}
.menu-item:last-child { border-bottom: none; }
.menu-item:active { opacity: 0.6; }
.menu-icon { font-size: 36rpx; margin-right: 20rpx; }
.menu-label { flex: 1; font-size: 28rpx; color: #1f2937; }
.menu-arrow { font-size: 34rpx; color: #9ca3af; }

/* ===== 退出 ===== */
.logout-btn {
  margin: 32rpx 40rpx 0;
  height: 88rpx;
  border-radius: 48rpx;
  background: #ffffff;
  border: 2rpx solid rgba(255, 107, 138, 0.08);
  color: #dc2626;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.05);
}
.logout-btn:active { opacity: 0.8; }
.version {
  display: block;
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9ca3af;
}

/* ===== 工作时间设置弹窗 ===== */
.ws-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.4);
}

.ws-sheet {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  max-height: 80vh;
  background: #ffffff;
  border-radius: 48rpx 48rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.ws-header {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 40rpx;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.ws-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
}

.ws-close {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ws-close:active { background: #e5e7eb; }
.ws-close-icon { font-size: 28rpx; color: #6b7280; font-weight: 600; }

.ws-body {
  flex: 1;
  min-height: 0;
  padding: 24rpx 0;
  overflow: hidden;
}

/* 新增方案按钮 */
.ws-add-btn {
  height: 88rpx;
  border-radius: 16rpx;
  background: #f7f3f5;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 0 40rpx 24rpx;
}
.ws-add-btn:active { background: #ece8eb; }
.ws-add-icon { font-size: 32rpx; color: #6b7280; font-weight: 600; }
.ws-add-text { font-size: 28rpx; font-weight: 600; color: #6b7280; }

/* 方案列表 */
.ws-scheme-list {
  background: #ffffff;
  border-radius: 18rpx;
  border: 2rpx solid rgba(255, 107, 138, 0.08);
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.05);
  overflow: hidden;
  margin: 0 40rpx 24rpx;
}

.ws-scheme-card {
  padding: 28rpx;
}
.ws-scheme-card:active { background: #fefbfc; }
.ws-scheme-card + .ws-scheme-card {
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.ws-scheme-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ws-scheme-info {
  flex: 1;
  min-width: 0;
}

.ws-scheme-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ws-scheme-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.ws-active-badge {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #EEF9F1;
}
.ws-active-badge-text {
  font-size: 20rpx;
  font-weight: 600;
  color: #31B46C;
}

.ws-scheme-summary {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

/* 开关 */
.ws-switch {
  width: 96rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: #ddd8de;
  position: relative;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.ws-switch-on {
  background: #31B46C;
}

.ws-switch-knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(29, 35, 53, 0.18);
  transition: left 0.2s;
}

.ws-switch-on .ws-switch-knob {
  left: 44rpx;
}

/* 休息日设置 */
.ws-rest-section {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 28rpx;
  border: 2rpx solid rgba(255, 107, 138, 0.08);
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.05);
  margin: 0 40rpx 24rpx;
}

.ws-rest-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.ws-rest-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.ws-rest-link {
  font-size: 26rpx;
  font-weight: 500;
  color: #ff6b8a;
}
.ws-rest-link:active { opacity: 0.7; }

.ws-rest-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ws-rest-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f2f0f3;
}

.ws-rest-tag-text {
  font-size: 22rpx;
  font-weight: 500;
  color: #6b7280;
}

.ws-rest-tag-x {
  font-size: 28rpx;
  color: #9ca3af;
  line-height: 1;
  padding: 0 4rpx;
}
.ws-rest-tag-x:active { color: #6b7280; }

.ws-rest-empty {
  font-size: 26rpx;
  color: #9ca3af;
}

/* 保存按钮 */
.ws-footer {
  padding: 16rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
  background: #ffffff;
}

.ws-save-btn {
  height: 88rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #ff6b8a, #8b5cf6);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(255, 94, 147, 0.25);
}
.ws-save-btn:active { opacity: 0.85; }
.ws-save-disabled { opacity: 0.6; }
.ws-save-text { font-size: 30rpx; font-weight: 600; color: #ffffff; }

/* ===== 方案编辑器弹窗 ===== */
.se-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1100;
  background: rgba(0, 0, 0, 0.5);
}

.se-sheet {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  max-height: 80vh;
  background: #ffffff;
  border-radius: 48rpx 48rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.se-header {
  padding: 36rpx 40rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.se-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
}

.se-body {
  flex: 1;
  min-height: 0;
  padding: 32rpx 0;
  overflow: hidden;
}

.se-error {
  padding: 20rpx 24rpx;
  background: #fef2f2;
  border-radius: 14rpx;
  margin: 0 40rpx 24rpx;
}
.se-error-text { font-size: 26rpx; color: #dc2626; }

.se-section { margin: 0 40rpx 36rpx; }

.se-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #374151;
  margin-bottom: 16rpx;
}

/* 时间选择器 */
.se-time-row {
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
}

.se-time-col {
  flex: 1;
}

.se-time-sublabel {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 8rpx;
}

.se-time-picker {
  height: 88rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border: 2rpx solid #e5e7eb;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}
.se-time-picker:active { border-color: #ff6b8a; }

.se-time-value {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2937;
}

.se-time-arrow {
  font-size: 24rpx;
  color: #9ca3af;
}

.se-time-dash {
  font-size: 28rpx;
  color: #9ca3af;
  padding-bottom: 20rpx;
}

/* 星期选择 */
.se-day-grid {
  display: flex;
  gap: 12rpx;
}

.se-day-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 14rpx;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
}
.se-day-btn:active { background: #e5e7eb; }

.se-day-active {
  background: linear-gradient(135deg, #ff6b8a, #8b5cf6);
}
.se-day-active:active { opacity: 0.85; }

.se-day-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #374151;
}
.se-day-active .se-day-text { color: #ffffff; font-weight: 600; }

/* 标签输入 */
.se-label-input {
  height: 88rpx;
  padding: 0 24rpx;
  background: #f9fafb;
  border: 2rpx solid transparent;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #1f2937;
  box-sizing: border-box;
}
.se-label-input:focus {
  background: #ffffff;
  border-color: #ff6b8a;
}

/* 编辑器 Footer */
.se-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.se-delete-btn {
  height: 80rpx;
  padding: 0 32rpx;
  border-radius: 14rpx;
  background: #ffe5e6;
  display: flex;
  align-items: center;
  justify-content: center;
}
.se-delete-btn:active { background: #fecdd3; }
.se-delete-text { font-size: 26rpx; font-weight: 500; color: #dc2626; }

.se-footer-right {
  display: flex;
  gap: 16rpx;
}

.se-cancel-btn {
  height: 80rpx;
  padding: 0 40rpx;
  border-radius: 14rpx;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
}
.se-cancel-btn:active { background: #e5e7eb; }
.se-cancel-text { font-size: 26rpx; font-weight: 500; color: #374151; }

.se-save-btn {
  height: 80rpx;
  padding: 0 40rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #ff6b8a, #8b5cf6);
  display: flex;
  align-items: center;
  justify-content: center;
}
.se-save-btn:active { opacity: 0.85; }
.se-save-text { font-size: 26rpx; font-weight: 600; color: #ffffff; }
