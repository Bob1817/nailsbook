page { background: var(--bg-gradient-entry); }

.page {
  min-height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ===== Header ===== */
.header {
  position: relative;
  margin: 24rpx 32rpx;
  background: var(--nb-surface);
  border-radius: var(--radius-lg);
  padding: 24rpx 32rpx;
}
.header-row {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 20rpx;
}
.avatar-wrap { flex-shrink: 0; }
.avatar, .avatar-placeholder {
  width: 112rpx; height: 112rpx;
  border-radius: 50%;
  border: 0;
}
.avatar-placeholder {
  background: var(--nb-surface);
  display: flex; align-items: center; justify-content: center;
}
.avatar-char { font-size: var(--font-2xl); font-weight: var(--weight-bold); color: var(--nb-ink); }

.user-info { flex: 1; min-width: 0; }
.name-row { display:flex; align-items:center; gap:12rpx; min-width:0; }
.name {
  display: block; min-width:0;
  font-size: var(--font-xl); font-weight: var(--weight-bold); color: var(--nb-ink);
}
.role-tag {
  flex-shrink:0; padding:4rpx 12rpx; border-radius:var(--radius-xs);
  background:var(--nb-page); color:var(--nb-secondary);
  font-size:var(--font-xs); font-weight:var(--weight-medium); line-height:1.4;
}
.phone {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: var(--nb-muted);
}
.header-row .profile-share-btn { width:auto; box-sizing:border-box; min-width:44px; min-height:44px; margin:0; padding:0 20rpx; justify-self:end; display:flex; align-items:center; justify-content:center; gap:8rpx; border:0; border-radius:22rpx; background:var(--nb-page); color:var(--nb-secondary); box-shadow:none; font-size:var(--font-sm); font-weight:var(--weight-medium); line-height:1.4; white-space:nowrap; }
.profile-share-btn::after { border:none; }
.header-row .profile-share-btn:active, .header-row .profile-share-pressed { background:var(--nb-pressed); }
.profile-share-btn:focus { outline:2px solid var(--nb-text-link); outline-offset:2px; }
.profile-share-icon { width:30rpx; height:30rpx; flex-shrink:0; display:block; }

.status-label {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--nb-ink);
  line-height: 1;
}


.stats-row {
  display: flex;
  align-items: stretch;
  padding: 24rpx 20rpx;
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
  min-height: 44px;
  padding: 8rpx 0;
}
.stat-item:active { opacity: 0.6; }
.stat-value { font-size: var(--font-lg); font-weight: var(--weight-bold); color: var(--text-primary); line-height: 1.35; overflow-wrap: anywhere; text-align: center; }
.stat-value-alert { color: var(--brand-primary); }
.stat-label { font-size: var(--font-xs); color: var(--text-muted); text-align: center; line-height: 1.35; }
.business-row { min-height: 92rpx; }
.business-value { font-size: var(--font-lg); }

/* ===== 卡片 ===== */
.card {
  margin: 24rpx 32rpx 0;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx 32rpx;
  border: 0;
  box-shadow: none;
}
.card-gap { margin-top: 24rpx; }

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-md);
}
.card-head .card-title { margin-bottom: 0; }
.card-title {
  display: block;
  font-size: var(--font-md); font-weight: var(--weight-semibold); color: var(--text-primary);
  margin-bottom: var(--space-md);
}
.card-more {
  min-height: 88rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  font-size: var(--font-sm);
  color: var(--nb-text-link);
  font-weight: var(--weight-medium);
}

/* ===== 我的预约 ===== */
.order-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
}
.order-cell {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.order-cell:active { opacity: 0.7; }
.order-cell-badge {
  position: relative;
  width: 40rpx; height: 40rpx;
  border-radius: var(--card-radius);
  display: flex; align-items: center; justify-content: center;
}
.order-cell-badge.has-count { box-shadow: none; }

.count-badge {
  position: absolute;
  top: 8rpx; right: 8rpx;
  min-width: 36rpx; height: 36rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
  background: var(--nb-danger);
  border-radius: 999rpx;
  color: var(--text-inverse); font-size: var(--font-xs); font-weight: var(--weight-bold);
  display: flex; align-items: center; justify-content: center;
  border: 0;
}
.order-cell-label { text-align: center; }

/* ===== 邀请码 ===== */
.invite-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.invite-sub {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-xs);
  color: var(--text-muted);
}
.invite-code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 40rpx;
  background: var(--bg-gradient-entry);
  border-radius: var(--radius-sm);
  border: 0;
}
.invite-code-block { display: flex; flex-direction: column; gap: 6rpx; }
.invite-code-cap { font-size: var(--font-xs); color: var(--text-muted); }
.invite-code {
  font-size: var(--font-lg); font-weight: var(--weight-bold); color: var(--brand-primary);
  letter-spacing: 3rpx;
}
.invite-copy {
  padding: 0 40rpx;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--btn-radius);
  background: var(--nb-page);
  color: var(--brand-primary);
  font-size: var(--font-sm); font-weight: var(--weight-semibold);
}

/* ===== 工具网格 ===== */
.tool-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx 8rpx;
}
.tool-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.tool-cell:active { opacity: 0.7; }
.tool-icon-bg {
  position: relative;
  width: 40rpx; height: 40rpx;
  border-radius: var(--card-radius);
  display: flex; align-items: center; justify-content: center;
}

.tool-label { text-align: center; }

/* 服务开启状态点 */
.tool-status-dot {
  position: absolute;
  top: 6rpx; right: 6rpx;
  width: 8rpx; height: 8rpx;
  border-radius: 50%;
  border: 0;
}
.dot-on { background: var(--nb-success); }
.dot-off { background: var(--nb-muted); }

/* ===== 新手引导卡 ===== */
.setup-guide-card {
  margin: 24rpx 32rpx 0;
  background: var(--nb-page);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: none;
  border: 0;
}
.setup-guide-head { margin-bottom: 28rpx; }
.setup-guide-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.setup-guide-title {
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
}
.setup-guide-badge {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--nb-action);
  color: var(--text-inverse);
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
}
.setup-guide-desc {
  font-size: var(--font-sm);
  color: var(--text-muted);
  line-height: var(--leading-normal);
}

.setup-steps {
  background: rgba(255, 255, 255, 0.7);
  border-radius: var(--radius-md);
  overflow: hidden;
}
.setup-step {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md) 28rpx;
}
.setup-step:active { background: rgba(0, 0, 0, 0.05) /* brand-primary-alpha */; }
.setup-step-divider {
  height: 1rpx;
  margin: 0 28rpx;
  background: rgba(0, 0, 0, 0.05);
}
.setup-step-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}
.setup-step-icon-wrap {
  width: 72rpx; height: 72rpx;
  border-radius: var(--radius-sm);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  background: var(--nb-page);
  color: var(--brand-primary);
  font-size: 26rpx;
  font-weight: var(--weight-semibold);
}
.setup-step-done { background:var(--nb-page); color:var(--nb-ink); }
.setup-step-icon-home { background: var(--nb-page); }
.setup-step-icon-shop { background: var(--nb-page); }
.setup-step-icon-svg {
  width: 40rpx; height: 40rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}
.setup-step-text { flex: 1; min-width: 0; }
.setup-step-label {
  display: block;
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin-bottom: 4rpx;
}
.setup-step-hint {
  display: block;
  font-size: var(--font-xs);
  color: var(--text-muted);
}
.setup-step-action {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}
.setup-step-btn {
  font-size: var(--font-sm);
  font-weight: var(--weight-semibold);
  color: var(--brand-primary);
}
.setup-step-arrow {
  font-size: var(--font-lg);
  color: var(--brand-primary);
  line-height: 1;
}

/* ===== 设置菜单 ===== */
.menu-list { display: flex; flex-direction: column; }
.menu-item {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 44px;
  padding: 8rpx 0;
  border-bottom: 0;
}
.menu-item:last-child { border-bottom: none; }
.menu-item:active { opacity: 0.6; }
.menu-icon { margin-right:16rpx; }
.menu-label { flex: 1; }
.menu-arrow { font-size: var(--font-lg); color: var(--text-muted); }

/* ===== 退出 ===== */
.logout-btn {
  margin: 32rpx 32rpx 0;
  height: 88rpx;
  border-radius: var(--btn-radius);
  background: transparent;
  border: 0;
  color: var(--nb-danger);
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
}
.logout-btn:active { opacity: 0.8; }
.version {
  display: block;
  margin-top: var(--space-md);
  text-align: center;
  font-size: var(--font-xs);
  color: var(--text-muted);
}

/* ===== 工作时间设置弹窗 ===== */
.ws-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.4);
}

.ws-sheet {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  max-height: 80vh;
  background: var(--bg-card);
  border-radius: var(--btn-radius) 48rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.ws-header {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 40rpx;
  background: var(--bg-card);
  border-bottom: 0;
}

.ws-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
}

.ws-close {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-input);
  display: flex;
  align-items: center;
  justify-content: center;
}
.ws-close:active { background: var(--nb-page); }
.ws-close-icon { font-size: var(--font-md); color: var(--text-muted); font-weight: var(--weight-semibold); }

.ws-body {
  flex: 1;
  min-height: 0;
  padding: var(--space-md) 0;
  overflow: hidden;
}

/* 新增方案按钮 */
.ws-add-btn {
  height: 88rpx;
  border-radius: var(--radius-sm);
  background: var(--nb-page);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 0 40rpx 24rpx;
}
.ws-add-btn:active { background: var(--nb-page); }
.ws-add-icon { font-size: var(--font-lg); color: var(--text-muted); font-weight: var(--weight-semibold); }
.ws-add-text { font-size: var(--font-md); font-weight: var(--weight-semibold); color: var(--text-muted); }

/* 方案列表 */
.ws-scheme-list {
  background: var(--bg-card);
  border-radius: var(--card-radius);
  border: 0;
  box-shadow: var(--shadow-lg);
  overflow: hidden;
  margin: 0 40rpx 24rpx;
}

.ws-scheme-card {
  padding: 28rpx;
}
.ws-scheme-card:active { background: var(--nb-surface); }
.ws-scheme-card + .ws-scheme-card {
  border-top: 0;
}

.ws-scheme-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ws-scheme-info {
  flex: 1;
  min-width: 0;
}

.ws-scheme-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ws-scheme-name {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.ws-active-badge {
  padding: 4rpx 16rpx;
  border-radius: var(--radius-md);
  background: var(--nb-page);
}
.ws-active-badge-text {
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
  color: var(--nb-ink);
}

.ws-scheme-summary {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--text-muted);
}


/* 休息日设置 */
.ws-rest-section {
  background: var(--bg-card);
  border-radius: var(--card-radius);
  padding: 24rpx 32rpx;
  border: 0;
  box-shadow: none;
  margin: 0 40rpx 24rpx;
}

.ws-rest-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.ws-rest-title {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.ws-rest-link {
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  color: var(--nb-text-link);
}
.ws-rest-link:active { opacity: 0.7; }

.ws-rest-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ws-rest-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--nb-page);
}

.ws-rest-tag-text {
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
  color: var(--text-muted);
}

.ws-rest-tag-x {
  font-size: var(--font-md);
  color: var(--text-muted);
  line-height: 1;
  padding: 0 4rpx;
}
.ws-rest-tag-x:active { color: var(--text-muted); }

.ws-rest-empty {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

/* 保存按钮 */
.ws-footer {
  padding: 16rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 0;
  background: var(--bg-card);
}

.ws-save-btn {
  height: 88rpx;
  border-radius: var(--btn-radius);
  background: var(--nb-text-link);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.25);
}
.ws-save-btn:active { opacity: 0.85; }
.ws-save-disabled { opacity: 0.6; }
.ws-save-text { font-size: var(--font-md); font-weight: var(--weight-semibold); color: var(--text-inverse); }

/* ===== 方案编辑器弹窗 ===== */
.se-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1100;
  background: var(--bg-overlay);
}

.se-sheet {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  max-height: 80vh;
  background: var(--bg-card);
  border-radius: var(--btn-radius) 48rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.se-header {
  padding: 36rpx 40rpx;
  border-bottom: 0;
}

.se-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
}

.se-body {
  flex: 1;
  min-height: 0;
  padding: 32rpx 0;
  overflow: hidden;
}

.se-error {
  padding: 20rpx 24rpx;
  background: var(--nb-page);
  border-radius: var(--radius-sm);
  margin: 0 40rpx 24rpx;
}
.se-error-text { font-size: var(--font-sm); color: var(--text-error); }

.se-section { margin: 0 40rpx 36rpx; }

.se-label {
  display: block;
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  color: var(--text-body);
  margin-bottom: var(--space-sm);
}

/* 时间选择器 */
.se-time-row {
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
}

.se-time-col {
  flex: 1;
}

.se-time-sublabel {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.se-time-picker {
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--bg-card);
  border: 0;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}
.se-time-picker:active { border-color: var(--brand-primary); }

.se-time-value {
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  color: var(--text-primary);
}

.se-time-arrow {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

.se-time-dash {
  font-size: var(--font-md);
  color: var(--text-muted);
  padding-bottom: 20rpx;
}

/* 星期选择 */
.se-day-grid {
  display: flex;
  gap: 12rpx;
}

.se-day-btn {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-input);
  display: flex;
  align-items: center;
  justify-content: center;
}
.se-day-btn:active { background: var(--nb-page); }

.se-day-active {
  background: var(--nb-text-link);
}
.se-day-active:active { opacity: 0.85; }

.se-day-text {
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  color: var(--text-body);
}
.se-day-active .se-day-text { color: var(--text-inverse); font-weight: var(--weight-semibold); }

/* 标签输入 */
.se-label-input {
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--nb-soft-surface);
  border: 0;
  border-radius: var(--radius-sm);
  font-size: var(--font-md);
  color: var(--text-primary);
  box-sizing: border-box;
}
.se-label-input:focus {
  background: var(--bg-card);
  border-color: var(--brand-primary);
}

/* 编辑器 Footer */
.se-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md) 40rpx calc(32rpx + env(safe-area-inset-bottom));
  border-top: 0;
}

.se-delete-btn {
  height: 88rpx;
  padding: 0 32rpx;
  border-radius: var(--radius-sm);
  background: var(--nb-page);
  display: flex;
  align-items: center;
  justify-content: center;
}
.se-delete-btn:active { background: var(--nb-page); }
.se-delete-text { font-size: var(--font-sm); font-weight: var(--weight-medium); color: var(--text-error); }

.se-footer-right {
  display: flex;
  gap: 16rpx;
}

.se-cancel-btn {
  height: 88rpx;
  padding: 0 40rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-input);
  display: flex;
  align-items: center;
  justify-content: center;
}
.se-cancel-btn:active { background: var(--nb-page); }
.se-cancel-text { font-size: var(--font-sm); font-weight: var(--weight-medium); color: var(--text-body); }

.se-save-btn {
  height: 88rpx;
  padding: 0 40rpx;
  border-radius: var(--radius-sm);
  background: var(--nb-text-link);
  display: flex;
  align-items: center;
  justify-content: center;
}
.se-save-btn:active { opacity: 0.85; }
.se-save-text { font-size: var(--font-sm); font-weight: var(--weight-semibold); color: var(--text-inverse); }

/* ===== 服务类型配置弹窗 ===== */
.st-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.4);
}

.st-sheet {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  max-height: 85vh;
  background: var(--bg-card);
  border-radius: var(--btn-radius) 48rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.st-header {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 36rpx 40rpx;
  background: var(--bg-card);
  border-bottom: 0;
}

.st-header-info {
  flex: 1;
  min-width: 0;
}

.st-title {
  display: block;
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.st-subtitle {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
  line-height: var(--leading-normal);
}

.st-close {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-input);
  display: flex;
  align-items: center;
  justify-content: center;
}
.st-close:active { background: var(--nb-page); }
.st-close-icon { font-size: var(--font-md); color: var(--text-muted); font-weight: var(--weight-semibold); }

/* Tab 切换 */
.st-tabs {
  display: flex;
  padding: var(--space-md) 40rpx;
  gap: 16rpx;
  background: var(--bg-card);
}

.st-tab {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-input);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  position: relative;
}
.st-tab:active { background: var(--nb-page); }

.st-tab-active {
  background: var(--nb-page);
  border: 0;
}

.st-tab-icon {
  color: var(--text-muted);
  flex-shrink: 0;
}
.st-tab-active .st-tab-icon {
  color: var(--brand-primary);
}
.st-tab-icon-home {
  position: relative;
  width: 34rpx;
  height: 28rpx;
  margin-top: 6rpx;
  border: 3rpx solid currentColor;
  border-radius: 5rpx;
  box-sizing: border-box;
}
.st-tab-icon-home::before {
  content: '';
  position: absolute;
  left: 5rpx;
  top: -11rpx;
  width: 18rpx;
  height: 18rpx;
  border-left: 3rpx solid currentColor;
  border-top: 3rpx solid currentColor;
  background: inherit;
  transform: rotate(45deg);
}
.st-tab-icon-shop {
  position: relative;
  width: 36rpx;
  height: 30rpx;
  margin-top: 4rpx;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
  box-sizing: border-box;
}
.st-tab-icon-shop::before {
  content: '';
  position: absolute;
  left: -3rpx;
  top: -8rpx;
  width: 36rpx;
  height: 8rpx;
  border: 3rpx solid currentColor;
  border-radius: 5rpx 5rpx 2rpx 2rpx;
  box-sizing: border-box;
}

.st-tab-text {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-body);
}
.st-tab-active .st-tab-text {
  color: var(--brand-primary);
}

.st-tab-dot {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--nb-action);
  border: 0;
}

/* 内容区 */
.st-body {
  flex: 1;
  min-height: 0;
  padding: var(--space-md) 0;
  overflow: hidden;
}

.st-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

/* 开关行 */
.st-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 40rpx;
  margin: 0 40rpx 24rpx;
  background: var(--bg-card);
  border-radius: var(--card-radius);
  border: 0;
  box-shadow: var(--shadow-lg);
}

.st-switch-info {
  flex: 1;
}

.st-switch-label {
  display: block;
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.st-switch-desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
}

/* 表单 */
.st-form {
  margin: 0 40rpx 24rpx;
  padding: 28rpx;
  background: var(--bg-card);
  border-radius: var(--card-radius);
  border: 0;
  box-shadow: var(--shadow-lg);
}

.st-field {
  margin-bottom: var(--space-md);
}
.st-field:last-child {
  margin-bottom: 0;
}

.st-field-label {
  display: block;
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  color: var(--text-body);
  margin-bottom: 12rpx;
}

.st-field-input-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.st-field-input {
  flex: 1;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--nb-soft-surface);
  border: 0;
  border-radius: var(--radius-sm);
  font-size: var(--font-md);
  color: var(--text-primary);
  box-sizing: border-box;
}
.st-field-input:focus {
  background: var(--bg-card);
  border-color: var(--brand-primary);
}

.st-field-unit {
  font-size: var(--font-sm);
  color: var(--text-muted);
  flex-shrink: 0;
}

.st-field-textarea {
  margin-bottom: 0;
}

.st-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx 24rpx;
  background: var(--nb-soft-surface);
  border: 0;
  border-radius: var(--radius-sm);
  font-size: var(--font-md);
  color: var(--text-primary);
  box-sizing: border-box;
}
.st-textarea:focus {
  background: var(--bg-card);
  border-color: var(--brand-primary);
}

/* 保存按钮 */
.st-save-btn {
  height: 88rpx;
  border-radius: var(--btn-radius);
  background: var(--nb-text-link);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 40rpx 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.25);
}
.st-save-btn:active { opacity: 0.85; }
.st-save-disabled { opacity: 0.6; }
.st-save-btn text {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-inverse);
}

/* 店铺列表 */
.st-shop-list {
  margin: 0 40rpx 24rpx;
}

.st-shop-card {
  padding: var(--space-md);
  background: var(--bg-card);
  border-radius: var(--card-radius);
  border: 0;
  box-shadow: var(--shadow-lg);
  margin-bottom: var(--space-sm);
}
.st-shop-card:last-child {
  margin-bottom: 0;
}

.st-shop-info {
  margin-bottom: var(--space-sm);
}

.st-shop-name {
  display: block;
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.st-shop-address {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
  margin-bottom: 4rpx;
}

.st-shop-phone {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
}

.st-shop-actions {
  display: flex;
  gap: 16rpx;
}

.st-shop-edit,
.st-shop-delete {
  flex: 1;
  height: 72rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
}

.st-shop-edit {
  background: var(--bg-input);
  color: var(--text-body);
}
.st-shop-edit:active { background: var(--nb-page); }

.st-shop-delete {
  background: var(--nb-page);
  color: var(--text-error);
}
.st-shop-delete:active { background: var(--nb-page); }

/* 空状态 */
.st-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.st-empty-icon {
  margin-bottom: var(--space-sm);
}
.st-empty-shop-icon {
  position: relative;
  width: 88rpx;
  height: 70rpx;
  border: 4rpx solid var(--nb-control);
  border-radius: var(--radius-xs);
  box-sizing: border-box;
}
.st-empty-shop-icon::before {
  content: '';
  position: absolute;
  left: -4rpx;
  top: -18rpx;
  width: 88rpx;
  height: 20rpx;
  border: 4rpx solid var(--nb-control);
  border-radius: 10rpx 10rpx 4rpx 4rpx;
  box-sizing: border-box;
}

.st-empty-text {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.st-empty-sub {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

/* 添加店铺按钮 */
.st-add-shop-btn {
  height: 88rpx;
  border-radius: var(--radius-sm);
  background: var(--nb-page);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 0 40rpx 24rpx;
}
.st-add-shop-btn:active { background: var(--nb-page); }
.st-add-icon {
  font-size: var(--font-lg);
  color: var(--text-muted);
  font-weight: var(--weight-semibold);
}
.st-add-shop-btn text {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-muted);
}

/* 店铺表单 */
.st-shop-form {
  margin: 0 40rpx 24rpx;
  padding: 28rpx;
  background: var(--bg-card);
  border-radius: var(--card-radius);
  border: 0;
  box-shadow: var(--shadow-lg);
}

.st-form-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-md);
}

.st-form-title {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.st-form-close {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-input);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm);
  color: var(--text-muted);
}
.st-form-close:active { background: var(--nb-page); }

.status-copy { display:flex; flex-direction:column; gap:8rpx; }

/* 我的页：复用语义色，以留白区分内容与操作。 */
.name { overflow-wrap:anywhere; }
.availability-card { margin-top:0; }
.availability-title {
  margin-bottom: 16rpx;
}
.availability-card .status-label {
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
}
.availability-card .profile-helper {
  margin-top: 0;
  font-size: var(--font-xs);
  line-height: 1.35;
}
.availability-card .accepting-helper { white-space:nowrap; }
.availability-row, .profile-schedule-row, .profile-invite-entry {
  display:flex; align-items:center; justify-content:space-between; gap:24rpx;
}
.availability-row, .profile-schedule-row { min-height:112rpx; padding:20rpx 22rpx; border-radius:16rpx; background:var(--nb-soft-surface); box-sizing:border-box; }
.profile-schedule-row { margin-top:12rpx; align-items:center; }
.status-copy { flex:1; min-width:0; }
.status-label { line-height:1.5; }
.profile-helper { display:block; font-size:var(--font-sm); color:var(--nb-muted); line-height:1.5; margin-top:6rpx; }
.profile-link { min-height:88rpx; padding-left:20rpx; display:flex; align-items:center; font-size:var(--font-sm); flex-shrink:0; }
.profile-pressed { opacity:.65; }
.profile-summary { display:grid; grid-template-columns:minmax(0, 1.4fr) repeat(2, minmax(0, 1fr)); gap:16rpx; }
.profile-summary .stat-value { font-size:var(--font-lg); }
.profile-summary .stat-item { justify-content:flex-start; }
.profile-detail-stats .stats-row { gap:16rpx; padding:24rpx 0; }
.profile-detail-stats .stat-item { overflow-wrap:anywhere; }
.profile-muted { color:var(--nb-muted); }
.profile-detail-sheet { max-height:75vh; padding-bottom:env(safe-area-inset-bottom); }
.profile-detail-body { height:55vh; box-sizing:border-box; padding:0 32rpx 32rpx; }
.profile-invite-content { padding:16rpx 0; }
.profile-invite-content .invite-code-row { padding:24rpx; }
.profile-invite-content .invite-copy { background:transparent; padding:0 16rpx; }
.profile-invite-content .invite-code { overflow-wrap:anywhere; }
.profile-invite-content .invite-code-block { min-width:0; }
.order-cell, .tool-cell {
  min-height:44px; min-width:44px; box-sizing:border-box;
  padding:20rpx 4rpx; justify-content:center;
  background:var(--nb-page); border-radius:var(--radius-sm);
}
.profile-tile-pressed { background:var(--nb-soft-surface); opacity:.7; }
.order-cell-badge, .tool-icon-bg { background:transparent; }
/* 同级功能入口共享尺寸与文字层级，网格和列表只保留布局差异。 */
.order-cell-icon, .tool-icon, .menu-icon {
  width:40rpx; height:40rpx; flex-shrink:0; display:block;
}
.order-cell-label, .tool-label {
  font-size:var(--font-sm); font-weight:var(--weight-normal);
  line-height:1.5; color:var(--nb-secondary);
}
.menu-label {
  flex:1;
  font-size:var(--font-sm);
  font-weight:var(--weight-normal);
  line-height:1.5;
  color:var(--nb-secondary);
}
.menu-value { flex-shrink:0; color:var(--nb-muted); font-size:var(--font-xs); }
.account-logout .menu-label { color:var(--nb-danger); }
.card-more { min-height:44px; }
.setup-step-arrow { color:var(--nb-muted); }
.menu-item, .logout-btn { min-height:44px; }
.setup-guide-card { background:var(--nb-surface); }
.setup-guide-badge { background:var(--nb-soft-surface); color:var(--nb-text-link); }

.profile-detail-sheet .ws-close { min-width:44px; min-height:44px; font-size:var(--font-sm); }

/* 说明独占整行，不再被开关挤窄；工作时间摘要仍可正常换行。 */
.availability-row { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.accepting-helper { white-space:normal; }

.invite-actions { display: flex; flex-direction: column; gap: 16rpx; margin: 24rpx 0; }
.profile-invite-content .invite-action { width: 100%; margin: 0; padding: 0 16px; min-height: 44px; height: 44px; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border-radius: 8px; font-size: 14px; line-height: 1.4; }
.invite-action::after { border: 0; }
.profile-invite-content .invite-primary { background: var(--nb-action); color: var(--nb-inverse); }
.profile-invite-content .invite-secondary { background: var(--nb-soft-surface); color: var(--nb-secondary); }
@import '../../../styles/booking-actions.wxss';
.profile-share-btn.booking-action,
.profile-invite-content .invite-action.booking-action { min-height:44px; height:44px; border-radius:8px; font-size:var(--font-sm); line-height:1.4; box-shadow:none; }
