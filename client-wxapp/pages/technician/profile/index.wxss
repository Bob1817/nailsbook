page { background: linear-gradient(180deg, #fff8fb 0%, #ffffff 34%, #f8f9fc 100%); }

.page {
  min-height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ===== Header ===== */
.header {
  position: relative;
  background: linear-gradient(135deg, #ff6b8a 0%, #ff8fa3 50%, #ff8fa3 100%);
  padding: 64rpx 40rpx 164rpx;
}
.header-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.avatar-wrap { flex-shrink: 0; }
.avatar, .avatar-placeholder {
  width: 112rpx; height: 112rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
}
.avatar-placeholder {
  background: rgba(255, 255, 255, 0.22);
  display: flex; align-items: center; justify-content: center;
}
.avatar-char { font-size: 48rpx; font-weight: 700; color: #fff; }

.user-info { flex: 1; min-width: 0; }
.name {
  display: block;
  font-size: 40rpx; font-weight: 700; color: #fff;
  text-shadow: 0 2rpx 6rpx rgba(112, 35, 71, 0.16);
}
.phone {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}
.edit-arrow {
  font-size: 44rpx;
  color: rgba(255, 255, 255, 0.7);
  flex-shrink: 0;
}

/* 接单状态切换 */
.status-bar {
  margin-top: 28rpx;
  padding: 20rpx 40rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.status-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}
.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.dot-on { background: #4ade80; box-shadow: 0 0 8rpx rgba(74, 222, 128, 0.9); }
.dot-off { background: rgba(255, 255, 255, 0.55); }
.status-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1;
}

.status-schedule-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.status-schedule-btn:active { background: rgba(255, 255, 255, 0.3); }
.status-schedule-icon-svg {
  width: 28rpx; height: 28rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23ffffff' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'/><polyline points='12 6 12 12 16 14'/></svg>");
}

/* 数据概览悬浮卡（双行） */
.stats-card {
  position: absolute;
  left: 32rpx; right: 32rpx;
  bottom: -88rpx;
  background: #ffffff;
  border-radius: 18rpx;
  border: 2rpx solid rgba(255, 107, 138, 0.08);
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.05);
  overflow: hidden;
}
.stats-row {
  display: flex;
  align-items: center;
  padding: 22rpx 32rpx;
}
.stats-h-divider {
  height: 1rpx;
  background: #f5f0f3;
  margin: 0 32rpx;
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.stat-item:active { opacity: 0.6; }
.stat-value { font-size: 36rpx; font-weight: 700; color: #1f2937; line-height: 1.1; }
.stat-value-alert { color: #ff6b8a; }
.stat-label { font-size: 20rpx; color: #6b7280; }
.stat-divider { width: 1rpx; height: 44rpx; background: #f0eaed; flex-shrink: 0; }
.business-row { min-height:88rpx; }.business-value { font-size:30rpx; }

/* ===== 卡片 ===== */
.card {
  margin: 20rpx 40rpx 0;
  background: #ffffff;
  border-radius: 18rpx;
  padding: 28rpx;
  border: 2rpx solid rgba(255, 107, 138, 0.08);
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.05);
}
.card-gap { margin-top: 116rpx; }

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.card-head .card-title { margin-bottom: 0; }
.card-title {
  display: block;
  font-size: 30rpx; font-weight: 600; color: #1f2937;
  margin-bottom: 24rpx;
}
.card-more {
  min-height: 88rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #ff6b8a;
  font-weight: 500;
}

/* ===== 我的预约 ===== */
.order-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 8rpx;
}
.order-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.order-cell:active { opacity: 0.7; }
.order-cell-badge {
  position: relative;
  width: 88rpx; height: 88rpx;
  border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
}
.order-cell-badge.has-count { box-shadow: 0 0 0 2rpx rgba(255, 107, 138, 0.18); }
.order-cell-icon {
  width: 44rpx; height: 44rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}
.count-badge {
  position: absolute;
  top: -8rpx; right: -8rpx;
  min-width: 32rpx; height: 32rpx;
  padding: 0 8rpx;
  background: linear-gradient(135deg, #ff6b8a, #8b5cf6);
  border-radius: 999rpx;
  color: #fff; font-size: 18rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  border: 2rpx solid #fff;
}
.order-cell-label {
  font-size: 22rpx;
  color: #6b7280;
  text-align: center;
}

/* ===== 邀请码 ===== */
.invite-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.invite-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6b7280;
}
.invite-share-btn {
  margin: 0;
  padding: 0 28rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff6b8a, #8b5cf6);
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
  flex-shrink: 0;
}
.invite-share-btn::after { border: none; }

.invite-code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 40rpx;
  background: linear-gradient(180deg, #fff8fb 0%, #ffffff 34%, #f8f9fc 100%);
  border-radius: 14rpx;
  border: 1rpx dashed #f2cdd9;
}
.invite-code-block { display: flex; flex-direction: column; gap: 6rpx; }
.invite-code-cap { font-size: 20rpx; color: #6b7280; }
.invite-code {
  font-size: 36rpx; font-weight: 700; color: #ff6b8a;
  letter-spacing: 3rpx;
}
.invite-copy {
  padding: 0 40rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 48rpx;
  background: #FFF1F6;
  color: #ff6b8a;
  font-size: 24rpx; font-weight: 600;
}

/* ===== 工具网格 ===== */
.tool-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx 8rpx;
}
.tool-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.tool-cell:active { opacity: 0.7; }
.tool-icon-bg {
  position: relative;
  width: 88rpx; height: 88rpx;
  border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
}
.tool-icon {
  width: 44rpx; height: 44rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}
.tool-label { font-size: 22rpx; color: #6b7280; text-align: center; }

/* 服务开启状态点 */
.tool-status-dot {
  position: absolute;
  top: 6rpx; right: 6rpx;
  width: 16rpx; height: 16rpx;
  border-radius: 50%;
  border: 3rpx solid #fff;
}
.dot-on  { background: #22c55e; }
.dot-off { background: #d1d5db; }

/* ===== 新手引导卡 ===== */
.setup-guide-card {
  margin: 20rpx 40rpx 0;
  background: linear-gradient(135deg, #fff8fb 0%, #fdf4ff 100%);
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 138, 0.12);
  border: 1rpx solid #fde4ec;
}
.setup-guide-head { margin-bottom: 28rpx; }
.setup-guide-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.setup-guide-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}
.setup-guide-badge {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff6b8a, #a855f7);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
}
.setup-guide-desc {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
}

.setup-steps {
  background: rgba(255, 255, 255, 0.7);
  border-radius: 20rpx;
  overflow: hidden;
}
.setup-step {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}
.setup-step:active { background: rgba(255, 107, 138, 0.05); }
.setup-step-divider {
  height: 1rpx;
  margin: 0 28rpx;
  background: rgba(0, 0, 0, 0.05);
}
.setup-step-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}
.setup-step-icon-wrap {
  width: 72rpx; height: 72rpx;
  border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.setup-step-icon-home { background: #fde8f0; }
.setup-step-icon-shop { background: #dbeafe; }
.setup-step-icon-svg {
  width: 40rpx; height: 40rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}
.setup-step-home-svg {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23f43f5e' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'/><polyline points='9 22 9 12 15 12 15 22'/></svg>");
}
.setup-step-shop-svg {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%233b82f6' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z'/><line x1='3' y1='6' x2='21' y2='6'/><path d='M16 10a4 4 0 0 1-8 0'/></svg>");
}
.setup-step-text { flex: 1; min-width: 0; }
.setup-step-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 4rpx;
}
.setup-step-hint {
  display: block;
  font-size: 22rpx;
  color: #6b7280;
}
.setup-step-action {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}
.setup-step-btn {
  font-size: 24rpx;
  font-weight: 600;
  color: #ff6b8a;
}
.setup-step-arrow {
  font-size: 32rpx;
  color: #ff6b8a;
  line-height: 1;
}

/* ===== 设置菜单 ===== */
.menu-list { display: flex; flex-direction: column; }
.menu-item {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 107, 138, 0.08);
}
.menu-item:last-child { border-bottom: none; }
.menu-item:active { opacity: 0.6; }
.menu-icon { position:relative; width:40rpx; height:40rpx; margin-right:20rpx; flex-shrink:0; color:#9d5274; box-sizing:border-box; }
.icon-settings { border:4rpx solid currentColor; border-radius:50%; box-shadow:inset 0 0 0 7rpx #fff; background:currentColor; }
.icon-settings::before,.icon-settings::after { content:''; position:absolute; left:14rpx; top:-7rpx; width:4rpx; height:46rpx; border-radius:3rpx; background:currentColor; transform-origin:center; }
.icon-settings::after { transform:rotate(90deg); }
.icon-lock { top:10rpx; height:28rpx; border:4rpx solid currentColor; border-radius:7rpx; }
.icon-lock::before { content:''; position:absolute; left:7rpx; top:-18rpx; width:18rpx; height:18rpx; border:4rpx solid currentColor; border-bottom:0; border-radius:12rpx 12rpx 0 0; box-sizing:border-box; }
.icon-help,.icon-about { display:flex; align-items:center; justify-content:center; border:4rpx solid currentColor; border-radius:50%; font-size:25rpx; font-weight:800; }
.icon-help::before { content:'?'; }.icon-about::before { content:'i'; }
.icon-switch::before,.icon-switch::after { content:''; position:absolute; left:3rpx; width:30rpx; height:12rpx; border-top:4rpx solid currentColor; border-right:4rpx solid currentColor; }
.icon-switch::before { top:7rpx; transform:skewX(35deg); }.icon-switch::after { bottom:5rpx; transform:rotate(180deg) skewX(35deg); }
.menu-label { flex: 1; font-size: 28rpx; color: #1f2937; }
.menu-arrow { font-size: 34rpx; color: #6b7280; }

/* ===== 退出 ===== */
.logout-btn {
  margin: 32rpx 40rpx 0;
  height: 88rpx;
  border-radius: 48rpx;
  background: #ffffff;
  border: 2rpx solid rgba(255, 107, 138, 0.08);
  color: #dc2626;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.05);
}
.logout-btn:active { opacity: 0.8; }
.version {
  display: block;
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #6b7280;
}

/* ===== 我的预约：per-status 背景色 ===== */
.order-bg-pending_quote   { background: #EEF2FF; }
.order-bg-pending_confirm { background: #FFFBEB; }
.order-bg-pending_home    { background: #FFF1F2; }
.order-bg-pending_shop    { background: #EFF6FF; }
.order-bg-in_progress     { background: #FDF4FF; }

