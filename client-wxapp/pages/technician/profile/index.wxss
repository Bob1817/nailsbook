  align-items: center;
  justify-content: center;
  gap: 12rpx;
  position: relative;
}
.st-tab:active { background: #e5e7eb; }

.st-tab-active {
  background: linear-gradient(135deg, #fff1f5 0%, #fdf4ff 100%);
