<nav-bar title="客户"/>
<view class="page">
  <!-- 固定头部 -->
  <view class="header">
    <!-- 搜索框 + 邀请按钮 -->
    <view class="search-row">
      <view class="search-bar">
        <view class="search-icon"></view>
        <input
          class="search-input"
        placeholder="搜索姓名或联系方式"
          confirm-type="search"
          value="{{keyword}}"
          bindinput="onKeywordInput"
          bindconfirm="onSearchConfirm"
        />
        <view wx:if="{{keyword}}" class="search-clear" bindtap="clearKeyword"><view class="clear-line"></view></view>
      </view>
      <view class="btn-invite" bindtap="handleInvite">
        <text class="invite-icon">+</text>
        <text class="invite-text">邀请</text>
      </view>
    </view>

    <!-- 系统生命周期 -->
    <view class="filter-row filter-row-stage">
      <scroll-view scroll-x class="tab-scroll" enhanced show-scrollbar="{{false}}">
        <view class="tab-list">
          <view
            wx:for="{{lifecycleTabs}}"
            wx:key="key"
            class="tab-item {{activeLifecycle === item.key ? 'tab-active' : ''}}"
            bindtap="onLifecycleChange"
            data-lifecycle="{{item.key}}"
          >{{item.label}}</view>
        </view>
      </scroll-view>
    </view>

    <!-- 人工标签 -->
    <view wx:if="{{tabs.length > 1}}" class="filter-row">
      <text class="filter-label">标签</text>
      <scroll-view scroll-x class="tab-scroll" enhanced show-scrollbar="{{false}}">
        <view class="tab-list">
          <view
            wx:for="{{tabs}}"
            wx:key="*this"
            class="tab-item {{activeTab === item ? 'tab-active' : ''}}"
            bindtap="onTabChange"
            data-tab="{{item}}"
          >{{item}}</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 可滚动客户列表 -->
  <scroll-view scroll-y class="list-scroll" enhanced show-scrollbar="{{false}}">
  <view class="list-area">
    <!-- 骨架屏 -->
    <view wx:if="{{loading && customers.length === 0}}" class="skeleton-list">
      <view wx:for="{{[1,2,3]}}" wx:key="*this" class="skel-card"></view>
    </view>

    <view wx:elif="{{loadFailed}}" class="empty-card" aria-live="polite">
      <text class="empty-title">客户列表加载失败</text>
      <text class="empty-sub">请检查网络后重试</text>
      <view class="empty-reset" bindtap="loadCustomers" role="button">重新加载</view>
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{!loading && visibleCustomers.length === 0}}" class="empty-card">
      <view class="empty-icon"><view class="empty-avatar-mark"></view></view>
      <text class="empty-title">{{keyword || activeTab !== '全部' || activeLifecycle !== 'all' ? '没有找到匹配的客户' : '还没有客户'}}</text>
      <text class="empty-sub">{{keyword || activeTab !== '全部' || activeLifecycle !== 'all' ? '换个关键词、生命周期或标签试试' : '客户预约后会自动出现在这里'}}</text>
      <view wx:if="{{keyword || activeTab !== '全部' || activeLifecycle !== 'all'}}" class="empty-reset" bindtap="resetFilters">清除筛选</view>
    </view>

    <!-- 客户卡片列表 -->
    <view wx:else class="customer-list">
      <view
        wx:for="{{visibleCustomers}}"
        wx:key="id"
        class="customer-card"
        bindtap="viewCustomer"
        data-id="{{item.id}}"
      >
        <view class="card-body">
          <!-- 头像 -->
          <view class="avatar-wrap">
            <view class="avatar" bindtap="toggleTagPopover" data-id="{{item.id}}">
              <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill" class="avatar-img" lazy-load aria-label="{{item.name || item.nickname || '客户'}}的头像" />
              <text wx:else class="avatar-char">{{item._initial}}</text>
            </view>
            <!-- 标签弹出层 -->
            <view wx:if="{{tagPopoverId === item.id && item._tags.length > 0}}" class="tag-popover">
              <view class="tag-popover-arrow"></view>
              <view class="tag-popover-content">
                <text wx:for="{{item._tags}}" wx:for-item="t" wx:key="*this" class="tag-pill" style="background:{{t.bg}};color:{{t.text}}">{{t.name}}</text>
              </view>
            </view>
          </view>

          <!-- 信息区 -->
          <view class="info-area">
            <view class="info-top">
              <view class="name-row">
                <text class="customer-name">{{item._displayName}}</text>
                <text class="lifecycle-badge {{item._lifecycleClass}}">{{item._lifecycleLabel}}</text>
                <view class="edit-name-btn" catchtap="startEditName" data-id="{{item.id}}" data-name="{{item.name}}">
                  <view class="edit-icon"></view>
                </view>
                <text class="arrow-icon">›</text>
              </view>
              <text class="customer-addr">{{item.address || '暂无地址'}}</text>
            </view>

            <view class="lifecycle-reason">
              <text>{{item._lifecycleReason}}</text>
              <text wx:if="{{item._expectedServiceText}}"> · 预计 {{item._expectedServiceText}}</text>
            </view>

            <!-- 标签 -->
            <view wx:if="{{item._tags.length > 0}}" class="tags-row">
              <text wx:for="{{item._tags}}" wx:for-item="t" wx:key="*this" class="tag-pill" style="background:{{t.bg}};color:{{t.text}}">{{t.name}}</text>
            </view>

            <!-- 统计网格 -->
            <view class="stats-grid">
              <view class="stat-item">
                <text class="stat-label">最近服务</text>
                <text class="stat-value">{{item._recentServiceText || '暂无记录'}}</text>
              </view>
              <view class="stat-item">
                <text class="stat-label">累计消费</text>
                <text class="stat-value stat-price">{{item._totalSpentText}}</text>
              </view>
              <view class="stat-item">
                <text class="stat-label">服务次数</text>
                <text class="stat-value">{{item.totalOrders || 0}} 次</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
  </scroll-view>
</view>

<!-- 编辑名称弹窗 -->
<view wx:if="{{showEditName}}" class="modal-overlay" bindtap="cancelEditName">
  <view class="modal-content" catchtap="noop">
    <text class="modal-title">编辑客户名称</text>
    <input
      class="modal-input"
      placeholder="请输入客户名称"
      value="{{editingName}}"
      bindinput="onEditNameInput"
      focus="{{showEditName}}"
    />
    <view class="modal-actions">
      <view class="modal-btn modal-cancel" bindtap="cancelEditName">取消</view>
      <view class="modal-btn modal-confirm" bindtap="saveEditName">保存</view>
    </view>
  </view>
</view>

<tab-bar selected="customers"/>
