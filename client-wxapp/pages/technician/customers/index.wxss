@import '../../../styles/booking-actions.wxss';

page {
  background: var(--bg-gradient-entry);
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== 固定头部 ===== */
.header {
  flex-shrink: 0;
  background: var(--bg-card);
  padding: 16rpx 32rpx 12rpx;
  border-bottom: 0;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

/* 搜索框 */
.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 44px;
  padding: 0 26rpx;
  background: var(--nb-soft-surface);
  border: 0;
  border-radius: var(--input-radius);
  min-width: 0;
}

.btn-invite {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 88rpx;
  padding: 0 22rpx;
  background: var(--nb-soft-surface);
  border: 0;
  border-radius: var(--radius-lg);
  flex-shrink: 0;
}

.btn-invite:active {
  background: var(--bg-tag);
}

.invite-icon {
  font-size: var(--font-md);
  color: var(--nb-money);
  font-weight: var(--weight-semibold);
}

.invite-text {
  font-size: var(--font-sm);
  color: var(--brand-primary);
  font-weight: var(--weight-semibold);
}

.search-icon {
  width: 24rpx; height: 24rpx; border: 3rpx solid var(--text-muted); border-radius: 50%; position: relative;
  flex-shrink: 0;
}
.search-icon::after { content: ''; position: absolute; width: 10rpx; height: 3rpx; right: -8rpx; bottom: -4rpx; background: var(--text-muted); transform: rotate(45deg); border-radius: 3rpx; }

.search-input {
  flex: 1;
  min-width: 0;
  min-height: 44px;
  font-size: var(--font-sm);
  color: var(--text-primary);
}
.search-placeholder { font-size: var(--font-sm); color: var(--nb-muted); }

.search-clear {
  min-width: 44px;
  min-height: 44px;
  width: 88rpx;
  height: 88rpx;
  margin-right: -26rpx;
  border-radius: 50%;
  background: transparent;
  color: var(--text-muted);
  font-size: var(--font-xs);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.clear-line { width: 24rpx; height: 3rpx; background: var(--nb-muted); transform: rotate(45deg); position: relative; }.clear-line::after { content: ''; position: absolute; inset: 0; background: var(--nb-muted); transform: rotate(90deg); }

/* 轻量筛选工具栏 */
.filter-row { min-height:88rpx; display:flex; align-items:center; gap:12rpx; }
.filter-row-stage { gap:0; }
.tab-scroll { flex:1; min-width:0; white-space:nowrap; }
.filter-label { width:58rpx; flex-shrink:0; color:var(--nb-muted); font-size: var(--font-xs); font-weight: var(--weight-semibold); }

.tab-list {
  display: inline-flex;
  gap: 8rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  height: 76rpx;
  min-height: 44px;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: transparent;
  border: 0;
  font-size: var(--font-sm);
  color: var(--text-muted);
  flex-shrink: 0;
  font-weight: var(--weight-medium);
}

.tab-item:active {
  background: var(--bg-tag);
}

.tab-active {
  background: var(--bg-tag);
  border-color: transparent;
  color: var(--brand-primary);
  font-weight: var(--weight-bold);
}

/* ===== 可滚动列表区 ===== */
.list-scroll {
  flex: 1;
  min-height: 0;
}

.list-area {
  padding: var(--space-md) 40rpx calc(24rpx + env(safe-area-inset-bottom));
}

/* 骨架屏 */
.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.skel-card {
  height: 280rpx;
  border-radius: var(--radius-lg);
  background: var(--nb-page);
  background-size: 200% 100%;
  animation: skel 1.4s linear infinite;
}

@keyframes skel {
  0% { background-position: 0 0; }
  100% { background-position: -200% 0; }
}

/* 空状态 */
.empty-card {
  margin: 80rpx 0;
  padding: 80rpx 40rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.empty-icon {
  width: 112rpx; height: 112rpx; border-radius: 50%; background: var(--bg-tag); display: flex; align-items: center; justify-content: center;
}
.empty-avatar-mark { width: 42rpx; height: 42rpx; border-radius: 50%; background: var(--nb-action); position: relative; }.empty-avatar-mark::after { content: ''; position: absolute; left: -14rpx; right: -14rpx; top: 48rpx; height: 28rpx; border-radius: var(--radius-lg) 28rpx 10rpx 10rpx; background: var(--nb-action); }
.empty-reset { display: flex; min-height: 88rpx; margin-top: 20rpx; padding: 0 38rpx; align-items: center; justify-content: center; border-radius: var(--radius-xl); background: var(--nb-page); color: var(--nb-ink); font-size: var(--font-sm); font-weight: var(--weight-semibold); }

.empty-title {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.empty-sub {
  font-size: var(--font-sm);
  color: var(--text-muted);
  text-align: center;
}

/* ===== 客户卡 ===== */
.customer-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.customer-card {
  padding: 24rpx 24rpx 20rpx;
  overflow: hidden;
  background: var(--bg-card);
  border: 0;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
  transition: transform 120ms ease, box-shadow 120ms ease;
}

.customer-card:active {
  transform: scale(0.995);
}

.customer-card-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 头像 */
.avatar {
  flex-shrink: 0;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--nb-page);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-char {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--nb-ink);
}

.identity-area {
  flex: 1;
  min-width: 0;
}

.identity-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  height: 48rpx;
}

.customer-name {
  flex: 0 1 auto;
  min-width: 0;
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.lifecycle-badge { flex-shrink:0; display:flex; height:40rpx; padding:0 14rpx; align-items:center; justify-content:center; box-sizing:border-box; border-radius:999rpx; font-size: var(--font-xs); font-weight: var(--weight-semibold); line-height:1; white-space:nowrap; }
.lifecycle-new { background: var(--nb-page); color: var(--nb-muted); }
.lifecycle-active { background: var(--nb-success-surface); color: var(--nb-success); }
.lifecycle-due { background: var(--nb-page); color: var(--nb-customer-due); }
.lifecycle-dormant { background: var(--nb-page); color: var(--nb-muted); }

.card-entry { flex-shrink:0; display:flex; width:88rpx; height:88rpx; margin-right:-20rpx; align-items:center; justify-content:center; border-radius:50%; }
.card-entry:active { background:var(--nb-page); }
.card-chevron {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--nb-control);
  border-right: 3rpx solid var(--nb-control);
  transform: rotate(45deg);
}

.address-row { display:flex; align-items:center; gap:10rpx; margin-top:10rpx; }
.location-icon { flex-shrink:0; width:14rpx; height:14rpx; border:3rpx solid var(--nb-control); border-radius:50% 50% 50% 0; transform:rotate(-45deg); }
.customer-addr {
  min-width: 0;
  font-size: var(--font-sm);
  color: var(--text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.customer-status { display:flex; min-height:88rpx; margin-top:18rpx; padding:12rpx 18rpx; align-items:center; gap:12rpx; border-radius:var(--radius-md); box-sizing:border-box; font-size: var(--font-xs); }
.status-dot { flex-shrink:0; width:12rpx; height:12rpx; border-radius:50%; }
.status-copy { flex:1; min-width:0; color:var(--text-body); }
.status-date { flex-shrink:0; color:var(--text-muted); }
.lifecycle-new-surface { background: var(--nb-page); }
.lifecycle-active-surface { background: var(--nb-success-surface); }
.lifecycle-due-surface { background: var(--nb-page); }
.lifecycle-dormant-surface { background: var(--nb-page); }
.lifecycle-new-dot { background: var(--nb-muted); }
.lifecycle-active-dot { background: var(--nb-success); }
.lifecycle-due-dot { background: var(--nb-customer-due); }
.lifecycle-dormant-dot { background: var(--nb-muted); }

/* 标签 */
.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.tag-pill {
  padding: 6rpx 20rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
}

/* 统计网格 */
.stats-grid {
  display: flex;
  margin-top: 20rpx;
  padding: 22rpx 0;
  border-top: 0;
  border-bottom: 0;
}

.stat-item {
  flex: 1;
  min-width: 0;
  padding: 0 8rpx;
  text-align: center;
  box-sizing: border-box;
  border-left: 0;
}

.stat-label {
  display: block;
  font-size: var(--font-xs);
  color: var(--text-muted);
  margin-bottom: 6rpx;
}

.stat-value {
  display: block;
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  color: var(--text-body);
}

.stat-price {
  color: var(--nb-money);
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
}

.lifecycle-deleted, .lifecycle-unbound { background:var(--nb-danger-surface); color:var(--nb-danger); }
.lifecycle-deleted-surface, .lifecycle-unbound-surface { background:var(--nb-danger-surface); }
.lifecycle-deleted-dot, .lifecycle-unbound-dot { background:var(--nb-danger); }
