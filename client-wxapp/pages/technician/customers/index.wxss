page {
  background: linear-gradient(180deg, #fff8fb 0%, #ffffff 34%, #f8f9fc 100%);
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== 固定头部 ===== */
.header {
  flex-shrink: 0;
  background: #fff;
  padding: 20rpx 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

/* 搜索框 */
.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 88rpx;
  padding: 0 24rpx;
  background: #fcf8f9;
  border: 2rpx solid #efe6ea;
  border-radius: 28rpx;
  min-width: 0;
}

.btn-invite {
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-height: 88rpx;
  padding: 0 28rpx;
  background: #fff1f5;
  border-radius: 28rpx;
  flex-shrink: 0;
}

.btn-invite:active {
  background: #ffe0ea;
}

.invite-icon {
  font-size: 28rpx;
  color: #ff6b8a;
  font-weight: 600;
}

.invite-text {
  font-size: 26rpx;
  color: #ff6b8a;
  font-weight: 500;
}

.search-icon {
  width: 24rpx; height: 24rpx; border: 3rpx solid #897881; border-radius: 50%; position: relative;
  flex-shrink: 0;
}
.search-icon::after { content: ''; position: absolute; width: 10rpx; height: 3rpx; right: -8rpx; bottom: -4rpx; background: #897881; transform: rotate(45deg); border-radius: 3rpx; }

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1f2937;
}

.search-clear {
  width: 88rpx;
  height: 88rpx;
  margin-right: -24rpx;
  border-radius: 50%;
  background: #e7dde2;
  color: #6b7280;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.clear-line { width: 24rpx; height: 3rpx; background: #6b7280; transform: rotate(45deg); position: relative; }.clear-line::after { content: ''; position: absolute; inset: 0; background: #6b7280; transform: rotate(90deg); }

/* 分类标签 */
.tab-scroll {
  white-space: nowrap;
}
.filter-label { display:block; margin:0 0 8rpx 4rpx; color:#8b7b84; font-size:21rpx; font-weight:600; }
.lifecycle-scroll { margin-bottom: 12rpx; }
.lifecycle-tab { background:#faf5f7; }

.tab-list {
  display: inline-flex;
  gap: 16rpx;
  padding-bottom: 4rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 32rpx;
  border-radius: 32rpx;
  background: #fff;
  border: 2rpx solid #efe6ea;
  font-size: 26rpx;
  color: #6b7280;
  flex-shrink: 0;
}

.tab-item:active {
  background: #f8edf1;
}

.tab-active {
  background: linear-gradient(135deg, #ff6b8a 0%, #8b5cf6 100%);
  border-color: transparent;
  color: #fff;
  font-weight: 600;
}

/* ===== 可滚动列表区 ===== */
.list-scroll {
  flex: 1;
  min-height: 0;
}

.list-area {
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
}

/* 骨架屏 */
.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.skel-card {
  height: 280rpx;
  border-radius: 28rpx;
  background: linear-gradient(90deg, #f5f0f3, #faf2f5, #f5f0f3);
  background-size: 200% 100%;
  animation: skel 1.4s linear infinite;
}

@keyframes skel {
  0% { background-position: 0 0; }
  100% { background-position: -200% 0; }
}

/* 空状态 */
.empty-card {
  margin: 80rpx 0;
  padding: 80rpx 40rpx;
  background: #fff;
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.empty-icon {
  width: 112rpx; height: 112rpx; border-radius: 50%; background: #fff0f5; display: flex; align-items: center; justify-content: center;
}
.empty-avatar-mark { width: 42rpx; height: 42rpx; border-radius: 50%; background: #e786aa; position: relative; }.empty-avatar-mark::after { content: ''; position: absolute; left: -14rpx; right: -14rpx; top: 48rpx; height: 28rpx; border-radius: 28rpx 28rpx 10rpx 10rpx; background: #e786aa; }
.empty-reset { display: flex; min-height: 88rpx; margin-top: 20rpx; padding: 0 38rpx; align-items: center; justify-content: center; border-radius: 44rpx; background: #fff1f5; color: #a64f73; font-size: 24rpx; font-weight: 600; }

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.empty-sub {
  font-size: 24rpx;
  color: #6b7280;
  text-align: center;
}

/* ===== 客户卡 ===== */
.customer-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.customer-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(36, 27, 41, 0.06);
}

.customer-card:active {
  background: #fafafa;
}

.card-body {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

/* 头像 */
.avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #fdecef;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-char {
  font-size: 36rpx;
  font-weight: 700;
  color: #e86b8f;
}

/* 标签弹出层 */
.tag-popover {
  position: absolute;
  left: 50%;
  top: 100%;
  transform: translateX(-50%);
  margin-top: 16rpx;
  z-index: 20;
  min-width: 160rpx;
}

.tag-popover-arrow {
  position: absolute;
  top: -12rpx;
  left: 50%;
  transform: translateX(-50%) rotate(45deg);
  width: 24rpx;
  height: 24rpx;
  background: #fff;
  border: 2rpx solid rgba(0, 0, 0, 0.04);
  border-bottom: none;
  border-right: none;
}

.tag-popover-content {
  background: #fff;
  border-radius: 24rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* 信息区 */
.info-area {
  flex: 1;
  min-width: 0;
}

.info-top {
  margin-bottom: 16rpx;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.customer-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.lifecycle-badge { flex-shrink:0; padding:6rpx 14rpx; border-radius:999rpx; font-size:20rpx; font-weight:600; }
.lifecycle-new { background:#ebf4ff; color:#3b82f6; }
.lifecycle-active { background:#e8f7ee; color:#238b57; }
.lifecycle-due { background:#fff2dc; color:#b56f12; }
.lifecycle-dormant { background:#f2f0f3; color:#756b70; }
.lifecycle-reason { margin:0 0 16rpx; color:#8b7b84; font-size:21rpx; line-height:1.5; }

.edit-name-btn {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.4;
}

.edit-name-btn:active {
  opacity: 0.8;
}

.edit-icon {
  width: 24rpx; height: 7rpx; border-radius: 4rpx; background: #8c7982; transform: rotate(-45deg); position: relative;
}
.edit-icon::after { content: ''; position: absolute; right: -7rpx; top: 0; border-top: 4rpx solid transparent; border-bottom: 4rpx solid transparent; border-left: 7rpx solid #8c7982; }

.arrow-icon {
  flex-shrink: 0;
  font-size: 32rpx;
  color: #767b84;
  margin-left: auto;
}

.customer-addr {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 标签 */
.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.tag-pill {
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

/* 统计网格 */
.stats-grid {
  display: flex;
  background: #fcf7f8;
  border-radius: 20rpx;
  padding: 20rpx;
  gap: 16rpx;
}

.stat-item {
  flex: 1;
  min-width: 0;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 6rpx;
}

.stat-value {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #374151;
}

.stat-price {
  color: #ff6b8a;
  font-weight: 600;
}

/* ===== 编辑名称弹窗 ===== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
}

.modal-content {
  width: 100%;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx;
}

.modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-input {
  width: 100%;
  height: 88rpx;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1f2937;
  box-sizing: border-box;
  margin-bottom: 32rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
}

.modal-cancel {
  background: #f3f4f6;
  color: #374151;
}

.modal-confirm {
  background: linear-gradient(135deg, #ff6b8a, #8b5cf6);
  color: #fff;
}
