@import '../../../styles/booking-actions.wxss';

page {
  background: var(--nb-page);
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== 固定头部 ===== */
.header {
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.78);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  backdrop-filter: blur(20px) saturate(180%);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  padding: 12rpx var(--space-lg) 14rpx;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 10rpx;
}

/* 搜索框 */
.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 72rpx;
  min-height: 44px;
  padding: 0 24rpx;
  background: var(--nb-page);
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  border-radius: var(--radius-full);
  min-width: 0;
  box-sizing: border-box;
}

/* Airbnb 完整实体胶囊邀请按钮 */
.btn-invite.btn-invite,
.btn-invite.booking-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 72rpx;
  min-height: 44px;
  padding: 0 24rpx;
  margin: 0;
  background: var(--nb-page);
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  border-radius: var(--radius-full);
  box-sizing: border-box;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.03);
  flex-shrink: 0;
  line-height: normal;
  font: inherit;
  width: auto;
  min-width: 124rpx;
  max-width: none;
}

.btn-invite.btn-invite::after,
.btn-invite.booking-action::after {
  border: 0;
}

.btn-invite.btn-invite:active,
.btn-invite.booking-action:active,
.btn-invite-pressed {
  background: var(--nb-pressed);
  opacity: 1;
  transform: scale(0.97);
}

.invite-icon {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

.invite-text {
  font-size: 26rpx;
  color: var(--nb-ink);
  font-weight: var(--weight-semibold);
  line-height: 1;
  white-space: nowrap;
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  min-height: 44px;
  font-size: 26rpx;
  color: var(--nb-ink);
}
.search-placeholder { font-size: 26rpx; color: var(--nb-muted); }

.search-clear {
  min-width: 44px;
  min-height: 44px;
  width: 56rpx;
  height: 72rpx;
  margin-right: -16rpx;
  border-radius: 50%;
  background: transparent;
  color: var(--nb-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.clear-icon { width: 24rpx; height: 24rpx; opacity: 0.6; }

/* 轻量筛选工具栏 - Airbnb Filter Chips */
.filter-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 56rpx;
  min-height: 56rpx;
  margin-top: 8rpx;
}

.filter-row-stage {
  margin-top: 0;
  gap: 0;
}

.tab-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  height: 56rpx;
}

.filter-label {
  width: 58rpx;
  flex-shrink: 0;
  color: var(--nb-muted);
  font-size: 22rpx;
  font-weight: var(--weight-semibold);
  line-height: 56rpx;
}

.tab-list {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  height: 56rpx;
}

/* Airbnb Filter Chip 药丸紧凑规格 */
.tab-item {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 54rpx;
  min-height: 54rpx;
  padding: 0 22rpx;
  border-radius: var(--radius-full);
  background: var(--nb-page);
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  font-size: 24rpx;
  color: var(--nb-secondary);
  flex-shrink: 0;
  font-weight: var(--weight-medium);
  transition: all 0.15s ease-in-out;
  box-sizing: border-box;
  line-height: 1;
}
.tab-item::after { content:''; position:absolute; top:-16rpx; bottom:-16rpx; left:0; right:0; }

/* 触控无障碍扩展：热区上下扩展 16rpx 达到 44px+ */
.tab-item:active {
  background: var(--nb-pressed);
  transform: scale(0.97);
}

.tab-active {
  background: var(--nb-action);
  border-color: var(--nb-action);
  color: var(--nb-inverse);
  font-weight: var(--weight-semibold);
}

/* ===== 可滚动列表区 ===== */
.list-scroll {
  flex: 1;
  min-height: 0;
}

.list-area {
  padding: var(--space-md) var(--space-xl) calc(140rpx + env(safe-area-inset-bottom));
}

/* 骨架屏 */
.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.skel-card {
  height: 280rpx;
  border-radius: var(--radius-lg);
  background: var(--nb-page);
  background-size: 200% 100%;
  animation: skel 1.4s linear infinite;
}

@keyframes skel {
  0% { background-position: 0 0; }
  100% { background-position: -200% 0; }
}

/* 空状态 */
.empty-card {
  margin: 80rpx 0;
  padding: 80rpx var(--space-xl);
  background: var(--nb-surface);
  border: 1rpx solid var(--nb-line);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.empty-icon {
  width: 112rpx; height: 112rpx; border-radius: 50%; background: var(--nb-soft-surface); display: flex; align-items: center; justify-content: center;
}
.empty-avatar-mark { width: 42rpx; height: 42rpx; border-radius: 50%; background: var(--nb-action); position: relative; }.empty-avatar-mark::after { content: ''; position: absolute; left: -14rpx; right: -14rpx; top: 48rpx; height: 28rpx; border-radius: var(--radius-lg) var(--radius-lg) 10rpx 10rpx; background: var(--nb-action); }
.empty-reset { display: flex; min-height: 88rpx; margin-top: 20rpx; padding: 0 38rpx; align-items: center; justify-content: center; border-radius: var(--radius-xl); background: var(--nb-page); color: var(--nb-ink); font-size: var(--font-sm); font-weight: var(--weight-semibold); }

.empty-title {
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: var(--nb-ink);
}

.empty-sub {
  font-size: var(--font-sm);
  color: var(--nb-muted);
  text-align: center;
}

/* ===== 客户卡 ===== */
.customer-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.customer-card {
  padding: var(--space-md);
  overflow: hidden;
  background: var(--nb-surface);
  border: 1rpx solid var(--nb-line);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: transform 120ms ease, box-shadow 120ms ease;
}

.customer-card:active {
  transform: scale(0.995);
}

.customer-card-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 头像 */
.avatar {
  flex-shrink: 0;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--nb-soft-surface);
  border: 1rpx solid var(--nb-line);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-char {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--nb-ink);
}

.identity-area {
  flex: 1;
  min-width: 0;
}

.identity-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  height: 48rpx;
}

.customer-name {
  flex: 0 1 auto;
  min-width: 0;
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--nb-ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.lifecycle-badge { flex-shrink:0; display:flex; height:40rpx; padding:0 14rpx; align-items:center; justify-content:center; box-sizing:border-box; border-radius:var(--radius-full); font-size: var(--font-xs); font-weight: var(--weight-semibold); line-height:1; white-space:nowrap; }
.lifecycle-new { background: var(--nb-page); color: var(--nb-muted); }
.lifecycle-active { background: var(--nb-success-surface); color: var(--nb-success); }
.lifecycle-due { background: var(--nb-page); color: var(--nb-customer-due); }
.lifecycle-dormant { background: var(--nb-page); color: var(--nb-muted); }

.card-entry { flex-shrink:0; display:flex; width:88rpx; height:88rpx; margin-right:-20rpx; align-items:center; justify-content:center; border-radius:50%; }
.card-entry:active { background:var(--nb-page); }
.card-chevron {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--nb-control);
  border-right: 3rpx solid var(--nb-control);
  transform: rotate(45deg);
}

.address-row { display:flex; align-items:center; gap:10rpx; margin-top:10rpx; }
.location-icon { flex-shrink:0; width:14rpx; height:14rpx; border:3rpx solid var(--nb-control); border-radius:50% 50% 50% 0; transform:rotate(-45deg); }
.customer-addr {
  min-width: 0;
  font-size: var(--font-sm);
  color: var(--nb-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.customer-status { display:flex; min-height:88rpx; margin-top:18rpx; padding:12rpx 18rpx; align-items:center; gap:12rpx; border-radius:var(--radius-md); box-sizing:border-box; font-size: var(--font-xs); }
.status-dot { flex-shrink:0; width:12rpx; height:12rpx; border-radius:50%; }
.status-copy { flex:1; min-width:0; color:var(--nb-ink); }
.status-date { flex-shrink:0; color:var(--nb-muted); }
.lifecycle-new-surface { background: var(--nb-page); }
.lifecycle-active-surface { background: var(--nb-success-surface); }
.lifecycle-due-surface { background: var(--nb-page); }
.lifecycle-dormant-surface { background: var(--nb-page); }
.lifecycle-new-dot { background: var(--nb-muted); }
.lifecycle-active-dot { background: var(--nb-success); }
.lifecycle-due-dot { background: var(--nb-customer-due); }
.lifecycle-dormant-dot { background: var(--nb-muted); }

/* 标签 */
.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.tag-pill {
  padding: 6rpx 20rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
}

/* 统计网格 */
.stats-grid {
  display: flex;
  margin-top: 20rpx;
  padding: 22rpx 0 0;
  border-top: 1rpx solid var(--nb-line);
  border-bottom: 0;
}

.stat-item {
  flex: 1;
  min-width: 0;
  padding: 0 var(--space-xs);
  text-align: center;
  box-sizing: border-box;
  border-left: 0;
}

.stat-label {
  display: block;
  font-size: var(--font-xs);
  color: var(--nb-muted);
  margin-bottom: 6rpx;
}

.stat-value {
  display: block;
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  color: var(--nb-ink);
}

.stat-price {
  color: var(--nb-ink);
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
}

.lifecycle-deleted, .lifecycle-unbound { background:var(--nb-danger-surface); color:var(--nb-danger); }
.lifecycle-deleted-surface, .lifecycle-unbound-surface { background:var(--nb-danger-surface); }
.lifecycle-deleted-dot, .lifecycle-unbound-dot { background:var(--nb-danger); }

.invite-guide-mask { position:fixed; z-index:1000; inset:0; padding:var(--space-lg); display:flex; align-items:center; justify-content:center; background:rgba(0,0,0,.52); box-sizing:border-box; }
.invite-guide-dialog { width:100%; max-width:620rpx; padding:36rpx var(--space-lg) 28rpx; border-radius:24rpx; background:var(--nb-surface); box-sizing:border-box; }
.invite-guide-title,.invite-guide-desc,.invite-guide-note { display:block; }
.invite-guide-title { color:var(--nb-ink); font-size:var(--font-md); font-weight:var(--weight-semibold); text-align:center; }
.invite-guide-desc { margin-top:var(--space-sm); color:var(--nb-secondary); font-size:var(--font-sm); line-height:1.6; }
.invite-guide-flow { margin-top:var(--space-md); display:grid; grid-template-columns:1fr 1fr; gap:12rpx; }
.invite-guide-flow text { min-height:64rpx; padding:12rpx 14rpx; display:flex; align-items:center; border-radius:12rpx; background:var(--nb-page); color:var(--nb-ink); font-size:var(--font-xs); box-sizing:border-box; }
.invite-guide-note { margin-top:18rpx; color:var(--nb-muted); font-size:var(--font-xs); line-height:1.5; }
.invite-guide-actions { margin-top:28rpx; display:grid; grid-template-columns:1fr 1fr; gap:var(--space-sm); }
.invite-guide-cancel,.invite-guide-share { min-height:44px; height:44px; margin:0; display:flex; align-items:center; justify-content:center; border-radius:8px; font-size:var(--font-sm); font-weight:var(--weight-semibold); box-sizing:border-box; }
.invite-guide-cancel { background:var(--nb-soft-surface); color:var(--nb-secondary); }
.invite-guide-share { padding:0; border:0; background:var(--nb-action); color:var(--text-inverse); line-height:1.4; }
.invite-guide-share::after { border:0; }
