page {
  background: var(--bg-gradient-entry);
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== 固定头部 ===== */
.header {
  flex-shrink: 0;
  background: var(--bg-card);
  padding: 16rpx 32rpx 12rpx;
  border-bottom: 1rpx solid #f1ecef;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

/* 搜索框 */
.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 88rpx;
  padding: 0 26rpx;
  background: #f7f7f8;
  border: 2rpx solid transparent;
  border-radius: 22rpx;
  min-width: 0;
}

.btn-invite {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 88rpx;
  padding: 0 22rpx;
  background: var(--bg-card);
  border: 2rpx solid #f0d7e1;
  border-radius: 22rpx;
  flex-shrink: 0;
}

.btn-invite:active {
  background: #fff5f8;
}

.invite-icon {
  font-size: var(--font-md);
  color: #b44f78;
  font-weight: var(--weight-semibold);
}

.invite-text {
  font-size: var(--font-sm);
  color: #9f496d;
  font-weight: var(--weight-semibold);
}

.search-icon {
  width: 24rpx; height: 24rpx; border: 3rpx solid #9a9297; border-radius: 50%; position: relative;
  flex-shrink: 0;
}
.search-icon::after { content: ''; position: absolute; width: 10rpx; height: 3rpx; right: -8rpx; bottom: -4rpx; background: #9a9297; transform: rotate(45deg); border-radius: 3rpx; }

.search-input {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--text-primary);
}

.search-clear {
  width: 88rpx;
  height: 88rpx;
  margin-right: -26rpx;
  border-radius: 50%;
  background: transparent;
  color: var(--text-muted);
  font-size: var(--font-xs);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.clear-line { width: 24rpx; height: 3rpx; background: #6b7280; transform: rotate(45deg); position: relative; }.clear-line::after { content: ''; position: absolute; inset: 0; background: #6b7280; transform: rotate(90deg); }

/* 轻量筛选工具栏 */
.filter-row { min-height:88rpx; display:flex; align-items:center; gap:12rpx; }
.filter-row-stage { gap:0; }
.tab-scroll { flex:1; min-width:0; white-space:nowrap; }
.filter-label { width:58rpx; flex-shrink:0; color:#9a8f96; font-size: var(--font-xs); font-weight: var(--weight-semibold); }

.tab-list {
  display: inline-flex;
  gap: 8rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: transparent;
  border: 2rpx solid transparent;
  font-size: var(--font-sm);
  color: #746b70;
  flex-shrink: 0;
}

.tab-item:active {
  background: #f8f3f5;
}

.tab-active {
  background: transparent;
  border-color: transparent;
  color: #a64f73;
  font-weight: var(--weight-bold);
}

/* ===== 可滚动列表区 ===== */
.list-scroll {
  flex: 1;
  min-height: 0;
}

.list-area {
  padding: var(--space-md) 40rpx calc(24rpx + env(safe-area-inset-bottom));
}

/* 骨架屏 */
.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.skel-card {
  height: 280rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(90deg, #f5f0f3, #faf2f5, #f5f0f3);
  background-size: 200% 100%;
  animation: skel 1.4s linear infinite;
}

@keyframes skel {
  0% { background-position: 0 0; }
  100% { background-position: -200% 0; }
}

/* 空状态 */
.empty-card {
  margin: 80rpx 0;
  padding: 80rpx 40rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.empty-icon {
  width: 112rpx; height: 112rpx; border-radius: 50%; background: var(--bg-tag); display: flex; align-items: center; justify-content: center;
}
.empty-avatar-mark { width: 42rpx; height: 42rpx; border-radius: 50%; background: #e786aa; position: relative; }.empty-avatar-mark::after { content: ''; position: absolute; left: -14rpx; right: -14rpx; top: 48rpx; height: 28rpx; border-radius: var(--radius-lg) 28rpx 10rpx 10rpx; background: #e786aa; }
.empty-reset { display: flex; min-height: 88rpx; margin-top: 20rpx; padding: 0 38rpx; align-items: center; justify-content: center; border-radius: var(--radius-xl); background: #fff1f5; color: #a64f73; font-size: var(--font-sm); font-weight: var(--weight-semibold); }

.empty-title {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.empty-sub {
  font-size: var(--font-sm);
  color: var(--text-muted);
  text-align: center;
}

/* ===== 客户卡 ===== */
.customer-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.customer-card {
  background: var(--bg-gradient-entry);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: 0 12rpx 24rpx rgba(36, 27, 41, 0.05);
}

.customer-card:active {
  background: #fff8fb;
}

.card-body {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

/* 头像 */
.avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #fdecef;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-char {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: #e86b8f;
}

/* 标签弹出层 */
.tag-popover {
  position: absolute;
  left: 50%;
  top: 100%;
  transform: translateX(-50%);
  margin-top: var(--space-sm);
  z-index: 20;
  min-width: 160rpx;
}

.tag-popover-arrow {
  position: absolute;
  top: -12rpx;
  left: 50%;
  transform: translateX(-50%) rotate(45deg);
  width: 24rpx;
  height: 24rpx;
  background: var(--bg-card);
  border: 2rpx solid rgba(0, 0, 0, 0.04);
  border-bottom: none;
  border-right: none;
}

.tag-popover-content {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 16rpx 20rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* 信息区 */
.info-area {
  flex: 1;
  min-width: 0;
}

.info-top {
  margin-bottom: var(--space-sm);
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.customer-name {
  flex: 1;
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.lifecycle-badge { flex-shrink:0; padding:6rpx 14rpx; border-radius:999rpx; font-size: var(--font-xs); font-weight: var(--weight-semibold); }
.lifecycle-new { background:#ebf4ff; color:#3b82f6; }
.lifecycle-active { background:#e8f7ee; color:#238b57; }
.lifecycle-due { background:#fff2dc; color:#b56f12; }
.lifecycle-dormant { background:#f2f0f3; color:#756b70; }
.lifecycle-reason { margin:0 0 16rpx; color:#8b7b84; font-size: var(--font-xs); line-height: var(--leading-normal); }

.edit-name-btn {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.4;
}

.edit-name-btn:active {
  opacity: 0.8;
}

.edit-icon {
  width: 24rpx; height: 7rpx; border-radius: 4rpx; background: #8c7982; transform: rotate(-45deg); position: relative;
}
.edit-icon::after { content: ''; position: absolute; right: -7rpx; top: 0; border-top: 4rpx solid transparent; border-bottom: 4rpx solid transparent; border-left: 7rpx solid #8c7982; }

.arrow-icon {
  flex-shrink: 0;
  font-size: var(--font-lg);
  color: var(--text-muted);
  margin-left: auto;
}

.customer-addr {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 标签 */
.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: var(--space-sm);
}

.tag-pill {
  padding: 6rpx 20rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
}

/* 统计网格 */
.stats-grid {
  display: flex;
  background: #faf5f7;
  border-radius: var(--radius-md);
  padding: 20rpx;
  gap: 16rpx;
}

.stat-item {
  flex: 1;
  min-width: 0;
}

.stat-label {
  display: block;
  font-size: var(--font-xs);
  color: var(--text-muted);
  margin-bottom: 6rpx;
}

.stat-value {
  display: block;
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  color: var(--text-body);
}

.stat-price {
  color: var(--brand-primary);
  font-weight: var(--weight-semibold);
}

/* ===== 编辑名称弹窗 ===== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
}

.modal-content {
  width: 100%;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 48rpx;
}

.modal-title {
  display: block;
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-input {
  width: 100%;
  height: 88rpx;
  background: var(--bg-input);
  border: 2rpx solid var(--border-default);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  font-size: var(--font-md);
  color: var(--text-primary);
  box-sizing: border-box;
  margin-bottom: 32rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: var(--radius-xl);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
}

.modal-cancel {
  background: var(--bg-input);
  color: var(--text-body);
}

.modal-confirm {
  background: var(--brand-gradient);
  color: var(--text-inverse);
}
