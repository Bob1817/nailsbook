<nav-bar title="预约详情" showBack/>
<view wx:if="{{loading}}" class="loading-page">
  <view class="spinner"></view>
  <text class="loading-text">加载中...</text>
</view>

<view wx:elif="{{loadFailed}}" class="load-error" aria-live="polite">
  <view class="load-error-mark">!</view>
  <text class="load-error-title">{{loadErrorText}}</text>
  <text wx:if="{{orderId}}" class="load-error-desc">请检查网络后重试</text>
  <button wx:if="{{orderId}}" class="retry-btn" bindtap="loadOrder">重新加载</button>
</view>

<view wx:else class="page">
  <!-- ============ 状态头 ============ -->
  <view class="status-hero {{order._statusTone}}">
    <view class="hero-row">
      <text class="hero-status">{{order._statusLabel}}</text>
      <text class="hero-type">{{order._typeLabel}}</text>
    </view>
    <text class="hero-order-no">预约号 {{order.orderNo}}</text>
    <text wx:if="{{order._statusDesc}}" class="hero-desc">{{order._statusDesc}}</text>
  </view>

  <!-- ============ 客户卡片 ============ -->
  <view class="card customer-card card-overlap">
    <view class="customer-row">
      <view class="cu-avatar">
        <image wx:if="{{order.customerAvatar}}" src="{{order.customerAvatar}}" mode="aspectFill" class="cu-avatar-img" aria-label="{{order.customerName}}的头像" />
        <text wx:else class="cu-avatar-char">{{order.customerName[0]}}</text>
      </view>
      <view class="cu-info">
        <text class="cu-name">{{order.customerName}}</text>
        <text class="cu-phone">{{order._customerPhoneMasked}}</text>
      </view>
      <view class="cu-actions">
        <view wx:if="{{order.customerPhone}}" class="round-btn" catchtap="callCustomer" role="button" aria-label="拨打客户电话">
          <image class="btn-icon-phone" src="/static/icons/phone.svg" mode="aspectFit" />
        </view>
      </view>
    </view>
  </view>

  <!-- ============ 服务信息 ============ -->
  <view class="card">
    <text class="card-title">服务信息</text>

    <view class="info-row">
      <text class="info-label">服务方式</text>
      <text class="info-value">{{order._typeLabel}}</text>
    </view>

    <view class="info-row">
      <text class="info-label">{{order.bookingPhase === 'application' ? '客户期望时间' : '预约时间'}}</text>
      <text class="info-value">{{order._dateLabel}} {{order._timeRange}}</text>
      <view class="edit-link" bindtap="editBookingTime" role="button" aria-label="编辑预约时间">
        <view class="edit-link-label">编辑</view>
      </view>
    </view>

    <view wx:if="{{order.address}}" class="info-row address-row">
      <text class="info-label">服务地址</text>
      <view class="info-value-block">
        <text class="addr-text">{{order.address}}</text>
        <view class="copy-link" catchtap="navigateToAddress" role="button" aria-label="导航到地址">
          <view class="copy-link-label">导航</view>
        </view>
      </view>
    </view>

    <view class="info-row">
      <text class="info-label">服务项目</text>
      <text class="info-value">{{order.serviceName}}</text>
      <view class="edit-link" bindtap="openServiceEdit" role="button" aria-label="编辑服务项目">
        <view class="edit-link-label">编辑</view>
      </view>
    </view>

    <view wx:if="{{order.durationMinutes > 0}}" class="info-row">
      <text class="info-label">预计时长</text>
      <text class="info-value">{{order.durationMinutes}}分钟</text>
    </view>
  </view>

  <!-- ============ 价格信息 ============ -->
  <view wx:if="{{order._showPriceCard}}" class="card">
    <text class="card-title">{{order.status === 'pending_agree' ? '报价信息' : '价格信息'}}</text>

    <view wx:if="{{order.serviceLines && order.serviceLines.length}}">
      <view wx:for="{{order.serviceLines}}" wx:key="id" class="price-line">
        <text>{{item.name}}{{item.quantity > 1 ? ' ×' + item.quantity : ''}}</text>
        <text>¥{{item.subtotalFen / 100}}</text>
      </view>
      <view class="price-line price-subtotal">
        <text>服务合计</text>
        <text>¥{{order.serviceSubtotalFen / 100}}</text>
      </view>
      <view wx:if="{{order.discountAmountFen > 0 && !order._priceDiffType}}" class="price-line price-discount">
        <text>优惠</text>
        <text>-¥{{order.discountAmountFen / 100}}</text>
      </view>
    </view>
    <view wx:else>
      <view class="price-line">
        <text>{{order.serviceName || '预约服务'}}</text>
        <text>{{order._priceText}}</text>
      </view>
    </view>

    <view wx:if="{{order._priceDiffType === 'surcharge'}}" class="price-line price-surcharge">
      <text>其他</text>
      <text>+¥{{order._priceDiffFen / 100}}</text>
    </view>
    <view wx:elif="{{order._priceDiffType === 'discount'}}" class="price-line price-discount">
      <text>优惠</text>
      <text>-¥{{0 - order._priceDiffFen / 100}}</text>
    </view>

    <view class="price-row" bindtap="openEditPrice">
      <text class="price-label">{{order.bookingType === 'work' ? '作品标准报价' : '最终价格'}}</text>
      <view class="price-right">
        <view class="price-main-wrap">
          <text class="price-main">{{order._priceText}}</text>
          <text class="price-edit-arrow">›</text>
        </view>
        <text class="deposit-note">{{order.depositPaid && order.depositAmount > 0 ? '已支付定金 ¥' + (order.depositAmount / 100) : '未支付定金'}}</text>
      </view>
    </view>

    <text class="offline-payment-note">实际付款由客户与门店线下完成，小程序不提供代收款服务。</text>
  </view>

  <!-- ============ 备注 ============ -->
  <view wx:if="{{order.remark}}" class="card">
    <text class="card-title">备注</text>
    <text class="remark-text">{{order.remark}}</text>
  </view>

  <!-- ============ 底部操作栏 ============ -->
  <view class="bottom-actions">
    <view class="action-btn action-danger {{submitting ? 'is-disabled' : ''}}" bindtap="openCancel">取消预约</view>
    <view wx:if="{{order.status === 'in_progress'}}" class="action-btn action-primary {{submitting ? 'is-disabled' : ''}}" bindtap="completeOrder">标记完成</view>
    <view wx:elif="{{order._actions.length > 0}}" class="action-btns-row">
      <view
        wx:for="{{order._actions}}"
        wx:key="key"
        class="action-btn {{item.style}}"
        bindtap="onAction"
        data-key="{{item.key}}"
      >{{item.label}}</view>
    </view>
  </view>
</view>

<!-- ============ 报价底部弹层 ============ -->
<view wx:if="{{showQuote}}" class="sheet-mask" bindtap="closeQuote"></view>
<view class="sheet {{showQuote ? 'sheet-show' : ''}}" catchtap="">
  <view class="sheet-header">
    <text class="sheet-title">{{quoteIsRevise ? '修改报价' : '发送报价'}}</text>
    <view class="sheet-close" bindtap="closeQuote">✕</view>
  </view>

  <scroll-view scroll-y class="sheet-body">
    <view class="form-item">
      <text class="form-label">服务组合 <text class="required">*</text></text>
      <text class="quote-helper">根据客户图片和描述，选择实际需要的基础服务</text>
      <view class="quote-service-list"><view wx:for="{{quoteServices}}" wx:key="id" class="quote-service {{quoteSelectedServiceIds.indexOf(item.id) >= 0 ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="toggleQuoteService"><view><text class="quote-service-name">{{item.name}}</text><text class="quote-service-meta">¥{{item.price}} · {{item.durationMinutes}}分钟</text></view><text class="quote-service-check">{{quoteSelectedServiceIds.indexOf(item.id) >= 0 ? '✓' : ''}}</text></view></view>
    </view>

    <view class="form-row-2">
      <view class="form-item form-half">
        <text class="form-label">服务日期 <text class="required">*</text></text>
        <picker mode="date" value="{{quoteDate}}" start="{{todayDate}}" bindchange="onQuoteDateChange">
          <view class="form-input picker-input">{{quoteDate || '请选择'}}</view>
        </picker>
      </view>
      <view class="form-item form-half">
        <text class="form-label">开始时间 <text class="required">*</text></text>
        <picker mode="time" value="{{quoteTime}}" bindchange="onQuoteTimeChange">
          <view class="form-input picker-input">{{quoteTime || '请选择'}}</view>
        </picker>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">优惠金额（元）</text>
      <input class="form-input" type="digit" placeholder="0" value="{{quoteDiscount}}" bindinput="onQuoteDiscountInput" confirm-type="done" />
      <view class="quote-summary"><text>服务合计 ¥{{quoteSubtotalFen / 100}}</text><text>预计 {{quoteTotalDuration}} 分钟</text><text class="quote-final">最终报价 ¥{{quoteFinalFen / 100}}</text></view>
    </view>

    <view class="form-item">
      <text class="form-label">备注（选填）</text>
      <textarea
        class="form-textarea"
        placeholder="给客户的备注"
        value="{{quoteRemark}}"
        bindinput="onQuoteRemarkInput"
        maxlength="200" confirm-type="done" />
    </view>

    <view class="form-item">
      <text class="form-label">定金金额（元）</text>
      <input class="form-input" type="digit" placeholder="0" value="{{quoteDepositAmount}}" bindinput="onQuoteDepositAmountInput" confirm-type="done" />
    </view>
    <view class="form-item form-item-switch">
      <text class="form-label">定金已支付</text>
      <switch checked="{{quoteDepositPaid}}" bindchange="onQuoteDepositPaidChange" color="#FF6B8A"/>
    </view>
  </scroll-view>

  <view class="sheet-footer">
    <view class="action-btn action-primary {{submitting ? 'is-disabled' : ''}}" bindtap="submitQuote">
      {{submitting ? '提交中...' : '确认报价'}}
    </view>
  </view>
</view>

<!-- ============ 取消预约底部弹层 ============ -->
<view wx:if="{{showCancel}}" class="sheet-mask" bindtap="closeCancel"></view>
<view class="sheet {{showCancel ? 'sheet-show' : ''}}" catchtap="">
  <view class="sheet-header">
    <text class="sheet-title">取消预约</text>
    <view class="sheet-close" bindtap="closeCancel">✕</view>
  </view>

  <view class="sheet-body">
    <view class="form-item">
      <text class="form-label">取消原因（选填）</text>
      <textarea
        class="form-textarea"
        placeholder="请简要说明取消原因，便于客户了解"
        value="{{cancelReason}}"
        bindinput="onCancelReasonInput"
        maxlength="200" confirm-type="done" />
    </view>

    <view class="reason-chips">
      <view
        wx:for="{{cancelReasons}}"
        wx:key="*this"
        class="reason-chip"
        bindtap="onPickReason"
        data-reason="{{item}}"
      >{{item}}</view>
    </view>
  </view>

  <view class="sheet-footer">
    <view class="action-btn action-danger {{submitting ? 'is-disabled' : ''}}" bindtap="submitCancel">
      {{submitting ? '提交中...' : '确认取消'}}
    </view>
  </view>
</view>

<!-- ============ 服务项目编辑弹层 ============ -->
<view wx:if="{{showServiceEdit}}" class="sheet-mask" bindtap="closeServiceEdit"></view>
<view class="sheet {{showServiceEdit ? 'sheet-show' : ''}}" catchtap="">
  <view class="sheet-header">
    <text class="sheet-title">编辑服务项目</text>
    <view class="sheet-close" bindtap="closeServiceEdit">✕</view>
  </view>

  <scroll-view scroll-y class="sheet-body">
    <!-- 服务列表（全部展示，用加减控制数量） -->
    <view class="se-service-list">
      <view wx:for="{{editAllServices}}" wx:key="id" class="se-svc-card {{item.quantity > 0 ? 'se-svc-active' : ''}}">
        <view class="se-svc-info">
          <text class="se-svc-name">{{item.name}}</text>
          <text class="se-svc-meta">¥{{item.price}} · {{item.durationMinutes}}分钟</text>
        </view>
        <view class="se-svc-stepper">
          <view class="se-stepper-btn {{item.quantity <= 0 ? 'se-stepper-disabled' : ''}}" bindtap="svcDecrement" data-id="{{item.id}}" role="button" aria-label="减少">-</view>
          <text class="se-stepper-num">{{item.quantity}}</text>
          <view class="se-stepper-btn se-stepper-plus" bindtap="svcIncrement" data-id="{{item.id}}" role="button" aria-label="增加">+</view>
        </view>
      </view>
      <view wx:if="{{editAllServices.length === 0}}" class="se-empty">暂无可选服务</view>
    </view>
  </scroll-view>

  <!-- 预计汇总（强化展示） -->
  <view class="se-summary-bar">
    <view class="se-summary-main">
      <view class="se-summary-item">
        <text class="se-summary-label">预计报价</text>
        <text class="se-summary-price">¥{{editSubtotalFen / 100}}</text>
      </view>
      <view class="se-summary-divider"></view>
      <view class="se-summary-item">
        <text class="se-summary-label">预计时长</text>
        <text class="se-summary-duration">{{editTotalDuration}}分钟</text>
      </view>
    </view>
  </view>

  <view class="sheet-footer">
    <view class="action-btn action-primary {{serviceEditSubmitting ? 'is-disabled' : ''}}" bindtap="submitServiceEdit">
      {{serviceEditSubmitting ? '保存中...' : '保存修改'}}
    </view>
  </view>
</view>

<!-- ============ 报价调整弹层 ============ -->
<view wx:if="{{showEditPrice}}" class="sheet-mask" bindtap="closeEditPrice"></view>
<view class="sheet {{showEditPrice ? 'sheet-show' : ''}}" catchtap="">
  <view class="sheet-header">
    <text class="sheet-title">调整报价</text>
    <view class="sheet-close" bindtap="closeEditPrice">✕</view>
  </view>

  <scroll-view scroll-y class="sheet-body">
    <view class="form-item">
      <text class="form-label">报价金额（元）</text>
      <input class="form-input" type="digit" placeholder="请输入报价金额" value="{{editQuotePrice}}" bindinput="onEditQuotePriceInput" confirm-type="done" />
      <text class="form-hint">服务合计 ¥{{order.serviceSubtotalFen / 100}}，调整后将作为作品标准报价</text>
    </view>

    <view class="form-item">
      <text class="form-label">定金金额（元）</text>
      <input class="form-input" type="digit" placeholder="0" value="{{editDepositAmount}}" bindinput="onEditDepositAmountInput" confirm-type="done" />
    </view>

    <view class="form-item form-item-switch">
      <text class="form-label">定金已支付</text>
      <switch checked="{{editDepositPaid}}" bindchange="onEditDepositPaidChange" color="#FF6B8A"/>
    </view>
  </scroll-view>

  <view class="sheet-footer">
    <view class="action-btn action-primary {{editPriceSubmitting ? 'is-disabled' : ''}}" bindtap="submitEditPrice">
      {{editPriceSubmitting ? '保存中...' : '确认调整'}}
    </view>
  </view>
</view>

<!-- ============ 标记完成确认弹层 ============ -->
<view wx:if="{{showCompleteConfirm}}" class="sheet-mask" bindtap="closeCompleteConfirm"></view>
<view class="sheet {{showCompleteConfirm ? 'sheet-show' : ''}}" catchtap="">
  <view class="sheet-header">
    <text class="sheet-title">确认完成</text>
    <view class="sheet-close" bindtap="closeCompleteConfirm">✕</view>
  </view>

  <scroll-view scroll-y class="sheet-body">
    <view class="form-item">
      <text class="form-label">实际支付金额（元）</text>
      <input class="form-input" type="digit" placeholder="请输入实际支付金额" value="{{completeAmount}}" bindinput="onCompleteAmountInput" confirm-type="done" />
      <text class="form-hint">默认为作品标准报价金额，可按实际调整</text>
    </view>
  </scroll-view>

  <view class="sheet-footer">
    <view class="action-btn action-primary {{completeSubmitting ? 'is-disabled' : ''}}" bindtap="submitComplete">
      {{completeSubmitting ? '提交中...' : '确认完成'}}
    </view>
  </view>
</view>
