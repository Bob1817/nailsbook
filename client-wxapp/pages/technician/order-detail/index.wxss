page { background: linear-gradient(180deg, #fff8fb 0%, #ffffff 34%, #f8f9fc 100%); }

.page {
  min-height: 100vh;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* ===== 加载/空状态 ===== */
.loading-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}
.spinner {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid #ffd8e3;
  border-top-color: #ff6b8a;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 26rpx; color: #9ca3af; }

/* ===== 状态头 ===== */
.status-hero {
  padding: 60rpx 40rpx 48rpx;
  background: linear-gradient(135deg, #ff6b8a 0%, #ff8fa3 50%, #ff8fa3 100%);
  color: #fff;
}
.status-hero.tone-gray   { background: linear-gradient(135deg, #B6B0BE 0%, #9C95A8 100%); }
.status-hero.tone-red    { background: linear-gradient(135deg, #FF7A85 0%, #DC4C58 100%); }
.status-hero.tone-emerald{ background: linear-gradient(135deg, #4ade80 0%, #16a34a 100%); }
.status-hero.tone-sky    { background: linear-gradient(135deg, #60A5FA 0%, #3B82F6 100%); }

.hero-row {
  display: flex; align-items: center; justify-content: space-between;
  gap: 16rpx;
}
.hero-status {
  font-size: 44rpx; font-weight: 700; color: #fff;
  letter-spacing: -1rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.12);
}
.hero-type {
  padding: 8rpx 40rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
}
.hero-order-no {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
}
.hero-desc {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.92);
}

/* ===== 卡片 ===== */
.card {
  margin: 20rpx 40rpx 0;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 24rpx rgba(36, 27, 41, 0.05);
}
.card-overlap { margin-top: -28rpx; }

.card-title {
  display: block;
  font-size: 28rpx; font-weight: 600; color: #1f2937;
  margin-bottom: 20rpx;
}

/* ===== 客户卡 ===== */
.customer-card { padding: 24rpx 40rpx; }
.customer-row { display: flex; align-items: center; gap: 20rpx; }
.cu-avatar {
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  background: #f8dce7;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.cu-avatar-img { width: 100%; height: 100%; }
.cu-avatar-char { font-size: 36rpx; font-weight: 700; color: #ff6b8a; }

.cu-info { flex: 1; min-width: 0; }
.cu-name { display: block; font-size: 32rpx; font-weight: 600; color: #1f2937; }
.cu-phone { display: block; margin-top: 4rpx; font-size: 24rpx; color: #6b7280; }

.cu-actions { display: flex; gap: 12rpx; }
.round-btn {
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  background: #FFF1F6;
  color: #ff6b8a;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx;
}
.round-btn:active { background: #ffe0eb; }

/* ===== 信息行 ===== */
.info-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f0f3;
  gap: 24rpx;
}
.info-row:last-child { border-bottom: none; }

.info-label {
  flex-shrink: 0;
  width: 140rpx;
  font-size: 26rpx;
  color: #6b7280;
}
.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #1f2937;
  line-height: 1.5;
  word-break: break-all;
}
.info-value-block {
  flex: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}
.addr-text {
  flex: 1;
  font-size: 26rpx;
  color: #1f2937;
  line-height: 1.5;
}
.copy-link { min-height: 44rpx;
  flex-shrink: 0;
  padding: 4rpx 40rpx;
  border-radius: 14rpx;
  background: #FFF1F6;
  color: #ff6b8a;
  font-size: 22rpx;
  font-weight: 600;
}
.copy-link:active { background: #ffe0eb; }

/* ===== 价格 ===== */
.price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f0f3;
  margin-bottom: 4rpx;
}
.price-label { font-size: 26rpx; color: #6b7280; }
.price-main {
  font-size: 48rpx; font-weight: 700; color: #ff6b8a;
  letter-spacing: -1rpx;
}

.deposit-state {
  flex-shrink: 0;
  padding: 4rpx 40rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
}
.deposit-paid { background: #e3f6ec; color: #067b4a; }
.deposit-unpaid { background: #fff2dc; color: #c97f1a; }

/* ===== 备注 ===== */
.remark-text {
  display: block;
  padding: 20rpx;
  background: linear-gradient(180deg, #fff8fb 0%, #ffffff 34%, #f8f9fc 100%);
  border-radius: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #374151;
}

/* ===== 底部操作栏 ===== */
.bottom-actions {
  position: fixed;
  left: 0; right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #fff8fb 0%, #ffffff 34%, #f8f9fc 100%);
  padding: 16rpx 40rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.06);
  display: flex;
  gap: 16rpx;
  z-index: 100;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.action-btn:active { opacity: 0.85; }

.action-primary {
  background: linear-gradient(135deg, #ff6b8a 0%, #ff8fa3 100%);
  color: #fff;
  box-shadow: 0 8rpx 16rpx rgba(255, 95, 134, 0.22);
}
.action-ghost {
  background: #FFF1F6;
  color: #ff6b8a;
}
.action-danger {
  background: linear-gradient(180deg, #fff8fb 0%, #ffffff 34%, #f8f9fc 100%);
  color: #dc2626;
  border: 2rpx solid #fee0e2;
}
.is-disabled { opacity: 0.5; }

/* ===== 底部弹层 ===== */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 200;
}

.sheet {
  position: fixed;
  left: 0; right: 0;
  bottom: 0;
  z-index: 201;
  background: #ffffff;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.25s ease-out;
}
.sheet-show { transform: translateY(0); }

.sheet-header {
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f5f0f3;
}
.sheet-title { font-size: 32rpx; font-weight: 600; color: #1f2937; }
.sheet-close {
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  background: #f5f1f3;
  color: #6b7280;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx;
}

.sheet-body {
  padding: 24rpx 40rpx;
  flex: 1;
  max-height: 60vh;
}

.sheet-footer {
  padding: 16rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f5f0f3;
}
.sheet-footer .action-btn { width: 100%; }

/* ===== 表单 ===== */
.form-item { margin-bottom: 28rpx; }
.form-row-2 { display: flex; gap: 16rpx; }
.form-half { flex: 1; min-width: 0; }

.form-label {
  display: block;
  font-size: 26rpx;
  color: #374151;
  margin-bottom: 12rpx;
  font-weight: 500;
}
.required { color: #ff6b8a; }

.form-input  {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #1f2937;
  box-sizing: border-box;
}
.picker-input {
  display: flex;
  align-items: center;
  color: #1f2937;
}
.picker-input:empty::before { content: '请选择'; color: #9ca3af; }

.form-textarea  {
  width: 100%;
  min-height: 140rpx;
  padding: 20rpx 40rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #1f2937;
  box-sizing: border-box;
}

.form-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

/* 取消原因 chips */
.reason-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 4rpx;
}
.reason-chip {
  padding: 10rpx 40rpx;
  border-radius: 999rpx;
  background: #FFF1F6;
  color: #ff6b8a;
  font-size: 24rpx;
}
.reason-chip:active { background: #ffe0eb; }
