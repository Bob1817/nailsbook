page { background: var(--bg-gradient-entry); }

.page {
  min-height: 100vh;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* ===== 加载/空状态 ===== */
.loading-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}
.spinner {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid #ffd8e3;
  border-top-color: var(--brand-primary);
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: var(--font-sm); color: var(--text-muted); }
.load-error { min-height:100vh; box-sizing:border-box; padding:120rpx 48rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; background:#f7f5f6; text-align:center; }
.load-error-mark { width:88rpx; height:88rpx; margin-bottom:28rpx; border-radius:50%; background:#fff0f4; color:#c75b83; font-size: var(--font-xl); line-height:88rpx; }
.load-error-title { color:#382a31; font-size: var(--font-lg); font-weight: var(--weight-semibold); }.load-error-desc { margin-top:12rpx; color:#796872; font-size: var(--font-sm); }
.retry-btn { min-height:88rpx; margin:44rpx 0 0; padding:0 56rpx; border:0; border-radius: var(--radius-xl); background:#1f2937; color: var(--text-inverse); font-size: var(--font-md); line-height:88rpx; }.retry-btn::after { border:0; }

/* ===== 状态头 ===== */
.status-hero {
  padding: 60rpx 40rpx 48rpx;
  background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-primary-light) 50%, var(--brand-primary-light) 100%);
  color: var(--text-inverse);
}
.status-hero.tone-gray   { background: linear-gradient(135deg, #B6B0BE 0%, #9C95A8 100%); }
.status-hero.tone-red    { background: linear-gradient(135deg, #FF7A85 0%, #DC4C58 100%); }
.status-hero.tone-emerald{ background: linear-gradient(135deg, #4ade80 0%, #16a34a 100%); }
.status-hero.tone-sky    { background: linear-gradient(135deg, #60A5FA 0%, #3B82F6 100%); }

.hero-row {
  display: flex; align-items: center; justify-content: space-between;
  gap: 16rpx;
}
.hero-status {
  font-size: var(--font-xl); font-weight: var(--weight-bold); color: var(--text-inverse);
  letter-spacing: -1rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.12);
}
.hero-type {
  padding: 8rpx 40rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  background: rgba(255, 255, 255, 0.16);
  font-size: var(--font-xs);
}
.hero-order-no {
  display: block;
  margin-top: 14rpx;
  font-size: var(--font-xs);
  color: rgba(255, 255, 255, 0.78);
}
.hero-desc {
  display: block;
  margin-top: 18rpx;
  font-size: var(--font-sm);
  line-height: var(--leading-normal);
  color: rgba(255, 255, 255, 0.92);
}

/* ===== 卡片 ===== */
.card {
  margin: 20rpx 40rpx 0;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: 0 12rpx 24rpx rgba(36, 27, 41, 0.05);
}
.card-overlap { margin-top: -28rpx; }

.card-title {
  display: block;
  font-size: var(--font-md); font-weight: var(--weight-semibold); color: var(--text-primary);
  margin-bottom: 20rpx;
}

/* ===== 客户卡 ===== */
.customer-card { padding: var(--space-md) 40rpx; }
.customer-row { display: flex; align-items: center; gap: 20rpx; }
.cu-avatar {
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  background: #f8dce7;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.cu-avatar-img { width: 100%; height: 100%; }
.cu-avatar-char { font-size: var(--font-lg); font-weight: var(--weight-bold); color: var(--brand-primary); }

.cu-info { flex: 1; min-width: 0; }
.cu-name { display: block; font-size: var(--font-lg); font-weight: var(--weight-semibold); color: var(--text-primary); }
.cu-phone { display: block; margin-top: 4rpx; font-size: var(--font-sm); color: var(--text-muted); }

.cu-actions { display: flex; gap: 12rpx; }
.round-btn {
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  background: #FFF1F6;
  color: var(--brand-primary);
  display: flex; align-items: center; justify-content: center;
  font-size: var(--font-lg);
}
.round-btn:active { background: #ffe0eb; }
.btn-icon-phone { width:38rpx; height:38rpx; }

/* ===== 信息行 ===== */
.info-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f0f3;
  gap: 24rpx;
}
.info-row:last-child { border-bottom: none; }
.address-row { align-items: center; }

.info-label {
  flex-shrink: 0;
  width: 140rpx;
  font-size: var(--font-sm);
  color: var(--text-muted);
}
.info-value {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--text-primary);
  line-height: var(--leading-normal);
  word-break: break-all;
}
.info-value-block {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.addr-text {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--text-primary);
  line-height: var(--leading-normal);
}
.copy-link {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.copy-link-label {
  min-width: 68rpx;
  height: 48rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #FFF1F6;
  color: var(--brand-primary);
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
}
.copy-link:active .copy-link-label { background: #ffe0eb; }

/* 编辑按钮 */
.edit-link {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-left: 12rpx;
}
.edit-link-label {
  min-width: 56rpx;
  height: 40rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: rgba(255,107,138,0.08);
  color: var(--brand-primary);
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
}
.edit-link:active .edit-link-label { background: rgba(255,107,138,0.18); }

/* ===== 价格 ===== */
.price-lines { margin-bottom:20rpx; padding-bottom:16rpx; border-bottom:1rpx solid #f0e8ec; }
/* 服务行 */
.price-line { min-height:52rpx; display:flex; align-items:center; justify-content:space-between; gap:20rpx; color:#705d66; font-size:25rpx; }
.price-subtotal { margin-top:8rpx; color:#493841; font-weight:600; }
.price-discount { color:#b93668; }
.price-surcharge { color:#c27a3a; }
.price-edit-arrow { font-size:28rpx; color:#b0a3a8; margin-left:8rpx; }
.price-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex: 1;
  margin-left: 16rpx;
}
.deposit-note {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-xs);
  color: var(--text-muted);
}
.offline-payment-note {
  display: block;
  margin-top: 12rpx;
  font-size: var(--font-xs);
  color: var(--text-muted);
  line-height: var(--leading-normal);
}
.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f0f3;
  margin-bottom: 4rpx;
}
.price-label { font-size: var(--font-sm); color: var(--text-muted); flex-shrink: 0; }
.price-main {
  font-size: var(--font-2xl); font-weight: var(--weight-bold); color: var(--brand-primary);
  letter-spacing: -1rpx;
}
.price-main-wrap {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

/* ===== 备注 ===== */
.remark-text {
  display: block;
  padding: 20rpx;
  background: var(--bg-gradient-entry);
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  line-height: 1.6;
  color: var(--text-body);
}

/* ===== 底部操作栏 ===== */
.bottom-actions {
  position: fixed;
  left: 0; right: 0;
  bottom: 0;
  background: var(--bg-gradient-entry);
  padding: 16rpx 40rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.06);
  display: flex;
  gap: 16rpx;
  z-index: 100;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: var(--btn-radius);
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
}
.action-btn:active { opacity: 0.85; }

.action-primary {
  background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-primary-light) 100%);
  color: var(--text-inverse);
  box-shadow: 0 8rpx 16rpx rgba(255, 95, 134, 0.22);
}
.action-ghost {
  background: #FFF1F6;
  color: var(--brand-primary);
}
.action-danger {
  background: var(--bg-gradient-entry);
  color: var(--text-error);
  border: 2rpx solid #fee0e2;
}
.is-disabled { opacity: 0.5; }
.action-btns-row {
  display: flex;
  gap: 16rpx;
  flex: 1;
}

/* ===== 底部弹层 ===== */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 200;
}

.sheet {
  position: fixed;
  left: 0; right: 0;
  bottom: 0;
  z-index: 201;
  background: var(--bg-card);
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.25s ease-out;
  overflow: hidden;
}
.sheet-show { transform: translateY(0); }

.sheet-header {
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f5f0f3;
}
.sheet-title { font-size: var(--font-lg); font-weight: var(--weight-semibold); color: var(--text-primary); }
.sheet-close {
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  background: #f5f1f3;
  color: var(--text-muted);
  display: flex; align-items: center; justify-content: center;
  font-size: var(--font-md);
}

.sheet-body {
  padding: var(--space-md) 40rpx;
  flex: 1;
  max-height: 60vh;
  overflow-x: hidden;
  box-sizing: border-box;
}

.sheet-footer {
  padding: 16rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f5f0f3;
}
.sheet-footer .action-btn { width: 100%; }

/* ===== 表单 ===== */
.form-item { margin-bottom: 28rpx; }
.form-item-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.form-row-2 { display: flex; gap: 16rpx; }
.form-half { flex: 1; min-width: 0; }

.form-label {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-body);
  margin-bottom: 12rpx;
  font-weight: var(--weight-medium);
}
.required { color: var(--brand-primary); }

.form-input  {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  font-size: var(--font-md);
  color: var(--text-primary);
  box-sizing: border-box;
}
.picker-input {
  display: flex;
  align-items: center;
  color: var(--text-primary);
}
.picker-input:empty::before { content: '请选择'; color: var(--text-muted); }

.form-textarea  {
  width: 100%;
  min-height: 140rpx;
  padding: 20rpx 40rpx;
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  font-size: var(--font-md);
  line-height: var(--leading-normal);
  color: var(--text-primary);
  box-sizing: border-box;
}

.form-hint {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-xs);
  color: var(--text-muted);
}

/* 取消原因 chips */
.reason-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 4rpx;
}
.reason-chip {
  padding: 10rpx 40rpx;
  border-radius: 999rpx;
  background: #FFF1F6;
  color: var(--brand-primary);
  font-size: var(--font-sm);
}
.reason-chip:active { background: #ffe0eb; }
.quote-helper { display:block; margin:8rpx 0 16rpx; color:#897680; font-size:24rpx; line-height:1.5; }
.quote-service-list { display:flex; flex-direction:column; gap:12rpx; }
.quote-service { min-height:92rpx; padding:16rpx 20rpx; border:1rpx solid #e8dfe3; border-radius:16rpx; display:flex; align-items:center; justify-content:space-between; box-sizing:border-box; overflow:hidden; }
.quote-service.selected { border-color:#ec4899; background:#fff7fb; }
.quote-service-name,.quote-service-meta { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:420rpx; }
.quote-service-name { color:#392a31; font-size:27rpx; font-weight:600; }
.quote-service-meta { margin-top:5rpx; color:#826f78; font-size:23rpx; }
.quote-service-check { width:42rpx; height:42rpx; border-radius:50%; background:#ec4899; color:#fff; display:flex; align-items:center; justify-content:center; }
.quote-summary { margin-top:18rpx; padding:20rpx; border-radius:16rpx; background:#f8f4f6; display:flex; flex-direction:column; gap:8rpx; color:#715c66; font-size:24rpx; word-break:break-all; }
.quote-final { color:#c83470; font-size:30rpx; font-weight:700; }

/* ===== 服务项目编辑（加减步进器）===== */
.se-service-list { display: flex; flex-direction: column; gap: 12rpx; }
.se-svc-card {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 20rpx; border-radius: var(--radius-sm);
  background: var(--bg-input); border: 2rpx solid transparent;
  transition: border-color 0.15s;
}
.se-svc-active { border-color: rgba(255,107,138,0.3); background: rgba(255,107,138,0.03); }
.se-svc-info { flex: 1; min-width: 0; }
.se-svc-name { display: block; font-size: var(--font-sm); font-weight: var(--weight-semibold); color: var(--text-primary); }
.se-svc-meta { display: block; font-size: var(--font-xs); color: var(--text-muted); margin-top: 4rpx; }

.se-svc-stepper {
  display: flex; align-items: center; gap: 0; flex-shrink: 0;
  background: var(--bg-page); border-radius: 999rpx; overflow: hidden;
  border: 1rpx solid var(--border-default);
}
.se-stepper-btn {
  width: 60rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: var(--font-md); font-weight: var(--weight-bold);
  color: var(--brand-primary);
}
.se-stepper-btn:active { background: rgba(255,107,138,0.08); }
.se-stepper-disabled { color: var(--text-muted); opacity: 0.4; }
.se-stepper-disabled:active { background: transparent; }
.se-stepper-plus { color: var(--brand-primary); }
.se-stepper-num {
  min-width: 48rpx; text-align: center;
  font-size: var(--font-sm); font-weight: var(--weight-bold); color: var(--text-primary);
  border-left: 1rpx solid var(--border-default);
  border-right: 1rpx solid var(--border-default);
  line-height: 56rpx;
}

/* 预计汇总（强化） */
.se-summary-bar {
  padding: 20rpx 32rpx;
  background: linear-gradient(135deg, #fff0f5, #fef6f8);
  border-top: 1rpx solid rgba(255,107,138,0.12);
}
.se-summary-main {
  display: flex; align-items: center; justify-content: center; gap: 40rpx;
}
.se-summary-item { display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.se-summary-label { font-size: var(--font-xs); color: var(--text-muted); font-weight: var(--weight-medium); }
.se-summary-price {
  font-size: 40rpx; font-weight: var(--weight-bold); color: var(--brand-primary);
  font-variant-numeric: tabular-nums;
}
.se-summary-duration {
  font-size: 32rpx; font-weight: var(--weight-bold); color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}
.se-summary-divider {
  width: 2rpx; height: 60rpx; background: rgba(255,107,138,0.2);
}

.se-empty { padding: 24rpx; text-align: center; font-size: var(--font-sm); color: var(--text-muted); }
