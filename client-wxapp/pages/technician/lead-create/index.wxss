.page{min-height:100vh;background:var(--nb-page);padding:28rpx}.tip,.form{background:var(--nb-surface);border-radius:24rpx;padding:28rpx;margin-bottom:20rpx}.tip{color:var(--nb-secondary)}.form label{display:block;margin:26rpx 0 10rpx;font-weight:600}input,textarea,.field{min-height:88rpx;background:var(--nb-page);border-radius:16rpx;padding:20rpx;box-sizing:border-box}textarea{height:180rpx;width:100%}.primary{min-height:96rpx;margin-top:32rpx;border-radius:48rpx;background:var(--nb-ink);color:var(--nb-surface)}.primary::after{border:0}
@import '../../../styles/booking-actions.wxss';
.primary.booking-action { min-height:44px; height:44px; margin-top:32rpx; border-radius:8px; font-size:var(--font-sm); line-height:1.4; }
.form input,.form textarea,.form .field { font-size:var(--font-sm); border-radius:var(--input-radius); }
.form input,.form .field { min-height:var(--input-height); }
