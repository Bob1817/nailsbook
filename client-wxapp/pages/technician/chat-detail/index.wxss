page {
  background: var(--nb-page);
  height: 100%;
  overflow: hidden;
}

.page {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== 加载中 ===== */
.loading-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-spinner, .sending-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(0, 0, 0, 0.25) /* brand-primary-alpha */;
  border-top-color: var(--brand-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.sending-spinner {
  width: 28rpx;
  height: 28rpx;
  border-width: 3rpx;
  border-color: rgba(255, 255, 255, 0.4);
  border-top-color: var(--text-inverse);
}

@keyframes spin { to { transform: rotate(360deg); } }

/* ===== 日期分隔符 ===== */
.date-separator {
  display: flex;
  justify-content: center;
  padding: 28rpx 0 16rpx;
}

.date-label {
  font-size: var(--font-xs);
  color: var(--text-muted);
  background: rgba(255, 255, 255, 0.8);
  padding: 6rpx 24rpx;
  border-radius: var(--radius-md);
  border: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* ===== 消息列表 ===== */
.msg-list {
  flex: 1;
  min-height: 0;
  padding: 8rpx 0;
}

.empty-chat {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.empty-icon-wrap {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--nb-page);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-md);
}

.empty-icon-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: var(--radius-sm);
  background: var(--brand-gradient);
  opacity: 0.5;
}

.empty-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: var(--font-sm);
  color: var(--text-muted);
  text-align: center;
  line-height: var(--leading-normal);
}

.msg-row {
  display: flex;
  align-items: flex-end;
  padding: 12rpx 28rpx;
  gap: 16rpx;
}

.row-right {
  flex-direction: row-reverse;
}

.row-left {
  flex-direction: row;
}

.msg-avatar {
  flex-shrink: 0;
}

.avatar-img {
  display:block;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: var(--nb-page);
  border: 0;
}

.avatar-placeholder, .avatar-self {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm);
  font-weight: var(--weight-semibold);
  border: 0;
}

.avatar-placeholder {
  background: var(--nb-page);
  color: var(--brand-primary);
}

.avatar-self {
  background: var(--brand-gradient);
  color: var(--text-inverse);
}

.msg-content-wrap {
  max-width: calc(100% - 96rpx);
  display: flex;
  flex-direction: column;
}

.row-right .msg-content-wrap {
  align-items: flex-end;
}

.row-left .msg-content-wrap {
  align-items: flex-start;
}

/* ===== 消息气泡 ===== */
.bubble {
  border-radius: 22rpx;
  padding: 18rpx 24rpx 14rpx;
  word-break: break-word;
  max-width: 100%;
  position: relative;
}

.bubble-right {
  background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-primary-light) 100%);
  border-bottom-right-radius: 8rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.13);
}

.bubble-left {
  background: var(--nb-surface);
  border-bottom-left-radius: 8rpx;
  border: 0;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.07);
}

.bubble-img {
  padding: 8rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 0;
}

.msg-text {
  font-size: var(--font-sm);
  line-height: 1.6;
}

.bubble-right .msg-text {
  color: var(--text-inverse);
}

.bubble-left .msg-text {
  color: var(--text-primary);
}

.msg-image {
  max-width: 360rpx;
  border-radius: var(--radius-sm);
  display: block;
}

/* 时间戳（内嵌在气泡内） */
.msg-time-inline {
  display: block;
  font-size: var(--font-xs);
  margin-top: 10rpx;
  opacity: 0.68;
}

.time-right {
  color: rgba(255, 255, 255, 0.7);
  text-align: right;
}

.time-left {
  color: var(--text-muted);
  text-align: left;
}

.list-bottom {
  height: 0;
}

/* ===== 系统消息 ===== */
.system-msg {
  text-align: center;
  padding: 8rpx 0;
  margin: 4rpx 0;
}

.system-text {
  font-size: var(--font-xs);
  color: var(--text-muted);
  background: rgba(255, 255, 255, 0.7);
  padding: 8rpx 32rpx;
  border-radius: var(--radius-md);
  border: 0;
}

/* ===== 底部输入栏 ===== */
.input-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  background: var(--bg-page);
  border-top: 0;
  gap: 12rpx;
}

.input-field-wrap {
  flex: 1;
  height: 72rpx;
  background: var(--nb-soft-surface);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  border: 0;
}

.input-field {
  width: 100%;
  height: 72rpx;
  font-size: var(--font-md);
  color: var(--text-primary);
  background: transparent;
}

.input-placeholder { color: var(--text-muted); font-size: var(--font-md); }

.send-btn {
  flex-shrink: 0;
  height: 72rpx;
  min-width: 128rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-sm);
  background: var(--nb-page);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.send-btn:active { opacity: 0.92; }

.send-btn-active { background: var(--nb-action); }

.send-btn-text {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  line-height: 1;
  color: var(--text-inverse);
}

.send-btn::after { border: none; }
/* ===== Conversation surface refinement ===== */
.empty-chat { padding: 72rpx 32rpx; }
.empty-chat-card { width: 100%; padding: 48rpx 36rpx; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; border-radius: 28rpx; background: var(--nb-surface); }
.empty-avatar { width: 96rpx; height: 96rpx; margin-bottom: 24rpx; overflow: hidden; border-radius: 50%; background: var(--nb-soft-surface); }
.empty-avatar-image { width: 100%; height: 100%; display: block; }
.empty-title { margin-bottom: 8rpx; font-size: var(--font-md); }
.empty-desc { max-width: 500rpx; font-size: var(--font-xs); }
.empty-actions { width: 100%; margin-top: 32rpx; display: flex; justify-content: center; gap: 16rpx; }
.empty-action { flex: 1; min-width: 0; min-height: 88rpx; padding: 0 24rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; gap: 10rpx; border-radius: var(--radius-md); background: var(--nb-soft-surface); color: var(--nb-secondary); font-size: var(--font-sm); font-weight: var(--weight-medium); }
.empty-action-icon { width: 28rpx; height: 28rpx; }
.empty-action-primary { background: var(--nb-active-surface); color: var(--nb-ink); }
.input-bar { padding-top: 12rpx; background: var(--nb-surface); box-shadow: 0 -6rpx 20rpx rgba(0, 0, 0, .04); }
.input-field-wrap { height: 88rpx; border-radius: 22rpx; }
.input-field { height: 88rpx; font-size: var(--font-sm); }
.input-placeholder { font-size: var(--font-sm); }
.toolbar-icon { width: 32rpx; height: 32rpx; display: block; }
.send-btn { height: 88rpx; min-width: 96rpx; padding: 0 24rpx; border-radius: 22rpx; }
.send-btn-text { font-size: var(--font-sm); font-weight: var(--weight-semibold); color: var(--nb-muted); }
.send-btn-active .send-btn-text { color: var(--nb-inverse); }
.attachment-btn, .booking-btn, .field-add-btn { width: 88rpx; height: 88rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; background: var(--nb-soft-surface); }
.msg-list { padding: 12rpx 0 24rpx; }
.msg-row { padding: 10rpx 28rpx; gap: 14rpx; }
.avatar-img, .avatar-placeholder, .avatar-self { width: 64rpx; height: 64rpx; }
.msg-content-wrap { max-width: 72%; }
.bubble { padding: 16rpx 22rpx 14rpx; border-radius: 20rpx; }
.bubble-left { background: var(--nb-surface); box-shadow: none; }
.bubble-right { background: var(--nb-action); box-shadow: none; }
.msg-text { font-size: var(--font-sm); }
.send-btn-active { background: var(--nb-action); box-shadow: none; }
