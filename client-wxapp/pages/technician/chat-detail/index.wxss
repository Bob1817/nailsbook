page {
  background: linear-gradient(180deg, #FFFDFD 0%, #F8F3F6 46%, #F4F6FB 100%);
  height: 100%;
  overflow: hidden;
}

.page {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== 加载中 ===== */
.loading-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-spinner, .sending-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(255, 107, 138, 0.25);
  border-top-color: #FF6B8A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.sending-spinner {
  width: 28rpx;
  height: 28rpx;
  border-width: 3rpx;
  border-color: rgba(255, 255, 255, 0.4);
  border-top-color: #fff;
}

@keyframes spin { to { transform: rotate(360deg); } }

/* ===== 日期分隔符 ===== */
.date-separator {
  display: flex;
  justify-content: center;
  padding: 28rpx 0 16rpx;
}

.date-label {
  font-size: 22rpx;
  color: #9ca3af;
  background: rgba(255, 255, 255, 0.8);
  padding: 6rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.04);
}

/* ===== 消息列表 ===== */
.msg-list {
  flex: 1;
  min-height: 0;
  padding: 8rpx 0;
}

.empty-chat {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.empty-icon-wrap {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFE2EA 0%, #F4F6FB 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-icon-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  opacity: 0.5;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #9ca3af;
  text-align: center;
  line-height: 1.5;
}

.msg-row {
  display: flex;
  align-items: flex-end;
  padding: 8rpx 32rpx;
  gap: 12rpx;
}

.row-right {
  flex-direction: row-reverse;
}

.row-left {
  flex-direction: row;
}

.msg-avatar {
  flex-shrink: 0;
}

.avatar-img {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f0f0f0;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
}

.avatar-placeholder, .avatar-self {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
}

.avatar-placeholder {
  background: linear-gradient(135deg, #FFE0EA, #F4F7FB);
  color: #FF6B8A;
}

.avatar-self {
  background: linear-gradient(135deg, #FF6B8A 0%, #A78BFA 100%);
  color: #fff;
}

.msg-content-wrap {
  max-width: 72%;
  display: flex;
  flex-direction: column;
}

.row-right .msg-content-wrap {
  align-items: flex-end;
}

.row-left .msg-content-wrap {
  align-items: flex-start;
}

/* ===== 消息气泡 ===== */
.bubble {
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  word-break: break-word;
  max-width: 100%;
  position: relative;
}

.bubble-right {
  background: linear-gradient(135deg, #FF6B8A 0%, #FF8FA3 100%);
  border-bottom-right-radius: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 138, 0.15), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
}

.bubble-left {
  background: rgba(255, 255, 255, 0.9);
  border-bottom-left-radius: 8rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
}

.bubble-img {
  padding: 8rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
}

.msg-text {
  font-size: 28rpx;
  line-height: 1.55;
}

.bubble-right .msg-text {
  color: #fff;
}

.bubble-left .msg-text {
  color: #1f2937;
}

.msg-image {
  max-width: 360rpx;
  border-radius: 16rpx;
  display: block;
}

/* 时间戳（内嵌在气泡内） */
.msg-time-inline {
  display: block;
  font-size: 20rpx;
  margin-top: 8rpx;
  opacity: 0.6;
}

.time-right {
  color: rgba(255, 255, 255, 0.7);
  text-align: right;
}

.time-left {
  color: #9ca3af;
  text-align: left;
}

.list-bottom {
  height: 0;
}

/* ===== 系统消息 ===== */
.system-msg {
  text-align: center;
  padding: 8rpx 0;
  margin: 4rpx 0;
}

.system-text {
  font-size: 22rpx;
  color: #9ca3af;
  background: rgba(255, 255, 255, 0.7);
  padding: 8rpx 32rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
}

/* ===== 预约卡片消息 ===== */
.order-card-msg {
  display: flex;
  border-radius: 20rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  width: 480rpx;
}

.card-right {
  border: 1rpx solid rgba(255, 107, 138, 0.15);
}

.card-accent {
  width: 6rpx;
  flex-shrink: 0;
  background: linear-gradient(180deg, #FF6B8A 0%, #A78BFA 100%);
}

.card-inner {
  flex: 1;
  padding: 24rpx;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.card-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #1f2937;
}

.card-content {
  font-size: 24rpx;
  color: #374151;
  line-height: 1.6;
  display: block;
  white-space: pre-line;
}

.card-action {
  font-size: 24rpx;
  color: #FF6B8A;
  font-weight: 500;
  margin-top: 12rpx;
  display: block;
}

/* ===== 底部输入栏 ===== */
.input-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  background: #f7f7f7;
  border-top: 1rpx solid #efefef;
  gap: 12rpx;
}

.input-field-wrap {
  flex: 1;
  height: 72rpx;
  background: #ffffff;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  border: 1rpx solid #e5e5e5;
}

.input-field {
  width: 100%;
  height: 72rpx;
  font-size: 28rpx;
  color: #1f2937;
  background: transparent;
}

.input-placeholder { color: #9ca3af; font-size: 28rpx; }

.send-btn {
  flex-shrink: 0;
  height: 72rpx;
  min-width: 128rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #c9c9c9;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.send-btn:active { opacity: 0.92; }

.send-btn-active { background: #07c160; }

.send-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  color: #ffffff;
}

.send-btn::after { border: none; }
