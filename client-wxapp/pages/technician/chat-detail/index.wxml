<nav-bar title="{{clientName || '对话'}}" showBack titleCenter/>
<view class="page" style="top: {{chatNavHeight}}px; bottom: {{keyboardHeight > 0 ? keyboardHeight : 0}}px;">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
  </view>

  <!-- 消息列表 -->
  <scroll-view
    wx:else
    scroll-y
    class="msg-list"
    scroll-into-view="{{scrollToId}}"
    scroll-with-animation
    enhanced
    show-scrollbar="{{false}}"
    bindscroll="onScroll"
  >
    <view wx:if="{{groupedMessages.length === 0}}" class="empty-chat">
      <view class="empty-icon-wrap">
        <view class="empty-icon-dot"></view>
      </view>
      <text class="empty-title">开始和{{clientName || '客户'}}沟通</text>
      <text class="empty-desc">把报价、到店安排、款式参考发给客户</text>
    </view>

    <block wx:for="{{groupedMessages}}" wx:key="date" wx:for-item="group">
      <!-- 日期分隔符 -->
      <view class="date-separator">
        <text class="date-label">{{group.dateLabel}}</text>
      </view>

      <!-- 该日期下的消息 -->
      <view wx:for="{{group.messages}}" wx:key="id" wx:for-item="item" id="msg-{{item.id}}" class="msg-row {{item.isMe ? 'row-right' : 'row-left'}}">
        <!-- 对方头像 -->
        <view wx:if="{{!item.isMe}}" class="msg-avatar">
          <image wx:if="{{clientAvatar && !clientAvatarFailed}}" class="avatar-img" src="{{clientAvatar}}" mode="aspectFill" lazy-load binderror="onClientAvatarError" aria-label="{{clientName || '客户'}}的头像" />
          <view wx:else class="avatar-placeholder"><text>{{clientName[0] || '客'}}</text></view>
        </view>

        <view class="msg-content-wrap">
          <!-- 系统消息 -->
          <view wx:if="{{item.isSystem && !item.isOrderCard}}" class="system-msg">
            <text class="system-text">{{item.content}}</text>
          </view>

          <!-- 预约/预约卡片消息 -->
          <technician-booking-card wx:elif="{{item.isOrderCard}}" order="{{item.bookingCard}}" variant="message" bind:open="onBookingCardOpen" />

          <!-- 图片消息 -->
          <view wx:elif="{{item.messageType === 'image' && item.imageUrl}}" class="bubble bubble-{{item.isMe ? 'right' : 'left'}} bubble-img" bindtap="previewImage" data-url="{{item.imageUrl}}">
            <image src="{{item.imageUrl}}" mode="widthFix" class="msg-image" lazy-load aria-label="聊天图片" />
          </view>

          <!-- 文字消息 -->
          <view wx:else class="bubble bubble-{{item.isMe ? 'right' : 'left'}}">
            <text class="msg-text">{{item.content}}</text>
            <text class="msg-time-inline {{item.isMe ? 'time-right' : 'time-left'}}">{{item.timeStr}}</text>
          </view>
        </view>

        <!-- 自己头像 -->
        <view wx:if="{{item.isMe}}" class="msg-avatar">
          <view class="avatar-self"><text>我</text></view>
        </view>
      </view>
    </block>

    <!-- 底部间距：键盘弹出时留 12px，否则 0（safe-area 由输入栏处理） -->
    <view class="list-bottom" style="height: {{keyboardHeight > 0 ? 12 : 0}}px;"></view>
  </scroll-view>

  <!-- 底部输入栏：键盘弹出时 fixed 到键盘上方 -->
  <view class="input-bar {{keyboardHeight > 0 ? 'input-bar-keyboard' : ''}}" style="bottom: {{keyboardHeight > 0 ? keyboardHeight : 0}}px;">
    <view class="input-field-wrap">
      <input
        class="input-field"
        type="text"
        value="{{inputText}}"
        bindinput="onInputChange"
        placeholder="发消息..."
        placeholder-class="input-placeholder"
        confirm-type="send"
        bindconfirm="sendText"
        bindfocus="onInputFocus"
        cursor-spacing="16"
        bindkeyboardheightchange="onKeyboardChange"
        adjust-position="{{false}}"
      />
    </view>
    <view class="send-btn {{inputText.length > 0 ? 'send-btn-active' : ''}}" bindtap="sendText">
      <text wx:if="{{!sending}}" class="send-btn-text">发送</text>
      <text wx:else class="send-btn-text">发送中</text>
    </view>
  </view>
</view>
