.container { min-height: 100vh; background: linear-gradient(180deg, #fff8fb 0%, #ffffff 34%, #f8f9fc 100%); padding: 80rpx 40rpx 40rpx; }
.header { margin-bottom: 60rpx; }
.logo-circle { width: 96rpx; height: 96rpx; border-radius: 24rpx; background: linear-gradient(135deg, #ff6b8a, #8b5cf6); color: #fff; font-size: 40rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; margin-bottom: 32rpx; box-shadow: 0 8rpx 24rpx rgba(255,104,137,0.3); }
.title { display: block; font-size: 48rpx; font-weight: 700; color: #1f2937; margin-bottom: 12rpx; }
.subtitle { display: block; font-size: 26rpx; color: #6b7280; }
.form { background: linear-gradient(180deg, #fff8fb 0%, #ffffff 34%, #f8f9fc 100%); border-radius: 28rpx; padding: 32rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04); }
.phone-display { background: linear-gradient(180deg, #fff8fb 0%, #ffffff 34%, #f8f9fc 100%); border-radius: 14rpx; padding: 24rpx; margin-bottom: 24rpx; font-size: 28rpx; color: #374151; }
.form-item { margin-bottom: 28rpx; }
.label { display: block; font-size: 26rpx; color: #374151; margin-bottom: 12rpx; }
.input  { width: 100%; height: 88rpx; border: 2rpx solid #ece8ec; border-radius: 14rpx; padding: 0 24rpx; font-size: 28rpx; box-sizing: border-box;  background: #f9fafb;}
.code-row { display: flex; gap: 16rpx; align-items: center; }
.code-input { flex: 1; min-width: 0; }
.code-btn { width: 220rpx; min-height: 88rpx; margin: 0; padding: 0 16rpx; border-radius: 14rpx; color: #ff6b8a; background: #fff1f5; font-size: 26rpx; display: flex; align-items: center; justify-content: center; }
.error-text { display: block; text-align: center; font-size: 26rpx; color: #dc2626; margin: 16rpx 0; }
.btn-primary { width: 100%; height: 88rpx; border-radius: 48rpx; background: linear-gradient(135deg, #ff6b8a, #8b5cf6); color: #fff; font-size: 30rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; border: none; margin-top: 16rpx; box-shadow: 0 8rpx 24rpx rgba(255,99,110,0.3); }
.btn-primary:active { opacity: 0.85; }
.btn-primary[disabled] { opacity: 0.5; }
