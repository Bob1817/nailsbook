<nav-bar title="设置密码" showBack/>
<view class="container">
  <view class="header">
    <view class="logo-circle">N</view>
    <text class="title">设置登录密码</text>
    <text class="subtitle">首次登录请设置登录密码，密码至少 8 位，需包含字母和数字</text>
  </view>

  <view class="form">
    <view wx:if="{{phone}}" class="phone-display">
      <text>手机号：{{phone}}</text>
    </view>
    <view class="form-item">
      <text class="label">设置新密码</text>
      <input class="input" type="text" password placeholder="至少 8 位，含字母和数字"
        value="{{newPassword}}" bindinput="onNewPwdInput" confirm-type="done" />
    </view>
    <view class="form-item">
      <text class="label">确认新密码</text>
      <input class="input" type="text" password placeholder="再次输入新密码"
        value="{{confirmPassword}}" bindinput="onConfirmPwdInput" confirm-type="done" />
    </view>

    <text wx:if="{{error}}" class="error-text">{{error}}</text>

    <block wx:if="{{phone}}">
      <button wx:if="{{wechatAvailable}}" class="btn-primary wechat-set-btn" open-type="getPhoneNumber" bindgetphonenumber="onWechatPhone" loading="{{loading}}" disabled="{{loading}}">
        {{loading ? '设置中...' : '微信授权设置并登录'}}
      </button>
      <view wx:elif="{{!wechatChecking}}" class="fallback-card">
        <text class="fallback-text">当前环境暂不支持微信授权验证，请联系客服协助设置密码</text>
        <button class="contact-btn" open-type="contact" show-message-card="true" send-message-title="首次设置密码">联系客服</button>
      </view>
    </block>
    <button wx:else class="btn-primary booking-action" bindtap="handleSubmit" disabled="{{loading}}">
      {{loading ? '设置中...' : '确认设置并登录'}}
    </button>
  </view>
</view>
