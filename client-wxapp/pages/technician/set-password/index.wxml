<nav-bar title="设置密码" showBack/>
<view class="container">
  <view class="header">
    <view class="logo-circle">N</view>
    <text class="title">设置登录密码</text>
    <text class="subtitle">首次登录请设置登录密码，密码至少 8 位，需包含字母和数字</text>
  </view>

  <view class="form">
    <view wx:if="{{phone}}" class="phone-display">
      <text>手机号：{{phone}}</text>
    </view>
    <view wx:if="{{phone}}" class="form-item">
      <text class="label">短信验证码</text>
      <view class="code-row">
        <input class="input code-input" type="number" maxlength="6" placeholder="请输入验证码"
          value="{{code}}" bindinput="onCodeInput" confirm-type="done" />
        <button class="code-btn booking-action" bindtap="handleSendCode" disabled="{{sending || countdown > 0}}">
          {{countdown > 0 ? countdown + 's' : sending ? '发送中' : '发送验证码'}}
        </button>
      </view>
    </view>
    <view class="form-item">
      <text class="label">设置新密码</text>
      <input class="input" type="text" password placeholder="至少 8 位，含字母和数字"
        value="{{newPassword}}" bindinput="onNewPwdInput" confirm-type="done" />
    </view>
    <view class="form-item">
      <text class="label">确认新密码</text>
      <input class="input" type="text" password placeholder="再次输入新密码"
        value="{{confirmPassword}}" bindinput="onConfirmPwdInput" confirm-type="done" />
    </view>

    <text wx:if="{{error}}" class="error-text">{{error}}</text>

    <button class="btn-primary booking-action" bindtap="handleSubmit" disabled="{{loading}}">
      {{loading ? '设置中...' : '确认设置并登录'}}
    </button>
  </view>
</view>
