@import '../../../styles/tokens.wxss';
@import '../../../styles/booking-actions.wxss';

page { background: var(--bg-page); }
.page {
  box-sizing: border-box;
  padding: var(--space-md) var(--space-lg) calc(200rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
}

/* ===== Section Cards ===== */
.section {
  background: rgba(255,255,255,0.88);
  border-radius: var(--radius-md);
  padding: var(--space-lg);
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-md), 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
}
.section-head { margin-bottom: var(--space-md); }
.section-title { display: block; font-size: var(--font-md); font-weight: var(--weight-semibold); color: var(--text-primary); }

.current-value {
  display: block;
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--nb-ink);
  line-height: var(--leading-normal);
}
.summary-line { display:block; margin-top:10rpx; color:var(--nb-secondary); font-size:var(--font-sm); line-height:1.5; }
.field-group { margin-bottom:var(--space-md); }
.field-group-last { margin-bottom:0; }
.field-label { display:block; margin-bottom:12rpx; color:var(--nb-secondary); font-size:var(--font-sm); font-weight:var(--weight-medium); }
.field-input,.field-textarea { width:100%; box-sizing:border-box; border-radius:var(--input-radius); background:var(--nb-soft-surface); color:var(--nb-ink); font-size:var(--font-sm); }
.field-input { min-height:44px; padding:0 var(--input-padding-h); }
.field-textarea { min-height:176rpx; padding:20rpx var(--input-padding-h); line-height:1.5; }

/* ===== Submit Bar ===== */
.submit-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: rgba(255, 255, 255, 0.86);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  backdrop-filter: blur(20px) saturate(180%);
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.04);
  padding: 20rpx var(--space-lg) calc(20rpx + env(safe-area-inset-bottom));
  z-index: 50;
}
.submit-btns {
  display: flex; gap: var(--space-sm);
}
.submit-btn {
  flex: 1; text-align: center; padding: 12rpx var(--space-sm);
}
.submit-btn-save {
  background: var(--nb-action); color: var(--nb-inverse);
  box-shadow: none;
}
.submit-btn-save:active { opacity: 0.85; }
.submit-btn-cancel {
  background: var(--nb-soft-surface); color: var(--nb-secondary);
}
.submit-btn-cancel:active { opacity: 0.85; }
.btn-disabled { opacity: 0.5; pointer-events: none; }
