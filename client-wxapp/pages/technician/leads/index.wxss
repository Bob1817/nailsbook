.page{min-height:100vh;background:var(--nb-page);padding:24rpx 24rpx 160rpx}.toolbar{display:flex;gap:12rpx;align-items:center;margin-bottom:20rpx}.filter,.add{min-height:88rpx;line-height:88rpx;padding:0 22rpx;background:var(--nb-surface);border-radius:18rpx;font-size:26rpx}.add{margin:0 0 0 auto;background:var(--nb-ink);color:var(--nb-surface);border:0}.add::after{border:0}.card{background:var(--nb-surface);padding:28rpx;border-radius:24rpx;margin-bottom:18rpx}.head{display:flex;justify-content:space-between}.name{font-size:32rpx;font-weight:700}.status{color:var(--nb-secondary)}.status-new,.status-following_up{color:var(--nb-text-link)}.status-won{color:var(--nb-success)}.status-lost{color:var(--nb-danger)}.status-paused{color:var(--nb-secondary)}.source,.need,.follow{display:block;margin-top:12rpx;color:var(--nb-secondary)}.need{color:var(--nb-ink)}.overdue{color:var(--nb-danger);font-weight:600}.empty{text-align:center;padding:120rpx 0;color:var(--nb-muted)}
@import '../../../styles/booking-actions.wxss';
.add.booking-action { min-height:44px; height:44px; line-height:1.4; padding:0 24rpx; border-radius:8px; font-size:var(--font-sm); }
