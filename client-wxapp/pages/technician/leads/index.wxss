.page{min-height:100vh;background:#f7f5f2;padding:24rpx 24rpx 160rpx}.toolbar{display:flex;gap:12rpx;align-items:center;margin-bottom:20rpx}.filter,.add{min-height:88rpx;line-height:88rpx;padding:0 22rpx;background:#fff;border-radius:18rpx;font-size:26rpx}.add{margin:0 0 0 auto;background:#211b18;color:#fff;border:0}.add::after{border:0}.card{background:#fff;padding:28rpx;border-radius:24rpx;margin-bottom:18rpx}.head{display:flex;justify-content:space-between}.name{font-size:32rpx;font-weight:700}.status{color:#9b6155}.source,.need,.follow{display:block;margin-top:12rpx;color:#716864}.need{color:#332b27}.overdue{color:#c64141;font-weight:600}.empty{text-align:center;padding:120rpx 0;color:#8b817c}
