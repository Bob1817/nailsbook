<nav-bar title="咨询线索" showBack/><view class="page"><view class="toolbar"><picker range="{{statusOptions}}" range-key="1" data-field="status" bindchange="filter"><view class="filter">状态筛选</view></picker><picker range="{{sourceOptions}}" range-key="1" data-field="source" bindchange="filter"><view class="filter">来源筛选</view></picker><button class="add booking-action" bindtap="create">+ 快速录入</button></view><view wx:if="{{loading}}" class="empty">加载中…</view><view wx:elif="{{!items.length}}" class="empty">暂无线索</view><view wx:for="{{items}}" wx:key="id" class="card" bindtap="detail" data-id="{{item.id}}"><view class="head"><text class="name">{{item.nickname || item.contact || '匿名咨询'}}</text><text class="status status-{{item.status}}">{{item.statusText}}</text></view><text class="source">{{item.sourceText}}{{item.sourceWork ? ' · ' + item.sourceWork.title : ''}}</text><text class="need">{{item.requirement || '尚未填写具体需求'}}</text><text class="follow {{item.due ? 'overdue' : ''}}">{{item.due ? '已逾期 · ' : '下次跟进 · '}}{{item.followText}}</text></view></view><tab-bar selected="customers"/>
