<nav-bar title="重置密码" showBack/>
<view class="page">
  <secondary-page-header title="重置密码" subtitle="通过微信手机号授权验证后重置登录密码" />
  <view class="container">
  <view class="form">
    <view class="field"><text class="label">手机号</text><input class="input" type="number" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" placeholder="请输入手机号" placeholder-class="ph" confirm-type="done" /></view>
    <view class="field"><text class="label">新密码</text><input class="input" password value="{{newPassword}}" bindinput="onNewPasswordInput" placeholder="至少8位，含字母和数字" placeholder-class="ph" confirm-type="done" /></view>
    <view class="field"><text class="label">确认密码</text><input class="input" password value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" placeholder="再次输入新密码" placeholder-class="ph" confirm-type="done" /></view>
  </view>

  <button wx:if="{{wechatAvailable}}" class="submit-btn wechat-submit" open-type="getPhoneNumber" bindgetphonenumber="onWechatPhone" loading="{{submitting}}" disabled="{{submitting}}">
    <text>{{submitting ? '提交中...' : '微信授权重置'}}</text>
  </button>
  <view wx:elif="{{!wechatChecking}}" class="fallback-card">
    <text class="fallback-text">当前环境暂不支持微信授权验证，请联系客服协助重置密码</text>
    <button class="contact-btn" open-type="contact" show-message-card="true" send-message-title="找回密码">联系客服</button>
  </view>
</view>
</view>
