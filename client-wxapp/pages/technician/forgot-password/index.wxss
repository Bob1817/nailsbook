.page { min-height: 100vh; background: var(--nb-page); color: var(--nb-ink); }
.container { padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.form { padding: 28rpx; background: var(--nb-surface); border-radius: 24rpx; overflow: hidden; margin-bottom: 24rpx; }
.field { padding: 20rpx 0; border-bottom: none; }
.field:last-child { border-bottom: none; }
.label { display: block; font-size: var(--font-sm); color: var(--text-body); margin-bottom: 12rpx; }
.input  { width:100%; height:92rpx; padding:0 24rpx; box-sizing:border-box; font-size: var(--font-md); color: var(--text-primary); background:rgba(255,255,255,.96); border: 0; border-radius: var(--radius-sm); box-shadow:0 2rpx 8rpx rgba(0, 0, 0, .035); transition:border-color 180ms ease,box-shadow 180ms ease,background-color 180ms ease;}
.input:focus { background: var(--bg-card); border-color:var(--nb-link); box-shadow:0 0 0 6rpx rgba(0, 0, 0, .08); }
.code-row { display: flex; gap: 16rpx; align-items: center; }
.code-input { flex: 1; min-width: 0; }
.code-btn { width: 220rpx; min-height: 92rpx; border: 0; border-radius: var(--radius-sm); color:var(--nb-ink); background:var(--nb-page); font-size: var(--font-sm); display:flex; align-items:center; justify-content:center; }
.ph { color: var(--text-muted); }
.submit-btn { background: var(--brand-gradient); color: var(--text-inverse); font-size: var(--font-md); font-weight: var(--weight-semibold); text-align: center; padding: 28rpx; border-radius: var(--btn-radius); box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3) /* brand-primary-alpha */; }
.submit-btn:active { opacity: 0.85; }
.btn-disabled { opacity: 0.6; }

@import '../../../styles/booking-actions.wxss';
.input { height: var(--input-height); min-height: 44px; background: var(--bg-input); border-radius: var(--input-radius); font-size: var(--font-sm); }
.code-btn.booking-action { width: 112px; min-height: 44px; height: var(--control-hit-height); border-radius: 8px; font-size: var(--font-sm); }
.submit-btn.booking-action { min-height: 44px; padding: 0 24rpx; border-radius: 8px; font-size: var(--font-sm); box-shadow: none; }
