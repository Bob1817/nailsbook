.page { min-height: 100vh; background: var(--nb-page); color: var(--nb-ink); }
.container { padding: var(--space-md) var(--space-lg) calc(var(--space-xl) + env(safe-area-inset-bottom)); box-sizing: border-box; }
.form { padding: 28rpx; background: var(--nb-surface); border-radius: var(--radius-lg); overflow: hidden; margin-bottom: var(--space-md); }
.field { padding: 20rpx 0; border-bottom: none; }
.field:last-child { border-bottom: none; }
.label { display: block; font-size: var(--font-sm); color: var(--text-body); margin-bottom: 12rpx; }
.input  { width:100%; height:92rpx; padding:0 var(--space-md); box-sizing:border-box; font-size: var(--font-md); color: var(--text-primary); background:rgba(255,255,255,.96); border: 0; border-radius: var(--radius-sm); box-shadow:0 2rpx 8rpx rgba(0, 0, 0, .035); transition:border-color 180ms ease,box-shadow 180ms ease,background-color 180ms ease;}
.input:focus { background: var(--bg-card); border-color:var(--nb-link); box-shadow:0 0 0 6rpx rgba(0, 0, 0, .08); }
.ph { color: var(--text-muted); }
.submit-btn { background: var(--brand-gradient); color: var(--text-inverse); font-size: var(--font-md); font-weight: var(--weight-semibold); text-align: center; padding: 28rpx; border-radius: var(--btn-radius); box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3) /* brand-primary-alpha */; }
.submit-btn:active { opacity: 0.85; }
.btn-disabled { opacity: 0.6; }
.wechat-submit { width: 100%; box-sizing: border-box; display: flex; align-items: center; justify-content: center; }
.wechat-submit::after { border: none; }
.wechat-submit[disabled] { opacity: 0.6; }

.fallback-card {
  background: var(--nb-surface);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-md);
}
.fallback-text { font-size: var(--font-sm); color: var(--text-muted); text-align: center; line-height: 1.6; }
.contact-btn {
  min-height: 88rpx;
  padding: 0 var(--space-2xl);
  border: 0;
  border-radius: var(--radius-lg);
  background: var(--nb-soft-surface);
  color: var(--nb-ink);
  font-size: var(--font-sm);
  font-weight: var(--weight-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
}
.contact-btn::after { border: none; }

@import '../../../styles/booking-actions.wxss';
.input { height: var(--input-height); min-height: 44px; background: var(--bg-input); border-radius: var(--input-radius); font-size: var(--font-sm); }
.wechat-submit.booking-action { min-height: 44px; padding: 0 var(--space-md); border-radius: 8px; font-size: var(--font-sm); box-shadow: none; }
