.container { min-height: 100vh; background: linear-gradient(180deg, #fff8fb 0%, #ffffff 34%, #f8f9fc 100%); padding: 60rpx 40rpx 40rpx; }
.header { margin-bottom: 48rpx; }
.title { display: block; font-size: 48rpx; font-weight: 700; color: #1f2937; margin-bottom: 12rpx; }
.subtitle { display: block; font-size: 28rpx; color: #9ca3af; }
.form { background: linear-gradient(180deg, #fff8fb 0%, #ffffff 34%, #f8f9fc 100%); border-radius: 24rpx; overflow: hidden; margin-bottom: 40rpx; }
.field { padding: 28rpx 40rpx; border-bottom: 1rpx solid #f5f5f5; }
.field:last-child { border-bottom: none; }
.label { display: block; font-size: 26rpx; color: #374151; margin-bottom: 12rpx; }
.input  { width: 100%; font-size: 28rpx; color: #1f2937; height: 88rpx;  background: #f9fafb; border-radius: 14rpx;}
.ph { color: #9ca3af; }
.submit-btn { background: linear-gradient(135deg, #ff6b8a, #8b5cf6); color: #fff; font-size: 30rpx; font-weight: 600; text-align: center; padding: 28rpx; border-radius: 48rpx; box-shadow: 0 8rpx 24rpx rgba(255,107,138,0.3); }
.submit-btn:active { opacity: 0.85; }
.btn-disabled { opacity: 0.6; }
