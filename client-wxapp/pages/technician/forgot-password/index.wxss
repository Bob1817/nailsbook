.container { min-height: 100vh; background: var(--bg-gradient-entry); padding: 60rpx 40rpx 40rpx; }
.header { margin-bottom: 48rpx; }
.title { display: block; font-size: var(--font-2xl); font-weight: var(--weight-bold); color: var(--text-primary); margin-bottom: 12rpx; }
.subtitle { display: block; font-size: var(--font-md); color: var(--text-muted); }
.form { background: transparent; border-radius: var(--radius-md); overflow: hidden; margin-bottom: 40rpx; }
.field { padding: 20rpx 0; border-bottom: none; }
.field:last-child { border-bottom: none; }
.label { display: block; font-size: var(--font-sm); color: var(--text-body); margin-bottom: 12rpx; }
.input  { width:100%; height:92rpx; padding:0 24rpx; box-sizing:border-box; font-size: var(--font-md); color: var(--text-primary); background:rgba(255,255,255,.96); border:2rpx solid #ddd7dc; border-radius: var(--radius-sm); box-shadow:0 2rpx 8rpx rgba(64,43,54,.035); transition:border-color 180ms ease,box-shadow 180ms ease,background-color 180ms ease;}
.input:focus { background: var(--bg-card); border-color:#b5537b; box-shadow:0 0 0 6rpx rgba(181,83,123,.08); }
.code-row { display: flex; gap: 16rpx; align-items: center; }
.code-input { flex: 1; min-width: 0; }
.code-btn { width: 220rpx; min-height: 92rpx; border:2rpx solid #f0d8e2; border-radius: var(--radius-sm); color:#b5537b; background:#fff4f7; font-size: var(--font-sm); display:flex; align-items:center; justify-content:center; }
.ph { color: var(--text-muted); }
.submit-btn { background: var(--brand-gradient); color: var(--text-inverse); font-size: var(--font-md); font-weight: var(--weight-semibold); text-align: center; padding: 28rpx; border-radius: var(--btn-radius); box-shadow: 0 8rpx 24rpx rgba(255,107,138,0.3) /* brand-primary-alpha */; }
.submit-btn:active { opacity: 0.85; }
.btn-disabled { opacity: 0.6; }
