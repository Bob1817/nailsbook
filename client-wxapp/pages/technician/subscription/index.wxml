<nav-bar title="订阅套餐" showBack/>
<view class="container">


  <view wx:if="{{loading}}" class="loading-wrap"><view class="loading-spinner"></view></view>

  <view wx:elif="{{loadFailed}}" class="load-error" aria-live="polite">
    <view class="load-error-mark">!</view>
    <text class="empty-text">套餐信息加载失败</text>
    <text class="empty-sub">请检查网络后重试</text>
    <button class="retry-btn" bindtap="loadSubscription">重新加载</button>
  </view>

  <view wx:else>
    <!-- 当前套餐 -->
    <view class="card current-card">
      <text class="current-label">当前套餐</text>
      <text class="current-name">{{currentPlan ? currentPlan.planName || '基础版' : '免费试用'}}</text>
      <text wx:if="{{currentPlan && currentPlan.expiresAt}}" class="current-expire">到期时间：{{currentPlan.expiresAt}}</text>
      <text class="current-mode">当前版本暂不支持小程序内付款，升级请联系平台客服确认套餐。</text>
    </view>

    <!-- 可选套餐 -->
    <view wx:if="{{plans.length > 0}}">
      <view class="section-header">
        <text class="section-title">可选套餐</text>
      </view>
      <view wx:for="{{plans}}" wx:key="id" class="plan-card">
        <view class="plan-info">
          <text class="plan-name">{{item.name}}</text>
          <text class="plan-price">¥{{item.price}}<text class="plan-cycle">/{{item.cycle || '月'}}</text></text>
          <text wx:if="{{item.description}}" class="plan-desc">{{item.description}}</text>
        </view>
        <button class="plan-btn" open-type="contact" show-message-card="true" send-message-title="咨询{{item.name}}套餐">
          <text>了解升级</text>
        </button>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:else class="empty">
      <view class="empty-icon"><view class="empty-icon-ring"></view></view>
      <text class="empty-text">暂无可选套餐</text>
      <text class="empty-sub">请联系平台了解套餐详情</text>
      <button class="contact-btn" open-type="contact" show-message-card="true" send-message-title="咨询订阅套餐">联系客服</button>
    </view>
  </view>
</view>
