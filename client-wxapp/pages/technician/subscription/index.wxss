.container {
  min-height: 100vh;
  background: #f6f7f9;
  padding-bottom: 140rpx;
}

/* ===== 加载 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #FF6B8A;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ===== 当前套餐卡片 ===== */
.current-card {
  margin: 0 24rpx 20rpx;
  background: linear-gradient(135deg, #ff6b8a, #a855f7);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 138, 0.25);
}
.current-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 8rpx;
}
.current-name {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}
.current-expire {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ===== 区块标题 ===== */
.section-header {
  padding: 16rpx 24rpx 12rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

/* ===== 套餐卡片 ===== */
.plan-card {
  margin: 0 24rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.plan-info {
  flex: 1;
  min-width: 0;
}
.plan-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.3;
  margin-bottom: 8rpx;
}
.plan-price {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #ff6b8a;
  margin-bottom: 6rpx;
}
.plan-cycle {
  font-size: 24rpx;
  font-weight: normal;
  color: #9ca3af;
}
.plan-desc {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
}
.plan-btn {
  height: 64rpx;
  padding: 0 32rpx;
  background: rgba(255, 107, 138, 0.08);
  color: #ff6b8a;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.plan-btn:active {
  opacity: 0.65;
}

/* ===== 空状态 ===== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx 80rpx;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 32rpx;
}
.empty-text {
  font-size: 32rpx;
  color: #374151;
  margin-bottom: 12rpx;
}
.empty-sub {
  font-size: 26rpx;
  color: #9ca3af;
  margin-bottom: 56rpx;
}
.contact-btn {
  height: 88rpx;
  padding: 0 72rpx;
  background: linear-gradient(135deg, #ff6b8a, #a855f7);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}
.contact-btn:active {
  opacity: 0.85;
}
