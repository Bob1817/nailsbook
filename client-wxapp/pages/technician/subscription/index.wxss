.container { min-height: 100vh; background: #f5f5f5; padding: 32rpx; }
.loading-wrap { display: flex; justify-content: center; padding: 200rpx 0; }
.loading-spinner { width: 60rpx; height: 60rpx; border: 4rpx solid #FF6B8A; border-top-color: transparent; border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.current-plan { background: linear-gradient(135deg, #FF6B8A, #FF8FA3); border-radius: 24rpx; padding: 40rpx; margin-bottom: 32rpx; }
.plan-label { display: block; font-size: 24rpx; color: rgba(255,255,255,0.7); margin-bottom: 8rpx; }
.plan-name { display: block; font-size: 40rpx; font-weight: 700; color: #fff; margin-bottom: 8rpx; }
.plan-expire { display: block; font-size: 24rpx; color: rgba(255,255,255,0.8); }
.section-title { display: block; font-size: 28rpx; font-weight: 600; color: #1a1a1a; margin-bottom: 16rpx; }
.plan-card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 16rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.plan-info { flex: 1; }
.plan-card-name { display: block; font-size: 30rpx; font-weight: 600; color: #1a1a1a; margin-bottom: 8rpx; }
.plan-price { display: block; font-size: 36rpx; font-weight: 700; color: #FF6B8A; margin-bottom: 6rpx; }
.plan-cycle { font-size: 24rpx; font-weight: normal; color: #999; }
.plan-desc { display: block; font-size: 24rpx; color: #666; }
.upgrade-btn { background: #FF6B8A; color: #fff; font-size: 26rpx; padding: 16rpx 28rpx; border-radius: 20rpx; flex-shrink: 0; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 80rpx; }
.empty-text { font-size: 28rpx; color: #666; margin-bottom: 32rpx; }
.contact-btn { background: linear-gradient(135deg, #FF6B8A, #FF8FA3); color: #fff; font-size: 28rpx; padding: 20rpx 60rpx; border-radius: 40rpx; }
