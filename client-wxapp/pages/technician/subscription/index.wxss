.container {
  min-height: 100vh;
  background: var(--nb-page);
  padding-bottom: 140rpx;
}

/* ===== 加载 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--brand-primary);
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ===== 当前套餐卡片 ===== */
.current-card {
  margin: 0 24rpx 20rpx;
  background: var(--nb-action);
  border-radius: var(--radius-md);
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.25) /* brand-primary-alpha */;
}
.current-label {
  display: block;
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 8rpx;
}
.current-name {
  display: block;
  font-size: var(--font-xl);
  font-weight: var(--weight-bold);
  color: var(--text-inverse);
  margin-bottom: 8rpx;
}
.current-expire {
  display: block;
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.8);
}
.current-mode { display: block; margin-top: 18rpx; color: rgba(255,255,255,.86); font-size: var(--font-xs); line-height: 1.55; }

/* ===== 区块标题 ===== */
.section-header {
  padding: 16rpx 24rpx 12rpx;
}
.section-title {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

/* ===== 套餐卡片 ===== */
.plan-card {
  margin: 0 24rpx 20rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.plan-info {
  flex: 1;
  min-width: 0;
}
.plan-name {
  display: block;
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  line-height: 1.3;
  margin-bottom: 8rpx;
}
.plan-price {
  display: block;
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--nb-money);
  margin-bottom: 6rpx;
}
.plan-cycle {
  font-size: var(--font-sm);
  font-weight: normal;
  color: var(--text-muted);
}
.plan-desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
  line-height: var(--leading-normal);
}
.plan-stage, .plan-quota {
  display: block;
  margin-top: 8rpx;
  color: var(--text-body);
  font-size: var(--font-xs);
  line-height: var(--leading-normal);
}
.plan-quota { color: var(--text-muted); }
.plan-btn {
  min-height: 88rpx;
  padding: 0 32rpx;
  background: rgba(0, 0, 0, 0.08) /* brand-primary-alpha */;
  color: var(--brand-primary);
  border-radius: var(--radius-lg);
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin: 0;
  line-height: 1;
}
.plan-actions {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
  flex-shrink: 0;
}
.impact-btn {
  min-height: 88rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: var(--radius-lg);
  background: var(--nb-soft-surface);
  color: var(--text-primary);
  font-size: var(--font-sm);
  line-height: 84rpx;
}
.impact-btn::after { border: 0; }
.impact-btn:active { background: var(--bg-page); }
.plan-btn::after, .contact-btn::after { border: 0; }
.plan-btn:active {
  opacity: 0.65;
}

/* ===== 空状态 ===== */
.empty, .load-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx 80rpx;
}
.load-error-mark { width:88rpx; height:88rpx; margin-bottom:32rpx; border-radius:50%; background:var(--nb-page); color:var(--nb-ink); font-size: var(--font-xl); line-height:88rpx; text-align:center; }
.retry-btn { min-height:88rpx; margin:0; padding:0 56rpx; border:0; border-radius: var(--radius-xl); background:var(--nb-ink); color: var(--text-inverse); font-size: var(--font-md); line-height:88rpx; }
.retry-btn::after { border:0; }
.empty-icon {
  width: 112rpx;
  height: 112rpx;
  margin-bottom: 32rpx;
  border-radius: 50%;
  background: var(--nb-page);
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty-icon-ring { width: 42rpx; height: 42rpx; border: 6rpx solid var(--brand-primary); border-radius: 50%; box-sizing: border-box; }
.empty-text {
  font-size: var(--font-lg);
  color: var(--text-body);
  margin-bottom: 12rpx;
}
.empty-sub {
  font-size: var(--font-sm);
  color: var(--text-muted);
  margin-bottom: 56rpx;
}
.contact-btn {
  min-height: 88rpx;
  padding: 0 72rpx;
  background: var(--nb-action);
  color: var(--text-inverse);
  border-radius: var(--radius-xl);
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  line-height: 1;
}
.contact-btn:active {
  opacity: 0.85;
}
.usage-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 28rpx;
}
.usage-item {
  color: var(--text-inverse);
  font-size: var(--font-sm);
}
.usage-heading {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 10rpx;
  color: rgba(255, 255, 255, 0.92);
}
.usage-track {
  height: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.28);
}
.usage-progress {
  height: 100%;
  min-width: 0;
  border-radius: inherit;
  background: var(--bg-card);
  transition: width 200ms ease;
}
.usage-item--notice .usage-progress { background: var(--nb-action); }
.usage-item--warning .usage-progress { background: var(--nb-action); }
.usage-item--limit .usage-progress { background: var(--nb-page); }
.usage-hint {
  display: block;
  margin-top: 10rpx;
  color: var(--text-inverse);
  font-size: var(--font-xs);
  line-height: 1.4;
}
@import '../../../styles/booking-actions.wxss';
.retry-btn.booking-action { min-height:44px; height:44px; margin:0; padding:0 24rpx; border-radius:8px; font-size:var(--font-sm); line-height:1.4; }
.plan-btn.booking-action,.contact-btn.booking-action { min-height:44px; height:44px; padding:0 24rpx; border-radius:8px; font-size:var(--font-sm); line-height:1.4; }
