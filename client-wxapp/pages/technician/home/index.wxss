@import '../../../styles/tokens.wxss';

/* ========== 基础 ========== */
page { background: var(--nb-page); }
.page {
  min-height: 100vh;
  padding-top: var(--space-md);
  padding-bottom: 24rpx;
}

/* ========== 游客模式横幅 ========== */
.tourist-banner {
  margin: 0 var(--space-xl) var(--space-md);
  padding: var(--space-md) 28rpx;
  background: var(--nb-surface);
  border: 1rpx solid var(--nb-line);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: flex-start;
  gap: var(--space-sm);
}
.tourist-banner:active { opacity: 0.88; }
.tourist-banner-icon {
  font-size: var(--font-lg);
  line-height: 1.2;
  flex-shrink: 0;
}
.tourist-banner-body {
  flex: 1;
  min-width: 0;
}
.tourist-banner-title {
  display: block;
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: var(--nb-ink);
  margin-bottom: 6rpx;
}
.tourist-banner-desc {
  display: block;
  font-size: var(--font-xs);
  color: var(--nb-secondary);
  line-height: 1.6;
}
.tourist-banner-action {
  flex-shrink: 0;
  align-self: center;
  font-size: var(--font-sm);
  font-weight: var(--weight-semibold);
  color: var(--nb-text-link);
  white-space: nowrap;
}

.reminder-card {
  margin: 0 var(--space-xl) var(--space-md);
  padding: var(--space-md) 28rpx;
  min-height: 112rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: var(--space-md);
  background: var(--nb-surface);
  border: 1rpx solid var(--nb-line);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.reminder-copy { flex: 1; min-width: 0; }
.reminder-title {
  display: block;
  color: var(--nb-ink);
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
}
.reminder-desc {
  display: block;
  margin-top: 6rpx;
  color: var(--nb-muted);
  font-size: var(--font-xs);
  line-height: 1.5;
}
.reminder-action {
  flex-shrink: 0;
  min-width: 152rpx;
  min-height: var(--touch-min);
  margin: 0;
  padding: 0 var(--space-md);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: var(--radius-md);
  background: var(--nb-action);
  color: var(--nb-inverse);
  font-size: var(--font-sm);
  font-weight: var(--weight-semibold);
  line-height: 1;
}
.reminder-action::after { border: 0; }
.reminder-action:active { opacity: .82; }

/* ========== 经营信息 Hero ========== */
.business-hero {
  position: relative;
  overflow: hidden;
  margin: 0 var(--space-xl);
  padding: var(--space-lg) 32rpx 32rpx;
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--nb-line);
  color: var(--nb-ink);
  background: var(--nb-surface);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.business-hero:active { opacity: 0.94; }
.hero-orb { display: none; }
.business-hero-head { position: relative; display: flex; align-items: flex-start; justify-content: space-between; }
.business-hero-kicker { display: block; font-size: var(--font-lg); font-weight: var(--weight-bold); color: var(--nb-ink); }
.business-hero-caption { display: block; margin-top: 6rpx; font-size: var(--font-xs); color: var(--nb-muted); }
.business-hero-more { min-height: var(--touch-min); margin-top: -12rpx; display: flex; align-items: center; gap: var(--space-xs); font-size: var(--font-sm); font-weight: var(--weight-semibold); }
.business-hero-content { position: relative; margin-top: var(--space-md); }
.business-hero-primary {
  min-width: 0;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.business-hero-value { font-size: var(--font-2xl); line-height: 1.1; font-weight: var(--weight-bold); letter-spacing: -1.5rpx; color: var(--nb-ink); }
.business-hero-primary .business-hero-label { margin-top: 10rpx; text-align: center; color: var(--nb-muted); font-size: var(--font-xs); line-height: 1.4; }
.business-hero-grid { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid var(--nb-line); }
.business-hero-number { display: block; font-size: var(--font-md); line-height: 1; font-weight: var(--weight-bold); letter-spacing: -0.5rpx; color: var(--nb-ink); white-space: nowrap; }
.business-hero-label { display: block; margin-top: 10rpx; font-size: var(--font-xs); line-height: 1.25; color: var(--nb-muted); white-space: nowrap; }
.business-hero-metric { min-width: 0; min-height: 80rpx; border-left: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 0 4rpx; }
.business-hero-estimated { border-left: 0; }
.business-hero-empty { position: relative; padding: 42rpx 0 12rpx; font-size: var(--font-sm); color: var(--nb-muted); text-align: center; }

/* ========== 快捷操作 ========== */
.quick-actions {
  margin: var(--space-md) var(--space-xl) 0;
  display: flex;
  width: auto;
  min-width: 0;
  box-sizing: border-box;
  align-items: stretch;
  gap: var(--space-sm);
  overflow: hidden;
}
.quick-action {
  flex: 1;
  min-width: 0;
  min-height: 120rpx;
  margin: 0;
  padding: 20rpx 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  border: 1rpx solid var(--nb-line);
  border-radius: var(--radius-lg);
  background: var(--nb-surface);
  color: var(--nb-ink);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  line-height: 1.2;
}
.quick-action::after { border: 0; }
.quick-action-pressed { background: var(--nb-soft-surface); transform: scale(.98); }
.quick-action-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.quick-action-icon image { width: 40rpx; height: 40rpx; }
.quick-action-title { font-size: var(--font-sm); font-weight: var(--weight-semibold); white-space: nowrap; }

/* ========== 通用卡片 ========== */
.card {
  margin: var(--space-md) var(--space-xl) 0;
  background: var(--nb-surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  border: 1rpx solid var(--nb-line);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.card-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); margin-bottom: var(--space-md); }
.card-title { display: block; font-size: var(--font-lg); font-weight: var(--weight-bold); color: var(--nb-ink); line-height: 1.2; }
.card-sub { display: block; margin-top: 6rpx; font-size: var(--font-xs); color: var(--nb-muted); }
.card-more {
  position: relative;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  font-size: var(--font-sm);
  color: var(--nb-muted);
  font-weight: var(--weight-semibold);
  padding: 0 4rpx;
  border-radius: var(--radius-full);
  border: 0;
  background: transparent;
  line-height: 1.4;
  flex-shrink: 0;
}
.card-more::after {
  content: '';
  position: absolute;
  top: -16rpx;
  bottom: -16rpx;
  left: -16rpx;
  right: -16rpx;
}
.card-more:active {
  opacity: 0.7;
}
.card-more.pink { color: var(--nb-text-link); border-color: transparent; }

.empty-soft {
  background: var(--nb-soft-surface);
  border-radius: var(--radius-md);
  padding: 48rpx var(--space-xl);
  text-align: center;
  font-size: var(--font-sm); color: var(--nb-muted);
}
.confirmation-todo-list { display:flex; flex-direction:column; gap:var(--space-sm); margin-bottom:0; }

/* ========== 下一单 ========== */
.next-card { margin-top: var(--space-md); position: relative; z-index: 2; }
.next-card-filled {
  padding: 0;
  background: transparent;
  border: none;
  box-shadow: none;
  overflow: visible;
}

.next-empty { padding: var(--space-sm) 0; text-align: center; }
.next-empty-title { display: block; font-size: var(--font-lg); font-weight: var(--weight-bold); color: var(--nb-ink); line-height: 1.3; }
.next-empty-sub { display: block; margin-top: var(--space-xs); font-size: var(--font-xs); line-height: 1.5; color: var(--nb-muted); }

/* ========== 待处理事项 ========== */
.todo-card { padding-bottom:24rpx; }
.todo-card .card-head { align-items:flex-start; margin-bottom:20rpx; }
.todo-total-text { padding-top:4rpx; color:var(--nb-secondary); font-size:var(--font-xs); font-weight:var(--weight-medium); }
.todo-priority-head { min-height:44px; display:flex; align-items:center; justify-content:space-between; gap:var(--space-sm); }
.todo-priority-label { color:var(--nb-ink); font-size:var(--font-sm); font-weight:var(--weight-semibold); }
.todo-priority-more { min-height:44px; display:flex; align-items:center; color:var(--nb-text-link); font-size:var(--font-xs); font-weight:var(--weight-medium); }
.todo-summary-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8rpx; margin-top:20rpx; padding-top:20rpx; border-top:2rpx solid var(--nb-line); }
.todo-summary-item { min-width:0; min-height:56px; padding:10rpx 4rpx; border-radius:14rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4rpx; box-sizing:border-box; background:var(--nb-soft-surface); color:var(--nb-muted); }
.todo-summary-item.is-active { color:var(--nb-ink); }
.todo-summary-item:active { background:var(--nb-pressed); }
.todo-summary-count { font-size:var(--font-md); line-height:1.2; font-weight:var(--weight-bold); font-variant-numeric:tabular-nums; }
.todo-summary-item.is-active .todo-summary-count { color:var(--nb-text-link); }
.todo-summary-label { width:100%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; text-align:center; font-size:20rpx; line-height:1.3; }

/* ========== 热门作品 - 瀑布流 ========== */
/* 以短距离轻阴影区分白色卡片，避免大范围投影叠加发灰。 */
.works-card { --work-card-shadow: 0 2rpx 8rpx rgba(0, 0, 0, .08); }
.hw-wall { padding:var(--space-xs); width:100%; max-width:100%; min-width:0; overflow:hidden; display: flex; gap: var(--space-sm); align-items: flex-start; box-sizing:border-box; }
.hw-lead { margin-bottom:var(--space-md); }
.hw-col { flex: 1 1 0; width:calc((100% - var(--space-sm)) / 2); min-width:0; max-width:calc((100% - var(--space-sm)) / 2); display:flex; flex-direction:column; gap:var(--space-sm); }
.hw-card { width:100%; }
.hw-card:active { transform: scale(0.985); opacity: 0.95; }
.hw-img-wrap { position: relative; width: 100%; height: 0; padding-bottom: 133.33%; overflow: hidden; box-sizing: border-box; }
.hw-col:first-child .hw-card:nth-child(3n + 1) .hw-img-wrap { padding-bottom: 148%; }
.hw-col:first-child .hw-card:nth-child(3n + 2) .hw-img-wrap { padding-bottom: 104%; }
.hw-col:first-child .hw-card:nth-child(3n) .hw-img-wrap { padding-bottom: 126%; }
.hw-col:last-child .hw-card:nth-child(3n + 1) .hw-img-wrap { padding-bottom: 112%; }
.hw-col:last-child .hw-card:nth-child(3n + 2) .hw-img-wrap { padding-bottom: 144%; }
.hw-col:last-child .hw-card:nth-child(3n) .hw-img-wrap { padding-bottom: 100%; }
.hw-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.hw-img-empty { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: var(--nb-page); }
.hw-gradient { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: linear-gradient(180deg, rgba(0, 0, 0, 0.12) 0%, transparent 30%, rgba(0, 0, 0, 0.72) 100%); }
.hw-tags-top { position: absolute; top: 12rpx; left: 12rpx; display: flex; gap: var(--space-xs); z-index: 2; }
.hw-tag { font-size: var(--font-xs); font-weight: var(--weight-semibold); padding: 4rpx 14rpx; border-radius: var(--radius-md); backdrop-filter: blur(8px); }
.hw-tag-pin { background: rgba(0, 0, 0, 0.85) /* brand-primary-alpha */; color: var(--text-inverse); }
.hw-tag-feat { background: rgba(0, 0, 0, 0.85); color: var(--text-inverse); }
.hw-bottom { position: absolute; bottom: 0; left: 0; right: 0; padding: 12rpx var(--space-sm); z-index: 1; }
.hw-title { display: block; font-size: var(--font-sm); font-weight: var(--weight-semibold); color: var(--text-inverse); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; line-height: var(--leading-tight); }
.hw-stats { display: flex; align-items: center; gap: 6rpx; margin-top: 6rpx; }
.hw-stat-icon { font-size: var(--font-xs); color: rgba(255, 255, 255, 0.7); }
.hw-stat-gap { margin-left: 12rpx; }
.hw-stat-num { font-size: var(--font-xs); color: rgba(255, 255, 255, 0.82); font-weight: var(--weight-medium); }

/* 跟进 */
.action-task-list { margin-top:20rpx; display:flex; flex-direction:column; gap:14rpx; }
.action-task-row { min-height:88rpx; display:flex; align-items:center; justify-content:space-between; gap:var(--space-sm); padding:16rpx 20rpx; border-radius:16rpx; background:var(--nb-soft-surface); box-sizing:border-box; border:0; }
.action-task-row:active { background:var(--nb-page); }
.action-task-copy { min-width:0; flex:1; }
.action-task-title,.action-task-desc { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.action-task-title { color:var(--nb-ink); font-size:var(--font-sm); font-weight:var(--weight-semibold); }
.action-task-desc { margin-top:4rpx; color:var(--nb-muted); font-size:var(--font-xs); }
.action-task-actions { display:flex; align-items:center; gap:14rpx; flex-shrink:0; }
.action-task-done { min-height:44px; display:flex; align-items:center; color:var(--nb-text-link); font-size:var(--font-xs); font-weight:600; }

/* Text navigation has no decorative pill. Keep existing hit-area sizing. */
.business-hero-more, .card-more, .card-more.pink, .confirmation-action-detail { color: var(--nb-text-link, #245EA8); background: transparent; border-color: transparent; box-shadow: none; }
.business-hero-more:active, .card-more:active, .card-more.pink:active, .confirmation-action-detail:active { background: transparent; opacity: .7; }
