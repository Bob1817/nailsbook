<nav-bar title="首页"/>
<view class="page">

  <!-- ===== 游客模式提示 ===== -->
  <view wx:if="{{isTourist}}" class="tourist-banner" bindtap="goActivate">
    <view class="tourist-banner-icon">⚠️</view>
    <view class="tourist-banner-body">
      <text class="tourist-banner-title">游客模式 · 功能受限</text>
      <text class="tourist-banner-desc">您当前为游客身份，可浏览页面但无法发布作品、接单或管理客户。设置密码后即可激活完整功能。</text>
    </view>
    <view class="tourist-banner-action">去激活 ›</view>
  </view>

  <!-- ===== 经营信息 ===== -->
  <view class="business-hero" bindtap="openBusinessDetail" role="button" aria-label="查看经营数据详情">
    <view class="hero-orb hero-orb-left"></view>
    <view class="hero-orb hero-orb-right"></view>
    <view class="business-hero-head">
      <view>
        <text class="business-hero-kicker">本月经营信息</text>
        <text class="business-hero-caption">数据更新至今日</text>
      </view>
      <view class="business-hero-more">详情 <text>›</text></view>
    </view>
    <view wx:if="{{businessOverview}}" class="business-hero-content">
      <view class="business-hero-primary"><text class="business-hero-value">{{businessOverview.revenue}}</text><text class="business-hero-label">已完成确认收入</text></view>
      <view class="business-hero-grid">
        <view class="business-hero-metric business-hero-estimated"><text class="business-hero-number">{{businessOverview.estimatedRevenue}}</text><text class="business-hero-label">预计收入</text></view>
        <view class="business-hero-metric"><text class="business-hero-number">{{businessOverview.monthCompleted}}</text><text class="business-hero-label">完成订单</text></view>
        <view class="business-hero-metric"><text class="business-hero-number">{{businessOverview.monthBookings}}</text><text class="business-hero-label">本月预约</text></view>
        <view class="business-hero-metric"><text class="business-hero-number">{{businessOverview.newCustomers}}</text><text class="business-hero-label">本月新增</text></view>
      </view>
    </view>
    <view wx:else class="business-hero-empty">经营数据正在生成</view>
  </view>

  <!-- ===== 下一单 ===== -->
  <view class="card next-card {{nextOrder ? 'next-card-filled' : ''}}">
    <block wx:if="{{nextOrder}}">
      <technician-booking-card order="{{nextOrder}}" variant="hero" bind:open="onBookingCardOpen" bind:message="onBookingCardMessage" bind:navigate="onBookingCardNavigate" bind:contact="onBookingCardContact" />
    </block>

    <view wx:else class="next-empty">
      <text class="next-empty-title">暂无行程安排</text>
      <text class="next-empty-sub">当前没有待上门、待到店或服务中的预约。</text>
    </view>
  </view>

  <!-- ===== 待处理事项 ===== -->
  <view class="card todo-card">
    <view class="card-head">
      <view>
        <text class="card-title">待处理事项</text>
        <text class="card-sub">高优先级工作提醒</text>
      </view>
      <view wx:if="{{todoTotal > 0}}" class="todo-total-badge">{{todoTotal}}</view>
    </view>

    <view wx:if="{{confirmationTodos.length > 0}}" class="confirmation-todo-list">
      <view wx:for="{{confirmationTodos}}" wx:key="id" class="confirmation-todo">
        <view class="confirmation-todo-head">
          <view class="confirmation-todo-status-row"><text class="confirmation-todo-status">待我确认</text><text wx:if="{{item._urgencyLabel}}" class="confirmation-todo-urgency">{{item._urgencyLabel}}</text></view>
          <text class="confirmation-todo-time">{{item._dateLabel}} {{item._clock}}</text>
        </view>
        <view class="confirmation-todo-primary">
          <view class="confirmation-todo-field"><text class="confirmation-todo-label">客户</text><text class="confirmation-todo-value">{{item.customerName || '客户'}}</text></view>
          <view class="confirmation-todo-field confirmation-todo-price"><text class="confirmation-todo-label">预约金额</text><text class="confirmation-todo-value">{{item._priceText}}</text></view>
        </view>
        <view class="confirmation-todo-shop"><text class="confirmation-todo-label">店铺</text><text class="confirmation-todo-value">{{item._shopName || '店铺待确认'}}</text></view>
        <view class="confirmation-todo-actions">
          <view class="confirmation-action-hit" catchtap="refuseConfirmation" data-id="{{item.id}}" role="button" aria-label="拒绝排期"><text class="confirmation-action confirmation-action-reject">拒绝排期</text></view>
          <view class="confirmation-action-hit" catchtap="confirmConfirmation" data-id="{{item.id}}" role="button" aria-label="确认排期"><text class="confirmation-action confirmation-action-confirm">确认排期</text></view>
          <view class="confirmation-action-hit" catchtap="openOrderDetail" data-id="{{item.id}}" role="button" aria-label="查看预约详情"><text class="confirmation-action confirmation-action-detail">查看详情</text></view>
        </view>
      </view>
    </view>

    <view wx:if="{{todoItems.length > 0}}" class="todo-list">
      <view
        wx:for="{{todoItems}}"
        wx:key="key"
        class="todo-item"
        bindtap="onTodoTap"
        data-key="{{item.key}}"
      >
        <view class="todo-left">
          <view class="todo-count {{item.tone}}">{{item.count}}</view>
          <text class="todo-label">{{item.label}}</text>
        </view>
        <text class="todo-arrow">›</text>
      </view>
    </view>

    <view wx:if="{{confirmationTodos.length === 0 && todoItems.length === 0}}" class="empty-soft">今日待办已清空，可以专心服务客户。</view>

    <view wx:if="{{todayFollowUps.length > 0}}" class="followup-today">
      <text class="followup-title">今日客户跟进</text>
      <view
        wx:for="{{todayFollowUps}}"
        wx:key="id"
        class="followup-row"
        bindtap="openFollowUpCustomer"
        data-id="{{item.customer.id}}"
      >
        <view class="followup-time">{{item._clock}}</view>
        <view class="followup-info">
          <text class="followup-name">{{item._customerName}}</text>
          <text class="followup-content">{{item.content}}</text>
        </view>
        <text class="todo-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- ===== 热门作品 ===== -->
  <view class="card works-card">
    <view class="card-head">
      <view>
        <text class="card-title">今日热门</text>
        <text class="card-sub">最近受欢迎的款式和客户收藏</text>
      </view>
      <view class="card-more pink" bindtap="navigateToWorks">更多</view>
    </view>

    <view wx:if="{{featuredWorks.length}}" class="hw-wall">
      <view class="hw-col">
        <view wx:for="{{worksLeft}}" wx:key="id" class="hw-card">
          <work-card work="{{item}}" manageable bind:cardtap="navigateToWorkDetail" bind:actiontap="showWorkActions" />
        </view>
      </view>
      <view class="hw-col">
        <view wx:for="{{worksRight}}" wx:key="id" class="hw-card">
          <work-card work="{{item}}" manageable bind:cardtap="navigateToWorkDetail" bind:actiontap="showWorkActions" />
        </view>
      </view>
    </view>

    <view wx:else class="empty-soft">还没有上传作品，先补几张好看的款式吧。</view>
  </view>
</view>
<tab-bar selected="home" />
