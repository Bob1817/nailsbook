<nav-bar title="首页"/>
<view class="page">
  <!-- ===== 顶部 Header ===== -->
  <view class="header">
    <view class="header-bg-blur b1"></view>
    <view class="header-bg-blur b2"></view>

    <view class="header-top">
      <view class="user-block">
        <view class="avatar-wrap">
          <image wx:if="{{avatar}}" src="{{avatar}}" mode="aspectFill" class="avatar" aria-label="{{name || '美甲师'}}的头像" />
          <view wx:else class="avatar-placeholder">
            <text class="avatar-char">{{name[0] || '美'}}</text>
          </view>
        </view>
        <view class="name-block">
          <view class="name-row">
            <text class="name">{{name || '美甲师'}}</text>
            <view class="status-pill {{status === 'active' ? 'status-on' : 'status-off'}}">
              <view class="status-pill-dot"></view>
              <text>{{status === 'active' ? '接单中' : '已暂停'}}</text>
            </view>
          </view>
          <text class="subline">今日 {{summary.todayCount}} 单 · 预估 {{summary.expectedIncomeText}}</text>
        </view>
      </view>

      <view class="share-wrap">
        <view class="share-inner">
          <view class="share-icon-svg"></view>
          <text class="share-label">分享名片</text>
        </view>
        <button class="share-cover" open-type="share"></button>
      </view>
    </view>
  </view>

  <view wx:if="{{businessOverview}}" class="card business-card">
    <view class="card-head">
      <view>
        <text class="card-title">经营总览</text>
        <text class="card-sub">本月确认收入按已完成订单实付金额统计</text>
      </view>
    </view>

    <view class="business-grid">
      <view class="business-metric" bindtap="openBusinessDetail" data-target="orders">
        <text class="business-value">{{businessOverview.revenue}}</text>
        <text class="business-label">本月确认收入</text>
        <text class="business-definition">已完成且确认入账的订单</text>
      </view>
      <view class="business-metric" bindtap="openBusinessDetail" data-target="orders">
        <text class="business-value">{{businessOverview.averageTicket}}</text>
        <text class="business-label">平均客单价</text>
        <text class="business-definition">确认收入 ÷ 完成订单数</text>
      </view>
      <view class="business-metric" bindtap="openBusinessDetail" data-target="customers">
        <text class="business-value">{{businessOverview.totalCustomers}}</text>
        <text class="business-label">总客户 · 新客 {{businessOverview.newCustomers}}</text>
        <text class="business-definition">当前客户档案与本月新增</text>
      </view>
      <view class="business-metric" bindtap="openBusinessDetail" data-target="customers">
        <text class="business-value">{{businessOverview.repeatRate}}</text>
        <text class="business-label">复购率</text>
        <text class="business-definition">复购客户 ÷ 完成客户 {{businessOverview.completedCustomers}}</text>
      </view>
    </view>

    <view class="business-link" bindtap="openBusinessDetail" data-target="due">
      <view><text class="business-link-title">待复购客户 {{businessOverview.dueCustomers}}</text><text class="business-link-sub">已达到预计复购日期，进入客户明细</text></view><text>›</text>
    </view>
    <view class="business-link" bindtap="openBusinessDetail" data-target="referrals">
      <view><text class="business-link-title">推荐 {{businessOverview.referrals}} · 有效 {{businessOverview.qualifiedReferrals}}</text><text class="business-link-sub">有效推荐首单实付 {{businessOverview.referralRevenue}}</text></view><text>›</text>
    </view>
    <view class="business-link" bindtap="openBusinessDetail" data-target="referrals">
      <view><text class="business-link-title">基金发放 {{businessOverview.fundsIssued}}</text><text class="business-link-sub">累计抵扣 {{businessOverview.fundsRedeemed}}，余额与明细可追溯</text></view><text>›</text>
    </view>

    <view class="insight-section">
      <text class="insight-title">近 7 日趋势</text>
      <view wx:if="{{businessOverview.dailyTrend.length}}" class="trend-list">
        <view wx:for="{{businessOverview.dailyTrend}}" wx:key="period" class="trend-row">
          <text>{{item.label}}</text><text>{{item.orders}} 单 · +{{item.newCustomers}} 客</text><text>{{item.revenueText}}</text>
        </view>
      </view>
      <text wx:else class="insight-empty">最近 7 日暂无确认收入</text>
      <text class="insight-title insight-title-gap">近 4 周趋势</text>
      <view wx:if="{{businessOverview.weeklyTrend.length}}" class="trend-list">
        <view wx:for="{{businessOverview.weeklyTrend}}" wx:key="period" class="trend-row">
          <text>{{item.label}}</text><text>{{item.orders}} 单 · +{{item.newCustomers}} 客</text><text>{{item.revenueText}}</text>
        </view>
      </view>
      <text wx:else class="insight-empty">最近 4 周暂无确认收入</text>
    </view>

    <view class="insight-section">
      <text class="insight-title">服务与时段表现</text>
      <block wx:if="{{businessOverview.performanceReady}}">
        <view class="performance-row"><text>收入最高服务</text><text>{{businessOverview.topService.name}} · {{businessOverview.topService.revenueText}}</text></view>
        <view class="performance-row"><text>收入最高时段</text><text>{{businessOverview.topTimeSlot.name}} · {{businessOverview.topTimeSlot.revenueText}}</text></view>
      </block>
      <text wx:else class="insight-empty">至少需要 {{businessOverview.performanceMinimum}} 笔完成订单后生成表现结论</text>
    </view>

    <view wx:if="{{businessOverview.reminders.length}}" class="insight-section">
      <text class="insight-title">经营提醒</text>
      <view wx:for="{{businessOverview.reminders}}" wx:key="key" class="reminder-row" bindtap="openInsightCustomer" data-id="{{item.customerId}}">
        <view><text class="reminder-name">{{item.typeText}} · {{item.customerName}}</text><text class="reminder-reason">{{item.reason}}</text></view><text>›</text>
      </view>
    </view>
  </view>

  <!-- ===== 下一单 ===== -->
  <view class="card next-card" bindtap="openOrderDetail" data-id="{{nextOrder.id}}">
    <text class="next-title">下一单</text>

    <block wx:if="{{nextOrder}}">
      <view class="next-row">
        <view class="time-col">
          <text class="next-date">{{nextOrder._dateLabel}}</text>
          <text class="next-time">{{nextOrder._clock}}</text>
        </view>
        <view class="next-info">
          <view class="next-name-row">
            <text class="next-name">{{nextOrder.customerName}}</text>
            <text class="tag {{nextOrder._typeClass}}">{{nextOrder._typeLabel}}</text>
          </view>
          <text class="next-svc">{{nextOrder.serviceName}}</text>
        </view>
      </view>

      <view class="next-addr">
        <view class="addr-icon"></view>
        <text class="addr-text">{{nextOrder._fullAddress}}</text>
      </view>

      <view class="next-stats">
        <view class="stat-mini">
          <text class="stat-mini-cap">预计路程</text>
          <text class="stat-mini-val">{{nextOrder._distanceText}}</text>
        </view>
        <view class="stat-mini">
          <text class="stat-mini-cap">建议出发</text>
          <text class="stat-mini-val">{{nextOrder._departureClock}}</text>
        </view>
      </view>

      <view wx:if="{{nextOrder._countdownText}}" class="countdown">
        <text class="countdown-cap">距出发还有</text>
        <text class="countdown-val">{{nextOrder._countdownText}}</text>
      </view>

      <view class="next-actions">
        <view class="btn btn-primary" catchtap="navigateToAddress" data-order-id="{{nextOrder.id}}">
          <view class="btn-ico btn-ico-nav"></view>
          <text>开始导航</text>
        </view>
        <view class="btn btn-ghost" catchtap="contactCustomer" data-phone="{{nextOrder.customerPhone}}">
          <view class="btn-ico btn-ico-phone"></view>
          <text>联系客户</text>
        </view>
      </view>
    </block>

    <view wx:else class="next-empty">
      <text class="next-empty-title">暂无行程安排</text>
      <text class="next-empty-sub">当前没有待上门、待到店或服务中的预约。</text>
    </view>
  </view>

  <!-- ===== 待处理事项 ===== -->
  <view class="card todo-card">
    <view class="card-head">
      <view>
        <text class="card-title">待处理事项</text>
        <text class="card-sub">高优先级工作提醒</text>
      </view>
      <view wx:if="{{todoTotal > 0}}" class="todo-total-badge">{{todoTotal}}</view>
    </view>

    <view wx:if="{{todoItems.length > 0}}" class="todo-list">
      <view
        wx:for="{{todoItems}}"
        wx:key="key"
        class="todo-item"
        bindtap="onTodoTap"
        data-key="{{item.key}}"
      >
        <view class="todo-left">
          <view class="todo-count {{item.tone}}">{{item.count}}</view>
          <text class="todo-label">{{item.label}}</text>
        </view>
        <text class="todo-arrow">›</text>
      </view>
    </view>

    <view wx:else class="empty-soft">今日待办已清空，可以专心服务客户。</view>

    <view wx:if="{{todayFollowUps.length > 0}}" class="followup-today">
      <text class="followup-title">今日客户跟进</text>
      <view
        wx:for="{{todayFollowUps}}"
        wx:key="id"
        class="followup-row"
        bindtap="openFollowUpCustomer"
        data-id="{{item.customer.id}}"
      >
        <view class="followup-time">{{item._clock}}</view>
        <view class="followup-info">
          <text class="followup-name">{{item._customerName}}</text>
          <text class="followup-content">{{item.content}}</text>
        </view>
        <text class="todo-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- ===== 热门作品 ===== -->
  <view class="card works-card">
    <view class="card-head">
      <view>
        <text class="card-title">今日热门作品</text>
        <text class="card-sub">最近受欢迎的款式和客户收藏</text>
      </view>
      <view class="card-more pink" bindtap="navigateToWorks">更多</view>
    </view>

    <view wx:if="{{featuredWorks.length > 0}}" class="hw-wall">
      <view class="hw-col">
        <view wx:for="{{worksLeft}}" wx:key="id" class="hw-card" bindtap="navigateToWorkDetail" data-id="{{item.id}}">
          <view class="hw-img-wrap">
            <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" class="hw-img" lazy-load aria-label="{{item.title || '美甲作品'}}" />
            <view wx:else class="hw-img hw-img-empty"></view>
            <view class="hw-gradient"></view>
            <view class="hw-tags-top">
              <view wx:if="{{item.isPinned}}" class="hw-tag hw-tag-pin">置顶</view>
              <view wx:if="{{item.isFeatured}}" class="hw-tag hw-tag-feat">推荐</view>
            </view>
            <view class="hw-bottom">
              <text class="hw-title">{{item.title || '未命名'}}</text>
              <view class="hw-stats">
                <text class="hw-stat-icon">♥</text>
                <text class="hw-stat-num">{{item.likeCount || 0}}</text>
                <text class="hw-stat-icon hw-stat-gap">★</text>
                <text class="hw-stat-num">{{item.favoriteCount || 0}}</text>
                <text class="hw-stat-icon hw-stat-gap">✎</text>
                <text class="hw-stat-num">{{item.commentCount || 0}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="hw-col">
        <view wx:for="{{worksRight}}" wx:key="id" class="hw-card" bindtap="navigateToWorkDetail" data-id="{{item.id}}">
          <view class="hw-img-wrap">
            <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" class="hw-img" lazy-load aria-label="{{item.title || '美甲作品'}}" />
            <view wx:else class="hw-img hw-img-empty"></view>
            <view class="hw-gradient"></view>
            <view class="hw-tags-top">
              <view wx:if="{{item.isPinned}}" class="hw-tag hw-tag-pin">置顶</view>
              <view wx:if="{{item.isFeatured}}" class="hw-tag hw-tag-feat">推荐</view>
            </view>
            <view class="hw-bottom">
              <text class="hw-title">{{item.title || '未命名'}}</text>
              <view class="hw-stats">
                <text class="hw-stat-icon">♥</text>
                <text class="hw-stat-num">{{item.likeCount || 0}}</text>
                <text class="hw-stat-icon hw-stat-gap">★</text>
                <text class="hw-stat-num">{{item.favoriteCount || 0}}</text>
                <text class="hw-stat-icon hw-stat-gap">✎</text>
                <text class="hw-stat-num">{{item.commentCount || 0}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="empty-soft">还没有上传作品，先补几张好看的款式吧。</view>
  </view>
</view>
<tab-bar selected="home" />
