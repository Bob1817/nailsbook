.settings-page{min-height:100vh;padding:44rpx var(--space-lg) calc(44rpx + env(safe-area-inset-bottom));background:var(--nb-page);box-sizing:border-box;color:var(--nb-ink)}.app-name,.brand-slogan,.version,.mission-kicker,.mission-title,.mission-copy,.feature-number,.feature-name,.section-title,.info-label,.info-value,.copyright{display:block}.brand-hero{display:flex;flex-direction:column;align-items:center;padding:var(--space-xs) 0 var(--space-xl)}.logo{min-width:104rpx;height:56rpx;padding:0 var(--space-md);box-sizing:border-box;display:flex;align-items:center;justify-content:center;border-radius:var(--radius-lg);background:var(--nb-action)}.logo-letter{color:var(--nb-inverse);font-size:var(--font-md);font-weight:700;letter-spacing:.5rpx}.app-name{margin-top:18rpx;font-size:var(--font-xl);font-weight:700;letter-spacing:.5rpx}.brand-slogan{margin-top:var(--space-xs);color:var(--nb-secondary);font-size:var(--font-xs)}.version{margin-top:12rpx;padding:6rpx 14rpx;border-radius:var(--radius-sm);background:var(--nb-soft-surface);color:var(--nb-muted);font-size:var(--font-xs)}.mission-card{padding:30rpx;border-radius:26rpx;background:var(--nb-surface)}.mission-heading{display:flex;align-items:center;justify-content:space-between}.mission-kicker{color:var(--nb-muted);font-size:var(--font-xs);font-weight:650;letter-spacing:2rpx}.mission-index{color:var(--nb-border);font-size:var(--font-lg);font-weight:700;line-height:1}.mission-title{margin-top:14rpx;font-size:var(--font-md);font-weight:680;line-height:1.4}.mission-copy{max-width:590rpx;margin-top:10rpx;color:var(--nb-secondary);font-size:var(--font-xs);line-height:1.65}.feature-row{margin-top:26rpx;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10rpx}.feature-item{min-height:92rpx;padding:var(--space-sm) 12rpx;box-sizing:border-box;border-radius:var(--radius-sm);background:var(--nb-soft-surface)}.feature-number{color:var(--nb-muted);font-size:var(--font-xs);font-weight:600}.feature-name{margin-top:var(--space-xs);font-size:var(--font-xs);font-weight:600;white-space:nowrap}.section-heading{padding:36rpx var(--space-xs) var(--space-sm)}.section-title{font-size:var(--font-md);font-weight:650}.info-card,.agreement-card{overflow:hidden;border-radius:24rpx;background:var(--nb-surface)}.info-item{min-height:88rpx;padding:14rpx 28rpx;display:flex;align-items:center;justify-content:space-between;gap:var(--space-md);border-bottom:1rpx solid var(--nb-border);box-sizing:border-box}.info-item:last-child{border-bottom:0}.info-label{flex-shrink:0;color:var(--nb-muted);font-size:var(--font-xs)}.info-value{max-width:430rpx;font-size:var(--font-sm);line-height:1.5;text-align:right;overflow-wrap:anywhere}.agreement-row{min-height:96rpx;padding:0 28rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid var(--nb-border);font-size:var(--font-sm)}.agreement-row:last-child{border-bottom:0}.chevron{color:var(--nb-muted);font-size:var(--font-lg)}.copyright{margin-top:36rpx;color:var(--nb-muted);font-size:var(--font-xs);text-align:center}
