.settings-page{min-height:100vh;padding:44rpx 32rpx calc(44rpx + env(safe-area-inset-bottom));background:var(--nb-page);box-sizing:border-box;color:var(--nb-ink)}.app-name,.brand-slogan,.version,.mission-kicker,.mission-title,.mission-copy,.feature-number,.feature-name,.section-title,.info-label,.info-value,.copyright{display:block}.brand-hero{display:flex;flex-direction:column;align-items:center;padding:8rpx 0 40rpx}.logo{width:104rpx;height:104rpx;display:flex;align-items:center;justify-content:center;border-radius:28rpx;background:var(--nb-action)}.logo-letter{color:var(--nb-inverse);font-size:50rpx;font-weight:750}.app-name{margin-top:18rpx;font-size:38rpx;font-weight:700;letter-spacing:.5rpx}.brand-slogan{margin-top:8rpx;color:var(--nb-secondary);font-size:22rpx}.version{margin-top:12rpx;padding:6rpx 14rpx;border-radius:14rpx;background:var(--nb-soft-surface);color:var(--nb-muted);font-size:19rpx}.mission-card{padding:30rpx;border-radius:26rpx;background:var(--nb-surface)}.mission-heading{display:flex;align-items:center;justify-content:space-between}.mission-kicker{color:var(--nb-muted);font-size:20rpx;font-weight:650;letter-spacing:2rpx}.mission-index{color:var(--nb-border);font-size:34rpx;font-weight:700;line-height:1}.mission-title{margin-top:14rpx;font-size:30rpx;font-weight:680;line-height:1.4}.mission-copy{max-width:590rpx;margin-top:10rpx;color:var(--nb-secondary);font-size:22rpx;line-height:1.65}.feature-row{margin-top:26rpx;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10rpx}.feature-item{min-height:92rpx;padding:16rpx 12rpx;box-sizing:border-box;border-radius:14rpx;background:var(--nb-soft-surface)}.feature-number{color:var(--nb-muted);font-size:18rpx;font-weight:600}.feature-name{margin-top:8rpx;font-size:22rpx;font-weight:600;white-space:nowrap}.section-heading{padding:36rpx 8rpx 16rpx}.section-title{font-size:28rpx;font-weight:650}.info-card,.agreement-card{overflow:hidden;border-radius:24rpx;background:var(--nb-surface)}.info-item{min-height:88rpx;padding:14rpx 28rpx;display:flex;align-items:center;justify-content:space-between;gap:24rpx;border-bottom:1rpx solid var(--nb-border);box-sizing:border-box}.info-item:last-child{border-bottom:0}.info-label{flex-shrink:0;color:var(--nb-muted);font-size:22rpx}.info-value{max-width:430rpx;font-size:23rpx;line-height:1.5;text-align:right;overflow-wrap:anywhere}.agreement-row{min-height:96rpx;padding:0 28rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid var(--nb-border);font-size:24rpx}.agreement-row:last-child{border-bottom:0}.chevron{color:var(--nb-muted);font-size:34rpx}.copyright{margin-top:36rpx;color:var(--nb-muted);font-size:20rpx;text-align:center}
