.container { min-height: 100vh; background: var(--bg-gradient-entry); padding: 60rpx 40rpx; }
.logo-section { display: flex; flex-direction: column; align-items: center; margin-bottom: 60rpx; }
.logo { width:120rpx; height:120rpx; margin-bottom:20rpx; display:flex; align-items:center; justify-content:center; border-radius: var(--radius-lg); background:linear-gradient(135deg,#ffcedd,#dfd2ff); }.logo-mark { width:42rpx; height:70rpx; border:6rpx solid #a75679; border-radius: var(--radius-md) 24rpx 14rpx 14rpx; transform:rotate(18deg); box-sizing:border-box; }
.app-name { font-size: var(--font-2xl); font-weight: var(--weight-bold); color: var(--text-primary); margin-bottom: 10rpx; }
.version { font-size: var(--font-sm); color: var(--text-muted); }
.info-card { background: var(--bg-gradient-entry); border-radius: var(--radius-md); overflow: hidden; margin-bottom: 40rpx; }
.info-item { padding: 28rpx 40rpx; }
.info-item-border { border-top: 1rpx solid var(--border-card); border-bottom: 1rpx solid var(--border-card); }
.info-label { display: block; font-size: var(--font-sm); color: var(--text-muted); margin-bottom: 8rpx; }
.info-value { display: block; font-size: var(--font-md); color: var(--text-primary); line-height: var(--leading-normal); }
.copyright { display: block; text-align: center; font-size: var(--font-sm); color: var(--text-muted); }
.agreement-row { display:flex; min-height:88rpx; padding:0 40rpx; align-items:center; justify-content:space-between; border-top:1rpx solid #f0e7eb; color:#4d3a43; font-size: var(--font-sm); }
