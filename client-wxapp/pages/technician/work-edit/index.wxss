.container {
  min-height: 100vh;
  background: var(--bg-gradient-entry);
  padding-bottom: 160rpx;
}

.section {
  background: var(--bg-gradient-entry);
  margin-bottom: var(--space-sm);
  padding: 32rpx;
}

.form-item {
  margin-bottom: 32rpx;
}
.form-item:last-child { margin-bottom: 0; }

.label {
  font-size: var(--font-sm);
  color: var(--text-body);
  display: block;
  margin-bottom: var(--space-sm);
}

.input  {
  width: 100%;
  height: 88rpx;
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  padding: 0 24rpx;
  font-size: var(--font-md);
  color: var(--text-primary);
  box-sizing: border-box;
}

.textarea  {
  width: 100%;
  height: 200rpx;
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  padding: var(--space-md);
  font-size: var(--font-md);
  color: var(--text-primary);
  box-sizing: border-box;
}
.aesthetic-textarea { height: 240rpx; line-height:1.6; }

.cover-picker {
  width: 100%;
  height: 400rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
}
.cover-preview {
  width: 100%;
  height: 100%;
}
.cover-placeholder {
  width: 100%;
  height: 100%;
  background: var(--bg-gradient-entry);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.cover-icon {
  font-size: 80rpx;
  color: var(--text-muted);
  line-height: 1;
  margin-bottom: var(--space-sm);
}
.cover-hint {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.img-wrap {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}
.img-thumb {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-sm);
}
.img-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.6);
  color: var(--text-inverse);
  border-radius: 50%;
  font-size: var(--font-md);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.img-add {
  width: 180rpx;
  height: 180rpx;
  background: var(--bg-gradient-entry);
  border: 2rpx dashed #ddd;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}
.img-add-icon {
  font-size: 60rpx;
  color: var(--text-muted);
  line-height: 1;
}

.visible-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.visible-row .label { margin-bottom: 0; }

.access-section { border-top: 1rpx solid #f2e5eb; border-bottom: 1rpx solid #f2e5eb; }
.access-heading { min-height: 88rpx; display:flex; align-items:center; justify-content:space-between; gap:24rpx; }
.access-copy { flex:1; min-width:0; }.access-title,.access-sub,.permission-name,.permission-desc { display:block; }
.access-title { color:#372630; font-size: var(--font-md); font-weight: var(--weight-bold); }.access-sub { margin-top:8rpx; color:#8b7882; font-size: var(--font-xs); line-height: var(--leading-normal); }
.access-fields { margin-top:28rpx; padding-top:28rpx; border-top:1rpx solid #eee3e8; }
.picker-field { min-height:88rpx; padding:0 24rpx; border-radius: var(--radius-sm); display:flex; align-items:center; justify-content:space-between; background: var(--bg-input); color:#352731; font-size: var(--font-sm); box-sizing:border-box; }
.picker-placeholder { color:#a2949b; }.picker-arrow { color:#9d8b94; font-size: var(--font-lg); }
.access-empty { padding:28rpx; border-radius: var(--radius-sm); background:#faf4f7; color:#8d7480; font-size: var(--font-sm); line-height:1.6; }
.permission-list { border-top:1rpx solid #eee3e8; }
.permission-row { min-height:112rpx; display:flex; align-items:center; justify-content:space-between; gap:24rpx; border-bottom:1rpx solid #f2eaee; }
.permission-row > view { flex:1; min-width:0; }.permission-name { color:#45333c; font-size: var(--font-sm); font-weight: var(--weight-semibold); }.permission-desc { margin-top:6rpx; color:#96868e; font-size: var(--font-xs); }
.grant-list { display:flex; flex-direction:column; gap:22rpx; }
.grant-card { padding: var(--space-md); border-radius:22rpx; background: var(--bg-card); border:1rpx solid #ecdde4; }
.grant-head { display:flex; align-items:center; justify-content:space-between; gap:20rpx; }.grant-name,.grant-index { display:block; }.grant-name { color:#3d2b34; font-size: var(--font-sm); font-weight: var(--weight-bold); }.grant-index { margin-top:5rpx; color:#9a8790; font-size: var(--font-xs); }.grant-remove { min-height:88rpx; padding:0 24rpx; border-radius: var(--radius-xl); display:flex; align-items:center; color:#c64663; background:#fff0f3; font-size: var(--font-xs); }
.grant-order { margin-top: var(--space-md); }

.footer {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: var(--bg-gradient-entry);
  padding: var(--space-md) 40rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.06);
}
.btn-save {
  width: 100%;
  height: 96rpx;
  background: var(--brand-gradient);
  color: var(--text-inverse);
  border-radius: var(--btn-radius);
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-save[disabled] { opacity: 0.5; }
.grant-summary { margin-top:20rpx; padding:20rpx 22rpx; border-radius: var(--card-radius); background:#f8f3f6; }
.grant-summary-title,.grant-summary-order,.grant-summary-permissions { display:block; }
.grant-summary-title { color:#543d49; font-size: var(--font-sm); font-weight: var(--weight-bold); }
.grant-summary-order { margin-top:9rpx; color:#765d6a; font-size: var(--font-xs); }
.grant-summary-permissions { margin-top:7rpx; color:#9a7888; font-size: var(--font-xs); line-height: var(--leading-normal); }
