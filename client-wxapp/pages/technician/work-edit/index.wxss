.container {
  min-height: 100vh;
  background: var(--nb-page);
  padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.section {
  margin: 24rpx 24rpx 0;
  padding: 28rpx;
  background: var(--nb-surface);
  border-radius: 24rpx;
  box-shadow: var(--shadow-sm);
}
.section-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:24rpx; margin-bottom:28rpx; }
.section-heading > view { flex:1; min-width:0; }
.section-title,.section-subtitle { display:block; }
.section-title { color:var(--nb-ink); font-size:var(--font-md); font-weight:var(--weight-semibold); line-height:1.35; }
.section-subtitle { margin-top:8rpx; color:var(--nb-muted); font-size:var(--font-xs); line-height:1.45; }
.required-mark,.section-count,.subsection-note,.selection-count { flex-shrink:0; padding:6rpx 14rpx; border-radius:999rpx; background:var(--nb-soft-surface); color:var(--nb-secondary); font-size:var(--font-xs); line-height:1.35; }
.field-heading { display:flex; align-items:center; justify-content:space-between; gap:20rpx; }
.field-heading .label { margin-bottom:0; }
.form-divider { height:16rpx; margin:8rpx -28rpx 28rpx; background:var(--nb-page); }
.subsection-heading { display:flex; align-items:center; justify-content:space-between; gap:20rpx; margin-bottom:24rpx; }
.subsection-title { color:var(--nb-ink); font-size:var(--font-sm); font-weight:var(--weight-semibold); }

.form-item {
  margin-bottom: 32rpx;
}
.form-item:last-child { margin-bottom: 0; }

.label {
  font-size: var(--font-sm);
  color: var(--nb-ink);
  font-weight: var(--weight-medium);
  display: block;
  margin-bottom: var(--space-sm);
}

.input  {
  width: 100%;
  height: var(--input-height);
  min-height: 44px;
  background: var(--bg-input);
  border-radius: var(--input-radius);
  padding: 0 var(--input-padding-h);
  font-size: var(--font-sm);
  font-weight: var(--weight-normal);
  color: var(--text-primary);
  box-sizing: border-box;
}

.textarea  {
  width: 100%;
  height: 200rpx;
  background: var(--bg-input);
  border-radius: var(--input-radius);
  padding: var(--space-md);
  font-size: var(--font-sm);
  font-weight: var(--weight-normal);
  color: var(--text-primary);
  box-sizing: border-box;
}
.aesthetic-textarea { height: 240rpx; line-height:1.6; }

.cover-picker {
  width: 100%;
  height: 360rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 20rpx;
  background: var(--nb-soft-surface);
  color: var(--nb-ink);
  line-height: normal;
  overflow: hidden;
}
.cover-picker::after,.img-add::after { border:0; }
.cover-picker.uploading,.img-add.uploading { opacity:.72; }
.cover-preview {
  width: 100%;
  height: 100%;
}
.cover-placeholder {
  width: 100%;
  height: 100%;
  background: var(--nb-soft-surface);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.cover-icon-wrap { width:72rpx; height:72rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; background:var(--nb-surface); }
.cover-icon {
  font-size: 48rpx;
  color: var(--nb-secondary);
  line-height: 1;
}
.cover-hint {
  margin-top:16rpx;
  font-size: var(--font-sm);
  color: var(--nb-ink);
  font-weight:var(--weight-medium);
}
.cover-subhint { margin-top:8rpx; color:var(--nb-muted); font-size:var(--font-xs); }

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.img-add { margin:0; padding:0; border:0; line-height:normal; }
.img-wrap {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}
.img-thumb {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-sm);
}
.img-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 44px;
  height: 44px;
  color: var(--text-inverse);
  border-radius: 50%;
  font-size: var(--font-md);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.img-remove-symbol { width:40rpx; height:40rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; background:rgba(0,0,0,0.6); }
.img-remove:active { opacity:.78; }
.img-add {
  width: 180rpx;
  height: 180rpx;
  background: var(--nb-soft-surface);
  border: 0;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}
.img-add-icon {
  font-size: 60rpx;
  color: var(--text-muted);
  line-height: 1;
}

.visible-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.visible-row > view { flex:1; min-width:0; }

.access-section { border-top: 0; border-bottom: 0; }
.access-heading { min-height: 88rpx; display:flex; align-items:center; justify-content:space-between; gap:24rpx; }
.access-copy { flex:1; min-width:0; }.access-title,.access-sub,.permission-name,.permission-desc { display:block; }
.access-title { color:var(--nb-ink); font-size:var(--font-md); font-weight:var(--weight-semibold); line-height:1.35; }.access-sub { margin-top:8rpx; color:var(--nb-muted); font-size:var(--font-xs); font-weight:var(--weight-normal); line-height:1.45; }
.access-fields { margin-top:24rpx; padding-top:0; background:transparent; }
.picker-field { min-height:max(44px, var(--input-height)); padding:12rpx var(--input-padding-h); border-radius:var(--input-radius); display:flex; align-items:center; justify-content:space-between; gap:16rpx; background:var(--bg-input); color:var(--nb-ink); font-size:var(--font-sm); font-weight:var(--weight-normal); line-height:1.5; box-sizing:border-box; }
.picker-placeholder { color:var(--nb-muted); }.picker-arrow { color:var(--nb-muted); font-size: var(--font-lg); }
.access-empty { padding:24rpx; border-radius:var(--radius-sm); background:var(--nb-soft-surface); color:var(--nb-muted); font-size:var(--font-sm); line-height:1.6; }
.permission-list { margin-top:20rpx; padding:0 20rpx; border-radius:16rpx; background:var(--nb-surface); }
.permission-row { min-height:112rpx; display:flex; align-items:center; justify-content:space-between; gap:24rpx; }
.permission-row > view { flex:1; min-width:0; }.permission-name { color:var(--nb-ink); font-size:var(--font-sm); font-weight:var(--weight-medium); }.permission-desc { margin-top:8rpx; color:var(--nb-muted); font-size:var(--font-xs); font-weight:var(--weight-normal); line-height:1.45; }
.grant-list { display:flex; flex-direction:column; gap:20rpx; }
.grant-card { padding:24rpx; border-radius:20rpx; background:var(--nb-page); }
.grant-head { display:flex; align-items:center; justify-content:space-between; gap:20rpx; }.grant-name,.grant-index { display:block; }.grant-name { color:var(--nb-ink); font-size:var(--font-sm); font-weight:var(--weight-medium); }.grant-index { margin-top:8rpx; color:var(--nb-muted); font-size:var(--font-xs); }.grant-remove { min-height:88rpx; padding:0 20rpx; border-radius:var(--radius-sm); display:flex; align-items:center; justify-content:center; font-size:var(--font-xs); font-weight:var(--weight-medium); }
.grant-order { margin-top: var(--space-md); }
.grant-order .picker-field { background:var(--nb-surface); }

.footer {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  z-index: 30;
  background: var(--nb-surface);
  padding: var(--space-md) 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.06);
  box-sizing: border-box;
}
.btn-save {
  width: 100%;
  min-height: 96rpx;
  margin: 0;
  padding: 0 32rpx;
  background: var(--nb-action);
  color: var(--text-inverse);
  border-radius: var(--btn-radius);
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.btn-save::after { border: 0; }
.btn-save[disabled] { opacity: 0.5; }
.field-help { display:block; margin:8rpx 0 18rpx; color:var(--nb-muted); font-size:var(--font-xs); line-height:1.55; }
.template-tags { display:flex; flex-wrap:wrap; gap:12rpx; margin-bottom:16rpx; }
.template-tag { min-height:44px; padding:0 22rpx; border-radius:999rpx; background:var(--nb-soft-surface); color:var(--nb-secondary); display:flex; align-items:center; font-size:var(--font-xs); font-weight:var(--weight-medium); box-sizing:border-box; }
.template-tag.selected { background:var(--nb-action); color:var(--text-inverse); }
.service-config-warning { margin-bottom:18rpx; padding:20rpx 22rpx; border-radius:16rpx; background:var(--nb-page); color:var(--nb-ink); font-size:24rpx; line-height:1.55; }
.service-config-action { display:inline-flex; min-height:44px; margin-top:8rpx; align-items:center; color:var(--nb-text-link); font-weight:600; }
.service-options { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:12rpx; }
.service-option { min-height:164rpx; padding:20rpx 12rpx 8rpx 20rpx; border: 0; border-radius:16rpx; background: var(--nb-soft-surface); display:flex; flex-direction:column; align-items:stretch; justify-content:space-between; box-sizing:border-box; }
.service-option.selected { background:var(--nb-active-surface); }
.service-option-invalid { background:var(--nb-page); opacity:.72; }
.service-option-copy,.service-option-name,.service-option-meta { display:block; }
.service-option-copy { flex:1; min-width:0; }
.service-option-name { color:var(--nb-ink); font-size:var(--font-sm); font-weight:var(--weight-medium); line-height:1.4; }
.service-option-meta { margin-top:8rpx; color:var(--nb-muted); font-size:var(--font-xs); font-weight:var(--weight-normal); line-height:1.4; }
.service-stepper { align-self:flex-end; display:flex; align-items:center; flex-shrink:0; }
.service-stepper-button { position:relative; width:44px; height:44px; min-height:44px; display:flex; align-items:center; justify-content:center; color:var(--nb-secondary); font-size:28rpx; font-weight:500; }
.service-stepper-button::before { content:''; position:absolute; width:48rpx; height:48rpx; border-radius:50%; background:var(--nb-page); }
.service-stepper-symbol { position:relative; z-index:1; line-height:1; }
.service-stepper-button:active::before { background:var(--nb-page); }
.service-stepper-button.plus { color:var(--nb-ink); }
.service-stepper-button.disabled { color:var(--nb-muted); }
.service-stepper-button.disabled::before { background:var(--nb-page); }
.service-stepper-button.disabled:active::before { background:var(--nb-page); }
.service-quantity { min-width:42rpx; line-height:88rpx; text-align:center; color:var(--nb-ink); font-size:var(--font-sm); font-weight:var(--weight-medium); font-variant-numeric:tabular-nums; }
.pricing-summary { margin-top:18rpx; padding:20rpx 22rpx; border-radius:16rpx; background:var(--nb-page); display:flex; align-items:center; justify-content:space-between; color:var(--nb-secondary); font-size:var(--font-xs); font-weight:var(--weight-normal); }
.price-breakdown { margin-top:20rpx; padding:20rpx 22rpx; border-radius:16rpx; background:var(--nb-page); }
.price-breakdown-line { min-height:48rpx; display:flex; align-items:center; justify-content:space-between; color:var(--nb-secondary); font-size:var(--font-xs); font-weight:var(--weight-normal); }
.price-breakdown-line.discount { color:var(--nb-money); }
.price-breakdown-line.surcharge { color:var(--nb-money); }
.price-breakdown-line.final { margin-top:12rpx; padding-top:16rpx; border-top: 0; color:var(--nb-money); font-weight:700; }
.grant-summary { margin-top:20rpx; padding:4rpx 0 0; background:transparent; }
.grant-summary-title,.grant-summary-order,.grant-summary-permissions { display:block; }
.grant-summary-title { color:var(--nb-secondary); font-size: var(--font-sm); font-weight: var(--weight-bold); }
.grant-summary-order { margin-top:9rpx; color:var(--nb-secondary); font-size: var(--font-xs); }
.grant-summary-permissions { margin-top:7rpx; color:var(--nb-muted); font-size: var(--font-xs); line-height: var(--leading-normal); }

@import '../../../styles/booking-actions.wxss';
.form-placeholder { font-size:var(--font-sm); color:var(--nb-muted); }
.picker-arrow { flex-shrink:0; }
.template-tag:active,.picker-field:active,.service-config-action:active { opacity:.78; }

/* 快速发布流程 */
.draft-row { min-height:88rpx; padding:0 28rpx; display:flex; align-items:center; justify-content:space-between; box-sizing:border-box; }
.draft-hint { color:var(--nb-muted); font-size:var(--font-xs); }
.draft-action { min-height:44px; padding:0 16rpx; display:flex; align-items:center; color:var(--nb-text-link); font-size:var(--font-sm); font-weight:var(--weight-medium); }
.photo-section { margin-top:0; }
.compact-heading { align-items:center; }
.section-action { min-width:144rpx; min-height:44px; margin:0; padding:0 20rpx; display:flex; align-items:center; justify-content:center; border:0; border-radius:16rpx; background:var(--nb-action); color:var(--text-inverse); font-size:var(--font-xs); font-weight:var(--weight-semibold); line-height:1.3; }
.section-action::after,.photo-tile::after { border:0; }
.photo-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12rpx; }
.photo-tile { position:relative; width:100%; aspect-ratio:1; min-height:0; margin:0; padding:0; overflow:hidden; border:0; border-radius:16rpx; background:var(--nb-soft-surface); line-height:normal; }
.photo-image { width:100%; height:100%; }
.photo-placeholder,.add-tile { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10rpx; color:var(--nb-muted); font-size:var(--font-xs); }
.photo-placeholder { width:100%; height:100%; }
.photo-placeholder image { width:44rpx; height:44rpx; opacity:.68; }
.cover-badge { position:absolute; left:10rpx; bottom:10rpx; padding:6rpx 12rpx; border-radius:10rpx; background:rgba(0,0,0,.72); color:#fff; font-size:20rpx; line-height:1.2; }
.compact-field { min-height:96rpx; margin-bottom:24rpx; padding:0 22rpx; display:flex; align-items:center; gap:24rpx; border-radius:16rpx; background:var(--nb-soft-surface); box-sizing:border-box; }
.compact-label { width:132rpx; flex-shrink:0; color:var(--nb-ink); font-size:var(--font-sm); font-weight:var(--weight-medium); }
.compact-input { flex:1; min-width:0; min-height:44px; color:var(--nb-ink); font-size:var(--font-sm); text-align:right; }
.price-input { flex:1; min-height:44px; display:flex; align-items:center; justify-content:flex-end; gap:8rpx; color:var(--nb-ink); font-size:var(--font-sm); }
.price-input input { width:180rpx; min-height:44px; text-align:right; }
.smart-summary { margin-top:-8rpx; padding:18rpx 22rpx; display:flex; flex-wrap:wrap; gap:12rpx 24rpx; border-radius:16rpx; background:var(--nb-page); color:var(--nb-secondary); font-size:var(--font-xs); }
.display-options { display:flex; flex-direction:column; gap:12rpx; }
.display-option { min-height:104rpx; padding:16rpx 20rpx; display:flex; align-items:center; gap:18rpx; border:2rpx solid transparent; border-radius:16rpx; background:var(--nb-soft-surface); box-sizing:border-box; }
.display-option.selected { border-color:var(--nb-action); background:var(--nb-active-surface); }
.display-check { width:40rpx; height:40rpx; flex-shrink:0; display:flex; align-items:center; justify-content:center; border:2rpx solid var(--nb-muted); border-radius:50%; color:var(--text-inverse); font-size:22rpx; }
.display-option.selected .display-check { border-color:var(--nb-action); background:var(--nb-action); }
.display-title,.display-desc { display:block; }
.display-title { color:var(--nb-ink); font-size:var(--font-sm); font-weight:var(--weight-medium); }
.display-desc { margin-top:6rpx; color:var(--nb-muted); font-size:var(--font-xs); }
.share-tip { display:block; margin-top:20rpx; color:var(--nb-muted); font-size:var(--font-xs); line-height:1.5; }
.more-trigger { min-height:88rpx; display:flex; align-items:center; justify-content:space-between; gap:20rpx; }
.more-arrow { color:var(--nb-muted); font-size:var(--font-lg); }
.more-content { margin-top:24rpx; padding-top:24rpx; border-top:1rpx solid var(--nb-soft-surface); }
.short-textarea { height:144rpx; }
.promotion-fields { display:flex; flex-direction:column; gap:16rpx; margin-top:20rpx; }
.publish-summary { min-height:48rpx; margin-bottom:12rpx; display:flex; align-items:center; justify-content:space-between; color:var(--nb-muted); font-size:var(--font-xs); }
.publish-price { color:var(--nb-money); font-size:var(--font-md); font-weight:var(--weight-bold); }
.btn-save { min-height:44px; height:88rpx; }
