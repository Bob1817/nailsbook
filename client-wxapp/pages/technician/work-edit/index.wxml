<nav-bar title="编辑作品" showBack/>
<view class="container">

  <view class="section">
    <view class="form-item">
      <text class="label">封面图片 *</text>
      <view class="cover-picker" bindtap="chooseCover">
    <image wx:if="{{coverUrl}}" class="cover-preview" src="{{coverUrl}}" mode="aspectFill" aria-label="作品封面预览"/>
        <view wx:else class="cover-placeholder">
          <text class="cover-icon">+</text>
          <text class="cover-hint">点击上传封面</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="form-item">
      <text class="label">作品标题 *</text>
      <input class="input" placeholder="给作品起个名字" value="{{title}}" data-field="title" bindinput="onInput" confirm-type="done" cursor-spacing="24"/>
    </view>
    <view class="form-item">
      <text class="label">基础服务组合 *</text>
      <text class="field-help">服务决定作品的价格基准、时长和预约占位</text>
      <view wx:if="{{hasInvalidServiceConfig}}" class="service-config-warning">
        <text>存在未配置有效时长的基础服务，完善后才能用于作品报价。</text>
        <text class="service-config-action" bindtap="goServiceManagement">前往服务管理</text>
      </view>
      <view class="service-options">
        <view wx:for="{{availableServices}}" wx:key="id" class="service-option {{item.quantity > 0 ? 'selected' : ''}} {{item.configurationValid ? '' : 'service-option-invalid'}}">
          <view class="service-option-copy"><text class="service-option-name">{{item.name}}</text><text class="service-option-meta">¥{{item.price}} · {{item.durationMinutes}} 分钟</text></view>
          <view class="service-stepper">
            <view class="service-stepper-button {{item.quantity <= 0 ? 'disabled' : ''}}" data-id="{{item.id}}" bindtap="decrementService" role="button" aria-label="减少{{item.name}}数量"><text class="service-stepper-symbol">−</text></view>
            <text class="service-quantity">{{item.quantity}}</text>
            <view class="service-stepper-button plus {{item.configurationValid ? '' : 'disabled'}}" data-id="{{item.id}}" bindtap="incrementService" role="button" aria-label="增加{{item.name}}数量"><text class="service-stepper-symbol">+</text></view>
          </view>
        </view>
      </view>
      <view wx:if="{{selectedServiceIds.length}}" class="pricing-summary"><text>服务原价 ¥{{serviceSubtotalFen / 100}}</text><text>预计 {{totalDurationMinutes}} 分钟</text></view>
    </view>
    <view class="form-item">
      <text class="label">作品综合报价（元）*</text>
      <input class="input" type="digit" placeholder="请输入美甲师综合报价" value="{{standardPrice}}" data-field="standardPrice" bindinput="onInput" confirm-type="done" cursor-spacing="24"/>
      <text class="field-help">服务原价按各项基础服务的价格及数量累加，综合报价为客户预约同款时的最终报价</text>
      <view wx:if="{{selectedServiceIds.length && standardPrice}}" class="price-breakdown">
        <view class="price-breakdown-line"><text>服务原价</text><text>¥{{serviceSubtotalFen / 100}}</text></view>
        <view wx:if="{{priceDifferenceType === 'discount'}}" class="price-breakdown-line discount"><text>优惠</text><text>-¥{{priceDifferenceFen / 100}}</text></view>
        <view wx:elif="{{priceDifferenceType === 'surcharge'}}" class="price-breakdown-line surcharge"><text>其他</text><text>+¥{{priceDifferenceFen / 100}}</text></view>
        <view class="price-breakdown-line final"><text>作品综合报价</text><text>¥{{standardPrice}}</text></view>
      </view>
    </view>
    <view class="form-item">
      <text class="label">标签</text>
      <input class="input" placeholder="例：法式,渐变,春季（逗号分隔）" value="{{tags}}" data-field="tags" bindinput="onInput" confirm-type="done" />
    </view>
    <view class="form-item">
      <text class="label">描述</text>
      <textarea class="textarea" placeholder="作品介绍（选填）" value="{{description}}" data-field="description" bindinput="onInput" adjust-position cursor-spacing="120" confirm-type="done" />
    </view>
    <view class="form-item">
      <text class="label">设计理念</text>
      <textarea class="textarea aesthetic-textarea" placeholder="例如：以莫奈花园色彩为灵感，通过低饱和蓝绿色营造春日高级感" value="{{designIdea}}" data-field="designIdea" bindinput="onInput" maxlength="300" adjust-position cursor-spacing="120" confirm-type="done" />
    </view>
    <view class="form-item">
      <text class="label">适合场景</text>
      <input class="input" placeholder="例如：职场、约会、婚礼（逗号分隔）" value="{{suitableScene}}" data-field="suitableScene" bindinput="onInput" confirm-type="done" />
    </view>
    <view class="form-item">
      <text class="label">推荐指数</text>
      <picker mode="selector" range="{{recommendationOptions}}" value="{{recommendationScore - 1}}" bindchange="onRecommendationChange">
        <view class="picker-field">{{recommendationOptions[recommendationScore - 1]}}<text class="picker-arrow">›</text></view>
      </picker>
    </view>
  </view>

  <view class="section">
    <view class="form-item">
      <text class="label">更多图片（最多9张）</text>
      <view class="image-grid">
        <view class="img-wrap" wx:for="{{images}}" wx:key="index">
        <image class="img-thumb" src="{{item}}" mode="aspectFill" aria-label="作品图片"/>
          <view class="img-remove" bindtap="removeImage" data-index="{{index}}">×</view>
        </view>
        <view wx:if="{{images.length < 9}}" class="img-add" bindtap="addImage">
          <text class="img-add-icon">+</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section access-section">
    <view class="access-heading">
      <view class="access-copy">
        <text class="access-title">关联客户作品</text>
        <text class="access-sub">从已完成预约关联客户照片，并为客户设置查看与互动权限</text>
      </view>
      <switch checked="{{visibilityScope === 'authorized_clients'}}" bindchange="onScopeChange" color="#ec4899"/>
    </view>

    <view wx:if="{{visibilityScope === 'authorized_clients'}}" class="access-fields">
      <view wx:if="{{customerNames.length}}" class="form-item">
        <text class="label">添加授权客户 *</text>
        <picker mode="selector" range="{{customerNames}}" value="{{selectedCustomerIndex}}" bindchange="onCustomerChange">
          <view class="picker-field picker-placeholder">
            请选择已绑定客户端账号的客户
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
      <view wx:else class="access-empty">暂无可授权客户。客户完成账号绑定后即可关联作品。</view>

      <view wx:if="{{accessGrants.length}}" class="grant-list">
        <view wx:for="{{accessGrants}}" wx:key="customerId" wx:for-item="grant" wx:for-index="grantIndex" class="grant-card">
          <view class="grant-head">
            <view><text class="grant-name">{{grant.customerName}}</text><text class="grant-index">授权客户 {{grantIndex + 1}}</text></view>
            <view class="grant-remove" bindtap="removeGrant" data-index="{{grantIndex}}">移除</view>
          </view>
          <view class="form-item grant-order">
            <text class="label">关联预约（已完成优先）</text>
            <picker mode="selector" range="{{grant.orderNames}}" value="{{grant.selectedOrderIndex}}" bindchange="onGrantOrderChange" data-index="{{grantIndex}}">
              <view class="picker-field">{{grant.orderNames[grant.selectedOrderIndex]}}<text class="picker-arrow">›</text></view>
            </picker>
          </view>
          <view class="permission-list">
            <view class="permission-row"><view><text class="permission-name">允许分享</text><text class="permission-desc">客户可生成限时分享链接</text></view><switch checked="{{grant.canShare}}" data-index="{{grantIndex}}" data-field="canShare" bindchange="onGrantPermissionChange" color="#ec4899"/></view>
            <view class="permission-row"><view><text class="permission-name">允许收藏</text><text class="permission-desc">加入客户个人收藏</text></view><switch checked="{{grant.canFavorite}}" data-index="{{grantIndex}}" data-field="canFavorite" bindchange="onGrantPermissionChange" color="#ec4899"/></view>
            <view class="permission-row"><view><text class="permission-name">允许点赞</text><text class="permission-desc">对作品表达喜欢</text></view><switch checked="{{grant.canLike}}" data-index="{{grantIndex}}" data-field="canLike" bindchange="onGrantPermissionChange" color="#ec4899"/></view>
            <view class="permission-row"><view><text class="permission-name">允许评论</text><text class="permission-desc">在作品下留言交流</text></view><switch checked="{{grant.canComment}}" data-index="{{grantIndex}}" data-field="canComment" bindchange="onGrantPermissionChange" color="#ec4899"/></view>
          </view>
          <view class="grant-summary">
            <text class="grant-summary-title">关联与授权摘要</text>
            <text class="grant-summary-order">{{grant.selectedOrderText}}</text>
            <text class="grant-summary-permissions">客户可查看{{grant.canShare ? ' · 可分享' : ''}}{{grant.canFavorite ? ' · 可收藏' : ''}}{{grant.canLike ? ' · 可点赞' : ''}}{{grant.canComment ? ' · 可评论' : ''}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="section visible-row">
    <text class="label">公开展示</text>
    <switch checked="{{isVisible}}" bindchange="onVisibleChange" color="#ff6b9d"/>
  </view>

  <view class="footer">
    <button class="btn-save" bindtap="handleSubmit" disabled="{{submitting || uploading}}">
      {{submitting ? '保存中...' : (isEdit ? '保存修改' : '发布作品')}}
    </button>
  </view>

</view>
