<nav-bar title="{{isEdit ? '编辑作品' : '上传作品'}}" showBack/>
<view class="container">
  <view class="draft-row"><text class="draft-hint">先选照片，其他信息可稍后完善</text><view wx:if="{{!isEdit}}" class="draft-action" bindtap="saveDraft" role="button">保存草稿</view></view>

  <view class="section photo-section">
    <view class="section-heading compact-heading"><view><text class="section-title">作品照片</text><text class="section-subtitle">首张作为封面，最多 10 张</text></view><button class="section-action" catchtap="addImage" disabled="{{uploading}}">{{uploading ? '上传中' : '批量选择'}}</button></view>
    <view class="photo-grid">
      <button class="photo-tile cover-tile" catchtap="chooseCover" disabled="{{uploading}}"><image wx:if="{{coverUrl}}" class="photo-image" src="{{coverUrl}}" mode="aspectFill"/><view wx:else class="photo-placeholder"><image src="/static/icons/camera.svg" mode="aspectFit"/><text>添加封面</text></view><text wx:if="{{coverUrl}}" class="cover-badge">封面</text></button>
      <view wx:if="{{item !== coverUrl}}" class="photo-tile" wx:for="{{images}}" wx:key="index"><image class="photo-image" src="{{item}}" mode="aspectFill"/><view class="img-remove" bindtap="removeImage" data-index="{{index}}" role="button" aria-label="移除第{{index + 1}}张作品图片"><text class="img-remove-symbol">×</text></view></view>
      <button wx:if="{{photoCount < 10}}" class="photo-tile add-tile" catchtap="addImage" disabled="{{uploading}}"><text>＋</text><text>继续添加</text></button>
    </view>
  </view>

  <view class="section">
    <view class="section-heading"><view><text class="section-title">基本信息</text><text class="section-subtitle">用于客户浏览和预约同款</text></view><text class="required-mark">必填</text></view>
    <view class="compact-field"><text class="compact-label">标题</text><input class="compact-input" placeholder-class="form-placeholder" placeholder="例如：轻法式晕染" value="{{title}}" data-field="title" bindinput="onInput"/></view>
    <view class="form-item"><text class="label">分类标签</text><view wx:if="{{workTagTemplates.length}}" class="template-tags"><view wx:for="{{workTagTemplates}}" wx:key="id" class="template-tag {{selectedWorkTagMap[item.name] ? 'selected' : ''}}" bindtap="toggleWorkTag" data-name="{{item.name}}">{{item.name}}</view></view><input class="input" placeholder-class="form-placeholder" placeholder="输入新分类，用逗号分隔" value="{{tags}}" data-field="tags" bindinput="onInput"/></view>
    <view class="form-item service-form-item">
      <view class="field-heading"><text class="label">关联服务</text><text wx:if="{{selectedServiceIds.length}}" class="selection-count">已选 {{selectedServiceIds.length}} 项</text></view>
      <view wx:if="{{hasInvalidServiceConfig}}" class="service-config-warning"><text>部分服务缺少有效时长</text><text class="service-config-action" bindtap="goServiceManagement">去完善</text></view>
      <view class="service-options"><view wx:for="{{availableServices}}" wx:key="id" class="service-option {{item.quantity > 0 ? 'selected' : ''}} {{item.configurationValid ? '' : 'service-option-invalid'}}"><view class="service-option-copy"><text class="service-option-name">{{item.name}}</text><text class="service-option-meta">¥{{item.price}} · {{item.durationMinutes}} 分钟</text></view><view class="service-stepper"><view class="service-stepper-button {{item.quantity <= 0 ? 'disabled' : ''}}" data-id="{{item.id}}" bindtap="decrementService"><text class="service-stepper-symbol">−</text></view><text class="service-quantity">{{item.quantity}}</text><view class="service-stepper-button plus {{item.configurationValid ? '' : 'disabled'}}" data-id="{{item.id}}" bindtap="incrementService"><text class="service-stepper-symbol">＋</text></view></view></view></view>
    </view>
    <view class="compact-field"><text class="compact-label">作品报价</text><view class="price-input"><text>¥</text><input type="digit" placeholder-class="form-placeholder" placeholder="0" value="{{standardPrice}}" data-field="standardPrice" bindinput="onInput"/></view></view>
    <view wx:if="{{selectedServiceIds.length}}" class="smart-summary"><text>服务原价 ¥{{serviceSubtotalFen / 100}}</text><text>预计 {{totalDurationMinutes}} 分钟</text><text wx:if="{{priceDifferenceType === 'discount'}}">优惠 ¥{{priceDifferenceFen / 100}}</text></view>
  </view>

  <view class="section">
    <view class="section-heading"><view><text class="section-title">展示位置</text><text class="section-subtitle">发布后仍可在作品管理中调整</text></view></view>
    <view class="display-options"><view wx:for="{{displayOptions}}" wx:key="key" class="display-option {{displayLevel === item.key ? 'selected' : ''}}" bindtap="setDisplayLevel" data-key="{{item.key}}" role="button"><view class="display-check">{{displayLevel === item.key ? '✓' : ''}}</view><view><text class="display-title">{{item.title}}</text><text class="display-desc">{{item.desc}}</text></view></view></view>
    <text class="share-tip">发布后可直接分享给客户，也可随时调整为首页主推</text>
  </view>

  <view class="section more-section">
    <view class="more-trigger" bindtap="toggleMoreSettings" role="button"><view><text class="section-title">更多设置</text><text class="section-subtitle">介绍、分享优惠与客户权限</text></view><text class="more-arrow">{{moreExpanded ? '⌃' : '⌄'}}</text></view>
    <view wx:if="{{moreExpanded}}" class="more-content">
      <view class="form-item"><text class="label">作品介绍</text><textarea class="textarea short-textarea" placeholder-class="form-placeholder" placeholder="补充设计亮点（选填）" value="{{description}}" data-field="description" bindinput="onInput"/></view>
      <view class="form-item"><text class="label">设计理念</text><textarea class="textarea short-textarea" placeholder-class="form-placeholder" placeholder="灵感与设计思路（选填）" value="{{designIdea}}" data-field="designIdea" bindinput="onInput" maxlength="300"/></view>
      <view class="form-item"><text class="label">适合场景</text><input class="input" placeholder-class="form-placeholder" placeholder="职场、约会、婚礼" value="{{suitableScene}}" data-field="suitableScene" bindinput="onInput"/></view>
      <view class="promotion-box"><view class="field-heading"><view><text class="label">分享预约优惠</text><text class="field-help">客户从分享入口预约时自动带出</text></view><nb-switch checked="{{promotionEnabled}}" bindchange="onPromotionEnabledChange" label="启用分享优惠"/></view><view wx:if="{{promotionEnabled}}" class="promotion-fields"><input class="input" type="digit" placeholder-class="form-placeholder" placeholder="优惠金额" value="{{promotionDiscount}}" data-field="promotionDiscount" bindinput="onPromotionInput"/><input class="input" maxlength="24" placeholder-class="form-placeholder" placeholder="优惠名称" value="{{promotionTitle}}" data-field="promotionTitle" bindinput="onPromotionInput"/><picker mode="date" value="{{promotionEndsAt}}" start="{{promotionEndsAt}}" bindchange="onPromotionEndChange"><view class="picker-field">{{promotionEndsAt ? '有效期至 ' + promotionEndsAt : '选择结束日期'}}<text>›</text></view></picker></view></view>
      <view class="access-heading"><view class="access-copy"><text class="access-title">仅指定客户可见</text><text class="access-sub">用于关联已完成预约的客户照片</text></view><nb-switch checked="{{visibilityScope === 'authorized_clients'}}" bindchange="onScopeChange" label="仅指定客户可见"/></view>
      <view wx:if="{{visibilityScope === 'authorized_clients'}}" class="access-fields"><picker wx:if="{{customerNames.length}}" mode="selector" range="{{customerNames}}" value="{{selectedCustomerIndex}}" bindchange="onCustomerChange"><view class="picker-field">添加授权客户<text>›</text></view></picker><view wx:else class="access-empty">暂无可授权客户</view><view wx:for="{{accessGrants}}" wx:key="customerId" wx:for-item="grant" wx:for-index="grantIndex" class="grant-card"><view class="grant-head"><text class="grant-name">{{grant.customerName}}</text><view class="grant-remove semantic-danger booking-action" bindtap="removeGrant" data-index="{{grantIndex}}">移除</view></view><picker mode="selector" range="{{grant.orderNames}}" value="{{grant.selectedOrderIndex}}" bindchange="onGrantOrderChange" data-index="{{grantIndex}}"><view class="picker-field">{{grant.orderNames[grant.selectedOrderIndex]}}<text>›</text></view></picker><view class="permission-list"><view class="permission-row"><text>允许分享</text><nb-switch checked="{{grant.canShare}}" data-index="{{grantIndex}}" data-field="canShare" bindchange="onGrantPermissionChange" label="允许分享"/></view><view class="permission-row"><text>允许收藏</text><nb-switch checked="{{grant.canFavorite}}" data-index="{{grantIndex}}" data-field="canFavorite" bindchange="onGrantPermissionChange" label="允许收藏"/></view></view></view></view>
    </view>
  </view>

  <view class="footer"><view class="publish-summary"><text>{{photoCount}} 张照片 · {{selectedServiceIds.length}} 项服务</text><text wx:if="{{standardPrice}}" class="publish-price">¥{{standardPrice}}</text></view><button class="btn-save booking-action" bindtap="handleSubmit" disabled="{{submitting || uploading}}">{{submitting ? '保存中...' : (isEdit ? '保存修改' : '确认发布')}}</button></view>
</view>
