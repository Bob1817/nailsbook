@import '../../../styles/booking-actions.wxss';
.shop-map-link{min-height:44px}.shop-map-link:active{opacity:.65}.shop-map-picker{display:flex;flex-direction:column;gap:12rpx;margin:16rpx 0}
.shop-map-picker .booking-action{width:100%}
.shop-map-hint{flex-shrink:0;font-size:var(--font-sm);color:var(--text-secondary)}

.container {
  min-height: 100vh;
  background: var(--nb-page);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 加载 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--nb-ink);
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ===== 空状态 ===== */
.empty, .load-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx var(--space-xl) 80rpx;
}
.shop-empty-mark {
  position: relative;
  width: 92rpx;
  height: 82rpx;
  box-sizing: border-box;
  margin-bottom: var(--space-lg);
  border: 0;
  border-radius: 10rpx;
}
.shop-awning {
  position: absolute;
  left: -4rpx;
  right: -4rpx;
  top: -4rpx;
  height: 28rpx;
  border: 0;
  border-radius: 10rpx 10rpx 16rpx 16rpx;
  background: var(--nb-page);
}
.shop-door {
  position: absolute;
  left: 34rpx;
  bottom: 0;
  width: 20rpx;
  height: 34rpx;
  background: var(--nb-page);
}
.load-error-mark {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: var(--space-lg);
  border-radius: 50%;
  background: var(--nb-page);
  color: var(--nb-ink);
  font-size: var(--font-xl);
  line-height: 88rpx;
  text-align: center;
}
.empty-text {
  font-size: var(--font-lg);
  color: var(--nb-ink);
  margin-bottom: 12rpx;
}
.empty-sub {
  font-size: var(--font-sm);
  color: var(--nb-muted);
  margin-bottom: 56rpx;
}
.btn-add-first {
  height: 88rpx;
  padding: 0 72rpx;
  background: var(--nb-action);
  color: var(--nb-inverse);
  border-radius: var(--radius-xl);
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  border: none;
  line-height: 88rpx;
}
.retry-btn {
  min-height: 88rpx;
  margin: 0;
  padding: 0 var(--space-xl);
  background: var(--nb-ink);
  color: var(--nb-inverse);
  font-size: var(--font-sm);
  line-height: 1.4;
}
.retry-btn::after { border: 0; }

/* ===== 列表 ===== */
.list {
  padding: var(--space-md);
}

/* ===== Airbnb 纯白店铺卡片 ===== */
.shop-card {
  background: var(--nb-surface);
  border: 1rpx solid var(--nb-line);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: var(--space-md);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.shop-card-disabled { opacity: 0.85; }
.card-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: var(--space-md);
}
.shop-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: var(--nb-soft-surface);
}
.shop-icon { width: 36rpx; height: 36rpx; }
.shop-card-disabled .shop-icon { opacity: .55; }
.shop-card-disabled .shop-icon-wrap { background: var(--nb-page); }
.shop-card-disabled .shop-name { color: var(--nb-secondary); }
.shop-card-disabled .shop-address,
.shop-card-disabled .shop-phone { color: var(--nb-muted); }
.card-title-area {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-xs);
}
.shop-name {
  min-width: 0;
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: var(--nb-ink);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.shop-status {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: var(--space-xs);
  min-height: 32rpx;
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
  color: var(--nb-muted);
}
.status-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--nb-control); }
.status-on .status-dot { background: var(--nb-success); }
.shop-meta { display: flex; flex-direction: column; padding: 0 4rpx; }
.shop-location-row { display: flex; align-items: flex-start; gap: 12rpx; }
.shop-location-icon { width: 28rpx; height: 28rpx; margin-top: 4rpx; flex-shrink: 0; opacity: .62; }
.shop-address {
  flex: 1;
  min-width: 0;
  font-size: var(--font-sm);
  color: var(--nb-secondary);
  line-height: 1.55;
}
.shop-phone-row { display: flex; align-items: center; gap: 12rpx; margin-top: 12rpx; }
.shop-phone-icon { width: 28rpx; height: 28rpx; flex-shrink: 0; opacity: .62; }
.shop-phone { font-size: var(--font-sm); color: var(--nb-secondary); }
.shop-guidance-link {
  position: relative;
  display: flex;
  align-items: center;
  align-self: flex-start;
  height:40rpx;
  margin:4rpx 0 0 var(--space-xl);
  color:var(--nb-text-link);
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
}
.shop-guidance-link::before {
  content: '';
  position: absolute;
  top: -24rpx;
  right: -20rpx;
  bottom: -24rpx;
  left: -20rpx;
}
.shop-guidance-link:active { opacity: .68; }
.shop-guidance-arrow { margin-left: var(--space-xs); color: var(--nb-text-link); font-size: var(--font-md); }

.card-settings {
  min-height: 112rpx;
  margin-top: 20rpx;
  padding: 0 var(--space-md);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  border-radius: 16rpx;
  background: var(--nb-page);
  border: 1rpx solid var(--nb-line);
}
.shop-enabled-copy { flex: 1; min-width: 0; }
.shop-enabled-title { display: block; width: 100%; white-space: nowrap; font-size: var(--font-sm); color: var(--nb-ink); font-weight: var(--weight-semibold); }
.shop-enabled-sub { display: block; width: 100%; margin-top: 4rpx; white-space: nowrap; font-size: var(--font-xs); color: var(--nb-muted); line-height: 1.4; }

.card-actions {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  min-height: 88rpx;
  margin-top: 20rpx;
}
.card-edit, .delete-card-action {
  flex: 1;
  min-width: 0;
  height: 44px;
  min-height: 44px;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  font-size: var(--font-sm);
  font-weight: var(--weight-semibold);
  line-height: 1.2;
  border-radius: 8px;
}
.card-edit { color: var(--nb-ink); background: var(--nb-soft-surface); }
.delete-card-action { color: var(--nb-danger); background: var(--nb-danger-surface); }
.card-edit.is-pressed, .delete-card-action.is-pressed { opacity: .78; }

/* ===== Airbnb Host FAB (添加店铺悬浮按钮) ===== */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(80rpx + env(safe-area-inset-bottom));
  width: 108rpx;
  height: 108rpx;
  background: var(--nb-action);
  border: 1rpx solid var(--nb-line);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.25);
  z-index: 50;
}
.fab:active {
  transform: scale(0.92);
}
.fab-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  display: block;
  font-size: 0;
}
.fab-icon::before,
.fab-icon::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 32rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--nb-inverse);
  transform: translate(-50%, -50%);
}
.fab-icon::after {
  transform: translate(-50%, -50%) rotate(90deg);
}

/* ===== 底部表单 (Airbnb Half-sheet Modal) ===== */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}
.form-sheet {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  height: 92vh;
  max-height: 92vh;
  background: var(--nb-surface);
  border-radius: 36rpx 36rpx 0 0;
  padding: 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
}
.form-sheet.show {
  transform: translateY(0);
}
.sheet-header {
  display: flex;
  align-items: center;
  min-height: 120rpx;
  padding: 0 36rpx;
  border-bottom: 1rpx solid var(--nb-line);
  background: var(--nb-surface);
  flex-shrink: 0;
  border-radius: 36rpx 36rpx 0 0;
}
.sheet-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  line-height: 1.25;
  color: var(--nb-ink);
}
.form-scroll {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
}
.form-section {
  margin: 0 var(--space-lg);
  padding: var(--space-xl) 0;
  border: 0;
  border-bottom: 1rpx solid var(--nb-line);
  border-radius: 0;
  background: var(--nb-surface);
  box-shadow: none;
}
.form-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-lg);
}
.form-section-title {
  font-size:var(--font-md);
  color: var(--nb-ink);
  line-height: 1.35;
  font-weight: var(--weight-bold);
}
.form-section-note {
  padding: 6rpx 14rpx;
  border-radius: var(--radius-full);
  background: var(--nb-soft-surface);
  color: var(--nb-ink);
  font-size: var(--font-xs);
  line-height: 1.3;
  font-weight: var(--weight-semibold);
}
.form-section-note-optional {
  background: var(--nb-page);
  color: var(--nb-muted);
}
.form-item {
  margin-bottom: 28rpx;
}
.form-item-last { margin-bottom: 0; }
.form-item-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  gap: var(--space-md);
}
.label {
  display: block;
  font-size: var(--font-sm);
  line-height: 1.4;
  color: var(--nb-ink);
  font-weight: var(--weight-medium);
  margin-bottom: 12rpx;
}
.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.label-link {
  font-size: var(--font-sm);
  color: var(--nb-text-link);
  font-weight: var(--weight-medium);
}
/* 地图选址 */
.location-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 120rpx;
  padding: 20rpx var(--input-padding-h);
  border: 2rpx solid transparent;
  border-radius: var(--input-radius);
  background: var(--nb-soft-surface);
  box-sizing: border-box;
}
.location-picker:active {
  border-color: var(--border-focus);
  background: var(--nb-surface);
}
.location-selected {
  border-color: var(--nb-line);
  background: var(--nb-soft-surface);
}
.location-loading { opacity: .62; }
.location-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  margin-right: 18rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--nb-page);
  flex-shrink: 0;
}
.location-icon { width: 32rpx; height: 32rpx; }
.location-copy { flex: 1; min-width: 0; }
.location-picker-text {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--nb-ink);
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
}
.location-picker-sub {
  display: block;
  margin-top: 6rpx;
  color: var(--nb-muted);
  font-size: var(--font-xs);
  line-height: 1.4;
}
.location-picker-arrow {
  color: var(--nb-muted);
  font-size: var(--font-lg);
  margin-left: 12rpx;
}

/* 地址指引 */
.label-group { flex: 1; min-width: 0; }
.switch-title {
  display: block;
  color: var(--nb-ink);
  font-size: var(--font-sm);
  line-height: 1.35;
  font-weight: var(--weight-medium);
}
.label-sub {
  display: block;
  margin-top: var(--space-xs);
  font-size: var(--font-xs);
  color: var(--nb-muted);
  line-height: 1.45;
}
.disclosure-item {
  padding-top: 20rpx;
  border-top: 1rpx solid var(--nb-line);
}
.guidance-setting {
  display: block;
  padding-top: var(--space-md);
}
.guidance-setting-row {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
}
.guidance-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  border-radius: var(--radius-sm);
  background: var(--nb-soft-surface);
  border: 1rpx solid var(--nb-line);
}
.guidance-entry:active { opacity: 0.7; }
.guidance-entry-copy { flex: 1; min-width: 0; }
.guidance-entry-text {
  display: block;
  font-size: var(--font-sm);
  color: var(--nb-text-link);
  font-weight: var(--weight-semibold);
}
.guidance-entry-sub {
  display: block;
  margin-top: 4rpx;
  color: var(--nb-muted);
  font-size: var(--font-xs);
}
.guidance-entry-arrow {
  color: var(--nb-text-link);
  font-size: var(--font-lg);
}

/* ===== 营业时间 ===== */
.business-hours-list {
  margin-top: var(--space-sm);
  background: var(--nb-page);
  border-radius: 18rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--nb-line);
}
.bh-item {
  min-height: 104rpx;
  border-bottom: 1rpx solid var(--nb-line);
}
.bh-item:last-child {
  border-bottom: none;
}
.bh-row {
  min-height: 104rpx;
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}
.bh-weekday {
  width: 64rpx;
  flex-shrink: 0;
  font-size: var(--font-sm);
  line-height: 1.3;
  font-weight: var(--weight-semibold);
  color: var(--nb-ink);
}
.bh-time {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: var(--space-xs);
}
.bh-time picker { flex: 1; min-width: 0; }
.bh-time-btn {
  width: 100%;
  min-height: 88rpx;
  background: var(--nb-surface);
  border: 1rpx solid var(--nb-line);
  border-radius: var(--radius-xs);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm);
  color: var(--nb-ink);
  font-weight: var(--weight-semibold);
  font-variant-numeric: tabular-nums;
}
.bh-time-sep {
  font-size: var(--font-xs);
  color: var(--nb-muted);
}
.bh-closed {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--nb-muted);
}

/* ===== 保存按钮 ===== */
.form-scroll-spacer { height: 24rpx; }
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-top: 12rpx;
}
.photo-cell {
  position: relative;
  width: 200rpx;
  height: 150rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: var(--nb-soft-surface);
  border: 1rpx solid var(--nb-line);
}
.photo-img {
  width: 100%;
  height: 100%;
  display: block;
}
.photo-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}
.photo-remove-icon {
  width: 20rpx;
  height: 20rpx;
}
.photo-add {
  width: 200rpx;
  height: 150rpx;
  border-radius: 12rpx;
  border: 1rpx dashed var(--nb-control);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: var(--nb-surface);
}
.photo-add-icon { width: var(--icon-md); height: var(--icon-md); }
.photo-add-text { font-size: var(--font-xs); color: var(--nb-muted); }

/* 店铺卡片环境图（名称与地址之间） */
.shop-card-photos {
  width: 100%;
  margin: var(--space-sm) 0 4rpx;
  white-space: nowrap;
}
.shop-card-photo-row {
  display: inline-flex;
  gap: 12rpx;
  padding-bottom: 4rpx;
}
.shop-card-photo {
  width: 220rpx;
  height: 150rpx;
  border-radius: 12rpx;
  background: var(--nb-soft-surface);
  border: 1rpx solid var(--nb-line);
  flex-shrink: 0;
}

.shop-region-picker{display:block;width:100%}.shop-region-value{display:flex;align-items:center;justify-content:space-between;gap:var(--space-sm);min-height:var(--input-height);font-size:var(--font-sm);line-height:1.5}.shop-region-value.is-placeholder{color:var(--nb-muted)}

.shop-region-value{height:var(--input-height);min-height:44px}
