.container {
  min-height: 100vh;
  background: #f6f7f9;
  padding-bottom: 140rpx;
}

/* ===== 加载 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #FF6B8A;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ===== 空状态 ===== */
.empty, .load-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx 80rpx;
}
.shop-empty-mark { position:relative; width:92rpx; height:82rpx; box-sizing:border-box; margin-bottom:32rpx; border:4rpx solid #d9a0b9; border-radius:10rpx; }
.shop-awning { position:absolute; left:-4rpx; right:-4rpx; top:-4rpx; height:28rpx; border:4rpx solid #d9a0b9; border-radius:10rpx 10rpx 16rpx 16rpx; background:#fff0f4; }
.shop-door { position:absolute; left:34rpx; bottom:0; width:20rpx; height:34rpx; background:#f3cfde; }
.load-error-mark { width:88rpx; height:88rpx; margin-bottom:32rpx; border-radius:50%; background:#fff0f4; color:#c75b83; font-size:44rpx; line-height:88rpx; text-align:center; }
.empty-text {
  font-size: 32rpx;
  color: #374151;
  margin-bottom: 12rpx;
}
.empty-sub {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 56rpx;
}
.btn-add-first {
  height: 88rpx;
  padding: 0 72rpx;
  background: linear-gradient(135deg, #ff6b8a, #a855f7);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  line-height: 88rpx;
}
.retry-btn { min-height:88rpx; margin:0; padding:0 56rpx; border:0; border-radius:44rpx; background:#1f2937; color:#fff; font-size:28rpx; line-height:88rpx; }
.retry-btn::after { border:0; }

/* ===== 列表 ===== */
.list {
  padding: 0 24rpx;
}

/* ===== 店铺卡片 ===== */
.shop-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}
.shop-card-active {
  border-left: 6rpx solid #22c55e;
}
.shop-card-disabled {
  border-left: 6rpx solid #d1d5db;
  opacity: 0.7;
}

.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.card-title-area {
  flex: 1;
  min-width: 0;
}
.shop-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.shop-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.3;
}
.shop-status {
  font-size: 20rpx;
  font-weight: 500;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}
.status-on {
  background: #dcfce7;
  color: #16a34a;
}
.status-off {
  background: #f3f4f6;
  color: #6b7280;
}
.shop-address {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.5;
  margin-bottom: 6rpx;
}
.shop-phone {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
}
.shop-switch {
  flex-shrink: 0;
  transform: scale(0.8);
}

/* ===== 操作按钮 ===== */
.card-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f3f4f6;
}
.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 500;
}
.action-btn:active {
  opacity: 0.65;
}
.action-edit {
  background: rgba(255, 107, 138, 0.08);
  color: #ff6b8a;
}
.action-delete {
  background: rgba(239, 68, 68, 0.06);
  color: #ef4444;
}

/* ===== FAB ===== */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(80rpx + env(safe-area-inset-bottom));
  width: 108rpx;
  height: 108rpx;
  background: linear-gradient(135deg, #ff6b8a, #a855f7);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 138, 0.35);
}
.fab:active {
  transform: scale(0.92);
}
.fab-icon {
  color: #fff;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}

/* ===== 底部表单 ===== */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}
.form-sheet {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  max-height: 90vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  display: flex;
  flex-direction: column;
}
.form-sheet.show {
  transform: translateY(0);
}
.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
  flex-shrink: 0;
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2937;
}
.sheet-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f3f4f6;
}
.sheet-close-icon {
  font-size: 36rpx;
  color: #6b7280;
  line-height: 1;
}
.form-scroll {
  flex: 1;
  min-height: 0;
  max-height: 60vh;
}
.form-item {
  margin-bottom: 28rpx;
}
.form-item-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.label {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}
.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.label-link {
  font-size: 26rpx;
  color: #ff6b8a;
  font-weight: 500;
}
.input {
  width: 100%;
  height: 88rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1f2937;
  box-sizing: border-box;
  line-height: 88rpx;
}
.picker-input {
  display: flex;
  align-items: center;
}
.picker-input.placeholder {
  color: #6b7280;
}
.ph {
  color: #6b7280;
}

/* ===== 营业时间 ===== */
.business-hours-list {
  background: #f9fafb;
  border-radius: 14rpx;
  padding: 16rpx;
}
.bh-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.bh-item:last-child {
  border-bottom: none;
}
.bh-day {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.bh-weekday {
  font-size: 28rpx;
  font-weight: 500;
  color: #374151;
}
.bh-switch {
  transform: scale(0.7);
}
.bh-time {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.bh-time-btn {
  flex: 1;
  height: 72rpx;
  background: #fff;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
}
.bh-time-sep {
  font-size: 26rpx;
  color: #6b7280;
}
.bh-closed {
  font-size: 26rpx;
  color: #6b7280;
  font-style: italic;
}

/* ===== 保存按钮 ===== */
.btn-save {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #ff6b8a, #a855f7);
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  margin-top: 20rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.btn-save text {
  line-height: 1;
}
.btn-save[disabled] {
  opacity: 0.45;
}
