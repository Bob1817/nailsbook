.container {
  min-height: 100vh;
  background: #f6f7f9;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

/* ===== 加载 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--brand-primary);
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ===== 空状态 ===== */
.empty, .load-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx 80rpx;
}
.shop-empty-mark { position:relative; width:92rpx; height:82rpx; box-sizing:border-box; margin-bottom:32rpx; border:4rpx solid #d9a0b9; border-radius:10rpx; }
.shop-awning { position:absolute; left:-4rpx; right:-4rpx; top:-4rpx; height:28rpx; border:4rpx solid #d9a0b9; border-radius:10rpx 10rpx 16rpx 16rpx; background:#fff0f4; }
.shop-door { position:absolute; left:34rpx; bottom:0; width:20rpx; height:34rpx; background:#f3cfde; }
.load-error-mark { width:88rpx; height:88rpx; margin-bottom:32rpx; border-radius:50%; background:#fff0f4; color:#c75b83; font-size: var(--font-xl); line-height:88rpx; text-align:center; }
.empty-text {
  font-size: var(--font-lg);
  color: var(--text-body);
  margin-bottom: 12rpx;
}
.empty-sub {
  font-size: var(--font-sm);
  color: var(--text-muted);
  margin-bottom: 56rpx;
}
.btn-add-first {
  height: 88rpx;
  padding: 0 72rpx;
  background: linear-gradient(135deg, #ff6b8a, #a855f7);
  color: var(--text-inverse);
  border-radius: var(--radius-xl);
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  border: none;
  line-height: 88rpx;
}
.retry-btn { min-height:88rpx; margin:0; padding:0 56rpx; border:0; border-radius: var(--radius-xl); background:#1f2937; color: var(--text-inverse); font-size: var(--font-md); line-height:88rpx; }
.retry-btn::after { border:0; }

/* ===== 列表 ===== */
.list {
  padding: 24rpx;
}

/* ===== 店铺卡片 ===== */
.shop-card {
  background: var(--bg-card);
  border: 1rpx solid rgba(34, 34, 34, 0.08);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(34, 34, 34, 0.04);
}
.shop-card-disabled {
  opacity: 0.72;
}
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 22rpx;
}
.card-title-area {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.shop-name {
  min-width: 0;
  font-size: 30rpx;
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.shop-status {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
  color: var(--text-muted);
}
.status-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--text-muted); }
.status-on .status-dot { background: #22a06b; }
.card-edit {
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-body);
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  border-radius: var(--radius-sm);
  background: var(--bg-input);
}
.card-edit:active { opacity: .65; }
.shop-location-row { display: flex; align-items: flex-start; gap: 12rpx; }
.shop-location-icon { width: 28rpx; height: 28rpx; margin-top: 4rpx; flex-shrink: 0; opacity: .62; }
.shop-address {
  flex: 1;
  min-width: 0;
  font-size: var(--font-sm);
  color: var(--text-body);
  line-height: 1.55;
}
.shop-phone {
  display: block;
  margin: 12rpx 0 0 40rpx;
  font-size: var(--font-sm);
  color: var(--text-muted);
}
.card-settings {
  min-height: 104rpx;
  margin-top: 24rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border-radius: 16rpx;
  background: #f7f7f8;
}
.shop-enabled-copy { flex: 1; min-width: 0; }
.shop-enabled-title { display: block; font-size: var(--font-sm); color: var(--text-primary); font-weight: var(--weight-semibold); }
.shop-enabled-sub { display: block; margin-top: 4rpx; font-size: var(--font-xs); color: var(--text-muted); line-height: 1.4; }
.shop-switch { flex-shrink: 0; transform: scale(.78); }
.card-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  margin-top: 12rpx;
}
.guidance-card-action, .delete-card-action {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
}
.guidance-card-action { color: var(--text-body); }
.action-arrow { color: var(--text-muted); font-size: var(--font-md); }
.delete-card-action { margin-left: auto; padding-left: 32rpx; color: var(--text-muted); }
.guidance-card-action:active, .delete-card-action:active { opacity: .6; }

/* ===== FAB ===== */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(80rpx + env(safe-area-inset-bottom));
  width: 108rpx;
  height: 108rpx;
  background: linear-gradient(135deg, #ff6b8a, #a855f7);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(255,107,138,0.35) /* brand-primary-alpha */;
}
.fab:active {
  transform: scale(0.92);
}
.fab-icon {
  color: var(--text-inverse);
  font-size: var(--font-2xl);
  font-weight: 300;
  line-height: 1;
}

/* ===== 底部表单 ===== */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}
.form-sheet {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  height: 92vh;
  max-height: 92vh;
  background: #f7f7f8;
  border-radius: 36rpx 36rpx 0 0;
  padding: 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  display: flex;
  flex-direction: column;
}
.form-sheet.show {
  transform: translateY(0);
}
.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid rgba(34,34,34,.08);
  background: var(--bg-card);
  flex-shrink: 0;
}
.sheet-title {
  font-size: 36rpx;
  font-weight: var(--weight-bold);
  color: var(--text-primary);
}
.sheet-close {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: transparent;
}
.sheet-close:active { background: var(--bg-input); }
.sheet-close-icon {
  font-size: var(--font-lg);
  color: var(--text-muted);
  line-height: 1;
}
.form-scroll {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
}
.form-section { margin: 24rpx 24rpx 0; padding: 28rpx; border:1rpx solid rgba(34,34,34,.08); border-radius:24rpx; background:var(--bg-card); box-shadow:0 4rpx 16rpx rgba(34,34,34,.035); }
.form-section-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:28rpx; }
.form-section-title { color:var(--text-primary); font-size:30rpx; line-height:1.3; font-weight:var(--weight-bold); }
.form-section-note { padding:4rpx 12rpx; border-radius:999rpx; background:rgba(255,107,138,.1); color:var(--brand-primary); font-size:20rpx; font-weight:var(--weight-semibold); }
.form-section-note-optional { background:#f2f2f3; color:var(--text-muted); }
.form-item {
  margin-bottom: 24rpx;
}
.form-item-last { margin-bottom:0; }
.form-item-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height:88rpx;
  gap:24rpx;
}
.label {
  display: block;
  font-size: 26rpx;
  color: var(--text-body);
  font-weight:var(--weight-semibold);
  margin-bottom: 12rpx;
}
.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.label-link {
  font-size: var(--font-sm);
  color: var(--brand-primary);
  font-weight: var(--weight-medium);
}
.input {
  width: 100%;
  height: 88rpx;
  background: #f7f7f8;
  border:1rpx solid transparent;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: var(--font-md);
  color: var(--text-primary);
  box-sizing: border-box;
  line-height: 88rpx;
}
.input:focus { background:var(--bg-card); border-color:var(--brand-primary); box-shadow:0 0 0 4rpx rgba(255,107,138,.1); }
.picker-input {
  display: flex;
  align-items: center;
}
.picker-input.placeholder {
  color: var(--text-muted);
}
.ph {
  color: var(--text-muted);
}

/* 地图选址 */
.location-picker {
  display:flex;
  align-items:center;
  justify-content: space-between;
  min-height:112rpx;
  padding: 18rpx 20rpx;
  border:1rpx solid rgba(34,34,34,.1);
  border-radius:18rpx;
  background:#fff;
  box-sizing:border-box;
}
.location-picker:active { background:#f7f7f8; }
.location-selected { border-color:rgba(255,107,138,.42); background:rgba(255,107,138,.035); }
.location-loading { opacity:.62; }
.location-icon-wrap { width:64rpx; height:64rpx; margin-right:16rpx; border-radius:16rpx; display:flex; align-items:center; justify-content:center; background:rgba(255,107,138,.1); flex-shrink:0; }
.location-icon { width:32rpx; height:32rpx; }
.location-copy { flex:1; min-width:0; }
.location-picker-text {
  display:block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color:var(--text-primary);
  font-size:26rpx;
  font-weight:var(--weight-semibold);
}
.location-picker-sub { display:block; margin-top:6rpx; color:var(--text-muted); font-size:20rpx; line-height:1.35; }
.location-picker-arrow {
  color: var(--text-muted);
  font-size: var(--font-lg);
  margin-left: 12rpx;
}
/* 地址指引 */
.label-group { flex: 1; min-width: 0; }
.switch-title { display:block; color:var(--text-primary); font-size:28rpx; line-height:1.35; font-weight:var(--weight-semibold); }
.label-sub { display: block; margin-top: 6rpx; font-size:22rpx; color: var(--text-muted); line-height:1.45; }
.disclosure-item { padding-top:20rpx; border-top:1rpx solid rgba(34,34,34,.08); }
.guidance-setting {
  display: block;
  padding-top: 24rpx;
}
.guidance-setting-row {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}
.guidance-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  margin-top: 20rpx;
  padding: 12rpx 20rpx;
  box-sizing: border-box;
  border-radius: var(--radius-sm);
  background: rgba(255,107,138,0.06) /* brand-primary-alpha */;
}
.guidance-entry:active { opacity: 0.7; }
.guidance-entry-copy { flex: 1; min-width: 0; }
.guidance-entry-text { display: block; font-size: var(--font-sm); color: var(--brand-primary); font-weight: var(--weight-semibold); }
.guidance-entry-sub { display: block; margin-top: 4rpx; color: var(--text-muted); font-size: var(--font-xs); }
.guidance-entry-arrow { color: var(--brand-primary); font-size: var(--font-lg); }
/* ===== 营业时间 ===== */
.business-hours-list {
  margin-top:16rpx;
  background: #f7f7f8;
  border-radius: 18rpx;
  padding: 0 20rpx;
}
.bh-item {
  min-height: 104rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.bh-item:last-child {
  border-bottom: none;
}
.bh-row {
  min-height: 104rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.bh-weekday {
  width: 64rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  line-height: 1.3;
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}
.bh-switch {
  margin-left: auto;
  flex-shrink: 0;
  transform: scale(0.7);
}
.bh-time {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8rpx;
}
.bh-time picker { flex: 1; min-width: 0; }
.bh-time-btn {
  width: 100%;
  min-height: 88rpx;
  background: var(--bg-card);
  border-radius: var(--radius-xs);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: var(--weight-semibold);
  font-variant-numeric: tabular-nums;
}
.bh-time-sep {
  font-size: 22rpx;
  color: var(--text-muted);
}
.bh-closed {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* ===== 保存按钮 ===== */
.form-scroll-spacer { height:24rpx; }
.sheet-footer { padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); border-top:1rpx solid rgba(34,34,34,.08); background:rgba(255,255,255,.96); flex-shrink:0; }
.btn-save {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #ff6b8a, #a855f7);
  color: var(--text-inverse);
  border-radius: 18rpx;
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  margin: 0;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.btn-save text {
  line-height: 1;
}
.btn-save[disabled] {
  opacity: 0.45;
}
