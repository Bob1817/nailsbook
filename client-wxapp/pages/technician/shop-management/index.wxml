<page-meta page-style="{{showAddModal ? 'overflow: hidden;' : ''}}"/>
<nav-bar title="店铺管理" showBack/>
<view class="container">

  <view wx:if="{{loading}}" class="loading-wrap"><view class="loading-spinner"></view></view>

  <view wx:elif="{{loadFailed}}" class="load-error" aria-live="polite">
    <view class="load-error-mark">!</view>
    <text class="empty-text">店铺信息加载失败</text>
    <text class="empty-sub">请检查网络后重试</text>
    <button class="retry-btn" bindtap="loadShops">重新加载</button>
  </view>

  <view wx:else>
    <!-- 空状态 -->
    <view wx:if="{{shops.length === 0}}" class="empty">
      <view class="shop-empty-mark"><view class="shop-awning"></view><view class="shop-door"></view></view>
      <text class="empty-text">还没有店铺</text>
      <text class="empty-sub">添加你的店铺信息，方便客户到店</text>
      <button class="btn-add-first" bindtap="openAdd">添加第一个店铺</button>
    </view>

    <!-- 店铺列表 -->
    <view wx:else class="list">
      <view wx:for="{{shops}}" wx:key="name" class="shop-card {{item.enabled ? 'shop-card-active' : 'shop-card-disabled'}}">
        <view class="card-header">
          <view class="card-title-area">
            <text class="shop-name">{{item.name}}</text>
            <view class="shop-status {{item.enabled ? 'status-on' : 'status-off'}}">
              <view class="status-dot"></view><text>{{item.enabled ? '营业中' : '已停用'}}</text>
            </view>
          </view>
          <view class="card-edit" bindtap="openEdit" data-shop="{{item}}" role="button" aria-label="编辑{{item.name}}"><text>编辑</text></view>
        </view>
        <view class="shop-location-row">
          <image class="shop-location-icon" src="/static/icons/pin.svg" mode="aspectFit" />
          <text class="shop-address">{{item.province}}{{item.city}}{{item.district}}{{item.detailAddress}}</text>
        </view>
        <text wx:if="{{item.phone}}" class="shop-phone">{{item.phone}}</text>
        <view class="card-settings">
          <view class="shop-enabled-copy"><text class="shop-enabled-title">启用店铺</text><text class="shop-enabled-sub">可作为客户预约的到店地点</text></view>
          <switch checked="{{item.enabled}}" bindchange="toggleShopEnabled" data-name="{{item.name}}" data-address="{{item.detailAddress}}" color="#FF6B8A" class="shop-switch"/>
        </view>
        <view class="card-actions">
          <view wx:if="{{item.guidance && item.guidance.enabled}}" class="guidance-card-action" catchtap="openGuidanceEdit" data-name="{{item.name}}" data-address="{{item.detailAddress}}" role="button" aria-label="编辑{{item.name}}的到店指引">
            <text>到店指引</text><text class="action-arrow">›</text>
          </view>
          <view class="delete-card-action" bindtap="deleteShop" data-name="{{item.name}}" data-address="{{item.detailAddress}}" role="button" aria-label="删除{{item.name}}">
            <text>删除</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- FAB 添加按钮 -->
  <view wx:if="{{shops.length > 0 && !loadFailed}}" class="fab" bindtap="openAdd">
    <text class="fab-icon">+</text>
  </view>

  <!-- 底部表单 -->
  <view wx:if="{{showAddModal}}" class="mask" bindtap="closeModal"/>
  <view class="form-sheet {{showAddModal ? 'show' : ''}}">
    <view class="sheet-header">
      <text class="sheet-title">{{editShop ? '编辑店铺' : '添加店铺'}}</text>
      <view class="sheet-close" bindtap="closeModal" role="button" aria-label="关闭店铺编辑弹窗">
        <text class="sheet-close-icon">×</text>
      </view>
    </view>

    <scroll-view scroll-y class="form-scroll">
      <view class="form-section">
        <view class="form-section-head"><text class="form-section-title">基本信息</text><text class="form-section-note">必填</text></view>
        <view class="form-item">
          <text class="label">店铺名称</text>
          <input class="input" value="{{name}}" bindinput="onNameInput" placeholder="例如：贝贝美甲工作室" placeholder-class="ph" confirm-type="done" />
        </view>
        <view class="form-item">
          <text class="label">所在地区</text>
          <picker mode="region" value="{{region}}" bindchange="onRegionChange">
            <view class="input picker-input {{regionText ? '' : 'placeholder'}}">{{regionText || '请选择省市区'}}</view>
          </picker>
        </view>
        <view class="form-item">
          <text class="label">详细地址</text>
          <input class="input" value="{{detailAddress}}" bindinput="onDetailAddressInput" placeholder="街道、楼栋、门牌号" placeholder-class="ph" confirm-type="done" />
        </view>
        <view class="form-item form-item-last">
          <text class="label">地图定位</text>
          <view class="location-picker {{locationText ? 'location-selected' : ''}} {{locating ? 'location-loading' : ''}}" bindtap="chooseLocation" role="button" aria-label="选择店铺地图位置">
            <view class="location-icon-wrap"><image class="location-icon" src="/static/icons/pin.svg" mode="aspectFit" /></view>
            <view class="location-copy">
              <text class="location-picker-text">{{locating ? '正在打开地图…' : (locationText || '在地图上选择店铺位置')}}</text>
              <text class="location-picker-sub">{{locationText ? '已保存经纬度，点击可重新选择' : '用于客户一键导航，不会替换上方详细地址'}}</text>
            </view>
            <text class="location-picker-arrow">›</text>
          </view>
        </view>
      </view>

      <view class="form-section">
        <view class="form-section-head"><text class="form-section-title">经营设置</text><text class="form-section-note form-section-note-optional">可选</text></view>
        <view class="form-item">
          <text class="label">联系电话</text>
          <input class="input" type="number" value="{{phone}}" bindinput="onPhoneInput" placeholder="客户需要时可联系店铺" placeholder-class="ph" confirm-type="done" />
        </view>
        <view class="form-item form-item-switch">
          <view class="label-group"><text class="switch-title">启用店铺</text><text class="label-sub">启用后可作为预约到店地点</text></view>
          <switch checked="{{enabled}}" bindchange="toggleEnabled" color="#FF6B8A"/>
        </view>

        <view class="form-item disclosure-item">
        <view class="label-row" bindtap="toggleBusinessHours" role="button" aria-label="展开或收起营业时间设置">
          <view><text class="switch-title">营业时间</text><text class="label-sub">不同日期可单独设置</text></view>
          <text class="label-link">{{showBusinessHours ? '收起 ⌃' : '设置 ›'}}</text>
        </view>
        <view wx:if="{{showBusinessHours}}" class="business-hours-list">
          <view wx:for="{{businessHours}}" wx:key="weekday" class="bh-item">
            <view class="bh-row">
              <text class="bh-weekday">{{weekdayNames[item.weekday]}}</text>
              <view wx:if="{{!item.closed}}" class="bh-time">
                <picker mode="selector" range="{{timeOptions}}" value="{{timeOptions.indexOf(item.start)}}" bindchange="onStartTimeChange" data-idx="{{index}}">
                  <view class="bh-time-btn">{{item.start}}</view>
                </picker>
                <text class="bh-time-sep">—</text>
                <picker mode="selector" range="{{timeOptions}}" value="{{timeOptions.indexOf(item.end)}}" bindchange="onEndTimeChange" data-idx="{{index}}">
                  <view class="bh-time-btn">{{item.end}}</view>
                </picker>
              </view>
              <text wx:else class="bh-closed">休息</text>
              <switch checked="{{!item.closed}}" bindchange="toggleDayClosed" data-idx="{{index}}" color="#FF6B8A" class="bh-switch"/>
            </view>
          </view>
        </view>
      </view>

      <view class="form-item guidance-setting form-item-last">
        <view class="guidance-setting-row">
          <view class="label-group">
            <text class="switch-title">到店指引</text>
            <text class="label-sub">开启后客户可查看地铁、公交和开车指引</text>
          </view>
          <switch checked="{{guidanceEnabled}}" bindchange="toggleGuidanceEnabled" color="#FF6B8A" disabled="{{!detailAddress}}"/>
        </view>
        <view wx:if="{{guidanceEnabled}}" class="guidance-entry" catchtap="openGuidanceEdit" role="button" aria-label="编辑到店指引">
          <view class="guidance-entry-copy">
            <text class="guidance-entry-text">编辑指引内容</text>
            <text class="guidance-entry-sub">按到店顺序添加文字和图片</text>
          </view>
          <text class="guidance-entry-arrow">›</text>
        </view>
      </view>
      </view>
      <view class="form-scroll-spacer"></view>
    </scroll-view>

    <view class="sheet-footer"><button class="btn-save" bindtap="save" disabled="{{saving}}"><text>{{saving ? '保存中…' : '保存店铺'}}</text></button></view>
  </view>
</view>
