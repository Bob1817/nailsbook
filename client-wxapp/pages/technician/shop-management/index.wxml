<view class="container">
  <view wx:if="{{loading}}" class="loading-wrap"><view class="loading-spinner"></view></view>

  <view wx:else>
    <view class="add-btn" bindtap="openAdd">+ 添加店铺</view>

    <view wx:if="{{shops.length === 0}}" class="empty">
      <text class="empty-icon">🏪</text>
      <text class="empty-text">还没有店铺，添加一个吧</text>
    </view>

    <view wx:for="{{shops}}" wx:key="id" class="shop-card">
      <view class="shop-info">
        <text class="shop-name">{{item.name}}</text>
        <text class="shop-address">{{item.address}}</text>
        <text wx:if="{{item.phone}}" class="shop-phone">📞 {{item.phone}}</text>
      </view>
      <view class="shop-actions">
        <view class="action-btn action-edit" bindtap="openEdit" data-shop="{{item}}">编辑</view>
        <view class="action-btn action-del" bindtap="deleteShop" data-id="{{item.id}}" data-name="{{item.name}}">删除</view>
      </view>
    </view>
  </view>

  <!-- 添加/编辑弹窗 -->
  <view wx:if="{{showAddModal}}" class="modal-mask" bindtap="closeModal">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">{{editShop ? '编辑店铺' : '添加店铺'}}</text>
        <view class="modal-close" bindtap="closeModal">✕</view>
      </view>
      <view class="form">
        <view class="field">
          <text class="label">店铺名称</text>
          <input class="input" value="{{name}}" bindinput="onNameInput" placeholder="请输入店铺名称" placeholder-class="ph" />
        </view>
        <view class="field">
          <text class="label">详细地址</text>
          <input class="input" value="{{address}}" bindinput="onAddressInput" placeholder="请输入地址" placeholder-class="ph" />
        </view>
        <view class="field">
          <text class="label">联系电话</text>
          <input class="input" type="number" value="{{phone}}" bindinput="onPhoneInput" placeholder="选填" placeholder-class="ph" />
        </view>
      </view>
      <view class="modal-btn {{saving ? 'btn-disabled' : ''}}" bindtap="save">
        <text>{{saving ? '保存中...' : '保存'}}</text>
      </view>
    </view>
  </view>
</view>
