<page-meta page-style="{{showAddModal ? 'overflow: hidden;' : ''}}"/>
<nav-bar title="店铺管理" showBack/>
<view class="container">

  <view wx:if="{{loading}}" class="loading-wrap"><view class="loading-spinner"></view></view>

  <state-card compact wx:elif="{{loadFailed}}" type="error" title="店铺信息加载失败" description="请检查网络后重试" actionText="重新加载" bind:action="loadShops" />

  <view wx:else>
    <!-- 空状态 -->
    <state-card compact wx:if="{{shops.length === 0}}" icon="/static/icons/shop.svg" title="还没有店铺" description="添加你的店铺信息，方便客户到店" actionText="添加第一个店铺" bind:action="openAdd" />

    <!-- 店铺列表 -->
    <view wx:else class="list">
      <view wx:for="{{shops}}" wx:key="name" class="shop-card {{item.enabled ? 'shop-card-active' : 'shop-card-disabled'}}">
        <view class="card-header">
          <view class="shop-icon-wrap"><image class="shop-icon" src="/static/icons/shop.svg" mode="aspectFit" /></view>
          <view class="card-title-area">
            <text class="shop-name">{{item.name}}</text>
            <view class="shop-status {{item.enabled ? 'status-on' : 'status-off'}}">
              <view class="status-dot"></view><text>{{item.enabled ? '营业中' : '已停用'}}</text>
            </view>
          </view>
        </view>
        <scroll-view wx:if="{{item.photos && item.photos.length}}" scroll-x class="shop-card-photos" enhanced show-scrollbar="{{false}}">
          <view class="shop-card-photo-row">
            <image
              wx:for="{{item.photos}}"
              wx:for-item="photoUrl"
              wx:for-index="photoIdx"
              wx:key="*this"
              class="shop-card-photo"
              src="{{photoUrl}}"
              mode="aspectFill"
              bindtap="previewShopPhoto"
              data-name="{{item.name}}"
              data-address="{{item.detailAddress}}"
              data-idx="{{photoIdx}}"
              role="button"
              aria-label="预览第{{photoIdx + 1}}张环境照片"
            />
          </view>
        </scroll-view>
        <view class="shop-meta">
          <view class="shop-location-row shop-map-link" bindtap="viewShopLocation" data-shop="{{item}}" role="button" aria-label="在地图查看{{item.name}}">
            <image class="shop-location-icon" src="/static/icons/pin.svg" mode="aspectFit" />
            <text class="shop-address">{{item.province}}{{item.city}}{{item.district}}{{item.detailAddress}}</text>
            <text class="shop-map-hint">地图 ›</text>
          </view>
          <button wx:if="{{item.enabled}}" class="card-edit booking-action" bindtap="openShopPage" data-shop="{{item}}" hover-class="is-pressed">查看店铺 ›</button>
          <view wx:if="{{item.enabled && item.guidance && item.guidance.enabled}}" class="shop-guidance-link" catchtap="openShopPage" data-shop="{{item}}" data-view="guidance" role="button" aria-label="查看{{item.name}}的到店指引">
            <text>到店指引</text><text class="shop-guidance-arrow">›</text>
          </view>
          <view wx:if="{{item.phone}}" class="shop-phone-row">
            <image class="shop-phone-icon" src="/static/icons/phone-active.svg" mode="aspectFit" />
            <text class="shop-phone">{{item.phone}}</text>
          </view>
        </view>
        <view class="card-settings">
          <view class="shop-enabled-copy"><text class="shop-enabled-title">接受到店预约</text><text class="shop-enabled-sub">{{item.enabled ? '客户可选择此店铺作为服务地点' : '此店铺暂不会出现在预约选项中'}}</text></view>
          <nb-switch checked="{{item.enabled}}" bindchange="toggleShopEnabled" data-name="{{item.name}}" data-address="{{item.detailAddress}}" label="启用{{item.name}}"/>
        </view>
        <view class="card-actions">
          <button wx:if="{{item.enabled}}" class="card-edit booking-action" open-type="share" data-shop="{{item}}" hover-class="is-pressed">发送店铺信息</button>
          <view class="card-edit booking-action" bindtap="openEdit" data-shop="{{item}}" role="button" aria-label="编辑{{item.name}}" hover-class="is-pressed">
            <text>编辑店铺</text>
          </view>
          <view class="delete-card-action booking-action semantic-danger" bindtap="deleteShop" data-name="{{item.name}}" data-address="{{item.detailAddress}}" role="button" aria-label="删除{{item.name}}" hover-class="is-pressed">
            <text>删除店铺</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- FAB 添加按钮 -->
  <view wx:if="{{shops.length > 0 && !loadFailed}}" class="fab" bindtap="openAdd" role="button" aria-label="添加店铺">
    <view class="fab-icon"></view>
  </view>

  <!-- 底部表单 -->
  <view wx:if="{{showAddModal}}" class="mask" bindtap="closeModal"/>
  <view class="form-sheet {{showAddModal ? 'show' : ''}}">
    <view class="sheet-header">
      <text class="sheet-title">{{editShop ? '编辑店铺' : '添加店铺'}}</text>
    </view>

    <scroll-view scroll-y class="form-scroll">
      <view class="form-section">
        <view class="form-section-head"><text class="form-section-title">基本信息</text><text class="form-section-note">必填</text></view>
        <form-field outlined required label="店铺名称" value="{{name}}" bindinput="onNameInput" placeholder="例如 贝贝美甲工作室" disabled="{{saving}}"/>
        <form-field outlined required label="所在地区" custom-control disabled="{{saving || choosingLocation}}"><picker slot="control" class="shop-region-picker" mode="region" value="{{region}}" bindchange="onRegionChange" disabled="{{saving || choosingLocation}}"><view class="shop-region-value {{regionText ? '' : 'is-placeholder'}}"><text>{{regionText || '请选择省市区'}}</text><text>›</text></view></picker></form-field>
        <location-field label="店铺地图位置" confirmed="{{!!latitude && !!longitude}}" value="{{locationText}}" loading="{{choosingLocation}}" disabled="{{saving}}" hint="选点后填入地址。修改省市区或详细地址后，请重新标注位置。" bindchoose="chooseShopLocation"/>
        <form-field outlined required label="详细地址" value="{{detailAddress}}" bindinput="onDetailAddressInput" placeholder="街道、楼栋、门牌号" disabled="{{saving || choosingLocation}}"/>
        <view class="form-item">
          <view class="label-row">
            <text class="label">环境照片</text>
            <text class="form-section-note form-section-note-optional">{{shopPhotos.length}}/6</text>
          </view>
          <view class="photo-grid">
            <view wx:for="{{shopPhotos}}" wx:key="*this" class="photo-cell">
              <image class="photo-img" src="{{item}}" mode="aspectFill"/>
              <view class="photo-remove" catchtap="removeShopPhoto" data-idx="{{index}}" role="button" aria-label="删除第{{index + 1}}张环境照片">
                <image class="photo-remove-icon" src="/static/icons/close-white.svg" mode="aspectFit" />
              </view>
            </view>
            <view wx:if="{{shopPhotos.length < 6}}" class="photo-add booking-action" bindtap="chooseShopPhotos" role="button" aria-label="上传环境照片">
              <image class="photo-add-icon" src="/static/icons/plus.svg" mode="aspectFit" />
              <text class="photo-add-text">{{photoUploading ? '上传中' : '上传实景'}}</text>
            </view>
          </view>
          <text class="label-sub">用于主页展示工作室环境，建议门厅、操作区、消毒角等</text>
        </view>
      </view>

      <view class="form-section">
        <view class="form-section-head"><text class="form-section-title">经营设置</text><text class="form-section-note form-section-note-optional">可选</text></view>
        <form-field outlined label="联系电话" type="number" value="{{phone}}" bindinput="onPhoneInput" placeholder="客户需要时可联系店铺" disabled="{{saving}}"/>
        <view class="form-item form-item-switch">
          <view class="label-group"><text class="switch-title">启用店铺</text><text class="label-sub">启用后可作为预约到店地点</text></view>
          <nb-switch checked="{{enabled}}" bindchange="toggleEnabled" label="启用店铺"/>
        </view>

        <view class="form-item disclosure-item">
        <view class="label-row" bindtap="toggleBusinessHours" role="button" aria-label="展开或收起营业时间设置">
          <view><text class="switch-title">营业时间</text><text class="label-sub">不同日期可单独设置</text></view>
          <text class="label-link">{{showBusinessHours ? '收起 ⌃' : '设置 ›'}}</text>
        </view>
        <view wx:if="{{showBusinessHours}}" class="business-hours-list">
          <view wx:for="{{businessHours}}" wx:key="weekday" class="bh-item">
            <view class="bh-row">
              <text class="bh-weekday">{{weekdayNames[item.weekday]}}</text>
              <view wx:if="{{!item.closed}}" class="bh-time">
                <picker mode="selector" range="{{timeOptions}}" value="{{timeOptions.indexOf(item.start)}}" bindchange="onStartTimeChange" data-idx="{{index}}">
                  <view class="bh-time-btn">{{item.start}}</view>
                </picker>
                <text class="bh-time-sep">—</text>
                <picker mode="selector" range="{{timeOptions}}" value="{{timeOptions.indexOf(item.end)}}" bindchange="onEndTimeChange" data-idx="{{index}}">
                  <view class="bh-time-btn">{{item.end}}</view>
                </picker>
              </view>
              <text wx:else class="bh-closed">休息</text>
              <nb-switch checked="{{!item.closed}}" bindchange="toggleDayClosed" data-idx="{{index}}" label="{{item.label}}营业状态"/>
            </view>
          </view>
        </view>
      </view>

      <view class="form-item guidance-setting form-item-last">
        <view class="guidance-setting-row">
          <view class="label-group">
            <text class="switch-title">到店指引</text>
            <text class="label-sub">开启后客户可查看地铁、公交和开车指引</text>
          </view>
          <nb-switch checked="{{guidanceEnabled}}" bindchange="toggleGuidanceEnabled" label="启用到店指引"/>
        </view>
        <view wx:if="{{guidanceEnabled}}" class="guidance-entry" catchtap="openGuidanceEdit" role="button" aria-label="编辑到店指引">
          <view class="guidance-entry-copy">
            <text class="guidance-entry-text">编辑指引内容</text>
            <text class="guidance-entry-sub">按到店顺序添加文字和图片</text>
          </view>
          <text class="guidance-entry-arrow">›</text>
        </view>
      </view>
      </view>
      <view class="form-scroll-spacer"></view>
    </scroll-view>

    <bottom-action-bar class="page-actions" fixed="{{false}}" primary-label="保存店铺" secondary-label="取消" loading="{{saving}}" disabled="{{choosingLocation || photoUploading}}" secondary-disabled="{{choosingLocation || photoUploading}}" bindprimary="save" bindsecondary="closeModal"/>

  </view>
</view>
