.container { min-height: 100vh; background: #f5f5f5; }

.loading-wrap { display: flex; justify-content: center; padding: 200rpx 0; }

.loading-spinner {
  width: 60rpx; height: 60rpx;
  border: 4rpx solid #FF6B8A; border-top-color: transparent;
  border-radius: 50%; animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.empty-wrap { display: flex; flex-direction: column; align-items: center; padding: 200rpx 40rpx; }
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 34rpx; font-weight: 600; color: #1a1a1a; margin-bottom: 12rpx; }
.empty-desc { font-size: 28rpx; color: #999; }

.list { padding: 16rpx 0; }

.conv-item {
  display: flex; align-items: center;
  padding: 24rpx 32rpx; background: #fff;
  margin-bottom: 2rpx; gap: 24rpx;
}
.conv-item:active { background: #f9f9f9; }

.avatar-wrap { position: relative; flex-shrink: 0; }

.avatar { width: 96rpx; height: 96rpx; border-radius: 50%; background: #f0f0f0; }

.avatar-placeholder {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: linear-gradient(135deg, #FFE0EA, #F4F7FB);
  display: flex; align-items: center; justify-content: center;
}

.avatar-text { font-size: 36rpx; font-weight: 600; color: #FF6B8A; }

.badge {
  position: absolute; top: -6rpx; right: -6rpx;
  min-width: 36rpx; height: 36rpx; border-radius: 18rpx;
  background: #FF6B8A; color: #fff; font-size: 20rpx;
  font-weight: 700; display: flex; align-items: center; justify-content: center;
  padding: 0 8rpx; border: 3rpx solid #fff;
}

.conv-info { flex: 1; min-width: 0; }
.conv-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8rpx; }
.client-name { font-size: 32rpx; font-weight: 600; color: #1a1a1a; }
.last-time { font-size: 24rpx; color: #999; flex-shrink: 0; margin-left: 16rpx; }
.last-msg { font-size: 28rpx; color: #888; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
