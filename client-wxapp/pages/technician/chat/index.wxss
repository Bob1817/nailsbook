page {
  background: var(--bg-gradient-entry);
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== 固定头部 ===== */
.header {
  flex-shrink: 0;
  padding: 16rpx 32rpx 12rpx;
  background: var(--bg-card);
  border-bottom: 0;
}

/* ===== 搜索栏 + 新建 ===== */
.search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: var(--nb-page);
  border: 0;
  border-radius: 22rpx;
  padding: 0 26rpx;
  min-height: 88rpx;
  min-width: 0;
  box-sizing: border-box;
}
.header-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 88rpx;
  padding: 0 22rpx;
  border-radius: 22rpx;
  background: var(--nb-soft-surface);
  border: 0;
  flex-shrink: 0;
}

.header-btn:active { background: var(--nb-page); }

.header-btn-icon {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--nb-ink);
}

.header-btn-text {
  font-size: var(--font-sm);
  font-weight: var(--weight-semibold);
  color: var(--nb-ink);
}

.search-icon {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid var(--nb-control);
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}
.search-icon::after { content: ''; position: absolute; width: 10rpx; height: 3rpx; right: -8rpx; bottom: -4rpx; background: var(--nb-control); transform: rotate(45deg); border-radius: 3rpx; }

.search-input {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--text-primary);
  height: 88rpx;
}

/* ===== 可滚动内容区 ===== */
.content-scroll {
  flex: 1;
  min-height: 0;
}

.content-area {
  padding: 16rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
}

/* ===== Tab 栏（固定） ===== */
.tab-scroll {
  flex-shrink: 0;
  padding: 0 32rpx;
  background: var(--bg-card);
  white-space: nowrap;
  border-bottom: 0;
}

.tab-bar {
  display: inline-flex;
  gap: 8rpx;
}

.tab-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 88rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  border: 0;
  background: transparent;
  flex-shrink: 0;
  box-sizing: border-box;
}

.tab-pill:active { background: var(--nb-page); }

.tab-pill-active {
  background: transparent;
  border-color: transparent;
}

.tab-label {
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  color: var(--nb-secondary);
}

.tab-pill-active .tab-label {
  color: var(--nb-ink);
  font-weight: var(--weight-bold);
}

.tab-count {
  font-size: var(--font-xs);
  color: var(--nb-muted);
  font-weight: var(--weight-medium);
}

.tab-pill-active .tab-count {
  color: var(--nb-ink);
}

/* ===== 消息卡片 ===== */
.msg-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.msg-card {
  position: relative;
  display:flex; align-items:flex-start; gap:20rpx;
  padding:28rpx; min-height:140rpx; box-sizing:border-box;
  background:var(--nb-surface); border-radius:24rpx;
  box-shadow:none; overflow:hidden;
}

.msg-card:active {
  background:var(--nb-pressed);
}

.msg-avatar-wrap {
  position: relative;
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
}

.msg-avatar-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.msg-avatar-placeholder {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-chat { background: var(--nb-page); }
.avatar-pending { background: var(--nb-page); }
.avatar-service { background: var(--nb-page); }
.avatar-system { background: var(--nb-page); }

.msg-semantic-icon {
  width: 52rpx;
  height: 52rpx;
  display: block;
}

.msg-avatar-char {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-muted);
}

.avatar-chat .msg-avatar-char { color: var(--nb-ink); }
.avatar-pending .msg-avatar-char { color: var(--nb-ink); }
.avatar-service .msg-avatar-char { color: var(--nb-ink); }

.msg-body {
  flex: 1;
  min-width: 0;
}

.msg-top-row {
  display:flex; align-items:center; justify-content:space-between; gap:16rpx;
  margin-bottom:10rpx;
}

.msg-name {
  min-width:0; font-size:var(--font-md); font-weight:var(--weight-medium);
  color:var(--nb-secondary); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
}


.msg-type-badge-text {
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
}

.badge-chat { background: var(--nb-page); }
.badge-chat .msg-type-badge-text { color: var(--nb-ink); }

.badge-pending { background: var(--nb-page); }
.badge-pending .msg-type-badge-text { color: var(--nb-ink); }

.badge-service { background: var(--nb-page); }
.badge-service .msg-type-badge-text { color: var(--nb-ink); }

.badge-system { background: var(--nb-page); }
.badge-system .msg-type-badge-text { color: var(--nb-ink); }

.msg-preview {
  font-size: var(--font-sm);
  color: var(--text-muted);
  line-height: var(--leading-normal);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}


.msg-time {
  flex-shrink:0; font-size:var(--font-xs); line-height:1.4; color:var(--nb-muted);
}




.msg-unread-dot {
  width:6rpx; height:6rpx; flex-shrink:0; border-radius:50%;
  background:var(--nb-ink); border:0; box-shadow:none;
}


/* ===== 空态 ===== */
.empty-card {
  margin: 80rpx 0;
  padding: 64rpx 40rpx;
  background: var(--bg-card);
  border-radius: var(--card-radius);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  border: 0;
  box-shadow: var(--shadow-lg);
}
.load-error { margin:80rpx 0; padding:72rpx 48rpx; border: 0; border-radius: var(--radius-md); background: var(--bg-card); box-shadow:0 10rpx 26rpx rgba(0, 0, 0, .05); display:flex; flex-direction:column; align-items:center; gap:16rpx; text-align:center; }
.load-error-mark { width:88rpx; height:88rpx; margin-bottom:12rpx; border-radius:50%; background:var(--nb-page); color:var(--nb-ink); font-size: var(--font-xl); line-height:88rpx; text-align:center; }
.retry-btn { min-height:88rpx; margin:28rpx 0 0; padding:0 56rpx; border:0; border-radius: var(--radius-xl); background:var(--nb-ink); color: var(--text-inverse); font-size: var(--font-md); line-height:88rpx; }
.retry-btn::after { border:0; }
.customer-retry { margin-top: var(--space-md); }

.empty-icon-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--nb-page);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.empty-icon-inner {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-xs);
  background: var(--brand-gradient);
  opacity: 0.6;
}

.empty-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.empty-sub {
  font-size: var(--font-sm);
  color: var(--text-muted);
  text-align: center;
  line-height: var(--leading-normal);
}

/* ===== 骨架屏 ===== */
.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.skeleton-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.05);
}

.skel-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--nb-page);
  background-size: 200% 100%;
  animation: skel 1.4s linear infinite;
}

.skel-lines {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.skel-line {
  height: 24rpx;
  border-radius: var(--radius-xs);
  background: var(--nb-page);
  background-size: 200% 100%;
  animation: skel 1.4s linear infinite;
}

.skel-line-wide { width: 70%; }
.skel-line-narrow { width: 45%; }

@keyframes skel {
  0% { background-position: 0 0; }
  100% { background-position: -200% 0; }
}

/* ===== 弹窗 ===== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1500;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-sheet {
  width: 100%;
  background: var(--bg-card);
  border-radius: var(--btn-radius) 48rpx 0 0;
  padding: 40rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  max-height: 85vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: var(--space-md);
}

.modal-type-badge {
  padding: 8rpx 24rpx;
  border-radius: var(--radius-md);
}

.modal-subtitle {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
  margin-top: 4rpx;
}

.modal-close {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-input);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.modal-close:active { background: var(--nb-page); }

.modal-close-icon {
  font-size: var(--font-md);
  color: var(--text-muted);
  font-weight: var(--weight-semibold);
}

.modal-name {
  display: block;
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin-bottom: var(--space-sm);
}

.modal-preview {
  display: block;
  font-size: var(--font-md);
  color: var(--text-body);
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.modal-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 28rpx;
}

.modal-meta-text {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

.modal-meta-dot {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: var(--btn-radius);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn:active { opacity: 0.85; }

.modal-btn-close {
  background: var(--bg-input);
}

.modal-btn-close-text {
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  color: var(--text-body);
}

.modal-btn-primary {
  background: var(--brand-gradient);
}

.modal-btn-primary-text {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-inverse);
}

/* ===== 新建对话 - 客户列表 ===== */
.modal-search {
  margin-bottom: 20rpx;
}

.customer-list-scroll {
  max-height: 50vh;
}

.customer-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 0;
}

.customer-item:last-child { border-bottom: none; }
.customer-item:active { opacity: 0.7; }

.customer-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--nb-page);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.customer-avatar-char {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--nb-ink);
}

.customer-info {
  flex: 1;
  min-width: 0;
}

.customer-name {
  display: block;
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.customer-phone {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
  margin-top: 4rpx;
}

.customer-badge {
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-input);
  flex-shrink: 0;
}

.customer-badge-text {
  font-size: var(--font-xs);
  color: var(--text-muted);
}

.customer-empty {
  padding: 60rpx 0;
  text-align: center;
}

.customer-empty-text {
  font-size: var(--font-md);
  color: var(--text-muted);
}

/* 未读通过文字层级及小点表达，不给整张卡片染色。 */
.msg-title-group { display:flex; align-items:center; gap:10rpx; min-width:0; }
.msg-unread-count { flex-shrink:0; color:var(--nb-secondary); font-size:var(--font-xs); }
.is-unread .msg-name { color:var(--nb-ink); font-weight:var(--weight-semibold); }
.is-unread .msg-preview { color:var(--nb-secondary); }
.avatar-service, .avatar-system { background:transparent; }
 .retry-btn.booking-action { min-height:44px; height:44px; margin-top:28rpx; padding:0 24rpx; border-radius:8px; font-size:var(--font-sm); line-height:1.4; }
@import '../../../styles/booking-actions.wxss';
