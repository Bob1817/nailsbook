page {
  background: linear-gradient(180deg, #fff8fb 0%, #ffffff 34%, #f8f9fc 100%);
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== 固定头部 ===== */
.header {
  flex-shrink: 0;
  padding: 20rpx 40rpx;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

/* ===== 搜索栏 + 新建 ===== */
.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #f9fafb;
  border: 2rpx solid transparent;
  border-radius: 14rpx;
  padding: 0 26rpx;
  height: 88rpx;
  min-width: 0;
  box-sizing: border-box;
}
.search-bar:focus-within {
  background: #ffffff;
  border-color: #ff6b8a;
}

.header-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 0 28rpx;
  height: 88rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #ff6b8a, #8b5cf6);
  flex-shrink: 0;
}

.header-btn:active { opacity: 0.85; }

.header-btn-icon {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.header-btn-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #ffffff;
}

.search-icon {
  font-size: 28rpx;
  color: #6b7280;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1f2937;
  height: 88rpx;
}

/* ===== 可滚动内容区 ===== */
.content-scroll {
  flex: 1;
  min-height: 0;
}

.content-area {
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
}

/* ===== Tab 栏（固定） ===== */
.tab-scroll {
  flex-shrink: 0;
  padding: 20rpx 40rpx 0;
  background: #ffffff;
  white-space: nowrap;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.tab-bar {
  display: inline-flex;
  gap: 16rpx;
}

.tab-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  min-height: 88rpx;
  padding: 0 32rpx;
  border-radius: 40rpx;
  border: 2rpx solid rgba(255, 107, 138, 0.08);
  background: #ffffff;
  flex-shrink: 0;
  box-sizing: border-box;
}

.tab-pill:active { background: #fef7f9; }

.tab-pill-active {
  background: #fff0f3;
  border-color: #ffcdd6;
}

.tab-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #6b7280;
}

.tab-pill-active .tab-label {
  color: #ff6b8a;
}

.tab-count {
  font-size: 22rpx;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  background: #f7f2f5;
  color: #6b7280;
  font-weight: 500;
}

.tab-pill-active .tab-count {
  background: #ffffff;
  color: #ff6b8a;
}

/* ===== 消息卡片 ===== */
.msg-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.msg-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 18rpx;
  border: 2rpx solid rgba(255, 107, 138, 0.08);
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.05);
}

.msg-card:active { background: #fefbfc; }

.msg-avatar-wrap {
  position: relative;
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
}

.msg-avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
}

.msg-avatar-placeholder {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-chat { background: #ffe9f0; }
.avatar-pending { background: #fff3e8; }
.avatar-service { background: #eef6ff; }
.avatar-system { background: #f3f4f6; }

.msg-avatar-char {
  font-size: 36rpx;
  font-weight: 600;
  color: #6b7280;
}

.avatar-chat .msg-avatar-char { color: #ea5e93; }
.avatar-pending .msg-avatar-char { color: #c96c1a; }
.avatar-service .msg-avatar-char { color: #3f6dbe; }

.msg-body {
  flex: 1;
  min-width: 0;
}

.msg-top-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.msg-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.msg-type-badge {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.msg-type-badge-text {
  font-size: 22rpx;
  font-weight: 500;
}

.badge-chat { background: #ffe9f0; }
.badge-chat .msg-type-badge-text { color: #ea5e93; }

.badge-pending { background: #fff3e8; }
.badge-pending .msg-type-badge-text { color: #c96c1a; }

.badge-service { background: #eef6ff; }
.badge-service .msg-type-badge-text { color: #3f6dbe; }

.badge-system { background: #f3f4f6; }
.badge-system .msg-type-badge-text { color: #6b7280; }

.msg-preview {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.msg-right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  padding-top: 4rpx;
  min-width: 96rpx;
}

.msg-time {
  font-size: 24rpx;
  color: #6b7280;
}

.msg-action {
  font-size: 22rpx;
  font-weight: 500;
}

.action-pending { color: #c96c1a; }
.action-service { color: #3f6dbe; }
.action-system { color: #6b7280; }

.msg-unread-badge {
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  background: #e85d75;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.msg-unread-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #ff6b8a;
}

/* ===== 空态 ===== */
.empty-card {
  margin: 80rpx 0;
  padding: 64rpx 40rpx;
  background: #ffffff;
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  border: 2rpx solid rgba(255, 107, 138, 0.08);
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.05);
}
.load-error { margin:80rpx 0; padding:72rpx 48rpx; border:2rpx solid rgba(255,107,138,.08); border-radius:24rpx; background:#fff; box-shadow:0 10rpx 26rpx rgba(15,23,42,.05); display:flex; flex-direction:column; align-items:center; gap:16rpx; text-align:center; }
.load-error-mark { width:88rpx; height:88rpx; margin-bottom:12rpx; border-radius:50%; background:#fff0f4; color:#c75b83; font-size:44rpx; line-height:88rpx; text-align:center; }
.retry-btn { min-height:88rpx; margin:28rpx 0 0; padding:0 56rpx; border:0; border-radius:44rpx; background:#1f2937; color:#fff; font-size:28rpx; line-height:88rpx; }
.retry-btn::after { border:0; }
.customer-retry { margin-top:24rpx; }

.empty-icon-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFE2EA 0%, #F4F6FB 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.empty-icon-inner {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #ff6b8a, #8b5cf6);
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.empty-sub {
  font-size: 26rpx;
  color: #6b7280;
  text-align: center;
  line-height: 1.5;
}

/* ===== 骨架屏 ===== */
.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.skeleton-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 18rpx;
  border: 2rpx solid rgba(255, 107, 138, 0.08);
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.05);
}

.skel-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, #f5f0f3, #faf2f5, #f5f0f3);
  background-size: 200% 100%;
  animation: skel 1.4s linear infinite;
}

.skel-lines {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.skel-line {
  height: 24rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #f5f0f3, #faf2f5, #f5f0f3);
  background-size: 200% 100%;
  animation: skel 1.4s linear infinite;
}

.skel-line-wide { width: 70%; }
.skel-line-narrow { width: 45%; }

@keyframes skel {
  0% { background-position: 0 0; }
  100% { background-position: -200% 0; }
}

/* ===== 弹窗 ===== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1500;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 48rpx 48rpx 0 0;
  padding: 40rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  max-height: 85vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.modal-type-badge {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
}

.modal-subtitle {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.modal-close {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.modal-close:active { background: #e5e7eb; }

.modal-close-icon {
  font-size: 28rpx;
  color: #6b7280;
  font-weight: 600;
}

.modal-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 16rpx;
}

.modal-preview {
  display: block;
  font-size: 28rpx;
  color: #374151;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.modal-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 28rpx;
}

.modal-meta-text {
  font-size: 24rpx;
  color: #6b7280;
}

.modal-meta-dot {
  font-size: 24rpx;
  color: #767b84;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn:active { opacity: 0.85; }

.modal-btn-close {
  background: #f3f4f6;
}

.modal-btn-close-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #374151;
}

.modal-btn-primary {
  background: linear-gradient(135deg, #ff6b8a, #8b5cf6);
}

.modal-btn-primary-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

/* ===== 新建对话 - 客户列表 ===== */
.modal-search {
  margin-bottom: 20rpx;
}

.customer-list-scroll {
  max-height: 50vh;
}

.customer-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.customer-item:last-child { border-bottom: none; }
.customer-item:active { opacity: 0.7; }

.customer-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #ffe9f0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.customer-avatar-char {
  font-size: 32rpx;
  font-weight: 600;
  color: #ea5e93;
}

.customer-info {
  flex: 1;
  min-width: 0;
}

.customer-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.customer-phone {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.customer-badge {
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
  flex-shrink: 0;
}

.customer-badge-text {
  font-size: 22rpx;
  color: #6b7280;
}

.customer-empty {
  padding: 60rpx 0;
  text-align: center;
}

.customer-empty-text {
  font-size: 28rpx;
  color: #6b7280;
}
