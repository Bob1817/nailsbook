page {
  background: var(--bg-gradient-entry);
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== 固定头部 ===== */
.header {
  flex-shrink: 0;
  padding: 16rpx 32rpx 12rpx;
  background: var(--bg-card);
  border-bottom: 1rpx solid #f1ecef;
}

/* ===== 搜索栏 + 新建 ===== */
.search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #f7f7f8;
  border: 2rpx solid transparent;
  border-radius: 22rpx;
  padding: 0 26rpx;
  min-height: 88rpx;
  min-width: 0;
  box-sizing: border-box;
}
.header-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 88rpx;
  padding: 0 22rpx;
  border-radius: 22rpx;
  background: var(--bg-card);
  border: 2rpx solid #f0d7e1;
  flex-shrink: 0;
}

.header-btn:active { background: #fff5f8; }

.header-btn-icon {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: #b44f78;
}

.header-btn-text {
  font-size: var(--font-sm);
  font-weight: var(--weight-semibold);
  color: #9f496d;
}

.search-icon {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #9a9297;
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}
.search-icon::after { content: ''; position: absolute; width: 10rpx; height: 3rpx; right: -8rpx; bottom: -4rpx; background: #9a9297; transform: rotate(45deg); border-radius: 3rpx; }

.search-input {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--text-primary);
  height: 88rpx;
}

/* ===== 可滚动内容区 ===== */
.content-scroll {
  flex: 1;
  min-height: 0;
}

.content-area {
  padding: 16rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
}

/* ===== Tab 栏（固定） ===== */
.tab-scroll {
  flex-shrink: 0;
  padding: 0 32rpx;
  background: var(--bg-card);
  white-space: nowrap;
  border-bottom: 1rpx solid #f1ecef;
}

.tab-bar {
  display: inline-flex;
  gap: 8rpx;
}

.tab-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 88rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  border: 2rpx solid transparent;
  background: transparent;
  flex-shrink: 0;
  box-sizing: border-box;
}

.tab-pill:active { background: #f8f3f5; }

.tab-pill-active {
  background: transparent;
  border-color: transparent;
}

.tab-label {
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  color: #746b70;
}

.tab-pill-active .tab-label {
  color: #a64f73;
  font-weight: var(--weight-bold);
}

.tab-count {
  font-size: var(--font-xs);
  color: #9a9297;
  font-weight: var(--weight-medium);
}

.tab-pill-active .tab-count {
  color: #a64f73;
}

/* ===== 消息卡片 ===== */
.msg-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.msg-card {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 28rpx;
  background: var(--bg-gradient-entry);
  border-radius: var(--radius-lg);
  box-shadow: 0 12rpx 24rpx rgba(36, 27, 41, 0.05);
  overflow: hidden;
}

.msg-card:active { background: #fefbfc; }

.msg-avatar-wrap {
  position: relative;
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
}

.msg-avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
}

.msg-avatar-placeholder {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-chat { background: #ffe9f0; }
.avatar-pending { background: #fff3e8; }
.avatar-service { background: #eaf4ff; }
.avatar-system { background: #f1edfb; }

.msg-semantic-icon {
  width: 52rpx;
  height: 52rpx;
  display: block;
}

.msg-avatar-char {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-muted);
}

.avatar-chat .msg-avatar-char { color: #ea5e93; }
.avatar-pending .msg-avatar-char { color: #c96c1a; }
.avatar-service .msg-avatar-char { color: #3f6dbe; }

.msg-body {
  flex: 1;
  min-width: 0;
}

.msg-top-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.msg-name {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.msg-type-badge {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-md);
}

.msg-type-badge-text {
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
}

.badge-chat { background: #ffe9f0; }
.badge-chat .msg-type-badge-text { color: #ea5e93; }

.badge-pending { background: #fff3e8; }
.badge-pending .msg-type-badge-text { color: #c96c1a; }

.badge-service { background: #eaf4ff; }
.badge-service .msg-type-badge-text { color: #3569b3; }

.badge-system { background: #f1edfb; }
.badge-system .msg-type-badge-text { color: #67569e; }

.msg-preview {
  font-size: var(--font-sm);
  color: var(--text-muted);
  line-height: var(--leading-normal);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.msg-right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  padding-top: 4rpx;
  min-width: 96rpx;
}

.msg-time {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

.msg-action {
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
}

.action-pending { color: #c96c1a; }
.action-service { color: #3569b3; }
.action-system { color: #67569e; }

.msg-unread-badge {
  min-width: 32rpx;
  height: 32rpx;
  border-radius: var(--radius-sm);
  background: #e85d75;
  color: var(--text-inverse);
  font-size: var(--font-xs);
  font-weight: var(--weight-bold);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.msg-unread-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--brand-primary);
}

.unread-service { background: #4b83d1; }
.unread-system { background: #7c6bb3; }

/* ===== 空态 ===== */
.empty-card {
  margin: 80rpx 0;
  padding: 64rpx 40rpx;
  background: var(--bg-card);
  border-radius: var(--card-radius);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  border: 2rpx solid rgba(255,107,138,0.08) /* brand-primary-alpha */;
  box-shadow: var(--shadow-lg);
}
.load-error { margin:80rpx 0; padding:72rpx 48rpx; border:2rpx solid rgba(255,107,138,.08); border-radius: var(--radius-md); background: var(--bg-card); box-shadow:0 10rpx 26rpx rgba(15,23,42,.05); display:flex; flex-direction:column; align-items:center; gap:16rpx; text-align:center; }
.load-error-mark { width:88rpx; height:88rpx; margin-bottom:12rpx; border-radius:50%; background:#fff0f4; color:#c75b83; font-size: var(--font-xl); line-height:88rpx; text-align:center; }
.retry-btn { min-height:88rpx; margin:28rpx 0 0; padding:0 56rpx; border:0; border-radius: var(--radius-xl); background:#1f2937; color: var(--text-inverse); font-size: var(--font-md); line-height:88rpx; }
.retry-btn::after { border:0; }
.customer-retry { margin-top: var(--space-md); }

.empty-icon-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFE2EA 0%, #F4F6FB 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.empty-icon-inner {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-xs);
  background: var(--brand-gradient);
  opacity: 0.6;
}

.empty-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.empty-sub {
  font-size: var(--font-sm);
  color: var(--text-muted);
  text-align: center;
  line-height: var(--leading-normal);
}

/* ===== 骨架屏 ===== */
.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.skeleton-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: 0 12rpx 24rpx rgba(36, 27, 41, 0.05);
}

.skel-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, #f5f0f3, #faf2f5, #f5f0f3);
  background-size: 200% 100%;
  animation: skel 1.4s linear infinite;
}

.skel-lines {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.skel-line {
  height: 24rpx;
  border-radius: var(--radius-xs);
  background: linear-gradient(90deg, #f5f0f3, #faf2f5, #f5f0f3);
  background-size: 200% 100%;
  animation: skel 1.4s linear infinite;
}

.skel-line-wide { width: 70%; }
.skel-line-narrow { width: 45%; }

@keyframes skel {
  0% { background-position: 0 0; }
  100% { background-position: -200% 0; }
}

/* ===== 弹窗 ===== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1500;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-sheet {
  width: 100%;
  background: var(--bg-card);
  border-radius: var(--btn-radius) 48rpx 0 0;
  padding: 40rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  max-height: 85vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: var(--space-md);
}

.modal-type-badge {
  padding: 8rpx 24rpx;
  border-radius: var(--radius-md);
}

.modal-subtitle {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
  margin-top: 4rpx;
}

.modal-close {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-input);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.modal-close:active { background: #e5e7eb; }

.modal-close-icon {
  font-size: var(--font-md);
  color: var(--text-muted);
  font-weight: var(--weight-semibold);
}

.modal-name {
  display: block;
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin-bottom: var(--space-sm);
}

.modal-preview {
  display: block;
  font-size: var(--font-md);
  color: var(--text-body);
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.modal-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 28rpx;
}

.modal-meta-text {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

.modal-meta-dot {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: var(--btn-radius);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn:active { opacity: 0.85; }

.modal-btn-close {
  background: var(--bg-input);
}

.modal-btn-close-text {
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  color: var(--text-body);
}

.modal-btn-primary {
  background: var(--brand-gradient);
}

.modal-btn-primary-text {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-inverse);
}

/* ===== 新建对话 - 客户列表 ===== */
.modal-search {
  margin-bottom: 20rpx;
}

.customer-list-scroll {
  max-height: 50vh;
}

.customer-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.customer-item:last-child { border-bottom: none; }
.customer-item:active { opacity: 0.7; }

.customer-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #ffe9f0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.customer-avatar-char {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: #ea5e93;
}

.customer-info {
  flex: 1;
  min-width: 0;
}

.customer-name {
  display: block;
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.customer-phone {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
  margin-top: 4rpx;
}

.customer-badge {
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-input);
  flex-shrink: 0;
}

.customer-badge-text {
  font-size: var(--font-xs);
  color: var(--text-muted);
}

.customer-empty {
  padding: 60rpx 0;
  text-align: center;
}

.customer-empty-text {
  font-size: var(--font-md);
  color: var(--text-muted);
}
