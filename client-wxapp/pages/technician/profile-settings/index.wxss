.page{min-height:100vh;background:var(--nb-page);color:var(--nb-ink)}.settings-page{padding:24rpx 32rpx 160rpx;box-sizing:border-box}.avatar-title,.field-hint,.section-title,.section-note,.label,.field-count{display:block}.profile-card,.form-card{background:var(--nb-surface);border-radius:24rpx}.profile-card{padding:24rpx 28rpx}.avatar-section{width:100%;min-height:112rpx;display:flex;align-items:center;gap:22rpx;box-sizing:border-box}.avatar-section.uploading{opacity:.72}.avatar-wrap{position:relative;width:104rpx;height:104rpx;flex-shrink:0;border-radius:50%;overflow:hidden}.avatar,.avatar-placeholder{width:104rpx;height:104rpx;border-radius:50%}.avatar-placeholder{display:flex;align-items:center;justify-content:center;background:var(--nb-soft-surface)}.avatar-copy{flex:1;min-width:0}.avatar-title{font-size:27rpx;font-weight:600}.field-hint{margin-top:6rpx;color:var(--nb-muted);font-size:21rpx;line-height:1.5}.edit-link{min-width:88rpx;min-height:88rpx;display:flex;align-items:center;justify-content:flex-end;color:var(--nb-text-link);font-size:23rpx;flex-shrink:0}.avatar-uploading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:var(--nb-overlay)}.upload-spinner{width:38rpx;height:38rpx;border:4rpx solid var(--nb-border);border-top-color:var(--nb-inverse);border-radius:50%;animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}.section-heading{padding:34rpx 8rpx 16rpx;display:flex;align-items:center;justify-content:space-between}.section-title{font-size:28rpx;font-weight:650}.section-note{color:var(--nb-muted);font-size:21rpx}.form-card{overflow:hidden}.field{padding:26rpx 28rpx;border-bottom:1rpx solid var(--nb-border)}.field:last-child{border-bottom:0}.label{margin-bottom:12rpx;font-size:24rpx;font-weight:550}.field-label-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.field-label-row .label{margin-bottom:12rpx}.label-badge{padding:5rpx 12rpx;border-radius:14rpx;background:var(--nb-soft-surface);color:var(--nb-secondary);font-size:19rpx}.field-count{color:var(--nb-muted);font-size:20rpx}.input,.picker-row{width:100%;height:88rpx;padding:0 20rpx;box-sizing:border-box;border-radius:14rpx;background:var(--nb-soft-surface);color:var(--nb-ink);font-size:26rpx}.picker-row{display:flex;align-items:center;justify-content:space-between}.picker-val{flex:1}.picker-chevron{width:14rpx;height:14rpx;border-right:2rpx solid var(--nb-control);border-bottom:2rpx solid var(--nb-control);transform:rotate(-45deg)}.textarea{width:100%;min-height:176rpx;padding:20rpx;box-sizing:border-box;border-radius:14rpx;background:var(--nb-soft-surface);color:var(--nb-ink);font-size:26rpx;line-height:1.6}.ph{color:var(--nb-muted)}.footer-bar{position:fixed;left:0;right:0;bottom:0;z-index:10;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));background:var(--nb-surface)}.save-btn{min-height:88rpx;display:flex;align-items:center;justify-content:center;border-radius:16rpx;background:var(--nb-action);color:var(--nb-inverse);font-size:26rpx;font-weight:650}.save-btn:active{background:var(--nb-action-pressed)}.btn-disabled{opacity:.6}

@import '../../../styles/booking-form.wxss';
@import '../../../styles/booking-actions.wxss';
.ph,.picker-val { font-size:var(--font-sm); }
.avatar-title,.section-title { font-size:var(--font-md); font-weight:var(--weight-semibold); }
.field-hint,.section-note,.field-count,.label-badge { font-size:var(--font-xs); }
.edit-link { font-size:var(--font-sm); color:var(--nb-text-link); }
.settings-page { padding-bottom:calc(160rpx + env(safe-area-inset-bottom)); }
