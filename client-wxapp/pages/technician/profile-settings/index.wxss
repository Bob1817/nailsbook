.page{min-height:100vh;background:var(--nb-page);color:var(--nb-ink)}.settings-page{padding:var(--space-md) var(--space-lg) 160rpx;box-sizing:border-box}.avatar-title,.field-hint,.section-title,.section-note,.label,.field-count{display:block}.profile-card,.form-card{background:var(--nb-surface);border-radius:24rpx}.profile-card{padding:var(--space-md) 28rpx}.avatar-section{width:100%;min-height:112rpx;display:flex;align-items:center;gap:22rpx;box-sizing:border-box}.avatar-section.uploading{opacity:.72}.avatar-wrap{position:relative;width:104rpx;height:104rpx;flex-shrink:0;border-radius:50%;overflow:hidden}.avatar,.avatar-placeholder{width:104rpx;height:104rpx;border-radius:50%}.avatar-placeholder{display:flex;align-items:center;justify-content:center;background:var(--nb-soft-surface)}.avatar-copy{flex:1;min-width:0}.avatar-title{font-size:var(--font-md);font-weight:600}.field-hint{margin-top:6rpx;color:var(--nb-muted);font-size:var(--font-xs);line-height:1.5}.edit-link{min-width:88rpx;min-height:88rpx;display:flex;align-items:center;justify-content:flex-end;color:var(--nb-text-link);font-size:var(--font-sm);flex-shrink:0}.avatar-uploading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:var(--nb-overlay)}.upload-spinner{width:38rpx;height:38rpx;border:4rpx solid var(--nb-border);border-top-color:var(--nb-inverse);border-radius:50%;animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}.section-heading{padding:34rpx var(--space-xs) var(--space-sm);display:flex;align-items:center;justify-content:space-between}.section-title{font-size:var(--font-md);font-weight:650}.section-note{color:var(--nb-muted);font-size:var(--font-xs)}.form-card{overflow:hidden}.field{padding:26rpx 28rpx;border-bottom:1rpx solid var(--nb-border)}.field:last-child{border-bottom:0}.label{margin-bottom:12rpx;font-size:var(--font-sm);font-weight:550}.field-label-row{display:flex;align-items:center;justify-content:space-between;gap:var(--space-sm)}.field-label-row .label{margin-bottom:12rpx}.label-badge{padding:5rpx 12rpx;border-radius:var(--radius-sm);background:var(--nb-soft-surface);color:var(--nb-secondary);font-size:var(--font-xs)}.field-count{color:var(--nb-muted);font-size:var(--font-xs)}.input,.picker-row{width:100%;height:88rpx;padding:0 20rpx;box-sizing:border-box;border-radius:var(--radius-sm);background:var(--nb-soft-surface);color:var(--nb-ink);font-size:var(--font-md)}.picker-row{display:flex;align-items:center;justify-content:space-between}.picker-val{flex:1}.picker-chevron{width:14rpx;height:14rpx;border-right:2rpx solid var(--nb-control);border-bottom:2rpx solid var(--nb-control);transform:rotate(-45deg)}.textarea{width:100%;min-height:176rpx;padding:20rpx;box-sizing:border-box;border-radius:var(--radius-sm);background:var(--nb-soft-surface);color:var(--nb-ink);font-size:var(--font-md);line-height:1.6}.ph{color:var(--nb-muted)}.footer-bar{position:fixed;left:0;right:0;bottom:0;z-index:10;padding:20rpx var(--space-lg) calc(20rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,0.86);-webkit-backdrop-filter:blur(20px) saturate(180%);backdrop-filter:blur(20px) saturate(180%);border-top:1rpx solid rgba(0,0,0,0.06);box-shadow:0 -8rpx 32rpx rgba(0,0,0,0.04);}.save-btn{min-height:88rpx;display:flex;align-items:center;justify-content:center;border-radius:16rpx;background:var(--nb-action);color:var(--nb-inverse);font-size:var(--font-md);font-weight:650}.save-btn:active{background:var(--nb-action-pressed)}.btn-disabled{opacity:.6}

@import '../../../styles/booking-form.wxss';
@import '../../../styles/booking-actions.wxss';
.ph,.picker-val { font-size:var(--font-sm); }
.avatar-title,.section-title { font-size:var(--font-md); font-weight:var(--weight-semibold); }
.field-hint,.section-note,.field-count,.label-badge { font-size:var(--font-xs); }
.edit-link { font-size:var(--font-sm); color:var(--nb-text-link); }
.settings-page { padding-bottom:calc(160rpx + env(safe-area-inset-bottom)); }
.wechat-qr-row{display:flex;align-items:center;gap:24rpx;margin-top:20rpx}.wechat-qr-preview,.wechat-qr-placeholder{width:176rpx;height:176rpx;border-radius:16rpx;background:var(--nb-soft-surface);flex-shrink:0}.wechat-qr-placeholder{display:flex;align-items:center;justify-content:center;color:var(--nb-muted);font-size:var(--font-xs)}.wechat-qr-actions{flex:1;display:flex;flex-direction:column;gap:12rpx}.qr-action,.qr-remove{width:100%;min-height:88rpx;margin:0;border-radius:16rpx;font-size:var(--font-sm)}.qr-action{background:var(--nb-action);color:var(--nb-inverse)}.qr-remove{background:var(--nb-danger-surface);color:var(--nb-danger)}.qr-action::after,.qr-remove::after{border:0}
.switch-field{display:flex;align-items:center;justify-content:space-between;gap:var(--space-md);min-height:88rpx}.switch-field-copy{flex:1;min-width:0}.switch-field-copy .label{margin-bottom:6rpx}
