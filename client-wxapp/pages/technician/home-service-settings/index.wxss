.page {
  min-height: 100vh;
  background: var(--nb-page);
  padding-bottom: 160rpx;
}

/* ===== 加载 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}
.loading-spinner {
  width: 60rpx; height: 60rpx;
  border: 4rpx solid var(--nb-line);
  border-top-color: var(--brand-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.load-error { display:flex; flex-direction:column; align-items:center; padding:160rpx var(--space-xl) 80rpx; }
.load-error-mark { width:88rpx; height:88rpx; margin-bottom:var(--space-lg); border-radius:50%; background:var(--nb-page); color:var(--nb-ink); font-size: var(--font-xl); line-height:88rpx; text-align:center; }
.load-error-title { margin-bottom:12rpx; color: var(--text-body); font-size: var(--font-lg); }
.load-error-desc { margin-bottom:56rpx; color: var(--text-muted); font-size: var(--font-sm); }
.retry-btn { min-height:88rpx; margin:0; padding:0 56rpx; border:0; border-radius: var(--radius-xl); background:var(--nb-ink); color: var(--text-inverse); font-size: var(--font-md); line-height:88rpx; }
.retry-btn::after { border:0; }

/* ===== Hero 状态卡 ===== */
.hero-card {
  margin: 0 var(--space-md) 20rpx;
  border-radius: var(--radius-md);
  padding: var(--space-lg);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hero-on {
  background: var(--nb-page);
  border: 0;
}
.hero-off {
  background: var(--bg-card);
  border: 0;
}
.hero-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.hero-icon-wrap {
  width: 88rpx; height: 88rpx;
  border-radius: var(--radius-md);
  background: rgba(0, 0, 0, 0.1) /* brand-primary-alpha */;
  display: flex; align-items: center; justify-content: center;
}
.hero-icon { position:relative; width:54rpx; height:40rpx; }
.car-body { position:absolute; left:4rpx; right:4rpx; top:10rpx; height:22rpx; border: 0; border-radius:10rpx 12rpx 6rpx 6rpx; box-sizing:border-box; }
.car-body::before { content:''; position:absolute; left:10rpx; top:-12rpx; width:24rpx; height:12rpx; border: 0; border-bottom:0; border-radius:var(--radius-xs) var(--radius-xs) 0 0; box-sizing:border-box; }
.car-wheel { position:absolute; bottom:2rpx; width:10rpx; height:10rpx; border-radius:50%; background:var(--nb-action); }
.wheel-left { left:10rpx; } .wheel-right { right:10rpx; }
.hero-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.hero-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
}
.hero-status-label {
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
  padding: 4rpx var(--space-sm);
  border-radius: var(--radius-full);
}
.label-on  { background: var(--nb-page); color: var(--nb-ink); }
.label-off { background: var(--bg-input); color: var(--text-muted); }

/* ===== 快速开启横幅 ===== */
.quick-banner {
  margin: 0 var(--space-md) 20rpx;
  background: var(--nb-action);
  border-radius: var(--radius-md);
  padding: 28rpx var(--space-lg);
}
.quick-banner-body { margin-bottom: var(--space-md); }
.quick-banner-title {
  display: block;
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: var(--text-inverse);
  margin-bottom: var(--space-xs);
}
.quick-banner-desc {
  display: block;
  font-size: var(--font-sm);
  color: rgba(255,255,255,0.85);
  line-height: var(--leading-normal);
  margin-bottom: var(--space-sm);
}
.quick-banner-defaults {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  flex-wrap: wrap;
}
.quick-default-item {
  font-size: var(--font-xs);
  color: rgba(255,255,255,0.75);
}
.quick-default-sep {
  font-size: var(--font-xs);
  color: rgba(255,255,255,0.4);
}
.quick-btn {
  width: 100%;
  height: 88rpx;
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: var(--brand-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}
.quick-btn:active { opacity: 0.85; }
.quick-btn-disabled { opacity: 0.5; }

/* ===== 参数配置卡 ===== */
.config-card {
  margin: 0 var(--space-md) 20rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}
.config-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx var(--space-lg) 20rpx;
}
.config-card-title {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}
.config-card-tip {
  font-size: var(--font-xs);
  color: var(--nb-ink);
  font-weight: var(--weight-medium);
}

/* 默认值提示条 */
.tip-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: var(--nb-page);
  margin: 0 var(--space-lg) 20rpx;
  border-radius: var(--radius-xs);
  padding: 14rpx 20rpx;
}
.tip-dot {
  width: 12rpx; height: 12rpx;
  border-radius: 50%;
  background: var(--nb-action);
  flex-shrink: 0;
}
.tip-text {
  font-size: var(--font-sm);
  color: var(--nb-ink);
  line-height: 1.4;
}

/* ===== 字段组 ===== */
.field-group {
  padding: 0 var(--space-lg) var(--space-md);
}
.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: var(--space-xs) 0;
}
.field-row-textarea {
  align-items: flex-start;
  padding: 20rpx 0 var(--space-xs);
}
.field-sep {
  height: 1rpx;
  background: var(--bg-page);
}
.field-label-wrap {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
}
.field-label {
  font-size: var(--font-md);
  color: var(--text-body);
  font-weight: var(--weight-medium);
}
.field-unit {
  font-size: var(--font-xs);
  color: var(--text-muted);
}
.field-input {
  flex: 1;
  height: 88rpx;
  text-align: right;
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  padding: 0 0 0 var(--space-sm);
}
.field-textarea {
  flex: 1;
  min-height: 120rpx;
  font-size: var(--font-sm);
  color: var(--text-primary);
  line-height: 1.6;
  text-align: right;
  padding: 0 0 0 var(--space-sm);
}
.ph { color: var(--text-muted); }

/* ===== 阶梯报价 ===== */
.pricing-list {
  padding: 0 var(--space-lg) var(--space-sm);
}
.pricing-item {
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  padding: 20rpx;
  margin-bottom: var(--space-sm);
}
.pricing-item:last-child {
  margin-bottom: 0;
}
.pricing-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.pricing-row + .pricing-row {
  margin-top: var(--space-sm);
}
.pricing-label {
  font-size: var(--font-sm);
  color: var(--text-muted);
  width: 80rpx;
  flex-shrink: 0;
}
.pricing-input {
  flex: 1;
  height: 88rpx;
  background: var(--nb-soft-surface);
  border-radius: var(--radius-xs);
  padding: 0 var(--space-sm);
  font-size: var(--font-md);
  color: var(--text-primary);
  text-align: center;
  box-sizing: border-box;
  border: 0;
}
.pricing-input:focus {
  border-color: var(--brand-primary);
  background: var(--nb-soft-surface);
}
.pricing-dash {
  font-size: var(--font-sm);
  color: var(--text-muted);
  flex-shrink: 0;
}
.pricing-unit {
  font-size: var(--font-sm);
  color: var(--text-muted);
  flex-shrink: 0;
  width: 60rpx;
}
.pricing-remove {
  padding: var(--space-xs) 20rpx;
  background: var(--nb-page);
  border-radius: var(--radius-xs);
  flex-shrink: 0;
}
.pricing-remove text {
  font-size: var(--font-sm);
  color: var(--nb-ink);
}
.add-pricing-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  height: 80rpx;
  margin: 0 var(--space-lg) var(--space-md);
  background: var(--bg-card);
  border: 2rpx dashed var(--nb-line);
  border-radius: var(--radius-sm);
}
.add-pricing-btn:active {
  background: var(--bg-input);
}
.add-icon {
  font-size: var(--font-lg);
  color: var(--brand-primary);
  font-weight: var(--weight-semibold);
}
.add-pricing-btn text {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

/* ===== 保存按钮 ===== */
.btn-save {
  margin: 0 var(--space-md) var(--space-sm);
  height: 96rpx;
  background: var(--nb-action);
  color: var(--text-inverse);
  border-radius: var(--btn-radius);
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.28) /* brand-primary-alpha */;
}
.btn-save:active { opacity: 0.85; }
.btn-disabled { opacity: 0.45; }

/* 关闭服务提示 */
.close-tip {
  padding: 0 var(--space-xl);
  text-align: center;
  font-size: var(--font-xs);
  color: var(--nb-muted);
  line-height: var(--leading-normal);
}
@import '../../../styles/booking-actions.wxss';
.retry-btn.booking-action { min-height:44px; height:44px; margin:0; padding:0 var(--space-md); border-radius:8px; font-size:var(--font-sm); line-height:1.4; }
.compliance-banner { margin: 0 var(--space-md) 20rpx; padding: var(--space-md); background: var(--nb-soft-surface); border-radius: var(--radius-md); border: 1rpx solid var(--nb-border); display: flex; flex-direction: column; gap: 8rpx; }
.compliance-badge { display: inline-block; align-self: flex-start; font-size: var(--font-xs); font-weight: var(--weight-medium); color: var(--nb-ink); background: var(--nb-surface); border-radius: var(--radius-sm); padding: 4rpx 12rpx; }
.compliance-text { font-size: var(--font-xs); color: var(--nb-muted); line-height: var(--leading-normal); }
