.container {
  min-height: 100vh;
  background: #f6f7f9;
  padding-bottom: 140rpx;
}

/* ===== 页面标题区 ===== */
.page-header {
  padding: 24rpx 40rpx 28rpx;
}
.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.2;
  margin-bottom: 8rpx;
}
.page-subtitle {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.4;
}

/* ===== 加载 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #FF6B8A;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ===== 卡片 ===== */
.card {
  margin: 0 24rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.card-row-info {
  flex: 1;
  min-width: 0;
}
.card-row-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.3;
  margin-bottom: 6rpx;
}
.card-row-desc {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.4;
}

/* ===== 表单项 ===== */
.form-item {
  margin-bottom: 28rpx;
}
.form-item-last {
  margin-bottom: 0;
}
.label {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}
.input {
  width: 100%;
  height: 88rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1f2937;
  box-sizing: border-box;
}
.textarea {
  width: 100%;
  height: 160rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #1f2937;
  box-sizing: border-box;
}
.ph {
  color: #9ca3af;
}

/* ===== 保存按钮 ===== */
.btn-save {
  margin: 32rpx 24rpx 0;
  height: 96rpx;
  background: linear-gradient(135deg, #ff6b8a, #a855f7);
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 138, 0.3);
}
.btn-save:active {
  opacity: 0.85;
}
.btn-disabled {
  opacity: 0.45;
}
