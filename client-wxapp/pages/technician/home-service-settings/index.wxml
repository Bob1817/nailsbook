<nav-bar title="上门设置" showBack/>
<view class="page">

  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
  </view>

  <view wx:else>

    <!-- ===== 状态 Hero 卡 ===== -->
    <view class="hero-card {{enabled ? 'hero-on' : 'hero-off'}}">
      <view class="hero-left">
        <view class="hero-icon-wrap">
          <text class="hero-icon">🚗</text>
        </view>
        <view class="hero-text">
          <text class="hero-title">上门服务</text>
          <text class="hero-status-label {{enabled ? 'label-on' : 'label-off'}}">
            {{enabled ? '已开启' : '未开启'}}
          </text>
        </view>
      </view>
      <switch checked="{{enabled}}" bindchange="toggleEnabled" color="#FF6B8A" />
    </view>

    <!-- ===== 快速开启引导（仅未开启时显示）===== -->
    <view wx:if="{{!enabled}}" class="quick-banner">
      <view class="quick-banner-body">
        <view class="quick-banner-text">
          <text class="quick-banner-title">{{fromSetup ? '🎉 快速完成设置' : '⚡ 一键开启'}}</text>
          <text class="quick-banner-desc">使用推荐默认配置立即开启，后续随时调整</text>
        </view>
        <view class="quick-banner-defaults">
          <text class="quick-default-item">服务范围 10 公里</text>
          <text class="quick-default-sep">·</text>
          <text class="quick-default-item">无附加费</text>
          <text class="quick-default-sep">·</text>
          <text class="quick-default-item">无最低消费</text>
        </view>
      </view>
      <view class="quick-btn {{saving ? 'quick-btn-disabled' : ''}}" bindtap="quickEnable">
        <text>{{saving ? '开启中…' : '一键开启'}}</text>
      </view>
    </view>

    <!-- ===== 参数配置（仅开启时显示）===== -->
    <view wx:if="{{enabled}}" class="config-card">
      <view class="config-card-header">
        <text class="config-card-title">服务配置</text>
        <text wx:if="{{_defaultFilled}}" class="config-card-tip">已填入推荐默认值</text>
      </view>

      <!-- 默认值提示条 -->
      <view wx:if="{{_defaultFilled}}" class="tip-bar">
        <text class="tip-dot"></text>
        <text class="tip-text">以下为推荐默认配置，可按需调整后保存</text>
      </view>

      <view class="field-group">
        <!-- 服务范围 -->
        <view class="field-row">
          <view class="field-label-wrap">
            <text class="field-label">服务范围</text>
            <text class="field-unit">公里</text>
          </view>
          <input
            class="field-input"
            type="digit"
            value="{{radius}}"
            bindinput="onRadiusInput"
            placeholder="如：10"
            placeholder-class="ph"
          />
        </view>
        <view class="field-sep"></view>

        <!-- 上门附加费 -->
        <view class="field-row">
          <view class="field-label-wrap">
            <text class="field-label">上门附加费</text>
            <text class="field-unit">元</text>
          </view>
          <input
            class="field-input"
            type="digit"
            value="{{extraFee}}"
            bindinput="onExtraFeeInput"
            placeholder="如：20"
            placeholder-class="ph"
          />
        </view>
        <view class="field-sep"></view>

        <!-- 最低消费 -->
        <view class="field-row">
          <view class="field-label-wrap">
            <text class="field-label">最低消费</text>
            <text class="field-unit">元</text>
          </view>
          <input
            class="field-input"
            type="digit"
            value="{{minOrderAmount}}"
            bindinput="onMinAmountInput"
            placeholder="如：150"
            placeholder-class="ph"
          />
        </view>
        <view class="field-sep"></view>

        <!-- 备注说明 -->
        <view class="field-row field-row-textarea">
          <text class="field-label">备注说明</text>
          <textarea
            class="field-textarea"
            value="{{notes}}"
            bindinput="onNotesInput"
            placeholder="如：地铁3公里内，服务时间9-21点"
            placeholder-class="ph"
            auto-height
          />
        </view>
      </view>
    </view>

    <!-- ===== 保存按钮 ===== -->
    <view class="btn-save {{saving ? 'btn-disabled' : ''}}" bindtap="save">
      <text>{{saving ? '保存中…' : '保存设置'}}</text>
    </view>

    <!-- 关闭服务提示 -->
    <view wx:if="{{!enabled}}" class="close-tip">
      <text>关闭上门服务后，客户将无法预约上门美甲</text>
    </view>

  </view>
</view>
