.container {
  min-height: 100vh;
  background: var(--nb-page);
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

@import '../../../styles/booking-form.wxss';
@import '../../../styles/booking-actions.wxss';

/* ===== 加载与空状态 ===== */
.loading-wrap { display:flex; justify-content:center; padding:200rpx 0; }
.loading-spinner { width:60rpx; height:60rpx; border:4rpx solid var(--nb-line); border-top-color: var(--brand-primary); border-radius:50%; animation:spin .8s linear infinite; }
@keyframes spin { to { transform:rotate(360deg); } }
.empty, .load-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx 80rpx;
}
.service-empty-mark { width:88rpx; height:88rpx; box-sizing:border-box; padding:18rpx 16rpx; margin-bottom:32rpx; border: 0; border-radius: var(--radius-sm); }
.service-empty-mark view { height:4rpx; margin-bottom:12rpx; border-radius:4rpx; background:var(--nb-action); }
.load-error-mark { width:88rpx; height:88rpx; margin-bottom:32rpx; border-radius:50%; background:var(--nb-page); color:var(--nb-ink); font-size: var(--font-xl); line-height:88rpx; text-align:center; }
.empty-text {
  font-size: var(--font-lg);
  color: var(--text-body);
  margin-bottom: 12rpx;
}
.empty-sub {
  font-size: var(--font-sm);
  color: var(--text-muted);
  margin-bottom: 56rpx;
}
.btn-add-first {
  height: 88rpx;
  padding: 0 72rpx;
  background: var(--nb-action);
  color: var(--text-inverse);
  border-radius: var(--radius-xl);
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  border: none;
  line-height: 88rpx;
}
.retry-btn { min-height:88rpx; margin:0; padding:0 56rpx; border:0; border-radius: var(--radius-xl); background:var(--nb-ink); color: var(--text-inverse); font-size: var(--font-md); line-height:88rpx; }
.retry-btn::after { border:0; }

/* ===== 服务列表 ===== */
.list {
  padding: 8rpx 28rpx 0;
}

/* ===== 服务卡片 ===== */
.svc-card {
  position: relative;
  background: var(--bg-card);
  border: 0;
  border-radius: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(34, 34, 34, 0.035);
}
.svc-card.menu-open { z-index: 31; }

.svc-card-body {
  padding: 30rpx 30rpx 28rpx;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.card-menu-wrap { position: relative; flex-shrink: 0; }
.card-menu-trigger {
  width: 88rpx;
  height: 88rpx;
  margin: -24rpx -20rpx -24rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.card-menu-trigger:active { background: var(--nb-page); }
.more-icon { display:flex; align-items:center; gap:6rpx; }
.more-icon view { width:7rpx; height:7rpx; border-radius:50%; background:var(--nb-muted); }
.action-menu-scrim { position:fixed; top:0; right:0; bottom:0; left:0; z-index:25; background:transparent; }
.action-menu {
  position: absolute;
  top: 70rpx;
  right: -8rpx;
  width: 220rpx;
  padding: 8rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 20rpx;
  background: var(--nb-surface);
  box-shadow: 0 18rpx 48rpx rgba(34,34,34,.14);
  z-index: 32;
}
.action-menu-arrow {
  position:absolute;
  top:-9rpx;
  right:32rpx;
  width:18rpx;
  height:18rpx;
  background:var(--nb-surface);
  border-left:1rpx solid var(--nb-line);
  border-top:1rpx solid var(--nb-line);
  transform:rotate(45deg);
}
.action-menu-item {
  position:relative;
  min-height:88rpx;
  padding:0 24rpx;
  display:flex;
  align-items:center;
  border-radius:14rpx;
  color:var(--text-body);
  font-size:var(--font-sm);
  font-weight:var(--weight-medium);
}
.action-menu-item:active { background:var(--nb-page); }
.action-menu .action-edit { color:var(--text-primary); font-weight:var(--weight-semibold); }
.action-menu .action-toggle { color:var(--nb-secondary); }
.action-menu .action-delete { color:var(--nb-danger); }
.svc-title-row {
  display:flex;
  align-items:center;
  gap:14rpx;
  margin-top:20rpx;
}
.svc-name {
  min-width:0;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  display: block;
  font-size: 34rpx;
  font-weight: var(--weight-semibold);
  color: var(--nb-ink);
  line-height: 1.35;
  letter-spacing: -0.5rpx;
}
.svc-category {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
  color: var(--text-muted);
  line-height: 1.3;
}

/* 状态徽章 */
.svc-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
  flex-shrink: 0;
  padding: 7rpx 14rpx;
  border-radius: var(--radius-full);
}
.badge-active {
  color: var(--nb-success);
  background:var(--nb-success-surface);
}
.badge-inactive {
  color: var(--nb-muted);
  background:var(--nb-page);
}
.badge-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}
.dot-active {
  background: var(--nb-action);
}
.dot-inactive {
  background: var(--nb-control);
}

/* 描述 */
.svc-desc {
  margin-top: 12rpx;
  font-size: var(--font-sm);
  color: var(--text-muted);
  line-height: 1.55;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.svc-meta {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 24rpx;
}
.svc-meta-group {
  min-width:0;
  padding:20rpx 22rpx;
  box-sizing:border-box;
  border-radius:18rpx;
  background:var(--nb-page);
}
.svc-meta-label { display:block; color:var(--text-muted); font-size:22rpx; line-height:1.2; }
.svc-price {
  display:block;
  margin-top:10rpx;
  color: var(--nb-money);
  font-size: 36rpx;
  line-height: 1;
  font-weight: var(--weight-semibold);
  letter-spacing: -0.5rpx;
}
.svc-duration-value { margin-top:10rpx; display:flex; align-items:baseline; gap:6rpx; }
.svc-duration-number { color:var(--text-primary); font-size:32rpx; line-height:1; font-weight:var(--weight-semibold); }
.svc-duration-unit { color:var(--text-muted); font-size:22rpx; line-height:1; }

.form-pair { display:flex; gap:16rpx; }.form-half { min-width:0; flex:1; }
.form-helper { display:block; margin:-4rpx 0 24rpx; color:var(--text-muted); font-size:24rpx; line-height:1.6; }

/* ===== FAB 添加按钮 ===== */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  width: 108rpx;
  height: 108rpx;
  background: var(--nb-action);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.35) /* brand-primary-alpha */;
  z-index: 20;
}
.fab:active {
  transform: scale(0.92);
}
.fab-icon {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-inverse);
  font-size: var(--font-2xl);
  font-weight: 300;
  line-height: 1;
  transform: translateY(3rpx);
}

/* ===== 底部表单 ===== */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}
.form-sheet {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: var(--bg-card);
  border-radius: var(--radius-lg) 32rpx 0 0;
  padding: 32rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}
.form-sheet.show {
  transform: translateY(0);
}
.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
}
.sheet-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}
.sheet-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--bg-input);
}
.sheet-close-icon {
  font-size: var(--font-lg);
  color: var(--text-muted);
  line-height: 1;
}
.form-item {
  margin-bottom: 28rpx;
}
.label {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-muted);
  margin-bottom: 12rpx;
}
.input {
  width: 100%;
  height: 88rpx;
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  padding: 0 24rpx;
  font-size: var(--font-md);
  color: var(--text-primary);
  box-sizing: border-box;
}
.picker-view {
  height: 88rpx;
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: var(--font-md);
  color: var(--text-primary);
}
.picker-arrow {
  font-size: var(--font-lg);
  color: var(--text-muted);
}
.textarea {
  width: 100%;
  height: 160rpx;
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  padding: var(--space-md);
  font-size: var(--font-md);
  color: var(--text-primary);
  box-sizing: border-box;
}
.btn-save {
  width: 100%;
  height: 96rpx;
  background: var(--nb-action);
  color: var(--text-inverse);
  border-radius: var(--btn-radius);
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  margin-top: 20rpx;
  border: none;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.btn-save[disabled] {
  opacity: 0.45;
}
