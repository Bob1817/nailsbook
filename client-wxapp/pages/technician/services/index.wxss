.container {
  min-height: 100vh;
  background: #f6f7f9;
  padding-bottom: 140rpx;
}

/* ===== 加载与空状态 ===== */
.loading-wrap { display:flex; justify-content:center; padding:200rpx 0; }
.loading-spinner { width:60rpx; height:60rpx; border:4rpx solid #ffd0de; border-top-color:#ff6b8a; border-radius:50%; animation:spin .8s linear infinite; }
@keyframes spin { to { transform:rotate(360deg); } }
.empty, .load-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx 80rpx;
}
.service-empty-mark { width:88rpx; height:88rpx; box-sizing:border-box; padding:18rpx 16rpx; margin-bottom:32rpx; border:4rpx solid #d9a0b9; border-radius:14rpx; }
.service-empty-mark view { height:4rpx; margin-bottom:12rpx; border-radius:4rpx; background:#d9a0b9; }
.load-error-mark { width:88rpx; height:88rpx; margin-bottom:32rpx; border-radius:50%; background:#fff0f4; color:#c75b83; font-size:44rpx; line-height:88rpx; text-align:center; }
.empty-text {
  font-size: 32rpx;
  color: #374151;
  margin-bottom: 12rpx;
}
.empty-sub {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 56rpx;
}
.btn-add-first {
  height: 88rpx;
  padding: 0 72rpx;
  background: linear-gradient(135deg, #ff6b8a, #a855f7);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  line-height: 88rpx;
}
.retry-btn { min-height:88rpx; margin:0; padding:0 56rpx; border:0; border-radius:44rpx; background:#1f2937; color:#fff; font-size:28rpx; line-height:88rpx; }
.retry-btn::after { border:0; }

/* ===== 服务列表 ===== */
.list {
  padding: 0 24rpx;
}

/* ===== 服务卡片 ===== */
.svc-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.card-title-area {
  flex: 1;
  min-width: 0;
}
.svc-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.3;
  margin-bottom: 6rpx;
}
.svc-category {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.4;
}

/* 状态徽章 */
.svc-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}
.badge-active {
  background: rgba(16, 185, 129, 0.08);
  color: #059669;
}
.badge-inactive {
  background: #f3f4f6;
  color: #6b7280;
}
.badge-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.dot-active {
  background: #10b981;
}
.dot-inactive {
  background: #d1d5db;
}

/* 描述 */
.svc-desc {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.6;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
}
.svc-meta { display:flex; gap:24rpx; margin-bottom:20rpx; color:#9d4f73; font-size:24rpx; font-weight:600; }

/* ===== 操作按钮 ===== */
.card-actions {
  display: flex;
  gap: 16rpx;
}
.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 500;
}
.form-pair { display:flex; gap:16rpx; }.form-half { min-width:0; flex:1; }
.action-btn:active {
  opacity: 0.65;
}
.action-toggle {
  background: #f3f4f6;
  color: #374151;
}
.action-edit {
  background: rgba(255, 107, 138, 0.08);
  color: #ff6b8a;
}
.action-delete {
  background: rgba(239, 68, 68, 0.06);
  color: #ef4444;
}

/* ===== FAB 添加按钮 ===== */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(80rpx + env(safe-area-inset-bottom));
  width: 108rpx;
  height: 108rpx;
  background: linear-gradient(135deg, #ff6b8a, #a855f7);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 138, 0.35);
}
.fab:active {
  transform: scale(0.92);
}
.fab-icon {
  color: #fff;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}

/* ===== 底部表单 ===== */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}
.form-sheet {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}
.form-sheet.show {
  transform: translateY(0);
}
.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2937;
}
.sheet-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f3f4f6;
}
.sheet-close-icon {
  font-size: 36rpx;
  color: #6b7280;
  line-height: 1;
}
.form-item {
  margin-bottom: 28rpx;
}
.label {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}
.input {
  width: 100%;
  height: 88rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1f2937;
  box-sizing: border-box;
}
.picker-view {
  height: 88rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: #1f2937;
}
.picker-arrow {
  font-size: 36rpx;
  color: #767b84;
}
.textarea {
  width: 100%;
  height: 160rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #1f2937;
  box-sizing: border-box;
}
.btn-save {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #ff6b8a, #a855f7);
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  margin-top: 20rpx;
  border: none;
  line-height: 96rpx;
}
.btn-save[disabled] {
  opacity: 0.45;
}
