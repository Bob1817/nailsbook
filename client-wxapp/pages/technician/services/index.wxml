<nav-bar title="服务管理" showBack/>
<view class="container">
  <view class="svc-card">
    <view class="form-item"><text class="label">预约定金</text><picker range="{{depositModes}}" value="{{depositModeIndex}}" bindchange="onDepositMode"><view class="input form-input">{{depositModes[depositModeIndex]}}</view></picker></view>
    <view wx:if="{{depositModeIndex > 0}}" class="form-item"><text class="label">{{depositModeIndex === 2 ? '最终总价比例（%）' : '固定定金（元）'}}</text><input class="input form-input" type="digit" value="{{depositInput}}" bindinput="onDepositInput" placeholder="0" placeholder-class="form-placeholder" /></view>
    <text class="form-helper">未设置为 0；比例按含附加费、扣除优惠后的最终总价计算，确认预约时可修改。</text>
    <button class="booking-action btn-save" bindtap="savePricingSettings" disabled="{{pricingSaving}}">保存定金设置</button>
  </view>

  <view class="svc-card loyalty-card">
    <view class="loyalty-head"><view><text class="label">会员等级与权益</text><text class="form-helper">仅对你的客户生效</text></view><switch checked="{{loyaltyEnabled}}" bindchange="toggleLoyalty" color="#111111" /></view>
    <view class="form-item"><text class="label">每实付 1 元赠送积分</text><input class="input form-input" type="digit" value="{{pointsPerYuan}}" bindinput="onPointsRate" placeholder="0" placeholder-class="form-placeholder" /></view>
    <view wx:for="{{loyaltyTiers}}" wx:key="id" class="loyalty-tier">
      <view class="loyalty-tier-head"><text>等级 {{index + 1}}</text><text class="tier-remove" bindtap="removeLoyaltyTier" data-index="{{index}}">删除</text></view>
      <input class="input form-input" value="{{item.name}}" bindinput="updateLoyaltyTier" data-index="{{index}}" data-field="name" placeholder="等级名称，如银卡会员" placeholder-class="form-placeholder" />
      <picker range="{{thresholdTypes}}" value="{{item.thresholdTypeIndex}}" bindchange="updateTierType" data-index="{{index}}"><view class="input form-input">升级依据：{{thresholdTypes[item.thresholdTypeIndex]}}</view></picker>
      <input class="input form-input" type="digit" value="{{item.thresholdValue}}" bindinput="updateLoyaltyTier" data-index="{{index}}" data-field="thresholdValue" placeholder="达到数值" placeholder-class="form-placeholder" />
      <input class="input form-input" type="digit" value="{{item.discountPercent}}" bindinput="updateLoyaltyTier" data-index="{{index}}" data-field="discountPercent" placeholder="折扣减免比例，如 10" placeholder-class="form-placeholder" />
      <input class="input form-input" value="{{item.benefitsText}}" bindinput="updateLoyaltyTier" data-index="{{index}}" data-field="benefitsText" placeholder="权益，用顿号分隔" placeholder-class="form-placeholder" />
    </view>
    <button class="booking-action loyalty-add" bindtap="addLoyaltyTier">添加会员等级</button>
    <button class="booking-action btn-save" bindtap="saveLoyaltySettings" disabled="{{loyaltySaving}}">保存会员权益</button>
  </view>


  <view wx:if="{{loading}}" class="loading-wrap"><view class="loading-spinner"></view></view>

  <view wx:elif="{{loadFailed}}" class="load-error" aria-live="polite">
    <view class="load-error-mark">!</view>
    <text class="empty-text">服务项目加载失败</text>
    <text class="empty-sub">请检查网络后重试</text>
    <button class="booking-action retry-btn" bindtap="loadServices">重新加载</button>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{services.length === 0}}" class="empty">
    <view class="service-empty-mark"><view></view><view></view><view></view></view>
    <text class="empty-text">还没有服务项目</text>
      <text class="empty-sub">至少添加一项有效服务和价格，才能开启接单</text>
    <button class="booking-action btn-add-first" bindtap="openCreate">添加第一个服务</button>
  </view>

  <!-- 服务列表 -->
  <view wx:if="{{actionMenuId !== null}}" class="action-menu-scrim" bindtap="closeActionMenu"></view>
  <view wx:if="{{!loading && !loadFailed && services.length > 0}}" class="list">
    <view
      class="svc-card {{actionMenuId === item.id ? 'menu-open' : ''}}"
      wx:for="{{services}}"
      wx:key="id"
    >
      <view class="svc-card-body">
        <view class="card-top">
          <text class="svc-category">{{item.categoryLabel}}</text>
          <view class="card-menu-wrap">
            <view class="card-menu-trigger" catchtap="toggleActionMenu" data-id="{{item.id}}" role="button" aria-label="打开{{item.name}}操作菜单" aria-expanded="{{actionMenuId === item.id}}">
              <view class="more-icon"><view></view><view></view><view></view></view>
            </view>
            <view wx:if="{{actionMenuId === item.id}}" class="action-menu">
              <view class="action-menu-arrow"></view>
              <view class="action-menu-item action-edit" catchtap="openEdit" data-id="{{item.id}}" role="button">编辑</view>
              <view class="action-menu-item action-toggle" catchtap="toggleService" data-id="{{item.id}}" role="button">{{item.isActive ? '下架' : '上架'}}</view>
              <view class="action-menu-item action-delete semantic-danger" catchtap="confirmDelete" data-id="{{item.id}}" role="button">删除</view>
            </view>
          </view>
        </view>

        <view class="svc-title-row">
          <text class="svc-name">{{item.name}}</text>
          <view class="svc-badge {{item.isActive ? 'badge-active' : 'badge-inactive'}}">
            <view class="badge-dot {{item.isActive ? 'dot-active' : 'dot-inactive'}}"></view>
            <text>{{item.isActive ? '上架中' : '已下架'}}</text>
          </view>
        </view>
        <text wx:if="{{item.description}}" class="svc-desc">{{item.description}}</text>

        <view class="svc-meta">
          <view class="svc-meta-group">
            <text class="svc-meta-label">服务价格</text>
            <text class="svc-price semantic-money">¥{{item.price != null ? item.price : '待设置'}}</text>
          </view>
          <view class="svc-meta-group">
            <text class="svc-meta-label">预计时长</text>
            <view class="svc-duration-value"><text class="svc-duration-number">{{item.durationMinutes || '待设置'}}</text><text class="svc-duration-unit">分钟</text></view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- FAB 添加按钮 -->
  <view wx:if="{{services.length > 0 && !loadFailed}}" class="fab" bindtap="openCreate">
    <text class="fab-icon">+</text>
  </view>

  <!-- 底部表单 -->
  <view wx:if="{{showForm}}" class="mask" bindtap="closeForm"/>
  <view class="form-sheet {{showForm ? 'show' : ''}}">
    <view class="sheet-header">
      <text class="sheet-title">{{editingId ? '编辑服务' : '添加服务'}}</text>
      <view class="sheet-close" bindtap="closeForm">
        <text class="sheet-close-icon">×</text>
      </view>
    </view>

    <view class="form-item">
      <text class="label">服务名称 *</text>
      <input placeholder-class="form-placeholder" class="input form-input" placeholder="例：法式美甲" value="{{form.name}}" data-field="name" bindinput="onFormInput" confirm-type="done" />
    </view>

    <view class="form-item">
      <text class="label">分类</text>
      <picker mode="selector" range="{{categories}}" range-key="label" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker-view form-input">
          <text>{{categories[categoryIndex].label}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="form-pair">
      <view class="form-item form-half"><text class="label">服务价格（元）*</text><input placeholder-class="form-placeholder" class="input form-input" type="digit" placeholder="例如 168" value="{{form.price}}" data-field="price" bindinput="onFormInput" confirm-type="done" /></view>
      <view wx:if="{{categoryIndex < 4}}" class="form-item form-half"><text class="label">预计时长（分钟）*</text><input placeholder-class="form-placeholder" class="input form-input" type="number" placeholder="60" value="{{form.durationMinutes}}" data-field="durationMinutes" bindinput="onFormInput" confirm-type="done" /></view>
    </view>

    <text class="form-helper">客户预约时可多选服务，系统会按这里的价格自动累加。</text>

    <view class="form-item">
      <text class="label">描述（选填）</text>
      <textarea placeholder-class="form-placeholder" class="form-textarea textarea" placeholder="服务详细说明" value="{{form.description}}" data-field="description" bindinput="onFormInput" confirm-type="done" />
    </view>

    <button class="booking-action btn-save" bindtap="handleSubmit" disabled="{{submitting}}">
      {{submitting ? '保存中...' : '保存'}}
    </button>
  </view>

</view>
