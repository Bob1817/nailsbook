<nav-bar title="服务管理" showBack/>
<view class="container">

  <!-- 页面标题区 -->
  <view class="page-header">
    <text class="page-title">服务管理</text>
    <text class="page-subtitle">管理你提供的美甲服务项目</text>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{services.length === 0 && !loading}}" class="empty">
    <text class="empty-icon">📋</text>
    <text class="empty-text">还没有服务项目</text>
    <text class="empty-sub">添加你提供的美甲服务，方便客户下单</text>
    <button class="btn-add-first" bindtap="openCreate">添加第一个服务</button>
  </view>

  <!-- 服务列表 -->
  <view wx:else class="list">
    <view
      class="svc-card"
      wx:for="{{services}}"
      wx:key="id"
    >
      <!-- 卡片顶部：名称 + 状态 -->
      <view class="card-top">
        <view class="card-title-area">
          <text class="svc-name">{{item.name}}</text>
          <text class="svc-category">{{item.categoryLabel}}</text>
        </view>
        <view class="svc-badge {{item.isActive ? 'badge-active' : 'badge-inactive'}}">
          <view class="badge-dot {{item.isActive ? 'dot-active' : 'dot-inactive'}}"></view>
          <text>{{item.isActive ? '上架中' : '已下架'}}</text>
        </view>
      </view>

      <!-- 描述 -->
      <text wx:if="{{item.description}}" class="svc-desc">{{item.description}}</text>

      <!-- 操作按钮 -->
      <view class="card-actions">
        <view class="action-btn action-toggle" bindtap="toggleService" data-id="{{item.id}}">
          <text>{{item.isActive ? '下架' : '上架'}}</text>
        </view>
        <view class="action-btn action-edit" bindtap="openEdit" data-id="{{item.id}}">
          <text>编辑</text>
        </view>
        <view class="action-btn action-delete" bindtap="confirmDelete" data-id="{{item.id}}">
          <text>删除</text>
        </view>
      </view>
    </view>
  </view>

  <!-- FAB 添加按钮 -->
  <view wx:if="{{services.length > 0}}" class="fab" bindtap="openCreate">
    <text class="fab-icon">+</text>
  </view>

  <!-- 底部表单 -->
  <view wx:if="{{showForm}}" class="mask" bindtap="closeForm"/>
  <view class="form-sheet {{showForm ? 'show' : ''}}">
    <view class="sheet-header">
      <text class="sheet-title">{{editingId ? '编辑服务' : '添加服务'}}</text>
      <view class="sheet-close" bindtap="closeForm">
        <text class="sheet-close-icon">×</text>
      </view>
    </view>

    <view class="form-item">
      <text class="label">服务名称 *</text>
      <input class="input" placeholder="例：法式美甲" value="{{form.name}}" data-field="name" bindinput="onFormInput"/>
    </view>

    <view class="form-item">
      <text class="label">分类</text>
      <picker mode="selector" range="{{categories}}" range-key="label" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker-view">
          <text>{{categories[categoryIndex].label}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <text class="label">描述（选填）</text>
      <textarea class="textarea" placeholder="服务详细说明" value="{{form.description}}" data-field="description" bindinput="onFormInput"/>
    </view>

    <button class="btn-save" bindtap="handleSubmit" disabled="{{submitting}}">
      {{submitting ? '保存中...' : '保存'}}
    </button>
  </view>

</view>
