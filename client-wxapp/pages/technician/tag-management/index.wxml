<view class="container">
  <view class="add-section">
    <input class="tag-input" value="{{newTag}}" bindinput="onNewTagInput" placeholder="输入标签名" placeholder-class="ph" confirm-type="done" bindconfirm="addTag" />
    <view class="add-btn {{adding ? 'btn-disabled' : ''}}" bindtap="addTag">
      <text>{{adding ? '添加中' : '添加'}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-wrap"><view class="loading-spinner"></view></view>

  <view wx:elif="{{tags.length === 0}}" class="empty">
    <text class="empty-icon">🏷️</text>
    <text class="empty-text">还没有标签，添加一个吧</text>
    <text class="empty-desc">标签可用于给客户打分类标记</text>
  </view>

  <view wx:else class="tag-list">
    <view wx:for="{{tags}}" wx:key="id" class="tag-item">
      <text class="tag-name"># {{item.name}}</text>
      <view class="tag-del" bindtap="deleteTag" data-id="{{item.id}}" data-name="{{item.name}}">✕</view>
    </view>
  </view>
</view>
