<nav-bar title="标签管理" showBack/>
<view class="container">


  <!-- 添加标签 -->
  <view class="add-card">
    <input class="tag-input" value="{{newTag}}" bindinput="onNewTagInput" placeholder="输入标签名（最多12字）" maxlength="12" placeholder-class="ph" confirm-type="done" bindconfirm="addTag" />
    <view class="add-btn {{adding ? 'btn-disabled' : ''}}" bindtap="addTag">
      <text>{{adding ? '添加中' : '添加'}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-wrap"><view class="loading-spinner"></view></view>

  <view wx:elif="{{loadFailed}}" class="load-error" aria-live="polite">
    <view class="load-error-mark">!</view>
    <text class="empty-text">标签加载失败</text>
    <text class="empty-sub">请检查网络后重试</text>
    <button class="retry-btn" bindtap="loadTags">重新加载</button>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{tags.length === 0}}" class="empty">
    <view class="empty-icon"><view class="tag-outline"></view></view>
    <text class="empty-text">还没有标签</text>
    <text class="empty-sub">在上方输入框添加标签，用于客户分类</text>
  </view>

  <!-- 标签列表 -->
  <view wx:else class="tag-list">
    <view wx:for="{{tags}}" wx:key="id" class="tag-card">
      <text class="tag-name"># {{item.name}}</text>
      <view class="tag-del" bindtap="deleteTag" data-id="{{item.id}}" data-name="{{item.name}}">
        <text class="tag-del-icon">×</text>
      </view>
    </view>
  </view>
  <text wx:if="{{tags.length}}" class="tag-note">删除模板不会移除已经添加到客户资料中的标签。</text>
</view>
