page { background:var(--nb-page); color:var(--nb-ink); }.page { min-height:100vh; padding:0 var(--space-md) 120rpx; box-sizing:border-box; }
.category-tabs { display:flex; gap:var(--space-xs); margin-bottom:20rpx; padding:var(--space-xs); border-radius:var(--radius-md); background:var(--nb-soft-surface); }
.category-tab { flex:1; min-height:88rpx; padding:0 20rpx; border-radius:16rpx; display:flex; align-items:center; justify-content:center; gap:12rpx; color:var(--nb-muted); font-size:var(--font-sm); font-weight:var(--weight-medium); box-sizing:border-box; }
.category-tab.active { background:var(--nb-surface); color:var(--nb-ink); box-shadow:var(--shadow-sm); }.tab-count { min-width:36rpx; height:36rpx; padding:0 var(--space-xs); border-radius:var(--radius-full); background:var(--nb-page); color:var(--nb-muted); font-size:var(--font-xs); line-height:36rpx; text-align:center; box-sizing:border-box; }.category-tab.active .tab-count { background:var(--nb-action); color:var(--text-inverse); }
.section-card { margin-bottom:20rpx; padding:28rpx; border-radius:24rpx; background:var(--nb-surface); box-shadow:var(--shadow-sm); }.section-head { display:flex; align-items:flex-start; justify-content:space-between; gap:20rpx; }.section-copy { flex:1; min-width:0; }.section-title,.section-sub,.state-title,.state-sub,.usage-title,.usage-text { display:block; }.section-title { color:var(--nb-ink); font-size:var(--font-md); font-weight:var(--weight-semibold); line-height:1.35; }.section-sub { margin-top:var(--space-xs); color:var(--nb-muted); font-size:var(--font-xs); line-height:1.45; }
.organize-action { min-width:88rpx; min-height:88rpx; margin:-20rpx -12rpx 0 0; display:flex; align-items:center; justify-content:center; font-size:var(--font-sm); font-weight:var(--weight-medium); }
.tag-cloud { display:flex; flex-wrap:wrap; gap:14rpx; margin-top:28rpx; }.tag-chip { position:relative; height: 54rpx; min-height: 54rpx; padding:0 22rpx; border-radius:var(--radius-full); background:var(--nb-page); border:1rpx solid rgba(0, 0, 0, 0.08); color:var(--nb-secondary); display:inline-flex; align-items:center; gap:var(--space-xs); font-size:24rpx; font-weight:var(--weight-medium); box-sizing:border-box; max-width:100%; }
.tag-chip::after { content:''; position:absolute; top:-16rpx; bottom:-16rpx; left:0; right:0; }.tag-hash { color:var(--nb-muted); }.tag-cloud.organizing .tag-chip { padding-right:var(--space-xs); }.tag-remove { width:44rpx; height:44rpx; margin-left:4rpx; border-radius:50%; background:var(--nb-danger-surface); display:flex; align-items:center; justify-content:center; flex-shrink:0; }.organize-tip { margin-top:var(--space-md); padding:20rpx 22rpx; border-radius:16rpx; background:var(--nb-danger-surface); color:var(--nb-danger); font-size:var(--font-xs); line-height:1.5; }
.state-wrap { min-height:260rpx; padding:var(--space-2xl) 20rpx 20rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; box-sizing:border-box; }.state-title { color:var(--nb-ink); font-size:var(--font-sm); font-weight:var(--weight-medium); }.state-sub { margin-top:var(--space-xs); color:var(--nb-muted); font-size:var(--font-xs); line-height:1.45; }.empty-symbol { width:72rpx; height:72rpx; margin-bottom:18rpx; border-radius:var(--radius-md); background:var(--nb-soft-surface); color:var(--nb-secondary); display:flex; align-items:center; justify-content:center; font-size:var(--font-lg); font-weight:var(--weight-semibold); }.loading-spinner { width:48rpx; height:48rpx; margin-bottom:18rpx; border:4rpx solid var(--nb-soft-surface); border-top-color:var(--nb-action); border-radius:50%; animation:spin .8s linear infinite; }@keyframes spin { to { transform:rotate(360deg); } }
.retry-btn,.create-btn { min-height:88rpx; margin:var(--space-md) 0 0; padding:0 28rpx; border:0; border-radius:var(--btn-radius); background:var(--nb-action); color:var(--text-inverse); display:flex; align-items:center; justify-content:center; font-size:var(--font-sm); font-weight:var(--weight-medium); box-sizing:border-box; }.retry-btn::after,.create-btn::after { border:0; }.create-btn { width:100%; min-height:96rpx; }.create-btn[disabled] { background:var(--nb-pressed); color:var(--nb-control); }.create-btn:active { background:var(--nb-action-pressed); }
.create-head { align-items:center; }.input-count { color:var(--nb-muted); font-size:var(--font-xs); }.input-shell { min-height:96rpx; margin-top:var(--space-md); padding:0 22rpx; border-radius:18rpx; background:var(--nb-soft-surface); display:flex; align-items:center; gap:12rpx; box-sizing:border-box; }.input-prefix { color:var(--nb-secondary); font-size:var(--font-md); font-weight:var(--weight-semibold); }.tag-input { flex:1; min-width:0; height:88rpx; color:var(--nb-ink); font-size:var(--font-sm); }.ph { color:var(--nb-muted); }
.usage-note { padding:4rpx 12rpx 0; }.usage-title { color:var(--nb-secondary); font-size:var(--font-xs); font-weight:var(--weight-medium); }.usage-text { margin-top:var(--space-xs); color:var(--nb-muted); font-size:var(--font-xs); line-height:1.55; }

@import '../../../styles/booking-actions.wxss';
.input-shell { min-height:44px; padding:0 var(--input-padding-h); border-radius:var(--input-radius); }
.tag-input { height:var(--input-height); min-height:44px; }
.ph { font-size:var(--font-sm); }
.category-tab,.organize-action { min-height:44px; }
.tag-remove { width:44px; height:44px; flex-shrink:0; }
.tag-remove-icon { width: var(--icon-xs); height: var(--icon-xs); }
.tag-chip { max-width:100%; }
.tag-name { min-width:0; word-break:break-all; }
.tag-remove:active,.category-tab:active { opacity:.78; }
