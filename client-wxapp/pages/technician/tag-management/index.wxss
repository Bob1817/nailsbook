.container {
  min-height: 100vh;
  background: #f6f7f9;
  padding-bottom: 140rpx;
}

/* ===== 页面标题区 ===== */
.page-header {
  padding: 24rpx 40rpx 28rpx;
}
.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.2;
  margin-bottom: 8rpx;
}
.page-subtitle {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.4;
}

/* ===== 加载 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #FF6B8A;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ===== 添加标签卡片 ===== */
.add-card {
  margin: 0 24rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.tag-input {
  flex: 1;
  height: 80rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1f2937;
}
.ph {
  color: #9ca3af;
}
.add-btn {
  height: 80rpx;
  padding: 0 40rpx;
  background: linear-gradient(135deg, #ff6b8a, #a855f7);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.add-btn:active {
  opacity: 0.85;
}
.btn-disabled {
  opacity: 0.45;
}

/* ===== 空状态 ===== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx 80rpx;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 32rpx;
}
.empty-text {
  font-size: 32rpx;
  color: #374151;
  margin-bottom: 12rpx;
}
.empty-sub {
  font-size: 26rpx;
  color: #9ca3af;
}

/* ===== 标签列表 ===== */
.tag-list {
  padding: 0 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.tag-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}
.tag-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #ff6b8a;
}
.tag-del {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.tag-del:active {
  background: #e5e7eb;
}
.tag-del-icon {
  font-size: 28rpx;
  color: #9ca3af;
  line-height: 1;
}
