.container {
  min-height: 100vh;
  background: #f6f7f9;
  padding-bottom: 140rpx;
}

/* ===== 加载 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--brand-primary);
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ===== 添加标签卡片 ===== */
.add-card {
  margin: 0 24rpx 20rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: var(--space-md) 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.tag-input {
  flex: 1;
  height: 88rpx;
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  padding: 0 24rpx;
  font-size: var(--font-md);
  color: var(--text-primary);
}
.ph {
  color: var(--text-muted);
}
.add-btn {
  height: 88rpx;
  padding: 0 40rpx;
  background: linear-gradient(135deg, #ff6b8a, #a855f7);
  color: var(--text-inverse);
  border-radius: var(--radius-xl);
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.add-btn:active {
  opacity: 0.85;
}
.btn-disabled {
  opacity: 0.45;
}

/* ===== 空状态 ===== */
.empty, .load-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx 80rpx;
}
.load-error-mark { width:88rpx; height:88rpx; margin-bottom:32rpx; border-radius:50%; background:#fff0f4; color:#c75b83; font-size: var(--font-xl); line-height:88rpx; text-align:center; }
.retry-btn { min-height:88rpx; margin:0; padding:0 56rpx; border:0; border-radius: var(--radius-xl); background:#1f2937; color: var(--text-inverse); font-size: var(--font-md); line-height:88rpx; }
.retry-btn::after { border:0; }
.empty-icon {
  position:relative;
  width:88rpx;
  height:88rpx;
  margin-bottom: 32rpx;
}
.tag-outline { position:absolute; inset:12rpx; border:4rpx solid #d9a0b9; border-radius: var(--radius-xs) 28rpx 28rpx 12rpx; transform:rotate(-12deg); }
.tag-outline::after { content:''; position:absolute; left:12rpx; top:50%; width:10rpx; height:10rpx; margin-top:-5rpx; border-radius:50%; background:#d9a0b9; }
.empty-text {
  font-size: var(--font-lg);
  color: var(--text-body);
  margin-bottom: 12rpx;
}
.empty-sub {
  font-size: var(--font-sm);
  color: var(--text-muted);
}

/* ===== 标签列表 ===== */
.tag-list {
  padding: 0 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.tag-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 20rpx 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}
.tag-name {
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  color: var(--brand-primary);
}
.tag-del {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-input);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.tag-note { display:block; margin:28rpx 32rpx 0; color:#8d7c85; font-size: var(--font-xs); line-height:1.6; }
.tag-del:active {
  background: #e5e7eb;
}
.tag-del-icon {
  font-size: var(--font-md);
  color: var(--text-muted);
  line-height: 1;
}
