.container { min-height: 100vh; background: #f5f5f5; padding: 32rpx; }
.add-section { display: flex; align-items: center; background: #fff; border-radius: 20rpx; padding: 16rpx 16rpx 16rpx 32rpx; margin-bottom: 24rpx; gap: 16rpx; }
.tag-input { flex: 1; height: 64rpx; font-size: 30rpx; color: #1a1a1a; }
.ph { color: #ccc; }
.add-btn { background: linear-gradient(135deg, #FF6B8A, #FF8FA3); color: #fff; font-size: 28rpx; font-weight: 600; padding: 20rpx 32rpx; border-radius: 16rpx; flex-shrink: 0; }
.add-btn:active { opacity: 0.85; }
.btn-disabled { opacity: 0.6; }
.loading-wrap { display: flex; justify-content: center; padding: 120rpx 0; }
.loading-spinner { width: 60rpx; height: 60rpx; border: 4rpx solid #FF6B8A; border-top-color: transparent; border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.empty { display: flex; flex-direction: column; align-items: center; padding: 80rpx; }
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 30rpx; font-weight: 600; color: #1a1a1a; margin-bottom: 10rpx; }
.empty-desc { font-size: 26rpx; color: #999; }
.tag-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.tag-item { display: flex; align-items: center; background: #fff; border-radius: 40rpx; padding: 16rpx 24rpx; gap: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05); }
.tag-name { font-size: 28rpx; color: #FF6B8A; }
.tag-del { width: 40rpx; height: 40rpx; background: #f5f5f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 22rpx; color: #999; }
