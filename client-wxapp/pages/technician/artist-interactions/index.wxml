<nav-bar title="主页互动" showBack/>
<view class="records-page">
  <view class="tabs">
    <view class="tab {{type === 'like' ? 'active' : ''}}" data-type="like" bindtap="switchType">点赞</view>
    <view class="tab {{type === 'favorite' ? 'active' : ''}}" data-type="favorite" bindtap="switchType">收藏</view>
    <view class="tab {{type === 'comment' ? 'active' : ''}}" data-type="comment" bindtap="switchType">评论</view>
  </view>
  <text class="summary">主页收到的{{label}} · 按时间倒序</text>
  <view wx:for="{{list}}" wx:key="id" class="record">
    <view class="person">
      <image class="avatar" src="{{item.avatarUrl || '/static/icons/client.svg'}}" mode="aspectFill" aria-label="{{item.name}}的头像"/>
      <view class="person-info"><text class="name">{{item.name}}</text><text class="time">{{item.time}}</text></view>
      <text class="action">{{type === 'comment' ? '评论了主页' : label + '了主页'}}</text>
    </view>
    <view wx:if="{{type === 'comment'}}" class="comment-content">
      <text>{{item.content}}</text>
      <view class="comment-footer"><text>{{item.isPinned ? '已置顶' : ''}}{{item.isHidden ? ' · 已隐藏' : ''}}</text><view class="manage" bindtap="manageComment" data-id="{{item.id}}">管理</view></view>
    </view>
  </view>
  <view wx:if="{{error}}" class="state"><text>{{error}}</text><button class="retry booking-action" bindtap="retry" hover-class="pressed">重新加载</button></view>
  <view wx:elif="{{loading}}" class="state">正在加载…</view>
  <view wx:elif="{{!list.length}}" class="state">暂无{{label}}记录</view>
  <view wx:elif="{{!hasMore}}" class="state">已显示全部记录</view>
</view>
