.records-page { padding: var(--space-lg) var(--space-lg) calc(var(--space-lg) + env(safe-area-inset-bottom)); }
.tabs { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-xs); margin-bottom: var(--space-md); padding: var(--space-xs); border-radius: 12rpx; background: var(--nb-soft-surface); }
.tab { min-height: 44px; display: flex; align-items: center; justify-content: center; border-radius: 8px; color: var(--nb-muted); font-size: var(--font-sm); }
.tab.active { background: var(--nb-surface); color: var(--nb-ink); font-weight: var(--weight-semibold); }
.summary { display: block; margin-bottom: var(--space-md); font-size: var(--font-sm); line-height: 1.6; color: var(--nb-muted); }
.record { padding: 28rpx; margin-bottom: 20rpx; border-radius: var(--radius-md); background: var(--nb-surface); }
.person { display: flex; align-items: center; gap: 20rpx; }
.avatar { width: 80rpx; height: 80rpx; border-radius: 50%; flex-shrink: 0; }
.person-info { flex: 1; min-width: 0; }
.name { display: block; font-size: var(--font-md); font-weight: 600; color: var(--nb-ink); overflow-wrap: anywhere; }
.time, .action { font-size: var(--font-xs); color: var(--nb-muted); line-height: 1.6; }
.time { display: block; margin-top: 6rpx; }
.action { flex-shrink: 0; }
.comment-content { margin-top: 20rpx; padding: 20rpx; border-radius: 8px; background: var(--nb-page); color: var(--nb-secondary); font-size: var(--font-sm); line-height: 1.6; overflow-wrap: anywhere; }
.comment-footer { min-height: 44px; margin-top: 12rpx; display: flex; align-items: center; justify-content: space-between; color: var(--nb-muted); font-size: var(--font-xs); }
.manage { min-width: 88rpx; min-height: 44px; display: flex; align-items: center; justify-content: flex-end; color: var(--nb-text-link); font-size: var(--font-sm); }
.state { padding: var(--space-2xl) 0; text-align: center; color: var(--nb-muted); font-size: var(--font-md); }
.records-page .retry { min-height: 44px; margin-top: var(--space-md); padding: 0 var(--space-md); border-radius: 8px; background: var(--nb-action); color: var(--nb-inverse); font-size: var(--font-md); }
.retry::after { border: 0; }
.pressed { opacity: 0.7; }
@import '../../../styles/booking-actions.wxss';
.records-page .retry.booking-action { min-height:44px; height:44px; margin-top:var(--space-md); padding:0 var(--space-md); border-radius:8px; font-size:var(--font-sm); line-height:1.4; }
