.records-page { padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); }
.summary { display: block; margin-bottom: 24rpx; font-size: 24rpx; line-height: 1.6; color: var(--nb-muted); }
.record { padding: 28rpx; margin-bottom: 20rpx; border-radius: 20rpx; background: var(--nb-surface); }
.person { display: flex; align-items: center; gap: 20rpx; }
.avatar { width: 80rpx; height: 80rpx; border-radius: 50%; flex-shrink: 0; }
.person-info { flex: 1; min-width: 0; }
.name { display: block; font-size: 28rpx; font-weight: 600; color: var(--nb-ink); overflow-wrap: anywhere; }
.time, .action { font-size: 22rpx; color: var(--nb-muted); line-height: 1.6; }
.time { display: block; margin-top: 6rpx; }
.action { flex-shrink: 0; }
.work { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 44px; padding: 12rpx 20rpx; margin-top: 24rpx; box-sizing: border-box; border-radius: 8px; background: var(--nb-page); color: var(--nb-secondary); font-size: 26rpx; }
.work-title { min-width: 0; overflow-wrap: anywhere; }
.state { padding: 48rpx 0; text-align: center; color: var(--nb-muted); font-size: 26rpx; }
.records-page .retry { min-height: 44px; margin-top: 24rpx; padding: 0 24rpx; border-radius: 8px; background: var(--nb-action); color: var(--nb-inverse); font-size: 28rpx; }
.retry::after { border: 0; }
.pressed { opacity: 0.7; }
@import '../../../styles/booking-actions.wxss';
.records-page .retry.booking-action { min-height:44px; height:44px; margin-top:24rpx; padding:0 24rpx; border-radius:8px; font-size:var(--font-sm); line-height:1.4; }
