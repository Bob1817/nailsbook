.page{min-height:100vh;background:var(--nb-page);padding:24rpx}.list{background:var(--nb-surface);border: 0;border-radius:28rpx;overflow:hidden}.row{min-height:96rpx;padding:20rpx 24rpx;display:flex;align-items:center;justify-content:space-between;border-bottom: 0;}.row:last-child{border-bottom:0}.name,.meta{display:block}.name{font-size:30rpx;font-weight:600;color:var(--nb-ink)}.meta{margin-top:6rpx;font-size:24rpx;color:var(--nb-secondary)}.arrow{font-size:34rpx;color:var(--nb-muted)}.empty{padding:96rpx 24rpx;text-align:center;color:var(--nb-secondary)}
