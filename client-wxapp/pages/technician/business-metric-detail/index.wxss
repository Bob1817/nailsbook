.page {
  min-height: 100vh;
  background: var(--nb-page);
  padding: var(--space-md);
  box-sizing: border-box;
}
.list {
  background: var(--nb-surface);
  border: 1rpx solid var(--nb-line);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}
.row {
  min-height: 96rpx;
  padding: 24rpx var(--space-md);
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--nb-line);
}
.row:last-child {
  border-bottom: 0;
}
.name, .meta {
  display: block;
}
.name {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--nb-ink);
}
.meta {
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: var(--nb-secondary);
}
.arrow {
  font-size: var(--font-lg);
  color: var(--nb-muted);
}
.empty {
  padding: 96rpx var(--space-md);
  text-align: center;
  color: var(--nb-muted);
}
