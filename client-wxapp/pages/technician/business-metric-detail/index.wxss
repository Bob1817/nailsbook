.page{min-height:100vh;background:#f7f7f7;padding:24rpx}.list{background:#fff;border:1rpx solid #ddd;border-radius:28rpx;overflow:hidden}.row{min-height:96rpx;padding:20rpx 24rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #eee}.row:last-child{border-bottom:0}.name,.meta{display:block}.name{font-size:30rpx;font-weight:600;color:#222}.meta{margin-top:6rpx;font-size:24rpx;color:#6a6a6a}.arrow{font-size:34rpx;color:#929292}.empty{padding:96rpx 24rpx;text-align:center;color:#6a6a6a}
