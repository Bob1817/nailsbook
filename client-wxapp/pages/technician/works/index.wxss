.container {
  min-height: 100vh;
  background: var(--nb-page);
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 加载中 */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(0, 0, 0, 0.3) /* brand-primary-alpha */;
  border-top-color: var(--brand-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.empty-icon-wrap {
  margin-bottom: var(--space-md);
}



.empty-title {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-muted);
  margin-bottom: var(--space-xs);
}

.empty-sub {
  font-size: var(--font-sm);
  color: var(--text-muted);
  margin-bottom: var(--space-lg);
  text-align: center;
}

.btn-add-first {
  height: 88rpx;
  padding: 0 var(--space-3xl);
  background: var(--brand-gradient);
  color: var(--text-inverse);
  border-radius: var(--btn-radius);
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3) /* brand-primary-alpha */;
  border: none;
}

.btn-add-first::after { border: none; }

/* 瀑布流 */
.waterfall {
  display: flex;
  gap: var(--space-sm);
  padding: var(--space-sm) var(--space-lg);
  align-items: flex-start;
}

.col {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}
.work-item { width:100%; overflow:hidden; border-radius:var(--radius-md); background:var(--nb-surface); box-shadow:var(--shadow-sm); }

/* 卡片 */
.card-img-wrap {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 133.33%;
  overflow: hidden;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md), 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
  border: 0;
  box-sizing: border-box;
}
.col:first-child .card-img-wrap:nth-child(3n + 1) { padding-bottom: 140%; }
.col:first-child .card-img-wrap:nth-child(3n + 2) { padding-bottom: 112%; }
.col:first-child .card-img-wrap:nth-child(3n) { padding-bottom: 126%; }
.col:last-child .card-img-wrap:nth-child(3n + 1) { padding-bottom: 120%; }
.col:last-child .card-img-wrap:nth-child(3n + 2) { padding-bottom: 140%; }
.col:last-child .card-img-wrap:nth-child(3n) { padding-bottom: 108%; }

.card-img-wrap:active { transform: scale(0.985); opacity: 0.95; }

.card-img {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
}

.card-img-empty {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: var(--nb-page);
}

/* 渐变遮罩 */
.card-gradient {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.12) 0%, transparent 30%, rgba(0,0,0,0.72) 100%);
}

/* 隐藏状态遮罩 */
.hidden-mask {
  position: absolute;
  inset: 0;
  background: var(--bg-overlay);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
  backdrop-filter: blur(4rpx);
}

.hidden-label {
  font-size: var(--font-md);
  color: var(--text-inverse);
  font-weight: var(--weight-semibold);
  background: rgba(0, 0, 0, 0.3);
  padding: var(--space-xs) var(--space-xl);
  border-radius: var(--radius-sm);
}

/* 左上角标签 */
.card-tags-top {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  display: flex;
  gap: var(--space-xs);
  z-index: 2;
}

.tag-pill {
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
  padding: 4rpx var(--space-sm);
  border-radius: var(--radius-md);
  backdrop-filter: blur(8px);
}

.tag-pin {
  background: rgba(0, 0, 0, 0.85) /* brand-primary-alpha */;
  color: var(--text-inverse);
}

.tag-feat {
  background: rgba(0, 0, 0, 0.85);
  color: var(--text-inverse);
}

/* 右上角更多操作 */
.card-more-btn {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 64rpx;
  height: 64rpx;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10px);
  z-index: 2;
}

.card-more-btn:active { background: var(--bg-overlay); }

.card-more-icon {
  font-size: var(--font-md);
  color: var(--text-inverse);
  font-weight: bold;
  letter-spacing: 2rpx;
}

/* 底部信息 */
.card-bottom {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: var(--space-sm) 20rpx;
  z-index: 1;
}

.card-title {
  display: block;
  font-size: var(--font-sm);
  font-weight: var(--weight-semibold);
  color: var(--text-inverse);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.3;
}

.card-price {
  display: block;
  font-size: var(--font-sm);
  font-weight: var(--weight-bold);
  color: rgba(255, 255, 255, 0.92);
  margin-top: 4rpx;
}

.card-stats-row {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  margin-top: 10rpx;
}

.card-stat {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.stat-icon {
  font-size: var(--font-xs);
  color: rgba(255, 255, 255, 0.7);
}

.stat-num {
  font-size: var(--font-xs);
  color: rgba(255, 255, 255, 0.82);
  font-weight: var(--weight-medium);
}

/* 固定底部发布按钮 */
.fixed-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 50;
  padding: 20rpx var(--space-xl) calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top: 1rpx solid var(--nb-line);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.btn-publish {
  max-width: none;
  width: 100%;
  height: 88rpx;
  background: var(--brand-gradient);
  color: var(--text-inverse);
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  border-radius: var(--btn-radius);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3) /* brand-primary-alpha */;
  border: none;
}

.btn-publish::after { border: none; }

@import '../../../styles/booking-actions.wxss';
.btn-add-first,.btn-publish { background:var(--nb-action); }
.btn-add-first.booking-action,
.btn-publish.booking-action { min-height:44px; height:44px; border-radius:12rpx; font-size:var(--font-sm); font-weight:700; line-height:1.4; box-shadow:none; }


.manage-tools { margin: 0 var(--space-lg); padding: var(--space-sm) 0 0; }
.search-row { min-height: 44px; padding: 0 var(--space-sm); display: flex; align-items: center; gap: var(--space-sm); border-radius: 8px; background: var(--nb-surface); }
.search-row image { width: 18px; height: 18px; }
.search-row input { flex: 1; min-width: 0; min-height: 44px; font-size: var(--font-sm); }
.search-clear { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; }
.status-row, .secondary-tools { display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); }
.status-row { border-bottom: 1rpx solid var(--nb-line); }
.simple-tabs { display: flex; gap: var(--space-lg); min-width: 0; }
.simple-tab, .filter-action, .reset-filter { display: flex; align-items: center; min-height: 44px; font-size: var(--font-xs); color: var(--nb-secondary); }
.simple-tab { border-bottom: 2px solid transparent; }
.simple-tab.active { border-bottom-color: var(--nb-ink); color: var(--nb-ink); font-weight: var(--weight-semibold); }
.simple-tab:active, .filter-action:active, .reset-filter:active { background: var(--nb-page); }
.reset-filter { color: var(--nb-text-link); }
page { background: var(--nb-page); }
.result-head { padding:20rpx var(--space-lg) 0; display:flex; align-items:center; justify-content:space-between; color:var(--nb-muted); font-size:var(--font-xs); }
.filter-empty { padding-top:72rpx; }
.empty-work-icon { width:96rpx; height:96rpx; margin-bottom:var(--space-md); opacity:.5; }

/* ===== 瀑布流感知骨架屏 ===== */
.skel-mode {
  display: flex;
  gap: var(--space-sm);
  padding: var(--space-sm) var(--space-lg);
  align-items: flex-start;
  box-sizing: border-box;
}
.skel-card {
  width: 100%;
  border-radius: var(--radius-md);
  background: linear-gradient(
    90deg,
    var(--nb-page) 0%,
    var(--nb-surface) 50%,
    var(--nb-page) 100%
  );
  background-size: 200% 100%;
  animation: techSkelShimmer 1.5s ease-in-out infinite;
  margin-bottom: var(--space-sm);
}
.skel-tall { height: 440rpx; }
.skel-mid  { height: 340rpx; }

@keyframes techSkelShimmer {
  0%   { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}
