.container {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 160rpx;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255,107,138,0.3) /* brand-primary-alpha */;
  border-top-color: var(--brand-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 60rpx;
}

.empty-icon-wrap {
  margin-bottom: 32rpx;
}

.icon-placeholder-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255,107,138,0.12) /* brand-primary-alpha */;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-placeholder-inner {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(255,107,138,0.3) /* brand-primary-alpha */;
}

.empty-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-muted);
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: var(--font-sm);
  color: var(--text-muted);
  margin-bottom: 48rpx;
  text-align: center;
}

.btn-add-first {
  height: 88rpx;
  padding: 0 64rpx;
  background: var(--brand-gradient);
  color: var(--text-inverse);
  border-radius: var(--btn-radius);
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255,107,138,0.3) /* brand-primary-alpha */;
  border: none;
}

.btn-add-first::after { border: none; }

/* 瀑布流 */
.waterfall {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx;
  align-items: flex-start;
}

.col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 卡片 */
.card-img-wrap {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 133.33%;
  overflow: hidden;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md), 0 1rpx 4rpx rgba(15, 23, 42, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}
.col:first-child .card-img-wrap:nth-child(3n + 1) { padding-bottom: 146%; }
.col:first-child .card-img-wrap:nth-child(3n + 2) { padding-bottom: 106%; }
.col:first-child .card-img-wrap:nth-child(3n) { padding-bottom: 128%; }
.col:last-child .card-img-wrap:nth-child(3n + 1) { padding-bottom: 114%; }
.col:last-child .card-img-wrap:nth-child(3n + 2) { padding-bottom: 148%; }
.col:last-child .card-img-wrap:nth-child(3n) { padding-bottom: 102%; }

.card-img-wrap:active { transform: scale(0.985); opacity: 0.95; }

.card-img {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
}

.card-img-empty {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: linear-gradient(135deg, #f1f5f9, #e2e8f0);
}

/* 渐变遮罩 */
.card-gradient {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.12) 0%, transparent 30%, rgba(0,0,0,0.72) 100%);
}

/* 隐藏状态遮罩 */
.hidden-mask {
  position: absolute;
  inset: 0;
  background: var(--bg-overlay);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
  backdrop-filter: blur(4rpx);
}

.hidden-label {
  font-size: var(--font-md);
  color: var(--text-inverse);
  font-weight: var(--weight-semibold);
  background: rgba(0, 0, 0, 0.3);
  padding: 8rpx 40rpx;
  border-radius: var(--radius-sm);
}

/* 左上角标签 */
.card-tags-top {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  display: flex;
  gap: 8rpx;
  z-index: 2;
}

.tag-pill {
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-md);
  backdrop-filter: blur(8px);
}

.tag-pin {
  background: rgba(255,107,138,0.85) /* brand-primary-alpha */;
  color: var(--text-inverse);
}

.tag-feat {
  background: rgba(167, 139, 250, 0.85);
  color: var(--text-inverse);
}

/* 右上角更多操作 */
.card-more-btn {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 56rpx;
  height: 56rpx;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10px);
  z-index: 2;
}

.card-more-btn:active { background: var(--bg-overlay); }

.card-more-icon {
  font-size: var(--font-md);
  color: var(--text-inverse);
  font-weight: bold;
  letter-spacing: 2rpx;
}

/* 底部信息 */
.card-bottom {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 16rpx 20rpx;
  z-index: 1;
}

.card-title {
  display: block;
  font-size: var(--font-sm);
  font-weight: var(--weight-semibold);
  color: var(--text-inverse);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.3;
}

.card-price {
  display: block;
  font-size: var(--font-sm);
  font-weight: var(--weight-bold);
  color: rgba(255, 255, 255, 0.92);
  margin-top: 4rpx;
}

.card-stats-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 10rpx;
}

.card-stat {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.stat-icon {
  font-size: var(--font-xs);
  color: rgba(255, 255, 255, 0.7);
}

.stat-num {
  font-size: var(--font-xs);
  color: rgba(255, 255, 255, 0.82);
  font-weight: var(--weight-medium);
}

/* 固定底部发布按钮 */
.fixed-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 50;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.9) 30%, #ffffff 100%);
  backdrop-filter: blur(10px);
}

.btn-publish {
  width: 100%;
  height: 88rpx;
  background: var(--brand-gradient);
  color: var(--text-inverse);
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  border-radius: var(--btn-radius);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255,107,138,0.3) /* brand-primary-alpha */;
  border: none;
}

.btn-publish::after { border: none; }
