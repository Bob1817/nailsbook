.container { min-height: 100vh; background: var(--bg-gradient-entry); padding: 32rpx; }
.section { margin-bottom: 40rpx; }
.section-title { display: block; font-size: var(--font-md); font-weight: var(--weight-semibold); color: var(--text-primary); margin-bottom: var(--space-sm); }
.faq-card { background: var(--bg-gradient-entry); border-radius: var(--radius-md); overflow: hidden; }
.faq-item { padding: 0 32rpx; }
.faq-border { border-bottom: 1rpx solid var(--border-card); }
.faq-header { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 0; gap: 20rpx; }
.faq-q { flex: 1; font-size: var(--font-md); color: var(--text-primary); line-height: var(--leading-normal); }
.faq-arrow { font-size: var(--font-lg); color: var(--text-muted); display: inline-block; transition: transform 0.2s; }
.arrow-open { transform: rotate(90deg); }
.faq-answer { padding-bottom: 28rpx; }
.faq-a { font-size: var(--font-sm); color: var(--text-body); line-height: 1.7; }
.tip { display: block; font-size: var(--font-sm); color: var(--text-muted); line-height: 1.6; }
.support-btn { display:flex; min-height:88rpx; margin:0 0 20rpx; align-items:center; justify-content:center; border:0; border-radius: var(--radius-xl); background:linear-gradient(135deg,#ff6b8a,#a855f7); color: var(--text-inverse); font-size: var(--font-sm); font-weight: var(--weight-semibold); line-height:1; }.support-btn::after { border:0; }
