.settings-page{min-height:100vh;padding:36rpx var(--space-lg) calc(var(--space-xl) + env(safe-area-inset-bottom));background:var(--nb-page);box-sizing:border-box;color:var(--nb-ink)}.hero-kicker,.hero-title,.hero-copy,.support-title,.support-sub,.section-title,.section-note,.faq-q,.faq-a,.tip-title,.tip-copy{display:block}.help-hero{padding:var(--space-xs) var(--space-xs) var(--space-lg)}.hero-kicker{color:var(--nb-muted);font-size:var(--font-xs);font-weight:600;letter-spacing:3rpx}.hero-title{margin-top:14rpx;font-size:var(--font-xl);font-weight:680;line-height:1.3}.hero-copy{margin-top:10rpx;color:var(--nb-secondary);font-size:var(--font-sm);line-height:1.6}.support-card{min-height:128rpx;padding:var(--space-md) 26rpx;display:flex;align-items:center;gap:18rpx;border-radius:24rpx;background:var(--nb-action);color:var(--nb-inverse)}.support-mark{width:52rpx;height:52rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;border:1rpx solid var(--nb-inverse);border-radius:50%;font-size:var(--font-md);font-weight:700}.support-copy{flex:1;min-width:0}.support-title{font-size:var(--font-md);font-weight:650}.support-sub{margin-top:5rpx;font-size:var(--font-xs);opacity:.72}.support-btn{min-width:144rpx;min-height:72rpx;margin:0;padding:0 20rpx;display:flex;align-items:center;justify-content:center;border:0;border-radius:var(--radius-sm);background:var(--nb-inverse);color:var(--nb-action);font-size:var(--font-sm);font-weight:650}.support-btn::after{border:0}.section-heading{padding:36rpx var(--space-xs) var(--space-sm);display:flex;align-items:center;justify-content:space-between}.section-title{font-size:var(--font-md);font-weight:650}.section-note{color:var(--nb-muted);font-size:var(--font-xs)}.faq-card{overflow:hidden;border-radius:24rpx;background:var(--nb-surface)}.faq-item{padding:0 28rpx;border-bottom:1rpx solid var(--nb-border)}.faq-item:last-child{border-bottom:0}.faq-header{min-height:104rpx;display:flex;align-items:center;gap:18rpx}.question-index{width:40rpx;height:40rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;border-radius:50%;background:var(--nb-soft-surface);color:var(--nb-secondary);font-size:var(--font-xs);font-weight:600}.faq-q{flex:1;font-size:var(--font-sm);font-weight:550;line-height:1.45}.faq-arrow{color:var(--nb-muted);font-size:var(--font-lg);transition:transform .2s}.arrow-open{transform:rotate(90deg)}.faq-answer{padding:0 0 26rpx 58rpx}.faq-a{color:var(--nb-secondary);font-size:var(--font-sm);line-height:1.7}.contact-tip{margin-top:var(--space-md);padding:var(--space-md) 28rpx;border-radius:var(--radius-md);background:var(--nb-soft-surface)}.tip-title{font-size:var(--font-sm);font-weight:600}.tip-copy{margin-top:6rpx;color:var(--nb-muted);font-size:var(--font-xs);line-height:1.55}
