.container { min-height: 100vh; background: #f5f5f5; padding: 32rpx; }
.section { margin-bottom: 40rpx; }
.section-title { display: block; font-size: 28rpx; font-weight: 600; color: #1a1a1a; margin-bottom: 16rpx; }
.faq-card { background: #fff; border-radius: 24rpx; overflow: hidden; }
.faq-item { padding: 0 32rpx; }
.faq-border { border-bottom: 1rpx solid #f5f5f5; }
.faq-header { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 0; gap: 20rpx; }
.faq-q { flex: 1; font-size: 28rpx; color: #1a1a1a; line-height: 1.5; }
.faq-arrow { font-size: 36rpx; color: #ccc; display: inline-block; transition: transform 0.2s; }
.arrow-open { transform: rotate(90deg); }
.faq-answer { padding-bottom: 28rpx; }
.faq-a { font-size: 26rpx; color: #666; line-height: 1.7; }
.tip { display: block; font-size: 24rpx; color: #999; line-height: 1.6; }
