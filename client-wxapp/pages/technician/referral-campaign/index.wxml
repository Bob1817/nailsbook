<nav-bar title="推荐数据" show-back="{{true}}" title-center="{{true}}"/>
<view class="page">
  <view wx:if="{{loading}}" class="state-card">推荐数据加载中…</view>
  <view wx:elif="{{loadFailed}}" class="state-card">
    <text>推荐数据暂时无法加载</text>
    <button class="retry-btn" bindtap="loadReferrals">重新加载</button>
  </view>

  <block wx:else>
    <view class="summary-card">
      <text class="summary-title">客户推荐效果</text>
      <text class="summary-copy">统计好友推荐带来的客户与已确认收入</text>
      <view class="metric-grid">
        <view class="metric"><text class="metric-value">{{stats.total}}</text><text class="metric-label">推荐总数</text></view>
        <view class="metric"><text class="metric-value">{{stats.qualified}}</text><text class="metric-label">有效推荐</text></view>
        <view class="metric"><text class="metric-value {{stats.conversionRate === '待积累' ? 'text-muted' : ''}}">{{stats.conversionRate}}</text><text class="metric-label">有效转化率</text></view>
        <view class="metric"><text class="metric-value semantic-money">{{stats.qualifiedRevenue}}</text><text class="metric-label">有效推荐收入</text></view>
      </view>
    </view>

    <view class="section-head"><text class="section-title">推荐记录</text></view>
    <view wx:if="{{relations.length}}" class="relation-card">
      <view wx:for="{{relations}}" wx:key="id" class="relation-row">
        <view class="relation-main">
          <text class="relation-title">{{item.referrerName}} 推荐 {{item.referredName}}</text>
          <text class="relation-detail">{{item.date || '日期待更新'}} · {{item.statusText}}</text>
        </view>
      </view>
    </view>
    <view wx:else class="empty-card">
      <text class="empty-title">暂无推荐记录</text>
      <text class="empty-copy">客户成功邀请好友后，推荐进度会显示在这里</text>
      <text wx:if="{{relationDataUnavailable}}" class="empty-note">明细暂未同步，汇总数据不受影响</text>
    </view>
  </block>
</view>
