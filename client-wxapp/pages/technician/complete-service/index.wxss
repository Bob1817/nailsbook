.page{min-height:100vh;background:#f7f5f2;padding:24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom))}.card{background:#fff;border-radius:24rpx;padding:28rpx;margin-bottom:20rpx}.title{display:block;font-size:32rpx;font-weight:700}.card label{display:block;margin:24rpx 0 10rpx;font-weight:600}input,textarea{width:100%;min-height:88rpx;padding:20rpx;background:#f7f5f2;border-radius:16rpx;box-sizing:border-box}textarea{height:150rpx}.primary{min-height:96rpx;border-radius:48rpx;background:#211b18;color:#fff}.primary::after{border:0}
.success-card{display:flex;flex-direction:column;align-items:center;padding:64rpx 40rpx;margin-top:120rpx}.success-icon{width:112rpx;height:112rpx;line-height:112rpx;text-align:center;border-radius:50%;background:#e8f5ee;color:#1f9d5b;font-size:56rpx;font-weight:700;margin-bottom:24rpx}.success-title{font-size:36rpx;font-weight:700;color:#211b18;margin-bottom:8rpx}.success-desc{font-size:28rpx;color:#6f6a65;margin-bottom:32rpx}.success-tip{font-size:26rpx;color:#9b958e;margin-bottom:40rpx;text-align:center}.success-card .primary{width:100%;margin-bottom:20rpx}.ghost{width:100%;min-height:96rpx;border-radius:48rpx;background:#fff;color:#211b18;border:2rpx solid #e5e0da;box-sizing:border-box}.ghost::after{border:0}
