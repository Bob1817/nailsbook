@import '../../../styles/booking-actions.wxss';
@import '../../../styles/booking-form.wxss';
.page { min-height: 100vh; box-sizing: border-box; background: var(--nb-page); padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom)); }
.card { background: var(--nb-surface); border-radius: var(--radius-md); padding: 28rpx; margin-bottom: 20rpx; font-size: var(--font-sm); }
.title, .success-title { display: block; font-size: var(--font-md); font-weight: var(--weight-semibold); }
.card label { display: block; margin: 24rpx 0 10rpx; font-weight: var(--weight-medium); }
.form-input, .form-textarea { width: 100%; background: var(--bg-input); color: var(--nb-ink); box-sizing: border-box; }
.form-textarea { min-height: 44px; height: 150rpx; padding: 20rpx; }
.time-fields { display: flex; gap: 16rpx; }
.date-picker { flex: 3; min-width: 0; }
.time-picker { flex: 2; min-width: 0; }
.picker-value { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; }
.picker-value:active { opacity: .82; }
.picker-arrow { color: var(--nb-muted); }
.primary { width: 100%; background: var(--nb-action); color: var(--nb-inverse); }
.ghost { width: 100%; background: var(--bg-input); color: var(--nb-secondary); }
.primary[disabled], .ghost[disabled] { background: var(--nb-pressed); color: var(--nb-control); }
.success-card { display: flex; flex-direction: column; align-items: center; padding: 48rpx 28rpx; }
.success-icon { width: 88rpx; height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 50%; background: var(--nb-page); color: var(--nb-ink); font-size: var(--font-lg); margin-bottom: 24rpx; }
.success-desc { font-size: var(--font-sm); color: var(--nb-secondary); margin: 8rpx 0 24rpx; overflow-wrap: anywhere; }
.success-tip { font-size: var(--font-sm); color: var(--nb-muted); margin-bottom: 32rpx; text-align: center; line-height: 1.5; }
.success-card .primary { margin-bottom: 20rpx; }
.record-status { display:flex; justify-content:space-between; gap:16rpx; padding:18rpx 24rpx; margin-bottom:20rpx; border-radius:var(--radius-md); background:var(--bg-input); color:var(--nb-secondary); font-size:var(--font-xs); }
.section-hint { display:block; margin-top:8rpx; color:var(--nb-muted); font-size:var(--font-xs); line-height:1.5; }
.photo-section { margin-top:24rpx; }
.photo-head { min-height:44px; display:flex; align-items:center; justify-content:space-between; font-weight:var(--weight-medium); }
.photo-add { min-height:44px; margin:0; padding:0 24rpx; background:var(--bg-input); color:var(--nb-secondary); font-size:var(--font-xs); }
.photo-strip { width:100%; }
.photo-list { display:flex; align-items:center; gap:12rpx; min-height:150rpx; }
.photo-wrap { position:relative; flex:0 0 150rpx; width:150rpx; height:150rpx; }
.record-photo { width:150rpx; height:150rpx; border-radius:var(--radius-md); background:var(--nb-line); }
.photo-remove { position:absolute; top:6rpx; right:6rpx; width:44rpx; height:44rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; background:rgba(0,0,0,.72); color:#fff; }
.photo-empty { color:var(--nb-muted); font-size:var(--font-xs); }
.record-actions { display:flex; gap:16rpx; }
.record-actions button { flex:1; min-height:88rpx; }
.completion-tip { display:block; margin:18rpx 12rpx 0; color:var(--nb-muted); font-size:var(--font-xs); line-height:1.5; text-align:center; }
