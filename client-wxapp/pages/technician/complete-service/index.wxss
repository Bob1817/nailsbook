@import '../../../styles/booking-actions.wxss';
@import '../../../styles/booking-form.wxss';

/* ============ 页面容器与全局韵律 ============ */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--nb-page);
  padding: var(--space-md) var(--space-md) calc(var(--space-2xl) + env(safe-area-inset-bottom));
}

.page-with-bottom-bar {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

/* ============ Airbnb 风格通用卡片 ============ */
.card, .record-section-card, .record-hero {
  background: var(--nb-surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--nb-line);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
}

.airbnb-card {
  position: relative;
}

.title, .success-title {
  display: block;
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: var(--nb-ink);
  line-height: 1.35;
}

.section-header-block {
  margin-bottom: var(--space-md);
}

.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}

.section-hint {
  display: block;
  margin-top: 8rpx;
  color: var(--nb-muted);
  font-size: var(--font-xs);
  line-height: 1.5;
}

.required-star {
  color: var(--nb-danger);
  font-weight: var(--weight-bold);
  margin-left: 4rpx;
}

/* ============ 顶部实时自动保存指示条 ============ */
.record-status, .airbnb-status-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  min-height: 44px;
  padding: 14rpx 24rpx;
  margin-bottom: 24rpx;
  border-radius: var(--radius-full);
  background: var(--nb-surface);
  border: 1rpx solid var(--nb-line);
  box-sizing: border-box;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.02);
}

.status-indicator-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
  font-size: var(--font-xs);
  color: var(--nb-secondary);
}

.status-pulse-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--nb-muted);
}

.dot-saved {
  background: var(--nb-ink);
}

.dot-saving {
  background: var(--nb-secondary);
  opacity: 0.6;
}

.dot-failed {
  background: var(--nb-danger);
}

.status-error-click {
  color: var(--nb-danger);
  font-weight: var(--weight-medium);
}

.status-mode-pill {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
}

.pill-complete {
  background: var(--nb-page);
  color: var(--nb-ink);
}

.pill-draft {
  background: var(--nb-soft-surface);
  color: var(--nb-secondary);
}

/* ============ Airbnb Hero 头部卡片（只读模式） ============ */
.record-hero.airbnb-hero {
  padding: 36rpx 32rpx;
}

.record-hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}

.hero-badge-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.record-eyebrow {
  color: var(--nb-muted);
  font-size: var(--font-xs);
  letter-spacing: 1rpx;
  text-transform: uppercase;
  font-weight: var(--weight-semibold);
}

.record-state {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
  background: var(--nb-page);
  color: var(--nb-secondary);
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
}

.record-state-complete {
  background: var(--nb-page);
  color: var(--nb-ink);
}

.record-state-draft {
  background: var(--nb-soft-surface);
  color: var(--nb-muted);
}

.airbnb-edit-pill {
  min-height: 44px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: var(--radius-full);
  background: var(--nb-page);
  color: var(--nb-ink);
  font-size: var(--font-sm);
  font-weight: var(--weight-semibold);
  border: 1rpx solid var(--nb-line);
}

.airbnb-edit-pill:active {
  background: var(--nb-soft-surface);
}

.edit-btn-icon {
  font-size: var(--font-md);
}

.record-hero-title {
  display: block;
  margin-top: 24rpx;
  color: var(--nb-ink);
  font-size: var(--font-xl);
  font-weight: var(--weight-bold);
  line-height: 1.3;
}

.record-hero-meta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
  font-size: var(--font-sm);
  color: var(--nb-secondary);
}

.record-hero-meta {
  color: var(--nb-secondary);
}

.record-hero-client {
  color: var(--nb-ink);
  font-weight: var(--weight-medium);
}

.record-completed {
  display: block;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--nb-line);
  color: var(--nb-muted);
  font-size: var(--font-xs);
}

/* ============ Airbnb 风格关键指标栏 ============ */
.record-metrics.airbnb-metrics-card {
  display: grid;
  grid-template-columns: 1fr 1rpx 1fr 1rpx 1fr;
  align-items: center;
  background: var(--nb-surface);
  border-radius: var(--radius-lg);
  padding: 28rpx 16rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--nb-line);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
  box-sizing: border-box;
}

.record-metric {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 8rpx 0;
}

.record-metric-label {
  color: var(--nb-muted);
  font-size: var(--font-xs);
  margin-bottom: 6rpx;
}

.record-metric-value {
  display: block;
  color: var(--nb-ink);
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  line-height: 1.25;
}

.record-metric-money {
  color: var(--nb-money);
}

.metric-divider {
  height: 48rpx;
  width: 1rpx;
  background: var(--nb-line);
}

/* ============ 章节标题与副标题 ============ */
.record-section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-sm);
  margin-bottom: var(--space-sm);
}

.record-section-title {
  display: block;
  color: var(--nb-ink);
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
}

.record-section-sub {
  display: block;
  margin-top: 6rpx;
  color: var(--nb-muted);
  font-size: var(--font-xs);
  line-height: 1.45;
}

.record-subsection-title {
  display: block;
  margin-top: var(--space-md);
  margin-bottom: 12rpx;
  color: var(--nb-secondary);
  font-size: var(--font-sm);
  font-weight: var(--weight-semibold);
}

.airbnb-private-badge {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-full);
  background: var(--nb-soft-surface);
  color: var(--nb-muted);
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
}

/* ============ 照片展示与上传器 (Photo-First) ============ */
.photo-section {
  margin-top: var(--space-sm);
}

.photo-head {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.photo-stage-title, .record-photo-stage {
  color: var(--nb-ink);
  font-size: var(--font-sm);
  font-weight: var(--weight-semibold);
}

.record-photo-count {
  margin-left: 10rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  background: var(--nb-soft-surface);
  color: var(--nb-muted);
  font-size: var(--font-xs);
}

.airbnb-add-photo-btn, .photo-add {
  min-height: 44px;
  margin: 0;
  padding: 0 24rpx;
  border-radius: var(--radius-full);
  background: var(--nb-page);
  color: var(--nb-ink);
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
  border: 1rpx solid var(--nb-line);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.airbnb-add-photo-btn:active, .photo-add:active {
  background: var(--nb-soft-surface);
}

.photo-strip {
  width: 100%;
}

.photo-list {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 6rpx 0;
}

.photo-wrap, .airbnb-photo-wrap {
  position: relative;
  flex: 0 0 180rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 1rpx solid var(--nb-line);
  box-sizing: border-box;
}

.record-photo, .airbnb-photo {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-md);
  background: var(--nb-soft-surface);
  display: block;
}

.photo-remove, .airbnb-photo-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--bg-overlay);
}

.photo-remove-icon {
  width: 20rpx;
  height: 20rpx;
}

.photo-empty-tile {
  flex: 0 0 180rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--radius-md);
  border: 2rpx dashed var(--nb-line);
  background: var(--nb-page);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-sizing: border-box;
}

.photo-empty-icon {
  font-size: 36rpx;
  color: var(--nb-muted);
  line-height: 1;
}

.photo-empty, .record-photo-empty {
  color: var(--nb-muted);
  font-size: var(--font-xs);
}

.record-photo-empty-box {
  padding: 24rpx;
  background: var(--nb-page);
  border-radius: var(--radius-md);
  text-align: center;
  margin-top: 10rpx;
}

.record-photo-section + .record-photo-section {
  margin-top: var(--space-md);
  padding-top: var(--space-sm);
  border-top: 1rpx solid var(--nb-line);
}

/* ============ 过程细节与结构化内容 ============ */
.record-groups {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  margin-top: var(--space-md);
}

.record-group.airbnb-group {
  padding: 24rpx;
  border-radius: var(--radius-md);
  background: var(--nb-page);
  border: 1rpx solid var(--nb-line);
}

.record-group-title {
  display: block;
  margin-bottom: 8rpx;
  color: var(--nb-ink);
  font-size: var(--font-sm);
  font-weight: var(--weight-bold);
}

.record-detail-row {
  display: grid;
  grid-template-columns: 160rpx minmax(0, 1fr);
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--nb-line);
}

.record-detail-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.record-detail-label {
  color: var(--nb-muted);
  font-size: var(--font-xs);
  line-height: 1.5;
}

.record-detail-value {
  color: var(--nb-ink);
  font-size: var(--font-sm);
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.record-empty-summary {
  display: block;
  margin-top: var(--space-md);
  padding: 32rpx;
  border-radius: var(--radius-md);
  background: var(--nb-page);
  color: var(--nb-muted);
  font-size: var(--font-sm);
  text-align: center;
}

/* ============ 客户档案 & 作品档案候选清单 ============ */
.archive-list, .sync-candidate-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: var(--space-md);
}

.archive-item.airbnb-archive-item, .sync-candidate.airbnb-candidate-card {
  padding: 24rpx;
  border-radius: var(--radius-md);
  background: var(--nb-page);
  border: 1rpx solid var(--nb-line);
  box-sizing: border-box;
}

.sync-candidate.airbnb-candidate-card {
  min-height: 44px;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.sync-candidate.airbnb-candidate-card:active {
  background: var(--nb-soft-surface);
}

.sync-candidate-copy {
  flex: 1;
  min-width: 0;
}

.archive-item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}

.archive-label {
  color: var(--nb-ink);
  font-size: var(--font-xs);
  font-weight: var(--weight-bold);
}

.archive-state {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  background: var(--nb-soft-surface);
  color: var(--nb-muted);
  font-size: var(--font-xs);
}

.archive-state-synced {
  background: var(--nb-page);
  color: var(--nb-ink);
  font-weight: var(--weight-semibold);
}

.archive-content {
  display: block;
  margin-top: 10rpx;
  color: var(--nb-ink);
  font-size: var(--font-sm);
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.archive-meta {
  display: block;
  margin-top: 10rpx;
  color: var(--nb-muted);
  font-size: var(--font-xs);
}

.archive-conflict {
  display: block;
  margin-top: 10rpx;
  padding: 8rpx 14rpx;
  border-radius: var(--radius-sm);
  background: var(--nb-soft-surface);
  color: var(--nb-secondary);
  font-size: var(--font-xs);
  line-height: 1.45;
}

.sync-candidate-disabled {
  opacity: 0.72;
}

.archive-work-head {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  margin-top: var(--space-sm);
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--nb-line);
}

.archive-work-name {
  display: block;
  margin-bottom: 4rpx;
  color: var(--nb-ink);
  font-size: var(--font-sm);
  font-weight: var(--weight-bold);
}

.detail-arrow {
  color: var(--nb-muted);
  font-size: var(--font-md);
}

.archive-unlinked {
  display: block;
  margin-top: var(--space-sm);
  color: var(--nb-muted);
  font-size: var(--font-xs);
  line-height: 1.5;
}

.work-review.airbnb-work-review {
  margin-top: var(--space-md);
  padding: 24rpx;
  border-radius: var(--radius-md);
  background: var(--nb-soft-surface);
  border: 1rpx solid var(--nb-line);
}

.work-review-title {
  display: block;
  color: var(--nb-ink);
  font-size: var(--font-sm);
  font-weight: var(--weight-bold);
}

.work-review-item {
  display: grid;
  grid-template-columns: 140rpx minmax(0, 1fr);
  gap: 16rpx;
  padding-top: 14rpx;
}

.work-review-label {
  color: var(--nb-muted);
  font-size: var(--font-xs);
  line-height: 1.5;
}

.work-review-value {
  color: var(--nb-ink);
  font-size: var(--font-sm);
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.work-review-note {
  display: block;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--nb-line);
  color: var(--nb-muted);
  font-size: var(--font-xs);
  line-height: 1.5;
}

/* ============ 关联信息行 ============ */
.record-link.airbnb-link-row {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  margin-top: 14rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  background: var(--nb-page);
  border: 1rpx solid var(--nb-line);
  box-sizing: border-box;
}

.record-link.airbnb-link-row:active {
  background: var(--nb-soft-surface);
}

.record-link-info {
  flex: 1;
  min-width: 0;
}

.detail-value {
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  color: var(--nb-ink);
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.detail-link-sub {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-xs);
  color: var(--nb-muted);
}

.airbnb-sub-btn, .association-change {
  min-height: 44px;
  min-width: 112rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: var(--radius-full);
  background: var(--nb-surface);
  color: var(--nb-text-link);
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
  border: 1rpx solid var(--nb-line);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.airbnb-full-btn, .association-empty-action {
  width: 100%;
  margin-top: var(--space-sm);
}

/* ============ 表单字段与交互控件 ============ */
.form-field-label, .card label {
  display: block;
  margin: var(--space-md) 0 12rpx;
  color: var(--nb-ink);
  font-size: var(--font-sm);
  font-weight: var(--weight-semibold);
}

.form-input, .form-textarea, .airbnb-input, .airbnb-textarea {
  width: 100%;
  background: var(--bg-input);
  color: var(--nb-ink);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  font-size: var(--font-sm);
  line-height: 1.5;
  box-sizing: border-box;
  border: 1rpx solid transparent;
}

.form-input:focus, .form-textarea:focus {
  border-color: var(--nb-ink);
}

.form-input, .airbnb-input {
  min-height: 44px;
  height: 88rpx;
}

.form-textarea, .airbnb-textarea {
  min-height: 44px;
  height: 160rpx;
}

/* 时间与金额组合字段 */
.airbnb-completion-box {
  background: var(--nb-page);
  padding: 24rpx;
  border-radius: var(--radius-md);
  margin-bottom: var(--space-md);
  border: 1rpx solid var(--nb-line);
}

.time-fields.airbnb-picker-row {
  display: flex;
  gap: var(--space-sm);
}

.date-picker {
  flex: 3;
  min-width: 0;
}

.time-picker {
  flex: 2;
  min-width: 0;
}

.picker-value.airbnb-picker {
  min-height: 44px;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-xs);
  background: var(--nb-surface);
  border: 1rpx solid var(--nb-line);
}

.picker-arrow {
  color: var(--nb-muted);
  font-size: var(--font-md);
}

.amount-fields-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-sm);
  margin-top: 10rpx;
}

.amount-field-col {
  min-width: 0;
}

.deposit-settle-hint {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-xs);
  color: var(--nb-secondary);
  line-height: 1.4;
}

/* ============ Airbnb 极简勾选框 (Check Control) ============ */
.confirm-row.airbnb-confirm-row {
  min-height: 44px;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--nb-line);
}

.confirm-row.airbnb-confirm-row:active {
  opacity: 0.72;
}

.airbnb-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid var(--nb-muted);
  background: var(--nb-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.airbnb-check.is-checked {
  background: var(--nb-action);
  border-color: var(--nb-action);
}

.confirm-check {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  color: var(--nb-inverse);
  font-size: var(--font-xs);
  font-weight: var(--weight-bold);
}

.confirm-label {
  font-size: var(--font-sm);
  color: var(--nb-secondary);
  line-height: 1.4;
}

/* ============ Airbnb 滤镜式选项胶囊 (Chips) ============ */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: var(--space-xs) 0 16rpx;
}

.chip.airbnb-chip {
  position: relative;
  height: 54rpx;
  min-height: 54rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  border-radius: var(--radius-full);
  background: var(--nb-page);
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  color: var(--nb-secondary);
  font-size: 24rpx;
  font-weight: var(--weight-medium);
  box-sizing: border-box;
  transition: all 0.15s ease-in-out;
}
.chip.airbnb-chip::after { content:''; position:absolute; top:-16rpx; bottom:-16rpx; left:0; right:0; }

.chip.airbnb-chip:active {
  background: var(--nb-pressed);
  transform: scale(0.97);
}

.chip.airbnb-chip.chip-active {
  background: var(--nb-action);
  border-color: var(--nb-action);
  color: var(--nb-inverse);
  font-weight: var(--weight-semibold);
}

/* ============ 展开折叠器 ============ */
.section-toggle.airbnb-section-toggle {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.section-toggle.airbnb-section-toggle:active {
  opacity: 0.72;
}

.toggle-pill {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 18rpx;
  border-radius: var(--radius-full);
  background: var(--nb-page);
  color: var(--nb-secondary);
  font-size: var(--font-xs);
}

.section-arrow {
  color: var(--nb-secondary);
}

.toggle-arrow-icon {
  font-size: var(--font-sm);
  transition: transform 0.2s ease;
}

.arrow-up {
  transform: rotate(-90deg);
}

/* ============ 客户禁忌与安全提醒 ============ */
.alert-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 16rpx;
}

.alert-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: var(--radius-md);
  background: var(--nb-soft-surface);
  font-size: var(--font-sm);
  color: var(--nb-ink);
  line-height: 1.5;
}

.alert-mark {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  background: var(--nb-ink);
  color: var(--nb-inverse);
  font-size: var(--font-xs);
  text-align: center;
  font-weight: var(--weight-bold);
}

.alert-text {
  flex: 1;
  min-width: 0;
}

.missing-card.airbnb-alert-card {
  border-left: 6rpx solid var(--nb-ink);
  background: var(--nb-page);
}

/* 款式准备块 */
.preparation-item.airbnb-prep-item {
  margin-top: var(--space-sm);
  padding-top: var(--space-sm);
  border-top: 1rpx solid var(--nb-line);
}

.preparation-item.airbnb-prep-item:first-of-type {
  border-top: 0;
  margin-top: 0;
  padding-top: 0;
}

.context-work-title {
  display: block;
  color: var(--nb-ink);
  font-size: var(--font-sm);
  font-weight: var(--weight-bold);
  margin-bottom: 8rpx;
}

.context-block {
  display: grid;
  grid-template-columns: 140rpx minmax(0, 1fr);
  gap: 14rpx;
  margin-top: 10rpx;
  font-size: var(--font-sm);
  color: var(--nb-ink);
  line-height: 1.5;
}

.context-label {
  color: var(--nb-muted);
  font-size: var(--font-xs);
}

.context-val {
  color: var(--nb-ink);
}

.context-meta {
  display: block;
  margin-top: 12rpx;
  color: var(--nb-muted);
  font-size: var(--font-xs);
}

/* ============ 底部固定浮动操作栏 (Floating Action Dock) ============ */
.record-bottom-bar.airbnb-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: var(--nb-surface);
  border-top: 1rpx solid var(--nb-line);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
  padding: 16rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.record-actions {
  display: flex;
  gap: var(--space-sm);
}

.record-actions button {
  flex: 1;
  min-height: 88rpx;
}

.primary, .airbnb-primary-btn {
  width: 100%;
  min-height: 88rpx;
  background: var(--nb-action);
  color: var(--nb-inverse);
  border-radius: var(--radius-md);
  font-size: var(--font-sm);
  font-weight: var(--weight-bold);
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary:active, .airbnb-primary-btn:active {
  background: var(--nb-action-pressed);
}

.primary[disabled] {
  background: var(--nb-soft-surface);
  color: var(--nb-muted);
}

.ghost, .airbnb-ghost-btn {
  width: 100%;
  min-height: 88rpx;
  background: var(--nb-page);
  color: var(--nb-ink);
  border-radius: var(--radius-md);
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  border: 1rpx solid var(--nb-line);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ghost:active, .airbnb-ghost-btn:active {
  background: var(--nb-soft-surface);
}

.airbnb-finish-btn {
  width: 100%;
  min-height: 88rpx;
  background: var(--nb-action);
  color: var(--nb-inverse);
  border-radius: var(--radius-md);
  font-size: var(--font-sm);
  font-weight: var(--weight-bold);
  margin-top: 24rpx;
}

.completion-tip {
  display: block;
  margin-bottom: 12rpx;
  color: var(--nb-muted);
  font-size: var(--font-xs);
  line-height: 1.45;
  text-align: center;
}

/* ============ 保存成功态 (Celebratory State) ============ */
.success-card.airbnb-success-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 36rpx;
  text-align: center;
}

.success-icon-wrap {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--nb-action);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.success-icon-svg {
  width: 48rpx;
  height: 48rpx;
}

.success-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--nb-ink);
}

.success-desc {
  font-size: var(--font-sm);
  color: var(--nb-secondary);
  margin: 12rpx 0 28rpx;
  overflow-wrap: anywhere;
}

.success-notices-card {
  width: 100%;
  background: var(--nb-page);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 32rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--nb-line);
}

.success-tip {
  display: block;
  font-size: var(--font-xs);
  color: var(--nb-secondary);
  line-height: 1.55;
  text-align: center;
}

.success-card .success-action-primary {
  width: 100%;
  margin-bottom: 20rpx;
}

.success-card .airbnb-ghost-btn {
  width: 100%;
  margin-bottom: 16rpx;
}

/* ============ 关联更正 Sheet 弹层 ============ */
.association-mask.airbnb-mask {
  position: fixed;
  inset: 0;
  z-index: 1200;
  display: flex;
  align-items: flex-end;
  background: var(--bg-overlay);
}

.association-sheet.airbnb-sheet {
  width: 100%;
  max-height: 82vh;
  padding: 32rpx var(--space-md) calc(var(--space-md) + env(safe-area-inset-bottom));
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  background: var(--nb-surface);
  box-sizing: border-box;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.association-sheet-head {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.association-close {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.association-close-icon {
  width: var(--icon-sm, 28rpx);
  height: var(--icon-sm, 28rpx);
}

.association-list.airbnb-association-list {
  max-height: 440rpx;
  margin: var(--space-md) 0;
}

.association-option.airbnb-association-option {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  margin-bottom: 8rpx;
  color: var(--nb-ink);
  font-size: var(--font-sm);
  box-sizing: border-box;
}

.association-option.airbnb-association-option:active {
  background: var(--nb-soft-surface);
}

.association-option-selected {
  background: var(--nb-page);
  font-weight: var(--weight-bold);
}

.association-option-check {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 28rpx;
  height: 28rpx;
}

.association-check-icon {
  width: var(--icon-sm, 28rpx);
  height: var(--icon-sm, 28rpx);
}

.association-reason {
  margin-bottom: var(--space-md);
}

.airbnb-state-box {
  text-align: center;
  padding: 60rpx 32rpx;
  color: var(--nb-muted);
}

.load-error-text {
  display: block;
  margin-bottom: var(--space-md);
  color: var(--nb-secondary);
}
