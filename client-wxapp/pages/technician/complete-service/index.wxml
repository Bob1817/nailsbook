<nav-bar title="{{isRecordMode ? '美甲记录详情' : (editingExisting ? '编辑美甲记录' : '美甲记录')}}" showBack/>
<view class="page {{!isRecordMode && !saved ? 'page-with-bottom-bar' : ''}}">
  <view wx:if="{{loading}}" class="card airbnb-card airbnb-state-box">正在加载预约信息…</view>
  <view wx:elif="{{loadError}}" class="card airbnb-card airbnb-state-box">
    <text class="load-error-text">{{loadError}}</text>
    <button class="ghost booking-action airbnb-ghost-btn" bindtap="loadOrder">重新加载</button>
  </view>
  <block wx:elif="{{loaded}}">
    <!-- ============ 只读档案详情态 ============ -->
    <block wx:if="{{isRecordMode}}">
      <!-- 1. Airbnb 风格主信息与操作 -->
      <view class="record-hero airbnb-hero">
        <view class="record-hero-head">
          <view class="hero-badge-wrap">
            <text class="record-eyebrow">服务档案</text>
            <text class="record-state {{recordStatus === 'complete' ? 'record-state-complete' : 'record-state-draft'}}">{{recordStatus === 'complete' ? '已完善' : '草稿'}}</text>
          </view>
          <button class="record-edit-btn booking-action airbnb-edit-pill" bindtap="editRecord">
            <text class="edit-btn-icon">✎</text>
            <text>编辑记录</text>
          </button>
        </view>
        <text class="record-hero-title">{{orderSummary.title}}</text>
        <view class="record-hero-meta-row">
          <text class="record-hero-meta">{{detailDateText || '未记录日期'}}{{detailTimeRangeText ? ' · ' + detailTimeRangeText : ''}}</text>
          <text class="record-hero-client">客户：{{customerName || '未记录客户'}}</text>
        </view>
        <text wx:if="{{detailCompletedAtText}}" class="record-completed">完善于 {{detailCompletedAtText}}</text>
      </view>

      <!-- 2. Airbnb 风格三列指标胶囊 -->
      <view class="record-metrics airbnb-metrics-card">
        <view class="record-metric">
          <text class="record-metric-label">实收金额</text>
          <text class="record-metric-value record-metric-money">¥{{actualAmount || '0'}}</text>
        </view>
        <view class="metric-divider"></view>
        <view class="record-metric">
          <text class="record-metric-label">服务时长</text>
          <text class="record-metric-value">{{detailDurationText || '—'}}</text>
        </view>
        <view class="metric-divider"></view>
        <view class="record-metric">
          <text class="record-metric-label">材料成本</text>
          <text class="record-metric-value">¥{{materialCost || '0'}}</text>
        </view>
      </view>

      <!-- 3. 美甲记录（本次服务事实） -->
      <view class="record-section-card airbnb-card">
        <view class="record-section-head">
          <view>
            <text class="record-section-title">美甲记录</text>
            <text class="record-section-sub">本次服务事实</text>
          </view>
        </view>
        <text class="record-subsection-title">服务照片</text>
        <view wx:for="{{recordPhotoStages}}" wx:key="key" class="record-photo-section">
          <view class="photo-head">
            <text class="record-photo-stage">{{item.label}}</text>
            <text class="record-photo-count">{{item.photos.length}} 张</text>
          </view>
          <scroll-view wx:if="{{item.photos.length}}" scroll-x class="photo-strip" enable-flex>
            <view class="photo-list">
              <view wx:for="{{item.photos}}" wx:for-item="url" wx:key="*this" class="photo-wrap airbnb-photo-wrap">
                <image class="record-photo airbnb-photo" src="{{url}}" mode="aspectFill" data-stage="{{item.key}}" data-url="{{url}}" bindtap="previewPhoto"/>
              </view>
            </view>
          </scroll-view>
          <view wx:else class="record-photo-empty-box">
            <text class="record-photo-empty">暂无照片</text>
          </view>
        </view>
      </view>

      <!-- 4. 过程与反馈 -->
      <view class="record-section-card airbnb-card">
        <view class="record-section-head">
          <view>
            <text class="record-section-title">过程与反馈</text>
            <text class="record-section-sub">本次已记录内容</text>
          </view>
        </view>
        <view wx:if="{{recordInsightGroups.length}}" class="record-groups">
          <view wx:for="{{recordInsightGroups}}" wx:key="key" wx:for-item="group" class="record-group airbnb-group">
            <text class="record-group-title">{{group.title}}</text>
            <view wx:for="{{group.items}}" wx:key="label" wx:for-item="detail" class="record-detail-row">
              <text class="record-detail-label">{{detail.label}}</text>
              <text class="record-detail-value">{{detail.value}}</text>
            </view>
          </view>
        </view>
        <text wx:else class="record-empty-summary">本次服务暂无补充总结</text>
      </view>

      <!-- 5. 客户档案 -->
      <view class="record-section-card airbnb-card">
        <view class="record-section-head">
          <view>
            <text class="record-section-title">客户档案</text>
            <text class="record-section-sub archive-intro">以下内容来自本次记录，编辑记录后手动确认同步。</text>
          </view>
          <text class="archive-private airbnb-private-badge">仅当前美甲师可见</text>
        </view>
        <view wx:if="{{customerFactCandidates.length}}" class="archive-list">
          <view wx:for="{{customerFactCandidates}}" wx:key="key" class="archive-item airbnb-archive-item">
            <view class="archive-item-head">
              <text class="archive-label">{{item.label}}</text>
              <text class="archive-state {{item.synced ? 'archive-state-synced' : ''}}">{{item.needsResync ? '需重新同步' : (item.synced ? '已同步' : '未同步')}}</text>
            </view>
            <text class="archive-content">{{item.content}}</text>
            <text wx:if="{{item.confirmationCount}}" class="archive-meta">已确认 {{item.confirmationCount}} 次</text>
            <text wx:if="{{item.conflicts.length}}" class="archive-conflict">同分类已有：{{item.conflictText}}</text>
          </view>
        </view>
        <text wx:else class="record-empty-summary">本次记录暂无可沉淀的客户档案</text>
      </view>

      <!-- 6. 作品档案 -->
      <view class="record-section-card airbnb-card">
        <view class="record-section-head">
          <view>
            <text class="record-section-title">作品档案</text>
            <text class="record-section-sub">经验沉淀与标准方案比对</text>
          </view>
          <text class="archive-private airbnb-private-badge">仅当前美甲师可见</text>
        </view>
        <view wx:if="{{relatedWork}}" class="archive-work-head" bindtap="openWorkDetail" role="button" aria-label="查看关联作品">
          <view>
            <text class="archive-work-name">{{relatedWork.title || '关联作品'}}</text>
            <text class="record-section-sub">{{workArchiveNeedsSync ? '记录已更新，需重新同步' : (workArchiveSynced ? '本次经验已同步' : '本次经验尚未同步')}}{{workArchiveVersion ? ' · 版本 ' + workArchiveVersion : ''}}</text>
          </view>
          <text class="detail-arrow">›</text>
        </view>
        <view wx:if="{{tools || materials || techniques}}" class="archive-list">
          <view wx:if="{{tools}}" class="archive-item airbnb-archive-item"><text class="archive-label">工具</text><text class="archive-content">{{tools}}</text></view>
          <view wx:if="{{materials}}" class="archive-item airbnb-archive-item"><text class="archive-label">材料</text><text class="archive-content">{{materials}}</text></view>
          <view wx:if="{{techniques}}" class="archive-item airbnb-archive-item"><text class="archive-label">制作步骤</text><text class="archive-content">{{techniques}}</text></view>
        </view>
        <text wx:else class="record-empty-summary">本次记录暂无可沉淀的作品制作经验</text>
        <view wx:if="{{workReviewItems.length}}" class="work-review airbnb-work-review">
          <text class="work-review-title">标准化复盘建议</text>
          <view wx:for="{{workReviewItems}}" wx:key="key" class="work-review-item">
            <text class="work-review-label">{{item.label}}</text>
            <text class="work-review-value">{{item.value}}</text>
          </view>
          <text class="work-review-note">仅提示本次记录与当前标准方案的差异，确认后再同步。</text>
        </view>
        <text wx:if="{{!relatedWork}}" class="archive-unlinked">未关联作品，编辑记录后可创建作品草稿。</text>
      </view>

      <!-- 7. 关联信息 -->
      <view class="record-section-card airbnb-card">
        <view class="record-section-head">
          <view>
            <text class="record-section-title">关联信息</text>
            <text class="record-section-sub">预约与作品</text>
          </view>
        </view>
        <view class="record-link airbnb-link-row">
          <view class="record-link-info">
            <text class="detail-value">关联客户</text>
            <text class="detail-link-sub">{{customerName || '未关联客户'}}</text>
          </view>
          <button class="association-change booking-action airbnb-sub-btn" data-type="customer" catchtap="openAssociationEditor">更正</button>
        </view>
        <view class="record-link airbnb-link-row" bindtap="openOrderDetail" role="button" aria-label="查看关联预约">
          <view class="record-link-info">
            <text class="detail-value">关联预约</text>
            <text class="detail-link-sub">{{orderSummary.orderNo || orderSummary.meta}}</text>
          </view>
          <text class="detail-arrow">›</text>
        </view>
        <view wx:if="{{relatedWork}}" class="record-link airbnb-link-row" bindtap="openWorkDetail" role="button" aria-label="查看关联作品">
          <view class="record-link-info">
            <text class="detail-value">{{relatedWork.relationText}}</text>
            <text class="detail-link-sub">{{relatedWork.title || '关联作品'}}</text>
          </view>
          <button class="association-change booking-action airbnb-sub-btn" data-type="work" catchtap="openAssociationEditor">更正</button>
        </view>
        <button wx:else class="association-empty-action booking-action airbnb-sub-btn airbnb-full-btn" data-type="work" bindtap="openAssociationEditor">关联已有作品</button>
      </view>
    </block>

    <!-- ============ 编辑录入态 ============ -->
    <block wx:elif="{{!saved}}">
      <!-- 顶部轻量自动保存指示条 -->
      <view class="record-status airbnb-status-bar">
        <view class="status-indicator-wrap">
          <view class="status-pulse-dot {{saveState === 'saving' ? 'dot-saving' : (saveState === 'failed' ? 'dot-failed' : 'dot-saved')}}"></view>
          <text wx:if="{{saveState === 'saving'}}">正在自动保存…</text>
          <text wx:elif="{{saveState === 'failed'}}" class="status-error-click" bindtap="retrySave" role="button" aria-label="重试自动保存">{{saveErrorText}} · 重试</text>
          <text wx:elif="{{saveState === 'saved'}}">已保存 {{lastSavedText}}</text>
          <text wx:else>填写内容自动保存</text>
        </view>
        <text class="status-mode-pill {{recordStatus === 'complete' ? 'pill-complete' : 'pill-draft'}}">{{recordStatus === 'complete' ? '记录已完善' : '记录草稿'}}</text>
      </view>

      <!-- 待补全提示 -->
      <view wx:if="{{missingLabels.length && orderStatus === 'completed'}}" class="card missing-card airbnb-alert-card">
        <text class="title">待补全</text>
        <text class="section-hint">{{missingText}}</text>
      </view>

      <!-- 客户提醒 -->
      <view class="card summary-card airbnb-card">
        <text class="title">这个客户需要注意什么</text>
        <view wx:if="{{customerAlerts.length}}" class="alert-list">
          <view wx:for="{{customerAlerts}}" wx:key="*this" class="alert-row">
            <text class="alert-mark">!</text>
            <text class="alert-text">{{item}}</text>
          </view>
        </view>
        <text wx:else class="section-hint">暂无已记录的过敏或禁忌</text>
        <view class="confirm-row airbnb-confirm-row" bindtap="confirmSafety" role="button" aria-label="确认已知悉客户过敏与禁忌">
          <view class="airbnb-check {{safetyConfirmed ? 'is-checked' : ''}}">
            <text class="confirm-check">{{safetyConfirmed ? '✓' : '○'}}</text>
          </view>
          <text class="confirm-label">{{safetyConfirmed ? '过敏与禁忌已确认 ' + safetyConfirmedText : '确认已知悉过敏与禁忌'}}</text>
        </view>
      </view>

      <!-- 款式准备 -->
      <view class="card summary-card airbnb-card">
        <text class="title">这个款式需要准备什么</text>
        <block wx:if="{{preparations.length}}">
          <view wx:for="{{preparations}}" wx:key="workId" class="preparation-item airbnb-prep-item">
            <text class="context-work-title">{{item.title}}</text>
            <view wx:if="{{item.tools}}" class="context-block"><text class="context-label">工具</text><text class="context-val">{{item.tools}}</text></view>
            <view wx:if="{{item.materials}}" class="context-block"><text class="context-label">材料</text><text class="context-val">{{item.materials}}</text></view>
            <view wx:if="{{item.preparation}}" class="context-block"><text class="context-label">前置准备</text><text class="context-val">{{item.preparation}}</text></view>
            <view wx:if="{{item.steps}}" class="context-block"><text class="context-label">关键步骤</text><text class="context-val">{{item.steps}}</text></view>
            <view wx:if="{{item.riskNotes}}" class="context-block"><text class="context-label">注意事项</text><text class="context-val">{{item.riskNotes}}</text></view>
            <text wx:if="{{item.estimatedMinutes}}" class="context-meta">历史制作约 {{item.estimatedMinutes}} 分钟</text>
          </view>
        </block>
        <text wx:else class="section-hint">本次预约没有关联作品的制作方案</text>
      </view>

      <!-- 一、服务前 -->
      <view class="card airbnb-card">
        <view class="section-header-block">
          <text class="title">一、服务前</text>
          <text class="section-hint">开始服务时先拍服务前照片，再确认甲面情况。</text>
        </view>
        <view class="photo-section">
          <view class="photo-head">
            <text class="photo-stage-title">服务前照片</text>
            <button class="photo-add booking-action airbnb-add-photo-btn" data-stage="before" bindtap="choosePhotos" disabled="{{uploading}}">＋ 添加</button>
          </view>
          <scroll-view scroll-x class="photo-strip" enable-flex>
            <view class="photo-list">
              <view wx:for="{{beforePhotos}}" wx:key="*this" class="photo-wrap airbnb-photo-wrap">
                <image class="record-photo airbnb-photo" src="{{item}}" mode="aspectFill" data-stage="before" data-url="{{item}}" bindtap="previewPhoto"/>
                <view class="photo-remove airbnb-photo-remove" data-stage="before" data-index="{{index}}" catchtap="removePhoto" role="button" aria-label="删除服务前照片"><image class="photo-remove-icon" src="/static/icons/close-white.svg" mode="aspectFit" /></view>
              </view>
              <view wx:if="{{!beforePhotos.length}}" class="photo-empty-tile" data-stage="before" bindtap="choosePhotos">
                <image class="photo-empty-svg" src="/static/icons/plus.svg" mode="aspectFit" />
                <text class="photo-empty">尚未添加</text>
              </view>
            </view>
          </scroll-view>
        </view>
        <view class="confirm-row airbnb-confirm-row" bindtap="confirmNailCondition" role="button" aria-label="确认已记录当前甲面情况">
          <view class="airbnb-check {{nailConditionConfirmed ? 'is-checked' : ''}}">
            <text class="confirm-check">{{nailConditionConfirmed ? '✓' : '○'}}</text>
          </view>
          <text class="confirm-label">{{nailConditionConfirmed ? '甲面情况已确认 ' + nailConditionConfirmedText : '确认已记录当前甲面情况'}}</text>
        </view>
        <label class="form-field-label">当前甲面、甲型与受损情况 <text class="required-star">*</text></label>
        <view class="chip-row">
          <view wx:for="{{nailConditionSuggestions}}" wx:key="*this" class="chip airbnb-chip" data-field="nailCondition" data-value="{{item}}" bindtap="pickSuggestion">{{item}}</view>
        </view>
        <textarea class="form-textarea airbnb-textarea" value="{{nailCondition}}" data-field="nailCondition" bindinput="input" placeholder="甲面、甲型、损伤和敏感情况"/>
        
        <label class="form-field-label">本次注意事项</label>
        <textarea class="form-textarea airbnb-textarea" value="{{preServiceNotes}}" data-field="preServiceNotes" bindinput="input" placeholder="本次需要特别留意的处理"/>
        
        <label class="form-field-label">客户临时需求</label>
        <textarea class="form-textarea airbnb-textarea" value="{{clientRequests}}" data-field="clientRequests" bindinput="input" placeholder="客户本次临时提出或调整的需求"/>
      </view>

      <!-- 二、过程细节 -->
      <view class="card airbnb-card">
        <view class="section-toggle airbnb-section-toggle" bindtap="toggleProcessDetails" role="button" aria-label="{{showProcessDetails ? '收起过程细节' : '补充过程细节'}}">
          <view>
            <text class="title">二、过程细节</text>
            <text class="section-hint">可选，只记录对下次服务有用的差异。</text>
          </view>
          <view class="toggle-pill">
            <text class="section-arrow">{{showProcessDetails ? '收起' : '展开'}} ›</text>
          </view>
        </view>
        <block wx:if="{{showProcessDetails}}">
          <view class="photo-section">
            <view class="photo-head">
              <text class="photo-stage-title">过程照片</text>
              <button class="photo-add booking-action airbnb-add-photo-btn" data-stage="during" bindtap="choosePhotos" disabled="{{uploading}}">＋ 添加</button>
            </view>
            <scroll-view scroll-x class="photo-strip" enable-flex>
              <view class="photo-list">
                <view wx:for="{{duringPhotos}}" wx:key="*this" class="photo-wrap airbnb-photo-wrap">
                  <image class="record-photo airbnb-photo" src="{{item}}" mode="aspectFill" data-stage="during" data-url="{{item}}" bindtap="previewPhoto"/>
                  <view class="photo-remove airbnb-photo-remove" data-stage="during" data-index="{{index}}" catchtap="removePhoto" role="button" aria-label="删除过程照片"><image class="photo-remove-icon" src="/static/icons/close-white.svg" mode="aspectFit" /></view>
                </view>
                <view wx:if="{{!duringPhotos.length}}" class="photo-empty-tile" data-stage="during" bindtap="choosePhotos">
                  <image class="photo-empty-svg" src="/static/icons/plus.svg" mode="aspectFit" />
                  <text class="photo-empty">尚未添加</text>
                </view>
              </view>
            </scroll-view>
          </view>
          
          <label class="form-field-label">使用材料</label>
          <view wx:if="{{materialSuggestions.length}}" class="chip-row">
            <view wx:for="{{materialSuggestions}}" wx:key="*this" class="chip airbnb-chip" data-field="materials" data-value="{{item}}" bindtap="pickSuggestion">{{item}}</view>
          </view>
          <textarea class="form-textarea airbnb-textarea" value="{{materials}}" data-field="materials" bindinput="input" placeholder="品牌、色号、胶型"/>
          
          <label class="form-field-label">使用工具</label>
          <view wx:if="{{toolSuggestions.length}}" class="chip-row">
            <view wx:for="{{toolSuggestions}}" wx:key="*this" class="chip airbnb-chip" data-field="tools" data-value="{{item}}" bindtap="pickSuggestion">{{item}}</view>
          </view>
          <textarea class="form-textarea airbnb-textarea" value="{{tools}}" data-field="tools" bindinput="input" placeholder="打磨头、笔刷、灯具等"/>
          
          <label class="form-field-label">制作步骤与技法</label>
          <textarea class="form-textarea airbnb-textarea" value="{{techniques}}" data-field="techniques" bindinput="input" placeholder="关键步骤、顺序和调整"/>
          
          <label class="form-field-label">客户过程反应</label>
          <textarea class="form-textarea airbnb-textarea" value="{{clientReaction}}" data-field="clientReaction" bindinput="input" placeholder="无异常、敏感、疼痛或其他反应"/>
          
          <label class="form-field-label">不适或异常</label>
          <textarea class="form-textarea airbnb-textarea" value="{{discomfortNotes}}" data-field="discomfortNotes" bindinput="input"/>
        </block>
      </view>

      <!-- 三、完成后 -->
      <view class="card airbnb-card">
        <view class="section-header-block">
          <text class="title">三、完成后</text>
          <text class="section-hint">完成服务事实记录与客户偏好观察。</text>
        </view>
        <view wx:if="{{orderStatus !== 'completed'}}" class="completion-fields airbnb-completion-box">
          <label class="form-field-label">开始时间 <text class="required-star">*</text></label>
          <view class="time-fields airbnb-picker-row">
            <picker class="date-picker" mode="date" value="{{startDate}}" data-field="startDate" bindchange="changeTime">
              <view class="form-input picker-value airbnb-picker"><text>{{startDate || '选择日期'}}</text><text class="picker-arrow">›</text></view>
            </picker>
            <picker class="time-picker" mode="time" value="{{startTime}}" data-field="startTime" bindchange="changeTime">
              <view class="form-input picker-value airbnb-picker"><text>{{startTime || '选择时间'}}</text><text class="picker-arrow">›</text></view>
            </picker>
          </view>
          <label class="form-field-label">结束时间 <text class="required-star">*</text></label>
          <view class="time-fields airbnb-picker-row">
            <picker class="date-picker" mode="date" value="{{endDate}}" data-field="endDate" bindchange="changeTime">
              <view class="form-input picker-value airbnb-picker"><text>{{endDate || '选择日期'}}</text><text class="picker-arrow">›</text></view>
            </picker>
            <picker class="time-picker" mode="time" value="{{endTime}}" data-field="endTime" bindchange="changeTime">
              <view class="form-input picker-value airbnb-picker"><text>{{endTime || '选择时间'}}</text><text class="picker-arrow">›</text></view>
            </picker>
          </view>
          <view class="amount-fields-row">
            <view class="amount-field-col">
              <label class="form-field-label">实际支付金额 <text class="required-star">*</text></label>
              <input class="form-input airbnb-input" type="digit" data-field="actualAmount" value="{{actualAmount}}" bindinput="input"/>
              <view wx:if="{{depositAmount > 0}}" class="deposit-settle-hint">
                <text wx:if="{{isDepositPaid}}">已付定金 ¥{{depositAmount}} · 现场收尾款：¥{{balanceAmount}}</text>
                <text wx:else>待付定金 ¥{{depositAmount}}（未付） · 现场收全款：¥{{actualAmount || '0'}}</text>
              </view>
            </view>
            <view class="amount-field-col">
              <label class="form-field-label">材料成本 <text class="required-star">*</text></label>
              <input class="form-input airbnb-input" type="digit" data-field="materialCost" value="{{materialCost}}" bindinput="input"/>
            </view>
          </view>
        </view>
        
        <view class="photo-section">
          <view class="photo-head">
            <text class="photo-stage-title">完成后照片</text>
            <button class="photo-add booking-action airbnb-add-photo-btn" data-stage="after" bindtap="choosePhotos" disabled="{{uploading}}">＋ 添加</button>
          </view>
          <scroll-view scroll-x class="photo-strip" enable-flex>
            <view class="photo-list">
              <view wx:for="{{afterPhotos}}" wx:key="*this" class="photo-wrap airbnb-photo-wrap">
                <image class="record-photo airbnb-photo" src="{{item}}" mode="aspectFill" data-stage="after" data-url="{{item}}" bindtap="previewPhoto"/>
                <view class="photo-remove airbnb-photo-remove" data-stage="after" data-index="{{index}}" catchtap="removePhoto" role="button" aria-label="删除完成后照片"><image class="photo-remove-icon" src="/static/icons/close-white.svg" mode="aspectFit" /></view>
              </view>
              <view wx:if="{{!afterPhotos.length}}" class="photo-empty-tile" data-stage="after" bindtap="choosePhotos">
                <image class="photo-empty-svg" src="/static/icons/plus.svg" mode="aspectFit" />
                <text class="photo-empty">尚未添加</text>
              </view>
            </view>
          </scroll-view>
        </view>
        
        <label class="form-field-label">客户反应 <text class="required-star">*</text></label>
        <view class="chip-row">
          <view wx:for="{{reactionOptions}}" wx:key="value" class="chip airbnb-chip {{reactionLevel === item.value ? 'chip-active' : ''}}" data-value="{{item.value}}" bindtap="selectReaction">{{item.label}}</view>
        </view>
        
        <label class="form-field-label">客户反馈</label>
        <textarea class="form-textarea airbnb-textarea" value="{{customerFeedback}}" data-field="customerFeedback" bindinput="input"/>
        
        <label class="form-field-label">本次偏好观察</label>
        <view class="chip-row">
          <view wx:for="{{preferenceSuggestions}}" wx:key="*this" class="chip airbnb-chip" data-field="preferenceNotes" data-value="{{item}}" bindtap="pickSuggestion">{{item}}</view>
        </view>
        <textarea class="form-textarea airbnb-textarea" value="{{preferenceNotes}}" data-field="preferenceNotes" bindinput="input" placeholder="仅补充本次新发现"/>
        
        <label class="form-field-label">护理建议</label>
        <textarea class="form-textarea airbnb-textarea" value="{{careAdvice}}" data-field="careAdvice" bindinput="input"/>
        
        <label class="form-field-label">下次服务准备</label>
        <textarea class="form-textarea airbnb-textarea" value="{{nextServiceNotes}}" data-field="nextServiceNotes" bindinput="input" placeholder="前置工作、替代材料和注意事项"/>
      </view>

      <!-- 同步客户档案 -->
      <view class="card airbnb-card">
        <view class="section-header-block">
          <view class="section-title-row">
            <text class="title">同步客户档案</text>
            <text class="archive-private airbnb-private-badge">仅当前美甲师可见</text>
          </view>
          <text class="section-hint">系统根据本次记录生成候选。只同步你明确选择的内容，且仅当前美甲师可见。</text>
        </view>
        <view wx:if="{{customerFactCandidates.length}}" class="sync-candidate-list">
          <view wx:for="{{customerFactCandidates}}" wx:key="key" class="sync-candidate airbnb-candidate-card {{item.synced ? 'sync-candidate-disabled' : ''}}" data-key="{{item.key}}" bindtap="toggleCustomerFact" role="checkbox" aria-checked="{{item.selected || item.synced}}">
            <view class="airbnb-check {{item.synced || item.selected ? 'is-checked' : ''}}">
              <text class="confirm-check">{{item.synced ? '✓' : (item.selected ? '✓' : '○')}}</text>
            </view>
            <view class="sync-candidate-copy">
              <view class="archive-item-head">
                <text class="archive-label">{{item.label}}</text>
                <text class="archive-state {{item.synced ? 'archive-state-synced' : ''}}">{{item.needsResync ? (item.selected ? '待重新同步' : '需重新同步') : (item.synced ? '已同步' : (item.selected ? '待同步' : '未选择'))}}</text>
              </view>
              <text class="archive-content">{{item.content}}</text>
              <text wx:if="{{item.conflicts.length}}" class="archive-conflict">同分类已有不同内容，请确认是否保留本条</text>
            </view>
          </view>
        </view>
        <text wx:else class="section-hint archive-empty-tip">填写偏好观察、临时需求、不适情况或下次准备后，可生成客户档案候选。</text>
      </view>

      <!-- 同步作品档案 -->
      <view class="card airbnb-card">
        <view class="section-header-block">
          <view class="section-title-row">
            <text class="title">同步作品档案</text>
            <text class="archive-private airbnb-private-badge">仅当前美甲师可见</text>
          </view>
          <text class="section-hint">可选，仅同步工具、材料、制作步骤和耗时；不会把客户信息写入作品。</text>
        </view>
        <view wx:if="{{workReviewItems.length}}" class="work-review work-review-edit airbnb-work-review">
          <text class="work-review-title">同步前复盘</text>
          <view wx:for="{{workReviewItems}}" wx:key="key" class="work-review-item">
            <text class="work-review-label">{{item.label}}</text>
            <text class="work-review-value">{{item.value}}</text>
          </view>
        </view>
        <view class="confirm-row airbnb-confirm-row" bindtap="toggleWorkSync" role="button" aria-label="{{workAssociation.label}}">
          <view class="airbnb-check {{syncWorkResult ? 'is-checked' : ''}}">
            <text class="confirm-check">{{syncWorkResult ? '✓' : '○'}}</text>
          </view>
          <text class="confirm-label">{{workAssociation.label}}</text>
        </view>
      </view>

      <!-- 底部固定浮动操作栏 -->
      <view class="record-bottom-bar airbnb-bottom-bar">
        <text class="completion-tip">缺少服务前照片、完成后照片、甲面情况或客户反应时，预约仍可完成，美甲记录会保留为待补全。</text>
        <view class="record-actions">
          <button class="primary booking-action airbnb-primary-btn" disabled="{{submitting || uploading || syncingWork}}" loading="{{submitting || syncingWork}}" bindtap="submit">
            {{orderStatus === 'completed' ? '保存美甲记录' : '完成预约并保存记录'}}
          </button>
        </view>
      </view>
    </block>

    <!-- ============ 保存成功态 ============ -->
    <block wx:else>
      <view class="card success-card airbnb-success-card">
        <view class="success-icon-wrap">
          <image class="success-icon-svg" src="/static/icons/check-white.svg" mode="aspectFit" />
        </view>
        <text class="success-title">{{recordStatus === 'complete' ? '美甲记录已完善' : '服务已完成，记录待补全'}}</text>
        <text class="success-desc">{{customerName ? '客户：' + customerName : '本次服务已保存'}}</text>
        <view wx:if="{{customerSyncNotice || workSyncNotice}}" class="success-notices-card">
          <text wx:if="{{customerSyncNotice}}" class="success-tip">{{customerSyncNotice}}</text>
          <text wx:if="{{workSyncNotice}}" class="success-tip">{{workSyncNotice}}</text>
        </view>
        <button wx:if="{{customerSyncFailed}}" class="ghost booking-action airbnb-ghost-btn" disabled="{{submitting}}" loading="{{submitting}}" bindtap="retryCustomerSync">重新同步客户档案</button>
        <button wx:if="{{workSyncFailed}}" class="ghost booking-action airbnb-ghost-btn" disabled="{{syncingWork}}" loading="{{syncingWork}}" bindtap="retryWorkSync">重新同步作品档案</button>
        <button wx:if="{{relatedWork}}" class="primary booking-action airbnb-primary-btn success-action-primary" bindtap="goPublishWork">完善并发布作品</button>
        <button wx:if="{{customerId}}" class="ghost booking-action airbnb-ghost-btn" bindtap="openCustomerDetail">查看客户档案</button>
        <button wx:if="{{relatedWork}}" class="ghost booking-action airbnb-ghost-btn" bindtap="openWorkDetail">查看关联作品</button>
        <button class="ghost booking-action airbnb-finish-btn" bindtap="finishAndBack">返回预约</button>
      </view>
    </block>
  </block>

  <!-- 关联更正弹层 -->
  <view wx:if="{{showAssociationEditor}}" class="association-mask airbnb-mask" catchtap="closeAssociationEditor">
    <view class="association-sheet airbnb-sheet" catchtap="noop">
      <view class="association-sheet-head">
        <text class="title">更正{{associationType === 'customer' ? '关联客户' : '关联作品'}}</text>
        <view class="association-close" bindtap="closeAssociationEditor" role="button" aria-label="关闭"><image class="association-close-icon" src="/static/icons/close.svg" mode="aspectFit" /></view>
      </view>
      <text class="section-hint">只能选择当前美甲师名下的信息，更正操作将保留审计记录。</text>
      <scroll-view scroll-y class="association-list airbnb-association-list">
        <view wx:for="{{associationOptions}}" wx:key="id" class="association-option airbnb-association-option {{item.selected ? 'association-option-selected' : ''}}" data-id="{{item.id}}" bindtap="selectAssociationTarget">
          <text class="association-option-label">{{item.label}}</text>
          <view class="association-option-check"><image wx:if="{{item.selected}}" class="association-check-icon" src="/static/icons/check.svg" mode="aspectFit" /></view>
        </view>
      </scroll-view>
      <textarea class="form-textarea association-reason airbnb-textarea" value="{{associationReason}}" bindinput="associationReasonInput" placeholder="填写更正原因（必填）" maxlength="200"/>
      <button class="primary booking-action airbnb-primary-btn" disabled="{{correctingAssociation}}" loading="{{correctingAssociation}}" bindtap="submitAssociationCorrection">确认更正</button>
    </view>
  </view>
</view>
