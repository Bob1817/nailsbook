<nav-bar title="完成服务" showBack/><view class="page">
  <block wx:if="{{!saved}}">
    <view class="card"><text class="title">实际服务信息</text><label>开始时间 *</label><input type="text" data-field="actualStartTime" value="{{actualStartTime}}" bindinput="input" confirm-type="done" /><label>结束时间 *</label><input type="text" data-field="actualEndTime" value="{{actualEndTime}}" bindinput="input" confirm-type="done" /><label>实收金额 *</label><input type="digit" data-field="actualAmount" value="{{actualAmount}}" bindinput="input" confirm-type="done" /><label>材料成本 *</label><input type="digit" data-field="materialCost" value="{{materialCost}}" bindinput="input" confirm-type="done" /></view><view class="card"><text class="title">服务记录</text><label>使用材料</label><textarea data-field="materials" bindinput="input" placeholder="色号、品牌和材料" confirm-type="done" /><label>工艺记录</label><textarea data-field="techniques" bindinput="input" placeholder="本次使用的工艺" confirm-type="done" /><label>指甲状况</label><textarea data-field="nailCondition" bindinput="input" placeholder="甲面、甲型和敏感情况" confirm-type="done" /><label>客户反馈</label><textarea data-field="customerFeedback" bindinput="input" confirm-type="done" /><label>护理建议</label><textarea data-field="careAdvice" bindinput="input" confirm-type="done" /></view><button class="primary" loading="{{submitting}}" bindtap="submit">确认完成并保存记录</button>
  </block>
  <block wx:else>
    <view class="card success-card">
      <text class="success-icon">✓</text>
      <text class="success-title">服务记录已保存</text>
      <text class="success-desc">{{customerName ? '客户：' + customerName : '本次服务已完成'}}</text>
      <text class="success-tip">趁手上的款式还在，马上发布关联作品吧</text>
      <button class="primary" bindtap="goPublishWork">发布关联作品</button>
      <button class="ghost" bindtap="finishAndBack">暂不发布，返回订单</button>
    </view>
  </block>
</view>
