<nav-bar title="美甲记录" showBack/>
<view class="page">
  <view wx:if="{{loading}}" class="card">正在加载预约信息…</view>
  <view wx:elif="{{loadError}}" class="card"><text>{{loadError}}</text><button class="ghost booking-action" bindtap="loadOrder">重新加载</button></view>
  <block wx:elif="{{loaded}}">
    <block wx:if="{{!saved}}">
      <view class="record-status"><text>{{recordStatus === 'complete' ? '记录已完善' : '记录草稿'}}</text><text>内容自动关联当前预约与客户</text></view>

      <view wx:if="{{orderStatus !== 'completed'}}" class="card">
        <text class="title">实际服务信息</text>
        <label>开始时间 *</label>
        <view class="time-fields">
          <picker class="date-picker" mode="date" value="{{startDate}}" data-field="startDate" bindchange="changeTime"><view class="form-input picker-value">{{startDate || '选择日期'}}<text>›</text></view></picker>
          <picker class="time-picker" mode="time" value="{{startTime}}" data-field="startTime" bindchange="changeTime"><view class="form-input picker-value">{{startTime || '选择时间'}}<text>›</text></view></picker>
        </view>
        <label>结束时间 *</label>
        <view class="time-fields">
          <picker class="date-picker" mode="date" value="{{endDate}}" data-field="endDate" bindchange="changeTime"><view class="form-input picker-value">{{endDate || '选择日期'}}<text>›</text></view></picker>
          <picker class="time-picker" mode="time" value="{{endTime}}" data-field="endTime" bindchange="changeTime"><view class="form-input picker-value">{{endTime || '选择时间'}}<text>›</text></view></picker>
        </view>
        <label>实际支付金额 *</label><input class="form-input" type="digit" data-field="actualAmount" value="{{actualAmount}}" bindinput="input"/>
        <label>材料成本 *</label><input class="form-input" type="digit" data-field="materialCost" value="{{materialCost}}" bindinput="input"/>
      </view>

      <view class="card">
        <text class="title">过程照片</text>
        <text class="section-hint">服务前、过程中和完成后分别留档，每组最多 9 张。</text>
        <view wx:for="{{photoStages}}" wx:key="key" class="photo-section">
          <view class="photo-head"><text>{{item.label}}</text><button class="photo-add" data-stage="{{item.key}}" bindtap="choosePhotos" disabled="{{uploading}}">＋ 添加</button></view>
          <scroll-view scroll-x class="photo-strip">
            <view class="photo-list">
              <view wx:for="{{item.key === 'before' ? beforePhotos : (item.key === 'during' ? duringPhotos : afterPhotos)}}" wx:for-item="url" wx:for-index="photoIndex" wx:key="*this" class="photo-wrap">
                <image class="record-photo" src="{{url}}" mode="aspectFill" data-stage="{{item.key}}" data-url="{{url}}" bindtap="previewPhoto"/>
                <view class="photo-remove" data-stage="{{item.key}}" data-index="{{photoIndex}}" catchtap="removePhoto">×</view>
              </view>
              <text wx:if="{{(item.key === 'before' && !beforePhotos.length) || (item.key === 'during' && !duringPhotos.length) || (item.key === 'after' && !afterPhotos.length)}}" class="photo-empty">尚未添加</text>
            </view>
          </scroll-view>
        </view>
      </view>

      <view class="card">
        <text class="title">本次服务事实</text>
        <label>使用材料</label><textarea class="form-textarea" value="{{materials}}" data-field="materials" bindinput="input" placeholder="品牌、色号、胶型"/>
        <label>使用工具</label><textarea class="form-textarea" value="{{tools}}" data-field="tools" bindinput="input" placeholder="打磨头、笔刷、灯具等"/>
        <label>制作步骤与技法</label><textarea class="form-textarea" value="{{techniques}}" data-field="techniques" bindinput="input" placeholder="关键步骤、顺序和调整"/>
        <label>服务前指甲情况 *</label><textarea class="form-textarea" value="{{nailCondition}}" data-field="nailCondition" bindinput="input" placeholder="甲面、甲型、损伤和敏感情况"/>
        <label>客户过程反应</label><textarea class="form-textarea" value="{{clientReaction}}" data-field="clientReaction" bindinput="input" placeholder="无异常、敏感、疼痛或其他反应"/>
        <label>不适或异常</label><textarea class="form-textarea" value="{{discomfortNotes}}" data-field="discomfortNotes" bindinput="input"/>
        <label>客户反馈</label><textarea class="form-textarea" value="{{customerFeedback}}" data-field="customerFeedback" bindinput="input"/>
        <label>本次偏好观察</label><textarea class="form-textarea" value="{{preferenceNotes}}" data-field="preferenceNotes" bindinput="input"/>
        <label>下次服务准备</label><textarea class="form-textarea" value="{{nextServiceNotes}}" data-field="nextServiceNotes" bindinput="input" placeholder="前置工作、替代材料和注意事项"/>
        <label>护理建议</label><textarea class="form-textarea" value="{{careAdvice}}" data-field="careAdvice" bindinput="input"/>
      </view>

      <view class="card">
        <text class="title">确认同步到客户档案</text>
        <text class="section-hint">只填写已经确认、下次服务仍然有用的信息。</text>
        <label>过敏史</label><input class="form-input" value="{{factAllergy}}" data-field="factAllergy" bindinput="input" placeholder="例如：对某类胶敏感"/>
        <label>禁忌</label><input class="form-input" value="{{factContraindication}}" data-field="factContraindication" bindinput="input"/>
        <label>稳定偏好</label><input class="form-input" value="{{factPreference}}" data-field="factPreference" bindinput="input"/>
        <label>沟通习惯</label><input class="form-input" value="{{factCommunication}}" data-field="factCommunication" bindinput="input"/>
        <label>特别提醒</label><input class="form-input" value="{{factReminder}}" data-field="factReminder" bindinput="input"/>
      </view>

      <view class="record-actions">
        <button class="ghost booking-action" disabled="{{submitting || uploading}}" bindtap="saveDraft">{{uploading ? '照片上传中…' : '保存草稿'}}</button>
        <button class="primary booking-action" disabled="{{submitting || uploading}}" loading="{{submitting}}" bindtap="submit">{{orderStatus === 'completed' ? '保存并完善记录' : '确认完成服务'}}</button>
      </view>
      <text class="completion-tip">填写服务前情况并添加至少一张完成后照片后，记录会标记为已完善；否则保留待办继续补充。</text>
    </block>
    <block wx:else>
      <view class="card success-card">
        <text class="success-icon">✓</text><text class="success-title">{{recordStatus === 'complete' ? '美甲记录已完善' : '服务已完成，记录待补全'}}</text>
        <text class="success-desc">{{customerName ? '客户：' + customerName : '本次服务已保存'}}</text>
        <button wx:if="{{orderStatus !== 'completed' || recordStatus === 'complete'}}" class="primary booking-action" loading="{{openingWork}}" bindtap="goPublishWork">{{openingWork ? '准备作品草稿…' : '整理关联作品'}}</button>
        <button class="ghost booking-action" bindtap="finishAndBack">返回预约</button>
      </view>
    </block>
  </block>
</view>
