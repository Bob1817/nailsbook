<nav-bar title="{{tradeView ? '我的订单' : '全部预约'}}" showBack="{{true}}"/>
<view class="page">
  <!-- 筛选标签栏 -->
  <view class="filter-strip">
    <scroll-view scroll-x class="filter-scroll" enhanced show-scrollbar="{{false}}">
      <view class="filter-inner">
        <view
          class="filter-tab {{activeFilter === item.value ? 'active' : ''}}"
          wx:for="{{filterTabs}}"
          wx:key="value"
          bindtap="selectFilter"
          data-value="{{item.value}}"
        >
          <text>{{item.label}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 统计 -->
  <view class="page-header">
    <text class="page-count">共 {{filteredOrders.length}} 个{{tradeView ? '订单' : '预约'}}</text>
  </view>

  <!-- 预约列表 -->
  <scroll-view scroll-y class="list-scroll" enhanced show-scrollbar="{{false}}">
    <view class="list-area">
      <view wx:if="{{loading}}" class="skeleton-list">
        <view wx:for="{{[1,2]}}" wx:key="*this" class="skel-card"></view>
      </view>

      <view wx:elif="{{loadFailed}}" class="empty-card" aria-live="polite">
        <text class="empty-title">预约列表加载失败</text>
        <text class="empty-sub">请检查网络后重试</text>
        <view class="retry-btn booking-action" bindtap="loadOrders" role="button">重新加载</view>
      </view>

      <view wx:elif="{{filteredOrders.length === 0}}" class="empty-card">
        <text class="empty-title">暂无预约记录</text>
        <text class="empty-sub">换个筛选条件看看</text>
      </view>

      <view wx:else class="trip-list">
        <technician-booking-card
          wx:for="{{filteredOrders}}"
          wx:key="id"
          order="{{item}}"
          variant="compact"
          bind:open="onBookingCardOpen"
          bind:navigate="onBookingCardNavigate"
          bind:contact="onBookingCardContact"
          bind:message="onBookingCardMessage"
        />
      </view>
    </view>
  </scroll-view>
</view>
