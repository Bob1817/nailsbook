<nav-bar title="全部预约" showBack="{{true}}"/>
<view class="page">
  <!-- 筛选标签栏 -->
  <view class="filter-strip">
    <scroll-view scroll-x class="filter-scroll" enhanced show-scrollbar="{{false}}">
      <view class="filter-inner">
        <view
          class="filter-tab {{activeFilter === item.value ? 'active' : ''}}"
          wx:for="{{filterTabs}}"
          wx:key="value"
          bindtap="selectFilter"
          data-value="{{item.value}}"
        >
          <text>{{item.label}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 统计 -->
  <view class="page-header">
    <text class="page-count">共 {{filteredOrders.length}} 个预约</text>
  </view>

  <!-- 预约列表 -->
  <scroll-view scroll-y class="list-scroll" enhanced show-scrollbar="{{false}}">
    <view class="list-area">
      <view wx:if="{{loading}}" class="skeleton-list">
        <view wx:for="{{[1,2]}}" wx:key="*this" class="skel-card"></view>
      </view>

      <view wx:elif="{{loadFailed}}" class="empty-card" aria-live="polite">
        <text class="empty-title">预约列表加载失败</text>
        <text class="empty-sub">请检查网络后重试</text>
        <view class="retry-btn" bindtap="loadOrders" role="button">重新加载</view>
      </view>

      <view wx:elif="{{filteredOrders.length === 0}}" class="empty-card">
        <text class="empty-title">暂无预约记录</text>
        <text class="empty-sub">换个筛选条件看看</text>
      </view>

      <view wx:else class="trip-list">
        <view
          wx:for="{{filteredOrders}}"
          wx:key="id"
          class="trip-card"
          bindtap="viewOrder"
          data-id="{{item.id}}"
        >
          <view class="trip-top">
            <text class="trip-time">{{item._clock}}</text>
            <view class="trip-avatar">
              <image wx:if="{{item.customerAvatar}}" src="{{item.customerAvatar}}" mode="aspectFill" class="trip-avatar-img" lazy-load aria-label="{{item.customerName || '客户'}}的头像" />
              <text wx:else class="trip-avatar-char">{{item._avatarChar}}</text>
            </view>
            <view class="trip-info">
              <text class="trip-name">{{item.customerName}}</text>
              <text class="trip-svc">{{item._typeLabel}} · {{item.serviceName}}</text>
            </view>
            <text class="trip-status {{item._statusTone}}">{{item._statusLabel}}</text>
          </view>

          <view wx:if="{{item.address}}" class="trip-addr">{{item.address}}</view>

          <view class="trip-actions">
            <view class="trip-btn trip-primary" catchtap="navigateToAddress" data-id="{{item.id}}">
              去导航
            </view>
            <view class="trip-btn trip-ghost" catchtap="contactCustomer" data-phone="{{item.customerPhone}}">
              联系客户
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
