page {
  background: var(--bg-gradient-entry);
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== 筛选标签栏 ===== */
.filter-strip {
  flex-shrink: 0;
  background: rgba(255,255,255,0.72);
  backdrop-filter: blur(12rpx);
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
  padding: 16rpx 0;
}
.filter-scroll { white-space: nowrap; }
.filter-inner {
  display: inline-flex;
  padding: 0 24rpx;
  gap: 16rpx;
}
.filter-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 28rpx;
  border-radius: var(--radius-lg);
  font-size: var(--font-sm);
  color: var(--text-muted);
  background: var(--bg-input);
  white-space: nowrap;
  flex-shrink: 0;
}
.filter-tab.active {
  background: var(--brand-gradient);
  color: var(--text-inverse);
  font-weight: var(--weight-medium);
}

/* ===== 页面头部 ===== */
.page-header {
  flex-shrink: 0;
  padding: 16rpx 40rpx 8rpx;
}
.page-count { font-size: var(--font-sm); color: var(--text-muted); }

/* ===== 列表 ===== */
.list-scroll { flex: 1; min-height: 0; }
.list-area { padding: 16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); }

/* ===== 骨架/空状态 ===== */
.skeleton-list { display: flex; flex-direction: column; gap: 16rpx; }
.skel-card {
  height: 200rpx;
  border-radius: var(--card-radius);
  background: var(--bg-input);
  animation: skel 1.4s linear infinite;
}
@keyframes skel { 0%{opacity:1;} 50%{opacity:0.5;} 100%{opacity:1;} }

.empty-card {
  margin: 80rpx 0;
  padding: 60rpx 40rpx;
  background: var(--bg-card);
  border-radius: var(--card-radius);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  border: 2rpx solid rgba(255,107,138,0.08) /* brand-primary-alpha */;
  box-shadow: var(--shadow-lg);
}
.empty-title { font-size: var(--font-md); font-weight: var(--weight-semibold); color: var(--text-primary); }
.empty-sub { font-size: var(--font-sm); color: var(--text-muted); text-align: center; }
.retry-btn { display:flex; min-height:88rpx; margin-top:22rpx; padding:0 38rpx; align-items:center; justify-content:center; border-radius: var(--radius-xl); background: var(--bg-tag); color:#9e496f; font-size: var(--font-sm); font-weight: var(--weight-semibold); }

/* ===== 行程卡片 ===== */
.trip-list { display: flex; flex-direction: column; gap: 16rpx; }
.trip-card {
  background: var(--bg-card);
  border-radius: var(--card-radius);
  padding: var(--space-md);
  border: 2rpx solid rgba(255,107,138,0.08) /* brand-primary-alpha */;
  box-shadow: var(--shadow-lg);
}
.trip-card:active { background: #fef7f9; }

.trip-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.trip-time {
  width: 88rpx;
  flex-shrink: 0;
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
}
.trip-avatar {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  background: var(--bg-page);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.trip-avatar-img { width: 100%; height: 100%; }
.trip-avatar-char { font-size: var(--font-sm); font-weight: var(--weight-semibold); color: var(--text-muted); }

.trip-info { flex: 1; min-width: 0; }
.trip-name { display: block; font-size: var(--font-md); font-weight: var(--weight-semibold); color: var(--text-primary); }
.trip-svc {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-xs);
  color: var(--text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.trip-status {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
}
.tone-orange  { background: #fff2dc; color: #c97f1a; }
.tone-purple  { background: #f0e9ff; color: #7c5dd4; }
.tone-yellow  { background: #fff8d6; color: #a48313; }
.tone-emerald { background: #e3f6ec; color: #067b4a; }
.tone-teal    { background: #d8f1ee; color: #107d70; }
.tone-sky     { background: #dbecff; color: #1f6dd6; }
.tone-gray    { background: #f4f5f7; color: #8a8f98; }
.tone-red     { background: #ffe5e6; color: #c5333d; }

.trip-addr {
  margin-top: var(--space-sm);
  padding: 12rpx 16rpx;
  background: var(--bg-input);
  border-radius: var(--radius-xs);
  font-size: var(--font-xs);
  line-height: var(--leading-normal);
  color: var(--text-muted);
}

.trip-actions {
  margin-top: var(--space-sm);
  display: flex;
  gap: 12rpx;
}
.trip-btn {
  flex: 1;
  min-height: 72rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
}
.trip-btn:active { opacity: 0.85; }
.trip-primary {
  background: var(--brand-gradient);
  color: var(--text-inverse);
}
.trip-ghost {
  background: var(--bg-card);
  color: var(--text-body);
  border: 2rpx solid rgba(255,107,138,0.15) /* brand-primary-alpha */;
}
