.deletion-page { padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); background: var(--nb-page); color: var(--nb-ink); }
.deletion-card { background: var(--nb-surface); border-radius: 16rpx; padding: 28rpx; margin-bottom: 24rpx; }
.deletion-title { display: block; font-size: 32rpx; font-weight: 600; margin-bottom: 20rpx; }
.deletion-copy { display: block; font-size: 28rpx; line-height: 1.7; margin-top: 16rpx; color: var(--nb-secondary); overflow-wrap: anywhere; }
.deletion-input { box-sizing: border-box; width: 100%; height: 200rpx; padding: 20rpx; border-radius: 12rpx; background: var(--nb-page); font-size: 28rpx; }
.deletion-check { display: flex; align-items: center; min-height: 44px; padding: 20rpx 0; font-size: 26rpx; line-height: 1.5; }
.deletion-button { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 44px; padding: 12rpx 24rpx; margin: 20rpx 0 0; border-radius: 12rpx; background: var(--nb-action); color: var(--nb-surface); font-size: 28rpx; line-height: 1.5; }
.deletion-button.secondary { background: var(--nb-page); color: var(--nb-ink); }
.deletion-button[disabled] { background: var(--nb-page); color: var(--nb-secondary); }
.deletion-page{padding:32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom))}.deletion-card{padding:28rpx;margin-bottom:20rpx;border-radius:24rpx}.deletion-title{margin-bottom:12rpx;font-size:var(--font-lg);font-weight:var(--weight-semibold)}.deletion-copy{margin-top:10rpx;font-size:var(--font-sm);line-height:1.65}.deletion-input{height:180rpx;margin-top:12rpx;border-radius:14rpx;background:var(--nb-soft-surface);font-size:var(--font-sm)}.deletion-check{font-size:var(--font-xs)}.deletion-button{min-height:88rpx;border-radius:16rpx;background:var(--nb-action);font-size:var(--font-sm)}.deletion-button.secondary{background:var(--nb-soft-surface)}

@import '../../styles/booking-actions.wxss';
.deletion-button.booking-action { min-height: var(--control-hit-height); height: var(--control-hit-height); border-radius: 8px; padding: 0 24rpx; font-size: var(--font-sm); box-shadow: none; }
