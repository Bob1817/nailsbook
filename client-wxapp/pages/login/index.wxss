/**
 * OnlyNail 统一登录页
 * 微信优先；品牌与操作收成居中一列，避免上下割裂的大留白
 */

/* ===== 页面根 ===== */
page {
  background: var(--bg-card);
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.login-root {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: calc(24px + env(safe-area-inset-top)) var(--space-xl) calc(var(--space-xl) + env(safe-area-inset-bottom));
}

.login-stack {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ===== WeChat 登录屏 ===== */
.hero {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: var(--space-3xl);
}

.logo-text {
  font-size: 48rpx;
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  line-height: 1.2;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.tagline {
  font-size: var(--font-sm);
  font-weight: var(--weight-regular);
  color: var(--text-muted);
}

/* ===== 按钮区域 ===== */
.btn-area {
  width: 100%;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-md);
}

/* WeChat 登录按钮：主操作，石墨底白字 */
.wechat-btn {
  width: 100%;
  height: var(--btn-height);
  border-radius: var(--btn-radius);
  background: var(--nb-action);
  border: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--nb-inverse);
  box-shadow: none;
}

.wechat-btn::after { border: none; }

.wechat-btn:active {
  opacity: 0.88;
}

.wechat-btn-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.wechat-unavailable {
  text-align: center;
  padding: var(--space-md) 0;
}

.wechat-unavailable-hint {
  font-size: var(--font-sm);
  color: var(--text-faint);
}

/* 其他登录方式 */
.alt-login {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm);
  color: var(--text-muted);
  padding: 0 var(--space-sm);
}

.guest-entry { min-height:88rpx; display:flex; align-items:center; justify-content:center; color:var(--nb-secondary); font-size:28rpx; }

.alt-login:active { opacity: 0.6; }

.wechat-privacy-consent {
  width: 100%;
  margin-top: var(--space-xl);
  justify-content: center;
}

/* ===== 手机号 + 密码登录屏 ===== */
.phone-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  margin-top: -60rpx;
}

.form-section {
  padding: 0 8rpx;
}

.phone-heading {
  font-size: 48rpx;
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  margin-bottom: var(--space-sm);
  text-align: center;
  width: 100%;
}

.phone-sub {
  font-size: var(--font-sm);
  color: var(--text-faint);
  margin-bottom: var(--space-3xl);
  text-align: center;
  width: 100%;
}

/* ===== 统一输入行 ===== */
.input-row {
  width: 100%;
  height: 56px;
  display: flex;
  align-items: center;
  background: var(--nb-soft-surface);
  border-radius: 14px;
  border: 0;
  padding: 0 28rpx;
  margin-bottom: var(--space-md);
  transition: border-color 0.2s;
  box-sizing: border-box;
}

.input-row:focus-within {
  border-color: var(--border-focus);
  background: var(--bg-input-focus);
}

/* 前缀区域（+86 / 图标） */
.input-prefix {
  font-size: 30rpx;
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  flex-shrink: 0;
  padding-right: 0;
}

.input-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  opacity: 0.45;
  margin-right: 24rpx;
}

/* 区号与号码之间的分隔线 */
.input-divider {
  width: 1.5rpx;
  height: 28rpx;
  background: var(--border-default);
  margin: 0 24rpx;
  flex-shrink: 0;
}

/* 输入框本身 */
.input-field {
  flex: 1;
  height: 56px;
  font-size: 30rpx;
  color: var(--text-primary);
  background: transparent;
  line-height: 56px;
}

.input-placeholder {
  color: var(--text-faint);
  font-size: 28rpx;
}

/* 密码可见切换按钮 */
.pwd-toggle {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: var(--space-sm);
}

.pwd-toggle:active { opacity: 0.5; }

.pwd-toggle-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.35;
}

.phone-privacy-consent {
  width: 100%;
  box-sizing: border-box;
  margin: 0 0 var(--space-lg);
  padding: 0;
  justify-content: flex-start;
}

/* ===== 提交按钮 ===== */
.submit-btn {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  height: var(--btn-height);
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  align-self: stretch;
  border-radius: var(--btn-radius);
  background: var(--bg-input);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: var(--text-muted);
  transition: all 0.24s;
  letter-spacing: 4rpx;
}

.submit-btn::after { border: none; }

.submit-btn-active {
  background: var(--brand-gradient);
  color: var(--text-inverse);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.3);
}

.submit-btn-active:active {
  opacity: 0.88;
  transform: scale(0.985);
}

/* ===== 登录辅助入口 ===== */
.account-actions {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-md);
  margin-top: var(--space-sm);
}

.account-action {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 var(--space-sm);
  font-size: var(--font-sm);
  color: var(--nb-text-link);
}

.account-action:active { opacity: 0.6; }

.account-action-divider {
  width: 1rpx;
  height: 24rpx;
  background: var(--border-default);
}

/* ===== 协议 ===== */
.agreement {
  flex-shrink: 0;
  font-size: 11px;
  color: var(--text-faint);
  text-align: center;
  width: 100%;
  padding-bottom: env(safe-area-inset-bottom, 40rpx);
  padding-top: var(--space-md);
}

.invite-registration-note { display: block; margin-bottom: 24rpx; font-size: 24rpx; line-height: 1.6; color: var(--nb-secondary); text-align: center; }

@import '../../styles/booking-actions.wxss';
.wechat-btn.booking-action,
.submit-btn.booking-action { height: var(--control-hit-height); min-height: 44px; border-radius: 8px; font-size: var(--font-sm); box-shadow: none; }
.wechat-btn.booking-action { background: var(--nb-action); color: var(--nb-inverse); }
.submit-btn.booking-action { background: var(--nb-soft-surface); color: var(--nb-secondary); }
.submit-btn.booking-action.submit-btn-active { background: var(--nb-action); color: var(--text-inverse); }
