# 数据库连接配置
# 开发: DATABASE_URL="file:./dev.db"
# 生产: DATABASE_URL="postgresql://user:password@host:5432/nailbook" 或 mysql
DATABASE_URL="file:./dev.db"

# JWT 密钥（各角色独立密钥，生产环境务必替换为强随机字符串）
# 生成方法: openssl rand -base64 48
ADMIN_JWT_SECRET=change-me-admin-secret-at-least-32-chars
TECHNICIAN_JWT_SECRET=change-me-technician-secret-at-least-32-chars
CLIENT_JWT_SECRET=change-me-client-secret-at-least-32-chars
JWT_EXPIRES_IN=8h

# 应用端口
PORT=3000

# 环境
NODE_ENV=development

# CORS 白名单，多个域名用英文逗号分隔；生产环境必须显式配置
# 开发: CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# 生产: CORS_ORIGINS=https://client.yourdomain.com,https://admin.yourdomain.com,https://landing.yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# 上传文件基础 URL（本地存储时跟随后端；用 OSS 时图片返回绝对 URL，此项不影响）
UPLOAD_BASE_URL=http://localhost:3000
WEBAPP_URL=http://localhost:3000

# ===== 图片存储配置 =====
# 留空 = 本地 uploads 目录（仅开发使用）
# oss  = 阿里云 OSS（生产环境推荐）
STORAGE_PROVIDER=

# 阿里云 OSS 配置（STORAGE_PROVIDER=oss 时必填）
# Region，如 oss-cn-hangzhou
OSS_REGION=oss-cn-hangzhou
# Bucket 名称
OSS_BUCKET=
# AccessKey ID 和 Secret（建议使用子账号，仅授予 OSS 读写权限）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 可选：自定义 endpoint（内网加速用，如 https://oss-cn-hangzhou-internal.aliyuncs.com）
OSS_ENDPOINT=
# 可选：CDN/自定义域名（如 https://img.yourdomain.com），不填则使用 OSS 默认域名
OSS_BASE_URL=
# 可选：对象前缀，默认 images/
OSS_PREFIX=images/

# 生产环境默认关闭 Swagger，如需临时开启请显式设置 true
ENABLE_SWAGGER=false

# 短信服务（找回密码验证码）
# 开发环境可留空：不真正发送，配合开发固定码 123456 使用
# 开发固定码需同时设置 NODE_ENV=development 且 ALLOW_DEV_MVP_VERIFICATION_CODE=true
ALLOW_DEV_MVP_VERIFICATION_CODE=true
# 启用阿里云短信：SMS_PROVIDER=aliyun
SMS_PROVIDER=
# 发送健壮性：失败重试次数与单次超时（毫秒）
SMS_MAX_RETRIES=2
SMS_TIMEOUT_MS=8000
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# 模板变量名（取决于你的模板，例如模板内容为 验证码${code}，则填 code）
ALIYUN_SMS_TEMPLATE_PARAM_KEY=code
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
