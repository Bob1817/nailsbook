generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           Int            @id @default(autoincrement())
  username     String         @unique
  passwordHash String
  realName     String?
  email        String?
  phone        String?
  roleId       Int
  status       String         @default("active")
  tokenVersion Int            @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt
  role         AdminRole      @relation(fields: [roleId], references: [id])
  logs         OperationLog[]
}

model AdminRole {
  id          Int                   @id @default(autoincrement())
  name        String
  code        String                @unique
  description String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @default(now()) @updatedAt
  users       AdminUser[]
  permissions AdminRolePermission[]
}

model AdminPermission {
  id        Int                   @id @default(autoincrement())
  name      String
  code      String                @unique
  module    String
  action    String
  createdAt DateTime              @default(now())
  roles     AdminRolePermission[]
}

model AdminRolePermission {
  id           Int             @id @default(autoincrement())
  roleId       Int
  permissionId Int
  createdAt    DateTime        @default(now())
  role         AdminRole       @relation(fields: [roleId], references: [id])
  permission   AdminPermission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model Technician {
  id                        Int                         @id @default(autoincrement())
  name                      String
  phone                     String                      @unique
  passwordHash              String                      @default("")
  managedPasswordCiphertext String?
  tokenVersion              Int                         @default(0)
  mustChangePassword        Boolean                     @default(false)
  avatarUrl                 String?
  city                      String?
  province                  String?
  serviceArea               String?
  status                    String                      @default("inactive")
  invitationCode            String?                     @unique
  invitedAt                 DateTime?
  lastLoginAt               DateTime?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @default(now()) @updatedAt
  inviteKey                 TechnicianInviteKey?
  // Service type settings
  homeService               Boolean                     @default(false)
  shopService               Boolean                     @default(false)
  shopAddresses             String? // JSON array of shop addresses
  serviceItems              String? // JSON array of technician service items
  // Home service configuration
  homeServiceRadius         Float? // Service radius in km
  homeServicePricing        String? // JSON: tiered pricing [{minKm, maxKm, price}]
  nightServiceFee           Float? // Night service surcharge
  holidayServiceFee         Float? // Holiday service surcharge
  minOrderAmount            Float? // Minimum order amount (guaranteed consumption)
  // Social media accounts
  socialMedia               String? // JSON object of social media accounts
  // Service schedule (JSON: weekly availability + time ranges)
  serviceSchedule           String?
  // Custom tags (JSON array of {id, name, color})
  customTags                String?
  customers                 Customer[]
  orders                    Order[]
  revenues                  Revenue[]
  subscription              TechnicianSubscription?
  clientBindings            ClientTechBinding[]
  nailWorks                 NailWork[]
  designRequests            ClientDesignRequest[]
  conversations             Conversation[]
  customServiceRequests     CustomServiceRequest[]
  workComments              NailWorkComment[]
  blockedTimeSlots          BlockedTimeSlot[]
  serviceReviews            ServiceReview[]
  customerFollowUps         CustomerFollowUp[]
  referralCampaign          ReferralCampaign?
  referralLinks             ReferralLink[]
  referralRelations         ReferralRelation[]
  rewardAccounts            RewardAccount[]
  paymentOrders             PaymentOrder[]
  wechatIdentity            WechatIdentity?
  subscriptionUsages        SubscriptionResourceUsage[]
  subscriptionChanges       SubscriptionChange[]
  subscriptionUsageEvents   SubscriptionUsageEvent[]
  marketingMaterials        MarketingMaterial[]
  dataExportAudits          DataExportAudit[]
  uploadedAssets            UploadedAsset[]
  subscriptionMetricEvents  SubscriptionMetricEvent[]
}

model ReferralCampaign {
  id                 Int        @id @default(autoincrement())
  technicianId       Int        @unique
  rewardAmount       Float
  minimumOrderAmount Float      @default(0)
  validFrom          DateTime
  validUntil         DateTime
  status             String     @default("inactive")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @default(now()) @updatedAt
  technician         Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([status, validUntil])
}

model ReferralLink {
  id               Int                @id @default(autoincrement())
  token            String             @unique
  referrerClientId Int
  technicianId     Int
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime           @default(now())
  referrer         ClientUser         @relation(fields: [referrerClientId], references: [id], onDelete: Cascade)
  technician       Technician         @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  relations        ReferralRelation[]

  @@index([referrerClientId, technicianId])
  @@index([expiresAt])
}

model ReferralRelation {
  id                 Int                    @id @default(autoincrement())
  referrerClientId   Int
  referredClientId   Int
  technicianId       Int
  sourceLinkId       Int
  rewardPromised     Boolean                @default(false)
  rewardAmount       Float?
  minimumOrderAmount Float                  @default(0)
  status             String                 @default("pending_first_order")
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @default(now()) @updatedAt
  referrer           ClientUser             @relation("ReferralReferrer", fields: [referrerClientId], references: [id], onDelete: Cascade)
  referred           ClientUser             @relation("ReferralReferred", fields: [referredClientId], references: [id], onDelete: Cascade)
  technician         Technician             @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  sourceLink         ReferralLink           @relation(fields: [sourceLinkId], references: [id], onDelete: Restrict)
  qualification      ReferralQualification?

  @@unique([technicianId, referredClientId])
  @@index([referrerClientId, technicianId])
}

model ReferralQualification {
  id                 Int              @id @default(autoincrement())
  relationId         Int              @unique
  orderId            Int              @unique
  paidAmount         Float
  minimumOrderAmount Float
  rewardAmount       Float
  status             String           @default("qualified")
  qualifiedAt        DateTime         @default(now())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt
  relation           ReferralRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  order              Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
}

model RewardAccount {
  id           Int            @id @default(autoincrement())
  technicianId Int
  clientUserId Int
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt
  technician   Technician     @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  clientUser   ClientUser     @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  ledger       RewardLedger[]

  @@unique([technicianId, clientUserId])
  @@index([clientUserId])
}

model RewardLedger {
  id           Int            @id @default(autoincrement())
  accountId    Int
  entryType    String
  amount       Float
  status       String
  sourceType   String
  sourceId     String
  reversalOfId Int?
  availableAt  DateTime?
  expiresAt    DateTime?
  createdAt    DateTime       @default(now())
  account      RewardAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  reversalOf   RewardLedger?  @relation("RewardLedgerReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals    RewardLedger[] @relation("RewardLedgerReversal")

  @@unique([sourceType, sourceId, entryType])
  @@index([accountId, status, expiresAt])
}

model Customer {
  id           Int                    @id @default(autoincrement())
  technicianId Int
  clientUserId Int?
  name         String
  phone        String?
  avatarUrl    String?
  gender       String?
  birthday     DateTime?
  address      String?
  tags         String?
  notes        String?
  sourceType   String                 @default("historical")
  sourceRef    String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @default(now()) @updatedAt
  archivedAt   DateTime?
  technician   Technician             @relation(fields: [technicianId], references: [id])
  clientUser   ClientUser?            @relation(fields: [clientUserId], references: [id])
  orders       Order[]
  revenues     Revenue[]
  workAccesses NailWorkClientAccess[]
  followUps    CustomerFollowUp[]

  @@unique([technicianId, clientUserId])
  @@index([technicianId])
  @@index([technicianId, archivedAt])
  @@index([clientUserId])
  @@index([phone])
}

model CustomerFollowUp {
  id           Int        @id @default(autoincrement())
  customerId   Int
  technicianId Int
  content      String
  plannedAt    DateTime
  status       String     @default("pending")
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([customerId, plannedAt])
  @@index([technicianId, status, plannedAt])
}

model Order {
  id                     Int                    @id @default(autoincrement())
  orderNo                String                 @unique
  technicianId           Int
  customerId             Int
  clientUserId           Int?
  addressId              Int?
  designRequestId        Int?
  customServiceRequestId Int?
  sourceWorkId           Int?
  startTime              DateTime
  endTime                DateTime
  address                String?
  serviceType            String?
  remark                 String?
  // 自定义需求模式下的内容（替代 selectedServiceIds 的可选输入）
  customTitle            String?
  customDescription      String?
  customImages           String? // JSON array of image URLs
  clientPhotos           String? // JSON array uploaded by the client after completion
  clientRecordNote       String? // Client-authored note shown in the completed beauty record
  reminderDaySent        Boolean                @default(false)
  reminderHourSent       Boolean                @default(false)
  quotePrice             Float?
  fundDiscountAmount     Float                  @default(0)
  paymentStatus          String                 @default("unpaid")
  paidAmount             Float                  @default(0)
  paidAt                 DateTime?
  quoteRemark            String?
  quotedAt               DateTime?
  confirmToken           String?                @unique
  confirmTokenExpiresAt  DateTime?
  confirmTokenUsedAt     DateTime?
  status                 String                 @default("pending_quote")
  isDepositPaid          Boolean                @default(false)
  depositAmount          Float?                 @default(0)
  depositStatus          String?                @default("pending")
  depositConfirmedAt     DateTime?
  confirmedAt            DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  cancelReason           String?
  // 自动过期：预约时间已过但仍未进入行程（待上门/待到店）时置为 expired。
  // expiredFromStatus 记录过期前状态，便于「重新发起」时恢复原状态。
  expiredAt              DateTime?
  expiredFromStatus      String?
  source                 String?                @default("technician")
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @default(now()) @updatedAt
  technician             Technician             @relation(fields: [technicianId], references: [id])
  customer               Customer               @relation(fields: [customerId], references: [id])
  clientUser             ClientUser?            @relation(fields: [clientUserId], references: [id])
  clientAddress          ClientAddress?         @relation(fields: [addressId], references: [id])
  designRequest          ClientDesignRequest?   @relation(fields: [designRequestId], references: [id])
  customServiceRequest   CustomServiceRequest?  @relation(fields: [customServiceRequestId], references: [id])
  sourceWork             NailWork?              @relation(fields: [sourceWorkId], references: [id], onDelete: SetNull)
  revenue                Revenue?
  workAccesses           NailWorkClientAccess[]
  review                 ServiceReview?
  reminders              OrderReminder[]
  referralQualification  ReferralQualification?
  paymentOrders          PaymentOrder[]

  @@index([technicianId])
  @@index([customerId])
  @@index([clientUserId])
  @@index([addressId])
  @@index([designRequestId])
  @@index([customServiceRequestId])
  @@index([sourceWorkId])
  @@index([status])
  @@index([startTime])
}

model OrderReminder {
  id            Int       @id @default(autoincrement())
  orderId       Int
  type          String
  scheduledFor  DateTime
  status        String    @default("pending")
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  sentAt        DateTime?
  cancelledAt   DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, type])
  @@index([status, scheduledFor])
}

model ClientUser {
  id                        Int                    @id @default(autoincrement())
  nickname                  String?
  phone                     String                 @unique
  passwordHash              String                 @default("")
  managedPasswordCiphertext String?
  tokenVersion              Int                    @default(0)
  avatarUrl                 String?
  city                      String?
  bio                       String?
  status                    String                 @default("active")
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @default(now()) @updatedAt
  bindings                  ClientTechBinding[]
  addresses                 ClientAddress[]
  orders                    Order[]
  customers                 Customer[]
  designRequests            ClientDesignRequest[]
  conversations             Conversation[]
  customServiceRequests     CustomServiceRequest[]
  workComments              NailWorkComment[]
  workAccesses              NailWorkClientAccess[]
  workShareGrants           NailWorkShareGrant[]
  serviceReviews            ServiceReview[]
  workShareEvents           NailWorkShareEvent[]
  referralLinks             ReferralLink[]
  referralsMade             ReferralRelation[]     @relation("ReferralReferrer")
  referralAttributions      ReferralRelation[]     @relation("ReferralReferred")
  rewardAccounts            RewardAccount[]
  paymentOrders             PaymentOrder[]
  wechatIdentity            WechatIdentity?
}

model WechatIdentity {
  id           Int         @id @default(autoincrement())
  appId        String
  openId       String
  unionId      String?
  clientUserId Int?        @unique
  technicianId Int?        @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt
  clientUser   ClientUser? @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  technician   Technician? @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([appId, openId])
  @@index([unionId])
}

model AuthVerificationCode {
  key       String   @id
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([expiresAt])
}

model AuthVerificationRateLimit {
  key       String   @id
  count     Int      @default(1)
  resetAt   DateTime
  updatedAt DateTime @default(now()) @updatedAt

  @@index([resetAt])
}

model WechatPlatformConfig {
  id                     Int       @id @default(1)
  loginEnabled           Boolean   @default(false)
  miniProgramAppId       String?
  miniProgramSecret      String?
  loginValidatedAt       DateTime?
  loginValidationError   String?
  paymentEnabled         Boolean   @default(false)
  merchantId             String?
  merchantSerialNo       String?
  merchantPrivateKey     String?
  apiV3Key               String?
  paymentNotifyUrl       String?
  paymentValidatedAt     DateTime?
  paymentValidationError String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now()) @updatedAt
}

model ClientTechBinding {
  id         Int        @id @default(autoincrement())
  clientId   Int
  techId     Int
  inviteCode String?
  bindSource String
  isDefault  Boolean    @default(false)
  // pending（待美甲师审批）| active（已绑定）| inactive（已解除）| rejected（被拒绝）
  status     String     @default("active")
  note       String? // 客户申请绑定时填写的备注
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @default(now()) @updatedAt
  client     ClientUser @relation(fields: [clientId], references: [id])
  technician Technician @relation(fields: [techId], references: [id])

  @@unique([clientId, techId])
  @@index([techId])
  @@index([clientId, status])
}

model ClientAddress {
  id                    Int                    @id @default(autoincrement())
  clientId              Int
  contactName           String?
  contactPhone          String?
  province              String?
  city                  String?
  district              String?
  detailAddress         String?
  doorInfo              String?
  latitude              Float?
  longitude             Float?
  isDefault             Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @default(now()) @updatedAt
  client                ClientUser             @relation(fields: [clientId], references: [id])
  orders                Order[]
  customServiceRequests CustomServiceRequest[]

  @@index([clientId])
}

model NailWork {
  id                  Int                    @id @default(autoincrement())
  techId              Int
  title               String?
  coverUrl            String?
  images              String?
  description         String?
  designIdea          String?
  suitableScene       String?
  recommendationScore Int?
  tags                String?
  isVisible           Boolean                @default(true)
  isPinned            Boolean                @default(false)
  isFeatured          Boolean                @default(false)
  sortOrder           Int                    @default(0)
  price               Float?
  viewCount           Int                    @default(0)
  isHomepageFeatured  Boolean                @default(false)
  // public: 已绑定客户均可见；authorized_clients: 仅授权客户可见
  visibilityScope     String                 @default("public")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @default(now()) @updatedAt
  technician          Technician             @relation(fields: [techId], references: [id])
  likes               NailWorkLike[]
  favorites           NailWorkFavorite[]
  comments            NailWorkComment[]
  clientAccesses      NailWorkClientAccess[]
  shareGrants         NailWorkShareGrant[]
  shareEvents         NailWorkShareEvent[]
  sourceOrders        Order[]

  @@index([techId])
  @@index([isVisible])
  @@index([isHomepageFeatured])
}

model NailWorkClientAccess {
  id           Int                  @id @default(autoincrement())
  workId       Int
  customerId   Int
  clientUserId Int?
  orderId      Int?
  canView      Boolean              @default(true)
  canShare     Boolean              @default(false)
  canFavorite  Boolean              @default(true)
  canLike      Boolean              @default(true)
  canComment   Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @default(now()) @updatedAt
  work         NailWork             @relation(fields: [workId], references: [id], onDelete: Cascade)
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  clientUser   ClientUser?          @relation(fields: [clientUserId], references: [id], onDelete: SetNull)
  order        Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  shareGrants  NailWorkShareGrant[]

  @@unique([workId, customerId])
  @@index([clientUserId, canView])
  @@index([orderId])
}

model NailWorkShareGrant {
  id           Int                  @id @default(autoincrement())
  token        String               @unique
  workId       Int
  accessId     Int
  clientUserId Int
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime             @default(now())
  work         NailWork             @relation(fields: [workId], references: [id], onDelete: Cascade)
  access       NailWorkClientAccess @relation(fields: [accessId], references: [id], onDelete: Cascade)
  clientUser   ClientUser           @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  events       NailWorkShareEvent[]

  @@index([workId])
  @@index([accessId, revokedAt])
  @@index([expiresAt])
}

model NailWorkShareEvent {
  id           Int                 @id @default(autoincrement())
  workId       Int
  clientUserId Int?
  shareGrantId Int?
  eventType    String
  channel      String?
  createdAt    DateTime            @default(now())
  work         NailWork            @relation(fields: [workId], references: [id], onDelete: Cascade)
  clientUser   ClientUser?         @relation(fields: [clientUserId], references: [id], onDelete: SetNull)
  shareGrant   NailWorkShareGrant? @relation(fields: [shareGrantId], references: [id], onDelete: SetNull)

  @@index([workId, eventType])
  @@index([clientUserId])
  @@index([shareGrantId])
  @@index([createdAt])
}

model ServiceReview {
  id                   Int        @id @default(autoincrement())
  orderId              Int        @unique
  clientUserId         Int
  technicianId         Int
  rating               Int
  content              String?
  photos               String?
  photoUseAuthorized   Boolean    @default(false)
  photoUseAuthorizedAt DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @default(now()) @updatedAt
  order                Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  clientUser           ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  technician           Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([clientUserId])
  @@index([technicianId, rating])
}

model NailWorkLike {
  id           Int      @id @default(autoincrement())
  workId       Int
  clientId     Int?
  technicianId Int?
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())
  work         NailWork @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([workId, clientId, technicianId])
  @@index([workId])
}

model NailWorkFavorite {
  id           Int      @id @default(autoincrement())
  workId       Int
  clientId     Int?
  technicianId Int?
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())
  work         NailWork @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([workId, clientId, technicianId])
  @@index([workId])
}

model NailWorkComment {
  id           Int               @id @default(autoincrement())
  workId       Int
  clientId     Int?
  technicianId Int?
  parentId     Int?
  content      String
  isRead       Boolean           @default(false)
  isPinned     Boolean           @default(false)
  isHidden     Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt
  work         NailWork          @relation(fields: [workId], references: [id], onDelete: Cascade)
  client       ClientUser?       @relation(fields: [clientId], references: [id])
  technician   Technician?       @relation(fields: [technicianId], references: [id])
  parent       NailWorkComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies      NailWorkComment[] @relation("CommentReplies")
  reports      NailWorkReport[]

  @@index([workId])
  @@index([parentId])
}

model ClientDesignRequest {
  id          Int        @id @default(autoincrement())
  clientId    Int
  techId      Int
  title       String?
  images      String?
  description String?
  quotePrice  Float?
  quoteRemark String?
  status      String     @default("pending_quote")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  client      ClientUser @relation(fields: [clientId], references: [id])
  technician  Technician @relation(fields: [techId], references: [id])
  orders      Order[]

  @@index([clientId])
  @@index([techId])
  @@index([status])
}

model CustomServiceRequest {
  id               Int            @id @default(autoincrement())
  requestNo        String         @unique
  clientId         Int
  techId           Int
  title            String?
  description      String?
  images           String? // JSON array of image URLs
  referenceWorkIds String? // JSON array of referenced work IDs
  serviceDate      String?
  startTime        String?
  serviceType      String? // 上门美甲 / 到店美甲
  addressId        Int?
  shopAddress      String? // JSON of shop address
  status           String         @default("pending_quote") // pending_quote, quoted, accepted, rejected, cancelled
  quotePrice       Float?
  quoteRemark      String?
  quotedAt         DateTime?
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt
  client           ClientUser     @relation(fields: [clientId], references: [id])
  technician       Technician     @relation(fields: [techId], references: [id])
  clientAddress    ClientAddress? @relation(fields: [addressId], references: [id])
  orders           Order[]

  @@index([clientId])
  @@index([techId])
  @@index([status])
  @@index([createdAt])
}

model Conversation {
  id            Int        @id @default(autoincrement())
  clientId      Int
  techId        Int
  lastMessage   String?
  lastMessageAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt
  client        ClientUser @relation(fields: [clientId], references: [id])
  technician    Technician @relation(fields: [techId], references: [id])
  messages      Message[]

  @@unique([clientId, techId])
  @@index([techId])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  senderType     String?
  senderId       Int?
  receiverType   String?
  receiverId     Int?
  messageType    String?
  content        String?
  imageUrl       String?
  relatedType    String?
  relatedId      Int?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([createdAt])
}

model Revenue {
  id           Int        @id @default(autoincrement())
  revenueNo    String     @unique
  orderId      Int        @unique
  technicianId Int
  customerId   Int
  amount       Float
  status       String     @default("confirmed")
  recognizedAt DateTime
  voidedAt     DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  order        Order      @relation(fields: [orderId], references: [id])
  technician   Technician @relation(fields: [technicianId], references: [id])
  customer     Customer   @relation(fields: [customerId], references: [id])

  @@index([technicianId])
  @@index([customerId])
  @@index([recognizedAt])
}

model SubscriptionPlan {
  id                  Int                      @id @default(autoincrement())
  name                String
  code                String                   @unique
  price               Float
  billingCycle        String
  maxCustomers        Int?
  maxMonthlyBookings  Int?
  maxWorks            Int?
  maxStorageBytes     Float?
  maxMarketingExports Int?
  maxMonthlySms       Int?
  maxEmployees        Int?
  maxBookingPages     Int?
  targetStage         String?
  description         String?
  features            String?
  status              String                   @default("active")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @default(now()) @updatedAt
  subscriptions       TechnicianSubscription[]
}

model PaymentOrder {
  id              Int                     @id @default(autoincrement())
  paymentNo       String                  @unique
  orderId         Int?
  subscriptionId  Int?
  clientUserId    Int?
  technicianId    Int?
  paymentType     String
  amountCents     Int
  channel         String                  @default("wechat")
  status          String                  @default("created")
  idempotencyKey  String                  @unique
  providerTradeNo String?                 @unique
  failureReason   String?
  providerPayload String?
  paidAt          DateTime?
  closedAt        DateTime?
  refundedAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @default(now()) @updatedAt
  order           Order?                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  subscription    TechnicianSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  clientUser      ClientUser?             @relation(fields: [clientUserId], references: [id], onDelete: Restrict)
  technician      Technician?             @relation(fields: [technicianId], references: [id], onDelete: Restrict)

  @@index([orderId, paymentType, status])
  @@index([subscriptionId, status])
  @@index([clientUserId, createdAt])
  @@index([technicianId, createdAt])
}

model TechnicianSubscription {
  id                Int              @id @default(autoincrement())
  technicianId      Int              @unique
  planId            Int
  status            String           @default("active")
  startedAt         DateTime
  expiredAt         DateTime?
  cancelledAt       DateTime?
  pendingPlanCode   String?
  changeEffectiveAt DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt
  technician        Technician       @relation(fields: [technicianId], references: [id])
  plan              SubscriptionPlan @relation(fields: [planId], references: [id])
  paymentOrders     PaymentOrder[]

  @@index([status])
  @@index([expiredAt])
}

model SubscriptionResourceUsage {
  id               Int        @id @default(autoincrement())
  technicianId     Int
  period           String
  marketingExports Int        @default(0)
  smsSent          Int        @default(0)
  storageBytes     Float      @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @default(now()) @updatedAt
  technician       Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([technicianId, period])
  @@index([period])
}

model SubscriptionChange {
  id           Int        @id @default(autoincrement())
  technicianId Int
  fromPlanCode String?
  toPlanCode   String
  reason       String
  effectiveAt  DateTime
  metadata     String?
  createdAt    DateTime   @default(now())
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([technicianId, createdAt])
  @@index([effectiveAt])
}

model SubscriptionUsageEvent {
  id             Int        @id @default(autoincrement())
  technicianId   Int
  resourceType   String
  idempotencyKey String
  amount         Int        @default(1)
  period         String
  metadata       String?
  createdAt      DateTime   @default(now())
  technician     Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([technicianId, resourceType, idempotencyKey])
  @@index([technicianId, resourceType, period])
}

model MarketingMaterial {
  id                Int        @id @default(autoincrement())
  technicianId      Int
  type              String
  title             String
  content           String
  status            String     @default("draft")
  revision          Int        @default(1)
  exportCount       Int        @default(0)
  freeReexportCount Int        @default(0)
  lastExportedAt    DateTime?
  lastChargedAt     DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @default(now()) @updatedAt
  technician        Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([technicianId, updatedAt])
}

model DataExportAudit {
  id           Int        @id @default(autoincrement())
  technicianId Int
  exportType   String
  format       String
  rowCount     Int
  filters      String?
  createdAt    DateTime   @default(now())
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([technicianId, createdAt])
}

model UploadedAsset {
  id           Int        @id @default(autoincrement())
  technicianId Int
  url          String     @unique
  highUrl      String
  mediumUrl    String
  thumbnailUrl String
  bytesStored  Int
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([technicianId, deletedAt])
}

model SubscriptionMetricEvent {
  id           Int        @id @default(autoincrement())
  technicianId Int
  eventType    String
  source       String
  planCode     String?
  metadata     String?
  createdAt    DateTime   @default(now())
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([eventType, createdAt])
  @@index([technicianId, createdAt])
}

model FeatureFlag {
  id           Int      @id @default(autoincrement())
  featureCode  String   @unique
  featureName  String
  enabled      Boolean  @default(true)
  enabledPlans String?
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model OperationLog {
  id          Int       @id @default(autoincrement())
  adminUserId Int
  module      String
  action      String
  targetType  String?
  targetId    Int?
  beforeData  String?
  afterData   String?
  ip          String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([module])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model ArtistApplication {
  id          Int       @id @default(autoincrement())
  name        String
  phone       String
  city        String
  serviceMode String? // home, shop, both
  experience  String? // years of experience
  specialty   String? // specialties
  wechat      String? // 微信号，用于发放激活码
  note        String?
  status      String    @default("pending") // pending, approved, rejected
  reviewedBy  Int?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([phone])
}

model TechnicianInviteKey {
  id                 Int         @id @default(autoincrement())
  key                String      @unique
  note               String?
  usedByTechnicianId Int?        @unique
  usedAt             DateTime?
  createdByAdminId   Int?
  createdAt          DateTime    @default(now())
  technician         Technician? @relation(fields: [usedByTechnicianId], references: [id])

  @@index([usedByTechnicianId])
}

model BlockedTimeSlot {
  id         Int        @id @default(autoincrement())
  techId     Int
  orderId    Int?
  startTime  DateTime
  endTime    DateTime
  reason     String?
  createdAt  DateTime   @default(now())
  technician Technician @relation(fields: [techId], references: [id])

  @@index([techId])
  @@index([startTime])
  @@index([endTime])
}

model NailWorkReport {
  id           Int             @id @default(autoincrement())
  commentId    Int
  reporterId   Int
  reporterType String
  reason       String
  status       String          @default("pending")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @default(now()) @updatedAt
  comment      NailWorkComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, reporterId, reporterType])
  @@index([status])
  @@index([commentId])
}

model Feedback {
  id             Int      @id @default(autoincrement())
  sourceType     String // 'client' | 'technician'
  sourceId       Int
  sourceName     String?
  sourcePhone    String?
  title          String
  type           String
  content        String
  attachmentUrls String   @default("[]")
  status         String   @default("pending") // 'pending' | 'resolved'
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([status])
  @@index([sourceType])
}

/// 设备推送 token（FCM）。一个 token 属于一个客户或一个技师。
model DeviceToken {
  id           Int      @id @default(autoincrement())
  token        String   @unique
  platform     String // 'ios' | 'android'
  role         String // 'client' | 'technician'
  clientUserId Int?
  technicianId Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([clientUserId])
  @@index([technicianId])
}
