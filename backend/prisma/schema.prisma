generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           Int            @id @default(autoincrement())
  username     String         @unique
  passwordHash String
  realName     String?
  email        String?
  phone        String?
  roleId       Int
  status       String         @default("active")
  tokenVersion Int            @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt
  role         AdminRole      @relation(fields: [roleId], references: [id])
  logs         OperationLog[]
}

model AdminRole {
  id          Int                   @id @default(autoincrement())
  name        String
  code        String                @unique
  description String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @default(now()) @updatedAt
  users       AdminUser[]
  permissions AdminRolePermission[]
}

model AdminPermission {
  id        Int                   @id @default(autoincrement())
  name      String
  code      String                @unique
  module    String
  action    String
  createdAt DateTime              @default(now())
  roles     AdminRolePermission[]
}

model AdminRolePermission {
  id           Int             @id @default(autoincrement())
  roleId       Int
  permissionId Int
  createdAt    DateTime        @default(now())
  role         AdminRole       @relation(fields: [roleId], references: [id])
  permission   AdminPermission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model Technician {
  id                        Int                         @id @default(autoincrement())
  name                      String
  phone                     String                      @unique
  passwordHash              String                      @default("")
  managedPasswordCiphertext String?
  tokenVersion              Int                         @default(0)
  mustChangePassword        Boolean                     @default(false)
  avatarUrl                 String?
  city                      String?
  province                  String?
  serviceArea               String?
  bio                       String?
  status                    String                      @default("inactive")
  invitationCode            String?                     @unique
  invitedAt                 DateTime?
  lastLoginAt               DateTime?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @default(now()) @updatedAt
  inviteKey                 TechnicianInviteKey?
  // Service type settings
  homeService               Boolean                     @default(false)
  shopService               Boolean                     @default(false)
  shopAddresses             String? // JSON array of shop addresses
  serviceItems              String? // JSON array of technician service items
  // Home service configuration
  homeServiceRadius         Float? // Service radius in km
  homeServicePricing        String? // JSON: tiered pricing [{minKm, maxKm, price}]
  nightServiceFee           Float? // Night service surcharge
  holidayServiceFee         Float? // Holiday service surcharge
  minOrderAmount            Float? // Minimum order amount (guaranteed consumption)
  // Social media accounts
  socialMedia               String? // JSON object of social media accounts
  // Service schedule (JSON: weekly availability + time ranges)
  serviceSchedule           String?
  // Custom tags (JSON array of {id, name, color})
  customTags                String?
  customers                 Customer[]
  orders                    Order[]
  revenues                  Revenue[]
  subscription              TechnicianSubscription?
  clientBindings            ClientTechBinding[]
  nailWorks                 NailWork[]
  designRequests            ClientDesignRequest[]
  conversations             Conversation[]
  customServiceRequests     CustomServiceRequest[]
  workComments              NailWorkComment[]
  blockedTimeSlots          BlockedTimeSlot[]
  serviceReviews            ServiceReview[]
  customerFollowUps         CustomerFollowUp[]
  referralCampaign          ReferralCampaign?
  referralLinks             ReferralLink[]
  referralRelations         ReferralRelation[]
  rewardAccounts            RewardAccount[]
  paymentOrders             PaymentOrder[]
  wechatIdentity            WechatIdentity?
  subscriptionUsages        SubscriptionResourceUsage[]
  subscriptionChanges       SubscriptionChange[]
  subscriptionUsageEvents   SubscriptionUsageEvent[]
  marketingMaterials        MarketingMaterial[]
  dataExportAudits          DataExportAudit[]
  conversionEvents          ConversionEvent[]
  uploadedAssets            UploadedAsset[]
  subscriptionMetricEvents  SubscriptionMetricEvent[]
  followers                 TechnicianFollow[]
  brandProfile             BrandProfile?
  services                 Service[]
  leads                    Lead[]
  leadFollowUps            LeadFollowUp[]
  leadStatusHistories      LeadStatusHistory[]
  actionTasks              ActionTask[]
  serviceRecords           ServiceRecord[]
  reviewInvitations        ReviewInvitation[]
}

model ReferralCampaign {
  id                 Int        @id @default(autoincrement())
  technicianId       Int        @unique
  rewardAmount       Float
  minimumOrderAmount Float      @default(0)
  validFrom          DateTime
  validUntil         DateTime
  status             String     @default("inactive")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @default(now()) @updatedAt
  technician         Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([status, validUntil])
}

model ReferralLink {
  id               Int                @id @default(autoincrement())
  token            String             @unique
  referrerClientId Int
  technicianId     Int
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime           @default(now())
  referrer         ClientUser         @relation(fields: [referrerClientId], references: [id], onDelete: Cascade)
  technician       Technician         @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  relations        ReferralRelation[]

  @@index([referrerClientId, technicianId])
  @@index([expiresAt])
}

model ReferralRelation {
  id                 Int                    @id @default(autoincrement())
  referrerClientId   Int
  referredClientId   Int
  technicianId       Int
  sourceLinkId       Int
  rewardPromised     Boolean                @default(false)
  rewardAmount       Float?
  minimumOrderAmount Float                  @default(0)
  status             String                 @default("pending_first_order")
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @default(now()) @updatedAt
  referrer           ClientUser             @relation("ReferralReferrer", fields: [referrerClientId], references: [id], onDelete: Cascade)
  referred           ClientUser             @relation("ReferralReferred", fields: [referredClientId], references: [id], onDelete: Cascade)
  technician         Technician             @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  sourceLink         ReferralLink           @relation(fields: [sourceLinkId], references: [id], onDelete: Restrict)
  qualification      ReferralQualification?

  @@unique([technicianId, referredClientId])
  @@index([referrerClientId, technicianId])
}

model ReferralQualification {
  id                 Int              @id @default(autoincrement())
  relationId         Int              @unique
  orderId            Int              @unique
  paidAmount         Float
  minimumOrderAmount Float
  rewardAmount       Float
  status             String           @default("qualified")
  qualifiedAt        DateTime         @default(now())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt
  relation           ReferralRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  order              Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
}

model RewardAccount {
  id           Int            @id @default(autoincrement())
  technicianId Int
  clientUserId Int
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt
  technician   Technician     @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  clientUser   ClientUser     @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  ledger       RewardLedger[]

  @@unique([technicianId, clientUserId])
  @@index([clientUserId])
}

model RewardLedger {
  id           Int            @id @default(autoincrement())
  accountId    Int
  entryType    String
  amount       Float
  status       String
  sourceType   String
  sourceId     String
  reversalOfId Int?
  availableAt  DateTime?
  expiresAt    DateTime?
  createdAt    DateTime       @default(now())
  account      RewardAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  reversalOf   RewardLedger?  @relation("RewardLedgerReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals    RewardLedger[] @relation("RewardLedgerReversal")

  @@unique([sourceType, sourceId, entryType])
  @@index([accountId, status, expiresAt])
}

model Customer {
  id           Int                    @id @default(autoincrement())
  technicianId Int
  clientUserId Int?
  name         String
  phone        String?
  avatarUrl    String?
  gender       String?
  birthday     DateTime?
  address      String?
  tags         String?
  notes        String?
  sourceType   String                 @default("historical")
  sourceRef    String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @default(now()) @updatedAt
  archivedAt   DateTime?
  technician   Technician             @relation(fields: [technicianId], references: [id])
  clientUser   ClientUser?            @relation(fields: [clientUserId], references: [id])
  orders       Order[]
  revenues     Revenue[]
  workAccesses NailWorkClientAccess[]
  followUps    CustomerFollowUp[]

  @@unique([technicianId, clientUserId])
  @@index([technicianId])
  @@index([technicianId, archivedAt])
  @@index([clientUserId])
  @@index([phone])
  leads                    Lead[]
  serviceRecords           ServiceRecord[]
  publicationConsents      PublicationConsent[]
}

model CustomerFollowUp {
  id           Int        @id @default(autoincrement())
  customerId   Int
  technicianId Int
  content      String
  plannedAt    DateTime
  status       String     @default("pending")
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([customerId, plannedAt])
  @@index([technicianId, status, plannedAt])
}

model Order {
  id                     Int                    @id @default(autoincrement())
  orderNo                String                 @unique
  technicianId           Int
  customerId             Int
  clientUserId           Int?
  addressId              Int?
  designRequestId        Int?
  customServiceRequestId Int?
  sourceWorkId           Int?
  startTime              DateTime
  endTime                DateTime
  address                String?
  serviceType            String?
  remark                 String?
  // 自定义需求模式下的内容（替代 selectedServiceIds 的可选输入）
  customTitle            String?
  customDescription      String?
  customImages           String? // JSON array of image URLs
  clientPhotos           String? // JSON array uploaded by the client after completion
  clientRecordNote       String? // Client-authored note shown in the completed beauty record
  reminderDaySent        Boolean                @default(false)
  reminderHourSent       Boolean                @default(false)
  quotePrice             Float?
  fundDiscountAmount     Float                  @default(0)
  paymentStatus          String                 @default("unpaid")
  paidAmount             Float                  @default(0)
  paidAt                 DateTime?
  quoteRemark            String?
  quotedAt               DateTime?
  confirmToken           String?                @unique
  confirmTokenExpiresAt  DateTime?
  confirmTokenUsedAt     DateTime?
  status                 String                 @default("pending_quote")
  isDepositPaid          Boolean                @default(false)
  depositAmount          Float?                 @default(0)
  depositStatus          String?                @default("pending")
  depositConfirmedAt     DateTime?
  confirmedAt            DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  cancelReason           String?
  // 自动过期：预约时间已过但仍未进入行程（待上门/待到店）时置为 expired。
  // expiredFromStatus 记录过期前状态，便于「重新发起」时恢复原状态。
  expiredAt              DateTime?
  expiredFromStatus      String?
  source                 String?                @default("technician")
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @default(now()) @updatedAt
  technician             Technician             @relation(fields: [technicianId], references: [id])
  customer               Customer               @relation(fields: [customerId], references: [id])
  clientUser             ClientUser?            @relation(fields: [clientUserId], references: [id])
  clientAddress          ClientAddress?         @relation(fields: [addressId], references: [id])
  designRequest          ClientDesignRequest?   @relation(fields: [designRequestId], references: [id])
  customServiceRequest   CustomServiceRequest?  @relation(fields: [customServiceRequestId], references: [id])
  sourceWork             NailWork?              @relation(fields: [sourceWorkId], references: [id], onDelete: SetNull)
  revenue                Revenue?
  workAccesses           NailWorkClientAccess[]
  review                 ServiceReview?
  reminders              OrderReminder[]
  referralQualification  ReferralQualification?
  paymentOrders          PaymentOrder[]

  @@index([technicianId])
  @@index([customerId])
  @@index([clientUserId])
  @@index([addressId])
  @@index([designRequestId])
  @@index([customServiceRequestId])
  @@index([sourceWorkId])
  @@index([serviceId])
  @@index([status])
  @@index([startTime])
  serviceId              Int?
  service                Service?              @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  sourceLeadId           Int?
  applicationKey         String?                 @unique
  bookingPhase           String                  @default("application")
  expectedDate           DateTime?
  expectedTimeSlot       String?
  confirmedStartTime     DateTime?
  confirmedEndTime       DateTime?
  estimatedAmount        Float?
  confirmedAmount        Float?
  actualAmount           Float?
  materialCost           Float                   @default(0)
  rejectionReason        String?
  noShowReason           String?
  aftercareDeadline      DateTime?
  suggestedMaintenanceAt DateTime?
  sourceLead             Lead?                   @relation("LeadBookings", fields: [sourceLeadId], references: [id], onDelete: SetNull)
  intentWorks            OrderIntentWork[]
  convertedLead          Lead[]                  @relation("LeadConvertedOrder")
  @@index([sourceLeadId])
  serviceRecord            ServiceRecord?
  reviewInvitation         ReviewInvitation?
  worksFromOrder           NailWork[]              @relation("WorkSourceOrder")
}

model OrderReminder {
  id            Int       @id @default(autoincrement())
  orderId       Int
  type          String
  scheduledFor  DateTime
  status        String    @default("pending")
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  sentAt        DateTime?
  cancelledAt   DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, type])
  @@index([status, scheduledFor])
}

model ClientUser {
  id                        Int                    @id @default(autoincrement())
  nickname                  String?
  phone                     String                 @unique
  passwordHash              String                 @default("")
  managedPasswordCiphertext String?
  tokenVersion              Int                    @default(0)
  avatarUrl                 String?
  city                      String?
  bio                       String?
  status                    String                 @default("active")
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @default(now()) @updatedAt
  bindings                  ClientTechBinding[]
  addresses                 ClientAddress[]
  orders                    Order[]
  customers                 Customer[]
  designRequests            ClientDesignRequest[]
  conversations             Conversation[]
  customServiceRequests     CustomServiceRequest[]
  workComments              NailWorkComment[]
  workAccesses              NailWorkClientAccess[]
  workShareGrants           NailWorkShareGrant[]
  serviceReviews            ServiceReview[]
  workShareEvents           NailWorkShareEvent[]
  referralLinks             ReferralLink[]
  referralsMade             ReferralRelation[]     @relation("ReferralReferrer")
  referralAttributions      ReferralRelation[]     @relation("ReferralReferred")
  rewardAccounts            RewardAccount[]
  paymentOrders             PaymentOrder[]
  wechatIdentity            WechatIdentity?
  followedTechnicians       TechnicianFollow[]
  conversionEvents          ConversionEvent[]
  leads                    Lead[]
  publicationConsents      PublicationConsent[]
}

model TechnicianFollow {
  id           Int        @id @default(autoincrement())
  clientUserId Int
  technicianId Int
  createdAt    DateTime   @default(now())
  clientUser   ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([clientUserId, technicianId])
  @@index([technicianId])
}

model WechatIdentity {
  id           Int         @id @default(autoincrement())
  appId        String
  openId       String
  unionId      String?
  clientUserId Int?        @unique
  technicianId Int?        @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt
  clientUser   ClientUser? @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  technician   Technician? @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([appId, openId])
  @@index([unionId])
}

model AuthVerificationCode {
  key       String   @id
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([expiresAt])
}

model AuthVerificationRateLimit {
  key       String   @id
  count     Int      @default(1)
  resetAt   DateTime
  updatedAt DateTime @default(now()) @updatedAt

  @@index([resetAt])
}

model WechatPlatformConfig {
  id                     Int       @id @default(1)
  loginEnabled           Boolean   @default(false)
  miniProgramAppId       String?
  miniProgramSecret      String?
  loginValidatedAt       DateTime?
  loginValidationError   String?
  paymentEnabled         Boolean   @default(false)
  merchantId             String?
  merchantSerialNo       String?
  merchantPrivateKey     String?
  apiV3Key               String?
  paymentVerifierMode    String?
  platformKeyId          String?
  platformPublicKey      String?
  boundAppId             String?
  bindingConfirmed       Boolean   @default(false)
  paymentNotifyUrl       String?
  paymentValidatedAt     DateTime?
  paymentValidationError String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now()) @updatedAt
}

model ClientTechBinding {
  id         Int        @id @default(autoincrement())
  clientId   Int
  techId     Int
  inviteCode String?
  bindSource String
  isDefault  Boolean    @default(false)
  // pending（待美甲师审批）| active（已绑定）| inactive（已解除）| rejected（被拒绝）
  status     String     @default("active")
  note       String? // 客户申请绑定时填写的备注
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @default(now()) @updatedAt
  client     ClientUser @relation(fields: [clientId], references: [id])
  technician Technician @relation(fields: [techId], references: [id])

  @@unique([clientId, techId])
  @@index([techId])
  @@index([clientId, status])
}

model ClientAddress {
  id                    Int                    @id @default(autoincrement())
  clientId              Int
  contactName           String?
  contactPhone          String?
  province              String?
  city                  String?
  district              String?
  detailAddress         String?
  doorInfo              String?
  latitude              Float?
  longitude             Float?
  isDefault             Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @default(now()) @updatedAt
  client                ClientUser             @relation(fields: [clientId], references: [id])
  orders                Order[]
  customServiceRequests CustomServiceRequest[]

  @@index([clientId])
}

model NailWork {
  id                  Int                    @id @default(autoincrement())
  techId              Int
  title               String?
  coverUrl            String?
  images              String?
  description         String?
  designIdea          String?
  suitableScene       String?
  recommendationScore Int?
  tags                String?
  isVisible           Boolean                @default(true)
  isPinned            Boolean                @default(false)
  isFeatured          Boolean                @default(false)
  sortOrder           Int                    @default(0)
  price               Float?
  viewCount           Int                    @default(0)
  isHomepageFeatured  Boolean                @default(false)
  publicationStatus   String                 @default("pending")
  reviewNote           String?
  reviewedAt           DateTime?
  reviewedBy           Int?
  publishedAt          DateTime?
  // public: 已绑定客户均可见；authorized_clients: 仅授权客户可见
  visibilityScope     String                 @default("public")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @default(now()) @updatedAt
  technician          Technician             @relation(fields: [techId], references: [id])
  likes               NailWorkLike[]
  favorites           NailWorkFavorite[]
  comments            NailWorkComment[]
  clientAccesses      NailWorkClientAccess[]
  shareGrants         NailWorkShareGrant[]
  shareEvents         NailWorkShareEvent[]
  sourceOrders        Order[]
  conversionEvents    ConversionEvent[]

  @@index([techId])
  @@index([isVisible])
  @@index([isHomepageFeatured])
  @@index([publicationStatus, createdAt])
  serviceId              Int?
  service                Service?              @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  style                  String?
  color                  String?
  nailShape              String?
  nailLength             String?
  suitableSkinTones      String?
  scenes                 String?
  productionMinutes      Int?
  craftHighlights        String?
  priceDisplayPolicy     String                @default("exact")
  referencePriceMinFen   Int?
  referencePriceMaxFen   Int?
  isReproducible         Boolean               @default(true)
  reproductionNotes      String?
  assetStatus            String                @default("draft")
  publicAuthorizationStatus String             @default("pending")
  publicSortOrder        Int                   @default(0)
  archivedAt             DateTime?
  @@index([serviceId])
  @@index([techId, assetStatus, archivedAt])
  @@index([techId, style, color, nailShape])
  @@index([assetStatus, publicAuthorizationStatus, publicSortOrder])
  leadSources              Lead[]
  intentOrders           OrderIntentWork[]
  sourceOrderId            Int?                    @unique
  sourceOrder              Order?                  @relation("WorkSourceOrder", fields: [sourceOrderId], references: [id])
}

model NailWorkClientAccess {
  id           Int                  @id @default(autoincrement())
  workId       Int
  customerId   Int
  clientUserId Int?
  orderId      Int?
  canView      Boolean              @default(true)
  canShare     Boolean              @default(false)
  canFavorite  Boolean              @default(true)
  canLike      Boolean              @default(true)
  canComment   Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @default(now()) @updatedAt
  work         NailWork             @relation(fields: [workId], references: [id], onDelete: Cascade)
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  clientUser   ClientUser?          @relation(fields: [clientUserId], references: [id], onDelete: SetNull)
  order        Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  shareGrants  NailWorkShareGrant[]

  @@unique([workId, customerId])
  @@index([clientUserId, canView])
  @@index([orderId])
}

model NailWorkShareGrant {
  id           Int                  @id @default(autoincrement())
  token        String               @unique
  workId       Int
  accessId     Int
  clientUserId Int
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime             @default(now())
  work         NailWork             @relation(fields: [workId], references: [id], onDelete: Cascade)
  access       NailWorkClientAccess @relation(fields: [accessId], references: [id], onDelete: Cascade)
  clientUser   ClientUser           @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  events       NailWorkShareEvent[]

  @@index([workId])
  @@index([accessId, revokedAt])
  @@index([expiresAt])
}

model NailWorkShareEvent {
  id           Int                 @id @default(autoincrement())
  workId       Int
  clientUserId Int?
  shareGrantId Int?
  eventType    String
  channel      String?
  createdAt    DateTime            @default(now())
  work         NailWork            @relation(fields: [workId], references: [id], onDelete: Cascade)
  clientUser   ClientUser?         @relation(fields: [clientUserId], references: [id], onDelete: SetNull)
  shareGrant   NailWorkShareGrant? @relation(fields: [shareGrantId], references: [id], onDelete: SetNull)

  @@index([workId, eventType])
  @@index([clientUserId])
  @@index([shareGrantId])
  @@index([createdAt])
}

model ConversionEvent {
  id           Int         @id @default(autoincrement())
  eventId      String      @unique
  technicianId Int
  workId       Int?
  clientUserId Int?
  visitorId    String?
  eventType    String
  source       String?
  createdAt    DateTime    @default(now())
  technician   Technician  @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  work         NailWork?   @relation(fields: [workId], references: [id], onDelete: SetNull)
  clientUser   ClientUser? @relation(fields: [clientUserId], references: [id], onDelete: SetNull)

  @@index([technicianId, eventType, createdAt])
  @@index([workId, eventType, createdAt])
  @@index([visitorId, createdAt])
}

model ServiceReview {
  id                   Int        @id @default(autoincrement())
  orderId              Int        @unique
  clientUserId         Int
  technicianId         Int
  rating               Int
  content              String?
  photos               String?
  photoUseAuthorized   Boolean    @default(false)
  photoUseAuthorizedAt DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @default(now()) @updatedAt
  order                Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  clientUser           ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  technician           Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([clientUserId])
  @@index([technicianId, rating])
  verificationSource       String                  @default("completed_order")
  moderationStatus         String                  @default("pending")
  publicationStatus        String                  @default("private")
  moderatedAt              DateTime?
  moderatorId              Int?
  technicianReply          String?
  repliedAt                DateTime?
  reviewInvitationId       Int?                    @unique
  reviewInvitation         ReviewInvitation?       @relation(fields: [reviewInvitationId], references: [id])
