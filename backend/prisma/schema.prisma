model PaymentOrder {
  id              Int                     @id @default(autoincrement())
  paymentNo       String                  @unique
  orderId         Int?
  subscriptionId  Int?
  clientUserId    Int?
  technicianId    Int?
  paymentType     String
  amountCents     Int
