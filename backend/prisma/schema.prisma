  clientUserId       Int?
  customerId         Int?
  convertedOrderId   Int?
  visitorId          String?
  sourceChannel      String       @default("direct")
  sourceCampaign     String?
  sourceContent      String?
  sourceWorkId       Int?
  firstTouchpoint    String?
  latestTouchpoint   String?
  nickname           String?
  contact            String?
  requirement        String?
  budget             String?
  expectedDate       DateTime?
  privacyAgreedAt    DateTime?
  submissionKey      String?      @unique
  status             String       @default("new")
  lostReason         String?
  lostReasonNote     String?
  nextFollowUpAt     DateTime?
  pausedAt           DateTime?
  convertedAt        DateTime?
  lastActivityAt     DateTime     @default(now())
  dedupeKey          String       @unique
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @default(now()) @updatedAt
  technician         Technician   @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  clientUser         ClientUser?  @relation(fields: [clientUserId], references: [id], onDelete: SetNull)
