# 管理后台 HTTPS（admin.lunails.cn）
#
# 首次部署时本文件以 .disabled 结尾，nginx 不会加载它（避免证书还没申请就启动失败）。
# 申请到证书后，去掉 .disabled 后缀使其生效：
#   mv deploy/nginx/conf.d/admin.lunails.cn-ssl.conf.disabled deploy/nginx/conf.d/admin.lunails.cn-ssl.conf
#   docker compose restart nginx
#
# 同源架构：SPA 静态页由 admin-web 容器提供；/api/ 反代到后端。
server {
    listen 443 ssl;
    server_name admin.lunails.cn;

    ssl_certificate     /etc/letsencrypt/live/admin.lunails.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.lunails.cn/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    client_max_body_size 20m;

    # REST API → 后端
    location /api/ {
        proxy_pass         http://backend:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # 其余请求 → 管理后台 SPA 静态服务
    location / {
        proxy_pass         http://admin-web:80;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}
